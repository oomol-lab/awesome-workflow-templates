    "modules": {
      "n_cafb9b75e4c8d643": {
        "name": "Format the error report",
        "imports": [],
        "source": "export default function ({ body, baseUrl, handlerId, handlerName }) {\n  if (!body || typeof body !== \"object\" || !body.workflow?.id || !body.workflow?.name)\n    throw Error(\"Missing workflow in error event\");\n  const source = body.execution?.error ? body.execution : body.trigger?.error ? body.trigger : null;\n  if (!source) throw Error(\"Expected execution or trigger error\");\n  const redact = (v, k = \"\") => {\n    if (/password|secret|token|authorization|api.?key/i.test(k)) return \"[redacted]\";\n    if (Array.isArray(v)) return v.map((x) => redact(x));\n    if (v && typeof v === \"object\")\n      return Object.fromEntries(Object.entries(v).map(([a, b]) => [a, redact(b, a)]));\n    return typeof v === \"string\"\n      ? v\n          .replace(/(bearer\\s+)[^\\s,;]+/gi, \"$1[redacted]\")\n          .replace(\n            /([\"']?(?:api[_-]?key|token|password|secret|authorization)[\"']?\\s*[=:]\\s*[\"']?)[^\"'\\s,;}]+/gi,\n            \"$1[redacted]\",\n          )\n      : v;\n  };\n  const safe = redact(body),\n    execution = !!body.execution?.error,\n    kind = execution ? \"execution error\" : \"trigger failure\",\n    name = String(body.workflow.name).replace(/[\\r\\n]+/g, \" \"),\n    message = String(redact(source.error.message ?? \"\")).replace(/[\\r\\n]+/g, \" \"),\n    base = String(baseUrl ?? \"\").replace(/\\/+$/, \"\");\n  if (base && !/^https?:\\/\\//.test(base)) throw Error(\"Invalid instance URL\");\n  const workflowUrl = base\n    ? base + \"/workflow/\" + encodeURIComponent(String(body.workflow.id))\n    : \"\";\n  return {\n    subject: `Workflow ${body.workflow.id} (${name}) ${kind}: ${message}`,\n    text: `Workflow: ${name} (${body.workflow.id})\\n${workflowUrl ? \"Workflow URL: \" + workflowUrl + \"\\n\" : \"\"}Error handler: ${handlerName || \"(not configured)\"} (${handlerId || \"unknown\"})\\nType: ${kind}\\n\\nError event:\\n${JSON.stringify(safe, null, 2)}`,\n  };\n}\n"
      }
    }
