    "modules": {
      "n_fd6fe40112496ec6": {
        "name": "Prepare company lookup",
        "imports": [],
        "source": "export default function domain({ body }) {\n  const email = body.email;\n  if (typeof email !== \"string\" || !email.includes(\"@\")) throw Error(\"Email required\");\n  const host = email.split(\"@\")[1];\n  return {\n    url:\n      \"https://gateway.datagma.net/api/ingress/v2/full?data=\" +\n      encodeURIComponent(host) +\n      \"&companyPremium=true&companyFull=true&companyEmployees=false&employeeCountry=US\",\n  };\n}\n"
      },
      "n_99ef959d87596e2f": {
        "name": "Choose demo route",
        "imports": [],
        "source": "export default function qualify({ body }) {\n  const text = body?.company?.premium?.employeesAmountInLinkedin;\n  if (typeof text !== \"string\") throw Error(\"Datagma did not return employee count\");\n  const size = parseInt(text.replace(/\\s/g, \"\"), 10);\n  return { response: { result: size > 100 ? 1 : 2 } };\n}\n"
      }
    }
