    "modules": {
      "n_66a6d12b7462473b": {
        "name": "Find new posts",
        "imports": [],
        "source": "export default async function plan({ posts, includes }, context) {\n  if (!Array.isArray(posts)) throw Error(\"Missing X results\");\n  if (posts.length && (!includes || !Array.isArray(includes.users)))\n    throw Error(\"Missing expanded authors\");\n  const prev = await context.state.get(\"x-search-ids\");\n  if (prev !== null && !Array.isArray(prev)) throw Error(\"Invalid previous IDs\");\n  const ids = [],\n    queue = [];\n  for (const p of posts) {\n    const raw = p.raw ?? p,\n      id = p.id,\n      text = p.text,\n      authorId = p.authorId ?? raw.author_id;\n    if (typeof id !== \"string\" || !id || typeof text !== \"string\" || typeof authorId !== \"string\")\n      throw Error(\"Incomplete X post\");\n    ids.push(id);\n    const u = includes.users.find((x) => x.id === authorId);\n    if (!u || typeof u.username !== \"string\" || !u.username || typeof u.name !== \"string\")\n      throw Error(\"Missing X author\");\n    queue.push({ id, text, username: u.username, name: u.name, photo: u.profile_image_url ?? \"\" });\n  }\n  let pending = [];\n  for (const x of queue) {\n    if (prev?.includes(x.id)) break;\n    pending.push(x);\n  }\n  return { pending, ids, hasResults: ids.length > 0 };\n}\n"
      },
      "n_c5e0577f692f90fc": {
        "name": "Prepare next notification",
        "imports": [],
        "source": "export default function next({ pending, previousState }) {\n  const i = previousState?.index ?? 0;\n  if (!Array.isArray(pending) || !Number.isSafeInteger(i) || i < 0)\n    throw Error(\"Invalid notification state\");\n  const p = pending[i];\n  if (!p) return { more: false, state: { index: i }, message: \"-\", props: {} };\n  const link =\n      \"https://x.com/\" + encodeURIComponent(p.username) + \"/status/\" + encodeURIComponent(p.id),\n    a = {\n      text: p.text,\n      author_name: p.name + \" (\" + p.username + \")\",\n      author_link: \"https://x.com/\" + encodeURIComponent(p.username),\n    };\n  if (p.photo) a.author_icon = p.photo;\n  return { more: true, state: { index: i + 1 }, message: link, props: { attachments: [a] } };\n}\n"
      },
      "n_9aa1e3aa0cd6a0d7": {
        "name": "Remember search results",
        "imports": [],
        "source": "export default async function commit({ ids, hasResults }, context) {\n  if (hasResults) await context.state.set(\"x-search-ids\", ids);\n  return { done: true };\n}\n"
      }
    }
