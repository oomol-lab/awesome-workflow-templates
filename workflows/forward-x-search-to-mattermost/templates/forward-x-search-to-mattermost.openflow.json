    "modules": {
      "n_66a6d12b7462473b": {
        "name": "Find new posts",
        "imports": [],
        "source": "export default async function plan({ response }, context) {\n  const data = response?.data ?? response ?? {};\n  const rawList = Array.isArray(data?.timeline)\n    ? data.timeline\n    : Array.isArray(data?.tweets)\n      ? data.tweets\n      : Array.isArray(data?.results)\n        ? data.results\n        : Array.isArray(data)\n          ? data\n          : null;\n  if (!Array.isArray(rawList)) throw Error(\"Missing TikHub X search timeline\");\n  const prev = await context.state.get(\"x-search-ids\");\n  if (prev !== null && !Array.isArray(prev)) throw Error(\"Invalid previous IDs\");\n  const ids = [];\n  const queue = [];\n  for (const item of rawList) {\n    if (!item || typeof item !== \"object\") continue;\n    const id = String(item.tweet_id ?? item.id_str ?? item.rest_id ?? item.id ?? \"\");\n    const text = item.text ?? item.full_text ?? item.legacy?.full_text ?? \"\";\n    const user =\n      item.user_info ?? item.author ?? item.user ?? item.core?.user_results?.result?.legacy ?? {};\n    const username = String(user.screen_name ?? user.username ?? item.screen_name ?? \"\");\n    const name = String(user.name ?? username);\n    const photo = String(\n      user.avatar ?? user.profile_image_url_https ?? user.profile_image_url ?? \"\",\n    );\n    if (!id || typeof text !== \"string\" || !username) {\n      throw Error(\"Incomplete TikHub X post\");\n    }\n    ids.push(id);\n    queue.push({ id, text, username, name, photo });\n  }\n  const pending = [];\n  for (const x of queue) {\n    if (prev?.includes(x.id)) break;\n    pending.push(x);\n  }\n  return { pending, ids, hasResults: ids.length > 0 };\n}\n"
      },
      "n_c5e0577f692f90fc": {
        "name": "Prepare next notification",
        "imports": [],
        "source": "export default function next({ pending, previousState }) {\n  const i = previousState?.index ?? 0;\n  if (!Array.isArray(pending) || !Number.isSafeInteger(i) || i < 0)\n    throw Error(\"Invalid notification state\");\n  const p = pending[i];\n  if (!p) return { more: false, state: { index: i }, message: \"-\", props: {} };\n  const link =\n      \"https://x.com/\" + encodeURIComponent(p.username) + \"/status/\" + encodeURIComponent(p.id),\n    a = {\n      text: p.text,\n      author_name: p.name + \" (\" + p.username + \")\",\n      author_link: \"https://x.com/\" + encodeURIComponent(p.username),\n    };\n  if (p.photo) a.author_icon = p.photo;\n  return { more: true, state: { index: i + 1 }, message: link, props: { attachments: [a] } };\n}\n"
      },
      "n_9aa1e3aa0cd6a0d7": {
        "name": "Remember search results",
        "imports": [],
        "source": "export default async function commit({ ids, hasResults }, context) {\n  if (hasResults) await context.state.set(\"x-search-ids\", ids);\n  return { done: true };\n}\n"
      }
