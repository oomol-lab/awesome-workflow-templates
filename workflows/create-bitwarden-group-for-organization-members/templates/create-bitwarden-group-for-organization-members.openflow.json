    "modules": {
      "n_820dc3d1751be352": {
        "name": "Prepare group",
        "imports": [],
        "source": "export default function create({ name }) {\n  if (typeof name !== \"string\" || !name.trim() || name.startsWith(\"YOUR_\"))\n    throw Error(\"Configure group name\");\n  return { endpoint: \"/public/groups\", body: { name: name.trim(), accessAll: false } };\n}\n"
      },
      "n_b751870f14983def": {
        "name": "Collect organization members",
        "imports": [],
        "source": "export default async function members({ statusCode, body }, context) {\n  if (statusCode < 200 || statusCode >= 300 || typeof body?.id !== \"string\" || !body.id)\n    throw Error(\"Group creation not confirmed\");\n  let cursor = null,\n    ids = [],\n    seen = new Set();\n  do {\n    const r = await context.actions.call(\n      \"bitwarden.list_members\",\n      cursor ? { continuationToken: cursor } : {},\n    );\n    if (!Array.isArray(r.members)) throw Error(\"Invalid member list\");\n    for (const m of r.members) {\n      if (typeof m.id !== \"string\" || !m.id || ids.includes(m.id))\n        throw Error(\"Invalid or duplicate member ID\");\n      ids.push(m.id);\n    }\n    const next = r.continuationToken ?? null;\n    if (next && seen.has(next)) throw Error(\"Repeated continuation token\");\n    if (next) seen.add(next);\n    cursor = next;\n  } while (cursor);\n  if (!ids.length) throw Error(\"Group created but no members found\");\n  return {\n    groupId: body.id,\n    endpoint: \"/public/groups/\" + encodeURIComponent(body.id) + \"/member-ids\",\n    body: { memberIds: ids },\n  };\n}\n"
      },
      "n_7cc07e43bdad1cb6": {
        "name": "Confirm group update",
        "imports": [],
        "source": "export default function confirm({ statusCode, groupId }) {\n  if (statusCode < 200 || statusCode >= 300) throw Error(\"Group membership update not confirmed\");\n  return { id: groupId };\n}\n"
      }
    }
