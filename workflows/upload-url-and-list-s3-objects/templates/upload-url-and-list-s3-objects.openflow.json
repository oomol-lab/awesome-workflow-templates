    "modules": {
      "n_e6441d789a993671": {
        "name": "Set bucket",
        "imports": [],
        "source": "export default function bucket({ bucket }) {\n  if (typeof bucket !== \"string\" || !bucket.trim()) throw Error(\"S3 bucket is required\");\n  return { bucket: bucket.trim() };\n}\n"
      },
      "n_fc24b52eb951b331": {
        "name": "Collect the bucket listing",
        "imports": [],
        "source": "export default function collect({ previous, objects, truncated, nextToken }) {\n  const state = previous ?? { items: [], started: false };\n  if (state.started) {\n    if (!Array.isArray(objects)) throw Error(\"S3 returned no object list\");\n    state.items.push(...objects);\n    if (truncated && (!nextToken || typeof nextToken !== \"string\"))\n      throw Error(\"S3 returned no continuation token\");\n    if (!truncated) return { state, more: false, token: null, items: state.items };\n  }\n  return {\n    state: { items: state.items, started: true },\n    more: true,\n    token: state.started ? nextToken : null,\n    items: state.items,\n  };\n}\n"
      }
    }
  },
