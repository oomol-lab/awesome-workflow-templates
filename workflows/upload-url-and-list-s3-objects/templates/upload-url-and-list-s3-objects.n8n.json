{
  "name": "Upload a URL and List S3 Objects",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        390,
        220
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "upload-url-and-list-s3-objects-0"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        590,
        220
      ],
      "parameters": {
        "url": "https://example.com/YOUR_FILE.png",
        "options": {},
        "responseFormat": "file"
      },
      "typeVersion": 1,
      "id": "upload-url-and-list-s3-objects-1"
    },
    {
      "name": "S3",
      "type": "n8n-nodes-base.s3",
      "position": [
        790,
        220
      ],
      "parameters": {
        "fileName": "={{$node[\"HTTP Request\"].binary.data.fileName}}",
        "operation": "upload",
        "bucketName": "YOUR_S3_BUCKET",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "upload-url-and-list-s3-objects-2"
    },
    {
      "name": "S",
      "type": "n8n-nodes-base.s3",
      "position": [
        990,
        220
      ],
      "parameters": {
        "options": {},
        "operation": "getAll",
        "returnAll": true,
        "bucketName": "YOUR_S3_BUCKET"
      },
      "typeVersion": 1,
      "id": "upload-url-and-list-s3-objects-3"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "S3": {
      "main": [
        [
          {
            "node": "S",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "S3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
