{
  "nodes": [
    {
      "name": "Eventbrite Trigger",
      "type": "n8n-nodes-base.eventbriteTrigger",
      "position": [
        880,
        400
      ],
      "parameters": {
        "event": "YOUR_EVENT_ID",
        "actions": [
          "order.placed",
          "order.updated",
          "order.refunded"
        ],
        "organization": "YOUR_ORGANIZATION_ID",
        "resolveData": false
      },
      "typeVersion": 1,
      "id": "receive-eventbrite-order-events-0"
    },
    {
      "id": "receive-eventbrite-order-events-validate",
      "name": "Validate order URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        220
      ],
      "parameters": {
        "jsCode": "const url = $json.api_url;\nif (\n  typeof url !== \"string\" ||\n  !/^https:\\/\\/www\\.eventbriteapi\\.com\\/v3\\/orders\\/[^/?#]+\\/(?:\\?[^#]*)?$/.test(url)\n)\n  throw new Error(\"Invalid Eventbrite order URL\");\nreturn [{ json: { url } }];\n"
      }
    },
    {
      "id": "receive-eventbrite-order-events-fetch",
      "name": "Fetch order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        850,
        220
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      }
    },
    {
      "id": "receive-eventbrite-order-events-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Eventbrite Trigger": {
      "main": [
        [
          {
            "node": "Validate order URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate order URL": {
      "main": [
        [
          {
            "node": "Fetch order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch order": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Receive Eventbrite Order Events",
  "active": false,
  "pinData": {}
}
