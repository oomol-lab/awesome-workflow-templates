{
  "name": "Send Workflow Failure SMS with Twilio",
  "nodes": [
    {
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [
        550,
        260
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "send-workflow-failure-sms-with-twilio-0"
    },
    {
      "name": "Twilio",
      "type": "n8n-nodes-base.twilio",
      "position": [
        750,
        260
      ],
      "parameters": {
        "from": "YOUR_TWILIO_NUMBER",
        "to": "YOUR_RECIPIENT_NUMBER",
        "message": "={{ `Your workflow with ID: ${$json.workflow.id} and name: ${$json.workflow.name} failed to execute.` }}"
      },
      "typeVersion": 1,
      "id": "send-workflow-failure-sms-with-twilio-1"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Twilio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
