        "source": "export default function workflowFailureSms({workflow}) {\n if(!workflow||typeof workflow.flowId!=='string'||!workflow.flowId||typeof workflow.name!=='string'||!workflow.name)throw Error('Missing workflow identity');\n return {message:`Your workflow with ID: ${workflow.flowId} and name: ${workflow.name} failed to execute.`};\n}\n"
