    "modules": {
      "n_153a1dd302b8744d": {
        "name": "Set campaign and Airtable fields",
        "imports": [],
        "source": "function prepareCampaign({\n  website_url,\n  campaign_id,\n  campaign_source,\n  campaign_medium,\n  campaign_name,\n  campaign_term,\n  baseId,\n  tableId,\n}) {\n  const site = website_url.trim();\n  const parts = /^(https?:\\/\\/)([a-z0-9.-]+(?::\\d{1,5})?)(\\/[^?#]*)?(?:\\?([^#]*))?(#.*)?$/i.exec(\n    site,\n  );\n  if (!parts || /[\\s\\\\\\x00-\\x1f\\x7f]/.test(site) || /%(?![a-f0-9]{2})/i.test(site)) {\n    throw new Error(\"Enter a complete HTTP or HTTPS campaign URL without credentials\");\n  }\n  const [host, port] = parts[2].split(\":\");\n  if (\n    !host\n      .split(\".\")\n      .filter((label, index, all) => label || index !== all.length - 1)\n      .every((label) => /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i.test(label)) ||\n    !/[a-z0-9]/i.test(host) ||\n    (port && (Number(port) < 1 || Number(port) > 65535))\n  ) {\n    throw new Error(\"Enter a campaign URL with a valid hostname and port\");\n  }\n  if (!/^app[A-Za-z0-9]{14}$/.test(baseId) || !/^tbl[A-Za-z0-9]{14}$/.test(tableId)) {\n    throw new Error(\"Set an Airtable base ID and table ID\");\n  }\n  const tags = {\n    utm_source: campaign_source.trim(),\n    utm_medium: campaign_medium.trim(),\n    utm_campaign: campaign_name.trim(),\n    utm_term: campaign_term.trim(),\n    utm_content: campaign_id.trim(),\n  };\n  if (!tags.utm_source || !tags.utm_medium || !tags.utm_campaign) {\n    throw new Error(\"Enter a campaign source, medium, and name\");\n  }\n  const replacements = Object.entries(tags).filter(([, text]) => text);\n  const overridden = new Set(replacements.map(([key]) => key));\n  const original = (parts[4] || \"\").split(\"&\").filter((entry) => {\n    if (!entry) return false;\n    const key = entry.split(\"=\", 1)[0];\n    try {\n      return !overridden.has(decodeURIComponent(key.replaceAll(\"+\", \" \")));\n    } catch {\n      return true;\n    }\n  });\n  const query = original.concat(\n    replacements.map(([key, text]) => key + \"=\" + encodeURIComponent(text)),\n  );\n  const url =\n    parts[1].toLowerCase() +\n    parts[2].toLowerCase() +\n    (parts[3] || \"/\") +\n    \"?\" +\n    query.join(\"&\") +\n    (parts[5] || \"\");\n  if (new TextEncoder().encode(url).length > 900)\n    throw new Error(\"Keep the campaign link within 900 UTF-8 bytes\");\n  return {\n    url,\n    endpoint: \"/v0/\" + baseId + \"/\" + tableId,\n    request: { performUpsert: { fieldsToMergeOn: [\"URL\"] }, records: [{ fields: { URL: url } }] },\n  };\n}\n\nexport default prepareCampaign;\n"
      },
      "n_d4e4defe47c1e262": {
        "name": "Check the QR code PNG",
        "imports": [],
        "source": "function checkQrPng(bytes, contentType, statusCode) {\n  const png = [137, 80, 78, 71, 13, 10, 26, 10];\n  const iend = [0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130];\n  if (\n    statusCode !== 200 ||\n    contentType?.split(\";\")[0].trim().toLowerCase() !== \"image/png\" ||\n    bytes?.length < 45 ||\n    bytes?.length > 1024 * 1024 ||\n    !png.every((byte, index) => bytes?.[index] === byte) ||\n    !iend.every((byte, index) => bytes[bytes.length - iend.length + index] === byte)\n  ) {\n    throw new Error(\"QuickChart did not return a complete PNG\");\n  }\n  const header = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n  if (\n    header.getUint32(8) !== 13 ||\n    header.getUint32(12) !== 0x49484452 ||\n    header.getUint32(16) !== 300 ||\n    header.getUint32(20) !== 300\n  ) {\n    throw new Error(\"QuickChart did not return the requested 300-pixel QR code\");\n  }\n}\n\nexport default async ({ qr, statusCode }, context) => {\n  if (qr.size > 1024 * 1024) throw new Error(\"QuickChart PNG exceeds 1 MiB\");\n  const bytes = await context.artifact.open(qr);\n  checkQrPng(bytes, qr.mediaType, statusCode);\n  return {\n    qr: await context.artifact.put(bytes, { name: \"campaign-qr.png\", mediaType: \"image/png\" }),\n  };\n};\n"
      },
      "n_b9a6e3e5a363e352": {
        "name": "Confirm the Airtable record",
        "imports": [],
        "source": "function confirmCampaign({ body, statusCode, url }) {\n  if (statusCode !== 200)\n    throw new Error(\n      \"Airtable upsert failed with HTTP \" + statusCode + \". Check Airtable before retrying.\",\n    );\n  const record = body?.records?.[0];\n  const created = body?.createdRecords;\n  const updated = body?.updatedRecords;\n  if (\n    body?.details ||\n    body?.records?.length !== 1 ||\n    typeof record?.id !== \"string\" ||\n    !/^rec[A-Za-z0-9]{14}$/.test(record.id) ||\n    record.fields?.URL !== url ||\n    !Array.isArray(created) ||\n    !Array.isArray(updated) ||\n    created.length + updated.length !== 1 ||\n    (created[0] ?? updated[0]) !== record.id\n  ) {\n    throw new Error(\"Airtable did not confirm this campaign link. Check Airtable before retrying.\");\n  }\n  return { url, recordId: record.id, created: created.length === 1 };\n}\n\nexport default confirmCampaign;\n"
      }
    },
