    {
      "name": "Select reviewed action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all();\nif (rows.length !== 1 || !rows[0].json.item_key) throw Error(\"Review not found or duplicated\");\nconst row = rows[0].json,\n  b = $(\"Reviewer decision webhook\").first().json.body;\nif (\n  ![\"REJECTED\", \"KIV\", \"SHORTLISTED\"].includes(b.decision) ||\n  typeof b.reason !== \"string\" ||\n  !b.reason.trim()\n)\n  throw Error(\"Human decision and reason required\");\nconst s = JSON.parse(row.payload);\nif (s.fileId !== b.fileId) throw Error(\"Wrong review\");\nlet stage = row.status;\nif (stage.startsWith(\"pending-\")) throw Error(\"Inspect pending operation\");\nif (stage === \"review\") {\n  s.decision = b.decision;\n  s.reason = b.reason;\n  stage = \"commit-decision\";\n} else if (s.decision !== b.decision || s.reason !== b.reason)\n  throw Error(\"Decision already recorded\");\nreturn [{ json: { stage, payload: s } }];\n"
      },
      "id": "review-resumes-before-hiring-decisions-21",
      "position": [
        4620,
        0
      ]
