        "jsCode": "const a = $json.output,\n  f = $(\"Google Drive - Resume CV File Created\").item.json;\nif (!a || typeof a.candidateName !== \"string\" || typeof a.facts !== \"string\")\n  throw Error(\"Invalid factual summary\");\nreturn { json: { fileId: f.id, fileName: f.name, candidateName: a.candidateName, facts: a.facts } };\n"
