        "mode": "runOnceForEachItem",
        "jsCode": "const mode = \"direct\";\nif (![\"direct\", \"relay\"].includes(mode)) throw Error(\"Choose direct or relay\");\nif (!Array.isArray($json.body)) throw Error(\"Expected Grist array\");\nreturn { json: { mode, events: $json.body } };\n"
      },
      "id": "copy-confirmed-grist-rows-once-1",
      "position": [
        230,
        300
      ]
    },
    {
      "name": "Route delivery mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.mode === 'direct' ? 0 : 1 }}",
        "options": {}
