        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {events:$json.events} }}",
        "options": {}
      },
      "id": "copy-confirmed-grist-rows-once-3",
      "position": [
        690,
        300
      ]
    },
    {
      "name": "Select confirmed rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events = $input.first().json.events;\nreturn events.flatMap((x) => {\n  if (!Number.isSafeInteger(x?.id) || x.id <= 0) throw Error(\"Invalid Grist row\");\n  return x.Confirmed === true ? [{ json: x }] : [];\n});\n"
      },
      "id": "copy-confirmed-grist-rows-once-4",
      "position": [
        920,
        300
      ]
    },
    {
      "name": "Loop confirmed rows",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "copy-confirmed-grist-rows-once-5",
      "position": [
        1150,
        300
      ]
    },
    {
      "id": "copy-confirmed-grist-rows-once-6",
      "name": "get existing",
      "type": "n8n-nodes-base.grist",
      "position": [
        1380,
        300
      ],
      "parameters": {
        "docId": "YOUR_DESTINATION_DOCUMENT_ID",
        "tableId": "YOUR_DESTINATION_TABLE_ID",
        "operation": "getAll",
        "returnAll": false,
        "limit": 1,
        "additionalOptions": {
          "filter": {
            "filterProperties": [
              {
                "field": "Source",
                "values": "={{ $json.id }}"
              }
            ]
          }
        }
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "name": "Check existing rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $(\"Loop confirmed rows\").first(1, $runIndex).json.id;\nreturn [\n  {\n    json: { id, exists: $input.all().some((x) => Number.isSafeInteger(x.json.id)) },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "copy-confirmed-grist-rows-once-7",
      "position": [
        1610,
        300
      ]
    },
