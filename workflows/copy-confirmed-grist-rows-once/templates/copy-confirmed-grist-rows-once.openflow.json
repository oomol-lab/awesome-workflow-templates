    "modules": {
      "n_43d86b5e50c420b1": {
        "name": "Check the next source row",
        "imports": [],
        "source": "export default async function sync({ body, previous, docId, tableId }, context) {\n  const events = body?.events;\n  if (!Array.isArray(events)) throw Error(\"Expected a Grist webhook array\");\n  for (const v of [docId, tableId])\n    if (typeof v !== \"string\" || !v || v.startsWith(\"YOUR_\"))\n      throw Error(\"Configure the destination document and table\");\n  const index = previous?.index ?? 0,\n    state = { index: index + 1 },\n    url = `https://api.getgrist.com/api/docs/${encodeURIComponent(docId)}/tables/${encodeURIComponent(tableId)}/records`;\n  if (index >= events.length)\n    return { state: { index }, more: false, create: false, url, request: {} };\n  const event = events[index];\n  if (!event || typeof event !== \"object\" || !Number.isSafeInteger(event.id) || event.id <= 0)\n    throw Error(\"Invalid Grist row\");\n  if (event.Confirmed !== true) return { state, more: true, create: false, url, request: {} };\n  const found = await context.actions.call(\"grist.list_records\", {\n    docId,\n    tableId,\n    filter: JSON.stringify({ Source: [event.id] }),\n    limit: 1,\n  });\n  if (!Array.isArray(found?.records)) throw Error(\"Invalid Grist lookup\");\n  return {\n    state,\n    more: true,\n    create: found.records.length === 0,\n    url,\n    request: { records: [{ fields: { Source: event.id } }] },\n  };\n}\n"
      },
      "n_f609e996b8a3f389": {
        "name": "Confirm the created row",
        "imports": [],
        "source": "export default function confirm({ response }) {\n  if (\n    !Array.isArray(response?.records) ||\n    response.records.length !== 1 ||\n    !Number.isSafeInteger(response.records[0]?.id) ||\n    response.records[0].id <= 0\n  )\n    throw Error(\"Grist did not confirm creation\");\n  return { confirmed: true };\n}\n"
      }
    }
