    "modules": {
      "n_26925b38eda0a7f8": {
        "name": "Reserve messaging action",
        "imports": [],
        "source": "export default async function plan(\n  { body, offerTemplate, replyTemplate, acknowledge, resolution },\n  ctx,\n) {\n  const e = body?.event;\n  if (!e || ![\"outbound\", \"inbound\"].includes(e.kind)) throw Error(\"Invalid event\");\n  const raw = String(e.phone ?? \"\")\n    .replace(/^00/, \"\")\n    .replace(/^\\+/, \"\")\n    .replace(/\\s+/g, \"\");\n  if (!/^\\d{7,15}$/.test(raw)) throw Error(\"Invalid phone\");\n  let key, action, template, components;\n  if (e.kind === \"outbound\") {\n    if ([e.name, e.product, e.company, e.link].some((x) => typeof x !== \"string\" || !x))\n      throw Error(\"Missing outbound template fields\");\n    key = \"wa-offer-pending\";\n    action = \"send\";\n    template = offerTemplate;\n    components = [\n      {\n        type: \"body\",\n        parameters: [e.name, e.product, e.company].map((text) => ({ type: \"text\", text })),\n      },\n      { type: \"button\", sub_type: \"url\", index: 0, parameters: [{ type: \"text\", text: e.link }] },\n    ];\n  } else {\n    if (!e.id || typeof e.text !== \"string\") throw Error(\"Missing message ID or text\");\n    key = \"wa-inbound:\" + e.id;\n    const stop = e.text.toLowerCase().replace(/\\s+/g, \"\").startsWith(\"stop\");\n    action = stop ? \"optout\" : \"send\";\n    template = replyTemplate;\n    components = [{ type: \"body\", parameters: [{ type: \"text\", text: e.name || \"\" }] }];\n  }\n  const old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { action: \"skip\", key, to: raw, template: \"\", components: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending action \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, e.kind === \"outbound\" ? null : { status: \"done\" });\n      return { action: \"skip\", key, to: raw, template: \"\", components: [] };\n    }\n  }\n  if (action === \"send\" && (!template || template.startsWith(\"YOUR_\")))\n    throw Error(\"Configure template\");\n  await ctx.state.set(key, { status: \"pending\", recipient: raw, action });\n  return { action, key, to: raw, template, components };\n}\n"
      },
      "n_ec86abd5ffb1d291": {
        "name": "Confirm WhatsApp message",
        "imports": [],
        "source": "export default async function confirm({ key, messages }, ctx) {\n  if (!Array.isArray(messages) || !messages[0]?.id) throw Error(\"WhatsApp send result unknown\");\n  await ctx.state.set(key, key === \"wa-offer-pending\" ? null : { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_8d837e3b9dc49885": {
        "name": "Subscribe opt-out number",
        "imports": [],
        "source": "export default async function stop({ key, to, username, password, listId }, ctx) {\n  if (!username || !password || !listId || String(listId).startsWith(\"YOUR_\"))\n    throw Error(\"Configure KlickTipp credentials and opt-out list\");\n  const login = await ctx.fetch(\"https://api.klicktipp.com/account/login\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ username, password }),\n  });\n  if (!login.ok) throw Error(\"KlickTipp login failed\");\n  const s = await login.json();\n  if (!s.session_name || !s.sessid) throw Error(\"Missing KlickTipp session\");\n  const r = await ctx.fetch(\"https://api.klicktipp.com/subscriber\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\", Cookie: s.session_name + \"=\" + s.sessid },\n    body: JSON.stringify({ smsnumber: \"+\" + to, listid: listId }),\n  });\n  if (!r.ok) throw Error(\"KlickTipp subscription result unknown\");\n  const value = await r.json();\n  if (!value?.id) throw Error(\"KlickTipp subscription result unknown\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
