    {
      "name": "Prepare outbound event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $input.first().json,\n  mode = \"direct\",\n  phone = String(x.PhoneNumber || \"\")\n    .replace(/^00/, \"\")\n    .replace(/^\\+/, \"\")\n    .replace(/\\s+/g, \"\");\nconst event = {\n  kind: \"outbound\",\n  phone,\n  name: x.CustomFieldFirstName,\n  product: x.YOUR_PRODUCT_FIELD,\n  company: x.YOUR_COMPANY_FIELD,\n  link: x.YOUR_LINK_FIELD,\n};\nif (\n  !/^\\d{7,15}$/.test(phone) ||\n  [event.name, event.product, event.company, event.link].some((x) => typeof x !== \"string\" || !x)\n)\n  throw Error(\"Configure outbound fields\");\nreturn [{ json: { event, mode } }];\n"
      },
      "id": "klicktipp-whatsapp-offers-and-opt-outs-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Normalize incoming messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const mode = \"direct\",\n  out = [];\nfor (const item of $input.all()) {\n  const e = item.json,\n    contacts = e.contacts || [];\n  for (const m of e.messages || []) {\n    if (m.type !== \"text\" || typeof m.text?.body !== \"string\") continue;\n    const phone = String(m.from || \"\").replace(/^\\+/, \"\");\n    if (!m.id || !/^\\d{7,15}$/.test(phone)) throw Error(\"Missing message ID or phone\");\n    const c = contacts.find((x) => x.wa_id === m.from);\n    if (!c) throw Error(\"No matching WhatsApp contact\");\n    out.push({\n      json: {\n        event: { kind: \"inbound\", id: m.id, phone, name: c.profile?.name || \"\", text: m.text.body },\n        mode,\n      },\n    });\n  }\n}\nreturn out;\n"
      },
      "id": "klicktipp-whatsapp-offers-and-opt-outs-3",
      "position": [
        660,
        0
      ]
    },
