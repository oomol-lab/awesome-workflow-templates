{
  "nodes": [
    {
      "id": "back-up-n8n-workflows-to-gitlab-0",
      "name": "Backup Now - Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        520,
        320
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "back-up-n8n-workflows-to-gitlab-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        520,
        520
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 21 * * 6"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "name": "Configure the backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function config({ owner, project, path, tag }) {\n  for (const [k, v] of Object.entries({ owner, project, path, tag }))\n    if (typeof v !== \"string\" || !v.trim() || v.startsWith(\"YOUR_\")) throw Error(\"Configure \" + k);\n  if (\n    owner.split(\"/\").some((x) => !x || x === \".\" || x === \"..\" || !/^[A-Za-z0-9_.-]+$/.test(x)) ||\n    project === \".\" ||\n    project === \"..\" ||\n    !/^[A-Za-z0-9_.-]+$/.test(project) ||\n    path.startsWith(\"/\") ||\n    path.endsWith(\"/\") ||\n    path.split(\"/\").some((x) => !x || x === \".\" || x === \"..\") ||\n    tag.split(\",\").some((x) => !x.trim())\n  )\n    throw Error(\"Invalid repository configuration\");\n  const p = \"/projects/\" + encodeURIComponent(owner + \"/\" + project);\n  return {\n    owner,\n    project,\n    path,\n    tag: tag\n      .split(\",\")\n      .map((x) => x.trim())\n      .join(\",\"),\n    projectEndpoint: p,\n    branchEndpoint: p + \"/repository/branches/main\",\n  };\n}\n\nreturn [\n  {\n    json: config({\n      owner: \"YOUR_GITLAB_OWNER\",\n      project: \"YOUR_GITLAB_PROJECT\",\n      path: \"YOUR_BACKUP_DIRECTORY\",\n      tag: \"gitlab_backup_enabled\",\n    }),\n  },\n];\n"
      },
      "id": "back-up-n8n-workflows-to-gitlab-2"
    },
    {
      "id": "back-up-n8n-workflows-to-gitlab-3",
      "name": "List the GitLab directory",
      "type": "n8n-nodes-base.gitlab",
      "position": [
        980,
        180
      ],
      "parameters": {
        "resource": "file",
        "operation": "list",
        "owner": "={{ $(\"Configure the backup\").first().json.owner }}",
        "repository": "={{ $(\"Configure the backup\").first().json.project }}",
        "filePath": "={{ $(\"Configure the backup\").first().json.path }}",
        "returnAll": true,
        "additionalParameters": {
          "ref": "main"
        }
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "back-up-n8n-workflows-to-gitlab-4",
      "name": "Read tagged workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [
        980,
        520
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "tags": "={{ $(\"Configure the backup\").first().json.tag }}"
        }
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "name": "Check backup filenames",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function plan({ state, path, projectEndpoint }) {\n  if (!Array.isArray(state.items)) throw Error(\"Invalid workflows\");\n  const seen = new Set(),\n    items = [];\n  for (const w of state.items) {\n    if (!w || typeof w.name !== \"string\" || !w.name.trim() || typeof w.id !== \"string\" || !w.id)\n      throw Error(\"Invalid workflow\");\n    const n = w.name.replace(/[^a-zA-Z0-9]/g, \"\") + \".json\";\n    if (n === \".json\" || seen.has(n)) throw Error(\"Workflow filenames collide or are empty\");\n    seen.add(n);\n    const filePath = path + \"/\" + n;\n    items.push({\n      workflow: w,\n      filePath,\n      endpoint: projectEndpoint + \"/repository/files/\" + encodeURIComponent(filePath),\n      content: JSON.stringify(w, null, 4),\n    });\n  }\n  return { items };\n}\n\nconst cfg = $(\"Configure the backup\").first().json,\n  items = $input\n    .all()\n    .map((x) => x.json)\n    .filter((x) => Object.keys(x).length);\nreturn plan({ state: { items }, path: cfg.path, projectEndpoint: cfg.projectEndpoint }).items.map(\n  (json, i) => ({ json, pairedItem: { item: i } }),\n);\n"
      },
      "id": "back-up-n8n-workflows-to-gitlab-5"
    },
    {
      "name": "Back up one workflow at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "back-up-n8n-workflows-to-gitlab-6"
    },
    {
      "name": "File already exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "exists",
              "leftValue": "={{ $(\"List the GitLab directory\").all().some(x => x.json.name === $json.filePath.split(\"/\").at(-1)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "back-up-n8n-workflows-to-gitlab-7"
    },
    {
      "id": "back-up-n8n-workflows-to-gitlab-8",
      "name": "Read the GitLab file",
      "type": "n8n-nodes-base.gitlab",
      "position": [
        1640,
        340
      ],
      "parameters": {
        "resource": "file",
        "owner": "={{ $(\"Configure the backup\").first().json.owner }}",
        "repository": "={{ $(\"Configure the backup\").first().json.project }}",
        "filePath": "={{ $(\"Back up one workflow at a time\").item.json.filePath }}",
        "operation": "get",
        "asBinaryProperty": false,
        "additionalParameters": {
          "reference": "main"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Compare the backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $input.first().json,\n  item = $(\"Back up one workflow at a time\").item.json;\nif (f.file_path !== item.filePath || f.encoding !== \"base64\" || typeof f.content !== \"string\")\n  throw Error(\"Invalid GitLab file\");\nconst bytes = Buffer.from(f.content.replace(/\\s/g, \"\"), \"base64\");\nif (\n  !bytes.length ||\n  bytes.toString(\"base64\").replace(/=+$/, \"\") !== f.content.replace(/\\s|=+$/g, \"\")\n)\n  throw Error(\"Invalid GitLab file content\");\nconst content = bytes.toString(\"utf8\");\nreturn [{ json: { changed: content !== item.content }, pairedItem: { item: 0 } }];\n"
      },
      "id": "back-up-n8n-workflows-to-gitlab-9"
    },
    {
      "name": "Backup changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "changed",
              "leftValue": "={{ $json.changed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "back-up-n8n-workflows-to-gitlab-10"
    },
    {
      "id": "back-up-n8n-workflows-to-gitlab-11",
      "name": "Create the backup file",
      "type": "n8n-nodes-base.gitlab",
