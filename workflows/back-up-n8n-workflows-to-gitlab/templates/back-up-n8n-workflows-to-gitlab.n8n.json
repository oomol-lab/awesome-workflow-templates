        "repository": "={{ $(\"Configure the backup\").first().json.project }}",
        "filePath": "={{ $(\"Back up one workflow at a time\").item.json.filePath }}",
        "operation": "edit",
        "branch": "main",
        "fileContent": "={{ $(\"Back up one workflow at a time\").item.json.content }}",
        "commitMessage": "Back up n8n workflow",
        "binaryData": false,
        "additionalParameters": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Confirm the backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json,\n  item = $(\"Back up one workflow at a time\").item.json;\nif (r.file_path !== item.filePath || r.branch !== \"main\") throw Error(\"GitLab write not confirmed\");\nreturn [{ json: r }];\n"
      },
      "id": "back-up-n8n-workflows-to-gitlab-13"
    }
