    },
    {
      "name": "Confirm the backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,item=$('Back up one workflow at a time').item.json;if(r.file_path!==item.filePath||r.branch!=='main')throw Error('GitLab write not confirmed');return [{json:r}];"
      },
      "id": "back-up-n8n-workflows-to-gitlab-13"
    }
