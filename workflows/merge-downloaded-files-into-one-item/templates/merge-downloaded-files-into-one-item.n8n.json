        "jsCode": "let binaries = {},\n  binary_keys = [];\n\nfor (const [index, inputItem] of Object.entries($input.all())) {\n  binaries[`data_${index}`] = inputItem.binary.data;\n  binary_keys.push(`data_${index}`);\n}\n\nreturn [\n  {\n    json: {\n      binary_keys: binary_keys.join(\",\"),\n    },\n    binary: binaries,\n  },\n];\n"
