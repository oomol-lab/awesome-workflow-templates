    "modules": {
      "n_5ba4967b6e11b99c": {
        "name": "Download and combine files",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function merge({ urls }, context) {\n  const files = {},\n    keys = [];\n  for (let i = 0; i < urls.length; i++) {\n    const r = await context.fetch(urls[i], { method: \"GET\" });\n    if (!r.ok) throw Error(`Download ${i + 1} failed (${r.status})`);\n    const bytes = new Uint8Array(await r.arrayBuffer()),\n      key = `data_${i}`,\n      name = new URL(urls[i]).pathname.split(\"/\").pop() || key;\n    files[key] = {\n      name,\n      mimeType: r.headers.get(\"content-type\") || \"application/octet-stream\",\n      contentBase64: Buffer.from(bytes).toString(\"base64\"),\n    };\n    keys.push(key);\n  }\n  return { binary_keys: keys.join(\",\"), files };\n}\n"
      }
    }
