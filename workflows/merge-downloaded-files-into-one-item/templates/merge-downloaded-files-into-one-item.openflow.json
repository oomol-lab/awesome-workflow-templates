      "n_5ba4967b6e11b99c": {
        "name": "Download and combine files",
        "imports": [],
        "source": "import{Buffer}from'node:buffer';export default async function merge({urls},context){const files={},keys=[];for(let i=0;i<urls.length;i++){const r=await context.fetch(urls[i],{method:'GET'});if(!r.ok)throw Error(`Download ${i+1} failed (${r.status})`);const bytes=new Uint8Array(await r.arrayBuffer()),key=`data_${i}`,name=new URL(urls[i]).pathname.split('/').pop()||key;files[key]={name,mimeType:r.headers.get('content-type')||'application/octet-stream',contentBase64:Buffer.from(bytes).toString('base64')};keys.push(key)}return{binary_keys:keys.join(','),files}}\n"
      }
    }
