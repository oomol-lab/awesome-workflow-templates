    "modules": {
      "n_3d3828cb0f61b3bb": {
        "name": "Prepare offers request",
        "imports": [],
        "source": "export default function f({ zone }) {\n  if (!zone || zone === \"YOUR_WEB_UNLOCKER_ZONE\") throw Error(\"Configure Bright Data zone\");\n  return {\n    body: {\n      zone,\n      url: \"https://www.mediamarkt.es/es/campaign/campanas-y-ofertas\",\n      format: \"raw\",\n      country: \"es\",\n    },\n  };\n}\n"
      },
      "n_3150426e9a50f9a9": {
        "name": "Read requested categories",
