        "name": "Verify and reserve deal email",
        "imports": [],
        "source": "export default async function plan({ body, html, result, acknowledge, resolution }, ctx) {\n  const id = String(body.submissionId || \"\"),\n    email = String(body.email || \"\").trim(),\n    categories = body.categories;\n  if (\n    !id ||\n    !email ||\n    !Array.isArray(categories) ||\n    !categories.length ||\n    typeof html !== \"string\" ||\n    !Array.isArray(result?.results)\n  )\n    throw Error(\"Invalid deal request\");\n  const verified = [];\n  for (const r of result.results) {\n    const name = String(r.name || \"\").trim(),\n      price = String(r.price || \"\").trim(),\n      category = String(r.category || \"\").trim(),\n      raw = String(r.link || \"\").trim();\n    let path;\n    if (raw.startsWith(\"https://www.mediamarkt.es/\"))\n      path = raw.slice(\"https://www.mediamarkt.es\".length);\n    else if (raw.startsWith(\"/\") && !raw.startsWith(\"//\")) path = raw;\n    else continue;\n    if (\n      !name ||\n      !price ||\n      !categories.includes(category) ||\n      !html.includes(path) ||\n      !html.includes(price) ||\n      !html.includes(name)\n    )\n      continue;\n    verified.push({ name, price, category, url: \"https://www.mediamarkt.es\" + path });\n  }\n  const text = verified.length\n    ? \"Recommended deals:\\n\\n\" +\n      verified.map((x) => `${x.category}: ${x.name} — ${x.price}\\n${x.url}`).join(\"\\n\\n\")\n    : \"No verifiable deals were found in the selected categories.\";\n  const key = \"deals:\" + id,\n    old = await ctx.state.get(key),\n    skip = { send: false, key, to: email, text, count: verified.length };\n  if (old?.status === \"done\") return skip;\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending deal email \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return skip;\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { send: true, key, to: email, text, count: verified.length };\n}\n"
      },
      "n_6672f82e0f3bf0ec": {
        "name": "Confirm deal email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown email result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_40db27132455ff97": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f({ count }) {\n  return { body: JSON.stringify({ status: \"completed\", count }) };\n}\n"
      }
    }
  },
