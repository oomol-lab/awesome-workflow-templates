    {
      "name": "Read classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let r;\ntry {\n  r = JSON.parse(\n    String($json.output ?? \"\")\n      .trim()\n      .replace(/^```(?:json)?\\s*|\\s*```$/g, \"\"),\n  );\n} catch {\n  throw Error(\"Invalid classification JSON\");\n}\nif (typeof r.interested !== \"boolean\" || typeof r.reason !== \"string\")\n  throw Error(\"Invalid classification fields\");\nreturn { json: { interested: r.interested }, pairedItem: { item: $itemIndex } };\n"
