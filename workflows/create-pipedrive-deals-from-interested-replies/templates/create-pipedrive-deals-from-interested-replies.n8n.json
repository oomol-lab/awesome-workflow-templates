      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.pipedrive.com/api/v2/persons/'+$json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "custom_fields",
              "value": "YOUR_CAMPAIGN_FIELD_KEY"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
