    {
      "name": "Configure retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    mailbox: \"INBOX_1\",\n    id: \"YOUR_MESSAGE_ID\",\n    from: { value: [{ address: \"sender@example.invalid\" }] },\n    text: \"ORIGINAL_UNQUOTED_REPLY\",\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "campaign-reply-5",
      "position": [
        1125,
        0
      ]
    },
    {
      "name": "Extract sender and reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = String($json.id ?? \"\"),\n  mailbox = $json.mailbox,\n  email = $json.from?.value?.[0]?.address?.toLowerCase();\nif (!id || ![\"INBOX_1\", \"INBOX_2\"].includes(mailbox) || !email || typeof $json.text !== \"string\")\n  throw Error(\"Missing inbox, message, sender or text\");\nconst lines = [];\nfor (const line of $json.text.split(/\\r?\\n/)) {\n  if (\n    /^On .+wrote:\\s*$/i.test(line.trim()) ||\n    /^\\s*>/.test(line) ||\n    /^[- ]{2,}Original Message[- ]*$/i.test(line.trim())\n  )\n    break;\n  lines.push(line);\n}\nconst text = lines.join(\"\\n\").trim();\nif (!text || text.length > 14800) throw Error(\"Reply is empty or too long\");\nreturn { json: { id, mailbox, email, text }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "campaign-reply-6",
      "position": [
        1350,
        0
      ]
    },
    {
      "name": "Read reply checkpoint",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'campaign-reply:'+$('Extract sender and reply').item.json.mailbox+':'+$('Extract sender and reply').item.json.id }}"
            }
          ]
        },
        "operation": "get"
      },
      "alwaysOutputData": true,
      "id": "campaign-reply-7",
      "position": [
        1575,
        0
      ]
    },
    {
      "name": "Check reply checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect pending Pipedrive deal\");\nif ($json.status && $json.status !== \"done\") throw Error(\"Invalid checkpoint\");\nreturn { json: { skip: $json.status === \"done\" }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "campaign-reply-8",
      "position": [
        1800,
        0
      ]
    },
    {
      "name": "Already processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "campaign-reply-9",
      "position": [
        2025,
        0
      ]
    },
    {
      "name": "Find campaign contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://api.pipedrive.com/api/v2/persons/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "term",
              "value": "={{ $('Extract sender and reply').item.json.email }}"
            },
            {
              "name": "fields",
              "value": "email"
            },
            {
              "name": "exact_match",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "2"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "campaign-reply-10",
      "position": [
        2250,
        0
      ]
    },
    {
      "name": "Verify contact match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $json.data?.items,\n  c = $json.additional_data?.next_cursor,\n  email = $(\"Extract sender and reply\").item.json.email;\nif (!Array.isArray(a)) throw Error(\"Invalid Pipedrive search\");\nif (c || a.length > 1) throw Error(\"Ambiguous contact\");\nif (!a.length) return { json: { matched: false }, pairedItem: { item: $itemIndex } };\nconst p = a[0].item;\nif (!p?.id || !p.emails?.some((x) => x.toLowerCase() === email)) throw Error(\"Sender mismatch\");\nreturn { json: { matched: true, id: p.id }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "campaign-reply-11",
      "position": [
        2475,
        0
      ]
    },
    {
      "name": "Contact found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.matched }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
