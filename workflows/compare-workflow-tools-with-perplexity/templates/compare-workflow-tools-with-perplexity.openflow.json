        "name": "Extract answer and citations",
        "imports": [],
        "source": "export default function answer({ response }) {\n  const text = response?.choices?.[0]?.message?.content;\n  if (typeof text !== \"string\") throw Error(\"Missing completion text\");\n  return { output: text, citations: Array.isArray(response.citations) ? response.citations : [] };\n}\n"
