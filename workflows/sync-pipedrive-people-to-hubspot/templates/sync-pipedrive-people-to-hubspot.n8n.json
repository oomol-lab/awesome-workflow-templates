          }
        ]
      ]
    },
    "Process contacts one by one": {
      "main": [
        [],
        [
          {
            "node": "Create HubSpot contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create HubSpot contact": {
      "main": [
        [
          {
            "node": "Process contacts one by one",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Sync Pipedrive People to HubSpot",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "pinData": {}
}
