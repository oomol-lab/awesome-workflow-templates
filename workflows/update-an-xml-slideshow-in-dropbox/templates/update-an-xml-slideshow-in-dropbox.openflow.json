    "modules": {
      "n_86f1626816e9f65d": {
        "name": "Change the slideshow title",
        "imports": [],
        "source": "export default function change({ xml, title }) {\n  if (typeof xml !== \"string\" || typeof title !== \"string\" || !title)\n    throw Error(\"Provide XML and a title\");\n  const m = /<slideshow\\b([^<>]*?)>/i.exec(xml);\n  if (!m) throw Error(\"Missing slideshow root\");\n  const found = [...m[1].matchAll(/\\btitle\\s*=\\s*([\"'])(.*?)\\1/gis)];\n  if (found.length !== 1) throw Error(\"Expected one slideshow title attribute\");\n  const escaped = title\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&apos;\");\n  const attr = found[0],\n    newTag = m[0].replace(attr[0], 'title=\"' + escaped + '\"');\n  return { xml: xml.slice(0, m.index) + newTag + xml.slice(m.index + m[0].length) };\n}\n"
      }
    }
