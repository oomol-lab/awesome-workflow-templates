    "modules": {
      "n_b8d629e11cafd6c3": {
        "name": "Choose the sheet",
        "imports": [],
        "source": "export default function config({ spreadsheetId, sheetName }) {\n  if (!spreadsheetId || spreadsheetId.startsWith(\"YOUR_\") || !sheetName.trim())\n    throw Error(\"Configure spreadsheet and sheet\");\n  return { spreadsheetId, sheetName, range: \"'\" + sheetName.replace(/'/g, \"''\") + \"'!A:Z\" };\n}\n"
      },
      "n_a0e933393a9b03c8": {
        "name": "Select unprocessed companies",
        "imports": [],
        "source": "export default function prepare({ values }) {\n  if (!Array.isArray(values) || !Array.isArray(values[0]))\n    throw Error(\"Sheet must have a header row\");\n  const names = [\n      \"domain\",\n      \"name\",\n      \"description\",\n      \"processed_at\",\n      \"data\",\n      \"domain_name\",\n      \"traffic\",\n      \"location\",\n      \"funds\",\n      \"year_founded\",\n      \"funding_round\",\n      \"last_funding_at\",\n    ],\n    header = values[0],\n    columns = {};\n  for (const name of names) {\n    let indices = header.flatMap((v, i) => (v === name ? [i] : []));\n    if (indices.length !== 1) throw Error(\"Expected one \" + name + \" column\");\n    columns[name] = indices[0];\n  }\n  const rows = [];\n  for (let i = 1; i < values.length; i++) {\n    const row = values[i];\n    if (!Array.isArray(row)) throw Error(\"Invalid sheet row\");\n    const processed = row[columns.processed_at];\n    if (processed !== undefined && processed !== null && processed !== \"\") continue;\n    const domain = row[columns.domain];\n    if (typeof domain !== \"string\" || !domain.trim()) continue;\n    rows.push({ row: i + 1, domain: domain.trim() });\n  }\n  return { rows, columns };\n}\n"
      },
      "n_37df59d9e9a94aaa": {
        "name": "Choose the next company",
        "imports": [],
        "source": "export default function next({ rows, previous }) {\n  if (!Array.isArray(rows)) throw Error(\"Invalid rows\");\n  const index = previous == null ? 0 : previous.index + 1;\n  if (!Number.isInteger(index) || index < 0 || index > rows.length)\n    throw Error(\"Invalid row progress\");\n  return {\n    state: { index },\n    more: index < rows.length,\n    row: rows[index] ?? { row: 0, domain: \"\" },\n  };\n}\n"
      },
      "n_ab433f91b0692b2d": {
        "name": "Look up the company",
        "imports": [],
        "source": "export default async function lookup({ row, apiKey }, context) {\n  if (typeof apiKey !== \"string\" || !apiKey.trim()) throw Error(\"Configure ProspectLens API key\");\n  if (!row || !Number.isInteger(row.row) || typeof row.domain !== \"string\" || !row.domain)\n    throw Error(\"Invalid row\");\n  const url = \"https://prospectlens.apiroad.net/lookup?domain=\" + encodeURIComponent(row.domain);\n  for (let attempt = 0; attempt < 2; attempt++) {\n    if (attempt) await new Promise((resolve) => setTimeout(resolve, 1000));\n    try {\n      const r = await context.fetch(url, { method: \"GET\", headers: { \"x-apiroad-key\": apiKey } });\n      if (!r.ok) throw Error(\"lookup failed\");\n      const data = await r.json();\n      if (!data || typeof data !== \"object\" || Array.isArray(data)) throw Error(\"invalid JSON\");\n      return { ok: true, data };\n    } catch {}\n  }\n  return { ok: false, data: null };\n}\n"
      },
      "n_070a0759542d9d4b": {
        "name": "Prepare company fields",
        "imports": [],
        "source": "export default function map({ row, columns, response, sheetName }) {\n  if (\n    !response ||\n    typeof response !== \"object\" ||\n    !response.data ||\n    typeof response.data !== \"object\"\n  )\n    throw Error(\"ProspectLens response missing data\");\n  const d = response.data,\n    need = (path) => {\n      let v = d;\n      for (const k of path) {\n        if (\n          v === null ||\n          v === undefined ||\n          typeof v !== \"object\" ||\n          !Object.prototype.hasOwnProperty.call(v, k)\n        )\n          throw Error(\"ProspectLens response missing \" + path.join(\".\"));\n        v = v[k];\n      }\n      if (![\"string\", \"number\", \"boolean\"].includes(typeof v))\n        throw Error(\"Invalid \" + path.join(\".\"));\n      return v;\n    };\n  const vals = {\n    domain: row.domain,\n    name: need([\"properties\", \"title\"]),\n    description: need([\"properties\", \"short_description\"]),\n    processed_at: new Date().toISOString(),\n    data: JSON.stringify(d).substr(0, 2000),\n    domain_name: need([\"info\", \"company_about_fields\", \"website\", \"hostname\"]),\n    traffic: need([\"info\", \"semrush_summary\", \"semrush_visits_latest_month\"]),\n    location: need([\"info\", \"semrush_location_list\", \"0\", \"location_identifiers\", \"0\", \"value\"]),\n    funds: need([\"info\", \"funding_rounds_summary\", \"funding_total\", \"value\"]),\n    year_founded: need([\"info\", \"overview_fields_extended\", \"founded_on\", \"value\"]),\n    funding_round: need([\"info\", \"funding_rounds_summary\", \"last_funding_type\"]),\n    last_funding_at: need([\"info\", \"funding_rounds_summary\", \"last_funding_at\"]),\n  };\n  if (\n    typeof sheetName !== \"string\" ||\n    !sheetName.trim() ||\n    !Number.isInteger(row.row) ||\n    row.row < 2\n  )\n    throw Error(\"Invalid sheet location\");\n  const name = \"'\" + sheetName.replace(/'/g, \"''\") + \"'\",\n    col = (i) => {\n      if (!Number.isInteger(i) || i < 0 || i >= 26) throw Error(\"Column outside A:Z\");\n      return String.fromCharCode(65 + i);\n    };\n  const data = Object.entries(vals).map(([key, value]) => ({\n    range: `${name}!${col(columns[key])}${row.row}`,\n    majorDimension: \"ROWS\",\n    values: [[value]],\n  }));\n  return { data };\n}\n"
      },
      "n_0269aa9e11876606": {
        "name": "Continue to the next company",
        "imports": [],
        "source": "export default function advance() {\n  return {};\n}\n"
      },
      "n_f7260d68632ee2c8": {
        "name": "Confirm the row update",
        "imports": [],
        "source": "export default function confirm({ spreadsheetId, expectedId, totalUpdatedCells }) {\n  if (spreadsheetId !== expectedId || totalUpdatedCells !== 12)\n    throw Error(\"Sheet update not confirmed\");\n  return { ok: true };\n}\n"
      }
    }
