    {
      "id": "turn-support-gmail-into-linear-issues-2",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        480,
        40
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"labels\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"Technical\",\"Account\",\"Access\",\"Billing\",\"Product\",\"Training\",\"Feedback\",\"Complaints\",\"Security\",\"Privacy\"]},\"minItems\":1},\"priority\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"summary\":{\"type\":\"string\",\"minLength\":1},\"description\":{\"type\":\"string\",\"minLength\":1}},\"required\":[\"labels\",\"priority\",\"summary\",\"description\"],\"additionalProperties\":false}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "turn-support-gmail-into-linear-issues-3",
      "name": "Markdown",
      "type": "n8n-nodes-base.markdown",
      "position": [
        100,
        -140
      ],
      "parameters": {
        "html": "={{ $json.html }}",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "turn-support-gmail-into-linear-issues-4",
      "name": "Check message state",
      "type": "n8n-nodes-base.code",
      "position": [
        -220,
        -140
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $input.item.json;\nif (typeof m.id !== \"string\" || !m.id) throw Error(\"Invalid Gmail message ID\");\nconst state = $getWorkflowStaticData(\"global\"),\n  seen = state.supportMessageIds ?? [];\nif (!Array.isArray(seen) || seen.some((x) => typeof x !== \"string\"))\n  throw Error(\"Invalid saved message IDs\");\nif (seen.includes(m.id)) return null;\nreturn $input.item;\n"
      },
      "typeVersion": 2
    },
    {
      "id": "turn-support-gmail-into-linear-issues-5",
      "name": "Generate Issue From Support Request",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        300,
        -140
      ],
      "parameters": {
        "text": "=Reported by {{ $json.from.value[0].name }} <{{ $json.from.value[0].address }}>\nReported at: {{ $now.toISO() }}\nSummary: {{ $json.subject }}\nDescription:\n{{ $json.data.replaceAll('\\n', ' ') }}",
        "messages": {
          "messageValues": [
            {
              "message": "=Your are Issues triage assistant who's task is to\n1) classify and label the given issue.\n2) Prioritise the given issue.\n3) Rewrite the issue summary and description.\n\n## Labels\nUse one or more labels.\n* Technical\n* Account\n* Access\n* Billing\n* Product\n* Training\n* Feedback\n* Complaints\n* Security\n* Privacy\n\n## Priority\n* 1 - highest\n* 2 - high\n* 3 - medium\n* 4 - low\n* 5 - lowest\n\n## Write Summary and Description\n* Remove emotional and anedotal phrases or information\n* Keep to the facts of the matter\n* Highlight what was attempted and is/was failing"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.6
    },
    {
      "id": "turn-support-gmail-into-linear-issues-6",
      "name": "Get Recent Messages",
      "type": "n8n-nodes-base.gmail",
      "position": [
        -440,
        -140
      ],
      "parameters": {
        "limit": 1,
        "simple": false,
        "filters": {
          "q": "to:YOUR_SUPPORT_EMAIL"
        },
        "options": {},
        "operation": "getAll"
      },
      "typeVersion": 2.1
    },
    {
      "id": "turn-support-gmail-into-linear-issues-7",
      "name": "Create Issue in Linear.App",
      "type": "n8n-nodes-base.linear",
      "position": [
        900,
        -140
      ],
      "parameters": {
        "title": "={{ $json.title }}",
        "teamId": "YOUR_LINEAR_TEAM_ID",
        "additionalFields": {
          "stateId": "YOUR_LINEAR_STATE_ID",
          "priorityId": "={{ $json.priority }}",
          "description": "={{ $json.description }}"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Prepare the Linear issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function fields({ result }) {\n  const allowed = [\n    \"Technical\",\n    \"Account\",\n    \"Access\",\n    \"Billing\",\n    \"Product\",\n    \"Training\",\n    \"Feedback\",\n    \"Complaints\",\n    \"Security\",\n    \"Privacy\",\n  ];\n  if (\n    !result ||\n    typeof result.summary !== \"string\" ||\n    !result.summary.trim() ||\n    typeof result.description !== \"string\" ||\n    !result.description.trim() ||\n    !Array.isArray(result.labels) ||\n    result.labels.length === 0 ||\n    result.labels.some((x) => !allowed.includes(x)) ||\n    !Number.isInteger(result.priority) ||\n    result.priority < 1 ||\n    result.priority > 5\n  )\n    throw Error(\"Invalid triage result\");\n  return {\n    title: result.summary,\n    description: result.description + \"\\n\\n\" + result.labels.map((x) => \"#\" + x).join(\" \"),\n    priority: Math.min(result.priority, 4),\n  };\n}\n\nreturn $input\n  .all()\n  .map((x, i) => ({ json: fields({ result: x.json.output }), pairedItem: { item: i } }));\n"
      },
      "id": "turn-support-gmail-into-linear-issues-8"
    },
    {
      "name": "Remember the processed email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const issue = $input.item.json,\n  id = $(\"Get Recent Messages\").item.json.id;\nif (typeof issue.id !== \"string\" || !issue.id || typeof id !== \"string\" || !id)\n  throw Error(\"Issue was not confirmed\");\nconst state = $getWorkflowStaticData(\"global\"),\n  seen = state.supportMessageIds ?? [];\nif (!Array.isArray(seen) || seen.some((x) => typeof x !== \"string\"))\n  throw Error(\"Invalid saved message IDs\");\nif (!seen.includes(id)) state.supportMessageIds = [...seen, id];\nreturn $input.item;\n"
      },
      "id": "turn-support-gmail-into-linear-issues-9"
    }
  ],
