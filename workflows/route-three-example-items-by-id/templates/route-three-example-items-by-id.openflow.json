      "n_7ea36e4456d64d3a": {
        "name": "Route and name items",
        "imports": [],
        "source": "export default function routes() {\n  const items = [{ id: 0 }, { id: 1 }, { id: 2 }],\n    zero = [],\n    one = [],\n    two = [],\n    other = [];\n  for (const item of items) {\n    if (item.id === 0) zero.push({ ...item, name: \"n8n\" });\n    else if (item.id === 1) one.push({ ...item, name: \"nodemation\" });\n    else if (item.id === 2) two.push({ ...item, name: \"nathan\" });\n    else other.push(item);\n  }\n  return { zero, one, two, other };\n}\n"
      }
    }
