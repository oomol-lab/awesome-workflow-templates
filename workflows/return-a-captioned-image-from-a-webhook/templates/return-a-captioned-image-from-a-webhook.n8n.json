{
  "name": "Return a Captioned Image from a Webhook",
  "nodes": [
    {
      "id": "return-a-captioned-image-from-a-webhook-hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "name": "Receive the name from GET",
      "parameters": {
        "httpMethod": "GET",
        "path": "test",
        "responseMode": "lastNode",
        "responseData": "firstEntryBinary",
        "responseBinaryPropertyName": "data",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Cache-Control",
                "value": "no-store"
              }
            ]
          }
        }
      },
      "position": [
        0,
        240
      ]
    },
    {
      "id": "return-a-captioned-image-from-a-webhook-caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Build the caption",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function makeCaption(value) {\n  const name = typeof value === \"string\" ? value.trim().normalize(\"NFC\") : \"\";\n  if (!/^[\\p{L}\\p{M}][\\p{L}\\p{M} .’'-]{0,39}$/u.test(name)) {\n    throw Error(\"Use one name of up to 40 letters, spaces, periods, apostrophes or hyphens.\");\n  }\n  return \"They found the killer it was \" + name + \"!\";\n}\nreturn [{ json: { text: makeCaption($input.first().json.query?.name) } }];\n"
      },
      "position": [
        225,
        240
      ]
    },
    {
      "id": "return-a-captioned-image-from-a-webhook-download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "name": "Download the configured background",
      "parameters": {
        "method": "GET",
        "url": "https://images.example.invalid/background.jpg",
        "authentication": "none",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "file",
              "fullResponse": true,
              "outputPropertyName": "data"
            }
          }
        }
      },
      "position": [
        450,
        240
      ]
    },
    {
      "id": "return-a-captioned-image-from-a-webhook-validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "name": "Check the background image",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function checkedImage(item, bytes) {\n  const mime = String(item.binary?.data?.mimeType ?? \"\")\n    .toLowerCase()\n    .split(\";\", 1)[0]\n    .trim();\n  if (\n    item.json.statusCode !== 200 ||\n    bytes.length < 24 ||\n    bytes.length > 6291456 ||\n    !(\n      (mime === \"image/jpeg\" &&\n        bytes[0] === 255 &&\n        bytes[1] === 216 &&\n        bytes[2] === 255 &&\n        bytes.at(-2) === 255 &&\n        bytes.at(-1) === 217) ||\n      (mime === \"image/png\" &&\n        bytes[0] === 137 &&\n        bytes.subarray(1, 8).equals(Buffer.from([80, 78, 71, 13, 10, 26, 10])) &&\n        bytes.subarray(-8, -4).toString(\"ascii\") === \"IEND\")\n    )\n  ) {\n    throw Error(\"The source must return a complete JPEG or PNG up to 6 MiB.\");\n  }\n}\nconst item = $input.first();\nconst bytes = await helpers.getBinaryDataBuffer(0, \"data\");\ncheckedImage(item, bytes);\nreturn [\n  {\n    json: { text: $(\"Build the caption\").first().json.text },\n    binary: item.binary,\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "position": [
        675,
        240
      ]
    },
    {
      "id": "return-a-captioned-image-from-a-webhook-draw",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "name": "Draw the caption onto the image",
      "parameters": {
        "operation": "text",
        "dataPropertyName": "data",
        "text": "={{ $json.text }}",
        "fontSize": 25,
        "fontColor": "#000000",
        "positionX": 150,
        "positionY": 180,
        "lineLength": 18,
        "options": {
          "format": "jpeg",
          "fileName": "captioned.jpg"
        }
      },
      "position": [
        900,
        240
      ]
    }
  ],
  "connections": {
    "Receive the name from GET": {
      "main": [
        [
          {
            "node": "Build the caption",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build the caption": {
      "main": [
        [
          {
            "node": "Download the configured background",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download the configured background": {
      "main": [
        [
          {
            "node": "Check the background image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check the background image": {
      "main": [
        [
          {
            "node": "Draw the caption onto the image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
