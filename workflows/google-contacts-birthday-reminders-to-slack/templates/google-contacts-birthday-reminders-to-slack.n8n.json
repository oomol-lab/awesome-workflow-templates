    {
      "id": "google-contacts-birthday-reminders-to-slack-2",
      "name": "Find today’s birthdays",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function findBirthdays({ state, scheduledAt }) {\n  const people = state.people;\n  const now = new Date(scheduledAt);\n  if (!Number.isFinite(now.getTime())) throw Error(\"Invalid schedule time\");\n  const month = now.getUTCMonth() + 1,\n    day = now.getUTCDate(),\n    matches = [];\n  for (const person of people) {\n    if (!person || typeof person !== \"object\") throw Error(\"Invalid contact\");\n    const birthdays = person.birthdays ?? [];\n    if (!Array.isArray(birthdays)) throw Error(\"Invalid contact birthdays\");\n    if (!birthdays.some((b) => b?.date?.month === month && b?.date?.day === day)) continue;\n    const names = Array.isArray(person.names) ? person.names : [],\n      primary = names.find((n) => n?.metadata?.primary) || names[0],\n      nickname = Array.isArray(person.nicknames) ? person.nicknames[0]?.value : undefined;\n    const name =\n      primary?.displayName ||\n      [primary?.givenName, primary?.familyName].filter(Boolean).join(\" \") ||\n      nickname ||\n      \"your friend\";\n    matches.push({ name: String(name) });\n  }\n  return { matches };\n}\n\nreturn findBirthdays({\n  state: { people: $input.all().map((x) => x.json) },\n  scheduledAt: new Date().toISOString(),\n}).matches.map((json) => ({ json }));\n"
      }
    },
    {
      "id": "google-contacts-birthday-reminders-to-slack-3",
      "name": "Slack",
      "type": "n8n-nodes-base.slack",
      "notes": "Reminds to the birthday message",
      "position": [
        1020,
        60
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
