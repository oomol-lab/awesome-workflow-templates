    "modules": {
      "n_0658d3e7a82df6fa": {
        "name": "Read every contacts page",
        "imports": [],
        "source": "export default async function collect(\n  { clientId, clientSecret, refreshToken, previousState },\n  context,\n) {\n  for (const [name, v] of Object.entries({ clientId, clientSecret, refreshToken }))\n    if (typeof v !== \"string\" || !v.trim()) throw Error(\"Configure Google OAuth \" + name);\n  const state = previousState === null ? { people: [], cursor: null, seen: [] } : previousState;\n  if (\n    !state ||\n    !Array.isArray(state.people) ||\n    !Array.isArray(state.seen) ||\n    (state.cursor !== null && typeof state.cursor !== \"string\")\n  )\n    throw Error(\"Invalid contact pagination state\");\n  const form = new URLSearchParams({\n    client_id: clientId,\n    client_secret: clientSecret,\n    refresh_token: refreshToken,\n    grant_type: \"refresh_token\",\n  });\n  const auth = await context.fetch(\"https://oauth2.googleapis.com/token\", {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: form.toString(),\n  });\n  if (!auth.ok) throw Error(\"Google OAuth refresh failed\");\n  const credential = await auth.json();\n  if (typeof credential.access_token !== \"string\" || !credential.access_token)\n    throw Error(\"Google OAuth refresh returned no access token\");\n  const url = new URL(\"https://people.googleapis.com/v1/people/me/connections\");\n  url.searchParams.set(\"personFields\", \"names,nicknames,birthdays\");\n  url.searchParams.set(\"pageSize\", \"100\");\n  if (state.cursor !== null) url.searchParams.set(\"pageToken\", state.cursor);\n  const response = await context.fetch(url.toString(), {\n    headers: { authorization: \"Bearer \" + credential.access_token },\n  });\n  if (!response.ok) throw Error(\"Google Contacts page failed\");\n  const result = await response.json();\n  if (result.connections !== undefined && !Array.isArray(result.connections))\n    throw Error(\"Invalid Google Contacts page\");\n  const people = state.people.concat(result.connections ?? []),\n    next = result.nextPageToken;\n  if (next === undefined) return { state: { people, cursor: null, seen: state.seen }, more: false };\n  if (typeof next !== \"string\" || next.length === 0 || state.seen.includes(next))\n    throw Error(\"Invalid or repeated Google Contacts page token\");\n  return { state: { people, cursor: next, seen: state.seen.concat(next) }, more: true };\n}\n"
      },
      "n_cfe69fec56d4f932": {
        "name": "Find today’s birthdays",
        "imports": [],
        "source": "export default function findBirthdays({ state, scheduledAt }) {\n  const people = state.people;\n  const now = new Date(scheduledAt);\n  if (!Number.isFinite(now.getTime())) throw Error(\"Invalid schedule time\");\n  const month = now.getUTCMonth() + 1,\n    day = now.getUTCDate(),\n    matches = [];\n  for (const person of people) {\n    if (!person || typeof person !== \"object\") throw Error(\"Invalid contact\");\n    const birthdays = person.birthdays ?? [];\n    if (!Array.isArray(birthdays)) throw Error(\"Invalid contact birthdays\");\n    if (!birthdays.some((b) => b?.date?.month === month && b?.date?.day === day)) continue;\n    const names = Array.isArray(person.names) ? person.names : [],\n      primary = names.find((n) => n?.metadata?.primary) || names[0],\n      nickname = Array.isArray(person.nicknames) ? person.nicknames[0]?.value : undefined;\n    const name =\n      primary?.displayName ||\n      [primary?.givenName, primary?.familyName].filter(Boolean).join(\" \") ||\n      nickname ||\n      \"your friend\";\n    matches.push({ name: String(name) });\n  }\n  return { matches };\n}\n"
      },
      "n_5367fabbcad6106a": {
        "name": "Prepare the next reminder",
        "imports": [],
        "source": "export default function next({ matches, channelId, previousState }) {\n  if (typeof channelId !== \"string\" || !channelId.trim() || channelId.includes(\"YOUR_\"))\n    throw Error(\"Configure a Slack channel ID\");\n  const index = previousState === null ? 0 : previousState.index + 1;\n  if (index >= matches.length)\n    return {\n      state: { index },\n      more: false,\n      channelId: channelId.trim(),\n      text: \"Todays Birthday of your friend\",\n      blocks: [{ type: \"section\", text: { type: \"plain_text\", text: \"No birthday\" } }],\n      count: matches.length,\n    };\n  const name = matches[index].name;\n  return {\n    state: { index },\n    more: true,\n    channelId: channelId.trim(),\n    text: \"Todays Birthday of your friend\",\n    blocks: [\n      { type: \"section\", text: { type: \"plain_text\", text: `Today is ${name}'s birthday! 🎉` } },\n    ],\n    count: matches.length,\n  };\n}\n"
      }
    }
