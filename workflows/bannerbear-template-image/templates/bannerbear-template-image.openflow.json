    "modules": {
      "n_ec4019825417e3bd": {
        "name": "Confirm completed image",
        "imports": [],
        "source": "function readBannerbearImage(image) {\n  if (\n    !image ||\n    typeof image !== \"object\" ||\n    Array.isArray(image) ||\n    image.status !== \"completed\" ||\n    typeof image.uid !== \"string\" ||\n    !image.uid.trim() ||\n    typeof image.image_url !== \"string\" ||\n    !image.image_url.trim()\n  ) {\n    throw new Error(\"Bannerbear did not return a completed image with a UID and media URL\");\n  }\n  return image;\n}\nexport default async function bannerbearResult({ image }) {\n  return { image: readBannerbearImage(image) };\n}\n"
      }
