{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "bannerbear-template-image-trigger"
    },
    {
      "id": "bannerbear-template-image-render",
      "name": "Render Bannerbear image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sync.api.bannerbear.com/v2/images",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"template\":\"YOUR_TEMPLATE_UID\",\"modifications\":[{\"name\":\"message\",\"text\":\"Your announcement\",\"color\":\"#3097BC\",\"background\":\"#28A96F\"}]}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      }
    },
    {
      "id": "bannerbear-template-image-check",
      "name": "Confirm completed image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function readBannerbearImage(image) {\n  if (\n    !image ||\n    typeof image !== \"object\" ||\n    Array.isArray(image) ||\n    image.status !== \"completed\" ||\n    typeof image.uid !== \"string\" ||\n    !image.uid.trim() ||\n    typeof image.image_url !== \"string\" ||\n    !image.image_url.trim()\n  ) {\n    throw new Error(\"Bannerbear did not return a completed image with a UID and media URL\");\n  }\n  return image;\n}\nasync function bannerbearResult({ image }) {\n  return { image: readBannerbearImage(image) };\n}\n\nreturn { json: readBannerbearImage($json.body) };\n"
      }
    }
  ],
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Render Bannerbear image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Bannerbear image": {
      "main": [
        [
          {
            "node": "Confirm completed image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Bannerbear Template Image",
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
