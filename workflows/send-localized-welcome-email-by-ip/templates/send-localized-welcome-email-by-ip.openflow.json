    "modules": {
      "n_285db7a3349f335e": {
        "name": "Prepare IP lookup",
        "imports": [],
        "source": "export default function prepare({ ip }) {\n  if (typeof ip !== \"string\" || !ip) throw Error(\"Enter an IP address\");\n  return { body: { processor: \"get-location-by-ip\", params: { ip } } };\n}\n"
      },
      "n_0efaab32259edc05": {
        "name": "Prepare next welcome email",
        "imports": [],
        "source": "export default function next({ body, previousState, response, email, from }) {\n  const rows = Array.isArray(body) ? body : [body],\n    list = [\n      ...rows.filter((x) => x?.message?.country_code === \"ES\"),\n      ...rows.filter((x) => x?.message?.country_code !== \"ES\"),\n    ],\n    state = previousState ?? { index: 0, responses: [] };\n  if (previousState) {\n    state.responses.push(response);\n    state.index++;\n  }\n  if (state.index > list.length) throw Error(\"Invalid result state\");\n  if (state.index === list.length)\n    return {\n      state,\n      more: false,\n      to: email,\n      from,\n      subject: \"unused\",\n      message: \"unused\",\n      count: state.index,\n      responses: state.responses,\n    };\n  const spanish = list[state.index]?.message?.country_code === \"ES\";\n  return {\n    state,\n    more: true,\n    to: email,\n    from,\n    subject: spanish ? \"Bienvenido a bordo\" : \"Welcome aboard\",\n    message: spanish ? \"Hola,\\n\\n¡Gracias por registrarte!\" : \"Hi,\\n\\nThank you for your signup!\",\n    count: state.index,\n    responses: state.responses,\n  };\n}\n"
      },
      "n_464049c050e09fa8": {
        "name": "Sign SES request",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nexport default function sign({\n  to,\n  from,\n  subject,\n  message,\n  region,\n  accessKeyId,\n  secretAccessKey,\n  sessionToken,\n}) {\n  for (const [name, v] of Object.entries({ to, from, region, accessKeyId, secretAccessKey }))\n    if (typeof v !== \"string\" || !v) throw Error(\"Configure \" + name);\n  if (!/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region)) throw Error(\"Invalid AWS region\");\n  const host = \"email.\" + region + \".amazonaws.com\" + (region.startsWith(\"cn-\") ? \".cn\" : \"\"),\n    path = \"/v2/email/outbound-emails\",\n    body = JSON.stringify({\n      FromEmailAddress: from,\n      Destination: { ToAddresses: [to] },\n      Content: {\n        Simple: {\n          Subject: { Data: subject, Charset: \"UTF-8\" },\n          Body: { Text: { Data: message, Charset: \"UTF-8\" } },\n        },\n      },\n    }),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8),\n    headers = {\n      \"content-type\": \"application/json\",\n      host,\n      \"x-amz-date\": timestamp,\n      ...(sessionToken ? { \"x-amz-security-token\": sessionToken } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signedHeaders = names.join(\";\"),\n    canonicalHeaders = names\n      .map((k) => k + \":\" + headers[k].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\"),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, v) => createHmac(\"sha256\", k).update(v).digest(),\n    scope = date + \"/\" + region + \"/ses/aws4_request\",\n    canonical = [\"POST\", path, \"\", canonicalHeaders, signedHeaders, hash(body)].join(\"\\n\"),\n    toSign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    key = hmac(hmac(hmac(hmac(\"AWS4\" + secretAccessKey, date), region), \"ses\"), \"aws4_request\"),\n    sig = createHmac(\"sha256\", key).update(toSign).digest(\"hex\");\n  delete headers.host;\n  headers.authorization =\n    \"AWS4-HMAC-SHA256 Credential=\" +\n    accessKeyId +\n    \"/\" +\n    scope +\n    \", SignedHeaders=\" +\n    signedHeaders +\n    \", Signature=\" +\n    sig;\n  return {\n    url: \"https://\" + host + path,\n    authorization: headers.authorization,\n    amzDate: timestamp,\n    body,\n  };\n}\n"
      }
    }
  },
