    "modules": {
      "n_285db7a3349f335e": {
        "name": "Prepare IP lookup",
        "imports": [],
        "source": "export default function prepare({ip}){if(typeof ip!=='string'||!ip)throw Error('Enter an IP address');return{body:{processor:'get-location-by-ip',params:{ip}}}}\n"
      },
      "n_0efaab32259edc05": {
        "name": "Prepare next welcome email",
        "imports": [],
        "source": "export default function next({body,previousState,response,email,from}){const rows=Array.isArray(body)?body:[body],list=[...rows.filter(x=>x?.message?.country_code==='ES'),...rows.filter(x=>x?.message?.country_code!=='ES')],state=previousState??{index:0,responses:[]};if(previousState){state.responses.push(response);state.index++}if(state.index>list.length)throw Error('Invalid result state');if(state.index===list.length)return{state,more:false,to:email,from,subject:'unused',message:'unused',count:state.index,responses:state.responses};const spanish=list[state.index]?.message?.country_code==='ES';return{state,more:true,to:email,from,subject:spanish?'Bienvenido a bordo':'Welcome aboard',message:spanish?'Hola,\\n\\n¡Gracias por registrarte!':'Hi,\\n\\nThank you for your signup!',count:state.index,responses:state.responses}}\n"
      },
      "n_464049c050e09fa8": {
        "name": "Sign SES request",
        "imports": [],
        "source": "import{createHash,createHmac}from'node:crypto';\nexport default function sign({to,from,subject,message,region,accessKeyId,secretAccessKey,sessionToken}){for(const [name,v]of Object.entries({to,from,region,accessKeyId,secretAccessKey}))if(typeof v!=='string'||!v)throw Error('Configure '+name);if(!/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))throw Error('Invalid AWS region');const host='email.'+region+'.amazonaws.com'+(region.startsWith('cn-')?'.cn':''),path='/v2/email/outbound-emails',body=JSON.stringify({FromEmailAddress:from,Destination:{ToAddresses:[to]},Content:{Simple:{Subject:{Data:subject,Charset:'UTF-8'},Body:{Text:{Data:message,Charset:'UTF-8'}}}}}),timestamp=new Date().toISOString().replace(/[:-]|\\.\\d{3}/g,''),date=timestamp.slice(0,8),headers={'content-type':'application/json',host,'x-amz-date':timestamp,...(sessionToken?{'x-amz-security-token':sessionToken}:{})},names=Object.keys(headers).sort(),signedHeaders=names.join(';'),canonicalHeaders=names.map(k=>k+':'+headers[k].trim().replace(/\\s+/g,' ')+'\\n').join(''),hash=x=>createHash('sha256').update(x).digest('hex'),hmac=(k,v)=>createHmac('sha256',k).update(v).digest(),scope=date+'/'+region+'/ses/aws4_request',canonical=['POST',path,'',canonicalHeaders,signedHeaders,hash(body)].join('\\n'),toSign=['AWS4-HMAC-SHA256',timestamp,scope,hash(canonical)].join('\\n'),key=hmac(hmac(hmac(hmac('AWS4'+secretAccessKey,date),region),'ses'),'aws4_request'),sig=createHmac('sha256',key).update(toSign).digest('hex');delete headers.host;headers.authorization='AWS4-HMAC-SHA256 Credential='+accessKeyId+'/'+scope+', SignedHeaders='+signedHeaders+', Signature='+sig;return{url:'https://'+host+path,authorization:headers.authorization,amzDate:timestamp,body}}\n"
      }
    }
