        "name": "Prepare section context",
        "imports": [],
        "source": "export default function ({ initial, previous }) {\n  const index = (previous?.index ?? -1) + 1,\n    more = index < initial.sections.length,\n    section = more ? initial.sections[index] : \"\";\n  const prompt = `<document> \\n${initial.document}\\n</document> \\nHere is the chunk we want to situate within the whole document \\n<chunk> \\n${section}\\n</chunk> \\nPlease give a short succinct context to situate this chunk within the overall document for the purposes of improving search retrieval of the chunk. Answer only with the succinct context and nothing else.`;\n  return {\n    state: { index },\n    more,\n    section,\n    body: { model: initial.model, messages: [{ role: \"user\", content: prompt }] },\n  };\n}\n"
      },
      "n_359f4927ad1bd9da": {
        "name": "Combine context and section",
        "imports": [],
        "source": "export default function ({ body, section }) {\n  const text = body?.choices?.[0]?.message?.content;\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"OpenRouter did not return context\");\n  return { text: text + \". \" + section };\n}\n"
      },
      "n_f6d0044c1625d28f": {
        "name": "Prepare Pinecone vector",
        "imports": [],
        "source": "import { randomUUID } from \"node:crypto\";\nexport default function ({ embedding, text, fileId, index }) {\n  if (embedding.length !== 3072) throw Error(\"Expected a 3072-dimensional Gemini vector\");\n  return {\n    vectors: [\n      {\n        id: randomUUID(),\n        values: embedding,\n        metadata: { text, documentId: fileId, sectionIndex: index },\n      },\n    ],\n  };\n}\n"
      }
    }
  },
