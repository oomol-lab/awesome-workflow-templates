      "n_6844ffd118493f70": {
        "name": "Split document sections",
        "imports": [],
        "source": "export default function ({ body, model }) {\n  if (typeof body?.text !== \"string\") throw Error(\"Drive relay did not return document text\");\n  const sections = body.text.split(\n    \"—---------------------------—-------------[SECTIONEND]—---------------------------—-------------\",\n  );\n  return { initial: { sections, document: JSON.stringify(sections), model } };\n}\n"
      },
