        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {receive_id:$json.chat_id,msg_type:'text',content:JSON.stringify({text:$json.text})} }}",
        "options": {}
