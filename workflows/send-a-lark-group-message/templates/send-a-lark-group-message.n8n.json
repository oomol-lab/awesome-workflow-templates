      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function check({response}){if(response?.code!==0||!response?.data?.message_id)throw Error('Lark did not confirm the message; check the chat before retrying');return{result:response}}\n\nreturn {json:check({response:$json}).result};"
      },
      "id": "send-a-lark-group-message-3"
