    "modules": {
      "n_47ac76692947d936": {
        "name": "Check the authorized command",
        "imports": [],
        "source": "export default function telegramReleaseCommand({body,allowedChatId,allowedUserId}) {\n const message=body?.message,text=message?.text;if(typeof text!=='string'||!text.includes('/deploy'))return {run:false,tag:'skipped'};\n for(const [name,value] of Object.entries({allowedChatId,allowedUserId}))if(typeof value!=='string'||!/^\\-?\\d{1,20}$/.test(value))throw new Error('Configure '+name+' as a numeric Telegram ID.');\n if(!Number.isSafeInteger(message?.chat?.id)||!Number.isSafeInteger(message?.from?.id))throw new Error('The command needs its Telegram chat and sender IDs.');\n if(String(message.chat.id)!==allowedChatId||String(message.from.id)!==allowedUserId)return {run:false,tag:'skipped'};\n const tag=text.split(' ')[1];if(typeof tag!=='string'||!tag.trim())throw new Error('The deploy message needs a nonempty second space-separated field.');return {run:true,tag};\n}\n"
      },
      "n_05ce40d1b3323048": {
        "name": "Skip other messages",
        "imports": [],
        "source": "export default function(){return {result:{status:\"skipped\"}};}"
      },
      "n_83d6d2bad1507034": {
        "name": "Confirm the published release",
        "imports": [],
        "source": "export default function confirmTelegramRelease({release,tag}) {\n if(!release||typeof release!=='object'||!Number.isSafeInteger(release.id)||release.id<=0||release.tag_name!==tag||release.draft!==false)throw new Error('GitHub did not confirm the published release; inspect GitHub before replaying.');\n return {result:{status:'published',release}};\n}\n"
      }
