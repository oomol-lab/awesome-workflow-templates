    "modules": {
      "n_504ebc26e49a45bb": {
        "name": "Set client name",
        "imports": [],
        "source": "export default function clientRequest({ name }) {\n  if (typeof name !== \"string\" || !name.trim()) throw new Error(\"Configure a nonempty client name\");\n  return { endpoint: \"/v2/clients\", body: { name } };\n}\n"
      },
      "n_b1b43aa59c466505": {
        "name": "Confirm client creation",
        "imports": [],
        "source": "export default function clientResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 201) throw new Error(\"Harvest did not confirm client creation with HTTP 201\");\n  if (\n    bodyEncoding != null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    !Number.isSafeInteger(body.id) ||\n    body.id <= 0 ||\n    typeof body.name !== \"string\"\n  )\n    throw new Error(\"Harvest returned an invalid client record\");\n  return { client: body };\n}\n"
      }
    }
