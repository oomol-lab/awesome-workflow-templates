    "modules": {
      "n_309b8fc378ba5e89": {
        "name": "Prepare Affinity organization",
        "imports": [],
        "source": "export default function organizationRequest({ name, domain }) {\n  if (typeof name !== \"string\" || !name || typeof domain !== \"string\" || !domain)\n    throw new Error(\"Configure the organization name and domain\");\n  return { endpoint: \"/organizations\", body: { name, domain } };\n}\n"
      },
      "n_b565475c562a4673": {
        "name": "Confirm created organization",
        "imports": [],
        "source": "export default function organizationResult({ body, statusCode, bodyEncoding }) {\n  if (![200, 201].includes(statusCode))\n    throw new Error(\"Affinity did not return a completed organization creation response\");\n  if (\n    bodyEncoding != null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    !Number.isSafeInteger(body.id) ||\n    body.id <= 0 ||\n    typeof body.name !== \"string\"\n  )\n    throw new Error(\"Affinity returned an invalid organization record\");\n  return { organization: body };\n}\n"
      }
    }
