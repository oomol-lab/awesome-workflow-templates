      "n_9a8aec32c8346938": {
        "name": "Select city",
        "imports": [],
        "source": "export default function city({ query }) {\n  return {\n    city: typeof query.parameter === \"string\" && query.parameter ? query.parameter : \"berlin,de\",\n  };\n}\n"
      },
      "n_cb264ab3fc8e729e": {
        "name": "Format temperature",
        "imports": [],
        "source": "export default function format({ weather }) {\n  return {\n    response: `It has ${weather.main.temp}℃  and feels like ${weather.main.feels_like}℃  in ${weather.name}`,\n  };\n}\n"
      }
