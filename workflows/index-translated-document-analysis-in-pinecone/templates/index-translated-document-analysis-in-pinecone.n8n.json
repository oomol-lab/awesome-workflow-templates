      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id || $json.id !== $(\"Parsing the document\").item.json.id)\n  throw Error(\"Unexpected parse job ID\");\nif ([\"ERROR\", \"FAILED\", \"CANCELLED\", \"PARTIAL_SUCCESS\"].includes($json.status))\n  throw Error(\"Parse failed or incomplete\");\nif (![\"PENDING\", \"RUNNING\", \"SUCCESS\"].includes($json.status))\n  throw Error(\"Unexpected parse status\");\nif ($runIndex > 240) throw Error(\"Parse timed out\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
