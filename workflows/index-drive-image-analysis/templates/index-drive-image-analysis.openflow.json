    "modules": {
      "n_f249e5d72e90b3bd": {
        "name": "Prepare embedding chunks",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const document = JSON.parse(body.document);\n  if (\n    typeof document.data !== \"string\" ||\n    !document.metadata ||\n    typeof document.metadata !== \"object\"\n  )\n    throw Error(\"Missing image analysis document\");\n  const text = JSON.stringify(document),\n    chunks = [];\n  for (let offset = 0; offset < text.length; offset += 800) {\n    chunks.push(text.slice(offset, offset + 1000));\n    if (offset + 1000 >= text.length) break;\n  }\n  return {\n    body: { model: \"text-embedding-ada-002\", input: chunks },\n    chunks,\n    metadata: document.metadata,\n  };\n}\n"
      },
      "n_dba3a60ca3ea75b3": {
        "name": "Store image vectors",
        "imports": [],
        "source": "export default async function save({ response, chunks, metadata }, context) {\n  const rows = response?.data;\n  if (!Array.isArray(rows) || rows.length !== chunks.length)\n    throw Error(\"Embedding count mismatch\");\n  const entries = chunks.map((text, index) => {\n    const row = rows.find((r) => r.index === index);\n    if (\n      !Array.isArray(row?.embedding) ||\n      !row.embedding.length ||\n      row.embedding.some((n) => !Number.isFinite(n))\n    )\n      throw Error(\"Invalid embedding\");\n    return { text, metadata, embedding: row.embedding };\n  });\n  const saved = (await context.state.get(\"image-embeddings\")) ?? [];\n  await context.state.set(\"image-embeddings\", [...saved, ...entries]);\n  return { count: entries.length };\n}\n"
      }
    }
