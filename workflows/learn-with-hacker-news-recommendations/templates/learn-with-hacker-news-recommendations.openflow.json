    "modules": {
      "n_957884e3839df172": {
        "name": "Validate submission",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (\n    typeof body?.email !== \"string\" ||\n    !body.email.trim() ||\n    typeof body.submissionId !== \"string\" ||\n    !body.submissionId.trim()\n  )\n    throw Error(\"Email and submission ID required\");\n  const topic = typeof body.topic === \"string\" ? body.topic : \"\";\n  return {\n    topic,\n    email: body.email,\n    key: \"hn-learning:\" + body.submissionId,\n    url:\n      \"https://hn.algolia.com/api/v1/search?tags=ask_hn&hitsPerPage=150&query=\" +\n      encodeURIComponent(topic),\n  };\n}\n"
      },
      "n_8d0fd769e4afae73": {
        "name": "Collect story IDs",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (!Array.isArray(body?.hits)) throw Error(\"Invalid search response\");\n  return { ids: body.hits.map((h) => String(h.objectID)).filter((x) => /^\\d+$/.test(x)) };\n}\n"
      },
      "n_0c3aea159a56f664": {
        "name": "Choose story",
        "imports": [],
        "source": "export default function ({ ids, previous }) {\n  const i = previous?.i ?? 0;\n  return {\n    state: { i: i + 1, kids: previous?.kids ?? [] },\n    more: i < ids.length,\n    url: \"https://hacker-news.firebaseio.com/v0/item/\" + (ids[i] ?? \"0\") + \".json\",\n  };\n}\n"
      },
      "n_747462bc3caddbd6": {
        "name": "Collect comment IDs",
        "imports": [],
        "source": "export default function ({ body, state }) {\n  return {\n    state: { i: state.i, kids: state.kids.concat(Array.isArray(body?.kids) ? body.kids : []) },\n  };\n}\n"
      },
      "n_1dfcfcee4da64672": {
        "name": "Choose comment",
        "imports": [],
        "source": "export default function ({ state, previous }) {\n  const i = previous?.i ?? 0;\n  return {\n    state: { i: i + 1, texts: previous?.texts ?? [] },\n    more: i < state.kids.length,\n    url: \"https://hacker-news.firebaseio.com/v0/item/\" + (state.kids[i] ?? 0) + \".json\",\n  };\n}\n"
      },
      "n_8636b1061f814371": {
        "name": "Collect comment text",
        "imports": [],
        "source": "export default function ({ body, state }) {\n  return {\n    state: {\n      i: state.i,\n      texts: state.texts.concat(typeof body?.text === \"string\" ? [body.text] : []),\n    },\n  };\n}\n"
      },
      "n_d5ae3816b5fd003e": {
        "name": "Prepare comment summary",
        "imports": [],
        "source": "export default function ({ state }) {\n  return { has: state.texts.length > 0, text: state.texts.join(\"\\n\\n\"), count: state.i - 1 };\n}\n"
      },
      "n_98ace7c97576eb79": {
        "name": "Prepare email",
        "imports": [],
        "source": "export default function ({ text, count, topic }) {\n  if (!text.trim()) throw Error(\"Empty result\");\n  const e = (s) => s.replaceAll(\"&\", \"&amp;\").replaceAll(\"<\", \"&lt;\").replaceAll(\">\", \"&gt;\");\n  return {\n    html: \"<p>We read through \" + count + \" comments.</p><pre>\" + e(text) + \"</pre>\",\n    subject: \"Top HN recommendations for learning \" + topic,\n  };\n}\n"
      },
      "n_3a58ea0abab337d2": {
        "name": "Reserve email",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  const s = await ctx.state.get(key);\n  if (s) throw Error(\"Submission already pending or sent; inspect Gmail before resolving\");\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ok: true };\n}\n"
      },
      "n_e9523a1176bea067": {
        "name": "Confirm email",
        "imports": [],
        "source": "export default async function ({ key, id }, ctx) {\n  if (!id) throw Error(\"Unknown email result\");\n  await ctx.state.set(key, { status: \"done\", id });\n  return { ok: true };\n}\n"
      }
    }
  },
