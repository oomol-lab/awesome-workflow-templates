    "modules": {
      "n_8cc5301b5d3c938c": {
        "name": "Read the new pull request",
        "imports": [],
        "source": "function readPullRequest(body) {\n  if (body?.eventType !== \"git.pullrequest.created\") return null;\n  const { message, resource } = body;\n  if (\n    typeof message?.markdown !== \"string\" ||\n    !message.markdown.trim() ||\n    typeof resource?.createdBy?.uniqueName !== \"string\" ||\n    typeof resource.createdBy.displayName !== \"string\" ||\n    !Array.isArray(resource.reviewers)\n  ) {\n    throw new Error(\"The pull request event needs the full Azure DevOps resource and message\");\n  }\n  return {\n    markdown: message.markdown,\n    creator: resource.createdBy,\n    reviewers: resource.reviewers,\n  };\n}\n\nexport default ({ body }) => {\n  const pullRequest = readPullRequest(body);\n  return { pullRequest, isNew: pullRequest !== null };\n};\n"
      },
      "n_329131b0346fb552": {
        "name": "Build the DingTalk message",
        "imports": [],
        "source": "function makeMessage(pr, rows) {\n  const normalize = (value) => (typeof value === \"string\" ? value.trim().toLowerCase() : \"\");\n  const mapping = new Map();\n  for (const { TfsAccount, UserName, DingTalkMobile } of rows) {\n    const account = normalize(TfsAccount);\n    if (!account && !UserName && !DingTalkMobile) continue;\n    const mobile = typeof DingTalkMobile === \"string\" ? DingTalkMobile.trim() : \"\";\n    if (!account || mapping.has(account) || (DingTalkMobile && !/^\\+?\\d{6,15}$/.test(mobile))) {\n      throw new Error(\n        \"Use distinct TfsAccount values and mobile numbers stored as text in the reviewer mapping\",\n      );\n    }\n    mapping.set(account, {\n      name: typeof UserName === \"string\" ? UserName.trim() : \"\",\n      mobile,\n    });\n  }\n\n  function find(identity) {\n    const account = normalize(identity?.uniqueName);\n    const shortName = account.split(\"\\\\\").at(-1).split(\"@\")[0];\n    return mapping.get(account) ?? mapping.get(shortName);\n  }\n\n  const creatorName = find(pr.creator)?.name;\n  let text = pr.markdown;\n  if (creatorName && pr.creator.displayName)\n    text = text.replace(pr.creator.displayName, () => creatorName);\n\n  const isTeam = (reviewer) =>\n    reviewer?.isContainer === true ||\n    (reviewer?.isContainer == null &&\n      typeof reviewer?.uniqueName === \"string\" &&\n      reviewer.uniqueName.includes(\"团队\"));\n  const isAtAll = pr.reviewers.some(isTeam);\n  const people = pr.reviewers\n    .filter((reviewer) => !isTeam(reviewer))\n    .map(find)\n    .filter(Boolean);\n  const mobiles = [...new Set(people.map(({ mobile }) => mobile).filter(Boolean))];\n  const names = isAtAll ? [...new Set(people.map(({ name }) => name).filter(Boolean))] : [];\n  const mentions = isAtAll ? [\"所有人\", ...names] : mobiles;\n  if (mentions.length) text += \"\\n\\n请 @\" + mentions.join(\" @\") + \" 评审\";\n\n  return {\n    title: \"New PR Notify\",\n    text,\n    atMobiles: !isAtAll && mobiles.length ? mobiles : null,\n    isAtAll,\n  };\n}\n\nfunction sheetMapping(values) {\n  const [header, ...cells] = values;\n  const columns = [\"TfsAccount\", \"UserName\", \"DingTalkMobile\"];\n  if (!header || !columns.every((name, index) => header[index] === name)) {\n    throw new Error(\"Check the first row of the reviewer mapping sheet\");\n  }\n  return cells.map(([TfsAccount, UserName, DingTalkMobile]) => ({\n    TfsAccount,\n    UserName,\n    DingTalkMobile,\n  }));\n}\n\nexport default ({ pullRequest, values }) => makeMessage(pullRequest, sheetMapping(values));\n"
      }
