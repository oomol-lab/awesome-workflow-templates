    "modules": {
      "n_926e79973add3996": {
        "name": "Validate page URL",
        "imports": [],
        "source": "export default function ({ url }) {\n  if (typeof url !== \"string\" || !/^https?:\\/\\/[^\\s/]+(?:\\/[^\\s]*)?$/i.test(url.trim())) {\n    throw new Error(\"Supply one nonempty HTTP or HTTPS page URL.\");\n  }\n  return { url: url.trim() };\n}\n"
      },
      "n_5543e374b1a6b622": {
        "name": "Read Markdown and page status",
        "imports": [],
        "source": "export default function ({ result }) {\n  if (!result || typeof result !== \"object\" || Array.isArray(result) || result.success !== true) {\n    throw new Error(\"Firecrawl did not report a successful scrape.\");\n  }\n  const response = result.data?.markdown;\n  if (typeof response !== \"string\" || !response.trim()) {\n    throw new Error(\"Firecrawl did not return nonempty Markdown.\");\n  }\n  const status = result.data?.metadata?.statusCode;\n  return {\n    response,\n    pageStatus: Number.isInteger(status) && status >= 100 && status <= 599 ? status : null,\n  };\n}\n"
      }
    }
  },
