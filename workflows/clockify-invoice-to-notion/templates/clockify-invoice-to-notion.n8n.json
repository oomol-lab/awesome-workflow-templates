            },
            {
              "key": "Amount|number",
              "numberValue": "={{ $json[\"body\"][\"amount\"] }}"
            }
          ]
        }
      },
      "typeVersion": 2
    }
  ],
  "connections": {
    "On new invoice in Clockify": {
      "main": [
        [
          {
            "node": "Create database page",
            "type": "main",
            "index": 0
