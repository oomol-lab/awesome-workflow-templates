    "modules": {
      "n_d7b4c90e559b2c61": {
        "name": "Prepare invoice properties",
        "imports": [],
        "source": "export default function invoiceToNotion({body,dataSourceId}) {\n  if (!body || typeof body !== 'object' || !dataSourceId || dataSourceId.startsWith('YOUR_')) throw new Error('Configure the Notion data source and provide an invoice');\n  const {number,issuedDate,dueDate,amount}=body;\n  if ((typeof number !== 'string' && typeof number !== 'number') || String(number).trim()==='' || typeof issuedDate !== 'string' || !issuedDate || typeof dueDate !== 'string' || !dueDate || typeof amount !== 'number' || !Number.isFinite(amount)) throw new Error('Invoice needs number, issuedDate, dueDate and numeric amount');\n  const issue = new Date(issuedDate), due = new Date(dueDate);\n  if (Number.isNaN(issue.getTime()) || Number.isNaN(due.getTime())) throw new Error('Invoice dates must be valid');\n  return {parent:{data_source_id:dataSourceId},properties:{'Invoice number':{title:[{text:{content:String(number)}}]},'Issue date':{date:{start:issue.toISOString().slice(0,10)}},'Due date':{date:{start:due.toISOString().slice(0,10)}},Amount:{number:amount}}};\n}\n"
      }
