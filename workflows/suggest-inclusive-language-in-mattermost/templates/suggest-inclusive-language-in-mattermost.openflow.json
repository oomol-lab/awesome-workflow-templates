      "n_76de0dca7665abc2": {
        "name": "Check the message",
        "imports": [],
        "source": "export default function plan({ body, token }) {\n  if (typeof token !== \"string\" || !token || body?.token !== token)\n    throw Error(\"Invalid Mattermost webhook token\");\n  if (typeof body?.channel_id !== \"string\" || !body.channel_id || typeof body?.text !== \"string\")\n    throw Error(\"Invalid Mattermost event\");\n  const match = [\"guys\", \"Guys\", \"bros\", \"Bros\", \"dudes\", \"Dudes\", \"gals\", \"Gals\"].some((word) =>\n    body.text.includes(word),\n  );\n  return { match, channelId: body.channel_id };\n}\n"
      }
