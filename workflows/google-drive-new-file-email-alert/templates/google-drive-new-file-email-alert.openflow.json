    "modules": {
      "n_4f9afcffddf7fe96": {
        "name": "Validate the new-file batch",
        "imports": [],
        "source": "export default function driveNewFileEvents({ events }) {\n  if (!Array.isArray(events)) throw new Error(\"Expected a Google Drive event batch\");\n  const seen = new Set();\n  const files = events.map((event) => {\n    if (\n      !event ||\n      event.eventType !== \"file_created\" ||\n      event.itemType !== \"file\" ||\n      typeof event.fileId !== \"string\" ||\n      !event.fileId ||\n      typeof event.name !== \"string\"\n    )\n      throw new Error(\"Expected a complete new-file event\");\n    if (seen.has(event.fileId)) throw new Error(\"Duplicate Google Drive file in this batch\");\n    seen.add(event.fileId);\n    return { fileId: event.fileId, name: event.name };\n  });\n  return { files };\n}\n"
      },
      "n_35d79d21f1c49748": {
        "name": "Prepare the next alert",
        "imports": [],
        "source": "export default function driveFileMailProgress({\n  files,\n  previousState,\n  messageId,\n  accepted,\n  rejected,\n  response,\n}) {\n  if (!Array.isArray(files)) throw new Error(\"Expected files to notify\");\n  let state;\n  if (previousState == null) state = { index: 0, receipts: [] };\n  else {\n    if (\n      !Number.isInteger(previousState.index) ||\n      previousState.index < 1 ||\n      previousState.index > files.length ||\n      !Array.isArray(previousState.receipts) ||\n      previousState.receipts.length !== previousState.index - 1\n    )\n      throw new Error(\"Invalid file notification state\");\n    if (\n      !Array.isArray(accepted) ||\n      !accepted.length ||\n      accepted.some((value) => typeof value !== \"string\" || !value.trim()) ||\n      !Array.isArray(rejected) ||\n      rejected.length ||\n      typeof response !== \"string\" ||\n      (messageId != null && typeof messageId !== \"string\")\n    )\n      throw new Error(\"SMTP did not confirm the file notification\");\n    state = {\n      index: previousState.index,\n      receipts: [\n        ...previousState.receipts,\n        {\n          fileId: files[previousState.index - 1].fileId,\n          messageId: messageId ?? null,\n          accepted,\n          rejected,\n          response,\n        },\n      ],\n    };\n  }\n  const file = files[state.index];\n  if (file == null) return { state, more: false, message: \"\", count: state.receipts.length };\n  if (typeof file.fileId !== \"string\" || !file.fileId || typeof file.name !== \"string\")\n    throw new Error(\"Invalid file notification\");\n  return {\n    state: { index: state.index + 1, receipts: state.receipts },\n    more: true,\n    message: \"A file in your Google Drive file folder has been created: \" + file.name,\n    count: state.receipts.length,\n  };\n}\n"
      }
    }
