    "modules": {
      "n_5ebbde3b641fc003": {
        "name": "Match and personalize greetings",
        "imports": [],
        "source": "export default function plan({calendar,messages}){\n const table=(v,needed)=>{if(!Array.isArray(v)||!v.length)return [];const h=v[0];if(!Array.isArray(h)||needed.some(x=>h.indexOf(x)<0||h.indexOf(x)!==h.lastIndexOf(x)))throw new Error('Sheet needs unique required headers');return v.slice(1).filter(r=>Array.isArray(r)&&r.some(x=>x!==''&&x!=null)).map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]??''])))};\n const people=table(calendar,['Date','Event Name','First Name','Phone Number']),templates=table(messages,['Event Name','Congratulations']);const now=new Date(),today=`${now.getUTCDate()}/${now.getUTCMonth()+1}`,rows=[];\n for(const person of people){if(String(person.Date)!==today)continue;const t=templates.findLast(x=>String(x['Event Name'])===String(person['Event Name']));if(!t||!t.Congratulations)continue;{const parts=String(t.Congratulations).split(','),first=parts.shift();if(!person['Phone Number'])throw new Error('A matched event needs a phone number');rows.push({to:String(person['Phone Number']),body:`${first} ${person['First Name']},${parts.join(',')}`})}}\n return {rows};\n}\n"
      },
      "n_e6b8c41475e2ae8d": {
        "name": "Prepare next greeting",
        "imports": [],
        "source": "export default function next({rows,previousState}){const index=previousState===null?0:previousState.index+1;if(index>=rows.length)return {state:{index},more:false,to:'-',body:'-',count:rows.length};return {state:{index},more:true,to:rows[index].to,body:rows[index].body,count:rows.length}}\n"
      }
    }
