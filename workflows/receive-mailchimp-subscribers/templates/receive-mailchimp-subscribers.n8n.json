{
  "nodes": [
    {
      "name": "Mailchimp Trigger",
      "type": "n8n-nodes-base.mailchimpTrigger",
      "position": [
        870,
        370
      ],
      "parameters": {
        "list": "YOUR_MAILCHIMP_AUDIENCE_ID",
        "events": [
          "subscribe"
        ],
        "sources": [
          "api",
          "admin",
          "user"
        ]
      },
      "typeVersion": 1,
      "id": "receive-mailchimp-subscribers-0"
    },
    {
      "id": "receive-mailchimp-subscribers-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Mailchimp Trigger": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Receive Mailchimp Subscribers",
  "active": false,
  "pinData": {}
}
