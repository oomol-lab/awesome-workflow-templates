    {
      "name": "Prepare news row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $(\"Process one article\").item.json,\n  summary = $(\"Summarize article\").item.json.output,\n  keywords = $json.output;\nif (!summary || !keywords) throw Error(\"Missing model output\");\nreturn {\n  json: {\n    News_Source: \"Colt\",\n    Title: item.title,\n    Date: item.date,\n    Link: item.url,\n    Summary: summary,\n    Keywords: keywords,\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "colt-news-14",
      "position": [
        3080,
        0
      ]
