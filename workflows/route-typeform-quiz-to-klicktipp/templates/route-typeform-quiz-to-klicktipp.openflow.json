        "source": "export default function prepare({ response, listId, customFields }) {\n  if (!Number.isSafeInteger(listId) || listId <= 0) throw Error(\"Configure opt-in process ID\");\n  const keys = [\"linkedin\", \"use\", \"location\", \"staff\"];\n  if (\n    !customFields ||\n    keys.some((k) => !/^field\\d+$/.test(customFields[k] || \"\")) ||\n    new Set(keys.map((k) => customFields[k])).size !== 4\n  )\n    throw Error(\"Configure four distinct custom fields\");\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers))\n    throw Error(\"Expected Typeform definition and answers\");\n  function answer(title) {\n    const f = fields.filter((x) => x.title === title);\n    if (f.length !== 1 || !f[0].id) throw Error(\"Expected one question: \" + title);\n    const a = answers.filter((x) => x.field?.id === f[0].id);\n    if (a.length > 1) throw Error(\"Ambiguous answer: \" + title);\n    if (!a.length) return null;\n    const x = a[0];\n    switch (x.type) {\n      case \"text\":\n      case \"email\":\n      case \"phone_number\":\n      case \"date\":\n      case \"url\":\n      case \"number\":\n        return x[x.type];\n      case \"choice\":\n        return x.choice?.label;\n      case \"choices\":\n        return x.choices?.labels;\n      default:\n        throw Error(\"Unsupported answer: \" + title);\n    }\n  }\n  const first = answer(\"Vorname\"),\n    last = answer(\"Nachname\"),\n    email = answer(\"E-Mail Adresse\"),\n    phone = answer(\"Mobilrufnummer\"),\n    birthday = answer(\"Geburtstag\"),\n    linkedin = answer(\"LinkedIn URL\"),\n    use = answer(\"Wofür wird KlickTipp genutzt?\"),\n    location = answer(\"Wo ist der Firmensitz der Klick-Tipp Limited?\"),\n    staff = answer(\"Wie viele Mitarbeiter hat das KlickTipp Customer Happiness Team?\");\n  if (\n    typeof email !== \"string\" ||\n    !email.includes(\"@\") ||\n    !Array.isArray(use) ||\n    use.some((x) => typeof x !== \"string\") ||\n    typeof location !== \"string\" ||\n    typeof staff !== \"number\" ||\n    !Number.isFinite(staff)\n  )\n    throw Error(\"Invalid quiz answers\");\n  const birth = Date.parse(String(birthday) + \"T00:00:00Z\");\n  if (!Number.isFinite(birth)) throw Error(\"Invalid birthday\");\n  const mobile = String(phone || \"\")\n    .replace(/^\\+/, \"00\")\n    .replace(/[^0-9]/g, \"\");\n  const data = {\n      fieldFirstName: String(first || \"\"),\n      fieldLastName: String(last || \"\"),\n      fieldBirthday: String(Math.floor(birth / 1000)),\n      [customFields.linkedin]: String(linkedin || \"\"),\n      [customFields.use]: use.join(\", \"),\n      [customFields.location]: location,\n      [customFields.staff]: String(staff * 100),\n    },\n    tags = [...new Set([...use, location, String(staff)])];\n  if (tags.some((x) => !x.trim())) throw Error(\"Invalid tag\");\n  return {\n    email,\n    subscriber: { email, ...(mobile ? { smsnumber: mobile } : {}), listid: listId, fields: data },\n    tags,\n  };\n}\n"
      },
      "n_3b9b18e2e57f5539": {
        "name": "Confirm subscriber",
        "imports": [],
        "source": "export default function confirm({ body, email }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body) || !body.id)\n    throw Error(\"Subscriber not confirmed\");\n  return { email };\n}\n"
      },
      "n_3af05ad039b07f5f": {
        "name": "Resolve the next tag",
        "imports": [],
        "source": "export default function next({ tags, all, state, created }) {\n  let s;\n  if (state == null) {\n    if (!all || typeof all !== \"object\" || Array.isArray(all)) throw Error(\"Invalid tag list\");\n    s = { remaining: tags, ids: [], lookup: all };\n  } else {\n    s = state;\n    if (created != null) {\n      if (!Array.isArray(created) || !Number.isSafeInteger(created[0]) || created[0] <= 0)\n        throw Error(\"Tag creation not confirmed\");\n      s = { ...s, ids: [...s.ids, created[0]] };\n    }\n  }\n  while (s.remaining.length) {\n    const [name, ...remaining] = s.remaining,\n      match = Object.entries(s.lookup).find(([, v]) => v === name);\n    s = { ...s, remaining };\n    if (match) {\n      const id = Number(match[0]);\n      if (!Number.isSafeInteger(id) || id <= 0) throw Error(\"Invalid tag ID\");\n      s.ids.push(id);\n      continue;\n    }\n    return { state: s, more: true, request: { name }, tagIds: [] };\n  }\n  return { state: s, more: false, request: {}, tagIds: s.ids };\n}\n"
      },
      "n_07f46cd7912ac038": {
        "name": "Prepare tag assignment",
        "imports": [],
        "source": "export default function tag({ email, tagIds }) {\n  return { body: { email, tagids: tagIds }, hasTags: tagIds.length > 0 };\n}\n"
      },
      "n_b9e38ee0b51e7824": {
        "name": "Confirm tag assignment",
        "imports": [],
        "source": "export default function result({ body, email }) {\n  if (!Array.isArray(body) || body.length !== 1 || body[0] !== true)\n    throw Error(\"Tag assignment not confirmed\");\n  return { result: { email, tagged: true } };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
