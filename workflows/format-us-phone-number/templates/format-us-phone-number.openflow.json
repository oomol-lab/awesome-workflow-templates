    "modules": {
      "n_6c325b8a3f54d752": {
        "name": "Format number and extension",
        "imports": [],
        "source": "function formatUsPhoneNumber(input) {\n  const original = typeof input === \"string\" || typeof input === \"number\" ? String(input) : \"\";\n  let number = \"\";\n  let extension = \"\";\n  if (typeof input !== \"number\" || (Number.isSafeInteger(input) && input >= 0)) {\n    const explicit = /^([+0-9(). -]+?)(?:\\s*(?:ext\\.?|x|#)\\s*([0-9]+))?$/i.exec(original.trim());\n    if (explicit) {\n      const base = explicit[1].trim();\n      const digits = base.replace(/\\D/g, \"\");\n      if (/^\\+1[^+]*$/.test(base) || !base.includes(\"+\")) {\n        if (digits.length === 10 && !base.startsWith(\"+\")) {\n          number = \"1\" + digits;\n          extension = explicit[2] ?? \"\";\n        } else if (\n          digits.length >= 11 &&\n          digits.startsWith(\"1\") &&\n          (!explicit[2] || digits.length === 11)\n        ) {\n          number = digits.slice(0, 11);\n          extension = explicit[2] ?? digits.slice(11);\n        }\n      }\n    }\n  }\n  const extensionNumber = Number(extension);\n  if (!Number.isSafeInteger(extensionNumber)) number = \"\";\n  const area = number.slice(1, 4);\n  const exchange = number.slice(4, 7);\n  const local = number.slice(7);\n  const national = number ? \"(\" + area + \") \" + exchange + \"-\" + local : \"\";\n  return {\n    \"Phone Number (Input)\": original,\n    \"Phone Number\": Number(number),\n    \"Phone Number (E-164)\": number ? \"+\" + number : \"\",\n    \"Phone Number (National)\": national,\n    \"Phone Number (Full National)\": number ? \"1 \" + national : \"\",\n    \"Phone Number (International)\": number ? \"00-1-\" + area + \"-\" + exchange + \"-\" + local : \"\",\n    Extension: number ? extensionNumber : 0,\n    \"Extension (String)\": number && extensionNumber ? String(extensionNumber) : \"\",\n  };\n}\n\nexport default (input) => formatUsPhoneNumber(input[\"Phone Number\"]);\n"
      }
    },
