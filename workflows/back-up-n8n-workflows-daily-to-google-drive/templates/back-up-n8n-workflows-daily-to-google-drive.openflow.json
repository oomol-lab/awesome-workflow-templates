    "modules": {
      "n_3bb24a840bca7b31": {
        "name": "Collect workflow pages",
        "imports": [],
        "source": "export default async function pages({ previous }, context) {\n  const s = previous ?? { items: [], cursor: null, seen: [] };\n  const r = await context.actions.call(\"n8n.list_workflows\", {\n    limit: 100,\n    ...(s.cursor ? { cursor: s.cursor } : {}),\n  });\n  if (!Array.isArray(r?.data)) throw Error(\"Invalid n8n workflow page\");\n  const c = r.nextCursor;\n  if (c !== null && (typeof c !== \"string\" || !c || s.seen.includes(c)))\n    throw Error(\"Invalid or repeated workflow cursor\");\n  return {\n    state: { items: s.items.concat(r.data), cursor: c, seen: c ? [...s.seen, c] : s.seen },\n    more: c !== null,\n  };\n}\n"
      },
      "n_c2a39c85513069df": {
        "name": "Read the next workflow",
        "imports": [],
        "source": "export default async function next({ list, previous, folderId }, context) {\n  if (typeof folderId !== \"string\" || !folderId || folderId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the Drive folder ID\");\n  const index = previous?.index ?? 0;\n  if (index >= list.items.length)\n    return { state: { index }, more: false, name: \"-\", text: \"-\", parents: [folderId] };\n  const item = list.items[index];\n  if (typeof item?.id !== \"string\" || !item.id) throw Error(\"Invalid workflow ID\");\n  const w = await context.actions.call(\"n8n.get_workflow\", { workflowId: item.id });\n  if (\n    w?.id !== item.id ||\n    typeof w.name !== \"string\" ||\n    !Array.isArray(w.nodes) ||\n    !w.connections ||\n    typeof w.connections !== \"object\"\n  )\n    throw Error(\"Invalid workflow details\");\n  const safe = w.name.replace(/[\\\\/\\x00-\\x1f]/g, \"_\").slice(0, 150) || \"workflow\";\n  return {\n    state: { index: index + 1 },\n    more: true,\n    name: `${safe}-${w.id}.json`,\n    text: JSON.stringify(w, null, 2),\n    parents: [folderId],\n  };\n}\n"
      }
    }
