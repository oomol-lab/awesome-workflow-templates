{
  "nodes": [
    {
      "id": "back-up-n8n-workflows-daily-to-google-drive-0",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 1,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "back-up-n8n-workflows-daily-to-google-drive-1",
      "name": "Get all n8n Workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [
        250,
        300
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Read the n8n workflow",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "get",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        }
      },
      "id": "back-up-n8n-workflows-daily-to-google-drive-2",
      "position": [
        500,
        300
      ]
    },
    {
      "name": "Make the JSON backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const w = $json;\nif (\n  typeof w.id !== \"string\" ||\n  !w.id ||\n  typeof w.name !== \"string\" ||\n  !Array.isArray(w.nodes) ||\n  !w.connections ||\n  typeof w.connections !== \"object\"\n)\n  throw Error(\"Invalid workflow\");\nconst safe = w.name.replace(/[\\\\/\\x00-\\x1f]/g, \"_\").slice(0, 150) || \"workflow\";\nreturn {\n  json: { name: safe + \"-\" + w.id + \".json\" },\n  binary: {\n    data: {\n      data: Buffer.from(JSON.stringify(w, null, 2)).toString(\"base64\"),\n      mimeType: \"application/json\",\n      fileName: safe + \"-\" + w.id + \".json\",\n    },\n  },\n};\n"
      },
      "id": "back-up-n8n-workflows-daily-to-google-drive-3",
      "position": [
        750,
        300
      ]
    },
    {
      "id": "back-up-n8n-workflows-daily-to-google-drive-4",
      "name": "Backup to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        1000,
        300
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ $json.name }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DRIVE_FOLDER_ID"
        },
        "options": {}
      },
      "typeVersion": 3
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get all n8n Workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get all n8n Workflows": {
      "main": [
        [
          {
            "node": "Read the n8n workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the n8n workflow": {
      "main": [
        [
          {
            "node": "Make the JSON backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Make the JSON backup": {
      "main": [
        [
          {
            "node": "Backup to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Back Up n8n Workflows Daily to Google Drive",
  "active": false,
  "settings": {
    "timezone": "UTC",
    "executionOrder": "v1"
  }
}
