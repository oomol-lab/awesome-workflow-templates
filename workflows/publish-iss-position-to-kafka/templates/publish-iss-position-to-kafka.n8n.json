{
  "name": "Publish ISS Position to Kafka",
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        510,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-kafka-0"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        710,
        300
      ],
      "parameters": {
        "url": "https://api.wheretheiss.at/v1/satellites/25544",
        "options": {}
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-kafka-1"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        910,
        300
      ],
      "parameters": {
        "values": {
          "number": [],
          "string": [
            {
              "name": "Name",
              "value": "={{$node[\"HTTP Request\"].json[\"name\"]}}"
            },
            {
              "name": "Latitude",
              "value": "={{$node[\"HTTP Request\"].json[\"latitude\"]}}"
            },
            {
              "name": "Longitude",
              "value": "={{$node[\"HTTP Request\"].json[\"longitude\"]}}"
            },
            {
              "name": "Timestamp",
              "value": "={{$node[\"HTTP Request\"].json[\"timestamp\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-kafka-2"
    },
    {
      "name": "Kafka",
      "type": "n8n-nodes-base.kafka",
      "position": [
        1110,
        300
      ],
      "parameters": {
        "topic": "iss-position",
        "options": {}
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-kafka-3"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "Kafka",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
