    "modules": {
      "n_5ef30902b18d1217": {
        "name": "Read feedback answers",
        "imports": [],
        "source": "export default function prepareFeedback(inputs) {\n  const root = inputs.response;\n  const response = root?.form_response ?? root;\n  if (!response || typeof response !== 'object' || Array.isArray(response)) throw new Error('Expected a completed Typeform response.');\n  if (!Array.isArray(response.answers) || !Array.isArray(response.definition?.fields)) throw new Error('The Typeform response must include answer and field definitions.');\n  const requiredTitles = [inputs.feedbackTitle, inputs.nameTitle].filter(Boolean);\n  const fields = new Map();\n  for (const field of response.definition.fields) {\n    if (typeof field?.id !== 'string' || typeof field.title !== 'string') continue;\n    const title = field.title.trim();\n    if (!requiredTitles.includes(title)) continue;\n    if (fields.has(title)) throw new Error('Required Typeform question titles must be unique: ' + title);\n    fields.set(title, field.id);\n  }\n  const readText = (title) => {\n    const id = fields.get(title);\n    if (!id) throw new Error('Missing Typeform question: ' + title);\n    const answers = response.answers.filter((answer) => answer?.field?.id === id);\n    if (answers.length !== 1 || answers[0].type !== 'text' || typeof answers[0].text !== 'string' || !answers[0].text.trim()) throw new Error('Expected one nonempty text answer for: ' + title);\n    return answers[0].text;\n  };\n  const feedback = readText(inputs.feedbackTitle);\n  const name = inputs.nameTitle ? readText(inputs.nameTitle) : '';\n  return { feedback, name, request: { document: { type: 'PLAIN_TEXT', content: feedback }, encodingType: 'UTF16' } };\n}\n"
      },
      "n_c2872abf4505904c": {
        "name": "Validate sentiment score",
        "imports": [],
        "source": "export default function readSentiment(inputs) {\n  const body = inputs.body;\n  const score = body?.documentSentiment?.score;\n  if (!body || typeof body !== 'object' || Array.isArray(body) || body.error || typeof score !== 'number' || !Number.isFinite(score) || score < -1 || score > 1) throw new Error('The sentiment service did not return a valid document score.');\n  return { score };\n}\n"
      },
      "n_89d4ee535e66d85a": {
        "name": "Prepare feedback message",
        "imports": [],
        "source": "export default function prepareDestinations(inputs) {\n  const { feedback, name, score } = inputs;\n  if (typeof feedback !== 'string' || typeof name !== 'string' || typeof score !== 'number' || !Number.isFinite(score)) throw new Error('Expected feedback, name, and a sentiment score.');\n  return {\n    message: `You got a new feedback with a score of ${score}. Here is what it says:${feedback}`,\n    properties: { Name: { title: [{ text: { content: name } }] }, Feedback: { rich_text: [{ text: { content: feedback } }] } },\n    attachments: [{ text: feedback, title: `${name} ${score}` }],\n    cardName: `Score: ${score}`,\n    cardDescription: `Score: ${score}\\nFeedback: ${feedback}\\nUser: ${name}`,\n  };\n}\n"
      }
    }
