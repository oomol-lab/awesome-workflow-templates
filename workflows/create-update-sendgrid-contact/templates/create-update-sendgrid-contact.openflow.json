    "modules": {
      "n_09cf2e63bd00614f": {
        "name": "Validate contact details",
        "imports": [],
        "source": "export default function input({email,firstName,lastName}){if(typeof email!=='string'||email.length>254||!/^\\S+@\\S+\\.\\S+$/.test(email.trim()))throw Error('Enter a valid email');if(typeof firstName!=='string'||!firstName.trim()||firstName.length>50||typeof lastName!=='string'||!lastName.trim()||lastName.length>50)throw Error('Enter first and last names (up to 50 characters)');email=email.trim().toLowerCase();return {email,firstName:firstName.trim(),lastName:lastName.trim(),first:{contacts:[{email,first_name:firstName.trim()}]},second:{contacts:[{email,last_name:lastName.trim()}]},lookup:{identifiers:[email]}};}\n"
      },
      "n_16b96793cd21a12c": {
        "name": "Read first job ID",
        "imports": [],
        "source": "export default function job({body,statusCode,bodyEncoding}){if(statusCode!==202||bodyEncoding||typeof body?.job_id!=='string'||!body.job_id)throw Error('Contact write did not return a job ID');return {jobId:body.job_id,endpoint:'/v3/marketing/contacts/imports/'+encodeURIComponent(body.job_id)};}\n"
      },
      "n_ff838409bfaa9ebd": {
        "name": "Check first job status",
        "imports": [],
        "source": "export default function check({body,statusCode,bodyEncoding,previous}){if(statusCode!==200||bodyEncoding||!body||typeof body!=='object')throw Error('Could not read contact job');const n=(previous?.count??0)+1;if(!Number.isInteger(n)||n<1||n>12)throw Error('Invalid job state');if(body.status==='completed')return {state:{count:n},done:true};if(body.status==='pending'){if(n>=12)throw Error('Contact job still pending after 12 checks');return {state:{count:n},done:false};}throw Error('Contact job failed or returned an unknown status');}\n"
      },
      "n_d9a44324bcd50beb": {
        "name": "Read second job ID",
        "imports": [],
        "source": "export default function job({body,statusCode,bodyEncoding}){if(statusCode!==202||bodyEncoding||typeof body?.job_id!=='string'||!body.job_id)throw Error('Contact write did not return a job ID');return {jobId:body.job_id,endpoint:'/v3/marketing/contacts/imports/'+encodeURIComponent(body.job_id)};}\n"
      },
      "n_a66ef7b8b35a1c6b": {
        "name": "Check second job status",
        "imports": [],
        "source": "export default function check({body,statusCode,bodyEncoding,previous}){if(statusCode!==200||bodyEncoding||!body||typeof body!=='object')throw Error('Could not read contact job');const n=(previous?.count??0)+1;if(!Number.isInteger(n)||n<1||n>12)throw Error('Invalid job state');if(body.status==='completed')return {state:{count:n},done:true};if(body.status==='pending'){if(n>=12)throw Error('Contact job still pending after 12 checks');return {state:{count:n},done:false};}throw Error('Contact job failed or returned an unknown status');}\n"
      },
      "n_8c4106935661d1e8": {
        "name": "Verify the contact",
        "imports": [],
        "source": "export default function confirm({body,statusCode,bodyEncoding,email,firstName,lastName}){if(statusCode!==200||bodyEncoding)throw Error('Could not read contact');const c=body?.result?.[email]?.contact;if(!c||typeof c.id!=='string'||c.email?.toLowerCase()!==email||c.first_name!==firstName||c.last_name!==lastName)throw Error('Contact does not match the requested update');return {contact:c};}\n"
      }
    }
