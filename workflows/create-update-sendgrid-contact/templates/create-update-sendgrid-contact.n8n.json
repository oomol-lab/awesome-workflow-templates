        "url": "https://api.sendgrid.com/v3/marketing/contacts/search/identifiers/email",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($(\"Set contact details\").first().json.lookup) }}",
        "options": {
