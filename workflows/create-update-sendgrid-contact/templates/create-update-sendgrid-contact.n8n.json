{
  "name": "Create and Update a SendGrid Contact",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        270,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-sendgrid-contact-0"
    },
    {
      "name": "Set contact details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function input({email,firstName,lastName}){if(typeof email!=='string'||email.length>254||!/^\\S+@\\S+\\.\\S+$/.test(email.trim()))throw Error('Enter a valid email');if(typeof firstName!=='string'||!firstName.trim()||firstName.length>50||typeof lastName!=='string'||!lastName.trim()||lastName.length>50)throw Error('Enter first and last names (up to 50 characters)');email=email.trim().toLowerCase();return {email,firstName:firstName.trim(),lastName:lastName.trim(),first:{contacts:[{email,first_name:firstName.trim()}]},second:{contacts:[{email,last_name:lastName.trim()}]},lookup:{identifiers:[email]}};}\n\nreturn [{json:input({email:'',firstName:'',lastName:''})}];"
      },
      "id": "create-update-sendgrid-contact-1"
    },
    {
      "name": "SendGrid",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        470,
        300
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://api.sendgrid.com/v3/marketing/contacts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($(\"Set contact details\").first().json.first) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2,
      "id": "create-update-sendgrid-contact-2"
    },
    {
      "name": "Prepare job 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function job({body,statusCode,bodyEncoding}){if(statusCode!==202||bodyEncoding||typeof body?.job_id!=='string'||!body.job_id)throw Error('Contact write did not return a job ID');return {jobId:body.job_id,endpoint:'/v3/marketing/contacts/imports/'+encodeURIComponent(body.job_id)};}\n\nconst response=$input.first().json;const j=job({body:response.body,statusCode:response.statusCode,bodyEncoding:null});return [{json:{jobId:j.jobId,count:0}}];"
      },
      "id": "create-update-sendgrid-contact-3"
    },
    {
      "name": "Wait for job 1",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "create-update-sendgrid-contact-4"
    },
    {
      "name": "Read job 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.sendgrid.com/v3/marketing/contacts/imports/\" + encodeURIComponent($('Prepare job 1').first().json.jobId) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-update-sendgrid-contact-5"
    },
    {
      "name": "Evaluate job 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function check({body,statusCode,bodyEncoding,previous}){if(statusCode!==200||bodyEncoding||!body||typeof body!=='object')throw Error('Could not read contact job');const n=(previous?.count??0)+1;if(!Number.isInteger(n)||n<1||n>12)throw Error('Invalid job state');if(body.status==='completed')return {state:{count:n},done:true};if(body.status==='pending'){if(n>=12)throw Error('Contact job still pending after 12 checks');return {state:{count:n},done:false};}throw Error('Contact job failed or returned an unknown status');}\n\nconst r=check({body:$input.first().json,statusCode:200,bodyEncoding:null,previous:{count:$runIndex}});return [{json:{done:r.done}}];"
      },
      "id": "create-update-sendgrid-contact-6"
    },
    {
      "name": "Job 1 complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "done",
              "leftValue": "={{ $json.done }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "create-update-sendgrid-contact-7"
    },
