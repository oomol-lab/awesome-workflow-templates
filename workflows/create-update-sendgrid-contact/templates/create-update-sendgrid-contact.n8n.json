        }
      },
      "typeVersion": 4.2,
      "id": "create-update-sendgrid-contact-14"
    },
    {
      "name": "Verify the contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function confirm({body,statusCode,bodyEncoding,email,firstName,lastName}){if(statusCode!==200||bodyEncoding)throw Error('Could not read contact');const c=body?.result?.[email]?.contact;if(!c||typeof c.id!=='string'||c.email?.toLowerCase()!==email||c.first_name!==firstName||c.last_name!==lastName)throw Error('Contact does not match the requested update');return {contact:c};}\n\nconst wanted=$('Set contact details').first().json,r=$input.first().json;return [{json:confirm({body:r.body,statusCode:r.statusCode,bodyEncoding:null,...wanted}).contact}];"
      },
      "id": "create-update-sendgrid-contact-15"
    }
  ],
