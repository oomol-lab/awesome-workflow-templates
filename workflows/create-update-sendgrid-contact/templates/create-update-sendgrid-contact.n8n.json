    {
      "name": "Verify the contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function confirm({ body, statusCode, bodyEncoding, email, firstName, lastName }) {\n  if (statusCode !== 200 || bodyEncoding) throw Error(\"Could not read contact\");\n  const c = body?.result?.[email]?.contact;\n  if (\n    !c ||\n    typeof c.id !== \"string\" ||\n    c.email?.toLowerCase() !== email ||\n    c.first_name !== firstName ||\n    c.last_name !== lastName\n  )\n    throw Error(\"Contact does not match the requested update\");\n  return { contact: c };\n}\n\nconst wanted = $(\"Set contact details\").first().json,\n  r = $input.first().json;\nreturn [\n  {\n    json: confirm({ body: r.body, statusCode: r.statusCode, bodyEncoding: null, ...wanted })\n      .contact,\n  },\n];\n"
      },
      "id": "create-update-sendgrid-contact-15"
    }
