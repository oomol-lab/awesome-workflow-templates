{
  "name": "Create and Update a SendGrid Contact",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        270,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-sendgrid-contact-0"
    },
    {
      "name": "Set contact details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function input({ email, firstName, lastName }) {\n  if (typeof email !== \"string\" || email.length > 254 || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()))\n    throw Error(\"Enter a valid email\");\n  if (\n    typeof firstName !== \"string\" ||\n    !firstName.trim() ||\n    firstName.length > 50 ||\n    typeof lastName !== \"string\" ||\n    !lastName.trim() ||\n    lastName.length > 50\n  )\n    throw Error(\"Enter first and last names (up to 50 characters)\");\n  email = email.trim().toLowerCase();\n  return {\n    email,\n    firstName: firstName.trim(),\n    lastName: lastName.trim(),\n    first: { contacts: [{ email, first_name: firstName.trim() }] },\n    second: { contacts: [{ email, last_name: lastName.trim() }] },\n    lookup: { identifiers: [email] },\n  };\n}\n\nreturn [{ json: input({ email: \"\", firstName: \"\", lastName: \"\" }) }];\n"
      },
      "id": "create-update-sendgrid-contact-1"
    },
    {
      "name": "SendGrid",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        470,
        300
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://api.sendgrid.com/v3/marketing/contacts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($(\"Set contact details\").first().json.first) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2,
      "id": "create-update-sendgrid-contact-2"
    },
    {
      "name": "Prepare job 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function job({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 202 || bodyEncoding || typeof body?.job_id !== \"string\" || !body.job_id)\n    throw Error(\"Contact write did not return a job ID\");\n  return {\n    jobId: body.job_id,\n    endpoint: \"/v3/marketing/contacts/imports/\" + encodeURIComponent(body.job_id),\n  };\n}\n\nconst response = $input.first().json;\nconst j = job({ body: response.body, statusCode: response.statusCode, bodyEncoding: null });\nreturn [{ json: { jobId: j.jobId, count: 0 } }];\n"
      },
      "id": "create-update-sendgrid-contact-3"
    },
    {
      "name": "Wait for job 1",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "create-update-sendgrid-contact-4"
    },
    {
      "name": "Read job 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.sendgrid.com/v3/marketing/contacts/imports/\" + encodeURIComponent($('Prepare job 1').first().json.jobId) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sendGridApi",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-update-sendgrid-contact-5"
    },
    {
      "name": "Evaluate job 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function check({ body, statusCode, bodyEncoding, previous }) {\n  if (statusCode !== 200 || bodyEncoding || !body || typeof body !== \"object\")\n    throw Error(\"Could not read contact job\");\n  const n = (previous?.count ?? 0) + 1;\n  if (!Number.isInteger(n) || n < 1 || n > 12) throw Error(\"Invalid job state\");\n  if (body.status === \"completed\") return { state: { count: n }, done: true };\n  if (body.status === \"pending\") {\n    if (n >= 12) throw Error(\"Contact job still pending after 12 checks\");\n    return { state: { count: n }, done: false };\n  }\n  throw Error(\"Contact job failed or returned an unknown status\");\n}\n\nconst r = check({\n  body: $input.first().json,\n  statusCode: 200,\n  bodyEncoding: null,\n  previous: { count: $runIndex },\n});\nreturn [{ json: { done: r.done } }];\n"
      },
      "id": "create-update-sendgrid-contact-6"
    },
    {
      "name": "Job 1 complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "done",
              "leftValue": "={{ $json.done }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "create-update-sendgrid-contact-7"
    },
