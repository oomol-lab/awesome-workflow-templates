    "modules": {
      "n_69c204f16de5fe19": {
        "name": "Send the template email",
        "imports": [],
        "source": "export default async function send({ apiKey, fromEmail, toEmail, template }, context) {\n  if (\n    !apiKey ||\n    !fromEmail ||\n    !toEmail ||\n    !template ||\n    fromEmail.startsWith(\"YOUR_\") ||\n    toEmail.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure the API key, sender, recipient and template\");\n  const message = {\n    html: \"\",\n    text: \"\",\n    subject: \"\",\n    from_email: fromEmail,\n    to: [{ email: toEmail, type: \"to\" }],\n    important: false,\n    track_opens: false,\n    track_clicks: false,\n    auto_text: false,\n    auto_html: false,\n    inline_css: false,\n    url_strip_qs: false,\n    preserve_recipients: false,\n    view_content_link: false,\n    async: false,\n    google_analytics_campaign: \"\",\n    ip_pool: \"\",\n    bcc_address: \"\",\n    tracking_domain: \"\",\n    signing_domain: \"\",\n    return_path_domain: \"\",\n  };\n  let r, data;\n  try {\n    r = await context.fetch(\"https://mandrillapp.com/api/1.0/messages/send-template.json\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ key: apiKey, template_name: template, template_content: [], message }),\n    });\n    if (!r.ok) throw Error(\"HTTP error\");\n    data = await r.json();\n  } catch {\n    throw Error(\n      \"Mailchimp Transactional request failed or has an unknown result; check the account before retrying\",\n    );\n  }\n  if (\n    !Array.isArray(data) ||\n    data.length !== 1 ||\n    data[0]?.email !== toEmail ||\n    ![\"sent\", \"queued\", \"scheduled\", \"rejected\", \"invalid\"].includes(data[0]?.status)\n  )\n    throw Error(\n      \"Mailchimp Transactional returned an unknown result; check the account before retrying\",\n    );\n  const row = data[0];\n  return { status: row.status, recipient: toEmail };\n}\n"
      }
    }
  },
