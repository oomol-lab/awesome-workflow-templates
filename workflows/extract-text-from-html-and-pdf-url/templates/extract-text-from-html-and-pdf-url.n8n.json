      "name": "Set HTML and PDF URL",
      "type": "n8n-nodes-base.code",
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function validateInputs({ html, pdfUrl }) {\n  if (typeof html !== \"string\" || !html.trim()) throw new Error(\"Enter HTML to render as a PDF\");\n  if (typeof pdfUrl !== \"string\" || !/^https?:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(pdfUrl)) {\n    throw new Error(\"Enter a direct HTTP or HTTPS PDF URL\");\n  }\n  return { html, pdfUrl };\n}\nconst html = \"<h1>Hello World</h1>\";\nconst pdfUrl = \"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\";\nreturn [{ json: validateInputs({ html, pdfUrl }) }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "420cfac7-a621-4bf3-bd34-3fee569321e4",
      "name": "Render HTML as PDF",
      "type": "@custom-js/n8n-nodes-pdf-toolkit.html2Pdf",
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "html2Pdf",
        "htmlInput": "={{ $json.html }}",
        "outputFilename": "rendered.pdf"
      },
      "typeVersion": 1
    },
    {
      "name": "Check rendered PDF bytes",
      "id": "extract-text-from-html-and-pdf-url-check-pdf",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nif (!item.binary?.data) throw new Error(\"CustomJS did not return a PDF file\");\nconst bytes = await helpers.getBinaryDataBuffer(0, \"data\");\nif (bytes.length < 8 || String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\") {\n  throw new Error(\"CustomJS did not return a PDF file\");\n}\nreturn [item];\n"
      },
      "position": [
        660,
        0
      ]
    },
    {
      "id": "d92f690d-c84d-451d-9ab8-da6f9356e0ca",
      "name": "Extract text from rendered PDF",
