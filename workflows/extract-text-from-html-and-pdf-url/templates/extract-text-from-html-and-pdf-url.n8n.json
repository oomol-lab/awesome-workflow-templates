      "typeVersion": 1
    },
    {
      "name": "Extracted text",
      "id": "extract-text-from-html-and-pdf-url-result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function checkText(text) {\n  if (typeof text !== \"string\") throw new Error(\"The processor did not return plain text\");\n  return text;\n}\nconst htmlText = checkText($(\"Extract text from rendered PDF\").first().json.output);\nconst urlText = checkText($input.first().json.output);\nreturn [{ json: { htmlText, urlText } }];\n"
      },
      "position": [
        1320,
