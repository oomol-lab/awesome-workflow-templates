    "modules": {
      "n_a3abe14fe9e7d57d": {
        "name": "Set HTML and PDF URL",
        "imports": [],
        "source": "function validateInputs({ html, pdfUrl }) {\n  if (typeof html !== \"string\" || !html.trim()) throw new Error(\"Enter HTML to render as a PDF\");\n  if (typeof pdfUrl !== \"string\" || !/^https?:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(pdfUrl)) {\n    throw new Error(\"Enter a direct HTTP or HTTPS PDF URL\");\n  }\n  return { html, pdfUrl };\n}\nexport default validateInputs;\n"
      },
      "n_ac19a937348289ea": {
        "name": "Check the rendered PDF link",
        "imports": [],
        "source": "export default function check({ url }) {\n  if (typeof url !== \"string\" || !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(url)) {\n    throw new Error(\"PDF.co did not return an HTTPS download URL\");\n  }\n  return { url };\n}\n"
      },
      "n_527be681380c7cf1": {
        "name": "Check text from rendered PDF",
        "imports": [],
        "source": "function checkText(text) {\n  if (typeof text !== \"string\") throw new Error(\"The processor did not return plain text\");\n  return text;\n}\nexport default function validate({ text }) {\n  return { text: checkText(text) };\n}\n"
      },
      "n_bcb02012d48e0ae7": {
        "name": "Check text from linked PDF",
        "imports": [],
        "source": "function checkText(text) {\n  if (typeof text !== \"string\") throw new Error(\"The processor did not return plain text\");\n  return text;\n}\nexport default function validate({ text }) {\n  return { text: checkText(text) };\n}\n"
      }
