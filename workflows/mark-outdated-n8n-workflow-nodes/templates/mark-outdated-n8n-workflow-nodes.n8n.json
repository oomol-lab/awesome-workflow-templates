    {
      "name": "Verify rename signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require(\"crypto\"),\n  body = $json.body,\n  secret = $env.N8N_RENAME_RELAY_SECRET,\n  payload = String(body?.payload || \"\"),\n  signature = String(body?.signature || \"\"),\n  expected = crypto\n    .createHmac(\"sha256\", secret || \"\")\n    .update(payload)\n    .digest(\"hex\");\nif (\n  !secret ||\n  signature.length !== expected.length ||\n  !crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected))\n)\n  throw Error(\"Invalid relay signature\");\nreturn {\n  json: JSON.parse(Buffer.from(payload, \"base64\").toString(\"utf8\")),\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "rename-26"
    },
    {
      "name": "Rename relay with n8n owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { Workflow } = require(\"n8n-workflow\");\nconst { workflow, outdated, symbol, onlyMajorChanges, addNodesToCanvas } = $json;\nif (\n  !workflow?.id ||\n  !Array.isArray(workflow.nodes) ||\n  !workflow.connections ||\n  !workflow.settings ||\n  !Array.isArray(outdated) ||\n  typeof symbol !== \"string\" ||\n  !symbol.trim()\n)\n  throw Error(\"Invalid workflow update request\");\nconst data = JSON.parse(JSON.stringify(workflow)),\n  types = { getByNameAndVersion: () => undefined },\n  owner = new Workflow({\n    id: data.id,\n    name: data.name,\n    nodes: data.nodes,\n    connections: data.connections,\n    settings: data.settings,\n    nodeTypes: types,\n    active: false,\n  });\nlet clones = [],\n  changed = 0;\nfor (const old of outdated) {\n  if (!old || typeof old.name !== \"string\" || old.latestVersion == null || old.version == null)\n    throw Error(\"Invalid outdated node\");\n  if (\n    onlyMajorChanges &&\n    String(old.version).split(\".\")[0] === String(old.latestVersion).split(\".\")[0]\n  )\n    continue;\n  let n = owner.nodes[old.name];\n  if (!n || !n.id || n.name.startsWith(symbol)) continue;\n  const newName = symbol + \" \" + old.name;\n  if (owner.nodes[newName]) throw Error(\"Renamed node already exists\");\n  let clone = addNodesToCanvas ? JSON.parse(JSON.stringify(n)) : null;\n  owner.renameNode(old.name, newName);\n  if (clone) {\n    delete clone.id;\n    clone.typeVersion = old.latestVersion;\n    clone.position = [clone.position[0] + 40, clone.position[1] - 40];\n    clones.push(clone);\n  }\n  changed++;\n}\nreturn {\n  json: {\n    id: data.id,\n    changed,\n    body: {\n      name: data.name,\n      nodes: [...clones, ...Object.values(owner.nodes)],\n      connections: owner.connectionsBySourceNode,\n      settings: data.settings,\n    },\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "rename-27"
    },
