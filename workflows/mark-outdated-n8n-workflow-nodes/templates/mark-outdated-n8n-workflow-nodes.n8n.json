    {
      "name": "Prepare workflow summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prefix = \"node-update:\" + $(\"Execute Workflow Trigger\").first().json.runId + \":\";\nconst rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => String(x.item_key || \"\").startsWith(prefix) && x.workflow_id && x.workflow_name)\n  .map((x) => ({ id: x.workflow_id, body: { name: x.workflow_name } }));\nconst base = $(\"Settings\").first().json.instanceBaseUrl,\n  esc = (s) =>\n    String(s)\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replaceAll('\\\"', \"&quot;\");\nreturn {\n  json: {\n    has: rows.length > 0,\n    body:\n      \"These workflows contain outdated nodes:<br><ul>\" +\n      rows\n        .map(\n          (x) =>\n            '<li><a href=\\\"' +\n            esc(base.replace(/\\/$/, \"\") + \"/workflow/\" + encodeURIComponent(x.id)) +\n            '\\\">' +\n            esc(x.body.name) +\n            \"</a></li>\",\n        )\n        .join(\"\") +\n      \"</ul>\",\n  },\n};\n"
      },
      "id": "rename-15"
