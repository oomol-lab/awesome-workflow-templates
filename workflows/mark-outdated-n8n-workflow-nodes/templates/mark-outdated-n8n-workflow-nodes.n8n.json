        "jsCode": "const items = $input.all(),\n  run = items[0]?.json.runId;\nif (\n  typeof run !== \"string\" ||\n  !run.trim() ||\n  items.some((x) => x.json.runId !== run || !x.json.Id) ||\n  new Set(items.map((x) => x.json.Id)).size !== items.length\n)\n  throw Error(\"Use one stable runId and unique workflow IDs\");\nreturn items;\n"
