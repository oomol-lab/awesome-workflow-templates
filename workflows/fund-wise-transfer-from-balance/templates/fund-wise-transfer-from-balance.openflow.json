    "modules": {
      "n_f5a598a37345c8f9": {
        "name": "Validate transfer details",
        "imports": [],
        "source": "export default async function start(\n  { profileId, recipientId, amount, sourceCurrency, targetCurrency, reference, transactionId },\n  ctx,\n) {\n  if (\n    !Number.isSafeInteger(profileId) ||\n    profileId <= 0 ||\n    !Number.isSafeInteger(recipientId) ||\n    recipientId <= 0 ||\n    typeof amount !== \"number\" ||\n    amount <= 0 ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(transactionId) ||\n    !/^[A-Z]{3}$/.test(sourceCurrency) ||\n    !/^[A-Z]{3}$/.test(targetCurrency)\n  )\n    throw Error(\"Configure positive IDs, amount, ISO currency codes and a unique transaction UUID\");\n  const s = (await ctx.state.get(\"wise-transfers\")) ?? {};\n  if (s[transactionId]) throw Error(\"Transaction already started: inspect Wise before retrying\");\n  return {\n    quote: { profile: profileId, sourceCurrency, targetCurrency, sourceAmount: amount },\n    params: { profileId, recipientId, reference, transactionId },\n  };\n}\n"
      },
      "n_ebbef808278356f3": {
        "name": "Checkpoint transfer creation",
        "imports": [],
        "source": "export default async function create({ quote, params }, ctx) {\n  if (typeof quote?.id !== \"string\") throw Error(\"Wise quote has no ID\");\n  const s = (await ctx.state.get(\"wise-transfers\")) ?? {};\n  if (s[params.transactionId]) throw Error(\"Transaction already started\");\n  s[params.transactionId] = { stage: \"create\", quoteId: quote.id };\n  await ctx.state.set(\"wise-transfers\", s);\n  return {\n    body: {\n      quoteUuid: quote.id,\n      targetAccount: params.recipientId,\n      customerTransactionId: params.transactionId,\n      details: { reference: params.reference },\n    },\n  };\n}\n"
      },
      "n_7faa8784604f845f": {
        "name": "Checkpoint balance funding",
        "imports": [],
        "source": "export default async function fund({ transfer, params }, ctx) {\n  if (!Number.isSafeInteger(transfer?.id)) throw Error(\"Wise transfer ID missing; inspect Wise\");\n  const s = await ctx.state.get(\"wise-transfers\");\n  if (s?.[params.transactionId]?.stage !== \"create\") throw Error(\"Invalid checkpoint\");\n  s[params.transactionId] = { stage: \"fund\", transferId: transfer.id };\n  await ctx.state.set(\"wise-transfers\", s);\n  return {\n    url:\n      \"https://api.wise.com/v3/profiles/\" +\n      params.profileId +\n      \"/transfers/\" +\n      transfer.id +\n      \"/payments\",\n    body: { type: \"BALANCE\" },\n    transferId: transfer.id,\n  };\n}\n"
      },
      "n_8adb55d9fae6a772": {
        "name": "Confirm funding",
        "imports": [],
        "source": "export default async function complete({ payment, params, transferId }, ctx) {\n  if (payment?.status !== \"COMPLETED\") throw Error(\"Funding not confirmed; inspect Wise\");\n  const s = await ctx.state.get(\"wise-transfers\");\n  if (s?.[params.transactionId]?.transferId !== transferId)\n    throw Error(\"Wrong transfer checkpoint\");\n  s[params.transactionId] = { stage: \"funded\", transferId };\n  await ctx.state.set(\"wise-transfers\", s);\n  return { url: \"https://api.wise.com/v1/transfers/\" + transferId };\n}\n"
      }
    }
  },
