    "modules": {
      "n_6bc48711ac3be2c3": {
        "name": "Collect entry pages",
        "imports": [],
        "source": "export default function pages({spaceId,environment,previousState,response,statusCode}){if(!spaceId||spaceId.startsWith('YOUR_')||!environment)throw Error('Configure space and environment');let s=previousState??{fields:[],skip:0};if(!Array.isArray(s.fields)||!Number.isSafeInteger(s.skip))throw Error('Invalid page state');let more=true;if(response!=null){if(statusCode!==200||!Array.isArray(response.items)||!Number.isSafeInteger(response.total)||response.total<0||response.skip!==s.skip||response.items.some(x=>!x||!x.fields||typeof x.fields!=='object'||Array.isArray(x.fields)))throw Error('Invalid Contentful page');const skip=s.skip+response.items.length;if(skip<response.total&&response.items.length===0)throw Error('Contentful pagination did not advance');s={fields:s.fields.concat(response.items.map(x=>x.fields)),skip};more=skip<response.total}return{state:s,more,fields:s.fields,url:'https://cdn.contentful.com/spaces/'+encodeURIComponent(spaceId)+'/environments/'+encodeURIComponent(environment)+'/entries?limit=100&skip='+s.skip}}\n"
      }
