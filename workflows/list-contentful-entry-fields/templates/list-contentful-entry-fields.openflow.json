    "modules": {
      "n_6bc48711ac3be2c3": {
        "name": "Collect entry pages",
        "imports": [],
        "source": "export default function pages({ spaceId, environment, previousState, response, statusCode }) {\n  if (!spaceId || spaceId.startsWith(\"YOUR_\") || !environment)\n    throw Error(\"Configure space and environment\");\n  let s = previousState ?? { fields: [], skip: 0 };\n  if (!Array.isArray(s.fields) || !Number.isSafeInteger(s.skip)) throw Error(\"Invalid page state\");\n  let more = true;\n  if (response != null) {\n    if (\n      statusCode !== 200 ||\n      !Array.isArray(response.items) ||\n      !Number.isSafeInteger(response.total) ||\n      response.total < 0 ||\n      response.skip !== s.skip ||\n      response.items.some(\n        (x) => !x || !x.fields || typeof x.fields !== \"object\" || Array.isArray(x.fields),\n      )\n    )\n      throw Error(\"Invalid Contentful page\");\n    const skip = s.skip + response.items.length;\n    if (skip < response.total && response.items.length === 0)\n      throw Error(\"Contentful pagination did not advance\");\n    s = { fields: s.fields.concat(response.items.map((x) => x.fields)), skip };\n    more = skip < response.total;\n  }\n  return {\n    state: s,\n    more,\n    fields: s.fields,\n    url:\n      \"https://cdn.contentful.com/spaces/\" +\n      encodeURIComponent(spaceId) +\n      \"/environments/\" +\n      encodeURIComponent(environment) +\n      \"/entries?limit=100&skip=\" +\n      s.skip,\n  };\n}\n"
      }
    }
