{
  "name": "List Contentful Entry Fields",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        150,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "list-contentful-entry-fields-0"
    },
    {
      "name": "Read entries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "https://cdn.contentful.com/spaces/YOUR_SPACE_ID/environments/master/entries?limit=100&skip=0",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://cdn.contentful.com/spaces/YOUR_SPACE_ID/environments/master/entries?limit=100&skip=' + ($pageCount === 0 ? 0 : $response.body.skip + $response.body.items.length) }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.skip + $response.body.items.length >= $response.body.total }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "id": "list-contentful-entry-fields-1"
    },
    {
      "name": "Collect entry fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=[];for(const {json} of $input.all()){const b=json.body;if(!b||!Array.isArray(b.items))throw Error('Invalid Contentful page');for(const x of b.items){if(!x.fields||typeof x.fields!=='object')throw Error('Invalid entry');rows.push({json:x.fields})}}return rows;"
      },
      "id": "list-contentful-entry-fields-2"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Read entries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read entries": {
      "main": [
        [
          {
            "node": "Collect entry fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
