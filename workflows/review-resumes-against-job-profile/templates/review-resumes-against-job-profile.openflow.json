    "modules": {
      "n_6da84c0513be0019": {
        "name": "Read application text",
        "imports": [],
        "source": "export default function unpack({ body }) {\n  if (!body?.text) throw Error(\"Missing resume text\");\n  return { text: body.text };\n}\n"
      },
      "n_f21b3d31a157a36b": {
        "name": "Prepare candidate row",
        "imports": [],
        "source": "export default async function prepare(\n  { body, spreadsheetId, range, acknowledge, resolution, assessment },\n  ctx,\n) {\n  if (!body?.submissionId || !body?.name || !body?.email || !body?.text || !body?.driveId)\n    throw Error(\"Missing submitted PDF data\");\n  if (!spreadsheetId || spreadsheetId.includes(\"YOUR_\") || !range)\n    throw Error(\"Configure spreadsheet and range\");\n  const key = \"cv:\" + body.submissionId;\n  let s = await ctx.state.get(key);\n  if (s?.status === \"done\") return { key, write: false, spreadsheetId, range, values: [] };\n  if (s?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown sheet append \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, write: false, spreadsheetId, range, values: [] };\n    }\n  }\n  const a = assessment;\n  if (!a || typeof a !== \"object\") throw Error(\"Missing candidate assessment\");\n  const iso = new Date().toISOString().slice(0, 10);\n  const date = iso.slice(8, 10) + \"/\" + iso.slice(5, 7) + \"/\" + iso.slice(0, 4);\n  const values = [\n    [\n      date,\n      body.name,\n      a.telephone || \"\",\n      a.city || \"\",\n      body.email,\n      a.birthdate || \"\",\n      a.education || \"\",\n      a.jobHistory || \"\",\n      a.skills || \"\",\n      a.summary || \"\",\n      a.vote || \"\",\n      a.consideration || \"\",\n    ],\n  ];\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, write: true, spreadsheetId, range, values };\n}\n"
      },
      "n_6642d1e3e0461d7a": {
        "name": "Confirm candidate row",
        "imports": [],
        "source": "export default async function confirm({ key, updatedRows }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Sheet append outcome unknown\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
  },
