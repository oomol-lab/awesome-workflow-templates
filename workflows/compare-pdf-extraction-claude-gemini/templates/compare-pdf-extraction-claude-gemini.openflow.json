      "n_6342c59b4630a965": {
        "name": "Prepare complete PDF requests",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function prepare({ file, prompt }, context) {\n  if (\n    file?.mimeType !== \"application/pdf\" ||\n    typeof file.transitUrl !== \"string\" ||\n    !file.transitUrl.startsWith(\"https://\") ||\n    typeof prompt !== \"string\" ||\n    !prompt.trim()\n  )\n    throw new Error(\"Expected a Drive PDF and prompt\");\n  const response = await context.fetch(file.transitUrl, { method: \"GET\" });\n  if (!response.ok) throw new Error(\"PDF download failed\");\n  const bytes = new Uint8Array(await response.arrayBuffer());\n  if (!bytes.length || (typeof file.sizeBytes === \"number\" && bytes.length !== file.sizeBytes))\n    throw new Error(\"Incomplete PDF download\");\n  const data = Buffer.from(bytes).toString(\"base64\");\n  return {\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          { type: \"document\", source: { type: \"base64\", media_type: \"application/pdf\", data } },\n          { type: \"text\", text: prompt },\n        ],\n      },\n    ],\n    geminiBody: {\n      contents: [\n        { parts: [{ inline_data: { mime_type: \"application/pdf\", data } }, { text: prompt }] },\n      ],\n    },\n    bytes: bytes.length,\n  };\n}\n"
      },
      "n_8ae217b12d157e75": {
        "name": "Keep both model responses",
        "imports": [],
        "source": "export default function result({ claude, gemini, statusCode, bytes }) {\n  if (\n    statusCode !== 200 ||\n    !claude ||\n    typeof claude !== \"object\" ||\n    !gemini ||\n    typeof gemini !== \"object\" ||\n    !Array.isArray(claude.content) ||\n    !Array.isArray(gemini.candidates)\n  )\n    throw new Error(\"Both model responses are required\");\n  return { result: { claude, gemini, bytes } };\n}\n"
      }
    }
