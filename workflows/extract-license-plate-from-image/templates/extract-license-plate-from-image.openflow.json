    "modules": {
      "n_873aed21de5118e2": {
        "name": "Prepare plate vision request",
        "imports": [],
        "source": "export default function ({ body }) {\n  const id = String(body?.fileId || \"\");\n  if (!/^file-[A-Za-z0-9_-]+$/.test(id)) throw Error(\"Expected an OpenAI image file ID\");\n  return {\n    request: {\n      model: \"gpt-4o-mini\",\n      input: [\n        {\n          role: \"user\",\n          content: [\n            {\n              type: \"input_text\",\n              text: \"Extract the number of the license plate on the front-most car depicted in the attached image and return only the extracted characters without any other text or structure.\",\n            },\n            { type: \"input_image\", file_id: id, detail: \"auto\" },\n          ],\n        },\n      ],\n    },\n  };\n}\n"
      },
      "n_265df34fc5323511": {
        "name": "Read plate result",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body?.status !== \"completed\" || !Array.isArray(body.output))\n    throw Error(\"Incomplete analysis\");\n  const text = body.output\n    .flatMap((x) => (Array.isArray(x.content) ? x.content : []))\n    .filter((x) => x.type === \"output_text\")\n    .map((x) => x.text)\n    .filter((x) => typeof x === \"string\")\n    .join(\"\\n\")\n    .trim();\n  if (!text) throw Error(\"Missing plate result\");\n  return { body: { text } };\n}\n"
      }
    }
