    "modules": {
      "n_66c15ca543e903ad": {
        "name": "Prepare phone lookup",
        "imports": [],
        "source": "export default function prepare({phone}) { if(typeof phone!=='string'||!phone)throw Error('Enter a phone number');return{body:{processor:'get-phone-parsed',params:{phone}}}; }\n"
      },
      "n_f25beb1a2377f982": {
        "name": "Check phone validity",
        "imports": [],
        "source": "export default function results({body}){const rows=Array.isArray(body)?body:[body];return{results:rows.map(response=>({response,valid:String(response?.message?.valid)==='true'}))}}\n"
      }
    }
