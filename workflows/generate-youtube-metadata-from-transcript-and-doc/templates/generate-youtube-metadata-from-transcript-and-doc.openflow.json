    "modules": {
      "n_3fdbcf01de5fa5c1": {
        "name": "Validate video and reference",
        "imports": [],
        "source": "export default function input({ body }) {\n  const raw = String(body.videoLink || \"\").trim();\n  let id = raw;\n  if (!/^[A-Za-z0-9_-]{11}$/.test(raw)) {\n    const short = raw.match(/^https?:\\/\\/youtu\\.be\\/([A-Za-z0-9_-]{11})(?:[?#].*)?$/i),\n      watch = raw.match(/^https?:\\/\\/(?:www\\.|m\\.)?youtube\\.com\\/watch\\?([^#]+)(?:#.*)?$/i);\n    if (short) id = short[1];\n    else if (watch) {\n      const pairs = watch[1].split(\"&\").map((x) => x.split(\"=\"));\n      id = pairs.find((x) => x[0] === \"v\")?.[1] ?? \"\";\n    } else throw Error(\"Invalid YouTube URL\");\n  }\n  if (!/^[A-Za-z0-9_-]{11}$/.test(id) || !body.transcript || !body.docId)\n    throw Error(\"Missing video, transcript or document\");\n  return {\n    videoId: id,\n    ids: [id],\n    transcript: String(body.transcript),\n    keywords: String(body.keywords || \"\"),\n    docId: String(body.docId),\n  };\n}\n"
      },
      "n_c69c4136e90f3923": {
        "name": "Reserve metadata update",
        "imports": [],
        "source": "export default async function prepare({ videoId, videos, metadata, resolution }, ctx) {\n  const key = \"youtube-metadata:\" + videoId,\n    state = await ctx.state.get(key);\n  if (state?.status === \"pending\" && resolution === \"applied\") {\n    await ctx.state.set(key, { status: \"confirmed\" });\n    return { write: false, key, body: {}, endpoint: \"/videos?part=snippet\", videoId };\n  }\n  if (state?.status === \"pending\" && resolution !== \"absent\")\n    throw Error(\"Inspect unknown video update and choose applied or absent\");\n  const v = (videos ?? []).filter((x) => x.id === videoId);\n  if (v.length !== 1 || !v[0].snippet?.categoryId) throw Error(\"Video or snippet mismatch\");\n  const old = v[0].snippet,\n    m = metadata,\n    title = String(m.title || \"\").trim(),\n    description = [\n      String(m.description || \"\").trim(),\n      String(m.call_to_action || \"\").trim(),\n      (m.hashtags ?? []).join(\" \"),\n    ]\n      .filter(Boolean)\n      .join(\"\\n\\n\"),\n    tags = m.tags;\n  if (\n    !title ||\n    title.length > 100 ||\n    !description ||\n    new TextEncoder().encode(description).length > 5000 ||\n    !Array.isArray(tags) ||\n    tags.some((x) => typeof x !== \"string\") ||\n    tags.join(\",\").length > 500\n  )\n    throw Error(\"Generated metadata violates YouTube limits\");\n  const snippet = { title, description, tags, categoryId: old.categoryId };\n  for (const k of [\"defaultLanguage\", \"defaultAudioLanguage\"])\n    if (old[k] !== undefined) snippet[k] = old[k];\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    write: true,\n    key,\n    endpoint: \"/videos?part=snippet\",\n    body: { id: videoId, snippet },\n    videoId,\n  };\n}\n"
      },
      "n_b2abfd1cbee02e97": {
        "name": "Confirm video update",
        "imports": [],
        "source": "export default async function f({ key, body, statusCode, videoId }, ctx) {\n  if (statusCode < 200 || statusCode >= 300 || body?.id !== videoId)\n    throw Error(\"Unknown video update\");\n  await ctx.state.set(key, { status: \"confirmed\" });\n  return { videoId };\n}\n"
      },
      "n_b64d956ea63654e4": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f({ videoId }) {\n  return { body: JSON.stringify({ status: \"completed\", videoId }) };\n}\n"
      }
    }
