{
  "nodes": [
    {
      "id": "generate-youtube-metadata-from-transcript-and-doc-0",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {
          "buttonLabel": "Update Youtube Video"
        },
        "formTitle": "Generate YouTube metadata",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Youtube Video Link",
              "requiredField": true
            },
            {
              "fieldLabel": "Video Transcript",
              "requiredField": true
            },
            {
              "fieldLabel": "Focus Keywords",
              "placeholder": "Focus Keywords (Optional)"
            }
          ]
        },
        "formDescription": "Provide a video, transcript and optional focus keywords."
      },
      "typeVersion": 2.2
    },
    {
      "name": "Prepare submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function input({ body }) {\n  const raw = String(body.videoLink || \"\").trim();\n  let id = raw;\n  if (!/^[A-Za-z0-9_-]{11}$/.test(raw)) {\n    const short = raw.match(/^https?:\\/\\/youtu\\.be\\/([A-Za-z0-9_-]{11})(?:[?#].*)?$/i),\n      watch = raw.match(/^https?:\\/\\/(?:www\\.|m\\.)?youtube\\.com\\/watch\\?([^#]+)(?:#.*)?$/i);\n    if (short) id = short[1];\n    else if (watch) {\n      const pairs = watch[1].split(\"&\").map((x) => x.split(\"=\"));\n      id = pairs.find((x) => x[0] === \"v\")?.[1] ?? \"\";\n    } else throw Error(\"Invalid YouTube URL\");\n  }\n  if (!/^[A-Za-z0-9_-]{11}$/.test(id) || !body.transcript || !body.docId)\n    throw Error(\"Missing video, transcript or document\");\n  return {\n    videoId: id,\n    ids: [id],\n    transcript: String(body.transcript),\n    keywords: String(body.keywords || \"\"),\n    docId: String(body.docId),\n  };\n}\n\nconst body = {\n  videoLink: $json[\"Youtube Video Link\"],\n  transcript: $json[\"Video Transcript\"],\n  keywords: $json[\"Focus Keywords\"] ?? \"\",\n  docId: \"YOUR_GOOGLE_DOC_ID\",\n};\nreturn { json: { ...input({ body }), videoLink: body.videoLink, mode: \"direct\" } };\n"
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Video update not pending",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'youtube-metadata:' + $('Prepare submission').first().json.videoId }}"
            }
          ]
        }
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-2",
      "position": [
        440,
