        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {videoLink:$('Prepare submission').first().json.videoLink,transcript:$('Prepare submission').first().json.transcript,keywords:$('Prepare submission').first().json.keywords,docId:$('Prepare submission').first().json.docId} }}",
        "options": {}
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-5",
      "position": [
        1100,
