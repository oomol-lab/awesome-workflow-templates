      "typeVersion": 2
    },
    {
      "id": "generate-youtube-metadata-from-transcript-and-doc-9",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1980,
        0
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
