    },
    {
      "id": "generate-youtube-metadata-from-transcript-and-doc-10",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"hashtags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"call_to_action\":{\"type\":\"string\"}},\"required\":[\"title\",\"description\",\"tags\",\"hashtags\",\"call_to_action\"],\"additionalProperties\":false}"
      },
      "typeVersion": 1.2
    },
    {
      "name": "Prepare metadata update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $(\"Prepare submission\").first().json.videoId,\n  items = $(\"Read video snippet\").first().json.items ?? [],\n  v = items.filter((x) => x.id === id);\nif (v.length !== 1 || !v[0].snippet?.categoryId) throw Error(\"Video mismatch\");\nconst m = $json.output ?? {},\n  title = String(m.title ?? \"\").trim(),\n  description = [\n    String(m.description ?? \"\").trim(),\n    String(m.call_to_action ?? \"\").trim(),\n    (m.hashtags ?? []).join(\" \"),\n  ]\n    .filter(Boolean)\n    .join(\"\\n\\n\"),\n  tags = m.tags;\nif (\n  !title ||\n  title.length > 100 ||\n  !description ||\n  Buffer.byteLength(description) > 5000 ||\n  !Array.isArray(tags) ||\n  tags.some((x) => typeof x !== \"string\") ||\n  tags.join(\",\").length > 500\n)\n  throw Error(\"Invalid generated metadata\");\nconst s = { title, description, tags, categoryId: v[0].snippet.categoryId };\nfor (const k of [\"defaultLanguage\", \"defaultAudioLanguage\"])\n  if (v[0].snippet[k] !== undefined) s[k] = v[0].snippet[k];\nreturn { json: { body: { id, snippet: s } } };\n"
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Update video metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PUT",
        "url": "https://www.googleapis.com/youtube/v3/videos?part=snippet",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {}
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Verify video update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $(\"Prepare submission\").first().json.videoId;\nif ($json.id !== id && !($json.status === \"completed\" && $json.videoId === id))\n  throw Error(\"Unknown video update\");\nreturn { json: { ok: true } };\n"
      },
      "id": "generate-youtube-metadata-from-transcript-and-doc-13",
      "position": [
        2860,
        0
      ]
    },
