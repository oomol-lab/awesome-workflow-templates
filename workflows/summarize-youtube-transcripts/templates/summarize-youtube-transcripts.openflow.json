    "modules": {
      "n_5dfbcd13c787cdb3": {
        "name": "Combine transcript segments",
        "imports": [],
        "source": "export default function transcript({ body, statusCode }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    !body ||\n    typeof body !== \"object\" ||\n    body.error ||\n    body.search_metadata?.status === \"Error\"\n  )\n    throw Error(\"SearchApi transcript request failed\");\n  const parts = body.transcripts;\n  if (parts === undefined && Array.isArray(body.available_languages))\n    return { text: \"\", hasText: false };\n  if (!Array.isArray(parts)) throw Error(\"Missing transcripts\");\n  const text = parts\n    .map((x) => {\n      if (!x || typeof x.text !== \"string\") throw Error(\"Invalid transcript segment\");\n      return x.text;\n    })\n    .join(\" \")\n    .trim();\n  return { text, hasText: text.length > 0 };\n}\n"
      }
    }
