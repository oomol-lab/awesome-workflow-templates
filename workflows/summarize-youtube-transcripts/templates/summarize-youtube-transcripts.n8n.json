    {
      "id": "summarize-youtube-transcripts-guard",
      "name": "Check transcript response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function transcript({body,statusCode}){if(statusCode<200||statusCode>=300||!body||typeof body!=='object'||body.error||body.search_metadata?.status==='Error')throw Error('SearchApi transcript request failed');const parts=body.transcripts;if(parts===undefined&&Array.isArray(body.available_languages))return{text:'',hasText:false};if(!Array.isArray(parts))throw Error('Missing transcripts');const text=parts.map(x=>{if(!x||typeof x.text!=='string')throw Error('Invalid transcript segment');return x.text}).join(' ').trim();return{text,hasText:text.length>0}}\n\nconst body=$input.first().json,result=transcript({body,statusCode:200});return result.hasText?[{json:body}]:[];"
      }
    }
