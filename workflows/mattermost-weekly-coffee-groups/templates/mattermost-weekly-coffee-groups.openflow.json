    "modules": {
      "n_a390e5b336536fff": {
        "name": "Configure the coffee session",
        "imports": [],
        "source": "export default function coffeeConfig({ scheduledAt, channelId, calendarId }) {\n  if (!channelId || channelId.startsWith(\"YOUR_\") || !calendarId || calendarId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the Mattermost channel and Calendar ID\");\n  const time = Date.parse(scheduledAt);\n  if (!Number.isFinite(time)) throw Error(\"Schedule time is invalid\");\n  return {\n    channelId,\n    calendarId,\n    start: new Date(time + 3600000).toISOString(),\n    end: new Date(time + 5400000).toISOString(),\n  };\n}\n"
      },
      "n_41cac5e3f36fd88c": {
        "name": "Collect channel members",
        "imports": [],
        "source": "export default function coffeePages({ channelId, previousState, statusCode, body, bodyEncoding }) {\n  let state;\n  if (previousState === null) state = { page: 0, users: [], done: false };\n  else {\n    if (\n      !Number.isInteger(statusCode) ||\n      statusCode < 200 ||\n      statusCode >= 300 ||\n      bodyEncoding != null ||\n      !Array.isArray(body)\n    )\n      throw Error(\"Mattermost user page failed\");\n    if (previousState.page >= 100) throw Error(\"Channel membership exceeds pagination limit\");\n    state = {\n      page: previousState.page + 1,\n      users: previousState.users.concat(body),\n      done: body.length === 0,\n    };\n  }\n  return {\n    state,\n    more: !state.done,\n    query: { in_channel: channelId, page: state.page, per_page: 100 },\n    users: state.users,\n  };\n}\n"
      },
      "n_16455fbb3a2e4c5b": {
        "name": "Shuffle and form groups",
        "imports": [],
        "source": "export default function coffeeGroups({ users }) {\n  if (users.length < 2) return { groups: [] };\n  const entries = users.map((u) => {\n    if (\n      !u ||\n      typeof u.username !== \"string\" ||\n      !u.username ||\n      typeof u.email !== \"string\" ||\n      !u.email\n    )\n      throw Error(\"Every member needs username and email\");\n    return { username: u.username, email: u.email };\n  });\n  for (let n = entries.length; n > 0; n--) {\n    let j = Math.floor(Math.random() * n);\n    [entries[n - 1], entries[j]] = [entries[j], entries[n - 1]];\n  }\n  const groups = [];\n  for (let i = 0; i < entries.length; i += 3) groups.push(entries.slice(i, i + 3));\n  if (groups.at(-1).length === 1) groups.at(-1).push(groups.at(-2).shift());\n  return { groups };\n}\n"
      },
      "n_dde9f94789667d28": {
        "name": "Prepare each group",
        "imports": [],
        "source": "export default function coffeeNext({\n  groups,\n  channelId,\n  calendarId,\n  start,\n  end,\n  previousState,\n  statusCode,\n  bodyEncoding,\n}) {\n  let state = previousState === null ? { phase: \"announce\", index: 0 } : previousState;\n  if (previousState !== null) {\n    if (\n      previousState.phase === \"invite\" &&\n      (!Number.isInteger(statusCode) ||\n        statusCode < 200 ||\n        statusCode >= 300 ||\n        bodyEncoding != null)\n    )\n      throw Error(\"Calendar invitation failed\");\n    state = { phase: state.phase, index: state.index + 1 };\n  }\n  if (state.index >= groups.length) {\n    if (state.phase === \"announce\") state = { phase: \"invite\", index: 0 };\n    else state = { phase: \"done\", index: 0 };\n  }\n  if (!groups.length) state = { phase: \"done\", index: 0 };\n  const more = state.phase !== \"done\",\n    g = more ? groups[state.index] : [],\n    id = Date.now().toString(36) + \"-\" + Math.random().toString(36).slice(2) + \"-\" + state.index;\n  return {\n    state,\n    more,\n    announce: state.phase === \"announce\",\n    channelId,\n    message: more ? \"☀️ \" + g.map((x) => x.username).join(\", \") : \"-\",\n    endpoint: \"/calendars/\" + encodeURIComponent(calendarId) + \"/events\",\n    query: { conferenceDataVersion: 1, sendUpdates: \"all\" },\n    body: {\n      summary: \"n8n coffee catchup\",\n      start: { dateTime: start },\n      end: { dateTime: end },\n      attendees: g.map((x) => ({ email: x.email })),\n      guestsCanModify: true,\n      conferenceData: {\n        createRequest: { requestId: id, conferenceSolutionKey: { type: \"hangoutsMeet\" } },\n      },\n    },\n    count: groups.length,\n  };\n}\n"
      }
    }
  },
