    "modules": {
      "n_a390e5b336536fff": {
        "name": "Configure the coffee session",
        "imports": [],
        "source": "export default function coffeeConfig({scheduledAt,channelId,calendarId}){\n if(!channelId||channelId.startsWith('YOUR_')||!calendarId||calendarId.startsWith('YOUR_'))throw Error('Configure the Mattermost channel and Calendar ID');\n const time=Date.parse(scheduledAt);if(!Number.isFinite(time))throw Error('Schedule time is invalid');\n return{channelId,calendarId,start:new Date(time+3600000).toISOString(),end:new Date(time+5400000).toISOString()};\n}\n"
      },
      "n_41cac5e3f36fd88c": {
        "name": "Collect channel members",
        "imports": [],
        "source": "export default function coffeePages({channelId,previousState,statusCode,body,bodyEncoding}){\n let state;if(previousState===null)state={page:0,users:[],done:false};else{\n  if(!Number.isInteger(statusCode)||statusCode<200||statusCode>=300||bodyEncoding!=null||!Array.isArray(body))throw Error('Mattermost user page failed');\n  if(previousState.page>=100)throw Error('Channel membership exceeds pagination limit');\n  state={page:previousState.page+1,users:previousState.users.concat(body),done:body.length===0};\n }\n return{state,more:!state.done,query:{in_channel:channelId,page:state.page,per_page:100},users:state.users};\n}\n"
      },
      "n_16455fbb3a2e4c5b": {
        "name": "Shuffle and form groups",
        "imports": [],
        "source": "export default function coffeeGroups({users}){\n if(users.length<2)return{groups:[]};\n const entries=users.map(u=>{if(!u||typeof u.username!=='string'||!u.username||typeof u.email!=='string'||!u.email)throw Error('Every member needs username and email');return{username:u.username,email:u.email}});\n for(let n=entries.length;n>0;n--){let j=Math.floor(Math.random()*n);[entries[n-1],entries[j]]=[entries[j],entries[n-1]];}\n const groups=[];for(let i=0;i<entries.length;i+=3)groups.push(entries.slice(i,i+3));\n if(groups.at(-1).length===1)groups.at(-1).push(groups.at(-2).shift());\n return{groups};\n}\n"
      },
      "n_dde9f94789667d28": {
        "name": "Prepare each group",
        "imports": [],
        "source": "export default function coffeeNext({groups,channelId,calendarId,start,end,previousState,statusCode,bodyEncoding}){\n let state=previousState===null?{phase:'announce',index:0}:previousState;\n if(previousState!==null){if(previousState.phase==='invite'&&(!Number.isInteger(statusCode)||statusCode<200||statusCode>=300||bodyEncoding!=null))throw Error('Calendar invitation failed');state={phase:state.phase,index:state.index+1};}\n if(state.index>=groups.length){if(state.phase==='announce')state={phase:'invite',index:0};else state={phase:'done',index:0};}\n if(!groups.length)state={phase:'done',index:0};\n const more=state.phase!=='done',g=more?groups[state.index]:[],id=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+'-'+state.index;\n return{state,more,announce:state.phase==='announce',channelId,message:more?'☀️ '+g.map(x=>x.username).join(', '):'-',endpoint:'/calendars/'+encodeURIComponent(calendarId)+'/events',query:{conferenceDataVersion:1,sendUpdates:'all'},body:{summary:'n8n coffee catchup',start:{dateTime:start},end:{dateTime:end},attendees:g.map(x=>({email:x.email})),guestsCanModify:true,conferenceData:{createRequest:{requestId:id,conferenceSolutionKey:{type:'hangoutsMeet'}}}},count:groups.length};\n}\n"
      }
    }
