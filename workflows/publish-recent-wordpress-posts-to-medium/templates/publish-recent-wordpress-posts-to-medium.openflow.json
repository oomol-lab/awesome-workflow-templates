    "modules": {
      "n_74966ed698a777dc": {
        "name": "Prepare the next post",
        "imports": [],
        "source": "export default function next({posts,previous,author}){const s=previous??{index:0};if(!Array.isArray(posts)||posts.length>5)throw Error('Invalid WordPress results');if(s.index>=posts.length)return{state:s,more:false,url:'https://api.medium.com/',body:{},summary:{published:s.index}};if(typeof author?.data?.id!=='string'||!author.data.id)throw Error('Medium author was not confirmed');const p=posts[s.index],title=p?.title?.rendered,content=p?.content?.rendered;if(typeof title!=='string'||typeof content!=='string'||!title.trim()||!content.trim())throw Error('A post has no rendered title or content');const text=title.replace(/<[^>]*>/g,'').replace(/&#(x[0-9a-f]+|\\d+);/gi,(_,v)=>String.fromCodePoint(v[0].toLowerCase()==='x'?parseInt(v.slice(1),16):parseInt(v,10))).replace(/&(amp|lt|gt|quot|apos|nbsp);/gi,(_,v)=>({amp:'&',lt:'<',gt:'>',quot:'\"',apos:\"'\",nbsp:' '})[v.toLowerCase()]);if(/&[a-z][a-z0-9]+;/i.test(text))throw Error('Unsupported HTML entity in title; review before publishing');return{state:{index:s.index+1},more:true,url:'https://api.medium.com/v1/users/'+encodeURIComponent(author.data.id)+'/posts',body:{title:text,contentFormat:'html',content,tags:['Email Hosting','Email','Email Marketing'],publishStatus:'public',notifyFollowers:false},summary:{published:s.index}}}\n"
      },
      "n_36bd6d4a538f6d9f": {
        "name": "Confirm publication",
        "imports": [],
        "source": "export default function confirm({response}){if(!response?.data?.id||!response?.data?.url)throw Error('Medium publication not confirmed; inspect before retrying');return{ok:true}}\n"
      }
    }
