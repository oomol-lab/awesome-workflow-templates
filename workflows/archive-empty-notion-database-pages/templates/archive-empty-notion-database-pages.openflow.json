        "source": "function emptyProperties(properties){if(!properties||typeof properties!=='object'||Array.isArray(properties))throw Error('Malformed properties');const values=Object.values(properties);if(!values.length)return false;const arrays=['title','rich_text','multi_select','people','files','relation'],nullable=['number','url','email','phone_number','select','status','date'];for(const p of values){if(!p||typeof p.type!=='string'||!(p.type in p))throw Error('Malformed property');const v=p[p.type];if(arrays.includes(p.type)){if(!Array.isArray(v))throw Error('Malformed property value');if(v.length)return false;continue}if(nullable.includes(p.type)){if(v!==null)return false;continue}return false}return true}\nfunction emptyBlock(b){if(!b||typeof b.type!=='string'||typeof b.has_children!=='boolean')throw Error('Malformed block');if(b.has_children)return false;if(b.type!=='paragraph')return false;const p=b.paragraph;const text=p?.rich_text??p?.text;if(!Array.isArray(text))throw Error('Malformed paragraph');return text.length===0}\nexport default async function next({scan,previous,confirmation},context){const s=previous??{index:0,phase:'page',cursor:null,seen:[],pageId:null,waiting:false};if(s.waiting){if(!confirmation||confirmation.id!==s.pageId||confirmation.in_trash!==true)throw Error('Archive not confirmed');s.index++;s.phase='page';s.cursor=null;s.seen=[];s.pageId=null;s.waiting=false}if(s.index>=scan.pages.length)return{state:s,more:false,archive:false,pageId:'unused'};const id=scan.pages[s.index];if(typeof id!=='string'||!id)throw Error('Invalid page ID');if(s.phase==='page'){const p=await context.actions.call('notion.retrieve_page',{pageId:id});if(p?.id!==id||p?.object!=='page')throw Error('Unexpected page');if(typeof p.in_trash!=='boolean')throw Error('Missing page trash state');if(p.in_trash||!emptyProperties(p.properties))return{state:{...s,index:s.index+1},more:true,archive:false,pageId:'unused'};return{state:{...s,phase:'blocks',pageId:id},more:true,archive:false,pageId:'unused'}}\n if(s.phase!=='blocks'||s.pageId!==id)throw Error('Invalid scan state');const args={blockId:id,pageSize:100,...(s.cursor?{startCursor:s.cursor}:{})},r=await context.actions.call('notion.list_block_children',args);if(!r||!Array.isArray(r.results)||typeof r.has_more!=='boolean')throw Error('Invalid blocks');const cursor=r.next_cursor;if(r.has_more&&(typeof cursor!=='string'||!cursor||s.seen.includes(cursor)))throw Error('Invalid block cursor');if(!r.has_more&&cursor!==null)throw Error('Invalid final block cursor');if(r.results.some(x=>!emptyBlock(x)))return{state:{...s,index:s.index+1,phase:'page',cursor:null,seen:[],pageId:null},more:true,archive:false,pageId:'unused'};if(r.has_more)return{state:{...s,cursor,seen:[...s.seen,cursor]},more:true,archive:false,pageId:'unused'};return{state:{...s,waiting:true},more:true,archive:true,pageId:id}}\n"
