      "n_ec2a63ad440a380f": {
        "name": "List accessible database pages",
        "imports": [],
        "source": "export default async function scan({ previous }, context) {\n  const s = previous ?? {\n    phase: \"sources\",\n    cursor: null,\n    seen: [],\n    sources: [],\n    pages: [],\n    index: 0,\n  };\n  const call = s.phase === \"sources\" ? \"notion.search\" : \"notion.query_data_source\";\n  if (s.phase === \"done\") return { state: s, more: false };\n  const args =\n    s.phase === \"sources\"\n      ? { filter: { property: \"object\", value: \"data_source\" }, pageSize: 100 }\n      : { dataSourceId: s.sources[s.index], pageSize: 100 };\n  if (s.cursor) args.startCursor = s.cursor;\n  const r = await context.actions.call(call, args);\n  if (!r || !Array.isArray(r.results) || typeof r.has_more !== \"boolean\")\n    throw Error(\"Invalid Notion page\");\n  const next = r.next_cursor;\n  if (r.has_more && (typeof next !== \"string\" || !next || s.seen.includes(next)))\n    throw Error(\"Invalid Notion cursor\");\n  if (!r.has_more && next !== null) throw Error(\"Invalid final Notion cursor\");\n  if (s.phase === \"sources\") {\n    const ids = r.results.map((x) => {\n      if (x?.object !== \"data_source\" || typeof x.id !== \"string\" || !x.id)\n        throw Error(\"Invalid data source\");\n      return x.id;\n    });\n    if (new Set([...s.sources, ...ids]).size !== s.sources.length + ids.length)\n      throw Error(\"Duplicate data source\");\n    const sources = [...s.sources, ...ids];\n    return {\n      state: {\n        ...s,\n        sources,\n        phase: r.has_more ? \"sources\" : sources.length ? \"pages\" : \"done\",\n        cursor: r.has_more ? next : null,\n        seen: r.has_more ? [...s.seen, next] : [],\n      },\n      more: r.has_more || sources.length > 0,\n    };\n  }\n  const pages = r.results.map((x) => {\n    if (x?.object !== \"page\" || typeof x.id !== \"string\" || !x.id)\n      throw Error(\"Invalid database page\");\n    return x.id;\n  });\n  if (new Set([...s.pages, ...pages]).size !== s.pages.length + pages.length)\n    throw Error(\"Duplicate page\");\n  let index = s.index + (r.has_more ? 0 : 1),\n    phase = index < s.sources.length ? \"pages\" : \"done\";\n  return {\n    state: {\n      ...s,\n      index,\n      pages: [...s.pages, ...pages],\n      phase,\n      cursor: r.has_more ? next : null,\n      seen: r.has_more ? [...s.seen, next] : [],\n    },\n    more: phase !== \"done\",\n  };\n}\n"
      },
      "n_173fabfb9dff0da5": {
        "name": "Inspect the next page",
        "imports": [],
        "source": "function emptyProperties(properties) {\n  if (!properties || typeof properties !== \"object\" || Array.isArray(properties))\n    throw Error(\"Malformed properties\");\n  const values = Object.values(properties);\n  if (!values.length) return false;\n  const arrays = [\"title\", \"rich_text\", \"multi_select\", \"people\", \"files\", \"relation\"],\n    nullable = [\"number\", \"url\", \"email\", \"phone_number\", \"select\", \"status\", \"date\"];\n  for (const p of values) {\n    if (!p || typeof p.type !== \"string\" || !(p.type in p)) throw Error(\"Malformed property\");\n    const v = p[p.type];\n    if (arrays.includes(p.type)) {\n      if (!Array.isArray(v)) throw Error(\"Malformed property value\");\n      if (v.length) return false;\n      continue;\n    }\n    if (nullable.includes(p.type)) {\n      if (v !== null) return false;\n      continue;\n    }\n    return false;\n  }\n  return true;\n}\nfunction emptyBlock(b) {\n  if (!b || typeof b.type !== \"string\" || typeof b.has_children !== \"boolean\")\n    throw Error(\"Malformed block\");\n  if (b.has_children) return false;\n  if (b.type !== \"paragraph\") return false;\n  const p = b.paragraph;\n  const text = p?.rich_text ?? p?.text;\n  if (!Array.isArray(text)) throw Error(\"Malformed paragraph\");\n  return text.length === 0;\n}\nexport default async function next({ scan, previous, confirmation }, context) {\n  const s = previous ?? {\n    index: 0,\n    phase: \"page\",\n    cursor: null,\n    seen: [],\n    pageId: null,\n    waiting: false,\n  };\n  if (s.waiting) {\n    if (!confirmation || confirmation.id !== s.pageId || confirmation.in_trash !== true)\n      throw Error(\"Archive not confirmed\");\n    s.index++;\n    s.phase = \"page\";\n    s.cursor = null;\n    s.seen = [];\n    s.pageId = null;\n    s.waiting = false;\n  }\n  if (s.index >= scan.pages.length)\n    return { state: s, more: false, archive: false, pageId: \"unused\" };\n  const id = scan.pages[s.index];\n  if (typeof id !== \"string\" || !id) throw Error(\"Invalid page ID\");\n  if (s.phase === \"page\") {\n    const p = await context.actions.call(\"notion.retrieve_page\", { pageId: id });\n    if (p?.id !== id || p?.object !== \"page\") throw Error(\"Unexpected page\");\n    if (typeof p.in_trash !== \"boolean\") throw Error(\"Missing page trash state\");\n    if (p.in_trash || !emptyProperties(p.properties))\n      return { state: { ...s, index: s.index + 1 }, more: true, archive: false, pageId: \"unused\" };\n    return {\n      state: { ...s, phase: \"blocks\", pageId: id },\n      more: true,\n      archive: false,\n      pageId: \"unused\",\n    };\n  }\n  if (s.phase !== \"blocks\" || s.pageId !== id) throw Error(\"Invalid scan state\");\n  const args = { blockId: id, pageSize: 100, ...(s.cursor ? { startCursor: s.cursor } : {}) },\n    r = await context.actions.call(\"notion.list_block_children\", args);\n  if (!r || !Array.isArray(r.results) || typeof r.has_more !== \"boolean\")\n    throw Error(\"Invalid blocks\");\n  const cursor = r.next_cursor;\n  if (r.has_more && (typeof cursor !== \"string\" || !cursor || s.seen.includes(cursor)))\n    throw Error(\"Invalid block cursor\");\n  if (!r.has_more && cursor !== null) throw Error(\"Invalid final block cursor\");\n  if (r.results.some((x) => !emptyBlock(x)))\n    return {\n      state: { ...s, index: s.index + 1, phase: \"page\", cursor: null, seen: [], pageId: null },\n      more: true,\n      archive: false,\n      pageId: \"unused\",\n    };\n  if (r.has_more)\n    return {\n      state: { ...s, cursor, seen: [...s.seen, cursor] },\n      more: true,\n      archive: false,\n      pageId: \"unused\",\n    };\n  return { state: { ...s, waiting: true }, more: true, archive: true, pageId: id };\n}\n"
      }
    }
