      "n_ec2a63ad440a380f": {
        "name": "List accessible database pages",
        "imports": [],
        "source": "export default async function scan({previous},context){\n const s=previous??{phase:'sources',cursor:null,seen:[],sources:[],pages:[],index:0};\n const call=s.phase==='sources'?'notion.search':'notion.query_data_source';\n if(s.phase==='done')return{state:s,more:false};\n const args=s.phase==='sources'?{filter:{property:'object',value:'data_source'},pageSize:100}:{dataSourceId:s.sources[s.index],pageSize:100};if(s.cursor)args.startCursor=s.cursor;\n const r=await context.actions.call(call,args);if(!r||!Array.isArray(r.results)||typeof r.has_more!=='boolean')throw Error('Invalid Notion page');\n const next=r.next_cursor;if(r.has_more&&(typeof next!=='string'||!next||s.seen.includes(next)))throw Error('Invalid Notion cursor');if(!r.has_more&&next!==null)throw Error('Invalid final Notion cursor');\n if(s.phase==='sources'){const ids=r.results.map(x=>{if(x?.object!=='data_source'||typeof x.id!=='string'||!x.id)throw Error('Invalid data source');return x.id});if(new Set([...s.sources,...ids]).size!==s.sources.length+ids.length)throw Error('Duplicate data source');const sources=[...s.sources,...ids];return{state:{...s,sources,phase:r.has_more?'sources':sources.length?'pages':'done',cursor:r.has_more?next:null,seen:r.has_more?[...s.seen,next]:[]},more:r.has_more||sources.length>0}}\n const pages=r.results.map(x=>{if(x?.object!=='page'||typeof x.id!=='string'||!x.id)throw Error('Invalid database page');return x.id});if(new Set([...s.pages,...pages]).size!==s.pages.length+pages.length)throw Error('Duplicate page');let index=s.index+(r.has_more?0:1),phase=index<s.sources.length?'pages':'done';return{state:{...s,index,pages:[...s.pages,...pages],phase,cursor:r.has_more?next:null,seen:r.has_more?[...s.seen,next]:[]},more:phase!=='done'};\n}\n"
      },
