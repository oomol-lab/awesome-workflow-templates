    {
      "name": "Process Blocks",
      "type": "n8n-nodes-base.function",
      "position": [
        1360,
        280
      ],
      "parameters": {
        "functionCode": "function emptyBlock(b) {\n  if (!b || typeof b.type !== \"string\" || typeof b.has_children !== \"boolean\")\n    throw Error(\"Malformed block\");\n  if (b.has_children) return false;\n  if (b.type !== \"paragraph\") return false;\n  const p = b.paragraph;\n  const text = p?.rich_text ?? p?.text;\n  if (!Array.isArray(text)) throw Error(\"Malformed paragraph\");\n  return text.length === 0;\n}\n\nconst id = $node[\"SplitInBatches\"].json.id;\nif (typeof id !== \"string\" || !id) throw Error(\"Missing page\");\nif (items.length === 1 && Object.keys(items[0].json).length === 0)\n  return [{ json: { toDelete: true, pageID: id } }];\nif (items.some((x) => !x.json.id)) throw Error(\"Invalid block\");\nreturn [{ json: { toDelete: items.every((x) => emptyBlock(x.json)), pageID: id } }];\n"
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-3"
    },
    {
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        1000,
        280
      ],
      "parameters": {
        "options": {},
        "batchSize": 1
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-4"
    },
    {
      "name": "Check for empty properties",
      "type": "n8n-nodes-base.function",
      "position": [
        600,
        300
      ],
      "parameters": {
        "functionCode": "function emptyProperties(properties) {\n  if (!properties || typeof properties !== \"object\" || Array.isArray(properties))\n    throw Error(\"Malformed properties\");\n  const values = Object.values(properties);\n  if (!values.length) return false;\n  const arrays = [\"title\", \"rich_text\", \"multi_select\", \"people\", \"files\", \"relation\"],\n    nullable = [\"number\", \"url\", \"email\", \"phone_number\", \"select\", \"status\", \"date\"];\n  for (const p of values) {\n    if (!p || typeof p.type !== \"string\" || !(p.type in p)) throw Error(\"Malformed property\");\n    const v = p[p.type];\n    if (arrays.includes(p.type)) {\n      if (!Array.isArray(v)) throw Error(\"Malformed property value\");\n      if (v.length) return false;\n      continue;\n    }\n    if (nullable.includes(p.type)) {\n      if (v !== null) return false;\n      continue;\n    }\n    return false;\n  }\n  return true;\n}\n\nfor (const item of items) {\n  item.json.toDelete = emptyProperties(item.json.properties);\n}\nreturn items;\n"
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-5"
    },
