    {
      "name": "Process Blocks",
      "type": "n8n-nodes-base.function",
      "position": [
        1360,
        280
      ],
      "parameters": {
        "functionCode": "function emptyBlock(b){if(!b||typeof b.type!=='string'||typeof b.has_children!=='boolean')throw Error('Malformed block');if(b.has_children)return false;if(b.type!=='paragraph')return false;const p=b.paragraph;const text=p?.rich_text??p?.text;if(!Array.isArray(text))throw Error('Malformed paragraph');return text.length===0}\n\nconst id=$node['SplitInBatches'].json.id;if(typeof id!=='string'||!id)throw Error('Missing page');if(items.length===1&&Object.keys(items[0].json).length===0)return [{json:{toDelete:true,pageID:id}}];if(items.some(x=>!x.json.id))throw Error('Invalid block');return [{json:{toDelete:items.every(x=>emptyBlock(x.json)),pageID:id}}];"
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-3"
    },
    {
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        1000,
        280
      ],
      "parameters": {
        "options": {},
        "batchSize": 1
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-4"
    },
    {
      "name": "Check for empty properties",
      "type": "n8n-nodes-base.function",
      "position": [
        600,
        300
      ],
      "parameters": {
        "functionCode": "function emptyProperties(properties){if(!properties||typeof properties!=='object'||Array.isArray(properties))throw Error('Malformed properties');const values=Object.values(properties);if(!values.length)return false;const arrays=['title','rich_text','multi_select','people','files','relation'],nullable=['number','url','email','phone_number','select','status','date'];for(const p of values){if(!p||typeof p.type!=='string'||!(p.type in p))throw Error('Malformed property');const v=p[p.type];if(arrays.includes(p.type)){if(!Array.isArray(v))throw Error('Malformed property value');if(v.length)return false;continue}if(nullable.includes(p.type)){if(v!==null)return false;continue}return false}return true}\n\nfor(const item of items){item.json.toDelete=emptyProperties(item.json.properties)}return items;"
      },
      "typeVersion": 1,
      "id": "archive-empty-notion-database-pages-5"
    },
