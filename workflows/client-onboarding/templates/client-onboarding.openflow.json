    "modules": {
      "n_4933fa836a773854": {
        "name": "Prepare client",
        "imports": [],
        "source": "import { randomUUID } from 'node:crypto';\n\nexport default function prepareClient({ body, senderName }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('Client data must be an object.');\n  const text = (value) => value == null ? '' : String(value).trim();\n  const name = text(body.client_name || body.name);\n  const email = text(body.client_email || body.email);\n  if (!name) throw new Error('Client name required.');\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('A valid client email is required.');\n  const company = text(body.company_name || body.company);\n  const projectType = text(body.project_type) || 'General';\n  const clientId = 'CF-' + randomUUID();\n  const onboardedAt = new Date().toISOString();\n  return {\n    name, email, company, projectType, clientId, onboardedAt,\n    subject: `Welcome aboard, ${name}!`,\n    message: `Hi ${name},\\n\\nWelcome! We're excited to start working on your ${projectType} project.\\n\\nWe'll be in touch soon with next steps and a kick-off meeting invite.\\n\\nBest regards,\\n${text(senderName) || 'The Team'}`,\n    values: [[clientId, name, email, company, projectType, onboardedAt]],\n  };\n}\n"
      }
    }
  },
