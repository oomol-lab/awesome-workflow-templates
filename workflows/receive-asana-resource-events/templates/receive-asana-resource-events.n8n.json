{
  "name": "Receive Asana Resource Events",
  "nodes": [
    {
      "name": "Asana-Trigger",
      "type": "n8n-nodes-base.asanaTrigger",
      "position": [
        1490,
        860
      ],
      "parameters": {
        "resource": "YOUR_ASANA_RESOURCE_ID",
        "workspace": "YOUR_ASANA_WORKSPACE_ID"
      },
      "typeVersion": 1,
      "id": "receive-asana-resource-events-0"
    },
    {
      "id": "receive-asana-resource-events-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "Asana-Trigger": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
