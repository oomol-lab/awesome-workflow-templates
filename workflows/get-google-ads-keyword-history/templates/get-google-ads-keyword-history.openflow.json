    "modules": {
      "n_c58e9cab956a6ce2": {
        "name": "Set account and keywords",
        "imports": [],
        "source": "function prepareHistoricalQuery({ customerId, managerId, keywords }) {\n  const isId = (value) => typeof value === \"string\" && /^\\d{10}$/.test(value);\n  if (!isId(customerId) || !(managerId === \"\" || isId(managerId)))\n    throw Error(\"Use 10-digit Google Ads account IDs without dashes.\");\n  if (\n    !Array.isArray(keywords) ||\n    !keywords.length ||\n    keywords.length > 20 ||\n    keywords.some((value) => typeof value !== \"string\" || !value.trim())\n  ) {\n    throw Error(\"Enter an array of 1 to 20 nonempty keywords.\");\n  }\n  return {\n    endpoint: \"/customers/\" + customerId + \":generateKeywordHistoricalMetrics\",\n    headers: managerId ? { \"login-customer-id\": managerId } : {},\n    body: { keywords: keywords.map((word) => word.trim()), keywordPlanNetwork: \"GOOGLE_SEARCH\" },\n  };\n}\nexport default ({ settings }) => prepareHistoricalQuery(settings);\n"
      },
      "n_e18fc879071a8ad8": {
        "name": "Read the returned keyword groups",
        "imports": [],
        "source": "function returnedKeywordGroups({ statusCode, body }) {\n  if (\n    statusCode !== 200 ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body.error\n  ) {\n    throw Error(\"Google Ads did not return historical keyword metrics (HTTP \" + statusCode + \").\");\n  }\n  const rows = body.results ?? [];\n  if (\n    !Array.isArray(rows) ||\n    rows.some(\n      (row) =>\n        typeof row?.text !== \"string\" ||\n        !row.text ||\n        (row.closeVariants !== undefined &&\n          (!Array.isArray(row.closeVariants) ||\n            row.closeVariants.some((word) => typeof word !== \"string\"))) ||\n        (row.keywordMetrics !== undefined &&\n          (!row.keywordMetrics ||\n            typeof row.keywordMetrics !== \"object\" ||\n            Array.isArray(row.keywordMetrics))),\n    )\n  ) {\n    throw Error(\"Google Ads returned an unexpected keyword metrics response.\");\n  }\n  return rows;\n}\nexport default (input) => ({ results: returnedKeywordGroups(input) });\n"
      }
