      "n_d9ba7da2d93f3576": {
        "name": "Select user or anonymous identity",
        "imports": [],
        "source": "import { randomUUID } from 'node:crypto';\n\nexport default function selectIdentity({ userId }) {\n  if (userId !== null && typeof userId !== 'string') throw new Error('User ID must be text or left empty');\n  return userId ? { userId, anonymousId: null } : { userId: null, anonymousId: randomUUID() };\n}\n"
      }
