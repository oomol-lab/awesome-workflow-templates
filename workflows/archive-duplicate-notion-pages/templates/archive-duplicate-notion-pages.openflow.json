    "modules": {
      "n_f7db4443d4ab7e55": {
        "name": "Find and archive duplicates",
        "imports": [],
        "source": "export default async function ({ sourceId, property, acknowledgePageId }, ctx) {\n  if (!sourceId || sourceId.startsWith(\"YOUR_\") || !property || property.startsWith(\"YOUR_\"))\n    throw Error(\"Configure data source and property\");\n  const checkpoint = (await ctx.state.get(\"notion-dedupe\")) ?? { pending: null, acknowledged: [] };\n  if (checkpoint.pending) {\n    if (acknowledgePageId !== checkpoint.pending)\n      throw Error(\"Inspect pending archived page \" + checkpoint.pending);\n    checkpoint.acknowledged.push(checkpoint.pending);\n    checkpoint.pending = null;\n    await ctx.state.set(\"notion-dedupe\", checkpoint);\n  }\n  let cursor,\n    seen = new Set(),\n    pages = [];\n  do {\n    const r = await ctx.actions.call(\"notion.query_data_source\", {\n      dataSourceId: sourceId,\n      pageSize: 100,\n      ...(cursor ? { startCursor: cursor } : {}),\n    });\n    if (!Array.isArray(r?.results) || typeof r.has_more !== \"boolean\")\n      throw Error(\"Invalid Notion page\");\n    pages.push(...r.results);\n    cursor = r.has_more ? r.next_cursor : null;\n    if (cursor) {\n      if (typeof cursor !== \"string\" || seen.has(cursor)) throw Error(\"Invalid cursor\");\n      seen.add(cursor);\n    } else if (r.has_more) throw Error(\"Missing cursor\");\n  } while (cursor);\n  const entries = pages\n    .map((p) => {\n      const prop = p?.properties?.[property],\n        type = prop?.type,\n        parts = prop?.[type];\n      if (\n        !p?.id ||\n        !p.created_time ||\n        ![\"title\", \"rich_text\"].includes(type) ||\n        !Array.isArray(parts) ||\n        parts.length >= 25 ||\n        parts.some((x) => typeof x?.plain_text !== \"string\")\n      )\n        throw Error(\"Unsupported or incomplete text property\");\n      return {\n        id: p.id,\n        created: p.created_time,\n        key: parts.map((x) => x.plain_text ?? \"\").join(\"\"),\n      };\n    })\n    .filter((x) => x.key)\n    .sort((a, b) => a.created.localeCompare(b.created) || a.id.localeCompare(b.id));\n  const keys = new Set(),\n    ids = new Set(),\n    done = [];\n  for (const e of entries) {\n    if (ids.has(e.id)) continue;\n    ids.add(e.id);\n    if (!keys.has(e.key)) {\n      keys.add(e.key);\n      continue;\n    }\n    if (checkpoint.acknowledged.includes(e.id)) continue;\n    checkpoint.pending = e.id;\n    await ctx.state.set(\"notion-dedupe\", checkpoint);\n    const r = await ctx.actions.call(\"notion.update_page\", { pageId: e.id, in_trash: true });\n    if (r?.id !== e.id || r.in_trash !== true) throw Error(\"Archive not confirmed\");\n    checkpoint.pending = null;\n    await ctx.state.set(\"notion-dedupe\", checkpoint);\n    done.push(e.id);\n  }\n  return { archived: done };\n}\n"
      }
