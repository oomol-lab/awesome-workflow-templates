    "modules": {
      "n_2b0d95c3b432804c": {
        "name": "Select execution page",
        "imports": [],
        "source": "export default function page({ cursor, baseUrl }) {\n  return {\n    url:\n      baseUrl.replace(/\\/+$/, \"\") +\n      \"/api/v1/executions?limit=100\" +\n      (cursor ? \"&cursor=\" + encodeURIComponent(cursor) : \"\"),\n  };\n}\n"
      },
      "n_9859c2eb1aed66b9": {
        "name": "Collect records older than ten days",
        "imports": [],
        "source": "export default function collect({ page, previous }) {\n  const ids = [...(previous?.ids ?? [])];\n  const cutoff = previous?.cutoff ?? Date.now() - 10 * 24 * 60 * 60 * 1000;\n  for (const x of page.data) {\n    const t = Date.parse(x.startedAt);\n    if (Number.isFinite(t) && t < cutoff) ids.push(String(x.id));\n  }\n  return {\n    state: { ids, cutoff },\n    ids,\n    hasNext: !!page.nextCursor,\n    nextCursor: page.nextCursor ?? \"\",\n  };\n}\n"
      },
      "n_69c0a53f7ae6f6ea": {
        "name": "Select old execution",
        "imports": [],
        "source": "export default function next({ state, previous, baseUrl }) {\n  const index = previous?.index ?? 0;\n  if (index >= state.ids.length)\n    return { state: { index }, hasItem: false, url: \"https://example.com/unused\", count: index };\n  const base = baseUrl.replace(/\\/+$/, \"\");\n  return {\n    state: { index: index + 1 },\n    hasItem: true,\n    url: base + \"/api/v1/executions/\" + encodeURIComponent(state.ids[index]),\n    count: index,\n  };\n}\n"
      }
    }
