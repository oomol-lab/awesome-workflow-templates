    {
      "id": "send-ubereats-receipts-to-slack-4",
      "name": "Extract Price, Shop, Date, TIme",
      "type": "n8n-nodes-base.code",
      "position": [
        620,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function format({body}){if(typeof body!=='string')throw Error('Email has no plain text');const amount=body.match(/\\$(\\d+(?:\\.\\d{2})?)/)?.[1],shop=body.match(/以下是您在([\\u4e00-\\u9fa5a-zA-Z0-9\\s]+)訂購/)?.[1],date=body.match(/Date: (\\d{4})年(\\d{1,2})月(\\d{1,2})日/),time=body.match(/(上午|下午) (\\d{1,2}):(\\d{2})/);if(!amount||!shop||!date)throw Error('Receipt does not match the expected format');const day=`${date[1]}.${date[2]}.${date[3]}`,hour=time?((Number(time[2])%12)+(time[1]==='下午'?12:0))+':'+time[3]:'';const link='moze3://expense?'+Object.entries({amount,account:'信用卡',subcategory:'外送',store:shop,date:day,project:'生活開銷',...(time?{time:hour}:{})}).map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&');const esc=x=>x.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');const text=`Ubereat 訂餐資訊:\\n商家: ${shop}\\n金額: ${amount}\\n日期: ${day}\\n記帳網址: ${link}`,blocks=[{type:'section',text:{type:'mrkdwn',text:`Ubereat 訂餐資訊:\\n\\n*商家:* ${esc(shop)}\\n*金額:* ${amount}\\n*日期:* ${day}`}},{type:'divider'},{type:'section',text:{type:'mrkdwn',text:'Moze 記帳請點我'},accessory:{type:'button',text:{type:'plain_text',text:'記帳'},value:'click',url:link,action_id:'button-action'}}];return{text,blocks};}\n\nreturn {json:format({body:$json.text})};"
      },
      "typeVersion": 2
    },
    {
      "id": "send-ubereats-receipts-to-slack-5",
      "name": "Send to Slack with Block",
      "type": "n8n-nodes-base.slack",
      "position": [
        800,
        60
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "select": "channel",
        "blocksUi": "={{ {blocks:$json.blocks} }}",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID"
        },
        "messageType": "block",
        "otherOptions": {
          "includeLinkToWorkflow": false
        },
        "authentication": "oAuth2"
      },
      "typeVersion": 2.3
    }
  ],
