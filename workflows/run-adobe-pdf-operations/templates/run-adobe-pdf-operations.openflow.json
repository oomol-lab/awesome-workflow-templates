    "modules": {
      "n_7e26feeff4f20b7b": {
        "name": "Inspect operation progress",
        "imports": [],
        "source": "export default async function ({ requestId, fileUrl, endpoint, payload }, ctx) {\n  if (\n    !/^[a-zA-Z0-9_-]{1,80}$/.test(requestId) ||\n    !/^https:\\/\\//.test(fileUrl) ||\n    !/^[a-z][a-z0-9]{1,40}$/.test(endpoint) ||\n    !payload ||\n    typeof payload !== \"object\" ||\n    Array.isArray(payload) ||\n    \"assetID\" in payload\n  )\n    throw Error(\"Provide request ID, HTTPS PDF URL, Adobe operation and payload without assetID\");\n  const key = \"adobe:\" + requestId,\n    s = await ctx.state.get(key);\n  if (\n    s &&\n    (s.fileUrl !== fileUrl ||\n      s.endpoint !== endpoint ||\n      JSON.stringify(s.payload) !== JSON.stringify(payload))\n  )\n    throw Error(\"Request ID belongs to another input\");\n  if (s?.phase === \"asset-pending\" || s?.phase === \"job-pending\")\n    throw Error(\"Inspect Adobe before retrying unknown result\");\n  if (!s) {\n    await ctx.state.set(key, { phase: \"asset-pending\", fileUrl, endpoint, payload });\n    return { key, mode: \"asset\" };\n  }\n  return { key, mode: s.jobUrl ? \"poll\" : s.assetID ? \"upload\" : \"asset\" };\n}\n"
      },
      "n_632bacb43d8856c2": {
        "name": "Record Adobe asset",
        "imports": [],
        "source": "export default async function ({ key, response }, ctx) {\n  if (typeof response?.assetID !== \"string\" || !/^https:\\/\\//.test(response?.uploadUri ?? \"\"))\n    throw Error(\"Unknown Adobe asset\");\n  let s = await ctx.state.get(key);\n  await ctx.state.set(key, {\n    ...s,\n    phase: \"asset-ready\",\n    assetID: response.assetID,\n    uploadUri: response.uploadUri,\n  });\n  return { ok: true };\n}\n"
      },
      "n_e866d133f5979bb6": {
        "name": "Prepare PDF transfer",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  const s = await ctx.state.get(key);\n  if (!s?.assetID || !s.uploadUri) throw Error(\"Missing Adobe asset\");\n  return { body: { fileUrl: s.fileUrl, uploadUri: s.uploadUri } };\n}\n"
      },
      "n_6deb193da3618251": {
        "name": "Confirm PDF transfer",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body?.ok !== true) throw Error(\"PDF transfer not confirmed\");\n  return { ok: true };\n}\n"
      },
      "n_f54f0a3f7668de96": {
        "name": "Prepare Adobe operation",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  let s = await ctx.state.get(key);\n  if (!s?.assetID) throw Error(\"Missing Adobe asset\");\n  await ctx.state.set(key, { ...s, phase: \"job-pending\" });\n  return { body: { endpoint: s.endpoint, payload: { ...s.payload, assetID: s.assetID } } };\n}\n"
      },
      "n_0e601331b6568012": {
        "name": "Record operation URL",
        "imports": [],
        "source": "export default async function ({ key, response }, ctx) {\n  const u = response?.location;\n  if (typeof u !== \"string\" || !/^https:\\/\\/pdf-services\\.adobe\\.io\\/operation\\//.test(u))\n    throw Error(\"Unknown Adobe operation\");\n  let s = await ctx.state.get(key);\n  await ctx.state.set(key, { ...s, phase: \"poll\", jobUrl: u });\n  return { ok: true };\n}\n"
      },
      "n_086ae9e3e96470dd": {
        "name": "Prepare status request",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  const s = await ctx.state.get(key);\n  if (!s?.jobUrl) throw Error(\"Missing operation URL\");\n  return { body: { url: s.jobUrl } };\n}\n"
      },
      "n_c03da288674469a8": {
        "name": "Read Adobe status",
        "imports": [],
        "source": "export default function ({ response }) {\n  if (response?.status === \"in progress\") return { ready: false, result: {} };\n  if (response?.status !== \"done\") throw Error(\"Adobe operation failed or returned unknown status\");\n  return { ready: true, result: response };\n}\n"
      }
    }
  },
