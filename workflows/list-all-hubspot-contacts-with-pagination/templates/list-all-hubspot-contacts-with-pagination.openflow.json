    "modules": {
      "n_9325c91195a10e34": {
        "name": "Collect contact pages",
        "imports": [],
        "source": "export default function pages({previousState,response,statusCode}){let state=previousState??{contacts:[],seen:[],cursor:null};if(!Array.isArray(state.contacts)||!Array.isArray(state.seen))throw Error('Invalid page state');if(response!=null){if(statusCode<200||statusCode>=300||!Array.isArray(response.results))throw Error('Invalid HubSpot page');const p=response.paging;if(p!=null&&(typeof p!=='object'||Array.isArray(p)))throw Error('Invalid paging');const next=p?.next;if(next!=null&&(typeof next!=='object'||typeof next.after!=='string'||!next.after||state.seen.includes(next.after)))throw Error('Invalid or repeated cursor');state={contacts:state.contacts.concat(response.results),seen:next?state.seen.concat(next.after):state.seen,cursor:next?.after??null}}return{state,more:response==null||state.cursor!=null,params:{limit:100,...(state.cursor?{after:state.cursor}:{})},contacts:state.contacts}}\n"
      }
