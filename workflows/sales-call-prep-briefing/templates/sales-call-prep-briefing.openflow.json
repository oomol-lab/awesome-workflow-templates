    "modules": {
      "n_476c5f95d216b625": {
        "name": "Extract company domain",
        "imports": [],
        "source": "const FREE_DOMAINS = new Set([\n  \"gmail.com\",\n  \"yahoo.com\",\n  \"outlook.com\",\n  \"hotmail.com\",\n  \"icloud.com\",\n  \"proton.me\",\n]);\nexport default function extractDomain({ attendeeEmails }) {\n  for (const email of attendeeEmails ?? []) {\n    const parts = String(email).trim().toLowerCase().split(\"@\");\n    if (parts.length === 2 && parts[1] && !FREE_DOMAINS.has(parts[1])) {\n      return { domain: parts[1], websiteUrl: \"https://\" + parts[1] };\n    }\n  }\n  return { domain: \"example.com\", websiteUrl: \"https://example.com\" };\n}\n"
      },
      "n_e61d4cdd396b6faf": {
        "name": "Extract readable site text",
        "imports": [],
        "source": "export default function cleanHtml({ body }) {\n  const text = String(body ?? \"\")\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, \" \")\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, \" \")\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .slice(0, 8000);\n  return { siteText: text || \"No homepage text extracted.\" };\n}\n"
      }
    }
