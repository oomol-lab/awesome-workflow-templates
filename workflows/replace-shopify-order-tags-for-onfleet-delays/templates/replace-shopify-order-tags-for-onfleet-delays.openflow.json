    "modules": {
      "n_a974f54f5f88ce11": {
        "name": "Map task to order and replacement tags",
        "imports": [],
        "source": "export default function map({ body, taskOrders, tags }) {\n  if (\n    body?.triggerId !== 12 ||\n    body?.triggerName !== \"taskDelayed\" ||\n    typeof body.taskId !== \"string\" ||\n    !body.taskId\n  )\n    throw Error(\"Expected an Onfleet taskDelayed event\");\n  if (body.data?.task?.id && body.data.task.id !== body.taskId)\n    throw Error(\"Onfleet task IDs disagree\");\n  if (!taskOrders || typeof taskOrders !== \"object\" || !Object.hasOwn(taskOrders, body.taskId))\n    throw Error(\"Configure a Shopify order for this Onfleet task\");\n  const id = taskOrders[body.taskId];\n  if (typeof id !== \"string\" || !/^gid:\\/\\/shopify\\/Order\\/\\d+$/.test(id))\n    throw Error(\"Configure the Shopify order GraphQL ID\");\n  if (\n    !Array.isArray(tags) ||\n    !tags.length ||\n    tags.some((t) => typeof t !== \"string\" || !t.trim() || t.startsWith(\"YOUR_\"))\n  )\n    throw Error(\"Configure replacement tags\");\n  const variables = { input: { id, tags } },\n    query =\n      \"mutation UpdateOrder($input: OrderInput!){orderUpdate(input:$input){order{id} userErrors{field message}}}\";\n  return { variables, requestBody: { query, variables } };\n}\n"
      },
      "n_c8ffe513809533b8": {
        "name": "Confirm the same order",
        "imports": [],
        "source": "export default function confirm({ data, variables }) {\n  const result = data?.data?.orderUpdate;\n  if (\n    !result ||\n    !Array.isArray(result.userErrors) ||\n    result.userErrors.length ||\n    result.order?.id !== variables.input.id\n  )\n    throw Error(\"Shopify did not confirm the expected order update\");\n  return { confirmed: true };\n}\n"
      }
    }
