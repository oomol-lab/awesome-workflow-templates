      "n_8aff457b4b70b006": {
        "name": "Select the icon and logo URLs",
        "imports": [],
        "source": "export default function brandAirtable({name, logos}) {\n  if (typeof name !== 'string' || !name.trim() || !Array.isArray(logos)) throw new Error('Brand name and logo assets are required');\n  function validUrl(value) {\n    if (typeof value !== 'string' || /[\\s\\x00-\\x1f\\x7f\\\\]/.test(value) || /%(?![0-9a-f]{2})/i.test(value)) return false;\n    const match = /^https?:\\/\\/([^/?#]+)(?:[/?#].*)?$/i.exec(value);\n    if (!match || match[1].includes('@')) return false;\n    const authority = match[1];\n    let host, port;\n    if (authority.startsWith('[')) {\n      const parts = /^\\[([0-9a-f:]+)\\](?::(\\d+))?$/i.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      const halves = host.split('::');\n      if (halves.length > 2) return false;\n      const groups = halves.flatMap(part => part ? part.split(':') : []);\n      if (groups.some(group => !/^[0-9a-f]{1,4}$/i.test(group))) return false;\n      if (halves.length === 1 ? groups.length !== 8 : groups.length >= 8) return false;\n    } else {\n      const parts = /^([^:]+)(?::(\\d+))?$/.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      if (host.length > 253) return false;\n      const labels = host.replace(/\\.$/, '').split('.');\n      if (!labels.every(label => label.length > 0 && label.length <= 63 && /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(label))) return false;\n      if (labels.every(label => /^\\d+$/.test(label)) && (labels.length !== 4 || labels.some(label => Number(label) > 255))) return false;\n    }\n    return port === undefined || (port.length <= 5 && Number(port) <= 65535);\n  }\n  function asset(type) {\n    for (const logo of logos) {\n      if (logo?.type !== type || !Array.isArray(logo.formats)) continue;\n      for (const format of logo.formats) {\n        if (validUrl(format?.src)) return format.src;\n      }\n    }\n    throw new Error(`No usable ${type} URL returned by Brandfetch`);\n  }\n  return {records:[{fields:{Name:name,'Icon URL':asset('icon'),'Logo URL':asset('logo')}}]};\n}\n"
      }
    }
  },
