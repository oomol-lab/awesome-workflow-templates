        "imports": [],
        "source": "export default function prepare({ body }) {\n  const text = body?.drinks?.[0]?.strInstructions;\n  if (typeof text !== \"string\" || !text) throw Error(\"Cocktail response has no instructions\");\n  return { texts: [text] };\n}\n"
