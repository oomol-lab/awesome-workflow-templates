    "modules": {
      "n_495b93c65ceaa592": {
        "name": "Select next email",
        "imports": [],
        "source": "export default async function next({ events, acknowledgeId }, ctx) {\n  if (!Array.isArray(events)) throw Error(\"Invalid Gmail events\");\n  const s = (await ctx.state.get(\"promo-audio\")) ?? { queue: [], pending: null, done: [] };\n  for (const e of events) {\n    const id = e?.messageId;\n    if (typeof id !== \"string\" || !id) throw Error(\"Invalid Gmail message ID\");\n    if (!s.done.includes(id) && !s.queue.includes(id)) {\n      s.queue.push(id);\n    }\n  }\n  await ctx.state.set(\"promo-audio\", s);\n  if (s.pending) {\n    if (s.pending !== acknowledgeId)\n      throw Error(\"Inspect Telegram audio for Gmail message \" + s.pending);\n    s.done.push(s.pending);\n    s.queue = s.queue.filter((x) => x !== s.pending);\n    s.pending = null;\n    await ctx.state.set(\"promo-audio\", s);\n  }\n  return { more: s.queue.length > 0, id: s.queue[0] ?? \"\" };\n}\n"
      },
      "n_1e1d3027618f6208": {
        "name": "Prepare narration",
        "imports": [],
        "source": "export default async function prepare({ text }) {\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Model returned no summary\");\n  const summary = text.trim().slice(0, 247);\n  return { summary, body: { text: summary, voice: \"en_us_001\" } };\n}\n"
      },
      "n_980b645ea7266646": {
        "name": "Checkpoint audio delivery",
        "imports": [],
        "source": "export default async function pending({ id, tts, summary, chatId }, ctx) {\n  if (!/^-?\\d+$/.test(chatId)) throw Error(\"Configure Telegram chat ID\");\n  if (tts?.success !== true || typeof tts.data !== \"string\" || !tts.data)\n    throw Error(\"TTS did not return audio\");\n  const s = await ctx.state.get(\"promo-audio\");\n  if (!s || s.queue[0] !== id || s.pending) throw Error(\"Promotion state mismatch\");\n  s.pending = id;\n  await ctx.state.set(\"promo-audio\", s);\n  return { body: { id, chatId, audio: tts.data, caption: summary } };\n}\n"
      },
      "n_5a2430fa7b803fd5": {
        "name": "Confirm audio delivery",
        "imports": [],
        "source": "export default async function done({ id, response }, ctx) {\n  if (response?.ok !== true) throw Error(\"Audio delivery not confirmed\");\n  const s = await ctx.state.get(\"promo-audio\");\n  if (!s || s.pending !== id) throw Error(\"Promotion state mismatch\");\n  s.pending = null;\n  s.queue.shift();\n  s.done.push(id);\n  await ctx.state.set(\"promo-audio\", s);\n  return { ok: true };\n}\n"
      }
    }
  },
