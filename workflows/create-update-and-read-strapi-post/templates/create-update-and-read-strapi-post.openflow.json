    "modules": {
      "n_52954c0e286064c3": {
        "name": "Prepare post",
        "imports": [],
        "source": "export default async function({instanceUrl,title,content,description,slug}){let u;try{u=new URL(instanceUrl)}catch{throw Error('Enter an HTTPS Strapi instance URL')}if(u.protocol!=='https:'||u.username||u.password||u.search||u.hash)throw Error('Enter an HTTPS Strapi instance URL');if(!title.trim()||!content.trim()||!description.trim()||!slug.trim())throw Error('Enter post fields and slug');return {url:u.toString().replace(/\\/$/,'')+'/api/posts',body:{data:{Title:title,Content:content,Description:description}},slug}}\n"
      },
      "n_2108ab81003455c9": {
        "name": "Prepare slug update",
        "imports": [],
        "source": "export default async function({body,url,slug}){const d=body?.data;if(!d||typeof d.documentId!=='string'||!/^[A-Za-z0-9_-]+$/.test(d.documentId))throw Error('Strapi did not return a document ID');return {url:url+'/'+encodeURIComponent(d.documentId),id:d.documentId,body:{data:{slug}}}}\n"
      },
      "n_7b544fd52115100e": {
        "name": "Confirm update",
        "imports": [],
        "source": "export default async function({body,url,id,slug}){if(body?.data?.documentId!==id||body?.data?.slug!==slug)throw Error('Strapi did not confirm the update');return {url,id}}\n"
      },
      "n_aedf56a1f2cf2d9b": {
        "name": "Confirm post",
        "imports": [],
        "source": "export default async function({body,id}){if(body?.data?.documentId!==id)throw Error('Strapi returned a different document');return {post:body.data}}\n"
      }
    }
