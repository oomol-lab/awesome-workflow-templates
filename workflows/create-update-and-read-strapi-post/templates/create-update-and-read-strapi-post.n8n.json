{
  "name": "Create, Update and Read a Strapi Post",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-and-read-strapi-post-0"
    },
    {
      "name": "Set post details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const instanceUrl = \"\",\n  title = \"\",\n  content = \"\",\n  description = \"\",\n  slug = \"\";\nif (\n  !/^https:\\/\\/[^\\s@?#]+$/i.test(instanceUrl) ||\n  ![title, content, description, slug].every((s) => s.trim())\n)\n  throw Error(\"Enter an HTTPS instance and post fields\");\nreturn [\n  {\n    json: {\n      url: instanceUrl.replace(/\\/$/, \"\") + \"/api/posts\",\n      body: { data: { Title: title, Content: content, Description: description } },\n      slug,\n    },\n  },\n];\n"
      },
      "id": "create-update-and-read-strapi-post-1"
    },
    {
      "name": "Create post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-update-and-read-strapi-post-2"
    },
    {
      "name": "Prepare slug update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const s = $(\"Set post details\").first().json,\n  id = $input.first().json.data?.documentId;\nif (typeof id !== \"string\" || !/^[A-Za-z0-9_-]+$/.test(id)) throw Error(\"Missing document ID\");\nreturn [\n  { json: { url: s.url + \"/\" + encodeURIComponent(id), id, body: { data: { slug: s.slug } } } },\n];\n"
      },
      "id": "create-update-and-read-strapi-post-3"
    },
    {
      "name": "Update slug",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-update-and-read-strapi-post-4"
    },
    {
      "name": "Confirm update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d = $input.first().json.data,\n  p = $(\"Prepare slug update\").first().json,\n  s = $(\"Set post details\").first().json;\nif (d?.documentId !== p.id || d?.slug !== s.slug) throw Error(\"Update not confirmed\");\nreturn [{ json: { url: p.url, id: p.id } }];\n"
      },
      "id": "create-update-and-read-strapi-post-5"
    },
    {
      "name": "Read post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-update-and-read-strapi-post-6"
    },
    {
      "name": "Confirm post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d = $input.first().json.data,\n  id = $(\"Prepare slug update\").first().json.id;\nif (d?.documentId !== id) throw Error(\"Wrong document\");\nreturn [{ json: { post: d } }];\n"
      },
      "id": "create-update-and-read-strapi-post-7"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set post details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set post details": {
      "main": [
        [
          {
            "node": "Create post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create post": {
      "main": [
        [
          {
            "node": "Prepare slug update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare slug update": {
      "main": [
        [
          {
            "node": "Update slug",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update slug": {
      "main": [
        [
          {
            "node": "Confirm update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm update": {
      "main": [
        [
          {
            "node": "Read post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read post": {
      "main": [
        [
          {
            "node": "Confirm post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
