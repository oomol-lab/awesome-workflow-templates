      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (\n  !$binary?.data ||\n  !String($binary.data.mimeType || \"\")\n    .toLowerCase()\n    .startsWith(\"audio/\")\n)\n  throw Error(\"Missing generated audio\");\nreturn { json: $json, binary: $binary };\n"
