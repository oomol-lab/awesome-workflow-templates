    {
      "name": "Validate speech input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {},\n  voice = typeof b.voice_id === \"string\" ? b.voice_id.trim() : \"\",\n  text = typeof b.text === \"string\" ? b.text : \"\",\n  id = typeof b.request_id === \"string\" ? b.request_id.trim() : \"\";\nreturn {\n  json: { valid: /^[A-Za-z0-9_-]+$/.test(voice) && !!text.trim() && text.length <= 10000 && !!id },\n};\n"
      },
      "position": [
        2200,
        0
      ],
      "id": "generate-elevenlabs-speech-from-webhook-10"
    },
