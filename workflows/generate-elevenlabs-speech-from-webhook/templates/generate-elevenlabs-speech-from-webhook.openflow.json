    "modules": {
      "n_8e9098072d51ca4b": {
        "name": "Validate and reserve speech",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async function ({ body }, ctx) {\n  const voiceId = String(body?.voice_id || \"\").trim(),\n    text = String(body?.text || \"\"),\n    requestId = String(body?.request_id || \"\").trim();\n  if (!/^[A-Za-z0-9_-]+$/.test(voiceId) || !text.trim() || text.length > 10000 || !requestId)\n    throw Error(\"Provide voice, text up to 10000 characters, and request ID\");\n  const key = \"speech:\" + requestId,\n    hash = createHash(\"sha256\")\n      .update(JSON.stringify([voiceId, text]))\n      .digest(\"hex\"),\n    s = await ctx.state.get(key);\n  if (s && s.hash !== hash) throw Error(\"Request ID belongs to different input\");\n  if (s?.status === \"pending\") throw Error(\"Inspect ElevenLabs before retrying unknown generation\");\n  if (s?.status === \"done\") return { voiceId, text, key, hash, generate: false, cached: s.file };\n  await ctx.state.set(key, { status: \"pending\", hash });\n  return { voiceId, text, key, hash, generate: true, cached: null };\n}\n"
      },
      "n_9f7d77d51e69a79e": {
        "name": "Confirm generated audio",
        "imports": [],
        "source": "export default async function ({ key, hash, file }, ctx) {\n  if (\n    typeof file?.s3url !== \"string\" ||\n    !/^https:\\/\\//.test(file.s3url) ||\n    file.mimetype !== \"audio/mpeg\"\n  )\n    throw Error(\"Unknown audio result; inspect ElevenLabs\");\n  await ctx.state.set(key, { status: \"done\", hash, file });\n  return { file };\n}\n"
      },
      "n_ce81c936c609861e": {
        "name": "Return generated audio file",
        "imports": [],
        "source": "export default function ({ fresh, cached }) {\n  const file = fresh || cached;\n  if (!file?.s3url) throw Error(\"Missing audio file\");\n  return { file };\n}\n"
      }
    }
