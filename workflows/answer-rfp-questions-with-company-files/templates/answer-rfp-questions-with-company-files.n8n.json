      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input\n  .all()\n  .map((i) => i.json.response?.text || i.json.text)\n  .filter((x) => typeof x === \"string\" && x.trim());\nif (!q.length) throw Error(\"No questions extracted\");\nconst b = $(\"Normalize RFP\").first().json;\nreturn [{ json: { ...b, questions: q } }];\n"
