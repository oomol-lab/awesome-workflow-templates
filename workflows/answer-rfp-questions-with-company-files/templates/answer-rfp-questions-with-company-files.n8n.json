    {
      "name": "Read file search answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const calls = ($json.output || []).filter(\n  (x) => x.type === \"file_search_call\" && x.status === \"completed\",\n);\nconst answer = ($json.output || [])\n  .filter((x) => x.type === \"message\")\n  .flatMap((x) => x.content || [])\n  .filter((x) => x.type === \"output_text\")\n  .map((x) => x.text)\n  .join(\"\\n\");\nif ($json.status !== \"completed\" || !calls.length || !answer.trim())\n  throw Error(\"Invalid file search response\");\nreturn { json: { answer } };\n"
      },
