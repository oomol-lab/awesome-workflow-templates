    {
      "name": "Choose RFP state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.item_key);\nif (rows.length > 1) throw Error(\"Duplicate RFP state\");\nconst input = $(\"Collect questions\").first().json;\nlet s;\nif (!rows.length)\n  s = {\n    id: input.id,\n    title: input.title,\n    reply_to: input.reply_to,\n    text: input.text,\n    questions: input.questions,\n    index: 0,\n    docId: \"\",\n    answer: \"\",\n    stage: \"new\",\n  };\nelse {\n  s = JSON.parse(rows[0].payload);\n  s.stage = rows[0].stage;\n  if (\n    s.id !== input.id ||\n    s.title !== input.title ||\n    s.reply_to !== input.reply_to ||\n    s.text !== input.text\n  )\n    throw Error(\"Request ID reused\");\n}\nif (s.stage.startsWith(\"pending-\"))\n  throw Error(\"Inspect pending operation before retrying: \" + s.stage);\nreturn [{ json: s }];\n"
      },
      "id": "answer-rfp-questions-with-company-files-10",
      "position": [
        2200,
        0
      ]
