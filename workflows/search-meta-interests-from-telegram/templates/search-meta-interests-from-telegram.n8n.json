    {
      "id": "search-meta-interests-from-telegram-11",
      "name": "Prepare CSV rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body;\nif (!b || !Array.isArray(b.rows) || !b.rows.length || !/^[-]?\\d+$/.test(String(b.chatId)))\n  throw Error(\"Invalid CSV relay body\");\nreturn b.rows.map((row) => ({ json: row }));\n"
      },
      "position": [
        2750,
        600
      ],
      "disabled": false
    },
