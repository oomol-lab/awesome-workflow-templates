    "modules": {
      "n_55240e5d5bc4cfcd": {
        "name": "Select authorized interest search",
        "imports": [],
        "source": "export default async function next({ body, allowedChatId, acknowledgeId }, ctx) {\n  if (!/^-?\\d+$/.test(allowedChatId)) throw Error(\"Configure the allowed Telegram chat ID\");\n  const s = (await ctx.state.get(\"interest-reports\")) ?? { queue: [], pending: null, done: [] },\n    msg = body?.message,\n    id = String(body?.update_id ?? \"\");\n  if (\n    String(msg?.chat?.id ?? \"\") === allowedChatId &&\n    typeof msg?.text === \"string\" &&\n    msg.text.startsWith(\"#interest\")\n  ) {\n    const q = msg.text.slice(9).trim();\n    if (q && /^\\d+$/.test(id) && !s.done.includes(id) && !s.queue.some((x) => x.id === id)) {\n      s.queue.push({ id, q, chatId: allowedChatId });\n      await ctx.state.set(\"interest-reports\", s);\n    }\n  }\n  if (s.pending) {\n    if (s.pending !== acknowledgeId)\n      throw Error(\"Inspect Telegram delivery for update \" + s.pending);\n    s.done.push(s.pending);\n    s.queue = s.queue.filter((x) => x.id !== s.pending);\n    s.pending = null;\n    await ctx.state.set(\"interest-reports\", s);\n  }\n  if (!s.queue.length) return { more: false, query: {}, id: \"\", chatId: \"\" };\n  const x = s.queue[0];\n  return {\n    more: true,\n    query: { type: \"adinterest\", q: x.q, limit: 1000000, locale: \"en_US\" },\n    id: x.id,\n    chatId: x.chatId,\n  };\n}\n"
      },
      "n_5dccb8c0374a19db": {
        "name": "Prepare interest rows",
        "imports": [],
        "source": "export default async function results({ body, id, chatId }) {\n  if (!body || !Array.isArray(body.data)) throw Error(\"Meta search did not return interest data\");\n  const rows = body.data.map((x) => ({\n    name: x.name ?? \"\",\n    audience_size_lower_bound: x.audience_size_lower_bound ?? \"\",\n    audience_size_upper_bound: x.audience_size_upper_bound ?? \"\",\n    path: Array.isArray(x.path) ? x.path.join(\" / \") : (x.path ?? \"\"),\n    description: x.description ?? \"\",\n    topic: x.topic ?? \"\",\n  }));\n  return { body: { id, chatId, rows }, hasRows: rows.length > 0 };\n}\n"
      },
      "n_ffa30d36c2f85979": {
        "name": "Checkpoint CSV delivery",
        "imports": [],
        "source": "export default async function pending({ id }, ctx) {\n  const s = await ctx.state.get(\"interest-reports\");\n  if (!s || s.queue[0]?.id !== id || s.pending) throw Error(\"Interest report state mismatch\");\n  s.pending = id;\n  await ctx.state.set(\"interest-reports\", s);\n  return { ok: true };\n}\n"
      },
      "n_2bed1d63905ac0cc": {
        "name": "Confirm CSV delivery",
        "imports": [],
        "source": "export default async function done({ id, response }, ctx) {\n  if (response?.ok !== true) throw Error(\"CSV delivery not confirmed\");\n  const s = await ctx.state.get(\"interest-reports\");\n  if (!s || s.pending !== id) throw Error(\"Interest report state mismatch\");\n  s.pending = null;\n  s.queue.shift();\n  s.done.push(id);\n  await ctx.state.set(\"interest-reports\", s);\n  return { ok: true };\n}\n"
      },
      "n_7ce8743cb0444de2": {
        "name": "Complete empty search",
        "imports": [],
        "source": "export default async function empty({ id }, ctx) {\n  const s = await ctx.state.get(\"interest-reports\");\n  if (!s || s.pending || s.queue[0]?.id !== id) throw Error(\"Interest report state mismatch\");\n  s.queue.shift();\n  s.done.push(id);\n  await ctx.state.set(\"interest-reports\", s);\n  return { ok: true };\n}\n"
      }
    }
  },
