    "modules": {
      "n_aab93206e1c3e3da": {
        "name": "Validate and name the PDF",
        "imports": [],
        "source": "function pdfFilename(status, bytes, mime) {\n  const type = String(mime ?? \"\")\n    .split(\";\", 1)[0]\n    .trim()\n    .toLowerCase();\n  if (\n    status !== 200 ||\n    ![\"application/pdf\", \"application/octet-stream\", \"application/x-pdf\"].includes(type) ||\n    bytes.length < 12 ||\n    bytes.length > 10 * 1024 * 1024 ||\n    String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\" ||\n    !String.fromCharCode(...bytes.subarray(Math.max(0, bytes.length - 2048))).includes(\"%%EOF\")\n  ) {\n    throw Error(\"The upstream response did not contain a complete PDF of up to 10 MiB.\");\n  }\n  return \"my_document_\" + new Date().toISOString().slice(0, 10) + \".pdf\";\n}\nexport default async ({ file, statusCode }, context) => {\n  const bytes = await context.artifact.open(file);\n  const name = pdfFilename(statusCode, bytes, file.mediaType);\n  if (file.name === name && file.mediaType === \"application/pdf\") return { pdf: file };\n  return { pdf: await context.artifact.put(bytes, { name, mediaType: \"application/pdf\" }) };\n};\n"
      }
    },
