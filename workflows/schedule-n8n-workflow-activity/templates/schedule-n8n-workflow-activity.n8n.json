      ],
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      },
      "typeVersion": 3
    },
    {
      "id": "schedule-n8n-workflow-activity-6",
      "name": "n8n Activate",
      "type": "n8n-nodes-base.n8n",
      "position": [
        360,
        -180
      ],
      "parameters": {
        "operation": "activate",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.workflowID }}"
        },
        "requestOptions": {}
      },
      "typeVersion": 1
    },
    {
      "id": "schedule-n8n-workflow-activity-7",
      "name": "n8n Deactivate",
      "type": "n8n-nodes-base.n8n",
      "position": [
        360,
        140
      ],
      "parameters": {
        "operation": "deactivate",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.workflowID }}"
        },
        "requestOptions": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Confirm activation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,id=$('Workflow ID').first().json.workflowID;if(!r||r.id!==id||r.active!==true)throw Error('n8n did not confirm the requested workflow status');return [{json:r}];"
      },
      "id": "schedule-n8n-workflow-activity-8"
    },
    {
      "name": "Confirm deactivation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,id=$('Workflow ID').first().json.workflowID;if(!r||r.id!==id||r.active!==false)throw Error('n8n did not confirm the requested workflow status');return [{json:r}];"
      },
      "id": "schedule-n8n-workflow-activity-9"
    }
