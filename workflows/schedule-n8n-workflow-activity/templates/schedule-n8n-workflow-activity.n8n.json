    {
      "id": "schedule-n8n-workflow-activity-2",
      "name": "Workflow ID",
      "type": "n8n-nodes-base.set",
      "position": [
        -60,
        -80
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "86a66597-b7c3-4e26-aab9-fdf6cc4e43b5",
              "name": "workflowID",
              "type": "string",
              "value": "YOUR_N8N_WORKFLOW_ID"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "name": "Validate the target",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(x=>{const id=x.json.workflowID;if(typeof id!=='string'||!id.trim()||id.startsWith('YOUR_')||id===$workflow.id)throw Error('Configure a different target workflow ID');return x});"
      },
      "id": "schedule-n8n-workflow-activity-3"
    },
    {
      "id": "schedule-n8n-workflow-activity-4",
      "name": "Merge in Workflow ID for activation",
      "type": "n8n-nodes-base.merge",
      "position": [
        180,
        -180
      ],
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      },
      "typeVersion": 3
    },
    {
      "id": "schedule-n8n-workflow-activity-5",
      "name": "Merge in Workflow ID for deactivation",
      "type": "n8n-nodes-base.merge",
