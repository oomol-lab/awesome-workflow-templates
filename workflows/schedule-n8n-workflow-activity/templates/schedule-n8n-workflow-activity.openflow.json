        "source": "export default function confirm({ workflow, expectedId, active }) {\n  if (!workflow || workflow.id !== expectedId || workflow.active !== active)\n    throw Error(\"n8n did not confirm the requested workflow status\");\n  return { workflow };\n}\n"
