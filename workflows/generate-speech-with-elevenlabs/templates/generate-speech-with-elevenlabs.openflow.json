      "n_e77ce8d03e7ec79a": {
        "name": "Read voice and text",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const event = body.event;\n  if (\n    !event ||\n    typeof event.voice_id !== \"string\" ||\n    !event.voice_id ||\n    typeof event.text !== \"string\" ||\n    !event.text\n  )\n    throw Error(\"Expected voice_id and text\");\n  return { voiceId: event.voice_id, text: event.text };\n}\n"
      }
