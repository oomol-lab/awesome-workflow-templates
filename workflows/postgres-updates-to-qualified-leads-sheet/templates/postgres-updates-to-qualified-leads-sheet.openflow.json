    "modules": {
      "n_0477450fa42cd269": {
        "name": "Read updated user",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const event = JSON.parse(body.event),\n    row = event?.payload;\n  if (!row || row.id == null || typeof row.email !== \"string\" || typeof row.username !== \"string\")\n    throw Error(\"Postgres notification must contain id, email and username in payload\");\n  return {\n    eligible: !row.email.includes(\"n8n.io\"),\n    headers: [\"id\", \"username\", \"email\"],\n    rows: [[String(row.id), row.username, row.email]],\n  };\n}\n"
      }
    }
