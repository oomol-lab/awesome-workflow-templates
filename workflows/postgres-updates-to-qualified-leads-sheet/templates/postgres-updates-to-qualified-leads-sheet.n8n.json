{
  "nodes": [
    {
      "id": "postgres-updates-to-qualified-leads-sheet-0",
      "name": "Postgres Trigger",
      "type": "n8n-nodes-base.postgresTrigger",
      "disabled": false,
      "position": [
        500,
        480
      ],
      "parameters": {
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "YOUR_SCHEMA"
        },
        "firesOn": "UPDATE",
        "tableName": {
          "__rl": true,
          "mode": "name",
          "value": "YOUR_TABLE"
        },
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "id": "postgres-updates-to-qualified-leads-sheet-1",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "notes": "Filter out @n8n.io emails",
      "position": [
        980,
        540
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email }}",
              "value2": "n8n.io",
              "operation": "notContains"
            }
          ]
        }
      },
      "notesInFlow": true,
      "typeVersion": 1
    },
    {
      "id": "postgres-updates-to-qualified-leads-sheet-2",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "notes": "Add to \"Users to contact\"",
      "position": [
        1400,
        540
      ],
      "parameters": {
        "columns": {
          "value": {
            "id": "={{ $json.id }}",
            "email": "={{ $json.email }}",
            "username": "={{ $json.username }}"
          },
          "schema": [
            {
              "id": "id",
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "id",
              "defaultMatch": true,
              "canBeUsedToMatch": true
            },
            {
              "id": "username",
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "username",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "email",
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "email",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "id": "contacted",
              "type": "string",
              "display": true,
              "removed": true,
              "required": false,
              "displayName": "contacted",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ]
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        },
        "operation": "appendOrUpdate",
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SPREADSHEET_ID"
        }
      },
      "notesInFlow": true,
      "typeVersion": 4
    },
    {
      "id": "postgres-updates-to-qualified-leads-sheet-relay-trigger",
      "name": "Postgres Trigger (Open Flow)",
      "type": "n8n-nodes-base.postgresTrigger",
      "disabled": true,
      "position": [
        500,
        1000
      ],
      "parameters": {
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "YOUR_SCHEMA"
        },
        "firesOn": "UPDATE",
        "tableName": {
          "__rl": true,
          "mode": "name",
          "value": "YOUR_TABLE"
        },
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "id": "postgres-updates-to-qualified-leads-sheet-unwrap",
      "name": "Read updated row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        480
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $json.payload };\n"
      }
    },
    {
      "id": "postgres-updates-to-qualified-leads-sheet-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        1000
      ],
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Postgres Trigger": {
      "main": [
        [
          {
            "node": "Read updated row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read updated row": {
      "main": [
        [
          {
            "node": "Filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Trigger (Open Flow)": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Sync Postgres Leads to Google Sheets",
  "active": false,
  "pinData": {}
}
