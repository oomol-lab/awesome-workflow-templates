    {
      "id": "receive-mailjet-sent-events-decode",
      "name": "Decode exact event IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const bytes = await helpers.getBinaryDataBuffer(0, \"data\");\nconst events = JSON.parse(bytes.toString(\"utf8\"), (key, value, context) =>\n  typeof value === \"number\" && Number.isInteger(value) && !Number.isSafeInteger(value)\n    ? context.source\n    : value,\n);\nreturn (Array.isArray(events) ? events : [events]).map((json) => ({ json }));\n"
      }
    },
    {
      "id": "receive-mailjet-sent-events-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
