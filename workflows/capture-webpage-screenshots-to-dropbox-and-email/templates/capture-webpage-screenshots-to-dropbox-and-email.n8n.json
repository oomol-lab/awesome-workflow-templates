        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'screenshots:' + $('Create Web + Email Item').first().json.submissionId + ':simple' }}"
