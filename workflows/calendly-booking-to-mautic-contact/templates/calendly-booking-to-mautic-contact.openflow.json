    "modules": {
      "n_3d08f7c27330b2bc": {
        "name": "Prepare invitee contact fields",
        "imports": [],
        "source": "export default function calendlyMauticFields({ invitee }) {\n  if (!invitee || typeof invitee !== 'object' || Array.isArray(invitee) || typeof invitee.email !== 'string' || !invitee.email.trim() || typeof invitee.name !== 'string' || !invitee.name.trim()) {\n    throw new Error('The Calendly booking must contain an invitee email and name');\n  }\n  return { fields: { email: invitee.email, firstname: invitee.name, lastname: '', company: '', position: '', title: '' } };\n}\n"
      },
      "n_352afc581d6d422f": {
        "name": "Check the saved contact ID",
        "imports": [],
        "source": "export default function mauticContactSaved({ contact }) {\n  if (!contact || typeof contact !== 'object' || Array.isArray(contact) || !Number.isInteger(contact.id) || contact.id <= 0) {\n    throw new Error('Mautic did not return a saved contact ID');\n  }\n  return { contact };\n}\n"
      }
    }
