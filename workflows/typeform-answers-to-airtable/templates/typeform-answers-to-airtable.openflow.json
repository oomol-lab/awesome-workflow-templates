    "modules": {
      "n_7f0bb2d28c39d17c": {
        "name": "Map the question titles to fields",
        "imports": [],
        "source": "export default function typeformAirtableFields({ response }) {\n  if (!response || typeof response !== \"object\")\n    throw new Error(\"Expected a complete Typeform response\");\n  const form = response;\n  if (!Array.isArray(form.definition?.fields) || !Array.isArray(form.answers))\n    throw new Error(\"Expected the complete form definition and answers\");\n  const titles = new Map();\n  for (const field of form.definition.fields) {\n    if (\n      !field ||\n      typeof field.id !== \"string\" ||\n      !field.id ||\n      typeof field.title !== \"string\" ||\n      !field.title.trim() ||\n      titles.has(field.id)\n    )\n      throw new Error(\"Invalid or repeated Typeform field definition\");\n    titles.set(field.id, field.title.replace(/\\{\\{/g, \"[\").replace(/\\}\\}/g, \"]\"));\n  }\n  const entries = [],\n    used = new Set();\n  for (const answer of form.answers) {\n    const title = titles.get(answer?.field?.id);\n    if (\n      title === undefined ||\n      used.has(title) ||\n      typeof answer.type !== \"string\" ||\n      !Object.hasOwn(answer, answer.type) ||\n      answer[answer.type] == null\n    )\n      throw new Error(\"Missing, repeated or ambiguous Typeform answer\");\n    used.add(title);\n    let value = answer[answer.type];\n    if (value !== null && typeof value === \"object\") {\n      for (const key of [\"label\", \"labels\"]) {\n        if (Object.hasOwn(value, key) && value[key] !== undefined) {\n          value = value[key];\n          break;\n        }\n      }\n    }\n    if (title !== \"id\") entries.push([title, value]);\n  }\n  if (!entries.length) throw new Error(\"No answer fields remain for Airtable\");\n  return { records: [{ fields: Object.fromEntries(entries) }] };\n}\n"
      },
      "n_7453d8a6c0685075": {
        "name": "Confirm the saved form record",
        "imports": [],
        "source": "export default function airtableFormRecord({ records }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id ||\n    !records[0].fields ||\n    typeof records[0].fields !== \"object\" ||\n    Array.isArray(records[0].fields)\n  )\n    throw new Error(\n      \"Airtable did not confirm one saved record; creation may already have occurred\",\n    );\n  return { record: records[0] };\n}\n"
      }
    }
