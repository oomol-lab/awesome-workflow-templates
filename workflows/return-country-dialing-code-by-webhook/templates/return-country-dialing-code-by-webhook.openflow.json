    "modules": {
      "n_5abd4dfc9734b803": {
        "name": "Prepare GraphQL query",
        "imports": [],
        "source": "export default function prepare({ query }) {\n  const code = query.code.toUpperCase();\n  const q = `query { country(code: ${JSON.stringify(code)}) { name phone emoji } }`;\n  return { url: \"https://countries.trevorblades.com/?query=\" + encodeURIComponent(q) };\n}\n"
      },
      "n_49fe7227abe182b2": {
        "name": "Format country result",
        "imports": [],
        "source": "export default function format({ body }) {\n  const c = body?.data?.country;\n  if (!c || body.errors?.length) throw Error(\"Country lookup failed\");\n  return { response: { data: `The country code of ${c.name} ${c.emoji} is ${c.phone}` } };\n}\n"
      }
    }
