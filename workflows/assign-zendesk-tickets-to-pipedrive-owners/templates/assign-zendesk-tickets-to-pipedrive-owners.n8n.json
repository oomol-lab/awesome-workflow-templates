    {
      "id": "assign-zendesk-tickets-to-pipedrive-owners-15",
      "name": "Check contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const hits = $json.data?.items;\nif (!Array.isArray(hits) || hits.length > 1 || $json.additional_data?.next_cursor)\n  throw Error(\"Invalid or ambiguous contact\");\nif (!hits.length) return [{ json: { found: false }, pairedItem: { item: 0 } }];\nconst p = hits[0].item,\n  e = $(\"Validate requester\").item.json.email;\nif (!p.emails?.some((x) => x.toLowerCase() === e.toLowerCase()) || !p.owner?.id)\n  throw Error(\"Invalid contact\");\nreturn [{ json: { found: true, ownerId: p.owner.id }, pairedItem: { item: 0 } }];\n"
      },
      "position": [
        3300,
        0
