      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (!$json.user?.email || $json.user.id !== $(\"Prepare ticket\").item.json.requester_id)\n  throw Error(\"Missing requester email\");\nreturn [{ json: { email: $json.user.email }, pairedItem: { item: 0 } }];\n"
