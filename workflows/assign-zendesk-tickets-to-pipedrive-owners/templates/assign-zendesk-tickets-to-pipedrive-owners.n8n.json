    {
      "id": "assign-zendesk-tickets-to-pipedrive-owners-3",
      "name": "Prepare page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (\n  !Array.isArray($json.tickets) ||\n  !$json.after_cursor ||\n  typeof $json.end_of_stream !== \"boolean\"\n)\n  throw Error(\"Invalid page\");\nconst start = $(\"Configure export\").first().json.startTime,\n  old = $getWorkflowStaticData(\"global\").cursor;\nif (!$json.end_of_stream && old === $json.after_cursor) throw Error(\"Repeated cursor\");\nfor (const t of $json.tickets)\n  if (\n    !Number.isSafeInteger(t.id) ||\n    !Number.isSafeInteger(t.requester_id) ||\n    !Number.isFinite(Date.parse(t.created_at))\n  )\n    throw Error(\"Invalid ticket\");\nreturn [\n  {\n    json: {\n      cursor: $json.after_cursor,\n      tickets: $json.tickets.filter((t) => Date.parse(t.created_at) >= start * 1000),\n    },\n  },\n];\n"
      },
      "position": [
        660,
        0
      ]
    },
