    {
      "id": "assign-zendesk-tickets-to-pipedrive-owners-20",
      "name": "Choose ticket update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $(\"Validate owner\").item.json.email,\n  users = $json.users;\nif (!Array.isArray(users) || $json.next_page) throw Error(\"Invalid agent page\");\nconst found = users.filter(\n  (x) =>\n    x.email?.toLowerCase() === e.toLowerCase() &&\n    [\"agent\", \"admin\"].includes(x.role) &&\n    x.active !== false,\n);\nif (found.length > 1) throw Error(\"Ambiguous agent\");\nreturn [\n  {\n    json: {\n      ticket: found.length\n        ? { assignee_id: found[0].id }\n        : { comment: { body: \"Requester or owner agent not found\", public: false } },\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
