    {
      "id": "assign-zendesk-tickets-to-pipedrive-owners-1",
      "name": "Configure export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const zendesk = \"YOUR_ZENDESK_SUBDOMAIN\",\n  pipedrive = \"YOUR_PIPEDRIVE_DOMAIN\",\n  startTime = 0;\nif (\n  !/^[a-z0-9-]+$/.test(zendesk) ||\n  zendesk.startsWith(\"YOUR\") ||\n  !pipedrive.endsWith(\".pipedrive.com\") ||\n  !Number.isInteger(startTime) ||\n  startTime <= 0 ||\n  startTime >= Date.now() / 1000 - 60\n)\n  throw Error(\"Configure domains and initial time at least one minute ago\");\nconst s = $getWorkflowStaticData(\"global\");\nreturn [\n  {\n    json: {\n      zendesk,\n      pipedrive,\n      startTime,\n      url:\n        \"https://\" +\n        zendesk +\n        \".zendesk.com/api/v2/incremental/tickets/cursor.json?\" +\n        (s.cursor ? \"cursor=\" + encodeURIComponent(s.cursor) : \"start_time=\" + startTime),\n    },\n  },\n];\n"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "assign-zendesk-tickets-to-pipedrive-owners-2",
      "name": "Read Zendesk ticket page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
