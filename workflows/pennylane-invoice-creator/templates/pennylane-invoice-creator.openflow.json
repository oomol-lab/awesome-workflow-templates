        "source": "export default function pennylaneInvoiceReply({ body, statusCode, data, rejected }) {\n  const headers = { 'Cache-Control': 'no-store', ...(statusCode === 401 ? { 'WWW-Authenticate': 'Basic realm=\"Webhook\"' } : {}) };\n  if (rejected) return { body, statusCode, headers };\n  if (statusCode !== 201 || !body || typeof body !== 'object' || !Number.isSafeInteger(body.id) || body.id <= 0 || typeof body.invoice_number !== 'string' || !body.invoice_number.trim() || typeof body.currency_amount !== 'string' || !body.currency_amount.trim() || (body.public_file_url !== null && typeof body.public_file_url !== 'string')) throw new Error('Pennylane did not confirm a completed invoice with its documented HTTP 201 fields.');\n  return { body: { success: true, invoice_id: String(body.id), invoice_number: body.invoice_number, amount: body.currency_amount, customer: data.customer_name, public_url: body.public_file_url || null, email_sent: false }, statusCode: 200, headers };\n}\n"
