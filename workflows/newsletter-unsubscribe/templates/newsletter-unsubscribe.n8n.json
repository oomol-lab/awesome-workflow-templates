    {
      "id": "prepare-newsletter-unsubscribe",
      "name": "Prepare Subscriber Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function prepareNewsletterUnsubscribe({ ID, baseId, tableIdOrName }) {\n  const text = (value, prefix, name) => {\n    if (typeof value !== 'string' || !new RegExp('^' + prefix + '[A-Za-z0-9]+$').test(value.trim())) throw new Error('Configure a valid ' + name + '.');\n    return value.trim();\n  };\n  const recordId = text(ID, 'rec', 'subscriber record ID');\n  return { baseId: text(baseId, 'app', 'Airtable base ID'), tableIdOrName: text(tableIdOrName, 'tbl', 'subscribers table ID'), recordId, records: [{ id: recordId, fields: { Status: 'inactive' } }] };\n}\nfunction newsletterUnsubscribeInput({ body, baseId, tableIdOrName }) {\n  return prepareNewsletterUnsubscribe({ ID: body?.ID, baseId, tableIdOrName });\n}\n\nconst settings={\"baseId\":\"YOUR_AIRTABLE_BASE_ID\",\"tableIdOrName\":\"YOUR_SUBSCRIBERS_TABLE_ID\"};\nreturn $input.all().map((item,index)=>({json:prepareNewsletterUnsubscribe({...item.json,...settings}),pairedItem:{item:index}}));\n"
      }
    },
    {
      "id": "2213a81f-53a9-4142-9586-e87b88710eec",
      "name": "Update Subscriber",
      "type": "n8n-nodes-base.airtable",
      "position": [
        160,
        0
      ],
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.baseId }}"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.tableIdOrName }}"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.recordId }}",
            "Status": "inactive"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "readOnly": true,
              "removed": false
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "options",
              "options": [
                {
                  "name": "active",
                  "value": "active"
                },
                {
                  "name": "inactive",
                  "value": "inactive"
                }
              ],
              "readOnly": false,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "typecast": false
        }
      },
      "typeVersion": 2.1,
      "alwaysOutputData": true
    },
    {
      "id": "confirm-newsletter-unsubscribe",
      "name": "Confirm Inactive Subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function confirmNewsletterUnsubscribe({ records, recordId }) {\n  if (!Array.isArray(records) || records.length !== 1 || records[0]?.id !== recordId || records[0]?.fields?.Status !== 'inactive') throw new Error('Airtable did not confirm the requested subscriber as inactive.');\n  return { body: { unsubscribed: true } };\n}\n\nreturn $input.all().map((item,index)=>({json:confirmNewsletterUnsubscribe({records:[item.json],recordId:$('Prepare Subscriber Update').itemMatching(index).json.recordId}),pairedItem:{item:index}}));\n"
      }
    }
  ],
  "pinData": {},
