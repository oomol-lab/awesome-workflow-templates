    "modules": {
      "n_b5765dfcaa7aa380": {
        "name": "Prepare subscriber update",
        "imports": [],
        "source": "export function prepareNewsletterUnsubscribe({ ID, baseId, tableIdOrName }) {\n  const text = (value, prefix, name) => {\n    if (typeof value !== \"string\" || !new RegExp(\"^\" + prefix + \"[A-Za-z0-9]+$\").test(value.trim()))\n      throw new Error(\"Configure a valid \" + name + \".\");\n    return value.trim();\n  };\n  const recordId = text(ID, \"rec\", \"subscriber record ID\");\n  return {\n    baseId: text(baseId, \"app\", \"Airtable base ID\"),\n    tableIdOrName: text(tableIdOrName, \"tbl\", \"subscribers table ID\"),\n    recordId,\n    records: [{ id: recordId, fields: { Status: \"inactive\" } }],\n  };\n}\nexport default function newsletterUnsubscribeInput({ body, baseId, tableIdOrName }) {\n  return prepareNewsletterUnsubscribe({ ID: body?.ID, baseId, tableIdOrName });\n}\n"
      },
      "n_be92edc0ee4db6d7": {
        "name": "Confirm inactive subscription",
        "imports": [],
        "source": "export default function confirmNewsletterUnsubscribe({ records, recordId }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    records[0]?.id !== recordId ||\n    records[0]?.fields?.Status !== \"inactive\"\n  )\n    throw new Error(\"Airtable did not confirm the requested subscriber as inactive.\");\n  return { body: { unsubscribed: true } };\n}\n"
      }
    }
