      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const csv = $(\"Validate transaction CSV\").item.json.csv;\nif (\n  typeof csv !== \"string\" ||\n  !csv.trim() ||\n  csv.trim().startsWith(\"```\") ||\n  !csv.split(/\\r?\\n/, 1)[0].toLowerCase().includes(\"category\")\n)\n  throw Error(\"Expected CSV with category header\");\nreturn { json: { csv: csv.trim() } };\n"
      },
