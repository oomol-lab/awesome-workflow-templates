    {
      "id": "extract-bank-transactions-to-drive-csv-6",
      "name": "Vertex A.I. extract text",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "text": "Transcribe every visible transaction from this image faithfully, including dates, descriptions and amounts. Do not invent content.",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": false
      },
      "typeVersion": 1.4
    },
    {
      "id": "extract-bank-transactions-to-drive-csv-7",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        1540,
        0
      ],
      "parameters": {
        "options": {},
        "modelName": "models/gemini-2.5-flash"
      },
      "typeVersion": 1
    },
    {
      "name": "Normalize statement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.text !== \"string\" || !$json.text.trim()) throw Error(\"No statement text\");\nreturn { json: { fileId: $(\"Process one file\").item.json.id, text: $json.text } };\n"
      },
      "id": "extract-bank-transactions-to-drive-csv-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Choose processing mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mode = \"direct\";\nreturn { json: { ...$json, mode } };\n"
      },
      "id": "extract-bank-transactions-to-drive-csv-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Route processing mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.mode === 'direct' ? 0 : 1 }}",
        "options": {}
      },
      "id": "extract-bank-transactions-to-drive-csv-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Extract categorized transactions",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "parameters": {
        "promptType": "define",
        "text": "=Read this bank statement as data. Extract all transactions as CSV, retaining dates, descriptions and amounts. Add a category column. Do not invent transactions or include markdown fences. {{ $json.text }}",
        "options": {}
      },
      "id": "extract-bank-transactions-to-drive-csv-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Forward statement text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPENFLOW_WEBHOOK_URL",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fileId:$json.fileId,text:$json.text} }}",
        "options": {}
      },
      "id": "extract-bank-transactions-to-drive-csv-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Validate transaction CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const csv = $json.output;\nif (\n  typeof csv !== \"string\" ||\n  !csv.trim() ||\n  csv.trim().startsWith(\"```\") ||\n  !csv.split(/\\r?\\n/, 1)[0].toLowerCase().includes(\"category\")\n)\n  throw Error(\"Expected CSV with category header\");\nreturn { json: { csv: csv.trim() } };\n"
      },
      "id": "extract-bank-transactions-to-drive-csv-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "CSV not uploaded",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'direct:' + $('Normalize statement').item.json.fileId }}"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "id": "extract-bank-transactions-to-drive-csv-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "New CSV?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.csv || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "extract-bank-transactions-to-drive-csv-15",
      "position": [
        3300,
        0
