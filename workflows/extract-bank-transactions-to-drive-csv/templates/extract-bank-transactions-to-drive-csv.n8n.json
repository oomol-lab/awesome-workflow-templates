              "outputKey": "image"
            },
            {
              "value2": "",
              "operation": "contains",
              "outputKey": "skip"
            }
          ]
        },
        "value1": "={{$json.mimeType}}",
        "dataType": "string"
      },
      "typeVersion": 2
    },
