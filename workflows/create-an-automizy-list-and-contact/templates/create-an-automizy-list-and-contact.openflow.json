    "modules": {
      "n_289c94d54f57c5d3": {
        "name": "Prepare list",
        "imports": [],
        "source": "export default function prepare({ phase, list, email, response }) {\n  if (phase === \"list\")\n    return { url: \"https://gateway.automizy.com/v2/smart-lists\", body: { name: list } };\n  if (phase === \"contact\") {\n    if (!response?.id) throw Error(\"Missing list id\");\n    return {\n      url:\n        \"https://gateway.automizy.com/v2/smart-lists/\" +\n        encodeURIComponent(response.id) +\n        \"/contacts\",\n      body: { email, status: \"ACTIVE\" },\n    };\n  }\n  const contact = response?.contacts?.[0];\n  if (!contact?.email) throw Error(\"Missing contact email\");\n  return {\n    url: \"https://gateway.automizy.com/v2/contacts/\" + encodeURIComponent(contact.email),\n    body: { tags: [\"reviewer\"] },\n  };\n}\n"
      },
      "n_aea96344818079c9": {
        "name": "Prepare contact",
        "imports": [],
        "source": "export default function prepare({ phase, list, email, response }) {\n  if (phase === \"list\")\n    return { url: \"https://gateway.automizy.com/v2/smart-lists\", body: { name: list } };\n  if (phase === \"contact\") {\n    if (!response?.id) throw Error(\"Missing list id\");\n    return {\n      url:\n        \"https://gateway.automizy.com/v2/smart-lists/\" +\n        encodeURIComponent(response.id) +\n        \"/contacts\",\n      body: { email, status: \"ACTIVE\" },\n    };\n  }\n  const contact = response?.contacts?.[0];\n  if (!contact?.email) throw Error(\"Missing contact email\");\n  return {\n    url: \"https://gateway.automizy.com/v2/contacts/\" + encodeURIComponent(contact.email),\n    body: { tags: [\"reviewer\"] },\n  };\n}\n"
      },
      "n_ad39f57726af6647": {
        "name": "Prepare tag",
        "imports": [],
        "source": "export default function prepare({ phase, list, email, response }) {\n  if (phase === \"list\")\n    return { url: \"https://gateway.automizy.com/v2/smart-lists\", body: { name: list } };\n  if (phase === \"contact\") {\n    if (!response?.id) throw Error(\"Missing list id\");\n    return {\n      url:\n        \"https://gateway.automizy.com/v2/smart-lists/\" +\n        encodeURIComponent(response.id) +\n        \"/contacts\",\n      body: { email, status: \"ACTIVE\" },\n    };\n  }\n  const contact = response?.contacts?.[0];\n  if (!contact?.email) throw Error(\"Missing contact email\");\n  return {\n    url: \"https://gateway.automizy.com/v2/contacts/\" + encodeURIComponent(contact.email),\n    body: { tags: [\"reviewer\"] },\n  };\n}\n"
      },
      "n_9e3d5a030a710244": {
        "name": "Read all list contacts",
        "imports": [],
        "source": "export default async function list({ list, token }, context) {\n  if (!list?.id) throw Error(\"Missing list id\");\n  let page = 1,\n    contacts = [];\n  for (;;) {\n    const r = await context.fetch(\n      \"https://gateway.automizy.com/v2/smart-lists/\" +\n        encodeURIComponent(list.id) +\n        \"/contacts?limit=100&page=\" +\n        page,\n      { headers: { Authorization: \"Bearer \" + token } },\n    );\n    if (!r.ok) throw Error(\"Automizy list request failed\");\n    const x = await r.json();\n    if (\n      !Array.isArray(x.contacts) ||\n      x.page !== page ||\n      !Number.isInteger(x.pageCount) ||\n      x.pageCount < page\n    )\n      throw Error(\"Invalid Automizy pagination\");\n    contacts.push(...x.contacts);\n    if (page === x.pageCount) return { contacts };\n    page++;\n  }\n}\n"
      }
    }
  },
