    {
      "id": "diagnose-n8n-execution-errors-by-email-extract",
      "name": "Extract safe error details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function extract({ execution }) {\n  if (!execution || typeof execution !== \"object\") throw Error(\"Missing execution\");\n  if (execution.mode === \"manual\") return { enabled: false, meta: {}, errors: [] };\n  const runData = execution.data?.resultData?.runData;\n  if (!runData || typeof runData !== \"object\") throw Error(\"Execution details unavailable\");\n  const clean = (x) =>\n    String(x ?? \"\")\n      .replace(/(bearer\\s+)[^\\s,;]+/gi, \"$1[redacted]\")\n      .replace(\n        /([\\\"']?(?:api[_-]?key|token|password|secret|authorization)[\\\"']?\\s*[=:]\\s*[\\\"']?)[^\\\"'\\s,;}]+/gi,\n        \"$1[redacted]\",\n      );\n  const errors = [];\n  for (const [node, runs] of Object.entries(runData)) {\n    if (node.includes(\"SERP\") || !Array.isArray(runs)) continue;\n    for (const run of runs) {\n      if (run?.executionStatus !== \"error\") continue;\n      const e = run.error ?? execution.data?.resultData?.error ?? {};\n      errors.push({\n        node: clean(node),\n        name: clean(e.name),\n        message: clean(e.message),\n        description: clean(e.description),\n        httpCode:\n          typeof e.httpCode === \"number\" || typeof e.httpCode === \"string\" ? clean(e.httpCode) : \"\",\n        previousNode: clean(run.source?.[0]?.previousNode),\n      });\n    }\n  }\n  return {\n    enabled: errors.length > 0,\n    meta: {\n      workflowName: clean(execution.workflowData?.name ?? execution.workflowId),\n      executionId: String(execution.id ?? \"\"),\n    },\n    errors,\n  };\n}\n\nreturn [{ json: extract({ execution: $input.first().json }) }];\n"
      }
    },
    {
      "id": "diagnose-n8n-execution-errors-by-email-gate",
      "name": "Reportable errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "enabled",
              "leftValue": "={{ $json.enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "diagnose-n8n-execution-errors-by-email-split",
      "name": "Split errors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.first().json.errors.map((error, index) => ({\n  json: { node: error.node, prompt: JSON.stringify(error) },\n  pairedItem: { item: 0 },\n}));\n"
      }
    },
    {
      "id": "diagnose-n8n-execution-errors-by-email-format",
      "name": "Format diagnostic report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const diagnoses = $input.all(),\n  errors = $(\"Split errors\").all(),\n  meta = $(\"Extract safe error details\").first().json.meta;\nif (diagnoses.length !== errors.length) throw Error(\"Diagnosis count mismatch\");\nconst parts = diagnoses.map((x, i) => {\n  const r = x.json.output;\n  if (\n    !r ||\n    typeof r.diagnosis !== \"string\" ||\n    typeof r.cause !== \"string\" ||\n    typeof r.resolution !== \"string\"\n  )\n    throw Error(\"Invalid diagnosis\");\n  return (\n    \"Node: \" +\n    errors[i].json.node +\n    \"\\nDiagnosis: \" +\n    r.diagnosis +\n    \"\\nCause: \" +\n    r.cause +\n    \"\\nResolution: \" +\n    r.resolution\n  );\n});\nreturn [\n  {\n    json: {\n      subject:\n        \"n8n Error: \" +\n        String(meta.workflowName ?? \"\").replace(/[\\r\\n]+/g, \" \") +\n        \" (#\" +\n        meta.executionId +\n        \")\",\n      body: parts.join(\"\\n\\n\"),\n    },\n  },\n];\n"
      }
    }
