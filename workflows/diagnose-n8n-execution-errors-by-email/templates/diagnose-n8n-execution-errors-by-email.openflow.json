    "modules": {
      "n_face84115517b6e4": {
        "name": "Read execution ID",
        "imports": [],
        "source": "export default function failureUrl({ body, baseUrl }) {\n  const id = body?.execution?.id;\n  if ((typeof id !== \"string\" && typeof id !== \"number\") || !/^\\d+$/.test(String(id)))\n    throw Error(\"Expected an n8n failure execution ID\");\n  if (typeof baseUrl !== \"string\" || !/^https?:\\/\\/[^\\s/?#]+(?:\\/[^?#]*)?$/.test(baseUrl))\n    throw Error(\"Configure the n8n base URL without a query\");\n  let base = baseUrl.replace(/\\/+$/, \"\");\n  if (!base.endsWith(\"/api/v1\")) base += \"/api/v1\";\n  return { url: base + \"/executions/\" + encodeURIComponent(String(id)) + \"?includeData=true\" };\n}\n"
      },
      "n_cf1e899fb4da2208": {
        "name": "Extract safe error details",
        "imports": [],
        "source": "export default function extract({ execution }) {\n  if (!execution || typeof execution !== \"object\") throw Error(\"Missing execution\");\n  if (execution.mode === \"manual\") return { enabled: false, meta: {}, errors: [] };\n  const runData = execution.data?.resultData?.runData;\n  if (!runData || typeof runData !== \"object\") throw Error(\"Execution details unavailable\");\n  const clean = (x) =>\n    String(x ?? \"\")\n      .replace(/(bearer\\s+)[^\\s,;]+/gi, \"$1[redacted]\")\n      .replace(\n        /([\\\"']?(?:api[_-]?key|token|password|secret|authorization)[\\\"']?\\s*[=:]\\s*[\\\"']?)[^\\\"'\\s,;}]+/gi,\n        \"$1[redacted]\",\n      );\n  const errors = [];\n  for (const [node, runs] of Object.entries(runData)) {\n    if (node.includes(\"SERP\") || !Array.isArray(runs)) continue;\n    for (const run of runs) {\n      if (run?.executionStatus !== \"error\") continue;\n      const e = run.error ?? execution.data?.resultData?.error ?? {};\n      errors.push({\n        node: clean(node),\n        name: clean(e.name),\n        message: clean(e.message),\n        description: clean(e.description),\n        httpCode:\n          typeof e.httpCode === \"number\" || typeof e.httpCode === \"string\" ? clean(e.httpCode) : \"\",\n        previousNode: clean(run.source?.[0]?.previousNode),\n      });\n    }\n  }\n  return {\n    enabled: errors.length > 0,\n    meta: {\n      workflowName: clean(execution.workflowData?.name ?? execution.workflowId),\n      executionId: String(execution.id ?? \"\"),\n    },\n    errors,\n  };\n}\n"
      },
      "n_de5a174796e72283": {
        "name": "Prepare the next diagnosis",
        "imports": [],
        "source": "export default function next({ errors, meta, previousState, previousResult }) {\n  if (!Array.isArray(errors)) throw Error(\"Missing error list\");\n  let s = previousState ?? { index: 0, entries: [] };\n  if (s.index > 0) {\n    if (\n      !previousResult ||\n      typeof previousResult.diagnosis !== \"string\" ||\n      typeof previousResult.cause !== \"string\" ||\n      typeof previousResult.resolution !== \"string\"\n    )\n      throw Error(\"Invalid model diagnosis\");\n    s = { ...s, entries: [...s.entries, { node: errors[s.index - 1].node, ...previousResult }] };\n  }\n  if (s.index === errors.length) {\n    const title = String(meta.workflowName ?? \"\").replace(/[\\r\\n]+/g, \" \");\n    return {\n      state: s,\n      more: false,\n      prompt: \"unused\",\n      subject: \"n8n Error: \" + title + \" (#\" + meta.executionId + \")\",\n      body: s.entries\n        .map(\n          (e) =>\n            \"Node: \" +\n            e.node +\n            \"\\nDiagnosis: \" +\n            e.diagnosis +\n            \"\\nCause: \" +\n            e.cause +\n            \"\\nResolution: \" +\n            e.resolution,\n        )\n        .join(\"\\n\\n\"),\n    };\n  }\n  const error = errors[s.index];\n  return {\n    state: { ...s, index: s.index + 1 },\n    more: true,\n    prompt: JSON.stringify(error),\n    subject: \"unused\",\n    body: \"unused\",\n  };\n}\n"
      }
    }
  },
