    "modules": {
      "n_2781a588164b8c73": {
        "name": "Prepare the contact",
        "imports": [],
        "source": "export default function prepare({ subdomain, firstName, lastName }) {\n  if (!/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(subdomain))\n    throw Error(\"Configure your Agile CRM subdomain\");\n  const properties = [];\n  if (firstName) properties.push({ type: \"SYSTEM\", name: \"first_name\", value: firstName });\n  if (lastName) properties.push({ type: \"SYSTEM\", name: \"last_name\", value: lastName });\n  return { url: `https://${subdomain}.agilecrm.com/dev/api/contacts`, body: { properties } };\n}\n"
      }
    }
