    "modules": {
      "n_3738c9884c3664f5": {
        "name": "Prepare next batch",
        "imports": [],
        "source": "export default function next({\n  baseId,\n  table,\n  mode,\n  mergeFields,\n  records,\n  insertState,\n  patchState,\n}) {\n  const state = (mode === \"insert\" ? insertState : patchState) ?? {\n    index: 0,\n    retries: 0,\n    records: [],\n    createdRecords: [],\n    updatedRecords: [],\n  };\n  if (![\"insert\", \"update\", \"upsert\"].includes(mode))\n    throw Error(\"Choose insert, update or upsert\");\n  if (\n    mode === \"upsert\" &&\n    (!Array.isArray(mergeFields) || mergeFields.length < 1 || mergeFields.length > 3)\n  )\n    throw Error(\"Upsert needs one to three merge fields\");\n  if (!Array.isArray(records)) throw Error(\"records must be an array\");\n  const chunk = records.slice(state.index, state.index + 10).map((r) => {\n    const fields = { ...(r.fields ?? r) };\n    if (mode === \"update\") {\n      const id = fields.id;\n      delete fields.id;\n      if (!id) throw Error(\"Update record needs id\");\n      return { id, fields };\n    }\n    return { fields };\n  });\n  return {\n    batchCount: chunk.length,\n    more: state.index < records.length,\n    isInsert: mode === \"insert\",\n    url:\n      \"https://api.airtable.com/v0/\" + encodeURIComponent(baseId) + \"/\" + encodeURIComponent(table),\n    body: {\n      records: chunk,\n      ...(mode === \"upsert\" ? { performUpsert: { fieldsToMergeOn: mergeFields } } : {}),\n    },\n    state,\n    records: state.records,\n    createdRecords: state.createdRecords,\n    updatedRecords: state.updatedRecords,\n  };\n}\n"
      },
      "n_794f1ff71e78172b": {
        "name": "Collect insert response",
        "imports": [],
        "source": "export default function apply({ state, status, body, batchCount }) {\n  if (status === 429) {\n    if (state.retries >= 4) throw Error(\"Airtable rate limit persisted after five attempts\");\n    return { state: { ...state, retries: state.retries + 1 }, durationMs: 5000 };\n  }\n  if (status < 200 || status >= 300) throw Error(\"Airtable HTTP \" + status);\n  if (!body || !Array.isArray(body.records) || body.records.length !== batchCount)\n    throw Error(\"Airtable returned an incomplete batch\");\n  return {\n    state: {\n      index: state.index + body.records.length,\n      retries: 0,\n      records: state.records.concat(body.records),\n      createdRecords: state.createdRecords.concat(body.createdRecords ?? []),\n      updatedRecords: state.updatedRecords.concat(body.updatedRecords ?? []),\n    },\n    durationMs: 200,\n  };\n}\n"
      },
      "n_21f39d22c4075a7b": {
        "name": "Collect update response",
        "imports": [],
        "source": "export default function apply({ state, status, body, batchCount }) {\n  if (status === 429) {\n    if (state.retries >= 4) throw Error(\"Airtable rate limit persisted after five attempts\");\n    return { state: { ...state, retries: state.retries + 1 }, durationMs: 5000 };\n  }\n  if (status < 200 || status >= 300) throw Error(\"Airtable HTTP \" + status);\n  if (!body || !Array.isArray(body.records) || body.records.length !== batchCount)\n    throw Error(\"Airtable returned an incomplete batch\");\n  return {\n    state: {\n      index: state.index + body.records.length,\n      retries: 0,\n      records: state.records.concat(body.records),\n      createdRecords: state.createdRecords.concat(body.createdRecords ?? []),\n      updatedRecords: state.updatedRecords.concat(body.updatedRecords ?? []),\n    },\n    durationMs: 200,\n  };\n}\n"
      }
    }
