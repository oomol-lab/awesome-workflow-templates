      "position": [
        180,
        -40
      ],
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $json.driveUrl }}"
        },
        "options": {},
        "operation": "update",
        "newUpdatedFileName": "Music Video 1"
      },
      "typeVersion": 3
    },
    {
      "id": "upload-video-via-apps-script-and-rename-2",
      "name": "Send URL to GDrive Script and Upload",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -60,
        -40
      ],
      "parameters": {
        "url": "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec",
        "method": "POST",
        "options": {},
        "jsonBody": "{\n  \"videoUrl\": \"YOUR_VIDEO_URL\",\n  \"secret\": \"YOUR_SCRIPT_SHARED_SECRET\"\n}",
        "sendBody": true,
        "specifyBody": "json"
      },
      "typeVersion": 4.2
    }
  ],
  "active": false,
  "pinData": {},
