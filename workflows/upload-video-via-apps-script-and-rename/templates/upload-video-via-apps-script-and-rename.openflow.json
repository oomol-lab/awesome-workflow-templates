    "modules": {
      "n_ca99c898f8b33218": {
        "name": "Request Apps Script upload",
        "imports": [],
        "source": "export default async function upload({ scriptUrl, videoUrl, sharedSecret }, context) {\n  let response;\n  try {\n    response = await context.fetch(scriptUrl, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ videoUrl, secret: sharedSecret }),\n    });\n  } catch {\n    throw Error(\"Upload result is unknown; inspect Drive before rerunning\");\n  }\n  if ([301, 302, 303].includes(response.status)) {\n    const location = response.headers.get(\"location\");\n    if (!location) throw Error(\"Upload response missing redirect; inspect Drive before rerunning\");\n    try {\n      response = await context.fetch(new URL(location, scriptUrl).href, { method: \"GET\" });\n    } catch {\n      throw Error(\"Upload result is unknown; inspect Drive before rerunning\");\n    }\n  }\n  if (!response.ok) throw Error(\"Upload failed; inspect Drive before rerunning\");\n  const data = await response.json(),\n    url = data?.driveUrl,\n    match =\n      typeof url === \"string\"\n        ? url.match(\n            /^https:\\/\\/(?:drive|docs)\\.google\\.com(?:\\/.*|)\\/d\\/([0-9a-zA-Z_-]+)(?:\\/.*|)$/,\n          )\n        : null;\n  if (!match) throw Error(\"Upload did not return a Drive file URL; inspect Drive before rerunning\");\n  return { fileId: match[1] };\n}\n"
      }
    }
