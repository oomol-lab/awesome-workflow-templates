    "modules": {
      "n_7fa94caa6ddd6782": {
        "name": "Download and upload image",
        "imports": [],
        "source": "export default async function upload({ imageUrl, folder, fileName, token }, context) {\n  const image = new URL(imageUrl);\n  if (image.protocol !== \"https:\" || image.hostname !== \"fastly.picsum.photos\")\n    throw Error(\"Set the image host in the HTTP capability\");\n  const source = await context.fetch(image.href);\n  if (!source.ok) throw Error(\"Image download failed\");\n  const bytes = await source.arrayBuffer();\n  const path = [...folder.split(\"/\").filter(Boolean), fileName].map(encodeURIComponent).join(\"/\");\n  let response;\n  try {\n    response = await context.fetch(\n      \"https://graph.microsoft.com/v1.0/sites/root/drive/root:/\" + path + \":/content\",\n      {\n        method: \"PUT\",\n        headers: { authorization: \"Bearer \" + token, \"content-type\": \"application/octet-stream\" },\n        body: bytes,\n      },\n    );\n  } catch {\n    throw Error(\"Upload outcome unknown; inspect destination before retrying\");\n  }\n  if (!response.ok) throw Error(\"Upload failed; inspect destination before retrying\");\n  const result = await response.json();\n  return { id: result.id, name: result.name };\n}\n"
      }
    }
  },
