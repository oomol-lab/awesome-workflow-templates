      "n_8eb0d6d652c6ed18": {
        "name": "Prepare failure details",
        "imports": [],
        "source": "export default function prepare({ workflow, execution, error }) {\n  if (\n    typeof workflow?.name !== \"string\" ||\n    !workflow.name ||\n    typeof execution?.runId !== \"string\" ||\n    !execution.runId ||\n    typeof error?.message !== \"string\"\n  )\n    throw Error(\"Missing workflow failure details\");\n  const escape = (value) =>\n    String(value).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n  const text = `Workflow: ${escape(workflow.name)}\\nRun ID: ${escape(execution.runId)}\\nLast node ID: ${escape(error.nodeId || \"not available\")}\\nError: ${escape(error.message)}`;\n  if (text.length > 40000) throw Error(\"Failure alert exceeds Slack message limit\");\n  return { text };\n}\n"
      }
    }
