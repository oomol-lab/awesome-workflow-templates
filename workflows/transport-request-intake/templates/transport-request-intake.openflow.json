    "modules": {
      "n_bd68a9447093af00": {
        "name": "Normalize and check request",
        "imports": [],
        "source": "export default function transportIntake({ body }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body))\n    throw new Error(\"Transport request must be a JSON object.\");\n  const text = (value) => (value == null ? \"\" : String(value).trim());\n  const raw = text(body.weight_kg).replace(/\\s/g, \"\").replace(\",\", \".\");\n  const weight = /^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)$/.test(raw) ? Number(raw) : NaN;\n  const normalized_request = {\n    pickup_postcode: text(body.pickup_postcode),\n    delivery_postcode: text(body.delivery_postcode),\n    pickup_date: text(body.pickup_date),\n    weight_kg: Number.isFinite(weight) ? weight : null,\n  };\n  const missing_fields = Object.entries(normalized_request)\n    .filter(([, value]) => value === \"\" || value === null)\n    .map(([field]) => field);\n  return {\n    status: missing_fields.length ? \"needs_review\" : \"ready\",\n    missing_fields,\n    normalized_request,\n  };\n}\n"
      }
    }
