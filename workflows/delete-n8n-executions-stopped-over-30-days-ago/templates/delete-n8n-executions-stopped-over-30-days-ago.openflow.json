    "modules": {
      "n_1ffd6a532b618342": {
        "name": "Select execution page",
        "imports": [],
        "source": "export default function page({ cursor, baseUrl }) {\n  return {\n    url:\n      baseUrl.replace(/\\/+$/, \"\") +\n      \"/api/v1/executions?limit=100\" +\n      (cursor ? \"&cursor=\" + encodeURIComponent(cursor) : \"\"),\n  };\n}\n"
      },
      "n_680c4af8f46bae22": {
        "name": "Collect records stopped before the date 30 days ago",
        "imports": [],
        "source": "export default function collect({ page, previous }) {\n  const ids = [...(previous?.ids ?? [])];\n  const now = new Date();\n  now.setUTCHours(0, 0, 0, 0);\n  now.setUTCDate(now.getUTCDate() - 30);\n  const cutoff = previous?.cutoff ?? now.getTime();\n  for (const execution of page.data) {\n    if (!execution.stoppedAt) continue;\n    const stopped = Date.parse(execution.stoppedAt);\n    if (Number.isFinite(stopped) && stopped < cutoff) ids.push(String(execution.id));\n  }\n  return {\n    state: { ids, cutoff },\n    ids,\n    hasNext: !!page.nextCursor,\n    nextCursor: page.nextCursor ?? \"\",\n  };\n}\n"
      },
      "n_47ebe7e3a8dc5ed2": {
        "name": "Select old execution",
        "imports": [],
        "source": "export default function next({ state, previous, baseUrl }) {\n  const index = previous?.index ?? 0;\n  if (index >= state.ids.length)\n    return { state: { index }, hasItem: false, url: \"https://example.com/unused\", count: index };\n  const base = baseUrl.replace(/\\/+$/, \"\");\n  return {\n    state: { index: index + 1 },\n    hasItem: true,\n    url: base + \"/api/v1/executions/\" + encodeURIComponent(state.ids[index]),\n    count: index,\n  };\n}\n"
      }
    }
