{
  "name": "Delete n8n Executions Stopped Over 30 Days Ago",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "delete-n8n-executions-stopped-over-30-days-ago-0"
    },
    {
      "name": "Daily at 07:00 UTC",
      "type": "n8n-nodes-base.cron",
      "position": [
        250,
        460
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 7
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "delete-n8n-executions-stopped-over-30-days-ago-1"
    },
    {
      "id": "delete-n8n-executions-stopped-over-30-days-ago-2",
      "name": "List executions",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "resource": "execution",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      }
    },
    {
      "id": "delete-n8n-executions-stopped-over-30-days-ago-3",
      "name": "Select stopped executions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cutoff = new Date();\ncutoff.setUTCHours(0, 0, 0, 0);\ncutoff.setUTCDate(cutoff.getUTCDate() - 30);\nreturn $input\n  .all()\n  .map((item, index) => ({ json: item.json, pairedItem: { item: index } }))\n  .filter(\n    (item) => item.json.stoppedAt && new Date(item.json.stoppedAt).getTime() < cutoff.getTime(),\n  );\n"
      }
    },
    {
      "id": "delete-n8n-executions-stopped-over-30-days-ago-4",
      "name": "Delete execution",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        950,
        300
      ],
      "parameters": {
        "resource": "execution",
        "operation": "delete",
        "executionId": "={{ $json.id }}"
      }
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "List executions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily at 07:00 UTC": {
      "main": [
        [
          {
            "node": "List executions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List executions": {
      "main": [
        [
          {
            "node": "Select stopped executions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select stopped executions": {
      "main": [
        [
          {
            "node": "Delete execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
