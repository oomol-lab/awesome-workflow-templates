    {
      "name": "Prepare the failure alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json,w=x.workflow??{},e=x.execution??{};if(typeof w.name!=='string'||!w.name)throw Error('Missing workflow name');const url=typeof e.url==='string'&&e.url?e.url:'not available',text='🚨Workflow failed.🚨\\n\\nName: '+w.name+'\\nURL: '+url;if(text.length>5000)throw Error('Failure alert exceeds LINE text limit');return [{json:{to:'YOUR_LINE_DESTINATION_ID',messages:[{type:'text',text}]}}];"
      },
      "id": "send-workflow-failure-alerts-to-line-1"
    },
    {
      "id": "send-workflow-failure-alerts-to-line-2",
      "name": "Send the LINE alert",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        40,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "typeVersion": 4.2
    }
  ],
