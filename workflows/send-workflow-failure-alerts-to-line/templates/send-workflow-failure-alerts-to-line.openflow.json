      "n_15b9100eb307337f": {
        "name": "Prepare the failure alert",
        "imports": [],
        "source": "export default function message({ workflow, execution }) {\n  if (\n    typeof workflow?.name !== \"string\" ||\n    !workflow.name ||\n    typeof execution?.runId !== \"string\" ||\n    !execution.runId\n  )\n    throw Error(\"Missing workflow failure details\");\n  const text = `🚨Workflow failed.🚨\\n\\nName: ${workflow.name}\\nRun ID: ${execution.runId}`;\n  if (text.length > 5000) throw Error(\"Failure alert exceeds LINE text limit\");\n  return { texts: [text] };\n}\n"
      }
    }
