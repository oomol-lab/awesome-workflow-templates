    "modules": {
      "n_77e6e8b9caaeeb8b": {
        "name": "Validate current TOTP",
        "imports": [],
        "source": "import { createHmac } from \"node:crypto\";\nimport { Buffer } from \"node:buffer\";\nexport default function verify({ secret, code }) {\n  const alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567\",\n    s = secret.toUpperCase().replace(/=+$/, \"\");\n  if (!s || !/^[A-Z2-7]+$/.test(s) || ![0, 2, 4, 5, 7].includes(s.length % 8))\n    throw Error(\"Invalid Base32 secret\");\n  let bits = 0,\n    v = 0,\n    bytes = [];\n  for (const c of s) {\n    v = (v << 5) | alphabet.indexOf(c);\n    bits += 5;\n    if (bits >= 8) {\n      bits -= 8;\n      bytes.push((v >>> bits) & 255);\n    }\n  }\n  const counter = BigInt(Math.floor(Date.now() / 30000)),\n    buffer = Buffer.alloc(8);\n  for (let i = 0; i < 8; i++) buffer[7 - i] = Number((counter >> BigInt(i * 8)) & 255n);\n  const digest = createHmac(\"sha1\", Buffer.from(bytes)).update(buffer).digest(),\n    off = digest[digest.length - 1] & 15,\n    n =\n      (((digest[off] & 127) << 24) |\n        (digest[off + 1] << 16) |\n        (digest[off + 2] << 8) |\n        digest[off + 3]) %\n      1000000;\n  return { status: String(n).padStart(6, \"0\") === code ? 1 : 0 };\n}\n"
      }
    }
