      "n_f73a88f4015b1c8d": {
        "name": "Prepare PDF transcription",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function prepare({ file, prompt }, context) {\n  if (\n    file?.mimeType !== \"application/pdf\" ||\n    typeof file.transitUrl !== \"string\" ||\n    !file.transitUrl.startsWith(\"https://\") ||\n    typeof prompt !== \"string\" ||\n    !prompt.trim()\n  )\n    throw new Error(\"Expected a Drive PDF and prompt\");\n  const response = await context.fetch(file.transitUrl, { method: \"GET\" });\n  if (!response.ok) throw new Error(\"PDF download failed\");\n  const bytes = new Uint8Array(await response.arrayBuffer());\n  if (!bytes.length || (typeof file.sizeBytes === \"number\" && bytes.length !== file.sizeBytes))\n    throw new Error(\"Incomplete PDF download\");\n  const data = Buffer.from(bytes).toString(\"base64\");\n  return {\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          { type: \"document\", source: { type: \"base64\", media_type: \"application/pdf\", data } },\n          { type: \"text\", text: prompt },\n        ],\n      },\n    ],\n    geminiBody: {\n      contents: [\n        { parts: [{ inline_data: { mime_type: \"application/pdf\", data } }, { text: prompt }] },\n      ],\n    },\n    bytes: bytes.length,\n  };\n}\n"
      },
      "n_139d948c28bc390b": {
        "name": "Check transcription",
        "imports": [],
        "source": "export default function result({ body, statusCode }) {\n  if (\n    statusCode !== 200 ||\n    !Array.isArray(body?.candidates) ||\n    body.candidates[0]?.finishReason !== \"STOP\"\n  )\n    throw Error(\"PDF transcription failed or incomplete\");\n  const text = body.candidates[0]?.content?.parts\n    ?.map((x) => x.text || \"\")\n    .join(\"\")\n    .trim();\n  if (!text) throw Error(\"Empty transcription\");\n  return { text };\n}\n"
      },
      "n_e2601285e76075dd": {
        "name": "Prepare deposit extraction",
        "imports": [],
        "source": "export default function f({ text }) {\n  return {\n    prompt:\n      \"Extract only deposit rows from this bank statement transcript. Return JSON array of objects with date and description strings and amount number. Do not infer missing values. Transcript:\\n\" +\n      text,\n  };\n}\n"
      },
      "n_e2b5ca8820d5140e": {
        "name": "Check deposit rows",
        "imports": [],
        "source": "export default function result({ raw, text, transcript }) {\n  if (raw?.candidates?.[0]?.finishReason !== \"STOP\")\n    throw Error(\"Deposit extraction failed or incomplete\");\n  let rows;\n  try {\n    rows = JSON.parse(text);\n  } catch {\n    throw Error(\"Invalid deposit JSON\");\n  }\n  if (\n    !Array.isArray(rows) ||\n    rows.some(\n      (x) =>\n        typeof x.date !== \"string\" ||\n        typeof x.description !== \"string\" ||\n        typeof x.amount !== \"number\" ||\n        !Number.isFinite(x.amount),\n    )\n  )\n    throw Error(\"Invalid deposit rows\");\n  return { result: { transcript, deposits: rows } };\n}\n"
      }
    }
  },
