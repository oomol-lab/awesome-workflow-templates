      "n_facf8a593a95195c": {
        "name": "Read bookmark",
        "imports": [],
        "source": "export default function read({ result, item }) {\n  if (!result) throw Error(\"Raindrop request failed; inspect before rerunning\");\n  return { item };\n}\n"
