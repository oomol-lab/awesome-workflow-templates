      "n_05f1e909538cc191": {
        "name": "Read collection ID",
        "imports": [],
        "source": "export default function read({ result, item }) {\n  if (!result || !Number.isSafeInteger(item?._id))\n    throw Error(\"Raindrop did not return an item ID; inspect before rerunning\");\n  return { id: item._id };\n}\n"
      },
