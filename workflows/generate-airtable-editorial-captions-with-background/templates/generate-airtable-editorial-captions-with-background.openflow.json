    "modules": {
      "n_845b62d99e06f645": {
        "name": "Select the next record",
        "imports": [],
        "source": "export default function next({ events, previousState }) {\n  if (!Array.isArray(events)) throw Error(\"Invalid events\");\n  const index = previousState?.index ?? 0;\n  if (!Number.isInteger(index) || index < 0 || index > events.length)\n    throw Error(\"Invalid event index\");\n  if (index === events.length) return { state: { index }, more: false, id: \"unused\", count: index };\n  const id = events[index]?.recordId;\n  if (typeof id !== \"string\" || !id) throw Error(\"Missing automation record ID\");\n  return { state: { index: index + 1 }, more: true, id, count: index };\n}\n"
      },
      "n_4af57ba499a89464": {
        "name": "Read matching briefing",
        "imports": [],
        "source": "export default function ({ record, id }) {\n  if (\n    record?.id !== id ||\n    typeof record.fields?.Briefing !== \"string\" ||\n    !record.fields.Briefing.trim()\n  )\n    throw Error(\"Missing or mismatched briefing\");\n  return { brief: record.fields.Briefing };\n}\n"
      },
      "n_73156278dda354ac": {
        "name": "Prepare record update",
        "imports": [],
        "source": "export default function ({ text, id }) {\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Empty caption\");\n  return {\n    records: [{ id, fields: { SoMe_Text_KI: text.trim(), Posten: false, Werbeanzeige: false } }],\n  };\n}\n"
      },
      "n_86038d012f6eb617": {
        "name": "Reserve caption update",
        "imports": [],
        "source": "export default async function ({ id }, ctx) {\n  const key = \"caption133:\" + id,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect the pending Airtable update: \" + id);\n  if (s?.status === \"done\") return { write: false, key };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { write: true, key };\n}\n"
      },
      "n_cd5b7709c4339bc6": {
        "name": "Confirm caption update",
        "imports": [],
        "source": "export default async function ({ records, id, key }, ctx) {\n  if (!Array.isArray(records) || records.length !== 1 || records[0].id !== id)\n    throw Error(\"Unknown update result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { id };\n}\n"
      }
    }
