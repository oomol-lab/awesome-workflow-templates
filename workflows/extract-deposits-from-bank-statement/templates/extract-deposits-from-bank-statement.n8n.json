      "type": "n8n-nodes-base.compression",
      "position": [
        40,
        320
      ],
      "parameters": {},
      "typeVersion": 1.1
    },
    {
      "id": "extract-deposits-from-bank-statement-6",
      "name": "Images To List",
      "type": "n8n-nodes-base.code",
      "position": [
        220,
        320
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const [i, item] of $input.all().entries())\n  for (const file of Object.values(item.binary ?? {}))\n    out.push({\n      json: { fileName: file.fileName },\n      binary: { data: file },\n      pairedItem: { item: i },\n    });\nreturn out;\n"
      },
      "typeVersion": 2
    },
