    },
    {
      "id": "extract-deposits-from-bank-statement-2",
      "name": "Sort Pages",
      "type": "n8n-nodes-base.code",
      "position": [
        400,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input.all();\nconst number = (s) => {\n  const m = String(s ?? \"\").match(/(\\d+)(?=\\D*$)/);\n  if (!m) throw Error(\"Page filename has no number\");\n  return Number(m[1]);\n};\nreturn a\n  .map((x, i) => ({ json: x.json, binary: x.binary, pairedItem: { item: i } }))\n  .sort((a, b) => number(a.json.fileName) - number(b.json.fileName));\n"
      },
      "typeVersion": 2
    },
    {
      "id": "extract-deposits-from-bank-statement-3",
      "name": "Get Bank Statement",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        -500,
        260
      ],
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_DRIVE_FILE_ID"
        },
        "options": {},
        "operation": "download"
      },
      "typeVersion": 3
    },
    {
      "id": "extract-deposits-from-bank-statement-4",
      "name": "Split PDF into Images",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -140,
        320
      ],
      "parameters": {
        "url": "https://YOUR_STIRLING_PDF_HOST/api/v1/convert/pdf/img",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "fileInput",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            },
            {
              "name": "imageFormat",
              "value": "jpg"
            },
            {
              "name": "singleOrMultiple",
              "value": "multiple"
            },
            {
              "name": "dpi",
              "value": "300"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "extract-deposits-from-bank-statement-5",
