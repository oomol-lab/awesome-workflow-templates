    {
      "name": "Configure earnings run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const runId = \"YOUR_RUN_ID\";\nif (!runId || runId === \"YOUR_RUN_ID\") throw Error(\"Configure unique run ID\");\nreturn { json: { runId } };\n"
      },
      "id": "analyze-earnings-pdfs-with-pinecone-15",
      "position": [
        3300,
        0
