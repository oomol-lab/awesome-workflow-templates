    {
      "name": "Validate earnings file list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all(),\n  ids = items.map((i) => {\n    const url = String(i.json[\"File URL\"] || \"\");\n    return (url.match(/\\/d\\/([\\w-]+)/) || url.match(/[?&]id=([\\w-]+)/))?.[1] || \"\";\n  });\nif (\n  items.length < 3 ||\n  ids.some((id, i) => !id || !items[i].json[\"10Q\"]) ||\n  new Set(ids).size !== ids.length\n)\n  throw Error(\"Provide three distinct PDF URLs and 10Q labels\");\nreturn items.map((item, i) => ({\n  json: { ...item.json, fileId: ids[i] },\n  pairedItem: { item: i },\n}));\n"
      },
      "id": "analyze-earnings-pdfs-with-pinecone-16",
      "position": [
        3520,
        0
      ]
    },
