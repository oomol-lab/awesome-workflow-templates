    "modules": {
      "n_a9a893269ed85349": {
        "name": "Check pending operation",
        "imports": [],
        "source": "export default async function gate({ scheduledAt, acknowledge }, context) {\n  const pending = await context.state.get(\"snapshot-pending\");\n  if (pending) {\n    if (acknowledge !== pending.id)\n      throw Error(`Inspect DigitalOcean before resolving pending ${pending.id} (${pending.kind})`);\n    await context.state.set(\"snapshot-pending\", null);\n  }\n  return { runId: scheduledAt };\n}\n"
      },
      "n_5a1e804ec39b4a71": {
        "name": "Select first Droplet",
        "imports": [],
        "source": "export default function first({ body }) {\n  const id = body?.droplets?.[0]?.id;\n  if (id === undefined) throw Error(\"No Droplet found on first page\");\n  return {\n    url: `https://api.digitalocean.com/v2/droplets/${encodeURIComponent(id)}/snapshots?per_page=200`,\n    actionUrl: `https://api.digitalocean.com/v2/droplets/${encodeURIComponent(id)}/actions`,\n    id: String(id),\n  };\n}\n"
      },
      "n_e71fa7f244b5adb3": {
        "name": "Find oldest snapshot",
        "imports": [],
        "source": "export default function snapshot({ body }) {\n  if (!Array.isArray(body?.snapshots) || !Number.isSafeInteger(body?.meta?.total))\n    throw Error(\"Invalid snapshot listing\");\n  if (body.meta.total > body.snapshots.length)\n    throw Error(\"Snapshot list is incomplete; no write was made\");\n  const list = [...body.snapshots];\n  if (list.some((x) => x.id == null || !Number.isFinite(Date.parse(x.created_at))))\n    throw Error(\"Snapshot is missing ID or creation date\");\n  list.sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at));\n  return {\n    remove: list.length >= 4,\n    url: list.length\n      ? `https://api.digitalocean.com/v2/snapshots/${encodeURIComponent(list[0].id)}`\n      : \"\",\n  };\n}\n"
      },
      "n_607ffceeed1296f2": {
        "name": "Reserve deletion",
        "imports": [],
        "source": "export default async function reserve({ runId, kind }, context) {\n  if (await context.state.get(\"snapshot-pending\"))\n    throw Error(\"Another snapshot operation is pending\");\n  const id = `${kind}:${runId}`;\n  await context.state.set(\"snapshot-pending\", { id, kind });\n  return { id };\n}\n"
      },
      "n_386ab00daaa88b0d": {
        "name": "Confirm deletion",
        "imports": [],
        "source": "export default async function clear({ id }, context) {\n  const pending = await context.state.get(\"snapshot-pending\");\n  if (!pending || pending.id !== id) throw Error(\"Pending snapshot operation mismatch\");\n  await context.state.set(\"snapshot-pending\", null);\n  return { id };\n}\n"
      },
      "n_b817cd95629ebdb6": {
        "name": "Reserve snapshot request",
        "imports": [],
        "source": "export default async function reserve({ runId, kind }, context) {\n  if (await context.state.get(\"snapshot-pending\"))\n    throw Error(\"Another snapshot operation is pending\");\n  const id = `${kind}:${runId}`;\n  await context.state.set(\"snapshot-pending\", { id, kind });\n  return { id };\n}\n"
      },
      "n_e0bed3136d330acc": {
        "name": "Confirm snapshot request",
        "imports": [],
        "source": "export default async function clear({ id }, context) {\n  const pending = await context.state.get(\"snapshot-pending\");\n  if (!pending || pending.id !== id) throw Error(\"Pending snapshot operation mismatch\");\n  await context.state.set(\"snapshot-pending\", null);\n  return { id };\n}\n"
      }
    }
  },
