    {
      "id": "rotate-first-digitalocean-droplet-snapshot-check",
      "name": "Find oldest snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nif (\n  !Array.isArray(b.snapshots) ||\n  !Number.isSafeInteger(b.meta?.total) ||\n  b.meta.total > b.snapshots.length\n)\n  throw Error(\"Incomplete snapshot list\");\nconst s = [...b.snapshots];\nif (s.some((x) => x.id == null || !Number.isFinite(Date.parse(x.created_at))))\n  throw Error(\"Invalid snapshot\");\ns.sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at));\nreturn [{ json: { count: s.length, oldest: s[0]?.id ?? \"\" } }];\n"
      }
    },
