      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const order = JSON.parse($json.raw, (key, value, context) =>\n  typeof value === \"number\" && Number.isInteger(value) && !Number.isSafeInteger(value)\n    ? context.source\n    : value,\n);\nreturn { json: order, pairedItem: { item: $itemIndex } };\n"
      }
    },
