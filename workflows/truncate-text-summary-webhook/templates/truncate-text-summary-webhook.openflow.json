      "n_3fd6347a17b78a70": {
        "name": "Create short summary",
        "imports": [],
        "source": "export default function summarize({ body }) {\n  const event = JSON.parse(body.event),\n    value = event?.text || \"Digite seu texto aqui para resumir.\",\n    text = value.trim(),\n    summary = text.length <= 240 ? text : text.slice(0, 240) + \"...\";\n  return { response: { summary } };\n}\n"
      }
