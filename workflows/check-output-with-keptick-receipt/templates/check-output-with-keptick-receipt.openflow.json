      },
      "n_a4f575fe4273831a": {
        "name": "Choose the records to check",
        "imports": [],
        "source": "function demoRecords(demoCase) {\n  if (demoCase === \"empty\") return [];\n  if (demoCase === \"invalid\") return [{ unexpectedField: \"fictional\" }];\n  if (demoCase === \"duplicates\")\n    return [\"DEMO-001\", \"DEMO-001\", \"DEMO-002\"].map((recordId) => ({ recordId }));\n  if (demoCase === \"healthy\")\n    return [\"DEMO-001\", \"DEMO-002\", \"DEMO-003\"].map((recordId) => ({ recordId }));\n  throw new Error(\"Set demoCase to healthy, empty, invalid, or duplicates.\");\n}\n\nexport default ({ records, demoCase }) => ({ records: records ?? demoRecords(demoCase) });\n"
      },
      "n_0d3724cad318e544": {
        "name": "Check completed outputs",
        "imports": [],
        "source": "function checkOutputs({ records, minimumItems, recordIdField }) {\n  const minimum = Number(minimumItems);\n  if (!Number.isSafeInteger(minimum) || minimum < 0 || minimum > 1000000000)\n    throw new Error(\"minimumItems must be a non-negative integer, at most 1000000000.\");\n  const field = String(recordIdField || \"\").trim();\n  if (!field) throw new Error(\"Set recordIdField to the field identifying a completed output.\");\n  if (\n    !Array.isArray(records) ||\n    records.some((record) => !record || typeof record !== \"object\" || Array.isArray(record))\n  )\n    throw new Error(\"records must be an array of objects.\");\n  const rows = records.filter((record) => Object.keys(record).length > 0);\n  const keys = new Set();\n  let invalidItems = 0;\n  for (const row of rows) {\n    const value = row[field];\n    const valid =\n      (typeof value === \"string\" && value.trim().length > 0) ||\n      (typeof value === \"number\" && Number.isFinite(value));\n    if (!valid) {\n      invalidItems++;\n      continue;\n    }\n    keys.add(String(value).trim());\n  }\n  const items = keys.size;\n  const duplicateItems = rows.length - invalidItems - items;\n  return {\n    checkPassed: items >= minimum && invalidItems === 0,\n    checkStatus: invalidItems ? \"invalid_output\" : items < minimum ? \"below_minimum\" : \"healthy\",\n    minimumItems: minimum,\n    items,\n    invalidItems,\n    duplicateItems,\n  };\n}\nfunction receiptReport(result, eventId, testReceipt) {\n  const { checkPassed, items, minimumItems, invalidItems, duplicateItems } = result;\n  return {\n    ...result,\n    receipt: {\n      eventId,\n      success: checkPassed,\n      items,\n      test: testReceipt === true,\n      message:\n        \"Output check: \" +\n        items +\n        \" distinct IDs; minimum \" +\n        minimumItems +\n        \"; \" +\n        invalidItems +\n        \" invalid; \" +\n        duplicateItems +\n        \" duplicates.\",\n    },\n  };\n}\n\nexport default ({ records, minimumItems, recordIdField, testReceipt }, ctx) => {\n  const report = checkOutputs({ records, minimumItems, recordIdField });\n  return { report: receiptReport(report, \"openflow:\" + ctx.flowId + \":\" + ctx.runId, testReceipt) };\n};\n"
      },
      "n_25efc8b9c367beb3": {
        "name": "Send count-only receipt",
        "imports": [],
        "source": "function validReceiptUrl(url) {\n  return (\n    typeof url === \"string\" &&\n    /^https:\\/\\/keptick\\.aifirm\\.app\\/api\\/v1\\/ingest\\/[A-Za-z0-9._~-]{1,256}$/.test(url) &&\n    !url.endsWith(\"/REPLACE_WITH_YOUR_PRIVATE_TOKEN\") &&\n    !url.endsWith(\"/.\") &&\n    !url.endsWith(\"/..\")\n  );\n}\n\nfunction confirmedReceipt(report, reply) {\n  if (reply?.received !== true) throw new Error(\"The receiver did not confirm this receipt.\");\n  return {\n    ...report,\n    receiptAccepted: true,\n    duplicateReceipt: reply.duplicate === true,\n    monitorStatus: reply.status || null,\n  };\n}\n\nexport default async ({ report, receiptUrl }, ctx) => {\n  if (!validReceiptUrl(receiptUrl))\n    throw new Error(\"Bind a private Keptick receipt URL as a Secret Variable.\");\n  const controller = new AbortController();\n  const remaining = setTimeout(() => controller.abort(), 15000);\n  const cancel = () => controller.abort();\n  ctx.signal.addEventListener(\"abort\", cancel, { once: true });\n  let reply;\n  try {\n    const response = await ctx.fetch(receiptUrl, {\n      method: \"POST\",\n      headers: {\n        \"content-type\": \"application/json\",\n        accept: \"application/json\",\n      },\n      body: JSON.stringify(report.receipt),\n      signal: controller.signal,\n    });\n    if (!response.ok) throw Error(\"Receipt request was unsuccessful.\");\n    reply = await response.json();\n  } catch {\n    throw new Error(\"Keptick receipt was not confirmed. Check the monitor before sending again.\");\n  } finally {\n    clearTimeout(remaining);\n    ctx.signal.removeEventListener(\"abort\", cancel);\n  }\n  return { report: confirmedReceipt(report, reply) };\n};\n"
      },
      "n_15f1402e66743457": {
        "name": "Return the local result",
        "imports": [],
        "source": "export default ({ report }) => ({ report });\n"
      }
    },
