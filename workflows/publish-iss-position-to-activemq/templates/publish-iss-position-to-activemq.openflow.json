    "modules": {
      "n_6b08a585b6538d5a": {
        "name": "Prepare the position URL",
        "imports": [],
        "source": "export default function () {\n  return {url:'https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps='+Math.floor(Date.now()/1000)};\n}\n"
      },
      "n_17c6ae2da971a0af": {
        "name": "Prepare the topic message",
        "imports": [],
        "source": "export default function ({body}) {\n  const p=Array.isArray(body)?body[0]:null;\n  if(!p||typeof p.name!=='string'||!Number.isFinite(p.latitude)||!Number.isFinite(p.longitude)||!Number.isFinite(p.timestamp)) throw Error('Invalid ISS position response');\n  return {body:{body:JSON.stringify({Name:p.name,Latitude:p.latitude,Longitude:p.longitude,Timestamp:p.timestamp})}};\n}\n"
      }
