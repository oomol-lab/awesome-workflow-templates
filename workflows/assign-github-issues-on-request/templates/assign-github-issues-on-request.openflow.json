    "modules": {
      "n_1e4f405f70a9ce5c": {
        "name": "Inspect the assignment request",
        "imports": [],
        "source": "export default function decide({ body }) {\n  const ignore = {\n    action: \"ignore\",\n    owner: \"unused\",\n    repo: \"unused\",\n    issueNumber: 1,\n    assignees: [\"unused\"],\n    labels: [\"assigned\"],\n    comment: \"unused\",\n  };\n  if (!body || typeof body !== \"object\" || Array.isArray(body)) throw Error(\"Invalid GitHub event\");\n  if (body.action !== \"opened\" && body.action !== \"created\") return ignore;\n  const issue = body.issue,\n    repo = body.repository;\n  if (\n    !issue ||\n    !repo ||\n    typeof repo.name !== \"string\" ||\n    !repo.name ||\n    typeof repo.owner?.login !== \"string\" ||\n    !repo.owner.login ||\n    !Number.isSafeInteger(issue.number) ||\n    issue.number < 1 ||\n    !Array.isArray(issue.assignees)\n  )\n    throw Error(\"Invalid GitHub issue event\");\n  const isComment = body.action === \"created\",\n    text = isComment ? body.comment?.body : issue.body;\n  if (text == null) return ignore;\n  if (typeof text !== \"string\") throw Error(\"Invalid issue or comment text\");\n  if (!/[a,A]ssign[\\w*\\s*]*me/gm.test(text)) return ignore;\n  const requester = isComment ? body.comment?.user?.login : issue.user?.login;\n  if (\n    typeof requester !== \"string\" ||\n    !/^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$/.test(requester)\n  )\n    throw Error(\"Invalid requester login\");\n  const base = { ...ignore, owner: repo.owner.login, repo: repo.name, issueNumber: issue.number };\n  if (issue.assignees.length === 0) return { ...base, action: \"assign\", assignees: [requester] };\n  if (!isComment) return ignore;\n  const assigned = issue.assignee?.login;\n  if (\n    typeof assigned !== \"string\" ||\n    !/^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$/.test(assigned)\n  )\n    throw Error(\"Missing assigned user\");\n  return {\n    ...base,\n    action: \"comment\",\n    comment: \"Hey @\" + requester + \",\\n\\nThis issue is already assigned to \" + assigned + \" 🙂\",\n  };\n}\n"
      },
      "n_e6d93dd9beb65975": {
        "name": "Assign the issue",
        "imports": [],
        "source": "export default async function assignIssue(\n  { owner, repo, issueNumber, assignees, labels },\n  context,\n) {\n  const issue = await context.actions.call(\"github.update_issue\", {\n    owner,\n    repo,\n    issueNumber,\n    assignees,\n    labels,\n  });\n  return { output: issue };\n}\n"
      }
    }
