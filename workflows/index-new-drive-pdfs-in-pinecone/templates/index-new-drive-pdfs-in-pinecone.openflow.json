    "modules": {
      "n_c85a8845504fd3ba": {
        "name": "Choose document indexing step",
        "imports": [],
        "source": "export default async function step({ events, ack, resolution, confirmedJobId }, ctx) {\n  if (!Array.isArray(events) || !events.length) throw Error(\"No changed documents\");\n  const identity = JSON.stringify(events.map((x) => [x.fileId, x.modifiedTime]));\n  let hash = 2166136261;\n  for (const c of identity) hash = Math.imul(hash ^ c.charCodeAt(0), 16777619);\n  const key = \"pdf-ingest:\" + String(hash >>> 0);\n  let s = await ctx.state.get(key);\n  if (!s) s = { identity, index: 0, offset: 0, polls: 0, phase: \"read-ready\" };\n  if (s.identity !== identity) throw Error(\"Batch hash conflict\");\n  if (s.phase === \"read-pending\") {\n    s.phase = \"read-ready\";\n    await ctx.state.set(key, s);\n  }\n  if (s.phase === \"upsert-pending\") {\n    if (ack !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending vector write \" + key);\n    if (resolution === \"confirmed\") {\n      if (s.offset + 3000 >= s.text.length) {\n        s.index++;\n        s.offset = 0;\n        delete s.text;\n      } else s.offset += 2700;\n      s.phase = s.index < events.length ? (s.text ? \"embed-ready\" : \"read-ready\") : \"done\";\n    } else s.phase = \"embed-ready\";\n    await ctx.state.set(key, s);\n  }\n  let action = s.phase.endsWith(\"-ready\") ? s.phase.slice(0, -6) : s.phase,\n    e = events[s.index];\n  if (e && (!e.fileId || !e.mimeType || !e.modifiedTime)) throw Error(\"Unexpected document event\");\n  if (action === \"read\") s.phase = \"read-pending\";\n  await ctx.state.set(key, s);\n  let text = s.text?.slice(s.offset, s.offset + 3000) || \" \";\n  return {\n    key,\n    action,\n    jobId: s.jobId ?? \"none\",\n    fileId: e?.fileId ?? \"\",\n    name: e?.name ?? \"\",\n    modified: e?.modifiedTime ?? \"\",\n    offset: s.offset,\n    text,\n    request: {\n      fileId: e?.fileId ?? \"\",\n      name: e?.name ?? \"\",\n      mimeType: e?.mimeType ?? \"\",\n      modifiedTime: e?.modifiedTime ?? \"\",\n    },\n  };\n}\n"
      },
      "n_b50b8a64c807700b": {
        "name": "Confirm document extraction",
        "imports": [],
        "source": "export default async function f({ key, fileId, status, body }, ctx) {\n  const s = await ctx.state.get(key);\n  if (\n    !s ||\n    s.phase !== \"read-pending\" ||\n    status !== 200 ||\n    body?.fileId !== fileId ||\n    typeof body.text !== \"string\"\n  )\n    throw Error(\"Invalid PDF extraction\");\n  const text = body.text\n    .replace(/(\\r\\n|\\n|\\r)/gm, \" \")\n    .trim()\n    .replace(/[^\\w\\s]/gi, \"\");\n  if (!text.trim()) throw Error(\"PDF has no indexable text\");\n  s.text = text;\n  s.phase = \"embed-ready\";\n  await ctx.state.set(key, s);\n  return { ok: true };\n}\n"
      },
      "n_dff0b013bc0b4b09": {
        "name": "Prepare and reserve vector",
        "imports": [],
        "source": "export default async function vector(\n  { key, fileId, name, modified, offset, text, embedding },\n  ctx,\n) {\n  let s = await ctx.state.get(key);\n  if (\n    !s ||\n    s.phase !== \"embed-ready\" ||\n    s.offset !== offset ||\n    !text ||\n    !Array.isArray(embedding) ||\n    embedding.length !== 3072\n  )\n    throw Error(\"Invalid document embedding\");\n  s.phase = \"upsert-pending\";\n  await ctx.state.set(key, s);\n  return {\n    vectors: [\n      {\n        id: fileId + \":\" + modified + \":\" + offset,\n        values: embedding,\n        metadata: { fileId, name, modified, text },\n      },\n    ],\n  };\n}\n"
      },
      "n_49f45f529115c310": {
        "name": "Confirm vector write",
        "imports": [],
        "source": "export default async function confirm({ key, count }, ctx) {\n  let s = await ctx.state.get(key);\n  if (!s || s.phase !== \"upsert-pending\" || count !== 1) throw Error(\"Inspect Pinecone write\");\n  if (s.offset + 3000 >= s.text.length) {\n    s.index++;\n    s.offset = 0;\n    delete s.text;\n  } else s.offset += 2700;\n  let events = JSON.parse(s.identity);\n  s.phase = s.index < events.length ? (s.text ? \"embed-ready\" : \"read-ready\") : \"done\";\n  await ctx.state.set(key, s);\n  return { ok: true };\n}\n"
      }
    }
  },
