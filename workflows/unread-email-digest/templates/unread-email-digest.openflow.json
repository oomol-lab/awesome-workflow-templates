    "modules": {
      "n_1714968c4b1ba48d": {
        "name": "Prepare email batch",
        "imports": [],
        "source": "export default ({ messages }) => {\n  const lines = messages.map((email) => {\n    const sender = email.sender || 'Sconosciuto';\n    const subject = email.subject || '(senza oggetto)';\n    const preview = String(email.preview?.body || email.messageText || '').slice(0, 200).replace(/\\s+/g, ' ');\n    return 'DA: ' + sender + '\\nOGGETTO: ' + subject + '\\nANTEPRIMA: ' + preview + '\\n---';\n  });\n  return { vuoto: lines.length === 0, totale: lines.length, testoEmail: lines.join('\\n') };\n};\n"
      },
      "n_96692bef5aa03ad7": {
        "name": "Format digest",
        "imports": [],
        "source": "export default ({ summary, timezone }) => {\n  const parts = Object.fromEntries(\n    new Intl.DateTimeFormat('en-GB', { timeZone: timezone, day: '2-digit', month: '2-digit' })\n      .formatToParts(new Date()).map((part) => [part.type, part.value]),\n  );\n  return { text: '☕ Rassegna email del ' + parts.day + '/' + parts.month + '\\n\\n' + summary };\n};\n"
      }
    }
