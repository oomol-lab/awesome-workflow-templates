    "modules": {
      "n_0cca178c6d33454d": {
        "name": "Choose the subject",
        "imports": [],
        "source": "export default function subject({subject}){if(typeof subject!=='string'||!/^[-a-zA-Z0-9_]+$/.test(subject))throw Error('Enter an Open Library subject slug');return{url:'https://openlibrary.org/subjects/'+encodeURIComponent(subject)+'.json?limit=0',subject}}\n"
      },
      "n_6e21ddd46faf752d": {
        "name": "Choose a random work",
        "imports": [],
        "source": "export default function count({body,subject}){const n=body?.work_count;if(!Number.isSafeInteger(n)||n<0)throw Error('Invalid Open Library work count');return{found:n>0,url:'https://openlibrary.org/subjects/'+encodeURIComponent(subject)+'.json?limit=1&offset='+(n?Math.floor(Math.random()*n):0)+'&details=true',subject}}\n"
      },
      "n_e4024938eebc3347": {
        "name": "Prepare the work details URL",
        "imports": [],
        "source": "export default function basic({body}){const w=body?.works?.[0];if(!w||typeof w.title!=='string'||!/^\\/works\\/OL\\d+W$/.test(w.key)||!Array.isArray(w.authors))throw Error('Invalid Open Library work');return{url:'https://openlibrary.org'+w.key+'.json',work:w}}\n"
      },
      "n_2a6ce5a5ef0c9331": {
        "name": "Format the recommendation",
        "imports": [],
        "source": "export default function format({work,body}){if(body?.key!==work.key)throw Error('Unexpected Open Library work');const esc=x=>String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const authors=work.authors.map(a=>{if(!a||typeof a.name!=='string'||!/^\\/authors\\/OL\\d+A$/.test(a.key))throw Error('Invalid author');return '<a href=\"https://openlibrary.org'+a.key+'\">'+esc(a.name)+'</a>'}).join(', ');const d=typeof body.description==='string'?body.description:body.description?.value;const title=esc(work.title);return{subject:'Book Recommendation: '+work.title,html:'<h2><a href=\"https://openlibrary.org'+work.key+'\">'+title+'</a></h2><p><em>By '+authors+'</em><br>'+esc(d||'No description available.')+'</p>'}}\n"
      },
      "n_591e5268e5aa0eba": {
        "name": "Format the no-book notice",
        "imports": [],
        "source": "export default function empty({subject}){return{subject:'Book not found in '+subject,html:'<p>Unfortunately, there are no books available for the subject of <em>'+subject+'</em>. Choose another subject.</p><p>See <a href=\"https://openlibrary.org/subjects\">Open Library subjects</a>.</p>'}}\n"
      }
    }
