    "modules": {
      "n_cf47a3de301dc526": {
        "name": "Prepare call",
        "imports": [],
        "source": "import { randomUUID } from 'node:crypto';\n\nexport default function prepareCall({ body }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('Call data must be an object.');\n  const text = (value) => value == null ? '' : String(value);\n  const callId = text(body.call_id) || randomUUID();\n  const caller = text(body.caller_name || body.from) || 'Unknown';\n  const phone = text(body.caller_phone || body.from);\n  const duration = body.duration == null || body.duration === '' ? 0 : Number(body.duration);\n  if (!Number.isFinite(duration) || duration < 0) throw new Error('Call duration must be a nonnegative number.');\n  const transcript = text(body.transcript).slice(0, 500);\n  const summary = text(body.summary);\n  const receivedAt = new Date().toISOString();\n  return { callId, caller, phone, duration, transcript, summary, receivedAt, values: [[callId, receivedAt, caller, phone, duration, summary, transcript]] };\n}\n"
      }
