      "id": "trigger-webhook",
      "name": "Receive Content",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const {randomUUID}=require('crypto');\n\nconst prepare = function prepareRepurposing({request}) {\n  if (!request || typeof request !== 'object' || Array.isArray(request)) throw new Error('Submit a content object.');\n  const content=request.content||request.text||'';\n  if(typeof content!=='string'||content.trim().length<50) throw new Error('Content must be at least 50 characters.');\n  const title=request.title||'Untitled',brandVoice=request.brand_voice||'professional yet approachable';\n  if(typeof title!=='string'||typeof brandVoice!=='string') throw new Error('Title and brand_voice must be strings.');\n  return {content,title,brandVoice,requestId:randomUUID(),processedAt:new Date().toISOString()};\n}\n\nreturn [{json:prepare({request:$input.first().json.body??$input.first().json}),pairedItem:{item:0}}];"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Title: {{ $('Validate Input').first().json.title }}\nBrand Voice: {{ $('Validate Input').first().json.brandVoice }}\n\nContent:\n{{ $('Validate Input').first().json.content }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Analyze the content and extract: 5 key points, core message in one sentence, 10 hashtags, 5 SEO keywords. Respond in JSON: { keyPoints, coreMessage, hashtags, seoKeywords }"
            }
          ]
        },
        "batching": {
          "batchSize": 1
        }
      },
      "id": "ai-analysis",
      "name": "AI: Quick Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        400,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prepare = function preparePlatformPrompts({analysis,title,brandVoice,requestId}) {\n  if(!analysis||typeof analysis!=='object'||Array.isArray(analysis)) throw new Error('The analysis must be a JSON object.');\n  for(const name of ['keyPoints','hashtags','seoKeywords']) if(!Array.isArray(analysis[name])||analysis[name].some(value=>typeof value!=='string'||!value.trim())) throw new Error('The analysis has invalid '+name+'.');\n  if(typeof analysis.coreMessage!=='string'||!analysis.coreMessage.trim()) throw new Error('The analysis has no core message.');\n  return {title,brandVoice,requestId,keyPointsJson:JSON.stringify(analysis.keyPoints),coreMessage:analysis.coreMessage};\n}\n\nreturn [{json:prepare({analysis:$input.first().json,...$('Validate Input').first().json}),pairedItem:{item:0}}];"
      },
      "id": "merge-data",
      "name": "Prepare Platform Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
