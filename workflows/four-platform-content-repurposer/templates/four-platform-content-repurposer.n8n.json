{
  "name": "FlowScribe Lite — Quick 4-Platform Repurpose",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "four-platform-content-repurposer",
        "responseMode": "responseNode",
        "options": {}
