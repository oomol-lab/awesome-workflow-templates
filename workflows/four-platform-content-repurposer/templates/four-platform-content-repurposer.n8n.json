    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const collect = function collectPlatformDrafts({requestId,title,twitter,linkedin,instagram,facebook}) {\n  for(const [name,value] of Object.entries({twitter,linkedin,instagram,facebook})) if(!value||typeof value!=='object'||Array.isArray(value)) throw new Error(name+' must be a JSON object.');\n  if(!Array.isArray(twitter.thread)||twitter.thread.length===0||twitter.thread.some(value=>typeof value!=='string'||!value.trim())) throw new Error('The X draft has no complete thread.');\n  for(const [name,value] of [['LinkedIn post',linkedin.post],['Instagram caption',instagram.caption],['Facebook post',facebook.post]]) if(typeof value!=='string'||!value.trim()) throw new Error('The '+name+' is missing.');\n  if(!Array.isArray(instagram.hashtags)||instagram.hashtags.some(value=>typeof value!=='string'||!value.trim())) throw new Error('The Instagram hashtags are invalid.');\n  const completedAt=new Date().toISOString();\n  return {values:[[requestId,title,completedAt,JSON.stringify(twitter.thread),linkedin.post,instagram.caption,facebook.post]],result:{success:true,requestId,title,completedAt,platforms:['twitter','linkedin','instagram','facebook'],drafts:{twitter,linkedin,instagram,facebook},message:'4 platform drafts generated and logged to Google Sheets.'}};\n}\n\nreturn [{json:collect({requestId:$('Validate Input').first().json.requestId,title:$('Validate Input').first().json.title,twitter:$('Generate: Twitter Thread').first().json,linkedin:$('Generate: LinkedIn Post').first().json,instagram:$('Generate: Instagram Caption').first().json,facebook:$('Generate: Facebook Post').first().json}),pairedItem:{item:0}}];"
      },
