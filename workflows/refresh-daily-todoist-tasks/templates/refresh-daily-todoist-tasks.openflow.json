    "modules": {
      "n_a7c9d470bfd5e81c": {
        "name": "Read template tasks",
        "imports": [],
        "source": "export default async function collect({projectId,previous},context){\n if(!projectId||projectId.startsWith('YOUR_'))throw Error('Configure the Todoist project ID');\n const s=previous??{tasks:[],cursor:null,seen:[]};\n const page=await context.actions.call('todoist.list_tasks',{projectId,limit:200,...(s.cursor?{cursor:s.cursor}:{})});\n if(!Array.isArray(page.tasks))throw Error('Invalid Todoist task page');\n const cursor=page.nextCursor;if(cursor!==null&&(typeof cursor!=='string'||!cursor||s.seen.includes(cursor)))throw Error('Invalid or repeated Todoist cursor');\n const state={tasks:[...s.tasks,...page.tasks],cursor,seen:cursor?[...s.seen,cursor]:s.seen};return {state,more:cursor!==null,projectId};\n}\n"
      },
      "n_3aaec584decf9025": {
        "name": "Read Inbox tasks",
        "imports": [],
        "source": "export default async function collect({projectId,previous},context){\n if(!projectId||projectId.startsWith('YOUR_'))throw Error('Configure the Todoist project ID');\n const s=previous??{tasks:[],cursor:null,seen:[]};\n const page=await context.actions.call('todoist.list_tasks',{projectId,limit:200,...(s.cursor?{cursor:s.cursor}:{})});\n if(!Array.isArray(page.tasks))throw Error('Invalid Todoist task page');\n const cursor=page.nextCursor;if(cursor!==null&&(typeof cursor!=='string'||!cursor||s.seen.includes(cursor)))throw Error('Invalid or repeated Todoist cursor');\n const state={tasks:[...s.tasks,...page.tasks],cursor,seen:cursor?[...s.seen,cursor]:s.seen};return {state,more:cursor!==null,projectId};\n}\n"
      },
      "n_69c4061176ca866e": {
        "name": "Select old tasks and today’s templates",
        "imports": [],
        "source": "export default function plan({templates,inbox,now,templateProject,inboxProject}){\n if(!templateProject||!inboxProject||templateProject===inboxProject)throw Error('Template and Inbox projects must differ');\n const date=new Date(now);if(!Number.isFinite(date.getTime()))throw Error('Invalid run date');\n const weekday=['sun','mon','tues','wed','thurs','fri','sat'][date.getUTCDay()];\n const remove=[];for(const t of inbox.tasks){if(!t||typeof t.id!=='string'||!t.id||!Array.isArray(t.labels))throw Error('Invalid Inbox task');if(t.labels.includes('daily'))remove.push(t.id)}\n const create=[];for(const t of templates.tasks){if(!t||typeof t.id!=='string'||!t.id||typeof t.content!=='string'||!t.content||typeof t.description!=='string')throw Error('Invalid template task');const fields={};for(const part of t.description.split(';')){const p=part.trim().split(':');if(p.length===2)fields[p[0]]=p[1].trim()}if(!(fields.days||'').includes(weekday))continue;let dueDatetime;if(fields.due){const m=/^(\\d{1,2})(?:\\.(\\d{2}))?([ap]m)$/i.exec(fields.due);if(!m||+m[1]<1||+m[1]>12||+(m[2]||0)>59)throw Error('Invalid template due time');let h=(+m[1]%12)+(m[3].toLowerCase()==='pm'?12:0);const d=new Date(date);d.setUTCHours(h,+(m[2]||0),0,0);dueDatetime=d.toISOString()}create.push({content:t.content,description:t.description,...(dueDatetime?{dueDatetime}:{})})}\n return {remove,create};\n}\n"
      },
      "n_d4320ac546777c8e": {
        "name": "Prepare next deletion",
        "imports": [],
        "source": "export default function next({items,previous}){const i=previous?.index??0;if(i>=items.length)return {state:{index:i},more:false,item:{},endpoint:'/tasks/-'};const item=typeof items[i]==='string'?{id:items[i]}:items[i];return {state:{index:i+1},more:true,item,endpoint:item.id?'/tasks/'+encodeURIComponent(item.id):'/tasks/-'}}\n"
      },
      "n_f0ac998d2bc88c2e": {
        "name": "Prepare next task",
        "imports": [],
        "source": "export default function next({items,previous}){const i=previous?.index??0;if(i>=items.length)return {state:{index:i},more:false,item:{},endpoint:'/tasks/-'};const item=typeof items[i]==='string'?{id:items[i]}:items[i];return {state:{index:i+1},more:true,item,endpoint:item.id?'/tasks/'+encodeURIComponent(item.id):'/tasks/-'}}\n"
      },
      "n_60f728378b94c118": {
        "name": "Check deletion",
