    {
      "id": "refresh-daily-todoist-tasks-1",
      "name": "Read template tasks",
      "type": "n8n-nodes-base.todoist",
      "position": [
        860,
        420
      ],
      "parameters": {
        "authentication": "apiKey",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
