    {
      "id": "score-and-route-demo-leads-6",
      "name": "Extract Page Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        -100
      ],
      "parameters": {
        "jsCode": "const lead = $(\"Normalize, Score, and Assign Owner\").item.json;\nconst html = String($json.body || $json.data || \"\");\nconst title = (html.match(/<title[^>]*>([^<]+)<\\/title>/i)?.[1] || \"\").replace(/\\s+/g, \" \").trim();\nconst desc = (html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']+)/i)?.[1] || \"\")\n  .replace(/\\s+/g, \" \")\n  .trim();\nconst pageText = `${title} ${desc}`.toLowerCase();\nconst pageTags = [];\nfor (const [term, tag] of [\n  [\"pricing\", \"pricing_page\"],\n  [\"demo\", \"demo_page\"],\n  [\"case study\", \"proof_page\"],\n  [\"integration\", \"integration_page\"],\n  [\"contact\", \"contact_page\"],\n]) {\n  if (pageText.includes(term)) pageTags.push(tag);\n}\nconst pageBoost =\n  pageTags.includes(\"pricing_page\") || pageTags.includes(\"demo_page\") ? 8 : pageTags.length ? 3 : 0;\nconst score = Math.min(100, Number(lead.lead_score || 0) + pageBoost);\nreturn [\n  {\n    json: {\n      ...lead,\n      page_title: title,\n      page_description: desc,\n      page_signal_tags: pageTags.join(\", \"),\n      lead_score: score,\n      priority: score >= 72 ? \"hot\" : score >= 42 ? \"review\" : \"normal\",\n      sla_minutes: score >= 72 ? 15 : score >= 42 ? 240 : 1440,\n    },\n  },\n];\n"
      }
    },
