    "modules": {
      "n_4eaf4e4b532bf845": {
        "name": "Validate record details",
        "imports": [],
        "source": "export default function ({ tableId, nameFieldId, ageFieldId, name, initialAge, updatedAge }) {\n  if (\n    !tableId.trim() ||\n    !/^[A-Za-z0-9_-]+$/.test(tableId) ||\n    !Number.isSafeInteger(nameFieldId) ||\n    nameFieldId <= 3 ||\n    !Number.isSafeInteger(ageFieldId) ||\n    ageFieldId <= 3 ||\n    nameFieldId === ageFieldId ||\n    !name.trim() ||\n    !Number.isFinite(initialAge) ||\n    !Number.isFinite(updatedAge)\n  )\n    throw Error(\"Enter table, distinct field IDs, name and ages\");\n  return { tableId, nameFieldId, ageFieldId, name, initialAge, updatedAge };\n}\n"
      },
      "n_53d5a2aa48459402": {
        "name": "Create record",
        "imports": [],
        "source": "export default async function (p, ctx) {\n  const r = await ctx.actions.call(\"quickbase.upsert_records\", {\n    tableId: p.tableId,\n    data: [{ [p.nameFieldId]: { value: p.name }, [p.ageFieldId]: { value: p.initialAge } }],\n    fieldsToReturn: [3],\n  });\n  const id = r?.data?.[0]?.[\"3\"]?.value,\n    m = r?.metadata;\n  if (\n    !Number.isSafeInteger(id) ||\n    id <= 0 ||\n    m?.createdRecordIds?.length !== 1 ||\n    m.createdRecordIds[0] !== id ||\n    Object.keys(m.lineErrors ?? {}).length\n  )\n    throw Error(\"Quickbase did not confirm one created record\");\n  return { id };\n}\n"
      },
      "n_fba4841319b96423": {
        "name": "Update record age",
        "imports": [],
        "source": "export default async function ({ tableId, ageFieldId, updatedAge, id }, ctx) {\n  const r = await ctx.actions.call(\"quickbase.upsert_records\", {\n    tableId,\n    data: [{ 3: { value: id }, [ageFieldId]: { value: updatedAge } }],\n    mergeFieldId: 3,\n    fieldsToReturn: [3],\n  });\n  const m = r?.metadata,\n    returned = r?.data?.[0]?.[\"3\"]?.value,\n    ids = [...(m?.updatedRecordIds ?? []), ...(m?.unchangedRecordIds ?? [])];\n  if (\n    returned !== id ||\n    ids.length !== 1 ||\n    ids[0] !== id ||\n    (m?.createdRecordIds ?? []).length ||\n    Object.keys(m?.lineErrors ?? {}).length\n  )\n    throw Error(\"Quickbase did not confirm update of the same record\");\n  return { id };\n}\n"
      },
      "n_b7d8f5533a1bd5b8": {
        "name": "List table records",
        "imports": [],
        "source": "export default async function ({ tableId }, ctx) {\n  const r = await ctx.actions.call(\"quickbase.query_records\", { tableId, options: { top: 50 } });\n  if (!Array.isArray(r?.data) || !Array.isArray(r.fields) || !r.metadata || r.data.length > 50)\n    throw Error(\"Invalid Quickbase query response\");\n  const names = new Map();\n  for (const f of r.fields) {\n    if (!Number.isSafeInteger(f?.id) || typeof f.label !== \"string\" || names.has(String(f.id)))\n      throw Error(\"Invalid field metadata\");\n    names.set(String(f.id), f.label);\n  }\n  const labels = new Set(names.values());\n  if (labels.size !== names.size) throw Error(\"Duplicate field labels\");\n  return {\n    records: r.data.map((rec) =>\n      Object.fromEntries(\n        Object.entries(rec).map(([id, v]) => {\n          if (!names.has(id) || !v || !Object.hasOwn(v, \"value\"))\n            throw Error(\"Invalid field value\");\n          return [names.get(id), v.value];\n        }),\n      ),\n    ),\n  };\n}\n"
      }
    }
  },
