    "modules": {
      "n_4eaf4e4b532bf845": {
        "name": "Validate record details",
        "imports": [],
        "source": "export default function({tableId,nameFieldId,ageFieldId,name,initialAge,updatedAge}){if(!tableId.trim()||!/^[A-Za-z0-9_-]+$/.test(tableId)||!Number.isSafeInteger(nameFieldId)||nameFieldId<=3||!Number.isSafeInteger(ageFieldId)||ageFieldId<=3||nameFieldId===ageFieldId||!name.trim()||!Number.isFinite(initialAge)||!Number.isFinite(updatedAge))throw Error('Enter table, distinct field IDs, name and ages');return {tableId,nameFieldId,ageFieldId,name,initialAge,updatedAge}}\n"
      },
      "n_53d5a2aa48459402": {
        "name": "Create record",
        "imports": [],
        "source": "export default async function(p,ctx){const r=await ctx.actions.call('quickbase.upsert_records',{tableId:p.tableId,data:[{[p.nameFieldId]:{value:p.name},[p.ageFieldId]:{value:p.initialAge}}],fieldsToReturn:[3]});const id=r?.data?.[0]?.['3']?.value,m=r?.metadata;if(!Number.isSafeInteger(id)||id<=0||m?.createdRecordIds?.length!==1||m.createdRecordIds[0]!==id||Object.keys(m.lineErrors??{}).length)throw Error('Quickbase did not confirm one created record');return{id}}\n"
      },
      "n_fba4841319b96423": {
        "name": "Update record age",
        "imports": [],
        "source": "export default async function({tableId,ageFieldId,updatedAge,id},ctx){const r=await ctx.actions.call('quickbase.upsert_records',{tableId,data:[{'3':{value:id},[ageFieldId]:{value:updatedAge}}],mergeFieldId:3,fieldsToReturn:[3]});const m=r?.metadata,returned=r?.data?.[0]?.['3']?.value,ids=[...(m?.updatedRecordIds??[]),...(m?.unchangedRecordIds??[])];if(returned!==id||ids.length!==1||ids[0]!==id||(m?.createdRecordIds??[]).length||Object.keys(m?.lineErrors??{}).length)throw Error('Quickbase did not confirm update of the same record');return{id}}\n"
      },
      "n_b7d8f5533a1bd5b8": {
        "name": "List table records",
        "imports": [],
        "source": "export default async function({tableId},ctx){const r=await ctx.actions.call('quickbase.query_records',{tableId,options:{top:50}});if(!Array.isArray(r?.data)||!Array.isArray(r.fields)||!r.metadata||r.data.length>50)throw Error('Invalid Quickbase query response');const names=new Map();for(const f of r.fields){if(!Number.isSafeInteger(f?.id)||typeof f.label!=='string'||names.has(String(f.id)))throw Error('Invalid field metadata');names.set(String(f.id),f.label)}const labels=new Set(names.values());if(labels.size!==names.size)throw Error('Duplicate field labels');return {records:r.data.map(rec=>Object.fromEntries(Object.entries(rec).map(([id,v])=>{if(!names.has(id)||!v||!Object.hasOwn(v,'value'))throw Error('Invalid field value');return [names.get(id),v.value]})))}}\n"
      }
    }
