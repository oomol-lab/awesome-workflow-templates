{
  "name": "Create, Update and List Quickbase Records",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-0"
    },
    {
      "name": "Set record details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tableId = \"\",\n  nameFieldId = 0,\n  ageFieldId = 0,\n  name = \"\",\n  initialAge = 0,\n  updatedAge = 0;\nif (\n  !/^[A-Za-z0-9_-]+$/.test(tableId) ||\n  !Number.isSafeInteger(nameFieldId) ||\n  nameFieldId <= 3 ||\n  !Number.isSafeInteger(ageFieldId) ||\n  ageFieldId <= 3 ||\n  nameFieldId === ageFieldId ||\n  !name.trim() ||\n  !Number.isFinite(initialAge) ||\n  !Number.isFinite(updatedAge)\n)\n  throw Error(\"Enter table, distinct field IDs, name and ages\");\nreturn [{ json: { tableId, nameFieldId, ageFieldId, name, initialAge, updatedAge } }];\n"
      },
      "id": "create-update-and-list-quickbase-records-1"
    },
    {
      "name": "Prepare creation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $input.first().json;\nreturn [{ json: { [p.nameFieldId]: p.name, [p.ageFieldId]: p.initialAge } }];\n"
      },
      "id": "create-update-and-list-quickbase-records-2"
    },
    {
      "name": "Quick Base",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        650,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "create",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "columns": "unused",
        "simple": false,
        "options": {
          "useFieldIDs": true
        }
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-3"
    },
    {
      "name": "Confirm created record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json,\n  p = $(\"Set record details\").first().json,\n  id = r.data?.[0]?.[\"3\"]?.value,\n  m = r.metadata;\nif (\n  !Number.isSafeInteger(id) ||\n  id <= 0 ||\n  m?.createdRecordIds?.length !== 1 ||\n  m.createdRecordIds[0] !== id ||\n  Object.keys(m.lineErrors ?? {}).length\n)\n  throw Error(\"Record creation not confirmed\");\nreturn [{ json: { 3: id, [p.ageFieldId]: p.updatedAge } }];\n"
      },
      "id": "create-update-and-list-quickbase-records-4"
    },
    {
      "name": "Quick Base1",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        1050,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "upsert",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "columns": "unused",
        "updateKey": "3",
        "mergeFieldId": "={{ 3 }}",
        "simple": false,
        "options": {
          "useFieldIDs": true
        }
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-5"
    },
    {
      "name": "Confirm updated record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json,\n  id = $(\"Confirm created record\").first().json[\"3\"],\n  m = r.metadata,\n  ids = [...(m?.updatedRecordIds ?? []), ...(m?.unchangedRecordIds ?? [])];\nif (\n  r.data?.[0]?.[\"3\"]?.value !== id ||\n  ids.length !== 1 ||\n  ids[0] !== id ||\n  (m?.createdRecordIds ?? []).length ||\n  Object.keys(m?.lineErrors ?? {}).length\n)\n  throw Error(\"Same-record update not confirmed\");\nreturn [{ json: { id } }];\n"
      },
      "id": "create-update-and-list-quickbase-records-6"
    },
    {
      "name": "Quick Base2",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        1250,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "getAll",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "returnAll": false,
        "limit": 50,
        "options": {}
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-7"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
