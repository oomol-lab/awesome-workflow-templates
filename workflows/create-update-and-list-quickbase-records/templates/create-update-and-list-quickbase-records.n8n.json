{
  "name": "Create, Update and List Quickbase Records",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-0"
    },
    {
      "name": "Set record details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tableId='',nameFieldId=0,ageFieldId=0,name='',initialAge=0,updatedAge=0;if(!/^[A-Za-z0-9_-]+$/.test(tableId)||!Number.isSafeInteger(nameFieldId)||nameFieldId<=3||!Number.isSafeInteger(ageFieldId)||ageFieldId<=3||nameFieldId===ageFieldId||!name.trim()||!Number.isFinite(initialAge)||!Number.isFinite(updatedAge))throw Error('Enter table, distinct field IDs, name and ages');return [{json:{tableId,nameFieldId,ageFieldId,name,initialAge,updatedAge}}];"
      },
      "id": "create-update-and-list-quickbase-records-1"
    },
    {
      "name": "Prepare creation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json;return [{json:{[p.nameFieldId]:p.name,[p.ageFieldId]:p.initialAge}}];"
      },
      "id": "create-update-and-list-quickbase-records-2"
    },
    {
      "name": "Quick Base",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        650,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "create",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "columns": "unused",
        "simple": false,
        "options": {
          "useFieldIDs": true
        }
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-3"
    },
    {
      "name": "Confirm created record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,p=$('Set record details').first().json,id=r.data?.[0]?.['3']?.value,m=r.metadata;if(!Number.isSafeInteger(id)||id<=0||m?.createdRecordIds?.length!==1||m.createdRecordIds[0]!==id||Object.keys(m.lineErrors??{}).length)throw Error('Record creation not confirmed');return [{json:{'3':id,[p.ageFieldId]:p.updatedAge}}];"
      },
      "id": "create-update-and-list-quickbase-records-4"
    },
    {
      "name": "Quick Base1",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        1050,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "upsert",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "columns": "unused",
        "updateKey": "3",
        "mergeFieldId": "={{ 3 }}",
        "simple": false,
        "options": {
          "useFieldIDs": true
        }
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-5"
    },
    {
      "name": "Confirm updated record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,id=$('Confirm created record').first().json['3'],m=r.metadata,ids=[...(m?.updatedRecordIds??[]),...(m?.unchangedRecordIds??[])];if(r.data?.[0]?.['3']?.value!==id||ids.length!==1||ids[0]!==id||(m?.createdRecordIds??[]).length||Object.keys(m?.lineErrors??{}).length)throw Error('Same-record update not confirmed');return [{json:{id}}];"
      },
      "id": "create-update-and-list-quickbase-records-6"
    },
    {
      "name": "Quick Base2",
      "type": "n8n-nodes-base.quickbase",
      "position": [
        1250,
        300
      ],
      "parameters": {
        "resource": "record",
        "operation": "getAll",
        "tableId": "={{ $('Set record details').first().json.tableId }}",
        "returnAll": false,
        "limit": 50,
        "options": {}
      },
      "typeVersion": 1,
      "id": "create-update-and-list-quickbase-records-7"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
