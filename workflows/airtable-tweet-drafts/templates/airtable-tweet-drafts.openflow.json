    "modules": {
      "n_a045b1bf6cff44c7": {
        "name": "Choose hashtag",
        "imports": [],
        "source": "export default function chooseHashtag({ hashtags }) {\n  if (!Array.isArray(hashtags) || !hashtags.length || !hashtags.every((hashtag) => typeof hashtag === 'string' && /^#\\S+$/.test(hashtag))) {\n    throw new Error('hashtags must contain at least one hashtag');\n  }\n  return { hashtag: hashtags[Math.floor(Math.random() * hashtags.length)] };\n}\n"
      },
      "n_83c87dbeee2a663f": {
        "name": "Prepare Airtable draft",
        "imports": [],
        "source": "export default function airtableDraft({ hashtag, content }) {\n  if (typeof content !== 'string' || !content.trim()) throw new Error('The model returned no draft');\n  return { records: [{ fields: { Hashtag: hashtag, Content: content } }] };\n}\n"
      }
    }
