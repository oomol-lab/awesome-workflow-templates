          "value": "YOUR_AIRTABLE_TABLE_ID"
        },
        "options": {},
        "operation": "append",
        "application": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "authentication": "airtableTokenApi",
        "addAllFields": true
      },
      "typeVersion": 1,
      "id": "airtable-tweet-drafts-3"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.code",
      "position": [
        850,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const business = function airtableDraft({ hashtag, content }) {\n  if (typeof content !== \"string\" || !content.trim())\n    throw new Error(\"The model returned no draft\");\n  return { records: [{ fields: { Hashtag: hashtag, Content: content } }] };\n};\n\nreturn $input.all().map((item, index) => {\n  const result = business({\n    hashtag: $(\"FunctionItem\").itemMatching(index).json.hashtag,\n    content: item.json.message?.content,\n  });\n  return { json: result.records[0].fields, pairedItem: { item: index } };\n});\n"
      },
      "typeVersion": 2,
      "id": "airtable-tweet-drafts-4"
    }
