    {
      "name": "FunctionItem",
      "type": "n8n-nodes-base.code",
      "position": [
        450,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const business = function chooseHashtag({ hashtags }) {\n  if (\n    !Array.isArray(hashtags) ||\n    !hashtags.length ||\n    !hashtags.every((hashtag) => typeof hashtag === \"string\" && /^#\\S+$/.test(hashtag))\n  ) {\n    throw new Error(\"hashtags must contain at least one hashtag\");\n  }\n  return { hashtag: hashtags[Math.floor(Math.random() * hashtags.length)] };\n};\n\nreturn $input.all().map((item, index) => {\n  const result = business({ hashtags: [\"#techtwitter\", \"#n8n\"] });\n  return { json: result, pairedItem: { item: index } };\n});\n"
      },
      "typeVersion": 2,
      "id": "airtable-tweet-drafts-1"
    },
    {
      "name": "HTTP Request",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        650,
        300
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "content": "=Generate a tweet, with under 100 characters, about and including the hashtag {{ $json.hashtag }}:"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 64,
          "topP": 1
        }
      },
      "typeVersion": 1.8,
      "id": "airtable-tweet-drafts-2"
    },
