        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const filename = \"YOUR_ATTACHMENT_NAME.json\",\n  item = $input.first();\nif (filename.startsWith(\"YOUR_\")) throw Error(\"Configure the attachment filename\");\nconst found = Object.values(item.binary ?? {}).filter((x) => x.fileName === filename);\nif (found.length !== 1) throw Error(\"Expected exactly one matching attachment\");\nreturn [{ json: item.json, binary: { data: found[0] } }];\n"
      }
    }
