        "source": "import { Buffer } from \"node:buffer\";\nexport default function auth({ headers, expectedAuthorization }) {\n  const a =\n      typeof expectedAuthorization === \"string\"\n        ? /^Basic ([A-Za-z0-9+/]+={0,2})$/.exec(expectedAuthorization.trim())\n        : null,\n    secret = a ? Buffer.from(a[1], \"base64\").toString(\"utf8\") : \"\";\n  if (!/^[^:]+:.+$/.test(secret) || /[\\r\\n]/.test(secret))\n    throw Error(\"Configure webhook Basic authorization\");\n  const h = Object.entries(headers || {}).filter(([k]) => k.toLowerCase() === \"authorization\"),\n    m =\n      h.length === 1 && typeof h[0][1] === \"string\"\n        ? /^Basic +([A-Za-z0-9+/]+={0,2})$/i.exec(h[0][1].trim())\n        : null,\n    actual = m ? Buffer.from(m[1], \"base64\").toString(\"utf8\") : \"\";\n  let diff = secret.length ^ actual.length;\n  for (let i = 0; i < Math.max(secret.length, actual.length); i++)\n    diff |= (secret.charCodeAt(i) || 0) ^ (actual.charCodeAt(i) || 0);\n  return { ok: diff === 0 };\n}\n"
      },
      "n_7c3ca23e4b3128b4": {
        "name": "Reject the request",
        "imports": [],
        "source": "export default function reject() {\n  return { statusCode: 401, body: { error: \"Unauthorized\" } };\n}\n"
      },
      "n_5c5ec079303db229": {
        "name": "Read the organization",
        "imports": [],
        "source": "export default function inspect({ body, companyId, fieldKey }) {\n  if (\n    typeof companyId !== \"string\" ||\n    !/^\\d+$/.test(companyId) ||\n    typeof fieldKey !== \"string\" ||\n    !fieldKey.trim() ||\n    fieldKey.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure Pipedrive company and website field key\");\n  const m = body?.meta,\n    d = body?.data;\n  if (\n    !m ||\n    m.version !== \"2.0\" ||\n    m.entity !== \"organization\" ||\n    m.action !== \"create\" ||\n    String(m.company_id) !== companyId ||\n    !d ||\n    Number(m.entity_id) !== Number(d.id)\n  )\n    throw Error(\"Invalid organization event\");\n  const id = Number(d.id),\n    name = d.name,\n    url = d.custom_fields?.[fieldKey]?.value;\n  if (\n    !Number.isSafeInteger(id) ||\n    id <= 0 ||\n    typeof name !== \"string\" ||\n    !name.trim() ||\n    typeof url !== \"string\" ||\n    !/^https?:\\/\\//i.test(url) ||\n    /[\\r\\n]/.test(url)\n  )\n    throw Error(\"Organization requires a name and website URL\");\n  return { id, name, url };\n}\n"
      },
      "n_40da8e01bd2d0699": {
        "name": "Check website response",
        "imports": [],
        "source": "export default function page({ body, statusCode }) {\n  if (statusCode < 200 || statusCode >= 300 || typeof body !== \"string\" || !body.trim())\n    throw Error(\"Website scrape failed\");\n  return { html: body };\n}\n"
      },
      "n_e079defa75375b32": {
        "name": "Prepare the note and message",
        "imports": [],
        "source": "export default function note({ summary, id, name }) {\n  if (typeof summary !== \"string\" || !summary.trim()) throw Error(\"Empty summary\");\n  const e = (x) => x.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n  return {\n    body: { org_id: id, content: \"<p>\" + e(summary).replace(/\\n/g, \"<br>\") + \"</p>\" },\n    text: \"New organization \" + e(name) + \":\\n\\n\" + e(summary),\n  };\n}\n"
      },
      "n_c338fa95ef6bff14": {
        "name": "Confirm the note",
        "imports": [],
        "source": "export default function confirm({ body, statusCode, id }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    body?.success !== true ||\n    !body.data?.id ||\n    Number(body.data.org_id) !== id\n  )\n    throw Error(\"Pipedrive note not confirmed\");\n  return { ok: true };\n}\n"
      },
      "n_65c0065b454f2fed": {
        "name": "Acknowledge the event",
        "imports": [],
        "source": "export default function done() {\n  return { statusCode: 200, body: { status: \"processed\" } };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
