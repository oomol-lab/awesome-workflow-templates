    "modules": {
      "n_70d838782144fc20": {
        "name": "Check the temperature",
        "imports": [],
        "source": "export default function weatherAlert({weather}) {\n  const temp=weather?.main?.temp;\n  if(typeof temp!=='number'||!Number.isFinite(temp))throw new Error('OpenWeather response has no numeric temperature');\n  if(temp>=25)return {send:false,body:{}};\n  const lat=weather?.coord?.lat,lon=weather?.coord?.lon;\n  if(typeof lat!=='number'||!Number.isFinite(lat)||lat < -90||lat > 90||typeof lon!=='number'||!Number.isFinite(lon)||lon < -180||lon > 180)throw new Error('OpenWeather response has invalid coordinates');\n  return {send:true,body:{message:`Weather alert ❄️ Temperature: ${temp} °C`,title:'Weather Alert from n8n','X-S4-Location':`${lat},${lon}`,'X-S4-ExternalID':'weather-alert','X-S4-Status':'new','X-S4-SourceSystem':'n8n'}};\n}\n"
      }
    }
