    "modules": {
      "n_afcc72b477368f07": {
        "name": "Build the HTML file",
        "imports": [],
        "source": "export default function build({ values }) {\n  if (!Array.isArray(values)) throw Error(\"Expected sheet rows\");\n  const escape = (x) =>\n    String(x ?? \"\")\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  const rows = values.filter(Array.isArray);\n  let width = rows.reduce((n, r) => Math.max(n, r.length), 0);\n  const body = rows\n    .map(\n      (r, i) =>\n        \"<tr>\" +\n        Array.from({ length: width }, (_, j) =>\n          i === 0 ? \"<th>\" + escape(r[j]) + \"</th>\" : \"<td>\" + escape(r[j]) + \"</td>\",\n        ).join(\"\") +\n        \"</tr>\",\n    )\n    .join(\"\\n\");\n  return {\n    html:\n      '<!doctype html><html><head><meta charset=\"utf-8\"><title>Sheet</title></head><body><table>' +\n      body +\n      \"</table></body></html>\",\n  };\n}\n"
      }
