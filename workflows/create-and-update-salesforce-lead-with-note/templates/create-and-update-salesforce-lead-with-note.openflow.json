    "modules": {
      "n_83b56c422ec40b6d": {
        "name": "Create lead",
        "imports": [],
        "source": "export default async function ({ company, lastName }, ctx) {\n  if (!company.trim() || !lastName.trim()) throw Error(\"Enter a company and last name\");\n  const r = await ctx.actions.call(\"salesforce.create_record\", {\n    objectName: \"Lead\",\n    fields: { Company: company, LastName: lastName },\n  });\n  if (\n    r?.success !== true ||\n    typeof r.id !== \"string\" ||\n    !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(r.id)\n  )\n    throw Error(\"Lead creation not confirmed\");\n  return { id: r.id };\n}\n"
      },
      "n_a88bc7d0e8d7a3b3": {
        "name": "Update lead city",
        "imports": [],
        "source": "export default async function ({ id, city }, ctx) {\n  if (!city.trim()) throw Error(\"Enter a city\");\n  const r = await ctx.actions.call(\"salesforce.update_record\", {\n    objectName: \"Lead\",\n    recordId: id,\n    fields: { City: city },\n  });\n  if (r?.success !== true) throw Error(\"Lead update not confirmed\");\n  return { id };\n}\n"
      },
      "n_c6a885ebc93a8762": {
        "name": "Add lead note",
        "imports": [],
        "source": "export default async function ({ id, title }, ctx) {\n  if (!title.trim()) throw Error(\"Enter a note title\");\n  const r = await ctx.actions.call(\"salesforce.create_record\", {\n    objectName: \"Note\",\n    fields: { ParentId: id, Title: title },\n  });\n  if (\n    r?.success !== true ||\n    typeof r.id !== \"string\" ||\n    !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(r.id)\n  )\n    throw Error(\"Note creation not confirmed\");\n  return { noteId: r.id, leadId: id };\n}\n"
      }
    }
