    "modules": {
      "n_f77184c09eb6784f": {
        "name": "Configure server address",
        "imports": [],
        "source": "export default function endpoints({ base }) {\n  const root = base.replace(/\\/+$/, \"\");\n  if (!/^https?:\\/\\/[^/?#@\\s]+$/i.test(root)) throw new Error(\"Configure a ComfyUI base URL\");\n  return {\n    statsUrl: root + \"/system_stats\",\n    nodesUrl: root + \"/object_info\",\n    endpoints: {\n      prompt: \"POST \" + root + \"/prompt\",\n      history: \"GET \" + root + \"/history/{prompt_id}\",\n      queue: \"GET \" + root + \"/queue\",\n      system_stats: \"GET \" + root + \"/system_stats\",\n      view_image: \"GET \" + root + \"/view?filename={name}&type=output\",\n    },\n  };\n}\n"
      },
      "n_00e985fbe33e49b9": {
        "name": "Format status",
        "imports": [],
        "source": "export default function status({ stats, nodes, endpoints }) {\n  if (\n    !stats ||\n    typeof stats !== \"object\" ||\n    Array.isArray(stats) ||\n    !nodes ||\n    typeof nodes !== \"object\" ||\n    Array.isArray(nodes)\n  )\n    throw new Error(\"ComfyUI returned invalid data\");\n  return {\n    response: {\n      status: \"connected\",\n      comfyui: { system_stats: stats, available_nodes: Object.keys(nodes).length, endpoints },\n      message: \"ComfyUI is running and accessible.\",\n    },\n  };\n}\n"
      }
    }
