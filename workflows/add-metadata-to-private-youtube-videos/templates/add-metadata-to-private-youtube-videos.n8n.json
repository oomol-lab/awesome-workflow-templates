        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ $('Select stored private video').first().json.requestId }}"
            }
          ]
        },
        "operation": "update",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "private-video-34"
    }
  ],
