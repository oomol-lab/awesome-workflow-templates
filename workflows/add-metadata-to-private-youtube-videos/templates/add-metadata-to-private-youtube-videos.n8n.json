        "operation": "deleteFile"
      },
      "typeVersion": 3,
      "onError": "continueErrorOutput"
    },
    {
      "name": "Confirm source deletion",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
