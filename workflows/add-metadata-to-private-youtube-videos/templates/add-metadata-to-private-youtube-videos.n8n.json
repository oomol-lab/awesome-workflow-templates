        "resource": "video",
        "operation": "update",
        "videoId": "={{ $('Select stored private video').first().json.videoId }}",
        "title": "={{ $json.title }}",
        "categoryId": "25",
        "regionCode": "DE",
        "updateFields": {
          "tags": "={{ $json.tags.join(\",\") }}",
          "description": "={{ $json.description }}",
          "privacyStatus": "private"
        }
      },
      "typeVersion": 1
    },
