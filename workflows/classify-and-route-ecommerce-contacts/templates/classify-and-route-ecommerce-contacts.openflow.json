    "modules": {
      "n_03b87d703b32b8bb": {
        "name": "Read message",
        "imports": [],
        "source": "export default function f({ body }) {\n  if (!body.message) throw Error(\"Missing message\");\n  return { message: body.message };\n}\n"
      },
      "n_efc75e8ce493e85e": {
        "name": "Read category",
        "imports": [],
        "source": "export default function f({ analysis }) {\n  return { category: analysis.category };\n}\n"
      },
      "n_8ebe6454af8c1717": {
        "name": "Reserve department email",
        "imports": [],
        "source": "export default async function plan(\n  { body, category, quote, product, general, order, other, acknowledge, resolution },\n  ctx,\n) {\n  const routes = {\n    \"Request Quote\": quote,\n    \"Product info\": product,\n    \"General problem\": general,\n    Order: order,\n    Other: other,\n  };\n  if (!body?.submissionId || !body?.name || !body?.email || !body?.message)\n    throw Error(\"Missing submission\");\n  const to = routes[category];\n  if (\n    !to ||\n    to.includes(\"YOUR_\") ||\n    !/^\\S+@\\S+\\.\\S+$/.test(to) ||\n    !/^\\S+@\\S+\\.\\S+$/.test(body.email) ||\n    /[\\r\\n]/.test(to + body.email)\n  )\n    throw Error(\"Configure valid recipient and reply address\");\n  const key = \"contact:\" + body.submissionId + \":email\",\n    old = await ctx.state.get(key),\n    skip = {\n      key,\n      write: false,\n      to: old?.to || to,\n      category: old?.category || category,\n      request: {},\n    };\n  if (old?.status === \"done\") return skip;\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending email \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { ...old, status: \"done\" });\n      return skip;\n    }\n  }\n  const mime =\n    \"To: \" +\n    to +\n    \"\\r\\nReply-To: \" +\n    body.email +\n    \"\\r\\nSubject: Contact form \" +\n    category +\n    \"\\r\\nMIME-Version: 1.0\\r\\nContent-Type: text/plain; charset=UTF-8\\r\\nContent-Transfer-Encoding: base64\\r\\n\\r\\n\";\n  function enc(bytes) {\n    const alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\",\n      a = [];\n    for (let i = 0; i < bytes.length; i += 3) {\n      const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);\n      a.push(\n        alphabet[(n >> 18) & 63],\n        alphabet[(n >> 12) & 63],\n        i + 1 < bytes.length ? alphabet[(n >> 6) & 63] : \"=\",\n        i + 2 < bytes.length ? alphabet[n & 63] : \"=\",\n      );\n    }\n    return a.join(\"\");\n  }\n  const text = \"Name: \" + body.name + \"\\nEmail: \" + body.email + \"\\n\\nMessage:\\n\" + body.message,\n    raw = enc(new TextEncoder().encode(mime + enc(new TextEncoder().encode(text))))\n      .replace(/\\+/g, \"-\")\n      .replace(/\\//g, \"_\")\n      .replace(/=+$/, \"\");\n  await ctx.state.set(key, { status: \"pending\", to, category });\n  return { key, write: true, to, category, request: { raw } };\n}\n"
      },
      "n_7c2928e003cf4174": {
        "name": "Confirm department email",
        "imports": [],
        "source": "export default async function f({ key, body }, ctx) {\n  if (!body?.id) throw Error(\"Unknown email delivery\");\n  const old = await ctx.state.get(key);\n  await ctx.state.set(key, { ...old, status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_d9fdbab88d07663e": {
        "name": "Reserve contact row",
        "imports": [],
        "source": "export default async function plan(\n  { body, category, to, spreadsheetId, range, acknowledge, resolution },\n  ctx,\n) {\n  if (!spreadsheetId || spreadsheetId.includes(\"YOUR_\") || !range)\n    throw Error(\"Configure spreadsheet\");\n  const key = \"contact:\" + body.submissionId + \":sheet\",\n    old = await ctx.state.get(key),\n    result = {\n      key,\n      write: false,\n      spreadsheetId,\n      range,\n      values: [[body.submittedAt, body.name, body.email, body.message, category, to]],\n    };\n  if (old?.status === \"done\") return result;\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending sheet \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return result;\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ...result, write: true };\n}\n"
      },
      "n_b588b6a7529c1f30": {
        "name": "Confirm contact row",
        "imports": [],
        "source": "export default async function f({ key, updatedRows }, ctx) {\n  if (!updatedRows) throw Error(\"Unknown sheet result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_b6f4233fd5761fd4": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
