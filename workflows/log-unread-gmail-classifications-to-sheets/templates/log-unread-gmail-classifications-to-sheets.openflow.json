      "n_2a0483811fe08b28": {
        "name": "Choose the next email",
        "imports": [],
        "source": "export default function next({ events, previous }) {\n  const s = previous ?? { index: 0 };\n  if (!Array.isArray(events)) throw Error(\"Invalid Gmail events\");\n  if (s.index >= events.length) return { state: s, more: false, messageId: \"\", context: \"\" };\n  const e = events[s.index];\n  if (!e || typeof e.messageId !== \"string\" || !e.messageId)\n    throw Error(\"Missing Gmail message ID\");\n  return {\n    state: { index: s.index + 1 },\n    more: true,\n    messageId: e.messageId,\n    context: JSON.stringify(e),\n  };\n}\n"
      },
      "n_3f4a593e9473ab79": {
        "name": "Prepare the email excerpt",
        "imports": [],
        "source": "export default function prepare({ messageId, actualId, from, subject, date, body }) {\n  if (messageId !== actualId) throw Error(\"Message association failed\");\n  const m = from.match(/([^\\s<>\"(),;:]+@[^\\s<>\"(),;:]+)/);\n  if (!m) throw Error(\"The message has no usable sender address\");\n  const parsed = new Date(date),\n    normalizedDate = Number.isNaN(parsed.getTime()) ? \"\" : parsed.toISOString();\n  return {\n    from: m[1],\n    subject,\n    date: normalizedDate,\n    excerpt: body.slice(0, 500),\n    prompt: \"From: \" + from + \"\\nSubject: \" + subject + \"\\n\\n\" + body.slice(0, 500),\n  };\n}\n"
      },
      "n_ad5eccc7df9d6ae8": {
        "name": "Prepare the spreadsheet row",
        "imports": [],
        "source": "export default function row({ from, subject, date, classification }) {\n  const category = classification?.category,\n    summary = classification?.summary;\n  if (\n    ![\"urgent\", \"important\", \"informational\", \"spam\"].includes(category) ||\n    typeof summary !== \"string\" ||\n    !summary.trim()\n  )\n    throw Error(\"Model response did not contain a valid category and summary\");\n  return { values: [[date, from, subject, category, summary]] };\n}\n"
      }
    }
