    "modules": {
      "n_30a1bcb05254c3a2": {
        "name": "Prepare the next event",
        "imports": [],
        "source": "export default function eventsNext({ body, previousState }) {\n  if (!Array.isArray(body)) throw Error(\"Expected event array\");\n  const index = previousState?.index ?? 0;\n  if (index === body.length) return { state: { index }, more: false, records: [{ fields: {} }] };\n  const e = body[index];\n  if (\n    !e ||\n    typeof e.id !== \"string\" ||\n    !e.id ||\n    ![\"sport_key\", \"sport_title\", \"commence_time\", \"home_team\", \"away_team\"].every(\n      (k) => typeof e[k] === \"string\",\n    )\n  )\n    throw Error(\"Incomplete event\");\n  return {\n    state: { index: index + 1 },\n    more: true,\n    records: [\n      {\n        fields: {\n          event_id: e.id,\n          sports_key: e.sport_key,\n          sport_title: e.sport_title,\n          commence_time: e.commence_time,\n          home_team: e.home_team,\n          away_team: e.away_team,\n        },\n      },\n    ],\n  };\n}\n"
      },
      "n_8037b371de0ce12b": {
        "name": "Collect event records",
        "imports": [],
        "source": "export default function collectImagePages({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  return {\n    state: {\n      records: [...state.records, ...records],\n      seen: offset === null ? state.seen : [...state.seen, offset],\n    },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_35e6ab90b8d25801": {
        "name": "Match the next score",
        "imports": [],
        "source": "export default function scoreNext({ body, pageState, previousState }) {\n  if (!Array.isArray(body) || !Array.isArray(pageState.records))\n    throw Error(\"Expected scores and records\");\n  const index = previousState?.index ?? 0;\n  if (index === body.length)\n    return {\n      state: { index },\n      more: false,\n      matched: false,\n      records: [{ id: \"unused\", fields: {} }],\n    };\n  const s = body[index];\n  if (typeof s?.id !== \"string\" || !s.id) throw Error(\"Missing event ID\");\n  const found = pageState.records.filter((r) => r?.fields?.event_id === s.id);\n  if (found.length > 1) throw Error(\"Duplicate event ID in Airtable\");\n  if (!found.length)\n    return {\n      state: { index: index + 1 },\n      more: true,\n      matched: false,\n      records: [{ id: \"unused\", fields: {} }],\n    };\n  if (typeof found[0].id !== \"string\") throw Error(\"Missing Airtable record ID\");\n  return {\n    state: { index: index + 1 },\n    more: true,\n    matched: true,\n    records: [\n      {\n        id: found[0].id,\n        fields: {\n          scores: JSON.stringify(s.scores),\n          completed: String(s.completed),\n          last_update: s.last_update ?? \"\",\n        },\n      },\n    ],\n  };\n}\n"
      }
    }
  },
