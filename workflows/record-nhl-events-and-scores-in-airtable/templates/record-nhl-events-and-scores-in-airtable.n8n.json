    {
      "id": "record-nhl-events-and-scores-in-airtable-7",
      "name": "Match scores to records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const records = $input.all().map((x) => x.json),\n  scores = $(\"Retrieve Sport Results Data At The End Of The Day\")\n    .all()\n    .map((x) => x.json),\n  out = [];\nfor (const s of scores) {\n  const matches = records.filter((r) => r.event_id === s.id);\n  if (matches.length > 1) throw Error(\"Duplicate event ID in Airtable\");\n  if (matches.length) {\n    const r = matches[0];\n    if (typeof r.id !== \"string\") throw Error(\"Missing Airtable record ID\");\n    out.push({\n      json: {\n        recordId: r.id,\n        scores: JSON.stringify(s.scores),\n        completed: String(s.completed),\n        last_update: s.last_update ?? \"\",\n      },\n    });\n  }\n}\nreturn out;\n"
      }
    },
