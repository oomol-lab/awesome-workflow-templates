    "modules": {
      "n_b8d78602a9b64fe8": {
        "name": "Validate the contact form",
        "imports": [],
        "source": "export default function validate({ body }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body)) throw Error(\"Expected form body\");\n  const keys = [\"first_name\", \"last_name\", \"email\", \"phone\", \"message\"],\n    result = {};\n  for (const key of keys) {\n    const v = body[key] ?? \"\";\n    if (typeof v !== \"string\" || v.length > 10000) throw Error(\"Invalid \" + key);\n    result[key] = v.trim();\n  }\n  if (\n    !result.message ||\n    !/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(result.email) ||\n    /[\\x00-\\x1f\\x7f]/.test(result.email)\n  )\n    throw Error(\"A valid email and message are required\");\n  return { ...result, formJson: JSON.stringify(result) };\n}\n"
      },
      "n_bfb109ccf33b155b": {
        "name": "Validate the draft and log row",
        "imports": [],
        "source": "export default function prepare({ result, first_name, last_name, email, phone, message }) {\n  if (\n    !result ||\n    ![\"Product Info\", \"Order Info\", \"Other request\"].includes(result.category) ||\n    typeof result.subject !== \"string\" ||\n    !result.subject.trim() ||\n    /[\\x00-\\x1f\\x7f]/.test(result.subject) ||\n    result.subject.length > 300 ||\n    typeof result.text !== \"string\" ||\n    !result.text.trim() ||\n    result.text.length > 40000\n  )\n    throw Error(\"Invalid generated draft\");\n  const subject = result.subject.trim(),\n    body =\n      result.text.trim() +\n      \"\\n\\n---\\n\\nFirst Name: \" +\n      first_name +\n      \"\\nLast Name: \" +\n      last_name +\n      \"\\nEmail: \" +\n      email +\n      \"\\nPhone: \" +\n      phone +\n      \"\\n\\nMessage:\\n\" +\n      message,\n    date = new Date().toISOString().slice(0, 10).split(\"-\").reverse().join(\"/\");\n  return {\n    to: email,\n    subject,\n    body,\n    values: [\n      [date, first_name, last_name, email, phone, message, result.category, result.text.trim()],\n    ],\n  };\n}\n"
      },
      "n_5f7fb9eb12cc49d3": {
        "name": "Confirm the draft",
        "imports": [],
        "source": "export default function confirm({ draftId, values }) {\n  if (typeof draftId !== \"string\" || !draftId.trim())\n    throw Error(\"Gmail did not confirm the draft\");\n  return { values };\n}\n"
      }
    }
  },
