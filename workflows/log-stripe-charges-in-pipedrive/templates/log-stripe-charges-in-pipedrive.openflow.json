    "modules": {
      "n_cfbaf048c5782aec": {
        "name": "Read the last run time",
        "imports": [],
        "source": "export default async function window(_input,context){const now=Math.floor(Date.now()/1000);let since=await context.state.get('last-charge-run');if(since==null){since=now;await context.state.set('last-charge-run',now)}if(!Number.isSafeInteger(since)||since<0||since>now)throw Error('Invalid saved charge watermark');return {since,until:now}}\n"
      },
      "n_59d3fc36e864bb23": {
        "name": "Collect a Stripe page",
        "imports": [],
        "source": "export default function page({since,until,previousState,response,statusCode}){let state=previousState??{charges:[],seen:[],page:null};if(!Array.isArray(state.charges)||!Array.isArray(state.seen))throw Error('Invalid charge-list progress');if(response!=null){if(statusCode<200||statusCode>=300||!Array.isArray(response.data)||typeof response.has_more!=='boolean')throw Error('Invalid Stripe list response');for(const c of response.data)if(!c||typeof c.id!=='string'||!c.id||!['succeeded','pending','failed'].includes(c.status))throw Error('Invalid Stripe charge');state={charges:state.charges.concat(response.data.filter(c=>c.status==='succeeded')),seen:state.seen,page:null};if(response.has_more){const token=response.data.at(-1)?.id;if(typeof token!=='string'||!token||state.seen.includes(token))throw Error('Invalid or repeated Stripe page');state.page=token;state.seen=state.seen.concat(token)}}return {state,more:response==null||state.page!==null,params:{'created[gte]':since,'created[lt]':until,limit:100,...(state.page?{starting_after:state.page}:{})},charges:state.charges}}\n"
      },
      "n_53a663f5a6219d69": {
        "name": "Choose the next charge",
        "imports": [],
        "source": "export default function next({charges,previousState,confirmed}){if(!Array.isArray(charges))throw Error('Invalid charges');let state=previousState??{index:0,written:0};if(previousState!=null){if(!confirmed||confirmed.success!==true)throw Error('Note not confirmed');state={index:state.index,written:state.written+1}}let index=state.index;while(index<charges.length){const x=charges[index++];if(!x||x.status!=='succeeded'||typeof x.id!=='string'||!Number.isSafeInteger(x.amount)||typeof x.currency!=='string'||!(x.description===null||typeof x.description==='string'))throw Error('Invalid Stripe charge');if(x.customer==null)throw Error('Charge has no Stripe customer');if(typeof x.customer!=='string'||!x.customer)throw Error('Invalid customer');return {state:{index,written:state.written},more:true,customerId:x.customer,charge:x,written:state.written}}return {state:{index,written:state.written},more:false,customerId:'unused',charge:{},written:state.written}}\n"
      },
      "n_ee0212b830bb1f74": {
        "name": "Read the customer name",
        "imports": [],
        "source": "export default function org({customer,charge}){if(!customer||customer.id!==charge.customer||customer.deleted===true||typeof customer.name!=='string'||!customer.name.trim())throw Error('Charge customer has no usable name');return {name:customer.name,charge}}\n"
      },
      "n_b72aebd96f7e22d0": {
        "name": "Prepare the charge note",
        "imports": [],
        "source": "export function chargeAmount(amount,currency){\n const supported='usd aed afn all amd ang aoa ars aud awg azn bam bbd bdt bif bhd bmd bnd bob brl bsd bwp byn bzd cad cdf chf clp cny cop crc cve czk djf dkk dop dzd egp etb eur fjd fkp gbp gel gip gmd gnf gtq gyd hkd hnl htg huf idr ils inr isk jmd jod jpy kes kgs khr kmf krw kwd kyd kzt lak lbp lkr lrd lsl mad mdl mga mkd mmk mnt mop mur mvr mwk mxn myr mzn nad ngn nio nok npr nzd omr pab pen pgk php pkr pln pyg qar ron rsd rub rwf sar sbd scr sek sgd shp sle sos srd std szl thb tjs tnd top try ttd twd tzs uah ugx uyu uzs vnd vuv wst xaf xcd xcg xof xpf yer zar zmw'.split(' '),zero='bif clp djf gnf jpy kmf krw mga pyg rwf vnd vuv xaf xof xpf'.split(' ');\n if(!Number.isSafeInteger(amount)||amount<0||typeof currency!=='string'||!supported.includes(currency))throw Error('Unsupported or invalid Stripe charge currency or amount');\n if((currency==='isk'||currency==='ugx')&&amount%100!==0)throw Error('Invalid Stripe special-currency amount');\n if(zero.includes(currency))return String(amount);\n const places=['bhd','jod','kwd','omr','tnd'].includes(currency)?3:2,digits=String(amount).padStart(places+1,'0');return digits.slice(0,-places)+'.'+digits.slice(-places);\n}\n\nexport default function note({items,nextCursor,charge}){if(nextCursor!=null&&nextCursor!=='')throw Error('More than one page of organization matches');if(!Array.isArray(items)||items.length!==1||!Number.isSafeInteger(items[0]?.item?.id))throw Error('Expected one exact organization match');const esc=s=>String(s??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('\"','&quot;').replaceAll(\"'\",'&#39;');return {body:{org_id:items[0].item.id,content:`${esc(charge.description)}: ${chargeAmount(charge.amount,charge.currency)} ${esc(charge.currency)}`}}}\n"
      },
      "n_3ea7c4811899e24f": {
        "name": "Confirm the note",
        "imports": [],
        "source": "export default function confirm({statusCode,body}){if(statusCode<200||statusCode>=300||!body||body.success!==true||!body.data||!Number.isSafeInteger(body.data.id))throw Error('Pipedrive did not confirm note');return {confirmed:{success:true}}}\n"
      },
      "n_f041535f152a1aaa": {
        "name": "Save the completed run",
        "imports": [],
        "source": "export default async function finish({written,until},context){if(!Number.isSafeInteger(written)||!Number.isSafeInteger(until))throw Error('Invalid charge run state');if(written>0)await context.state.set('last-charge-run',until);return {count:written}}\n"
      }
    }
