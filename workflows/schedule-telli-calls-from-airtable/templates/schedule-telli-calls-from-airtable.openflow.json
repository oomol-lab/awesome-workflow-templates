    "modules": {
      "n_976144f5b7c04be7": {
        "name": "Select next contact",
        "imports": [],
        "source": "export default function next({ events, previousState }) {\n  if (!Array.isArray(events)) throw Error(\"Invalid events\");\n  const index = previousState?.index ?? 0;\n  if (!Number.isInteger(index) || index < 0 || index > events.length)\n    throw Error(\"Invalid event index\");\n  if (index === events.length) return { state: { index }, more: false, id: \"unused\", count: index };\n  const id = events[index]?.recordId;\n  if (typeof id !== \"string\" || !id) throw Error(\"Missing automation record ID\");\n  return { state: { index: index + 1 }, more: true, id, count: index };\n}\n"
      },
      "n_3741350e2fd51ad4": {
        "name": "Prepare contact",
        "imports": [],
        "source": "export default function contact({ record, id }) {\n  const fields = record.fields || {};\n  if (!fields.phone_number || !fields.first_name || !fields.last_name)\n    throw Error(\"Missing first_name, last_name or phone_number\");\n  const body = { external_contact_id: id, phone_number: String(fields.phone_number) };\n  for (const key of [\n    \"first_name\",\n    \"last_name\",\n    \"email\",\n    \"salutation\",\n    \"timezone\",\n    \"external_url\",\n    \"contact_details\",\n  ])\n    if (fields[key] != null && fields[key] !== \"\") body[key] = fields[key];\n  return { body };\n}\n"
      },
      "n_3b3392ab0aa39638": {
        "name": "Prepare call",
        "imports": [],
        "source": "export default function schedule({ result, agentId }) {\n  if (typeof result?.contact_id !== \"string\" || !result.contact_id)\n    throw Error(\"No contact ID returned by telli\");\n  return { body: { contact_id: result.contact_id, agent_id: agentId } };\n}\n"
      }
    }
