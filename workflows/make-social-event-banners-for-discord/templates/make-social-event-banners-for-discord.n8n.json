      "position": [
        1320,
        0
      ],
      "parameters": {
        "prompt": "={{ $json.image_prompt }}",
        "options": {
          "size": "1024x1024",
          "quality": "standard"
        },
        "resource": "image"
      },
      "typeVersion": 1.3
    },
