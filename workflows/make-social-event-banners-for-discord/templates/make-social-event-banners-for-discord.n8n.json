      "position": [
        1100,
        0
      ],
      "parameters": {
        "files": {
          "values": [
            {
              "inputFieldName": "data"
            }
          ]
        },
        "content": "=📅 New Event Alert! {{ $('Set Parameters').item.json.title }} being held at {{ $('Set Parameters').item.json.location }} on the {{ $('Set Parameters').item.json.date }}! Don't miss it!",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GUILD_ID"
        },
        "options": {},
        "resource": "message",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CHANNEL_ID"
        },
        "sendTo": "channel"
