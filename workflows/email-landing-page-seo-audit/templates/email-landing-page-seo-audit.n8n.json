  "nodes": [
    {
      "id": "email-landing-page-seo-audit-0",
      "name": "Landing Page Url",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {},
        "formTitle": "Audit a landing page",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Landing Page Url",
              "placeholder": "https://yuzuu.co",
              "requiredField": true
            }
          ]
        },
        "formDescription": "Your Landing Page is Leaking Sales—Fix It Now"
      },
      "typeVersion": 2.2
    },
    {
      "name": "Prepare audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const url = String($json[\"Landing Page Url\"] || \"\");\nif (!/^https?:\\/\\//i.test(url)) throw Error(\"Use a public HTTP(S) URL\");\nreturn { json: { submissionId: $execution.id, url, mode: \"direct\" } };\n"
      },
      "id": "email-landing-page-seo-audit-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $('Prepare audit').first().json.mode === 'relay' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "email-landing-page-seo-audit-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Forward audit request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Prepare audit').first().json }}",
        "options": {}
      },
      "id": "email-landing-page-seo-audit-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Verify relay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status !== \"completed\") throw Error(\"Unknown relay result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "email-landing-page-seo-audit-4",
      "position": [
        880,
        0
      ]
    },
    {
      "id": "email-landing-page-seo-audit-5",
      "name": "Scrape Website",
      "type": "n8n-nodes-base.httpRequest",
