    "modules": {
      "n_8b11a9392ba83e19": {
        "name": "Validate page URL",
        "imports": [],
        "source": "export default function f({ body }) {\n  const u = new URL(body.url);\n  if (![\"http:\", \"https:\"].includes(u.protocol) || u.username || u.password)\n    throw Error(\"Use a public HTTP(S) URL\");\n  return { url: u.href };\n}\n"
      },
      "n_c6cbe350b4378829": {
        "name": "Read page HTML",
        "imports": [],
        "source": "export default function f({ body }) {\n  if (typeof body !== \"string\" || !body.trim()) throw Error(\"Empty page\");\n  return { html: body };\n}\n"
      },
      "n_e112e3118156069f": {
        "name": "Reserve audit email",
        "imports": [],
        "source": "export default async function plan({ body, technical, content, to, acknowledge, resolution }, ctx) {\n  const submissionId = String(body?.submissionId || ctx.runId || \"\").trim();\n  if (!submissionId || !body?.url || !technical || !content || !to || to.includes(\"YOUR_\"))\n    throw Error(\"Missing audit or recipient\");\n  const key = \"seo-audit:\" + submissionId + \":email\",\n    old = await ctx.state.get(key),\n    subject = \"On-Page SEO Audit - \" + body.url,\n    text =\n      \"# On-Page Technical Audit\\n\" + technical + \"\\n\\n# On-Page SEO Content Audit\\n\" + content,\n    skip = { key, send: false, to, subject, text };\n  if (old?.status === \"done\") return skip;\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending email \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return skip;\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ...skip, send: true };\n}\n"
      },
      "n_d295bee8fc2a90f8": {
        "name": "Confirm audit email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown Gmail result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    },
