    {
      "id": "notify-qualified-form-leads-in-slack-hunter",
      "name": "Validate Hunter result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"n8n Form Trigger\").item.json[\"What's your business email?\"];\nif (\n  typeof $json.email !== \"string\" ||\n  typeof e !== \"string\" ||\n  $json.email.toLowerCase() !== e.trim().toLowerCase() ||\n  ![\"valid\", \"invalid\", \"accept_all\", \"webmail\", \"disposable\", \"unknown\"].includes($json.status)\n)\n  throw Error(\"Incomplete Hunter assessment\");\nreturn { json: $json };\n"
      }
    },
    {
      "id": "notify-qualified-form-leads-in-slack-fit",
      "name": "Validate customer fit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function main({ body, email }) {\n  const fit = body?.properties?.customer_fit,\n    signals = fit?.top_signals_formated ?? fit?.top_signals_formatted;\n  if (\n    !fit ||\n    typeof fit.score !== \"number\" ||\n    !Number.isFinite(fit.score) ||\n    typeof signals !== \"string\"\n  )\n    throw Error(\"MadKudu returned an incomplete customer fit\");\n  if (typeof body.email !== \"string\" || body.email.toLowerCase() !== email.toLowerCase())\n    throw Error(\"MadKudu returned a different email\");\n  const optional = (v) => {\n    if (v == null) return \"\";\n    if (typeof v !== \"string\") throw Error(\"Invalid lead detail\");\n    return v.replaceAll(\"&\", \"&amp;\").replaceAll(\"<\", \"&lt;\").replaceAll(\">\", \"&gt;\");\n  };\n  const p = body.properties,\n    c = body.company?.properties ?? {},\n    l = c.location ?? {};\n  const text = `⭐ Got a hot lead for you  ${optional(p.first_name)} ${optional(p.last_name)} from  ${optional(c.name)} (${optional(c.domain)}) based out of ${optional(l.state)}, ${optional(l.country)}.\\n\\n\\n${optional(signals)}`;\n  if (text.length > 40000) throw Error(\"Slack message exceeds the size limit\");\n  return { score: fit.score, qualified: fit.score > 60, text };\n}\n\nreturn { json: main({ body: $json, email: $(\"Verify email with Hunter\").item.json.email }) };\n"
      }
    }
  ],
