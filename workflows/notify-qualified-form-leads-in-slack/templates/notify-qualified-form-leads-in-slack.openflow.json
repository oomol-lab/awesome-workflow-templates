    "modules": {
      "n_40963b3f85022ddc": {
        "name": "Validate email",
        "imports": [],
        "source": "export default function main({ body }) {\n  const email = body?.email;\n  if (typeof email !== \"string\" || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim()))\n    throw Error(\"Provide a valid email address\");\n  return { email: email.trim() };\n}\n"
      },
      "n_a565e06ef15f7838": {
        "name": "Check the verification",
        "imports": [],
        "source": "export default function main({ response, email }) {\n  const data = response?.data;\n  if (\n    !data ||\n    typeof data.status !== \"string\" ||\n    typeof data.email !== \"string\" ||\n    data.email.toLowerCase() !== email.toLowerCase()\n  )\n    throw Error(\"Hunter returned an incomplete or mismatched assessment\");\n  if (![\"valid\", \"invalid\", \"accept_all\", \"webmail\", \"disposable\", \"unknown\"].includes(data.status))\n    throw Error(\"Hunter returned an unexpected status\");\n  return { valid: data.status === \"valid\" };\n}\n"
      },
      "n_51a1e6a5ff09f595": {
        "name": "Check customer fit",
        "imports": [],
        "source": "export default function main({ body, email }) {\n  const fit = body?.properties?.customer_fit,\n    signals = fit?.top_signals_formated ?? fit?.top_signals_formatted;\n  if (\n    !fit ||\n    typeof fit.score !== \"number\" ||\n    !Number.isFinite(fit.score) ||\n    typeof signals !== \"string\"\n  )\n    throw Error(\"MadKudu returned an incomplete customer fit\");\n  if (typeof body.email !== \"string\" || body.email.toLowerCase() !== email.toLowerCase())\n    throw Error(\"MadKudu returned a different email\");\n  const optional = (v) => {\n    if (v == null) return \"\";\n    if (typeof v !== \"string\") throw Error(\"Invalid lead detail\");\n    return v.replaceAll(\"&\", \"&amp;\").replaceAll(\"<\", \"&lt;\").replaceAll(\">\", \"&gt;\");\n  };\n  const p = body.properties,\n    c = body.company?.properties ?? {},\n    l = c.location ?? {};\n  const text = `⭐ Got a hot lead for you  ${optional(p.first_name)} ${optional(p.last_name)} from  ${optional(c.name)} (${optional(c.domain)}) based out of ${optional(l.state)}, ${optional(l.country)}.\\n\\n\\n${optional(signals)}`;\n  if (text.length > 40000) throw Error(\"Slack message exceeds the size limit\");\n  return { score: fit.score, qualified: fit.score > 60, text };\n}\n"
      }
    }
