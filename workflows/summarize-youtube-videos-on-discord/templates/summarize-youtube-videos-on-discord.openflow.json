    "modules": {
      "n_cee655fc4fb5dd4a": {
        "name": "Validate video",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (\n    typeof body?.id !== \"string\" ||\n    !/^[A-Za-z0-9_-]{11}$/.test(body.id) ||\n    typeof body.title !== \"string\" ||\n    typeof body.link !== \"string\"\n  )\n    throw Error(\"Invalid video\");\n  return { id: body.id, title: body.title, link: body.link, request: { videoId: body.id } };\n}\n"
      },
      "n_c56102509ba869f4": {
        "name": "Read caption text",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body?.available === false) return { available: false, text: \"\" };\n  if (body?.available !== true || typeof body.text !== \"string\" || !body.text.trim())\n    throw Error(\"Invalid caption response\");\n  return { available: true, text: body.text };\n}\n"
      },
      "n_e6c70ca6e558c421": {
        "name": "Prepare Discord message",
        "imports": [],
        "source": "export default function ({ title, link, summary }) {\n  if (!summary.trim()) throw Error(\"Empty summary\");\n  return {\n    body: {\n      content:\n        \"🌟 New Video Alert! 🌟\\n\\n**\" +\n        title +\n        \"**\\n\\n*What’s it about?*\\n\\n\" +\n        summary +\n        \"\\n\\n[Watch NOW](\" +\n        link +\n        \") and remember to share your thoughts!\",\n    },\n  };\n}\n"
      },
      "n_72dc08feeb136aa5": {
        "name": "Reserve Discord post",
        "imports": [],
        "source": "export default async function ({ id }, ctx) {\n  const key = \"youtube-discord:\" + id,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect pending Discord post: \" + key);\n  if (s?.status === \"done\") return { key, send: false };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_564734da48b4d008": {
        "name": "Confirm Discord post",
        "imports": [],
        "source": "export default async function ({ key, body }, ctx) {\n  if (!body?.id) throw Error(\"Discord result unknown; use webhook URL with wait=true\");\n  await ctx.state.set(key, { status: \"done\", id: body.id });\n  return { ok: true };\n}\n"
      }
    }
