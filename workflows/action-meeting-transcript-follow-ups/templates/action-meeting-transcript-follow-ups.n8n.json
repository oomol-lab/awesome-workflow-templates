      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id) throw Error(\"Unknown calendar create outcome\");\nreturn { json: $json };\n"
