      ]
    },
    {
      "name": "Return existing event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "string",
              "value": "={{ $json.response }}"
            }
          ]
        },
        "options": {}
      },
      "id": "action-meeting-transcript-follow-ups-26",
      "position": [
        5720,
        0
      ]
    },
    {
      "name": "Validate calendar request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const q = $json.query;\nif (\n  !q ||\n  !q.title ||\n  !/(?:Z|[+-]\\d\\d:\\d\\d)$/.test(q.start) ||\n  !/(?:Z|[+-]\\d\\d:\\d\\d)$/.test(q.end) ||\n  !Number.isFinite(Date.parse(q.start)) ||\n  !Number.isFinite(Date.parse(q.end)) ||\n  Date.parse(q.end) <= Date.parse(q.start) ||\n  !Array.isArray(q.attendees) ||\n  q.attendees.some((x) => !x.email)\n)\n  throw Error(\"Invalid calendar event\");\nreturn { json: $json };\n"
      },
      "id": "action-meeting-transcript-follow-ups-27",
      "position": [
        5940,
        0
      ]
    }
