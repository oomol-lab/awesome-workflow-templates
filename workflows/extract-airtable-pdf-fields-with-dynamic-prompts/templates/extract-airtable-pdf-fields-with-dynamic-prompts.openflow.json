    "modules": {
      "n_f7b54fd5d6dddc8b": {
        "name": "Select next prompted field",
        "imports": [],
        "source": "export default function ({ fields, previous, answer }) {\n  if (!Array.isArray(fields)) throw Error(\"Expected fields\");\n  let i = previous?.i ?? 0,\n    updates = previous?.updates ?? {};\n  if (previous) {\n    if (typeof answer !== \"string\" || !answer.trim()) throw Error(\"Empty model output\");\n    updates = { ...updates, [fields[i - 1].name]: answer.trim() };\n  }\n  if (i >= fields.length)\n    return { state: { i, updates }, more: false, description: \"\", type: \"\", name: \"\" };\n  const f = fields[i];\n  if (\n    !f ||\n    typeof f.name !== \"string\" ||\n    !f.name ||\n    typeof f.description !== \"string\" ||\n    !f.description ||\n    typeof f.type !== \"string\" ||\n    !f.type\n  )\n    throw Error(\"Invalid field definition\");\n  return {\n    state: { i: i + 1, updates },\n    more: true,\n    description: f.description,\n    type: f.type,\n    name: f.name,\n  };\n}\n"
      },
      "n_2d1e936ec339d1e0": {
        "name": "Reserve record update",
        "imports": [],
        "source": "export default async function ({ baseId, tableId, recordId, eventId, updates }, ctx) {\n  if (\n    !/^app[A-Za-z0-9]+$/.test(baseId) ||\n    !/^tbl[A-Za-z0-9]+$/.test(tableId) ||\n    !/^rec[A-Za-z0-9]+$/.test(recordId) ||\n    !eventId ||\n    !Object.keys(updates).length\n  )\n    throw Error(\"Invalid record update\");\n  const key = \"airtable-pdf:\" + eventId + \":\" + tableId + \":\" + recordId,\n    prior = await ctx.state.get(key);\n  if (prior?.status === \"done\")\n    return { key, url: \"https://example.invalid\", body: {}, skip: true };\n  if (prior) throw Error(\"Prior record update unknown; inspect Airtable\");\n  await ctx.state.set(key, { status: \"pending\", updates });\n  return {\n    key,\n    url: \"https://api.airtable.com/v0/\" + baseId + \"/\" + tableId + \"/\" + recordId,\n    body: { fields: updates },\n    skip: false,\n  };\n}\n"
      },
      "n_a396e033efd6b2b4": {
        "name": "Confirm record update",
        "imports": [],
        "source": "export default async function ({ key, recordId, body }, ctx) {\n  if (!body || body.id !== recordId) throw Error(\"Missing record receipt\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { done: true };\n}\n"
      },
      "n_7325ce5e4fa01219": {
        "name": "Return row receipt",
        "imports": [],
        "source": "export default function () {\n  return { response: { done: true } };\n}\n"
      },
      "n_abbe58d972166c58": {
        "name": "Return completed receipt",
        "imports": [],
        "source": "export default function () {\n  return { done: true };\n}\n"
      }
    }
