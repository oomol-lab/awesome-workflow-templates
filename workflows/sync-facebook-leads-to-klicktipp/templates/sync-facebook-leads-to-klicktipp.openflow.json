    "modules": {
      "n_fa45b967da68d985": {
        "name": "Prepare lead page",
        "imports": [],
        "source": "export default function page({ formId, after }) {\n  const url = new URL(\"https://graph.facebook.com/v27.0/\" + encodeURIComponent(formId) + \"/leads\");\n  url.searchParams.set(\"fields\", \"id,created_time,field_data\");\n  url.searchParams.set(\"limit\", \"100\");\n  if (after) url.searchParams.set(\"after\", after);\n  return { url: url.toString(), marker: after || \"\" };\n}\n"
      },
      "n_bf101d138cea5daf": {
        "name": "Select next lead",
        "imports": [],
        "source": "export default async function next(\n  {\n    page,\n    marker,\n    previousState,\n    commentField,\n    courseField,\n    paymentField,\n    acknowledgeLeadId,\n    resolution,\n  },\n  context,\n) {\n  const saved = (await context.state.get(\"facebook-leads\")) ?? { initialized: false, ids: [] };\n  if (!Array.isArray(saved.ids)) throw Error(\"Invalid lead state\");\n  if (saved.pending) {\n    if (acknowledgeLeadId !== saved.pending || ![\"confirmed\", \"retry\"].includes(resolution))\n      throw Error(\"Inspect KlickTipp and resolve pending lead \" + saved.pending);\n    if (resolution === \"confirmed\" && !saved.ids.includes(saved.pending))\n      saved.ids.push(saved.pending);\n    saved.pending = null;\n    await context.state.set(\"facebook-leads\", saved);\n  }\n  if (!Array.isArray(page?.data)) throw Error(\"Meta leads response missing data\");\n  const index = previousState?.marker === marker ? previousState.index : 0;\n  if (!Number.isInteger(index) || index < 0 || index > page.data.length)\n    throw Error(\"Invalid lead index\");\n  if (index === page.data.length) {\n    const after = page.paging?.next ? page.paging?.cursors?.after : null;\n    if (page.paging?.next && (!after || after === marker)) throw Error(\"Invalid Meta page cursor\");\n    if (!after && !saved.initialized) {\n      saved.initialized = true;\n      await context.state.set(\"facebook-leads\", saved);\n    }\n    return {\n      state: { marker, index },\n      more: false,\n      process: false,\n      hasNext: !!after,\n      after: after || \"\",\n      leadId: \"\",\n      email: \"\",\n      fields: {},\n    };\n  }\n  const lead = page.data[index];\n  if (typeof lead?.id !== \"string\" || !lead.id || !Array.isArray(lead.field_data))\n    throw Error(\"Invalid Meta lead\");\n  const state = { marker, index: index + 1 };\n  if (!saved.initialized) {\n    if (!saved.ids.includes(lead.id)) {\n      saved.ids.push(lead.id);\n      await context.state.set(\"facebook-leads\", saved);\n    }\n    return {\n      state,\n      more: true,\n      process: false,\n      hasNext: false,\n      after: \"\",\n      leadId: lead.id,\n      email: \"\",\n      fields: {},\n    };\n  }\n  if (saved.ids.includes(lead.id))\n    return {\n      state,\n      more: true,\n      process: false,\n      hasNext: false,\n      after: \"\",\n      leadId: lead.id,\n      email: \"\",\n      fields: {},\n    };\n  const fields = Object.fromEntries(\n      lead.field_data.map((x) => [\n        x.name,\n        Array.isArray(x.values) ? String(x.values[0] ?? \"\") : \"\",\n      ]),\n    ),\n    name = fields[\"full name\"] ?? fields.full_name ?? \"\",\n    parts = name.trim().split(/\\s+/),\n    email = fields.email ?? \"\";\n  if (!email) throw Error(\"Lead has no email\");\n  return {\n    state,\n    more: true,\n    process: true,\n    hasNext: false,\n    after: \"\",\n    leadId: lead.id,\n    email,\n    fields: {\n      fieldFirstName: parts[0] ?? \"\",\n      fieldLastName: parts.at(-1) ?? \"\",\n      [commentField]: fields[\"hast_du_zusätzliche_kommentare_für_uns?\"] ?? \"\",\n      [courseField]: fields[\"welcher_kurs_interessiert_dich?\"] ?? \"\",\n      [paymentField]: fields[\"was_ist_deine_bevorzugte_zahlungsweise?\"] ?? \"\",\n    },\n  };\n}\n"
      },
      "n_9c85d8e4cd0fa81d": {
        "name": "Reserve lead",
        "imports": [],
        "source": "export default async function reserve({ leadId }, context) {\n  const saved = await context.state.get(\"facebook-leads\");\n  if (!saved || !Array.isArray(saved.ids) || saved.pending)\n    throw Error(\"Resolve the existing pending lead first\");\n  saved.pending = leadId;\n  await context.state.set(\"facebook-leads\", saved);\n  return { leadId };\n}\n"
      },
      "n_46d959ffc896bda6": {
        "name": "Remember lead",
        "imports": [],
        "source": "export default async function done({ leadId }, context) {\n  const saved = await context.state.get(\"facebook-leads\");\n  if (!saved || !Array.isArray(saved.ids) || saved.pending !== leadId)\n    throw Error(\"Pending lead mismatch\");\n  if (!saved.ids.includes(leadId)) saved.ids.push(leadId);\n  saved.pending = null;\n  await context.state.set(\"facebook-leads\", saved);\n  return { done: true };\n}\n"
      }
    }
  },
