    "modules": {
      "n_39674dd0147568ed": {
        "name": "Parse recent feed articles",
        "imports": [],
        "source": "export default function parseFeed({ body }) {\n  const xml = String(body ?? \"\");\n  const items = [];\n  const matches = xml.match(/<(item|entry)[\\s\\S]*?<\\/\\1>/gi) ?? [];\n  for (const raw of matches.slice(0, 20)) {\n    const pick = (tag) => {\n      const m = raw.match(new RegExp(\"<\" + tag + \"[^>]*>([\\\\s\\\\S]*?)<\\\\/\" + tag + \">\", \"i\"));\n      return m\n        ? m[1]\n            .replace(/<!\\[CDATA\\[([\\s\\S]*?)\\]\\]>/g, \"$1\")\n            .replace(/<[^>]+>/g, \" \")\n            .replace(/\\s+/g, \" \")\n            .trim()\n        : \"\";\n    };\n    const title = pick(\"title\");\n    if (title)\n      items.push({ title, summary: (pick(\"description\") || pick(\"summary\")).slice(0, 400) });\n  }\n  return { itemsJson: JSON.stringify(items), articleCount: items.length };\n}\n"
      }
    }
