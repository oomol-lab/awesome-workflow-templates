    "modules": {
      "n_0b74d84759355d21": {
        "name": "Validate image and channel",
        "imports": [],
        "source": "export default function configure({ fileUrl, filename, channelId }) {\n  for (const [name, value] of Object.entries({ fileUrl, filename, channelId }))\n    if (typeof value !== \"string\" || !value.trim() || value.includes(\"YOUR_\"))\n      throw Error(\"Configure \" + name + \" before uploading\");\n  let url;\n  try {\n    url = new URL(fileUrl);\n  } catch {\n    throw Error(\"Enter a public HTTPS file URL\");\n  }\n  if (url.protocol !== \"https:\" || url.username || url.password)\n    throw Error(\"Enter a public HTTPS file URL\");\n  return { fileUrl: url.toString(), filename: filename.trim(), channelId: channelId.trim() };\n}\n"
      }
    }
