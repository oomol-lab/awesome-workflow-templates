    "modules": {
      "n_7378bf1d6807375b": {
        "name": "Select new matching entries",
        "imports": [],
        "source": "export function selectEvents({body,arrayField,filterField,filterValues,timestampField,lastTs}) {\n  if(!body||typeof body!=='object'||Array.isArray(body))throw new Error('The feed must return a JSON object.');\n  if([arrayField,filterField,timestampField].some(value=>typeof value!=='string'||!value))throw new Error('Configure the feed field names.');\n  if(!Array.isArray(filterValues)||filterValues.some(value=>typeof value!=='string'))throw new Error('filterValues must be an array of strings.');\n  if(typeof lastTs!=='string')throw new Error('The saved timestamp must be a string.');\n  const raw=body[arrayField]??[];\n  if(!Array.isArray(raw))throw new Error('The configured feed array must be an array.');\n  const eligible=[];\n  for(const entry of raw){\n    if(!entry||typeof entry!=='object'||Array.isArray(entry))throw new Error('Feed entries must be objects.');\n    if(filterValues.length&&!filterValues.includes(entry[filterField]))continue;\n    const value=entry[timestampField];\n    if(value!=null&&typeof value!=='string'&&!(typeof value==='number'&&Number.isFinite(value)))throw new Error('Feed timestamps must be comparable strings or finite numbers.');\n    const timestamp=value==null?'':String(value);\n    if(timestamp>lastTs)eligible.push({entry,timestamp});\n  }\n  eligible.sort((a,b)=>a.timestamp<b.timestamp?-1:a.timestamp>b.timestamp?1:0);\n  const escape=text=>text.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');\n  const notifications=eligible.map(({entry,timestamp})=>{\n    const rawText='🔔 '+(entry[filterField]||'evento')+'\\n'+JSON.stringify(entry).slice(0,300);\n    const text=escape(rawText);\n    if(!text||text.length>4096)throw new Error('A Telegram alert exceeds 4096 characters.');\n    return {text,timestamp};\n  });\n  return {notifications,count:notifications.length,nextTimestamp:eligible.at(-1)?.timestamp??lastTs};\n}\n\nexport default async function selectFeedEvents(input,context) {\n  const previous=await context.state.get(input.stateKey);\n  return selectEvents({...input,lastTs:previous??''});\n}\n"
      },
      "n_92d21094e406faa9": {
        "name": "Send Telegram alerts",
        "imports": [],
        "source": "export default async function sendFeedAlerts({notifications,chatId},context) {\n  let sent=0;\n  for(const {text} of notifications){\n    await context.actions.telegram.send_message({chatId,text,parseMode:'HTML'});\n    sent++;\n  }\n  return {sent};\n}\n"
      },
      "n_4ff82bd7556f2722": {
        "name": "Save successful watermark",
        "imports": [],
        "source": "export default async function commitFeedWatermark({stateKey,nextTimestamp,count,sent},context) {\n  if(sent!==count)throw new Error('Do not advance the watermark before all notifications succeed.');\n  if(count)await context.state.set(stateKey,nextTimestamp);\n  return {sent,watermark:nextTimestamp};\n}\n"
      }
