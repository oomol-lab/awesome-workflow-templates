    "modules": {
      "n_4489d7517715b5e4": {
        "name": "Prepare the release document",
        "imports": [],
        "source": "export default function prepare({event,collectionId,parentDocumentId}){if(!event||event.object_kind!=='release'||!['create','update','delete'].includes(event.action))throw Error('Invalid GitLab release event');if(event.action!=='create')return{publish:false,body:{}};if(typeof event.name!=='string'||!event.name.trim()||typeof event.url!=='string'||!/^https?:\\/\\/\\S+$/i.test(event.url))throw Error('Invalid GitLab release');if(typeof collectionId!=='string'||!collectionId.trim()||collectionId.startsWith('YOUR_'))throw Error('Configure the Outline collection ID');if(typeof parentDocumentId!=='string'||parentDocumentId.startsWith('YOUR_'))throw Error('Configure or clear the parent document ID');const description=event.description==null?'':event.description;if(typeof description!=='string')throw Error('Invalid release description');return{publish:true,body:{collectionId,...(parentDocumentId.trim()?{parentDocumentId:parentDocumentId.trim()}:{}),publish:true,title:'Release '+event.name,text:description+'\\n\\n\\\\\\n[More info]('+event.url+')'}}}\n"
      },
      "n_824f42080b023899": {
        "name": "Confirm the document",
        "imports": [],
        "source": "export default function confirm({body,statusCode}){if(statusCode<200||statusCode>=300||!body||body.ok===false||typeof body.data?.id!=='string'||!body.data.id)throw Error('Outline document was not confirmed; inspect before retry');return{document:body.data}}\n"
      }
