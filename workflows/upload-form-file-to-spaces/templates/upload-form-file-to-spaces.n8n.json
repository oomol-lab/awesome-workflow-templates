{
  "name": "Upload a Form File to Spaces",
  "tags": [
    {
      "id": "6YbZxCb4ODJ2Rmva",
      "name": "admin",
      "createdAt": "2024-12-01T14:18:53.184Z",
      "updatedAt": "2024-12-01T14:18:53.184Z"
    }
  ],
  "nodes": [
    {
      "id": "upload-form-file-to-spaces-0",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        200,
        340
      ],
      "parameters": {
        "options": {},
        "formTitle": "Upload File",
        "formFields": {
          "values": [
            {
              "fieldType": "file",
              "fieldLabel": "File to Upload",
              "requiredField": true,
              "multipleFiles": false
            }
          ]
        },
        "formDescription": "Upload the file to the public storage area"
      },
      "typeVersion": 2.2
    },
    {
      "id": "upload-form-file-to-spaces-1",
      "name": "S3",
      "type": "n8n-nodes-base.s3",
      "position": [
        360,
        340
      ],
      "parameters": {
        "fileName": "={{ $json['File to Upload'].filename }}",
        "operation": "upload",
        "bucketName": "YOUR_SPACE_NAME",
        "additionalFields": {
          "acl": "publicRead"
        },
        "binaryPropertyName": "File_to_Upload"
      },
      "typeVersion": 1
    },
    {
      "id": "upload-form-file-to-spaces-2",
      "name": "Form",
      "type": "n8n-nodes-base.form",
      "position": [
        540,
        340
      ],
      "parameters": {
        "options": {},
        "operation": "completion",
        "completionTitle": "Your file path is below!",
        "completionMessage": "={{ 'https://YOUR_SPACE.YOUR_REGION.cdn.digitaloceanspaces.com/' + encodeURIComponent($('On form submission').item.json['File to Upload'].filename) }}"
      },
      "typeVersion": 1
    },
    {
      "id": "upload-form-file-to-spaces-mode",
      "name": "Execution mode",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        430,
        550
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mode",
              "name": "executionMode",
              "type": "string",
              "value": "n8n"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "upload-form-file-to-spaces-choice",
      "name": "Use Open Flow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        590,
        550
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.executionMode }}",
              "operation": "equal",
              "value2": "openflow"
            }
          ]
        }
      }
    },
    {
      "id": "upload-form-file-to-spaces-relay",
      "name": "Get Open Flow link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        800
      ],
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($('On form submission').item.json)} }}",
        "options": {}
      }
    },
    {
      "id": "upload-form-file-to-spaces-relay-form",
      "name": "Open Flow completion",
      "type": "n8n-nodes-base.form",
      "position": [
        1030,
        800
      ],
      "parameters": {
        "options": {},
        "operation": "completion",
        "completionTitle": "Your file path is below!",
        "completionMessage": "={{ $json.url }}"
      },
      "typeVersion": 1
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "S3": {
      "main": [
        [
          {
            "node": "Execution mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On form submission": {
      "main": [
        [
          {
            "node": "S3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execution mode": {
      "main": [
        [
          {
            "node": "Use Open Flow?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Use Open Flow?": {
      "main": [
        [
          {
            "node": "Get Open Flow link",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Form",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Open Flow link": {
      "main": [
        [
          {
            "node": "Open Flow completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
