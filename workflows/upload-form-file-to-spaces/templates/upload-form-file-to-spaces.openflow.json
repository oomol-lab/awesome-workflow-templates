      "n_eaafae8f636b18de": {
        "name": "Build CDN link",
        "imports": [],
        "source": "export default function link({ body, cdnBase }) {\n  const event = JSON.parse(body.event),\n    file = event[\"File to Upload\"];\n  if (!file?.filename) throw Error(\"The submitted file has no filename\");\n  return {\n    response: { url: cdnBase.replace(/\\/$/, \"\") + \"/\" + encodeURIComponent(file.filename) },\n  };\n}\n"
      }
