    "modules": {
      "n_1828040eac8cade2": {
        "name": "Run SuiteQL",
        "imports": [],
        "source": "export default async function suiteql({ query }, context) {\n  const sql = query?.suiteql;\n  if (typeof sql !== \"string\" || !sql.trim()) throw Error(\"Provide the suiteql query parameter\");\n  let rows = [],\n    offset = 0;\n  while (rows.length < 100) {\n    const { result } = await context.actions.call(\"netsuite.run_suiteql\", {\n      query: sql,\n      limit: 100 - rows.length,\n      offset,\n    });\n    if (!result || !Array.isArray(result.items)) throw Error(\"Invalid SuiteQL response\");\n    rows.push(...result.items.slice(0, 100 - rows.length));\n    if (!result.hasMore || rows.length >= 100) break;\n    if (!result.items.length) throw Error(\"SuiteQL pagination did not advance\");\n    offset += result.items.length;\n  }\n  return { rows };\n}\n"
      }
    }
  },
