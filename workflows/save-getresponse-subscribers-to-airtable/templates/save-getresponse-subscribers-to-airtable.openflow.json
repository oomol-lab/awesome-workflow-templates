    "modules": {
      "n_84d214e377c48e47": {
        "name": "Select campaign",
        "imports": [],
        "source": "export default function filter({ query, campaignId }) {\n  return { accepted: query?.action === \"subscribe\" && query?.CAMPAIGN_ID === campaignId };\n}\n"
      },
      "n_85d5e0f2c9fd2a2f": {
        "name": "Prepare subscriber",
        "imports": [],
        "source": "export default function map({ query }) {\n  if (typeof query.contact_email !== \"string\" || !query.contact_email)\n    throw Error(\"Missing contact email\");\n  return {\n    records: [\n      {\n        fields: {\n          Name: typeof query.contact_name === \"string\" ? query.contact_name : \"\",\n          Email: query.contact_email,\n        },\n      },\n    ],\n  };\n}\n"
      }
