    "modules": {
      "n_8ac92395d73cbac0": {
        "name": "Collect collection pages",
        "imports": [],
        "source": "export default function collect({previousState,items,nextStart,totalResults}){\n const p=previousState??{start:0,pages:0,items:[]};\n if(p.pages===0&&items==null)return {state:{...p,pages:-1},more:true,start:0,items:[]};\n if(!Array.isArray(items)||!Number.isInteger(totalResults)||totalResults<0)throw Error('Invalid Zotero page');\n const rows=[...p.items,...items];if(rows.length>10000)throw Error('Zotero collection exceeds 10,000 items');\n if(nextStart!=null&&(!Number.isInteger(nextStart)||nextStart<=p.start||p.pages>=98))throw Error('Invalid or excessive Zotero pagination');\n const projected=rows.map(x=>{if(!x||typeof x.key!=='string'||!x.key)throw Error('Missing Zotero item key');return{key:x.key,title:typeof x.data?.title==='string'?x.data.title:'',creatorSummary:typeof x.meta?.creatorSummary==='string'?x.meta.creatorSummary:''}});\n return {state:{start:nextStart??p.start,pages:p.pages+1,items:rows},more:nextStart!=null,start:nextStart??0,items:projected};\n}\n"
      }
