    "modules": {
      "n_2391abdd2495506a": {
        "name": "Map every email",
        "imports": [],
        "source": "export default function map({ values }) {\n  if (!Array.isArray(values)) throw Error(\"Expected sheet rows\");\n  if (!values.length) return { rows: [] };\n  const i = values[0].indexOf(\"email\");\n  if (i < 0) throw Error(\"Expected email header\");\n  const rows = [];\n  for (const cells of values.slice(1)) {\n    if (!cells.some((x) => x !== \"\" && x != null)) continue;\n    const email = String(cells[i] ?? \"\");\n    if (!email) throw Error(\"Every row needs an email address\");\n    rows.push([email]);\n  }\n  return { rows };\n}\n"
      },
      "n_798f22d49efed84d": {
        "name": "Prepare next batch",
        "imports": [],
        "source": "export default function next({ rows, previousState, body }) {\n  if (!Array.isArray(rows)) throw Error(\"Expected complete rows\");\n  let state;\n  if (previousState == null) state = { offset: 0, files: [] };\n  else {\n    if (!body || body.success !== true || typeof body.file !== \"string\" || !body.file)\n      throw Error(\"Icypeas did not confirm batch; it may have been submitted\");\n    state = {\n      offset: previousState.offset + previousState.size,\n      files: [...previousState.files, body.file],\n    };\n  }\n  const batch = rows.slice(state.offset, state.offset + 5000),\n    more = batch.length > 0;\n  state.size = batch.length;\n  return {\n    state,\n    more,\n    body: { name: \"dernierTsfg\", task: \"email-verification\", data: batch },\n    files: state.files,\n  };\n}\n"
      }
    }
