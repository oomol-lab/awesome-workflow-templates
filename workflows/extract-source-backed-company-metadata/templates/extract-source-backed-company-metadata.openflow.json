        "source": "export default async function ({ domain, requestId }, ctx) {\n  domain = String(domain || \"\")\n    .trim()\n    .toLowerCase();\n  const parts = domain.split(\".\"),\n    rx = /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/;\n  if (\n    domain.length > 253 ||\n    parts.length < 2 ||\n    parts.some((x) => x.length > 63 || !rx.test(x)) ||\n    !/^[a-z]{2,63}$/.test(parts.at(-1)) ||\n    !requestId.trim()\n  )\n    throw Error(\"Provide a bare domain and unique request ID\");\n  const key = \"company-metadata:\" + requestId,\n    s = await ctx.state.get(key);\n  if (s && s.domain !== domain) throw Error(\"Request ID belongs to another domain\");\n  if (s && !s.runId) throw Error(\"Actor start outcome unknown; inspect Apify before retry\");\n  if (s)\n    return {\n      key,\n      domain,\n      runId: s.runId,\n      start: false,\n      body: { domain, integrationSource: \"n8n-github-c9\" },\n    };\n  await ctx.state.set(key, { domain, status: \"start-pending\" });\n  return {\n    key,\n    domain,\n    runId: \"pending\",\n    start: true,\n    body: { domain, integrationSource: \"n8n-github-c9\" },\n  };\n}\n"
      },
      "n_2ba9e91cc54aaa65": {
        "name": "Record Actor run ID",
        "imports": [],
        "source": "export default async function ({ key, domain, body }, ctx) {\n  const id = body?.data?.id;\n  if (typeof id !== \"string\" || !id) throw Error(\"Unknown Actor start outcome; inspect Apify\");\n  await ctx.state.set(key, { domain, status: \"running\", runId: id });\n  return { runId: id };\n}\n"
      },
      "n_5a254b02481fb843": {
        "name": "Select Actor run",
        "imports": [],
        "source": "export default function ({ fresh, existing }) {\n  return { runId: fresh || existing };\n}\n"
      },
      "n_4d4e83a9ae3eba7e": {
        "name": "Check Actor status",
        "imports": [],
        "source": "export default function ({ run, runId, previous }) {\n  if (run?.id !== runId) throw Error(\"Actor run ID mismatch\");\n  if ([\"FAILED\", \"ABORTED\", \"TIMED-OUT\"].includes(run.status))\n    throw Error(\"Actor failed: \" + run.status);\n  const count = (previous?.count || 0) + 1;\n  if (count > 20) throw Error(\"Actor still running; resume this request later\");\n  if (run.status === \"SUCCEEDED\" && !run.defaultDatasetId) throw Error(\"Missing dataset\");\n  return {\n    state: { count },\n    done: run.status === \"SUCCEEDED\",\n    datasetId: run.defaultDatasetId || \"pending\",\n  };\n}\n"
      },
      "n_42b1cc74d2975d62": {
        "name": "Validate metadata provenance",
        "imports": [],
        "source": "export default function ({ items, domain }) {\n  if (!Array.isArray(items) || items.length !== 1) throw Error(\"Expected one metadata item\");\n  const x = items[0];\n  if (\n    x?.success !== true ||\n    x.domain !== domain ||\n    x.integrationSource !== \"n8n-github-c9\" ||\n    x.provenance?.method !== \"website_metadata_scrape\"\n  )\n    throw Error(\"Metadata does not match domain or provenance\");\n  return { result: x };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
