      "id": "extract-source-backed-company-metadata-1",
      "name": "Set company domain"
    },
    {
      "parameters": {
        "jsCode": "const domain = String($json.domain || \"\")\n  .trim()\n  .toLowerCase();\nif (\n  domain.length > 253 ||\n  !domain.includes(\".\") ||\n  domain.includes(\"://\") ||\n  domain.includes(\"/\") ||\n  domain.includes(\":\") ||\n  domain.includes(\" \") ||\n  domain.startsWith(\".\") ||\n  domain.endsWith(\".\") ||\n  domain.includes(\"..\")\n) {\n  throw new Error(\"Use one bare company domain, for example example.com\");\n}\nconst labels = domain.split(\".\");\nconst labelPattern = /^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$/;\nif (\n  labels.some((label) => label.length < 1 || label.length > 63 || !labelPattern.test(label)) ||\n  !/^[A-Za-z]{2,63}$/.test(labels.at(-1))\n) {\n  throw new Error(\"The company domain is invalid\");\n}\nif (!$json.requestId || $json.requestId.startsWith(\"YOUR_\")) throw Error(\"Configure request ID\");\nreturn [{ json: { domain, integrationSource: \"n8n-github-c9\", requestId: $json.requestId } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "extract-source-backed-company-metadata-2",
      "name": "Validate domain"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/vivid_astronaut~company-enrichment/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxItems",
              "value": "1"
            },
            {
              "name": "maxTotalChargeUsd",
              "value": "0.02"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({domain:$(\"Validate domain\").first().json.domain,integrationSource:\"n8n-github-c9\"}) }}",
        "options": {
          "timeout": 150000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "id": "extract-source-backed-company-metadata-3",
      "name": "Extract metadata on Apify"
    },
    {
      "parameters": {
        "jsCode": "const expectedDomain = $(\"Validate domain\").first().json.domain;\nconst rows = $input.all().flatMap((item) => (Array.isArray(item.json) ? item.json : [item.json]));\nif (rows.length !== 1) {\n  throw new Error(\"Expected exactly one company metadata result\");\n}\nconst row = rows[0];\nif (\n  row.success !== true ||\n  row.domain !== expectedDomain ||\n  row.integrationSource !== \"n8n-github-c9\" ||\n  row.provenance?.method !== \"website_metadata_scrape\"\n) {\n  throw new Error(\"The Actor response failed semantic validation\");\n}\nreturn [{ json: row }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "extract-source-backed-company-metadata-4",
