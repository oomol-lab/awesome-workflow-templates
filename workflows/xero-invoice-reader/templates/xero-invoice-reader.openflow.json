        "name": "Take first 100 invoice records",
        "imports": [],
        "source": "export default function ({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding === 'base64' || !body || typeof body !== 'object' || Array.isArray(body) || !Array.isArray(body.Invoices) || body.Invoices.some((item) => !item || typeof item !== 'object' || Array.isArray(item))) throw new Error('Xero did not return an invoice collection');\n  return { invoices: body.Invoices.slice(0, 100) };\n}\n"
      }
