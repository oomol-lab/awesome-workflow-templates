    "modules": {
      "n_2071486fbcc8bc15": {
        "name": "Prepare cylinder",
        "imports": [],
        "source": "export default async function prepare({ kind, articleId, previous, recipient }) {\n  if (!articleId || articleId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the calculation article ID\");\n  let inputs, outputs;\n  if (kind === \"cylinder\") {\n    inputs = { D: { value: 200, unit: \"mm\" }, h: { value: 20, unit: \"cm\" } };\n    outputs = { A: { unit: \"m^2\" }, V: { unit: \"m^3\" } };\n  } else if (kind === \"speed\") {\n    inputs = { d: { value: 360, unit: \"km\" }, t: { value: 10, unit: \"h\" } };\n  } else if (kind === \"mass\") {\n    const v = previous?.data?.calculation?.outputs?.V;\n    if (!previous?.success || v?.value == null || !v.unit)\n      throw Error(\"Cylinder did not return a volume\");\n    inputs = { ρ: { value: 1000, unit: \"kg/m^3\" }, V: { value: v.value, unit: v.unit } };\n    outputs = { m: { unit: \"kg\" } };\n  } else throw Error(\"Unknown calculation\");\n  return {\n    body: { articleId, inputs, ...(outputs ? { outputs } : {}) },\n    recipient: recipient || \"\",\n  };\n}\n"
      },
      "n_c163c7ef15befae8": {
        "name": "Check cylinder result",
        "imports": [],
        "source": "export default async function result({ status, body, kind, recipient }) {\n  if (status < 200 || status >= 300 || !body?.success) throw Error(\"CalcsLive calculation failed\");\n  if (kind === \"mass\") {\n    const calc = body.data?.calculation,\n      m = calc?.outputs?.m;\n    if (m?.value == null || !m.unit || !recipient || recipient.includes(\"YOUR_\"))\n      throw Error(\"Configure recipient and check the mass result\");\n    return {\n      result: body,\n      to: recipient,\n      subject: \"CalcsLive Calculation Results\",\n      message: `Calculation Results:\\n- Total Physical Quantities: ${calc.totalPQs}\\n- Mass Result: ${m.value} ${m.unit}`,\n    };\n  }\n  return { result: body, to: \"\", subject: \"\", message: \"\" };\n}\n"
      },
