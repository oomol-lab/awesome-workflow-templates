{
  "name": "Calculate Cylinder Mass and Speed",
  "description": "Demonstrates @calcslive/n8n-nodes-calcslive custom node (https://www.npmjs.com/package/@calcslive/n8n-nodes-calcslive) that brings unit-aware physical quantities (PQ) and calculations to the n8n ecosystem in a composable manner. Example workflow with cylinder mass calculations.",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -128,
        -192
      ],
      "id": "calculate-cylinder-mass-and-speed-0",
      "name": "When clicking 'Execute workflow'"
    },
    {
      "parameters": {
        "articleId": "YOUR_CYLINDER_ARTICLE_ID",
        "inputPQs": {
          "pq": [
            {
              "symbol": "D",
              "value": 200,
              "unit": "mm"
            },
            {
              "symbol": "h",
              "value": 20,
              "unit": "cm"
            }
          ]
        },
        "outputPQs": {
          "pq": [
            {
              "symbol": "A",
              "unit": "m^2"
            },
            {
              "symbol": "V",
              "unit": "m^3"
            }
          ]
        }
      },
      "type": "@calcslive/n8n-nodes-calcslive.calcsLive",
      "typeVersion": 1,
      "position": [
        128,
        -80
      ],
      "id": "calculate-cylinder-mass-and-speed-1",
      "name": "Cylinder Calcs: (D, h) => (A, V)"
    },
    {
      "parameters": {
        "articleId": "YOUR_SPEED_ARTICLE_ID",
        "inputPQs": {
          "pq": [
            {
              "symbol": "d",
              "value": 360,
              "unit": "km"
            },
            {
              "symbol": "t",
              "value": 10,
              "unit": "h"
            }
          ]
        }
      },
      "type": "@calcslive/n8n-nodes-calcslive.calcsLive",
      "typeVersion": 1,
      "position": [
        336,
        -288
      ],
      "id": "calculate-cylinder-mass-and-speed-2",
      "name": "Speed Calc: (d, t) => v"
    },
    {
      "parameters": {
        "articleId": "YOUR_MASS_ARTICLE_ID",
        "inputPQs": {
          "pq": [
            {
              "symbol": "ρ",
              "value": 1000,
              "unit": "kg/m^3"
            },
            {
              "symbol": "V",
              "value": "={{ $json.data.calculation.outputs.V.value }}",
              "unit": "={{ $json.data.calculation.outputs.V.unit }}"
            }
          ]
        },
        "outputPQs": {
          "pq": [
            {
              "symbol": "m",
              "unit": "kg"
            }
          ]
        }
      },
      "type": "@calcslive/n8n-nodes-calcslive.calcsLive",
      "typeVersion": 1,
      "position": [
        336,
        -80
      ],
      "id": "calculate-cylinder-mass-and-speed-3",
      "name": "Mass Calc: (ρ, V) => m"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a026dc84-665f-4898-8de9-ccdbaa530bfa",
              "name": "Distance",
              "value": 360,
              "type": "number"
            },
            {
              "id": "de7d6d3e-151c-4390-b2d9-bf78da0159eb",
              "name": "DistanceUnit",
              "value": "km",
              "type": "string"
            },
            {
              "id": "49c1e979-a0c2-403e-bed1-ef28eb8513ad",
              "name": "Time",
              "value": 2,
              "type": "number"
            },
            {
              "id": "54ae6f42-844f-4bf2-b6d3-a6e159d46e9e",
              "name": "TimeUnit",
              "value": "h",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        128,
        -288
      ],
      "id": "calculate-cylinder-mass-and-speed-4",
      "name": "Fields: (d, t)"
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "CalcsLive Calculation Results",
        "message": "=Hello!\n\nThis is an automated email from your n8n workflow using @calcslive/n8n-nodes-calcslive.\n\nCalculation Results:\n- Total Physical Quantities: {{ $json.data.calculation.totalPQs }}\n- Mass Result: {{ $json.data.calculation.outputs.m.value }} {{ $json.data.calculation.outputs.m.unit }}\n\nBest regards,\nYour CalcsLive Workflow",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": []
          }
        }
      },
      "id": "calculate-cylinder-mass-and-speed-5",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        528,
        -80
      ]
    }
  ],
  "pinData": {},
