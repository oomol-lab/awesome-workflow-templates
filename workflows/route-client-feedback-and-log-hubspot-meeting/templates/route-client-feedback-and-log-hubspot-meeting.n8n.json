    {
      "name": "Prepare department email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare feedback\").first().json,\n  a = $(\"Analyze feedback\").first().json.output ?? {},\n  to = p[a.department];\nif (\n  ![\"product\", \"administrative\", \"support\", \"commercial\"].includes(a.department) ||\n  !to ||\n  to.startsWith(\"YOUR_\")\n)\n  throw Error(\"Configure department recipient\");\nreturn { json: { to, text: \"FROM CLIENT: \" + p.email + \"\\n\\n\" + p.transcript } };\n"
      },
      "id": "route-client-feedback-and-log-hubspot-meeting-18",
      "position": [
        3960,
        0
