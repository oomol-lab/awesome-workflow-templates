    "modules": {
      "n_bfced6ca4d471090": {
        "name": "Set Notion and Clockify IDs",
        "imports": [],
        "source": "function configure(settings, at) {\n  const { dataSourceId, workspaceId, nameProperty } = settings;\n  const uuid = String(dataSourceId).replace(/-/g, \"\").toLowerCase();\n  const oid = String(workspaceId).toLowerCase();\n  if (\n    !/^[0-9a-f]{32}$/.test(uuid) ||\n    !/^[0-9a-f]{24}$/.test(oid) ||\n    typeof nameProperty !== \"string\" ||\n    !nameProperty.trim()\n  ) {\n    throw Error(\"Configure the Notion data source ID, Clockify workspace ID and name property.\");\n  }\n  const time = Date.parse(at);\n  if (!Number.isFinite(time)) throw Error(\"The scheduled time is missing.\");\n  const source = uuid.replace(/^(........)(....)(....)(....)(............)$/, \"$1-$2-$3-$4-$5\");\n  return {\n    source,\n    workspaceId: oid,\n    nameProperty,\n    key: \"notion-clockify:\" + source + \"|\" + oid,\n    upper: new Date(Math.floor(time / 60000) * 60000).toISOString(),\n  };\n}\nexport default ({ settings, at }) => ({ config: configure(settings, at) });\n"
      },
      "n_3ad3fbd68209671a": {
        "name": "Set the creation-time window",
        "imports": [],
        "source": "function windowFor(config, previous) {\n  const baseline = previous?.baseline ?? config.upper;\n  const last = previous?.upper ?? config.upper;\n  if (!Number.isFinite(Date.parse(baseline)) || !Number.isFinite(Date.parse(last)))\n    throw Error(\"Invalid polling checkpoint.\");\n  const lower = new Date(Math.max(Date.parse(baseline), Date.parse(last) - 60000)).toISOString();\n  return { ...config, baseline, lower, first: previous == null, skip: config.upper <= last };\n}\nfunction range(win) {\n  return {\n    and: [\n      { timestamp: \"created_time\", created_time: { on_or_after: win.lower } },\n      { timestamp: \"created_time\", created_time: { before: win.upper } },\n    ],\n  };\n}\nexport default async ({ config }, ctx) => {\n  const earlier = await ctx.state.get(config.key);\n  const win = windowFor(config, earlier);\n  return { win };\n};\n"
      },
      "n_1c6f1dfe958a779c": {
        "name": "Read new Notion pages",
        "imports": [],
        "source": "function windowFor(config, previous) {\n  const baseline = previous?.baseline ?? config.upper;\n  const last = previous?.upper ?? config.upper;\n  if (!Number.isFinite(Date.parse(baseline)) || !Number.isFinite(Date.parse(last)))\n    throw Error(\"Invalid polling checkpoint.\");\n  const lower = new Date(Math.max(Date.parse(baseline), Date.parse(last) - 60000)).toISOString();\n  return { ...config, baseline, lower, first: previous == null, skip: config.upper <= last };\n}\nfunction range(win) {\n  return {\n    and: [\n      { timestamp: \"created_time\", created_time: { on_or_after: win.lower } },\n      { timestamp: \"created_time\", created_time: { before: win.upper } },\n    ],\n  };\n}\nfunction collectRows(pages, win) {\n  const queued = new Map(),\n    cursors = new Set();\n  for (const [index, page] of pages.entries()) {\n    if (\n      !Array.isArray(page?.results) ||\n      page.has_more !== index < pages.length - 1 ||\n      (page.has_more\n        ? typeof page.next_cursor !== \"string\" || !page.next_cursor || cursors.has(page.next_cursor)\n        : page.next_cursor !== null) ||\n      (page.request_status && page.request_status.type !== \"complete\" && !page.has_more)\n    ) {\n      throw Error(\n        \"The Notion query did not return a complete set of pages. The checkpoint was kept.\",\n      );\n    }\n    if (page.has_more) cursors.add(page.next_cursor);\n    for (const row of page.results) {\n      const created = Date.parse(row.created_time);\n      if (row.object !== \"page\" || !Number.isFinite(created))\n        throw Error(\"Notion returned an invalid page.\");\n      if (created < Date.parse(win.lower) || created >= Date.parse(win.upper)) continue;\n      const pageId = String(row.id).toLowerCase();\n      if (\n        !/^[0-9a-f-]{36}$/.test(pageId) ||\n        row.parent?.type !== \"data_source_id\" ||\n        String(row.parent.data_source_id).replace(/-/g, \"\").toLowerCase() !==\n          win.source.replace(/-/g, \"\")\n      ) {\n        throw Error(\"Notion returned a page outside the configured data source.\");\n      }\n      if (queued.has(pageId)) continue;\n      const property = row.properties?.[win.nameProperty];\n      const parts =\n        property?.type === \"title\"\n          ? property.title\n          : property?.type === \"rich_text\"\n            ? property.rich_text\n            : null;\n      const name = Array.isArray(parts)\n        ? parts\n            .map((part) => part.plain_text ?? part.text?.content ?? \"\")\n            .join(\"\")\n            .trim()\n        : \"\";\n      queued.set(pageId, {\n        pageId,\n        name,\n        key: win.key + \"|\" + pageId,\n        eligible: name.length > 0 && [...name].length <= 100,\n      });\n    }\n  }\n  return [...queued.values()];\n}\nexport default async ({ win }, ctx) => {\n  if (win.skip) return { rows: [] };\n  const pages = [],\n    seen = new Set();\n  let startCursor;\n  for (let count = 0; count < 50; count++) {\n    const page = await ctx.actions.call(\"notion.query_data_source\", {\n      dataSourceId: win.source,\n      pageSize: 100,\n      result_type: \"page\",\n      filter: range(win),\n      sorts: [{ timestamp: \"created_time\", direction: \"ascending\" }],\n      ...(startCursor ? { startCursor } : {}),\n    });\n    pages.push(page);\n    if (page?.has_more === false) return { rows: collectRows(pages, win) };\n    startCursor = page?.next_cursor;\n    if (typeof startCursor !== \"string\" || !startCursor || seen.has(startCursor))\n      throw Error(\"Invalid Notion continuation cursor.\");\n    seen.add(startCursor);\n  }\n  throw Error(\"The Notion query exceeded 50 pages. The checkpoint was kept.\");\n};\n"
      },
      "n_111716faa9b5bf0f": {
        "name": "Select one Notion page",
        "imports": [],
        "source": "export default ({ rows, prior }) => {\n  const progress = prior ?? { index: 0, results: [] };\n  const row = rows[progress.index] ?? {};\n  return { progress, row, more: progress.index < rows.length, results: progress.results };\n};\n"
      },
      "n_1d6b08b5fe5918f9": {
        "name": "Reserve this page ID",
        "imports": [],
        "source": "export default async ({ row, win }, ctx) => {\n  const previous = { pageId: row.pageId, status: \"invalid_name\" };\n  const fresh =\n    row.eligible &&\n    (await ctx.state.insert(row.key, { pageId: row.pageId, status: \"pending_review\" }));\n  return {\n    fresh,\n    previous: fresh ? previous : row.eligible ? await ctx.state.get(row.key) : previous,\n    endpoint: \"/workspaces/\" + win.workspaceId + \"/clients\",\n    body: { name: row.name },\n  };\n};\n"
      },
      "n_9ab7abc21057f144": {
        "name": "Verify the Clockify receipt",
        "imports": [],
        "source": "function outcome(row, ws, status, body) {\n  return status === 201 &&\n    typeof body?.id === \"string\" &&\n    body.id.length > 0 &&\n    body.workspaceId === ws &&\n    body.name === row.name\n    ? { pageId: row.pageId, status: \"created\", clientId: body.id }\n    : { pageId: row.pageId, status: \"pending_review\" };\n}\nexport default async ({ row, win, body, status }, ctx) => {\n  const result = outcome(row, win.workspaceId, status, body);\n  if (result.status === \"created\") await ctx.state.set(row.key, result);\n  return { result };\n};\n"
      },
      "n_b7a9732c087ee15c": {
        "name": "Collect the page outcome",
        "imports": [],
        "source": "export default ({ progress, previous, saved }) => ({\n  progress: {\n    index: progress.index + 1,\n    results: [...progress.results, saved?.pageId === previous.pageId ? saved : previous],\n  },\n});\n"
      },
      "n_015b6b4b35c1612c": {
        "name": "Save the polling checkpoint",
        "imports": [],
        "source": "export default async ({ win, results }, ctx) => {\n  const latest = await ctx.state.get(win.key);\n  if (!latest || win.upper > latest.upper)\n    await ctx.state.set(win.key, { baseline: win.baseline, upper: win.upper });\n  return { results, first: win.first };\n};\n"
      }
    },
