    "modules": {
      "n_e211c860c4fc52ef": {
        "name": "Set seed keywords and targeting",
        "imports": [],
        "source": "function prepareKeywordResearch(settings) {\n  const {\n    keywords,\n    geoTargetConstants,\n    language,\n    network,\n    customerId,\n    managerId,\n    pageSize,\n    spreadsheetId,\n    sheetName,\n  } = settings;\n  if (\n    !Array.isArray(keywords) ||\n    keywords.length < 1 ||\n    keywords.length > 20 ||\n    keywords.some(\n      (keyword) => typeof keyword !== \"string\" || !keyword.trim() || keyword.length > 80,\n    )\n  ) {\n    throw new Error(\"Enter 1 to 20 seed keywords\");\n  }\n  if (\n    !Array.isArray(geoTargetConstants) ||\n    geoTargetConstants.length > 10 ||\n    geoTargetConstants.some(\n      (geo) => typeof geo !== \"string\" || !/^geoTargetConstants\\/[1-9]\\d{0,9}$/.test(geo),\n    )\n  ) {\n    throw new Error(\"Enter up to 10 geoTargetConstants resource names\");\n  }\n  if (\n    typeof language !== \"string\" ||\n    (language && !/^languageConstants\\/[1-9]\\d{0,9}$/.test(language))\n  ) {\n    throw new Error(\"Enter a languageConstants resource name or leave it empty\");\n  }\n  if (![\"GOOGLE_SEARCH\", \"GOOGLE_SEARCH_AND_PARTNERS\"].includes(network))\n    throw new Error(\"Choose a Google Ads search network\");\n  if (\n    typeof customerId !== \"string\" ||\n    !/^\\d{10}$/.test(customerId) ||\n    typeof managerId !== \"string\" ||\n    (managerId && !/^\\d{10}$/.test(managerId))\n  ) {\n    throw new Error(\"Enter the 10-digit Ads client ID and optional manager ID without hyphens\");\n  }\n  if (!Number.isInteger(pageSize) || pageSize < 1 || pageSize > 500)\n    throw new Error(\"Page size must be between 1 and 500\");\n  if (\n    typeof spreadsheetId !== \"string\" ||\n    !/^[A-Za-z0-9_-]{12,}$/.test(spreadsheetId) ||\n    spreadsheetId === \"YOUR_SPREADSHEET_ID\" ||\n    typeof sheetName !== \"string\" ||\n    !sheetName.trim() ||\n    sheetName.length > 100\n  ) {\n    throw new Error(\"Set the spreadsheet ID and sheet tab name\");\n  }\n  return {\n    endpoint:\n      \"https://googleads.googleapis.com/v26/customers/\" + customerId + \":generateKeywordIdeas\",\n    headers: managerId ? { \"login-customer-id\": managerId } : {},\n    body: {\n      keywordSeed: { keywords: keywords.map((keyword) => keyword.trim()) },\n      geoTargetConstants,\n      ...(language ? { language } : {}),\n      includeAdultKeywords: false,\n      pageSize,\n      keywordPlanNetwork: network,\n    },\n    spreadsheetId,\n    sheetName,\n    range: \"'\" + sheetName.replace(/'/g, \"''\") + \"'!A:F\",\n  };\n}\n\nexport default (settings) => ({ plan: prepareKeywordResearch(settings) });\n"
      },
      "n_035f5900da056f7e": {
        "name": "Get all keyword ideas",
        "imports": [],
        "source": "function keywordCount(value) {\n  if (value == null) return \"\";\n  if (typeof value === \"number\" && !Number.isSafeInteger(value))\n    throw new Error(\"Google Ads returned an unsafe integer\");\n  if (typeof value !== \"string\" && typeof value !== \"number\")\n    throw new Error(\"Google Ads returned an invalid integer\");\n  const digits = String(value);\n  if (!/^\\d{1,19}$/.test(digits) || BigInt(digits) > 9223372036854775807n) {\n    throw new Error(\"Google Ads returned an invalid nonnegative int64\");\n  }\n  return digits;\n}\n\nfunction bidDisplay(value) {\n  const micros = keywordCount(value);\n  if (micros === \"\") return \"\";\n  const cents = (BigInt(micros) + 5000n) / 10000n;\n  return (cents / 100n).toString() + \".\" + (cents % 100n).toString().padStart(2, \"0\");\n}\n\nfunction keywordRow(idea) {\n  const keyword = idea?.text;\n  const metrics = idea?.keywordIdeaMetrics ?? {};\n  if (\n    typeof keyword !== \"string\" ||\n    !keyword.trim() ||\n    keyword.length > 200 ||\n    typeof metrics !== \"object\" ||\n    Array.isArray(metrics)\n  )\n    throw new Error(\"Google Ads returned an invalid keyword idea\");\n  const competition = metrics.competition ?? \"\";\n  if (![\"\", \"UNSPECIFIED\", \"UNKNOWN\", \"LOW\", \"MEDIUM\", \"HIGH\"].includes(competition)) {\n    throw new Error(\"Google Ads returned an invalid competition value\");\n  }\n  return [\n    keyword,\n    competition,\n    keywordCount(metrics.avgMonthlySearches),\n    keywordCount(metrics.competitionIndex),\n    bidDisplay(metrics.lowTopOfPageBidMicros),\n    bidDisplay(metrics.highTopOfPageBidMicros),\n  ];\n}\n\nfunction collectKeywordPage(previous, response) {\n  if (\n    !response ||\n    typeof response !== \"object\" ||\n    Array.isArray(response) ||\n    response.error ||\n    (response.results !== undefined && !Array.isArray(response.results))\n  ) {\n    throw new Error(\"Google Ads did not return a keyword ideas page\");\n  }\n  const page = response.results ?? [];\n  const token = response.nextPageToken ?? \"\";\n  if (\n    typeof token !== \"string\" ||\n    token.length > 4096 ||\n    (token && previous.tokens.includes(token))\n  ) {\n    throw new Error(\"Google Ads returned an invalid or repeated next page token\");\n  }\n  const rows = [...previous.rows, ...page.map(keywordRow)];\n  const count = previous.count + 1;\n  if (rows.length > 5000 || (token && count >= 20)) {\n    throw new Error(\n      \"Keyword research exceeded 20 pages or 5000 rows. Narrow the seed or targeting and run again.\",\n    );\n  }\n  const reportedSize = keywordCount(response.totalSize);\n  if (reportedSize && previous.totalSize && reportedSize !== previous.totalSize)\n    throw new Error(\"Google Ads total changed between pages\");\n  const totalSize = reportedSize || previous.totalSize;\n  if (\n    totalSize &&\n    (BigInt(rows.length) > BigInt(totalSize) ||\n      (!token && BigInt(rows.length) !== BigInt(totalSize)))\n  ) {\n    throw new Error(\"Google Ads returned an incomplete or inconsistent results list\");\n  }\n  if (new Set(rows.map((row) => row[0])).size !== rows.length)\n    throw new Error(\"Google Ads repeated a keyword across pages\");\n  return {\n    rows,\n    count,\n    tokens: token ? [...previous.tokens, token] : previous.tokens,\n    totalSize,\n    token,\n  };\n}\n\nexport default async function research({ plan, clientId, clientSecret, refreshToken }, context) {\n  if (\n    [clientId, clientSecret, refreshToken].some(\n      (value) => typeof value !== \"string\" || !value.trim(),\n    )\n  ) {\n    throw new Error(\"Bind the approved Google Ads OAuth credentials\");\n  }\n  const form = {\n    client_id: clientId,\n    client_secret: clientSecret,\n    refresh_token: refreshToken,\n    grant_type: \"refresh_token\",\n  };\n  const refresh = await context.fetch(\"https://oauth2.googleapis.com/token\", {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n    body: Object.entries(form)\n      .map(([key, value]) => key + \"=\" + encodeURIComponent(value))\n      .join(\"&\"),\n  });\n  if (refresh.status !== 200)\n    throw new Error(\"Google Ads OAuth refresh failed with HTTP \" + refresh.status);\n  const { access_token: token, token_type: type } = await refresh.json();\n  if (\n    typeof token !== \"string\" ||\n    !token.trim() ||\n    typeof type !== \"string\" ||\n    type.toLowerCase() !== \"bearer\"\n  ) {\n    throw new Error(\"Google OAuth did not return a usable access token\");\n  }\n  let state = { rows: [], count: 0, tokens: [], totalSize: \"\", token: \"\" };\n  do {\n    if (state.count) await new Promise((resolve) => setTimeout(resolve, 1100));\n    const request = { ...plan.body, ...(state.token ? { pageToken: state.token } : {}) };\n    const response = await context.fetch(plan.endpoint, {\n      method: \"POST\",\n      headers: {\n        ...plan.headers,\n        authorization: \"Bearer \" + token,\n        \"content-type\": \"application/json\",\n      },\n      body: JSON.stringify(request),\n    });\n    if (response.status !== 200)\n      throw new Error(\"Google Ads keyword ideas failed with HTTP \" + response.status);\n    state = collectKeywordPage(state, await response.json());\n  } while (state.token);\n  return { rows: state.rows, hasRows: state.rows.length > 0 };\n}\n"
      },
      "n_44fb46da40c0e14d": {
        "name": "Confirm the appended rows",
        "imports": [],
        "source": "function keywordSheetReceipt(receipt, expected, rows) {\n  const { spreadsheetId, updatedRange, updatedRows, updatedData } = receipt ?? {};\n  const split = typeof updatedRange === \"string\" ? updatedRange.lastIndexOf(\"!\") : -1;\n  const name = split < 0 ? \"\" : updatedRange.slice(0, split);\n  const tab =\n    name.startsWith(\"'\") && name.endsWith(\"'\") ? name.slice(1, -1).replace(/''/g, \"'\") : name;\n  const coordinates =\n    split < 0 ? null : /^A([1-9]\\d*):[A-F]([1-9]\\d*)$/.exec(updatedRange.slice(split + 1));\n  const actual = updatedData?.values;\n  if (\n    spreadsheetId !== expected.spreadsheetId ||\n    tab !== expected.sheetName ||\n    !coordinates ||\n    Number(coordinates[2]) - Number(coordinates[1]) + 1 !== rows.length ||\n    updatedRows !== rows.length ||\n    !Array.isArray(actual) ||\n    actual.length !== rows.length ||\n    !actual.every(\n      (row, index) =>\n        Array.isArray(row) &&\n        row.length <= rows[index].length &&\n        rows[index].every((cell, col) => (row[col] ?? \"\") === cell),\n    )\n  ) {\n    throw new Error(\"Sheets did not confirm these rows. Check the target tab before retrying.\");\n  }\n  return { spreadsheetId, updatedRange, appendedRows: updatedRows };\n}\n\nexport default ({ spreadsheetId, updatedRange, updatedRows, updatedData, plan, rows }) => ({\n  result: keywordSheetReceipt(\n    { spreadsheetId, updatedRange, updatedRows, updatedData },\n    plan,\n    rows,\n  ),\n});\n"
      },
      "n_7cc91bd2ed0f6a32": {
        "name": "Report no keyword ideas",
