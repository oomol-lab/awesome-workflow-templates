    "modules": {
      "n_33ae84ef422827ef": {
        "name": "Prepare analysis",
        "imports": [],
        "source": "export default function setup({instanceUrl,analyzerId,url}){let host,target;try{host=new URL(instanceUrl);target=new URL(url)}catch{throw Error('Enter valid Cortex and observable URLs')}if(host.protocol!=='https:'||host.username||host.password||host.search||host.hash||!['http:','https:'].includes(target.protocol)||target.username||target.password)throw Error('Use an HTTPS Cortex instance and an HTTP(S) observable');if(typeof analyzerId!=='string'||! /^[a-zA-Z0-9_-]+$/.test(analyzerId))throw Error('Enter a valid analyzer ID');const base=host.toString().replace(/\\/+$/,'');return{base,url:base+'/api/analyzer/'+encodeURIComponent(analyzerId)+'/run?force=false',body:{dataType:'url',tlp:2,data:target.toString()}};}\n"
      },
      "n_313f62e8733bc970": {
        "name": "Prepare job lookup",
        "imports": [],
        "source": "export default function job({body,base}){const id=body?.id;if(typeof id!=='string'||! /^[a-zA-Z0-9_-]+$/.test(id))throw Error('Cortex did not return a valid job ID');return{url:base+'/api/job/'+encodeURIComponent(id),jobId:id};}\n"
      },
      "n_953226ea347a608f": {
        "name": "Verify job",
        "imports": [],
        "source": "export default function result({body,jobId}){if(!body||typeof body!=='object'||Array.isArray(body)||body.id!==jobId)throw Error('Cortex did not return the submitted job');return{job:body};}\n"
      }
    }
