    "modules": {
      "n_33ae84ef422827ef": {
        "name": "Prepare analysis",
        "imports": [],
        "source": "export default function setup({ instanceUrl, analyzerId, url }) {\n  let host, target;\n  try {\n    host = new URL(instanceUrl);\n    target = new URL(url);\n  } catch {\n    throw Error(\"Enter valid Cortex and observable URLs\");\n  }\n  if (\n    host.protocol !== \"https:\" ||\n    host.username ||\n    host.password ||\n    host.search ||\n    host.hash ||\n    ![\"http:\", \"https:\"].includes(target.protocol) ||\n    target.username ||\n    target.password\n  )\n    throw Error(\"Use an HTTPS Cortex instance and an HTTP(S) observable\");\n  if (typeof analyzerId !== \"string\" || !/^[a-zA-Z0-9_-]+$/.test(analyzerId))\n    throw Error(\"Enter a valid analyzer ID\");\n  const base = host.toString().replace(/\\/+$/, \"\");\n  return {\n    base,\n    url: base + \"/api/analyzer/\" + encodeURIComponent(analyzerId) + \"/run?force=false\",\n    body: { dataType: \"url\", tlp: 2, data: target.toString() },\n  };\n}\n"
      },
      "n_313f62e8733bc970": {
        "name": "Prepare job lookup",
        "imports": [],
        "source": "export default function job({ body, base }) {\n  const id = body?.id;\n  if (typeof id !== \"string\" || !/^[a-zA-Z0-9_-]+$/.test(id))\n    throw Error(\"Cortex did not return a valid job ID\");\n  return { url: base + \"/api/job/\" + encodeURIComponent(id), jobId: id };\n}\n"
      },
      "n_953226ea347a608f": {
        "name": "Verify job",
        "imports": [],
        "source": "export default function result({ body, jobId }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body) || body.id !== jobId)\n    throw Error(\"Cortex did not return the submitted job\");\n  return { job: body };\n}\n"
      }
    }
