    "modules": {
      "n_3c33b1bf2a95f165": {
        "name": "Extract the article title",
        "imports": [],
        "source": "export default function wiki({body}) {const pages=body?.query?.pages;if(!pages||typeof pages!=='object')throw Error('Invalid Wikipedia response');const p=Object.values(pages)[0];if(!p||typeof p.title!=='string')throw Error('Missing Wikipedia title');return {title:p.title};}\n"
      },
      "n_9a7568cacc018edd": {
        "name": "Prepare the next starred page",
        "imports": [],
        "source": "export default function stars({previous,response,user}) {\n if(!/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/.test(user)) throw Error('Enter a GitHub username');\n const page=previous?.page??0;\n if(page===0)return {state:{page:1},more:true,url:`https://api.github.com/users/${user}/starred?per_page=15&page=1`,repositories:[]};\n if(!Array.isArray(response))throw Error('Invalid GitHub page');\n return {state:{page:page+1},more:response.length===15,url:`https://api.github.com/users/${user}/starred?per_page=15&page=${page+1}`,repositories:response};\n}\n"
      }
    }
