    {
      "id": "explore-http-request-examples-11",
      "name": "HTTP Request - Get my Stars",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1525,
        725
      ],
      "parameters": {
        "url": "={{ 'https://api.github.com/users/' + $('Set').first().json.githubUser + '/starred?per_page=15&page=1' }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://api.github.com/users/' + $('Set').first().json.githubUser + '/starred?per_page=15&page=' + ($pageCount + 1) }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.length < 15 }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "typeVersion": 4.2
    }
