    "modules": {
      "n_dd23a0c60a781205": {
        "name": "Check escalation threshold",
        "imports": [],
        "source": "export default function checkUrgency({\n  ticketId,\n  customerEmail,\n  category,\n  urgency,\n  internalSummary,\n}) {\n  const escalate = urgency === \"high\" || urgency === \"critical\";\n  const alertText =\n    \"*[\" +\n    String(urgency).toUpperCase() +\n    \"]* Ticket \" +\n    ticketId +\n    \" (\" +\n    category +\n    \") from \" +\n    customerEmail +\n    \"\\n\" +\n    internalSummary;\n  return { escalate, alertText };\n}\n"
      }
    }
