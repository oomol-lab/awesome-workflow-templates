    "modules": {
      "n_6d14a8470c57ee65": {
        "name": "Prepare single translation",
        "imports": [],
        "source": "function prepareTranslation(text, target) {\n  if (\n    typeof text !== \"string\" ||\n    !text.length ||\n    typeof target !== \"string\" ||\n    !target.trim() ||\n    target.trim() !== target\n  ) {\n    throw new Error(\"Enter text and a target language code\");\n  }\n  return { q: text, target };\n}\nexport default async function translateRequest({ text, target }) {\n  return { body: prepareTranslation(text, target) };\n}\n"
      },
      "n_f1a599b500d9f151": {
        "name": "Read translated text",
        "imports": [],
        "source": "function readTranslation(body) {\n  const translations = body && typeof body === \"object\" && body.data && body.data.translations;\n  if (!Array.isArray(translations) || translations.length !== 1)\n    throw new Error(\"Google did not return one translation\");\n  const translation = translations[0];\n  if (\n    !translation ||\n    typeof translation !== \"object\" ||\n    Array.isArray(translation) ||\n    typeof translation.translatedText !== \"string\"\n  ) {\n    throw new Error(\"Google did not return translated text\");\n  }\n  return translation;\n}\nexport default async function translateResult({ body }) {\n  return { translation: readTranslation(body) };\n}\n"
      }
    }
