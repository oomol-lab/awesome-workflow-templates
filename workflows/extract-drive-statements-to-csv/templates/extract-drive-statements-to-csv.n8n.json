        "specifyBody": "json",
        "jsonBody": "={{ {contents:[{parts:[{text:\"Extract every transaction into CSV and add a category column. Preserve numbers, do not invent data. Return only CSV.\"},{file_data:{file_uri:$json.uri,mime_type:$json.mimeType}}]}]} }}",
