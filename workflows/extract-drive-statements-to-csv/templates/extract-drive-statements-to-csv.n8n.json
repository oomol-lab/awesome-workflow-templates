    {
      "name": "Check PDF generation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status !== \"completed\") throw Error(\"Incomplete PDF generation\");\nconst text = ($json.output ?? [])\n  .flatMap((x) =>\n    x.type === \"message\"\n      ? (x.content ?? []).filter((p) => p.type === \"output_text\").map((p) => p.text)\n      : [],\n  )\n  .join(\"\\n\");\nreturn { json: { text } };\n"
      },
      "id": "extract-drive-statements-to-csv-19",
      "position": [
        4180,
        0
      ]
    },
