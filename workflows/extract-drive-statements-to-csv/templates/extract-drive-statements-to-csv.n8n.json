        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {model:\"gpt-5.4-mini\",store:false,input:[{role:\"user\",content:[{type:\"input_text\",text:\"Extract every transaction into CSV and add a category column. Preserve numbers, do not invent data. Return only CSV. Statement: \"+$json.text}]}]} }}",
        "options": {}
