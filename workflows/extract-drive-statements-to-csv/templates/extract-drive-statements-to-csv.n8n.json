    {
      "name": "Validate CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function validate({ text }) {\n  if (typeof text !== \"string\") throw Error(\"Missing CSV response\");\n  const csv = text\n    .trim()\n    .replace(/^```(?:csv)?\\s*\\n/i, \"\")\n    .replace(/\\n```\\s*$/, \"\");\n  let rows = [],\n    row = [],\n    cell = \"\",\n    quoted = false;\n  for (let i = 0; i < csv.length; i++) {\n    let c = csv[i];\n    if (quoted) {\n      if (c === '\"' && csv[i + 1] === '\"') {\n        cell += '\"';\n        i++;\n      } else if (c === '\"') quoted = false;\n      else cell += c;\n    } else if (c === '\"') {\n      if (cell) throw Error(\"Invalid CSV quoting\");\n      quoted = true;\n    } else if (c === \",\") {\n      row.push(cell);\n      cell = \"\";\n    } else if (c === \"\\n\") {\n      row.push(cell);\n      rows.push(row);\n      row = [];\n      cell = \"\";\n    } else if (c !== \"\\r\") cell += c;\n  }\n  if (quoted) throw Error(\"Unclosed CSV quote\");\n  if (cell || row.length) {\n    row.push(cell);\n    rows.push(row);\n  }\n  if (\n    !rows.length ||\n    !rows[0].some((x) => x.trim().toLowerCase() === \"category\") ||\n    rows.some((r) => r.length !== rows[0].length)\n  )\n    throw Error(\"Invalid transaction CSV\");\n  return { csv };\n}\n\nconst csv = validate({ text: $json.text }).csv,\n  source = $(\"Get PDF or Images\").item.json;\nif (!source.id) throw Error(\"Missing source file ID\");\nconst name = String(source.name || \"statement\").replace(/\\.[^.]+$/, \"\") + \"-\" + source.id + \".csv\";\nreturn {\n  json: { id: source.id, name, csv },\n  binary: {\n    data: await this.helpers.prepareBinaryData(Buffer.from(csv, \"utf8\"), name, \"text/csv\"),\n  },\n};\n"
      },
      "id": "extract-drive-statements-to-csv-5",
      "position": [
        1100,
        0
      ]
    },
    {
