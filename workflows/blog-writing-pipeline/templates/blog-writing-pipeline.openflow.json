        "imports": [],
        "source": "export default function blogResult({ topic, content }) {\n  if (typeof content !== \"string\" || !content.trim())\n    throw new Error(\"The editor returned an empty blog post.\");\n  return { topic, final_post: content, generated_at: new Date().toISOString() };\n}\n"
      }
