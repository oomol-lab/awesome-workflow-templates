              "type": "string"
            },
            {
              "id": "tone",
              "name": "tone",
              "value": "professional but conversational",
              "type": "string"
            },
            {
              "id": "word_count",
              "name": "word_count",
              "value": "1500",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-input",
      "name": "Set Blog Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "llama3:8b"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=You are a professional blog researcher. Research the topic: \"{{ $json.topic }}\" and provide 5 key points with supporting evidence. Format as a numbered list with brief explanations. Be factual and cite real concepts."
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 1000
        }
      },
      "id": "research",
      "name": "1. Research Topic (Ollama)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "llama3:8b"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=You are a blog outline creator. Based on this research:\n\n{{ $json.message.content }}\n\nCreate a detailed blog outline for the topic: \"{{ $('Set Blog Parameters').first().json.topic }}\"\n\nInclude: Title, H2 sections, key points under each, and a conclusion. Target {{ $('Set Blog Parameters').first().json.word_count }} words."
            }
          ]
        },
        "options": {
          "temperature": 0.4,
          "maxTokens": 1000
        }
      },
      "id": "outline",
      "name": "2. Create Outline (Ollama)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "llama3:8b"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=You are a professional blog writer. Write a complete blog post following this outline:\n\n{{ $json.message.content }}\n\nRequirements:\n- Tone: {{ $('Set Blog Parameters').first().json.tone }}\n- Target length: {{ $('Set Blog Parameters').first().json.word_count }} words\n- Use markdown formatting (## for headings)\n- Include a compelling introduction and conclusion\n- Add practical tips and examples\n- Write for SEO (use keywords naturally)"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 4000
        }
      },
      "id": "draft",
      "name": "3. Write Draft (Ollama)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "llama3:8b"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=You are a professional editor. Edit and improve this blog post for clarity, grammar, flow, and SEO. Fix any issues and make it publication-ready. Return the complete edited post in markdown.\n\nOriginal post:\n\n{{ $json.message.content }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 4000
        }
      },
      "id": "edit",
      "name": "4. Edit & Polish (Ollama)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const finish = function blogResult({ topic, content }) {\n  if (typeof content !== 'string' || !content.trim()) throw new Error('The editor returned an empty blog post.');\n  return { topic, final_post: content, generated_at: new Date().toISOString() };\n}\n\nreturn [{json: finish({topic: $('Set Blog Parameters').first().json.topic, content: $input.first().json.message.content})}];\n"
      },
      "id": "output",
      "name": "Final Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    }
