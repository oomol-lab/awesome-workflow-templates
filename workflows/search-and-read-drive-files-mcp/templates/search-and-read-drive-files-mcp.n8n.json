        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json.response ?? $json.text ?? $json.content ?? JSON.stringify($json);\nif (typeof x !== \"string\" || !x.trim()) throw Error(\"Empty extraction\");\nconst input = $(\"Select binary input\").item.json;\nreturn { json: { fileId: input.fileId, response: x, source: input.source } };\n"
