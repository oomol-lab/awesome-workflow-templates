    {
      "name": "Aggregate CSV rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all();\nconst response = rows\n  .map((i) =>\n    (i.json.row || []).map((v) => '\"' + String(v ?? \"\").replace(/\"/g, '\"\"') + '\"').join(\",\"),\n  )\n  .join(\"\\n\");\nreturn [{ json: { response }, pairedItem: { item: 0 } }];\n"
      },
