    {
      "name": "Prepare tool request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json;\nif (![\"search\", \"readFile\"].includes(x.operation)) throw Error(\"Invalid tool\");\nif (x.operation === \"readFile\" && !x.fileId) throw Error(\"Missing file ID\");\nreturn {\n  json: {\n    operation: x.operation,\n    query: x.query || \"\",\n    fileId: x.fileId || \"\",\n    folderId: x.folderId || \"\",\n    mode: \"direct\",\n  },\n};\n"
      },
