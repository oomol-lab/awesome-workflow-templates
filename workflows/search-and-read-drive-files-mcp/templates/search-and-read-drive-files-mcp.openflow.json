    "modules": {
      "n_0f7be6ccfb698ab6": {
        "name": "Authenticate and choose tool",
        "imports": [],
        "source": "export default function f({ headers, secret, body }) {\n  if (!secret || headers.authorization !== secret) throw Error(\"Unauthorized\");\n  if (![\"search\", \"readFile\"].includes(body?.operation)) throw Error(\"Invalid operation\");\n  const q = String(body.query || \"\")\n    .replace(/\\\\/g, \"\\\\\\\\\")\n    .replace(/'/g, \"\\\\'\");\n  if (body.operation === \"readFile\" && !body.fileId) throw Error(\"Missing file ID\");\n  return {\n    operation: body.operation,\n    fileId: body.fileId || \"\",\n    request: { fileId: body.fileId || \"\" },\n    query:\n      \"name contains '\" +\n      q +\n      \"' and mimeType != 'application/vnd.google-apps.folder' and trashed = false\",\n  };\n}\n"
      },
      "n_e0a16467e7b3ff7d": {
        "name": "Format search results",
        "imports": [],
        "source": "export default function f({ files }) {\n  return { body: { response: files } };\n}\n"
      },
      "n_efe24ca84bb7bb15": {
