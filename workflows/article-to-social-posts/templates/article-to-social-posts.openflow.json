      "n_1c6ea1f359477287": {
        "name": "Prepare source material",
        "imports": [],
        "source": "export default function prepareArticle({ source, voice_notes }) {\n  if (typeof source !== 'string' || !source.trim()) throw new Error('An article or transcript is required.');\n  if (voice_notes != null && typeof voice_notes !== 'string') throw new Error('Voice notes must be text.');\n  return { source: source.replace(/\\s+/g, ' ').slice(0, 9000), voice_notes: voice_notes || 'none' };\n}\n"
      }
