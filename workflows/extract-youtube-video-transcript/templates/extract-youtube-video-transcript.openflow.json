    "modules": {
      "n_002e4447dd8ee32a": {
        "name": "Read the video ID",
        "imports": [],
        "source": "export default function main({ video, body }) {\n  video = video ?? body?.video;\n  if (typeof video !== \"string\") throw Error(\"Provide a YouTube URL\");\n  const v = video.trim();\n  let id;\n  if (/^[A-Za-z0-9_-]{11}$/.test(v)) id = v;\n  else {\n    let m = v.match(/^https?:\\/\\/(?:www\\.|m\\.)?youtube\\.com\\/watch\\?([^#]*)/i);\n    if (m)\n      id = m[1]\n        .split(\"&\")\n        .find((x) => x.startsWith(\"v=\"))\n        ?.slice(2);\n    else\n      id =\n        v.match(\n          /^https?:\\/\\/(?:www\\.|m\\.)?youtube\\.com\\/(?:shorts|embed|live)\\/([A-Za-z0-9_-]{11})(?:[?#/]|$)/i,\n        )?.[1] ?? v.match(/^https?:\\/\\/(?:www\\.)?youtu\\.be\\/([A-Za-z0-9_-]{11})(?:[?#/]|$)/i)?.[1];\n  }\n  if (!/^[A-Za-z0-9_-]{11}$/.test(id ?? \"\"))\n    throw Error(\"Provide a supported YouTube video URL or ID\");\n  return { videoId: id };\n}\n"
      },
      "n_55c26beaadf11fbe": {
        "name": "Clean the transcript",
        "imports": [],
        "source": "export default function main({ requestedId, videoId, transcript }) {\n  if (videoId !== requestedId) throw Error(\"Transcript belongs to another video\");\n  if (typeof transcript !== \"string\" || !transcript.trim()) throw Error(\"No transcript available\");\n  return {\n    videoId,\n    transcript: transcript\n      .replace(/\\s+/g, \" \")\n      .replace(/\\s([.,!?])/g, \"$1\")\n      .trim(),\n  };\n}\n"
      }
    }
