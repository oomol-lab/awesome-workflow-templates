    "modules": {
      "n_a365d5ae42b4a7bb": {
        "name": "Choose yesterday’s orders",
        "imports": [],
        "source": "export default function window({ scheduledAt, overrideDay }) {\n  const n = new Date(scheduledAt);\n  if (!Number.isFinite(n.getTime())) throw Error(\"Invalid schedule time\");\n  if (typeof overrideDay !== \"string\") throw Error(\"Invalid replay date\");\n  let start, end;\n  if (overrideDay) {\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(overrideDay)) throw Error(\"Replay date must be YYYY-MM-DD\");\n    start = new Date(overrideDay + \"T00:00:00.000Z\");\n    if (!Number.isFinite(start.getTime()) || start.toISOString().slice(0, 10) !== overrideDay)\n      throw Error(\"Invalid replay date\");\n    end = new Date(start.getTime() + 86400000);\n  } else {\n    end = new Date(Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate()));\n    start = new Date(end.getTime() - 86400000);\n  }\n  const search =\n    \"created_at:>='\" + start.toISOString() + \"' created_at:<'\" + end.toISOString() + \"'\";\n  return { search, variables: { query: search } };\n}\n"
      },
      "n_758ac68683108d2d": {
        "name": "Select campaign orders",
        "imports": [],
        "source": "export default function plan({ data }) {\n  if (\n    !data ||\n    !data.orders ||\n    !Array.isArray(data.orders.edges) ||\n    !data.orders.pageInfo ||\n    typeof data.orders.pageInfo.hasNextPage !== \"boolean\"\n  )\n    throw Error(\"Invalid Shopify order response\");\n  const rows = [];\n  for (const edge of data.orders.edges) {\n    const o = edge?.node;\n    if (!o || typeof o.id !== \"string\" || !o.id || typeof o.name !== \"string\" || !o.name)\n      throw Error(\"Invalid Shopify order\");\n    if (!Object.hasOwn(o, \"customerJourneySummary\")) throw Error(\"Missing Shopify journey\");\n    const j = o.customerJourneySummary;\n    if (j === null) continue;\n    if (typeof j !== \"object\" || Array.isArray(j) || typeof j.ready !== \"boolean\" || !j.ready)\n      throw Error(\"Shopify attribution is not ready\");\n    if (!Object.hasOwn(j, \"firstVisit\")) throw Error(\"Missing first visit\");\n    if (j.firstVisit === null) continue;\n    if (\n      typeof j.firstVisit !== \"object\" ||\n      Array.isArray(j.firstVisit) ||\n      !Object.hasOwn(j.firstVisit, \"utmParameters\")\n    )\n      throw Error(\"Invalid first visit\");\n    const u = j.firstVisit.utmParameters;\n    if (u === null) continue;\n    if (typeof u !== \"object\" || Array.isArray(u)) throw Error(\"Invalid UTM parameters\");\n    if (!Object.hasOwn(u, \"campaign\") || !(typeof u.campaign === \"string\" || u.campaign === null))\n      throw Error(\"Invalid campaign\");\n    if (u.campaign === null) continue;\n    for (const key of [\"content\", \"medium\", \"source\"])\n      if (!Object.hasOwn(u, key) || !(typeof u[key] === \"string\" || u[key] === null))\n        throw Error(\"Invalid UTM \" + key);\n    const money = o.totalReceivedSet?.shopMoney;\n    if (\n      !money ||\n      typeof money.amount !== \"string\" ||\n      !/^\\d+(?:\\.\\d+)?$/.test(money.amount) ||\n      typeof money.currencyCode !== \"string\" ||\n      !/^[A-Z]{3}$/.test(money.currencyCode)\n    )\n      throw Error(\"Invalid order amount\");\n    rows.push({\n      order: o.name,\n      campaign: u.campaign,\n      content: u.content ?? \"\",\n      medium: u.medium ?? \"\",\n      source: u.source ?? \"\",\n      revenue: money.amount,\n      currency: money.currencyCode,\n    });\n  }\n  return { rows, truncated: data.orders.pageInfo.hasNextPage };\n}\n"
      },
      "n_fa4247aee83ac754": {
        "name": "Prepare the next Baserow row",
        "imports": [],
        "source": "export default function next({ rows, previous }) {\n  const i = previous?.index ?? 0;\n  if (!Array.isArray(rows) || !Number.isSafeInteger(i) || i < 0 || i > rows.length)\n    throw Error(\"Invalid order state\");\n  if (i === rows.length) return { state: { index: i }, more: false, row: {}, count: i };\n  const r = rows[i];\n  return {\n    state: { index: i + 1 },\n    more: true,\n    row: {\n      Order: r.order,\n      Campaign: r.campaign,\n      Content: r.content,\n      Medium: r.medium,\n      Source: r.source,\n      Revenue: r.revenue,\n      Currency: r.currency,\n    },\n    count: i,\n  };\n}\n"
      },
      "n_a4960080df180916": {
        "name": "Confirm the Baserow row",
        "imports": [],
        "source": "export default function confirm({ row }) {\n  if (!row || !Number.isSafeInteger(row.id) || row.id <= 0)\n    throw Error(\"Baserow did not confirm the row\");\n  return { ok: true };\n}\n"
      }
    }
