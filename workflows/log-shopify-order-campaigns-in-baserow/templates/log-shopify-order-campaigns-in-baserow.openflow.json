    "modules": {
      "n_a365d5ae42b4a7bb": {
        "name": "Choose yesterday’s orders",
        "imports": [],
        "source": "export default function window({scheduledAt,overrideDay}){const n=new Date(scheduledAt);if(!Number.isFinite(n.getTime()))throw Error('Invalid schedule time');if(typeof overrideDay!=='string')throw Error('Invalid replay date');let start,end;if(overrideDay){if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(overrideDay))throw Error('Replay date must be YYYY-MM-DD');start=new Date(overrideDay+'T00:00:00.000Z');if(!Number.isFinite(start.getTime())||start.toISOString().slice(0,10)!==overrideDay)throw Error('Invalid replay date');end=new Date(start.getTime()+86400000);}else{end=new Date(Date.UTC(n.getUTCFullYear(),n.getUTCMonth(),n.getUTCDate()));start=new Date(end.getTime()-86400000)}const search=\"created_at:>='\"+start.toISOString()+\"' created_at:<'\"+end.toISOString()+\"'\";return{search,variables:{query:search}};}\n"
      },
      "n_758ac68683108d2d": {
        "name": "Select campaign orders",
        "imports": [],
        "source": "export default function plan({data}){\n if(!data||!data.orders||!Array.isArray(data.orders.edges)||!data.orders.pageInfo||typeof data.orders.pageInfo.hasNextPage!=='boolean')throw Error('Invalid Shopify order response');const rows=[];\n for(const edge of data.orders.edges){const o=edge?.node;if(!o||typeof o.id!=='string'||!o.id||typeof o.name!=='string'||!o.name)throw Error('Invalid Shopify order');if(!Object.hasOwn(o,'customerJourneySummary'))throw Error('Missing Shopify journey');const j=o.customerJourneySummary;if(j===null)continue;if(typeof j!=='object'||Array.isArray(j)||typeof j.ready!=='boolean'||!j.ready)throw Error('Shopify attribution is not ready');if(!Object.hasOwn(j,'firstVisit'))throw Error('Missing first visit');if(j.firstVisit===null)continue;if(typeof j.firstVisit!=='object'||Array.isArray(j.firstVisit)||!Object.hasOwn(j.firstVisit,'utmParameters'))throw Error('Invalid first visit');const u=j.firstVisit.utmParameters;if(u===null)continue;if(typeof u!=='object'||Array.isArray(u))throw Error('Invalid UTM parameters');if(!Object.hasOwn(u,'campaign')||!(typeof u.campaign==='string'||u.campaign===null))throw Error('Invalid campaign');if(u.campaign===null)continue;for(const key of ['content','medium','source'])if(!Object.hasOwn(u,key)||!(typeof u[key]==='string'||u[key]===null))throw Error('Invalid UTM '+key);const money=o.totalReceivedSet?.shopMoney;if(!money||typeof money.amount!=='string'||!/^\\d+(?:\\.\\d+)?$/.test(money.amount)||typeof money.currencyCode!=='string'||!/^[A-Z]{3}$/.test(money.currencyCode))throw Error('Invalid order amount');rows.push({order:o.name,campaign:u.campaign,content:u.content??'',medium:u.medium??'',source:u.source??'',revenue:money.amount,currency:money.currencyCode});}\n return{rows,truncated:data.orders.pageInfo.hasNextPage};\n}\n"
      },
      "n_fa4247aee83ac754": {
        "name": "Prepare the next Baserow row",
        "imports": [],
        "source": "export default function next({rows,previous}){const i=previous?.index??0;if(!Array.isArray(rows)||!Number.isSafeInteger(i)||i<0||i>rows.length)throw Error('Invalid order state');if(i===rows.length)return{state:{index:i},more:false,row:{},count:i};const r=rows[i];return{state:{index:i+1},more:true,row:{Order:r.order,Campaign:r.campaign,Content:r.content,Medium:r.medium,Source:r.source,Revenue:r.revenue,Currency:r.currency},count:i};}\n"
      },
      "n_a4960080df180916": {
        "name": "Confirm the Baserow row",
        "imports": [],
        "source": "export default function confirm({row}){if(!row||!Number.isSafeInteger(row.id)||row.id<=0)throw Error('Baserow did not confirm the row');return{ok:true};}\n"
      }
    }
