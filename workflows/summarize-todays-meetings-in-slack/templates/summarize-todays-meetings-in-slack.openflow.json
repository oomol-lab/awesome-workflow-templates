    "modules": {
      "n_6af98fb5ac5320ac": {
        "name": "Prepare today’s UTC range",
        "imports": [],
        "source": "export default function ({ calendarId }) {\n  const day = new Date().toISOString().slice(0, 10);\n  return {\n    day,\n    endpoint: \"/calendars/\" + encodeURIComponent(calendarId) + \"/events\",\n    query: { timeMin: day + \"T00:00:00Z\", timeMax: day + \"T23:59:59Z\", maxResults: 50 },\n  };\n}\n"
      },
      "n_a00a14840665f9ab": {
        "name": "Prepare meeting data",
        "imports": [],
        "source": "export default function ({ body, statusCode }) {\n  if (statusCode < 200 || statusCode >= 300) throw Error(\"Calendar request failed\");\n  if (body?.items != null && !Array.isArray(body.items)) throw Error(\"Invalid calendar response\");\n  return { events: JSON.stringify(body?.items ?? []) };\n}\n"
      },
      "n_45dbc786ae9d1ad8": {
        "name": "Prepare Slack digest",
        "imports": [],
        "source": "export default function ({ summary }) {\n  if (!summary.trim()) throw Error(\"Empty digest\");\n  return { text: \"Meeting digest: \" + summary.trim() };\n}\n"
      },
      "n_ac3d91c461d86852": {
        "name": "Reserve Slack post",
        "imports": [],
        "source": "export default async function ({ day }, ctx) {\n  const key = \"meeting-digest:\" + day,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect pending Slack post: \" + key);\n  if (s?.status === \"done\") return { key, send: false };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_1e347b39d03fe11d": {
        "name": "Confirm Slack post",
        "imports": [],
        "source": "export default async function ({ key, ts }, ctx) {\n  if (!ts) throw Error(\"Unknown Slack result\");\n  await ctx.state.set(key, { status: \"done\", ts });\n  return { ok: true };\n}\n"
      }
    }
