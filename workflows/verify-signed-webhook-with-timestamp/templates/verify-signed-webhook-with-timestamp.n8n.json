{
  "name": "Verify a Signed Webhook with Timestamp",
  "description": "Verifies an HMAC-SHA256 signature against the exact raw JSON webhook body, checks a signed timestamp window and event ID, and returns a generic 401 before any business logic runs.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
