    "modules": {
      "n_37ee8e587ebdb802": {
        "name": "Prepare failure details",
        "imports": [],
        "source": "export default function prepare({workflow,execution,error}){if(typeof workflow?.name!=='string'||!workflow.name||typeof execution?.runId!=='string'||!execution.runId||typeof error?.message!=='string')throw Error('Missing failure details');const name=workflow.name.replace(/[\\r\\n]+/g,' '),node=typeof error.nodeId==='string'&&error.nodeId?error.nodeId:'not available',job=typeof error.jobId==='string'&&error.jobId?error.jobId:'not available',path=Array.isArray(error.path)?JSON.stringify(error.path):'not available';return{subject:'Error in workflow: '+name,body:`Workflow: ${workflow.name}\\nRun ID: ${execution.runId}\\nNode ID: ${node}\\nJob ID: ${job}\\nPath: ${path}\\nError code: ${error.code}\\nError message: ${error.message}`};}\n"
      }
