{
  "name": "Travis CI Build Request",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        510,
        350
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "travisci-build-request-0"
    },
    {
      "name": "Request Travis CI build",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        710,
        350
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.travis-ci.com/repo/YOUR_OWNER%2FYOUR_REPOSITORY/requests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Travis-API-Version",
              "value": "3"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"request\":{\"branch\":\"YOUR_BRANCH\"}}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": false
            }
          }
        }
      },
      "typeVersion": 4.2,
      "id": "travisci-build-request-1"
    },
    {
      "id": "travisci-build-request-check",
      "name": "Confirm accepted build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function readTravisAcceptance(body, statusCode) {\n  if (\n    statusCode !== 202 ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body[\"@type\"] !== \"pending\" ||\n    !body.request ||\n    typeof body.request !== \"object\" ||\n    !Number.isSafeInteger(body.request.id) ||\n    body.request.id < 1\n  )\n    throw new Error(\"Travis CI did not confirm an accepted build request\");\n  return body;\n}\nfunction travisCiResult({ body, statusCode }) {\n  return { acceptance: readTravisAcceptance(body, statusCode) };\n}\n\nreturn { json: readTravisAcceptance($json.body, $json.statusCode) };\n"
      }
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Request Travis CI build",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Travis CI build": {
      "main": [
        [
          {
            "node": "Confirm accepted build request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
