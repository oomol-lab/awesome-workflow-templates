    "modules": {
      "n_a447aab349aaa9da": {
        "name": "Prepare repository build request",
        "imports": [],
        "source": "export default function travisCiRequest({ repositorySlug, branch }) {\n  if (\n    typeof repositorySlug !== \"string\" ||\n    !/^[^\\s/\\\\]+\\/[^\\s/\\\\]+$/.test(repositorySlug) ||\n    repositorySlug.split(\"/\").some((part) => part === \".\" || part === \"..\")\n  )\n    throw new Error(\"Enter a repository slug in owner/repository form\");\n  if (\n    typeof branch !== \"string\" ||\n    branch.trim().length === 0 ||\n    /[\\u0000-\\u001f\\u007f]/.test(branch)\n  )\n    throw new Error(\"Enter a branch to build\");\n  return {\n    url: \"https://api.travis-ci.com/repo/\" + encodeURIComponent(repositorySlug) + \"/requests\",\n    body: { request: { branch } },\n  };\n}\n"
      },
      "n_35d4e35e6660264b": {
        "name": "Confirm accepted build request",
        "imports": [],
        "source": "function readTravisAcceptance(body, statusCode) {\n  if (\n    statusCode !== 202 ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body[\"@type\"] !== \"pending\" ||\n    !body.request ||\n    typeof body.request !== \"object\" ||\n    !Number.isSafeInteger(body.request.id) ||\n    body.request.id < 1\n  )\n    throw new Error(\"Travis CI did not confirm an accepted build request\");\n  return body;\n}\nexport default function travisCiResult({ body, statusCode }) {\n  return { acceptance: readTravisAcceptance(body, statusCode) };\n}\n"
      }
    }
