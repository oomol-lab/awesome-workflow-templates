    "modules": {
      "n_6ec2bda14bbd0905": {
        "name": "Format order notification",
        "imports": [],
        "source": "export default function orderMessage({ body }) {\n  const isHttpLink = (value) => {\n    const parts = typeof value === 'string' && /^https?:\\/\\/(\\[[0-9a-f:.]+\\]|[^\\s/\\\\?#@:%\\[\\]<>\"`]+)(?::(\\d{1,5}))?(?:[/?#][^\\s\\\\]*)?$/i.exec(value);\n    return Boolean(parts && !/[\\u0000-\\u0020\\u007f]/.test(value) && (!parts[2] || Number(parts[2]) <= 65535));\n  };\n  const escape = (text) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  if (!Number.isSafeInteger(body.id) || body.id < 1) throw new Error('WooCommerce order ID is missing or invalid');\n  for (const field of ['status', 'total', 'currency', 'date_created', 'transaction_id']) if (typeof body[field] !== 'string') throw new Error('WooCommerce order is missing ' + field);\n  const href = body._links?.self?.[0]?.href;\n  if (typeof href !== 'string') throw new Error('WooCommerce order self link is missing');\n  if (!isHttpLink(href)) throw new Error('Order link must be an HTTP(S) URL without credentials');\n  const money = typeof body.currency_symbol === 'string' && body.currency_symbol ? body.currency_symbol + body.total : body.currency + ' ' + body.total;\n  const footer = '*Ordered:* ' + escape(body.date_created) + ' | *Transaction ID:* ' + escape(body.transaction_id);\n  if (footer.length > 300) throw new Error('Order metadata exceeds Slack footer size');\n  const text = ':sparkles: There is a new order :sparkles:';\n  return { text, attachments: [{ color: '#66FF00', fallback: text, fields: [\n    { title: 'Order ID', value: String(body.id), short: true },\n    { title: 'Status', value: escape(body.status), short: true },\n    { title: 'Total', value: escape(money), short: true },\n    { title: 'Link', value: escape(href), short: false },\n  ], footer }] };\n}\n"
      },
      "n_81337928a2678d1f": {
        "name": "Read order total and status",
        "imports": [],
        "source": "export default function orderAmount({ body }) {\n  if (typeof body.total !== 'string' || !/^\\d+(?:\\.\\d+)?$/.test(body.total) || !Number.isFinite(Number(body.total))) throw new Error('WooCommerce order total must be a nonnegative decimal string');\n  if (typeof body.status !== 'string' || !body.status) throw new Error('WooCommerce order status is missing');\n  return { total: Number(body.total), status: body.status };\n}\n"
      }
