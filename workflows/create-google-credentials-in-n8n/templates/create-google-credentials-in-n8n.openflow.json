    "modules": {
      "n_a3ced00881f7809b": {
        "name": "Select Google service",
        "imports": [],
        "source": "export default function next({ previous }) {\n  const types = [\n      \"googleDocsOAuth2Api\",\n      \"googleSheetsOAuth2Api\",\n      \"googleSlidesOAuth2Api\",\n      \"googleDriveOAuth2Api\",\n      \"gmailOAuth2\",\n      \"googleCalendarOAuth2Api\",\n      \"googleContactsOAuth2Api\",\n    ],\n    index = previous?.index ?? 0,\n    created = previous?.created ?? [];\n  return {\n    more: index < types.length,\n    type: types[index] ?? \"\",\n    state: { index: index + 1, created },\n    created,\n  };\n}\n"
      },
      "n_3d50deba7d6fd9df": {
        "name": "Create n8n credential",
        "imports": [],
        "source": "export default async function create(\n  { type, email, clientId, clientSecret, apiKey, baseUrl, state },\n  context,\n) {\n  if (!email || !clientId || !clientSecret || !apiKey || !baseUrl || baseUrl.includes(\"YOUR_\"))\n    throw Error(\"Configure email, n8n URL and secret Variables\");\n  let url = new URL(baseUrl);\n  if (url.protocol !== \"https:\") throw Error(\"Configure an HTTPS n8n URL\");\n  url.pathname = url.pathname.replace(/\\/$/, \"\") + \"/api/v1/credentials\";\n  url.search = \"\";\n  url.hash = \"\";\n  let r;\n  try {\n    r = await context.fetch(url.href, {\n      method: \"POST\",\n      headers: { \"X-N8N-API-KEY\": apiKey, \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ name: `${email} - ${type}`, type, data: { clientId, clientSecret } }),\n    });\n  } catch {\n    throw Error(\"Credential creation result is unknown; inspect n8n before rerunning\");\n  }\n  if (!r.ok) throw Error(\"n8n rejected credential creation; inspect n8n before rerunning\");\n  const value = await r.json();\n  if (!value?.id) throw Error(\"n8n did not return a credential ID; inspect before rerunning\");\n  return {\n    state: {\n      ...state,\n      created: [\n        ...state.created,\n        { id: String(value.id), name: value.name ?? `${email} - ${type}`, type },\n      ],\n    },\n  };\n}\n"
      }
    }
