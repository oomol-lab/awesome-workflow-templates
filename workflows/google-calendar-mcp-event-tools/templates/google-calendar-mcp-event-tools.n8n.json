    {
      "name": "Validate tool input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json,\n  ops = [\"SearchEvent\", \"CreateEvent\", \"UpdateEvent\", \"DeleteEvent\"];\nif (!ops.includes(x.operation)) throw Error(\"Unknown operation\");\nif (x.operation !== \"SearchEvent\" && !/^[A-Za-z0-9_-]{1,100}$/.test(x.requestId || \"\"))\n  throw Error(\"Unique requestId required\");\nif ([\"UpdateEvent\", \"DeleteEvent\"].includes(x.operation) && !x.eventId)\n  throw Error(\"Event ID required\");\nif (\n  [\"CreateEvent\", \"UpdateEvent\"].includes(x.operation) &&\n  (!Number.isFinite(Date.parse(x.start)) ||\n    !Number.isFinite(Date.parse(x.end)) ||\n    Date.parse(x.end) <= Date.parse(x.start))\n)\n  throw Error(\"Valid start/end required\");\nconst limit = Number(x.limit || 10);\nif (!Number.isInteger(limit) || limit < 1 || limit > 250) throw Error(\"Invalid limit\");\nreturn {\n  json: {\n    ...x,\n    limit,\n    fingerprint: JSON.stringify({\n      op: x.operation,\n      id: x.eventId || \"\",\n      start: x.start || \"\",\n      end: x.end || \"\",\n      title: x.title,\n      description: x.description,\n    }),\n    mode: \"direct\",\n    relayUrl: \"YOUR_OPEN_FLOW_WEBHOOK_URL\",\n  },\n};\n"
      },
      "id": "google-calendar-mcp-event-tools-6"
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.mode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "google-calendar-mcp-event-tools-7"
    },
    {
      "name": "Forward tool request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.relayUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {operation:$json.operation,requestId:$json.requestId,eventId:$json.eventId,start:$json.start,end:$json.end,title:$json.title,description:$json.description,after:$json.after,before:$json.before,limit:$json.limit} }}",
        "options": {}
      },
      "id": "google-calendar-mcp-event-tools-8"
    },
    {
      "name": "Search?",
      "type": "n8n-nodes-base.if",
