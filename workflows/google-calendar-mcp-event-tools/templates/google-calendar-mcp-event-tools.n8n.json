        },
        "returnAll": false,
        "limit": "={{ $('Validate tool input').item.json.limit }}",
        "timeMin": "={{ $('Validate tool input').item.json.after }}",
        "timeMax": "={{ $('Validate tool input').item.json.before }}",
        "options": {}
      },
      "typeVersion": 1.3,
      "alwaysOutputData": true
    },
    {
      "name": "Collect search results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  {\n    json: {\n      response: $input\n        .all()\n        .map((x) => x.json)\n        .filter((x) => x.id),\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "google-calendar-mcp-event-tools-18"
    },
    {
      "id": "google-calendar-mcp-event-tools-19",
      "name": "Execute CreateEvent",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        520,
        260
      ],
      "parameters": {
        "end": "={{ $('Validate tool input').item.json.end }}",
        "start": "={{ $('Validate tool input').item.json.start }}",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CALENDAR_ID"
