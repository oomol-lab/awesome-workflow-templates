    },
    {
      "name": "Read write checkpoint",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'calendar-mcp:' + $('Validate tool input').item.json.operation + ':' + $('Validate tool input').item.json.requestId }}"
            }
          ]
        },
        "operation": "get"
      },
      "alwaysOutputData": true,
      "id": "google-calendar-mcp-event-tools-10"
    },
    {
      "name": "Inspect write checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input.all();\nif (a.length !== 1) throw Error(\"Duplicate checkpoint\");\nconst s = a[0].json.status;\nif (s && a[0].json.fingerprint !== $(\"Validate tool input\").item.json.fingerprint)\n  throw Error(\"Request ID reused with different input\");\nif (s && s !== \"done\") throw Error(\"Inspect pending write before retry\");\nreturn [{ json: { done: s === \"done\" }, pairedItem: { item: 0 } }];\n"
      },
      "id": "google-calendar-mcp-event-tools-11"
    },
    {
      "name": "Write confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "google-calendar-mcp-event-tools-12"
    },
    {
      "name": "Reserve calendar write",
