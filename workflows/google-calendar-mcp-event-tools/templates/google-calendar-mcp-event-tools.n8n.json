    {
      "name": "Receive tool call",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "google-calendar-mcp-event-tools-5"
