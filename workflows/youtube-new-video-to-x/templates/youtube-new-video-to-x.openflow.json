    "modules": {
      "n_139cabfa28f5cc19": {
        "name": "Set channel and time window",
        "imports": [],
        "source": "export default function search({ channelId }) {\n  if (typeof channelId !== \"string\" || !channelId.trim() || channelId === \"YOUR_YOUTUBE_CHANNEL_ID\")\n    throw Error(\"Configure your YouTube channel ID\");\n  return { channelId: channelId.trim(), after: new Date(Date.now() - 30 * 60000).toISOString() };\n}\n"
      },
      "n_fb91f41b16038146": {
        "name": "Read the video",
        "imports": [],
        "source": "export default function video({ body, statusCode }) {\n  if (statusCode !== 200 || !body || !Array.isArray(body.items))\n    throw Error(\"YouTube search failed or returned invalid items\");\n  if (body.items.length === 0) return { found: false, prompt: \"\", videoId: \"\" };\n  if (body.items.length !== 1) throw Error(\"YouTube returned more than one video\");\n  const v = body.items[0],\n    id = v?.id?.videoId,\n    title = v?.snippet?.title,\n    description = v?.snippet?.description;\n  if (typeof id !== \"string\" || !id || typeof title !== \"string\" || typeof description !== \"string\")\n    throw Error(\"YouTube result lacks video fields\");\n  return {\n    found: true,\n    videoId: id,\n    prompt: `Write an engaging post about my latest YouTube video for X (Twitter) of no more than 140 characters in length. Link to the video at https://youtu.be/${id} use this title and description: ${title} ${description}`,\n  };\n}\n"
      },
      "n_348f56b446b9e8c2": {
        "name": "Confirm the post",
        "imports": [],
        "source": "export default function result({ found, id, text, videoId }) {\n  if (!found) return { result: { posted: false } };\n  if (typeof id !== \"string\" || !id || typeof text !== \"string\")\n    throw Error(\"X did not confirm the post; inspect the account before retrying\");\n  return { result: { posted: true, videoId, id, text } };\n}\n"
      },
      "n_b7f26980de5c7414": {
        "name": "No recent video",
        "imports": [],
        "source": "export default function empty() {\n  return { result: { posted: false } };\n}\n"
      }
    }
