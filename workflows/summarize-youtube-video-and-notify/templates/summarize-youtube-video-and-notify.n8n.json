        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ \"youtube-notice:\" + $(\"Combine transcript\").item.json.id }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "typeVersion": 1,
