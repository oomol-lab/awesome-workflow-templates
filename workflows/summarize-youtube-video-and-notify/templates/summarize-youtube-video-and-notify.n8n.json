    {
      "name": "Inspect Telegram notice",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect Telegram before retry\");\nreturn { json: { done: $json.status === \"done\" } };\n"
      },
      "typeVersion": 2,
      "id": "summarize-youtube-video-and-notify-11",
