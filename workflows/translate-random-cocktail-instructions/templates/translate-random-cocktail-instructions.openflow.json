    "modules": {
      "n_c7728fff5d86014b": {
        "name": "Prepare CocktailDB URL",
        "imports": [],
        "source": "export default function hop({ initialUrl, previousState }) {\n  const candidate = previousState?.nextUrl || initialUrl;\n  let url;\n  try {\n    url = new URL(candidate);\n  } catch {\n    throw Error(\"Configure a valid HTTP or HTTPS target URL\");\n  }\n  if (![\"http:\", \"https:\"].includes(url.protocol) || url.username || url.password)\n    throw Error(\"Configure an HTTP or HTTPS URL without credentials\");\n  return { url: url.toString() };\n}\n"
      },
      "n_babf9690b95b5251": {
        "name": "Select the instructions",
        "imports": [],
        "source": "export default function check({ url, statusCode, headers, body, previousState }) {\n  const hops = previousState?.hops ?? 0;\n  if (\n    !Number.isInteger(statusCode) ||\n    statusCode < 100 ||\n    statusCode > 599 ||\n    !Number.isInteger(hops) ||\n    hops < 0\n  )\n    throw Error(\"Invalid response\");\n  if (\n    statusCode >= 300 &&\n    statusCode < 400 &&\n    typeof headers?.location === \"string\" &&\n    headers.location\n  ) {\n    if (hops >= 21) throw Error(\"Too many redirects\");\n    let target;\n    try {\n      target = new URL(headers.location, url);\n    } catch {\n      throw Error(\"Invalid redirect\");\n    }\n    if (![\"http:\", \"https:\"].includes(target.protocol) || target.username || target.password)\n      throw Error(\"Invalid redirect\");\n    return {\n      state: { hops: hops + 1, nextUrl: target.toString() },\n      redirect: true,\n      text: \"redirect\",\n    };\n  }\n  if (statusCode < 200 || statusCode >= 300) throw Error(\"Cocktail API request failed\");\n  let data;\n  try {\n    data = JSON.parse(body);\n  } catch {\n    throw Error(\"Invalid cocktail JSON\");\n  }\n  const text = data?.drinks?.[0]?.strInstructions;\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Missing cocktail instructions\");\n  return { state: { hops, nextUrl: \"\" }, redirect: false, text };\n}\n"
      },
      "n_963da9825e738c70": {
        "name": "Read the translation",
        "imports": [],
        "source": "export default function result({ translations, text }) {\n  if (\n    !Array.isArray(translations) ||\n    translations.length !== 1 ||\n    typeof translations[0]?.translatedText !== \"string\"\n  )\n    throw Error(\"Translation was not returned\");\n  return { sourceInstructions: text, italianInstructions: translations[0].translatedText };\n}\n"
      }
    }
