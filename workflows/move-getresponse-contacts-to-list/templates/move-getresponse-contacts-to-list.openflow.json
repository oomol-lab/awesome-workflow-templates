    "modules": {
      "n_82a65732d30e538f": {
        "name": "Collect all contact pages",
        "imports": [],
        "source": "export default function collect({contacts,pagination,previousState}) {const s=previousState??{records:[],page:0,totalPages:null,totalCount:null};if(!Array.isArray(contacts)||!Array.isArray(s.records)||!pagination)throw Error('Invalid contact page');const {currentPage,totalPages,totalCount}=pagination;if(!Number.isInteger(currentPage)||!Number.isInteger(totalPages)||!Number.isInteger(totalCount)||currentPage!==s.page+1||totalPages<0||totalCount<0||(s.totalPages!==null&&(s.totalPages!==totalPages||s.totalCount!==totalCount))||(totalPages===0&&(currentPage!==1||contacts.length!==0||totalCount!==0))||(totalPages>0&&currentPage>totalPages))throw Error('Inconsistent pagination');const records=[...s.records,...contacts];if(records.length>totalCount||(!contacts.length&&currentPage<totalPages))throw Error('Incomplete contact page');const more=currentPage<totalPages;if(!more&&records.length!==totalCount)throw Error('Contact total changed during reading');return{state:{records,page:currentPage,totalPages,totalCount},more,nextPage:currentPage+1};}\n"
      },
      "n_dbb8731a0ac51163": {
        "name": "Select contacts to move",
        "imports": [],
        "source": "export default function plan({state,campaign,targetCampaignId}){if(typeof targetCampaignId!=='string'||!targetCampaignId.trim()||targetCampaignId==='YOUR_CAMPAIGN_ID'||campaign?.campaignId!==targetCampaignId||typeof campaign.name!=='string'||!campaign.name)throw Error('Configure a valid target campaign');if(!Array.isArray(state?.records))throw Error('Invalid contact list');const ids=[],seen=new Set();for(const c of state.records){if(typeof c?.contactId!=='string'||!c.contactId||!c.campaign||typeof c.campaign.name!=='string'||typeof c.campaign.campaignId!=='string')throw Error('Contact lacks campaign identity');if(seen.has(c.contactId))throw Error('Duplicate contact in paginated list');seen.add(c.contactId);if(c.campaign.name!==campaign.name)ids.push(c.contactId);}return{ids,targetCampaignId};}\n"
      },
      "n_d5c4c22a3fea1571": {
        "name": "Prepare next contact",
        "imports": [],
        "source": "export default function next({ids,targetCampaignId,previousState}){const i=previousState?.index??0;if(!Array.isArray(ids)||!Number.isInteger(i)||i<0||i>ids.length)throw Error('Invalid update position');return{state:{index:i+1},more:i<ids.length,contactId:ids[i]??'unused',campaignId:targetCampaignId};}\n"
      },
      "n_2b516d0d63c0dd60": {
        "name": "Move contact",
        "imports": [],
        "source": "export default async function move({contactId,campaignId},context){return await context.actions.call('getresponse.update_contact',{contactId,campaignId});}\n"
      }
