    "modules": {
      "n_6a1400589c8b7249": {
        "name": "Prepare the request",
        "imports": [],
        "source": "export default function setup({ instanceUrl, url, title }) {\n  let instance, target;\n  try {\n    instance = new URL(instanceUrl);\n    target = new URL(url);\n  } catch {\n    throw Error(\"Enter valid instance and target URLs\");\n  }\n  if (\n    instance.protocol !== \"https:\" ||\n    instance.username ||\n    instance.password ||\n    instance.search ||\n    instance.hash ||\n    ![\"http:\", \"https:\"].includes(target.protocol) ||\n    target.username ||\n    target.password\n  )\n    throw Error(\"Use an HTTPS instance URL and an HTTP(S) target URL\");\n  if (typeof title !== \"string\" || !title.trim()) throw Error(\"Enter a title\");\n  const endpoint = instance.toString().replace(/\\/+$/, \"\") + \"/yourls-api.php\",\n    q = new URLSearchParams({\n      action: \"shorturl\",\n      format: \"json\",\n      url: target.toString(),\n      title: title.trim(),\n    });\n  return { endpoint, url: endpoint + \"?\" + q.toString() };\n}\n"
      },
      "n_de0a7727a87c6403": {
        "name": "Prepare statistics request",
        "imports": [],
        "source": "export default function created({ body, endpoint }) {\n  if (!body || body.status === \"fail\" || typeof body.shorturl !== \"string\")\n    throw Error(\"YOURLS did not return a short URL\");\n  let u;\n  try {\n    u = new URL(body.shorturl);\n  } catch {\n    throw Error(\"YOURLS returned an invalid short URL\");\n  }\n  if (![\"https:\", \"http:\"].includes(u.protocol))\n    throw Error(\"YOURLS returned an invalid short URL\");\n  const q = new URLSearchParams({ action: \"url-stats\", format: \"json\", shorturl: body.shorturl });\n  return { url: endpoint + \"?\" + q.toString() };\n}\n"
      },
      "n_ec7e9c0829fff8ce": {
        "name": "Return link statistics",
        "imports": [],
        "source": "export default function stats({ body }) {\n  if (\n    !body ||\n    body.status === \"fail\" ||\n    !body.link ||\n    typeof body.link !== \"object\" ||\n    Array.isArray(body.link)\n  )\n    throw Error(\"YOURLS did not return link statistics\");\n  return { link: body.link };\n}\n"
      }
    }
