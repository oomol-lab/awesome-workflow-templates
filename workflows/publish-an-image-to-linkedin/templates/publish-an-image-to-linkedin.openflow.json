    "modules": {
      "n_c6b000b46cf8e147": {
        "name": "Configure the post",
        "imports": [],
        "source": "export default function prepare({ person, text }) {\n  if (!person || person.startsWith(\"YOUR_\") || !text)\n    throw Error(\"Configure the LinkedIn person URN and post text\");\n  if (!person.startsWith(\"urn:li:person:\")) throw Error(\"Expected a LinkedIn person URN\");\n  return { person, text, body: { initializeUploadRequest: { owner: person } } };\n}\n"
      },
      "n_dbb209fa513097d1": {
        "name": "Download and upload image",
        "imports": [],
        "source": "export default async function upload({ statusCode, body, imageUrl, token }, context) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    typeof body?.value?.image !== \"string\" ||\n    typeof body?.value?.uploadUrl !== \"string\"\n  )\n    throw Error(\"LinkedIn did not initialize the image upload\");\n  const image = new URL(imageUrl),\n    target = new URL(body.value.uploadUrl);\n  if (image.protocol !== \"https:\" || image.hostname !== \"example.com\")\n    throw Error(\"Configure the image host in this step and its HTTP capability\");\n  if (\n    target.protocol !== \"https:\" ||\n    target.hostname !== \"www.linkedin.com\" ||\n    !target.pathname.startsWith(\"/dms-uploads/\")\n  )\n    throw Error(\"Unexpected LinkedIn upload address\");\n  if (!token || token.startsWith(\"YOUR_\")) throw Error(\"Configure the LinkedIn upload token\");\n  const source = await context.fetch(image.href);\n  if (!source.ok) throw Error(\"Image download failed\");\n  const bytes = await source.arrayBuffer();\n  if (!bytes.byteLength) throw Error(\"Image is empty\");\n  let uploaded;\n  try {\n    uploaded = await context.fetch(target.href, {\n      method: \"PUT\",\n      headers: { authorization: \"Bearer \" + token, \"content-type\": \"application/octet-stream\" },\n      body: bytes,\n    });\n  } catch {\n    throw Error(\"Image upload outcome is unknown; inspect LinkedIn before retrying\");\n  }\n  if (!uploaded.ok) throw Error(\"Image upload failed; inspect LinkedIn before retrying\");\n  return { image: body.value.image };\n}\n"
      },
      "n_b3152d21ff10389a": {
        "name": "Check image processing",
        "imports": [],
        "source": "export default async function status({ image, token, previous }, context) {\n  const count = (previous ?? 0) + 1;\n  const r = await context.fetch(\n    \"https://api.linkedin.com/rest/images/\" + encodeURIComponent(image),\n    { headers: { authorization: \"Bearer \" + token, \"x-restli-protocol-version\": \"2.0.0\" } },\n  );\n  if (!r.ok) throw Error(\"Cannot verify LinkedIn image processing\");\n  const body = await r.json();\n  if (body.id !== image) throw Error(\"LinkedIn returned a different image\");\n  if (body.status === \"AVAILABLE\") return { available: true, count };\n  if (body.status !== \"PROCESSING\" && body.status !== \"WAITING_UPLOAD\")\n    throw Error(\"LinkedIn image processing failed or returned an unknown status\");\n  if (count >= 12) throw Error(\"LinkedIn image processing timed out; no post was created\");\n  return { available: false, count };\n}\n"
      },
      "n_39dea99169451174": {
        "name": "Prepare the image post",
        "imports": [],
        "source": "export default function post({ person, text, image }) {\n  if (!image.startsWith(\"urn:li:image:\")) throw Error(\"Invalid LinkedIn image URN\");\n  return {\n    body: {\n      author: person,\n      commentary: text.replace(/[\\(*\\)\\[\\]\\{\\}<>@|~_]/g, (ch) => \"\\\\\" + ch),\n      visibility: \"PUBLIC\",\n      distribution: {\n        feedDistribution: \"MAIN_FEED\",\n        targetEntities: [],\n        thirdPartyDistributionChannels: [],\n      },\n      content: { media: { id: image } },\n      lifecycleState: \"PUBLISHED\",\n      isReshareDisabledByAuthor: false,\n    },\n  };\n}\n"
      },
      "n_2527355570fee0fa": {
        "name": "Check post receipt",
        "imports": [],
        "source": "export default function confirm({ statusCode, headers }) {\n  if (statusCode < 200 || statusCode >= 300)\n    throw Error(\"Post failed or result is unknown; inspect LinkedIn before retrying\");\n  const id = headers?.[\"x-restli-id\"];\n  if (!id) throw Error(\"Post result lacks an ID; inspect LinkedIn before retrying\");\n  return { id };\n}\n"
      }
    }
  },
