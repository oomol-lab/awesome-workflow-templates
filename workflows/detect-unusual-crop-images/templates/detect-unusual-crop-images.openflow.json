    "modules": {
      "n_3259d50d9a42a0c5": {
        "name": "Configure crop collection",
        "imports": [],
        "source": "export default function ({ imageURL, base, collection }) {\n  if (!/^https?:\\/\\//i.test(imageURL)) throw Error(\"Provide an HTTP image URL\");\n  if (!/^https:\\/\\//i.test(base) || !collection || collection.startsWith(\"YOUR_\"))\n    throw Error(\"Configure Qdrant\");\n  const root = base.replace(/\\/$/, \"\") + \"/collections/\" + encodeURIComponent(collection);\n  return {\n    imageURL,\n    countUrl: root + \"/points/count\",\n    facetUrl: root + \"/facet\",\n    queryUrl: root + \"/points/query\",\n  };\n}\n"
      },
      "n_a6fcf736151242e8": {
        "name": "Prepare crop facet",
        "imports": [],
        "source": "export default function ({ body }) {\n  const count = body?.result?.count;\n  if (!Number.isSafeInteger(count) || count < 1) throw Error(\"Qdrant collection has no points\");\n  return { body: { key: \"crop_name\", limit: count, exact: true } };\n}\n"
      },
      "n_c6762cdd1d470a1c": {
        "name": "Prepare image embedding",
        "imports": [],
        "source": "export default function ({ body, imageURL }) {\n  const hits = body?.result?.hits;\n  if (!Array.isArray(hits) || !hits.length) throw Error(\"No crop classes in collection\");\n  return {\n    count: hits.length,\n    body: {\n      inputs: [{ content: [{ type: \"image_url\", image_url: imageURL }] }],\n      model: \"voyage-multimodal-3\",\n      input_type: \"document\",\n    },\n  };\n}\n"
      },
      "n_ff868baa9a967d10": {
        "name": "Prepare center search",
        "imports": [],
        "source": "export default function ({ body, count }) {\n  const vector = body?.data?.[0]?.embedding;\n  if (\n    !Array.isArray(vector) ||\n    !vector.length ||\n    vector.some((n) => typeof n !== \"number\" || !Number.isFinite(n))\n  )\n    throw Error(\"Invalid embedding\");\n  return {\n    body: {\n      query: vector,\n      using: \"voyage\",\n      limit: count,\n      with_payload: true,\n      filter: { must: [{ key: \"is_medoid\", match: { value: true } }] },\n    },\n  };\n}\n"
      },
      "n_c9c454664880b1dc": {
        "name": "Compare class thresholds",
        "imports": [],
        "source": "export default function ({ body }) {\n  const points = body?.result?.points;\n  if (!Array.isArray(points)) throw Error(\"Invalid center results\");\n  let score = -Infinity,\n    crop = null;\n  for (const p of points) {\n    const t = p?.payload?.is_medoid_cluster_threshold;\n    if (\n      typeof p.score !== \"number\" ||\n      typeof t !== \"number\" ||\n      typeof p.payload?.crop_name !== \"string\"\n    )\n      throw Error(\"Center lacks score, threshold or crop name\");\n    if (p.score >= t && p.score > score) {\n      score = p.score;\n      crop = p.payload.crop_name;\n    }\n  }\n  return {\n    result:\n      crop === null ? \"ALERT, we might have a new undefined crop!\" : \"Looks similar to \" + crop,\n  };\n}\n"
      }
    }
  },
