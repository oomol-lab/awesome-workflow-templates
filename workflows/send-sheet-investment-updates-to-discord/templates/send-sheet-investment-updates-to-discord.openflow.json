    "modules": {
      "n_c172856b857e4861": {
        "name": "Detect changes and format the table",
        "imports": [],
        "source": "function PLAN({ values, previous }) {\n  if (!Array.isArray(values)) throw Error(\"Expected full sheet values\");\n  if (!values.length) return { snapshot: [], changed: false, text: \"unused\" };\n  const headers = values[0];\n  if (!Array.isArray(headers)) throw Error(\"Missing header row\");\n  const names = [\"Security Code\", \"Price\", \"Quantity\"],\n    indexes = names.map((n) => headers.indexOf(n));\n  if (indexes.some((v, i) => v < 0 || headers.lastIndexOf(names[i]) !== v))\n    throw Error(\"Sheet needs unique Security Code, Price and Quantity headers\");\n  const rows = values.slice(1).map((row) => {\n    if (!Array.isArray(row)) throw Error(\"Malformed sheet row\");\n    return names.map((_, i) => String(row[indexes[i]] ?? \"\"));\n  });\n  const current = rows.map((r) => r[0]);\n  if (\n    previous !== null &&\n    (!Array.isArray(previous) || previous.some((x) => typeof x !== \"string\"))\n  )\n    throw Error(\"Invalid saved sheet state\");\n  const changed =\n    previous !== null && current.some((v, i) => i >= previous.length || v !== previous[i]);\n  if (!changed) return { snapshot: current, changed: false, text: \"unused\" };\n  const printable = rows.filter((r) => r.some(Boolean));\n  const safe = (s) =>\n    s\n      .replace(/[\\r\\n\\t]/g, \" \")\n      .replace(/`/g, \"ˋ\")\n      .replace(/@/g, \"@\\u200b\");\n  const all = [names, ...printable].map((row) => row.map(safe)),\n    width = names.map((_, i) => Math.max(...all.map((r) => r[i].length)));\n  const text =\n    \"```\\n\" +\n    all.map((row) => row.map((s, i) => s.padEnd(width[i])).join(\"  \")).join(\"\\n\") +\n    \"\\n```\";\n  if (text.length > 2000) throw Error(\"Table exceeds Discord message limit\");\n  return { snapshot: current, changed: true, text };\n}\n\nexport default async function inspect({ values }, context) {\n  const previous = await context.state.get(\"security-codes\");\n  const result = PLAN({ values, previous });\n  await context.state.set(\"security-codes\", result.snapshot);\n  return { changed: result.changed, text: result.text };\n}\n"
      }
    }
