    "modules": {
      "n_64ec0bf7fbb4c0f1": {
        "name": "Prepare the next page",
        "imports": [],
        "source": "export default function prepare({ domain, state }) {\n  const allowed = [\n    \"https://www.zohoapis.com\",\n    \"https://www.zohoapis.eu\",\n    \"https://www.zohoapis.in\",\n    \"https://www.zohoapis.com.au\",\n    \"https://www.zohoapis.com.cn\",\n    \"https://www.zohoapis.jp\",\n    \"https://www.zohoapis.ca\",\n    \"https://www.zohoapis.sa\",\n  ];\n  if (!allowed.includes(domain)) throw Error(\"Configure a supported Zoho API domain\");\n  const page = (state?.page ?? 0) + 1;\n  return { url: `${domain}/crm/v2/accounts?per_page=200&page=${page}` };\n}\n"
      },
      "n_44a6dfcf59337dfa": {
        "name": "Collect the first five",
        "imports": [],
        "source": "export default function collect({ body, statusCode, previousState }) {\n  const state = previousState ?? { page: 0, records: [] };\n  if (statusCode === 204)\n    return { state: { page: state.page + 1, records: state.records }, more: false };\n  if (\n    statusCode !== 200 ||\n    !body ||\n    body.data?.[0]?.status === \"error\" ||\n    !Array.isArray(body.data) ||\n    !body.info ||\n    typeof body.info.more_records !== \"boolean\"\n  )\n    throw Error(\"Invalid Zoho response\");\n  return {\n    state: { page: state.page + 1, records: [...state.records, ...body.data].slice(0, 5) },\n    more: body.info.more_records,\n  };\n}\n"
      }
    }
