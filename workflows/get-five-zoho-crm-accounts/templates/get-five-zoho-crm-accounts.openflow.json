    "modules": {
      "n_64ec0bf7fbb4c0f1": {
        "name": "Prepare the next page",
        "imports": [],
        "source": "export default function prepare({domain,state}){const allowed=['https://www.zohoapis.com','https://www.zohoapis.eu','https://www.zohoapis.in','https://www.zohoapis.com.au','https://www.zohoapis.com.cn','https://www.zohoapis.jp','https://www.zohoapis.ca','https://www.zohoapis.sa'];if(!allowed.includes(domain))throw Error('Configure a supported Zoho API domain');const page=(state?.page??0)+1;return{url:`${domain}/crm/v2/accounts?per_page=200&page=${page}`}}\n"
      },
      "n_44a6dfcf59337dfa": {
        "name": "Collect the first five",
        "imports": [],
        "source": "export default function collect({body,statusCode,previousState}){const state=previousState??{page:0,records:[]};if(statusCode===204)return{state:{page:state.page+1,records:state.records},more:false};if(statusCode!==200||!body||body.data?.[0]?.status==='error'||!Array.isArray(body.data)||!body.info||typeof body.info.more_records!=='boolean')throw Error('Invalid Zoho response');return{state:{page:state.page+1,records:[...state.records,...body.data].slice(0,5)},more:body.info.more_records}}\n"
      }
    }
