    "modules": {
      "n_83137691f4a0d487": {
        "name": "Configure customer and segment",
        "imports": [],
        "source": "export default function customerioPlan({customerId,segmentId,name}){\n if(typeof customerId!=='string'||!customerId.trim())throw Error('Enter a customer ID');\n if(typeof segmentId!=='string'||!/^\\d+$/.test(segmentId)||Number(segmentId)<1||Number(segmentId)>2147483647)throw Error('Enter a positive manual segment ID');\n if(typeof name!=='string'||!name)throw Error('Enter the Name value');\n return{customerId,attributes:{data:{Name:name}},endpoint:'/api/v1/segments/'+segmentId+'/add_customers',body:{ids:[customerId]}};\n}\n"
      },
      "n_29071af9619efe9e": {
        "name": "Prepare segment request",
        "imports": [],
        "source": "export default function customerioConfirm({ok,endpoint,body}){if(ok!==true)throw Error('Customer identification was not accepted');return{endpoint,body};}\n"
      },
      "n_ae705ba0f081698d": {
        "name": "Confirm segment acceptance",
        "imports": [],
        "source": "export default function customerioFinish({statusCode,bodyEncoding,customerId}){if(!Number.isInteger(statusCode)||statusCode<200||statusCode>=300||bodyEncoding!=null)throw Error('Segment request failed');return{customerId,accepted:true};}\n"
      }
    }
