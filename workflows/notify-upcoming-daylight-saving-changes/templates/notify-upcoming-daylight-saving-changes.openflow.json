    "modules": {
      "n_1f8a5a3187e8005e": {
        "name": "Check tomorrow in each zone",
        "imports": [],
        "source": "export default function planDst({zones,instant}){\n if(!Array.isArray(zones)||zones.some(z=>typeof z!=='string'||!z.trim())||new Set(zones).size!==zones.length)throw Error('Configure distinct IANA time zones');\n const now=instant===null||instant===undefined?Date.now():Date.parse(instant);if(!Number.isFinite(now))throw Error('Invalid time');\n const alerts=[];\n for(const zone of zones){\n  let fmt,off;try{fmt=new Intl.DateTimeFormat('en-CA-u-ca-iso8601',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'});off=new Intl.DateTimeFormat('en-US',{timeZone:zone,timeZoneName:'shortOffset'});}catch{throw Error('Invalid time zone: '+zone)}\n  const dateKey=t=>{let p=Object.fromEntries(fmt.formatToParts(new Date(t)).map(x=>[x.type,x.value]));return p.year+'-'+p.month+'-'+p.day};\n  const keyAt=d=>new Date(d).toISOString().slice(0,10), today=dateKey(now),base=Date.parse(today+'T00:00:00Z'),tomorrow=keyAt(base+86400000),after=keyAt(base+172800000);\n  function boundary(key,center){let lo=center-36*3600000,hi=center+36*3600000;while(lo<hi){let mid=Math.floor((lo+hi)/2);if(dateKey(mid)<key)lo=mid+1;else hi=mid;}return lo;}\n  const offset=t=>{let v=off.formatToParts(new Date(t)).find(x=>x.type==='timeZoneName')?.value;if(v==='GMT')return 0;let m=/^GMT([+-])(\\d{1,2})(?::(\\d{2}))?$/.exec(v);if(!m)throw Error('Unsupported time zone offset');return (m[1]==='-'?-1:1)*(Number(m[2])*60+Number(m[3]||0));};\n  function isDst(t){const d=dateKey(t),[y,m,day]=d.split('-').map(Number),jan=Date.UTC(y,0,2),may=Date.UTC(y,4,day+1);return offset(t)>offset(boundary(keyAt(jan),jan)-1000)||offset(t)>offset(boundary(keyAt(may),may)-1000);}\n  const start=boundary(tomorrow,base+86400000),end=boundary(after,base+172800000);if(dateKey(start)!==tomorrow||dateKey(end-1)!==tomorrow)throw Error('Cannot identify tomorrow in '+zone);\n  if(isDst(start-1000)!==isDst(end-1000)){const message='Tomorrow is Daylight Saving Time change in zone '+zone+' - remember to adjust meeting times!';alerts.push({zone,message,subject:'DST change tomorrow in '+zone});}\n }\n return {alerts};\n}\n"
      },
      "n_7fa94832d451605a": {
        "name": "Prepare the next alert",
        "imports": [],
        "source": "export default function nextDst({alerts,previous}){if(!Array.isArray(alerts))throw Error('Invalid alerts');const i=previous?.index??0;if(!Number.isInteger(i)||i<0)throw Error('Invalid alert state');if(i>=alerts.length)return {state:{index:i},more:false,message:'',subject:'',count:i};const a=alerts[i];if(!a||typeof a.message!=='string'||typeof a.subject!=='string')throw Error('Invalid alert');return{state:{index:i+1},more:true,message:a.message,subject:a.subject,count:i+1};}\n"
      },
      "n_36159eaaa56c53dd": {
        "name": "Confirm SMTP acceptance",
        "imports": [],
        "source": "export default function confirmEmail({accepted,rejected,response}){if(!Array.isArray(accepted)||!accepted.length||!Array.isArray(rejected)||rejected.length||typeof response!=='string')throw Error('Email was not accepted by SMTP');return {};}\n"
      }
