      "n_1f8a5a3187e8005e": {
        "name": "Check tomorrow in each zone",
        "imports": [],
        "source": "export default function planDst({ zones, instant }) {\n  if (\n    !Array.isArray(zones) ||\n    zones.some((z) => typeof z !== \"string\" || !z.trim()) ||\n    new Set(zones).size !== zones.length\n  )\n    throw Error(\"Configure distinct IANA time zones\");\n  const now = instant === null || instant === undefined ? Date.now() : Date.parse(instant);\n  if (!Number.isFinite(now)) throw Error(\"Invalid time\");\n  const alerts = [];\n  for (const zone of zones) {\n    let fmt, off;\n    try {\n      fmt = new Intl.DateTimeFormat(\"en-CA-u-ca-iso8601\", {\n        timeZone: zone,\n        year: \"numeric\",\n        month: \"2-digit\",\n        day: \"2-digit\",\n      });\n      off = new Intl.DateTimeFormat(\"en-US\", { timeZone: zone, timeZoneName: \"shortOffset\" });\n    } catch {\n      throw Error(\"Invalid time zone: \" + zone);\n    }\n    const dateKey = (t) => {\n      let p = Object.fromEntries(fmt.formatToParts(new Date(t)).map((x) => [x.type, x.value]));\n      return p.year + \"-\" + p.month + \"-\" + p.day;\n    };\n    const keyAt = (d) => new Date(d).toISOString().slice(0, 10),\n      today = dateKey(now),\n      base = Date.parse(today + \"T00:00:00Z\"),\n      tomorrow = keyAt(base + 86400000),\n      after = keyAt(base + 172800000);\n    function boundary(key, center) {\n      let lo = center - 36 * 3600000,\n        hi = center + 36 * 3600000;\n      while (lo < hi) {\n        let mid = Math.floor((lo + hi) / 2);\n        if (dateKey(mid) < key) lo = mid + 1;\n        else hi = mid;\n      }\n      return lo;\n    }\n    const offset = (t) => {\n      let v = off.formatToParts(new Date(t)).find((x) => x.type === \"timeZoneName\")?.value;\n      if (v === \"GMT\") return 0;\n      let m = /^GMT([+-])(\\d{1,2})(?::(\\d{2}))?$/.exec(v);\n      if (!m) throw Error(\"Unsupported time zone offset\");\n      return (m[1] === \"-\" ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3] || 0));\n    };\n    function isDst(t) {\n      const d = dateKey(t),\n        [y, m, day] = d.split(\"-\").map(Number),\n        jan = Date.UTC(y, 0, 2),\n        may = Date.UTC(y, 4, day + 1);\n      return (\n        offset(t) > offset(boundary(keyAt(jan), jan) - 1000) ||\n        offset(t) > offset(boundary(keyAt(may), may) - 1000)\n      );\n    }\n    const start = boundary(tomorrow, base + 86400000),\n      end = boundary(after, base + 172800000);\n    if (dateKey(start) !== tomorrow || dateKey(end - 1) !== tomorrow)\n      throw Error(\"Cannot identify tomorrow in \" + zone);\n    if (isDst(start - 1000) !== isDst(end - 1000)) {\n      const message =\n        \"Tomorrow is Daylight Saving Time change in zone \" +\n        zone +\n        \" - remember to adjust meeting times!\";\n      alerts.push({ zone, message, subject: \"DST change tomorrow in \" + zone });\n    }\n  }\n  return { alerts };\n}\n"
      },
      "n_7fa94832d451605a": {
        "name": "Prepare the next alert",
        "imports": [],
        "source": "export default function nextDst({ alerts, previous }) {\n  if (!Array.isArray(alerts)) throw Error(\"Invalid alerts\");\n  const i = previous?.index ?? 0;\n  if (!Number.isInteger(i) || i < 0) throw Error(\"Invalid alert state\");\n  if (i >= alerts.length)\n    return { state: { index: i }, more: false, message: \"\", subject: \"\", count: i };\n  const a = alerts[i];\n  if (!a || typeof a.message !== \"string\" || typeof a.subject !== \"string\")\n    throw Error(\"Invalid alert\");\n  return {\n    state: { index: i + 1 },\n    more: true,\n    message: a.message,\n    subject: a.subject,\n    count: i + 1,\n  };\n}\n"
      },
      "n_36159eaaa56c53dd": {
        "name": "Confirm SMTP acceptance",
        "imports": [],
        "source": "export default function confirmEmail({ accepted, rejected, response }) {\n  if (\n    !Array.isArray(accepted) ||\n    !accepted.length ||\n    !Array.isArray(rejected) ||\n    rejected.length ||\n    typeof response !== \"string\"\n  )\n    throw Error(\"Email was not accepted by SMTP\");\n  return {};\n}\n"
      }
    }
