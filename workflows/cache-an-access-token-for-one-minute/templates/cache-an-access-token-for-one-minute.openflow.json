    "modules": {
      "n_09b30485d527dbef": {
        "name": "Refresh cached token if needed",
        "imports": [],
        "source": "export default async function cache({ endpoint }, ctx) {\n  if (!/^https:\\/\\//.test(endpoint)) throw Error(\"Configure HTTPS token endpoint\");\n  const now = Date.now(),\n    old = await ctx.state.get(\"access-token-demo\");\n  if (\n    old &&\n    typeof old.token === \"string\" &&\n    old.token &&\n    Number.isFinite(old.timestamp) &&\n    now - old.timestamp < 60000 &&\n    now >= old.timestamp\n  )\n    return { status: \"cached\" };\n  const response = await ctx.fetch(endpoint);\n  if (!response.ok) throw Error(\"Token endpoint failed\");\n  const body = await response.json();\n  if (typeof body.AccessToken !== \"string\" || !body.AccessToken)\n    throw Error(\"Response must contain AccessToken\");\n  await ctx.state.set(\"access-token-demo\", { token: body.AccessToken, timestamp: Date.now() });\n  return { status: \"refreshed\" };\n}\n"
      }
    }
  },
