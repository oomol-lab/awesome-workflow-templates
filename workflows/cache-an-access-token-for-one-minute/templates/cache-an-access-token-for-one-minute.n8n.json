      "parameters": {
        "jsCode": "const token = $input.first().json.AccessToken;\nif (typeof token !== \"string\" || !token) throw new Error(\"Response must contain AccessToken\");\nconst s = $getWorkflowStaticData(\"global\");\ns.accessToken = token;\ns.timestamp = $now.toISO();\nreturn [{ json: { accessToken: s.accessToken, timestamp: s.timestamp } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "cache-an-access-token-for-one-minute-4",
