    "modules": {
      "n_4f05d625b0606849": {
        "name": "Configure services",
        "imports": [],
        "source": "export default function configure({rssBase,wallabagBase,rssUser,rssPassword,clientId,clientSecret,wallabagUser,wallabagPassword}){function base(s){let u;try{u=new URL(s)}catch{throw Error('Invalid service URL')}if(u.protocol!=='https:'||u.username||u.password||u.search||u.hash)throw Error('Service URL must use HTTPS without embedded credentials, query or fragment');return u.href.replace(/\\/+$/,'')}const rss=base(rssBase),wallabag=base(wallabagBase);for(const v of [rssUser,rssPassword,clientId,clientSecret,wallabagUser,wallabagPassword])if(typeof v!=='string'||!v)throw Error('Configure all credentials');return{rssUrl:rss+'/api/',tokenUrl:wallabag+'/oauth/v2/token',saveUrl:wallabag+'/api/entries.json',rssLogin:{op:'login',user:rssUser,password:rssPassword},tokenBody:{grant_type:'password',client_id:clientId,client_secret:clientSecret,username:wallabagUser,password:wallabagPassword}}}\n"
      },
      "n_68c7f547144a012b": {
        "name": "Prepare starred feed request",
        "imports": [],
        "source": "export default function prepare({response}){if(!response||response.status!==0||typeof response.content?.session_id!=='string'||!response.content.session_id)throw Error('Tiny Tiny RSS login failed');return{body:{sid:response.content.session_id,op:'getHeadLines',feed_id:'-1'}}}\n"
      },
      "n_c202828b7a0ddd04": {
        "name": "Select new articles",
        "imports": [],
        "source": "export default async function plan({response,token},context){if(!response||response.status!==0||!Array.isArray(response.content))throw Error('Tiny Tiny RSS headlines failed');if(!token||typeof token.access_token!=='string'||!token.access_token)throw Error('Wallabag login failed');const rows=response.content;for(const r of rows)if(!r||!(typeof r.id==='number'||typeof r.id==='string')||typeof r.link!=='string'||!/^https?:\\/\\//i.test(r.link))throw Error('Invalid article ID or URL');if(!rows.length)return{plans:[],token:token.access_token,newest:null};const old=await context.state.get('ttrss-wallabag-last-id');let plans=[];for(const r of rows){if(old!==null&&String(r.id)===String(old))break;plans.push({id:r.id,url:r.link})}return{plans,token:token.access_token,newest:rows[0].id}}\n"
      },
      "n_f66e9121777f8063": {
        "name": "Prepare next article",
        "imports": [],
        "source": "export default function next({plans,previousState}){const state=previousState??{index:0};if(previousState)state.index++;if(!Array.isArray(plans)||state.index>plans.length)throw Error('Invalid plan');return{state,more:state.index<plans.length,body:{url:plans[state.index]?.url??'https://example.com'},count:state.index}}\n"
      },
      "n_2d947a5a55cc4f1e": {
        "name": "Remember newest article",
        "imports": [],
        "source": "export default async function commit({newest,count},context){if(newest!==null)await context.state.set('ttrss-wallabag-last-id',newest);return{count}}\n"
      }
    }
