    "modules": {
      "n_c3d9a72af51472ea": {
        "name": "Prepare the article",
        "imports": [],
        "source": "export default function prepare({ publicationId, title, content, contentFormat }) {\n  if (\n    !publicationId ||\n    publicationId.startsWith(\"YOUR_\") ||\n    !title ||\n    !content ||\n    ![\"markdown\", \"html\"].includes(contentFormat)\n  )\n    throw Error(\"Set a publication ID, title, content and valid format.\");\n  return {\n    url: \"https://api.medium.com/v1/publications/\" + encodeURIComponent(publicationId) + \"/posts\",\n    body: { title, content, contentFormat, tags: [] },\n  };\n}\n"
      },
      "n_56b8acd2d2e83de7": {
        "name": "Confirm the post",
        "imports": [],
        "source": "export default function check({ body, statusCode }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    !body ||\n    !body.data ||\n    typeof body.data.id !== \"string\" ||\n    !body.data.id\n  )\n    throw Error(\"Medium did not confirm a post ID.\");\n  return { post: body };\n}\n"
      }
    }
