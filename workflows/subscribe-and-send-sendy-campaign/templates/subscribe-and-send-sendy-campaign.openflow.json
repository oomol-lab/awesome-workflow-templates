      "n_a86d3557b3d0176c": {
        "name": "Confirm subscription",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body !== \"1\" && body !== \"true\") throw Error(\"Sendy did not confirm the subscription\");\n  return { ok: true };\n}\n"
      },
      "n_71823e30f48a6d23": {
        "name": "Confirm campaign",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body !== \"Campaign created\" && body !== \"Campaign created and now sending\")\n    throw Error(\"Sendy did not confirm campaign creation\");\n  return { message: body };\n}\n"
      }
