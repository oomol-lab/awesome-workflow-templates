{
  "name": "Subscribe and Send a Sendy Campaign",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "subscribe-and-send-sendy-campaign-0"
    },
    {
      "name": "Subscribe to list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SENDY_HOST/subscribe",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "subscribe-and-send-sendy-campaign-1"
    },
    {
      "name": "Confirm subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v = $input.first().json.data;\nif (![\"1\", \"true\"].includes(String(v))) throw Error(\"Sendy did not confirm subscription\");\nreturn [{ json: { success: true } }];\n"
      },
      "id": "subscribe-and-send-sendy-campaign-2"
    },
    {
      "name": "Sendy1",
      "type": "n8n-nodes-base.sendy",
      "position": [
        650,
        300
      ],
      "parameters": {
        "title": "YOUR_CAMPAIGN_TITLE",
        "replyTo": "YOUR_REPLY_TO_EMAIL",
        "subject": "YOUR_SUBJECT",
        "fromName": "YOUR_SENDER_NAME",
        "htmlText": "YOUR_HTML_CONTENT",
        "resource": "campaign",
        "fromEmail": "YOUR_SENDER_EMAIL",
        "sendCampaign": true,
        "additionalFields": {
          "listIds": "YOUR_LIST_ID"
        }
      },
      "typeVersion": 1,
      "id": "subscribe-and-send-sendy-campaign-3"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Subscribe to list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Subscribe to list": {
      "main": [
        [
          {
            "node": "Confirm subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm subscription": {
      "main": [
        [
          {
            "node": "Sendy1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
