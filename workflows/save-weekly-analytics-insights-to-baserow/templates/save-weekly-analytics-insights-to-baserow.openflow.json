    "modules": {
      "n_c64280ca027e1b01": {
        "name": "Collect six analytics reports",
        "imports": [],
        "source": "export default async function collect({ propertyId, previous }, context) {\n  const groups = [\n    {\n      dimension: \"unifiedScreenName\",\n      metrics: [\"screenPageViews\", \"activeUsers\", \"screenPageViewsPerUser\", \"eventCount\"],\n    },\n    {\n      dimension: \"landingPagePlusQueryString\",\n      metrics: [\n        \"activeUsers\",\n        \"engagedSessions\",\n        \"engagementRate\",\n        \"eventCount\",\n        \"organicGoogleSearchAveragePosition\",\n        \"organicGoogleSearchClickThroughRate\",\n        \"organicGoogleSearchClicks\",\n        \"organicGoogleSearchImpressions\",\n      ],\n    },\n    {\n      dimension: \"country\",\n      metrics: [\n        \"activeUsers\",\n        \"newUsers\",\n        \"engagementRate\",\n        \"engagedSessions\",\n        \"eventCount\",\n        \"totalUsers\",\n        \"sessions\",\n      ],\n    },\n  ];\n  if (typeof propertyId !== \"string\" || !/^\\d+$/.test(propertyId))\n    throw Error(\"Configure a Google Analytics property ID\");\n  const day = new Date().toISOString().slice(0, 10),\n    d = (base, n) =>\n      new Date(Date.parse(base + \"T00:00:00Z\") + n * 86400000).toISOString().slice(0, 10),\n    s = previous ?? { index: 0, offset: 0, day, tables: [[], [], [], [], [], []] };\n  if (\n    !Number.isSafeInteger(s.index) ||\n    s.index < 0 ||\n    s.index >= 6 ||\n    !Number.isSafeInteger(s.offset) ||\n    s.offset < 0 ||\n    !Array.isArray(s.tables) ||\n    s.tables.length !== 6 ||\n    typeof s.day !== \"string\"\n  )\n    throw Error(\"Invalid report state\");\n  const g = groups[Math.floor(s.index / 2)],\n    recent = s.index % 2 === 0,\n    range = { startDate: d(s.day, recent ? -7 : -14), endDate: d(s.day, recent ? -1 : -8) },\n    result = await context.actions.call(\"google_analytics.run_report\", {\n      propertyId,\n      dateRanges: [range],\n      dimensions: [g.dimension],\n      metrics: g.metrics,\n      keepEmptyRows: true,\n      limit: 10000,\n      offset: s.offset,\n    });\n  const r = result?.report;\n  if (!r || !Array.isArray(r.rows)) throw Error(\"Invalid analytics response\");\n  const count = r.rowCount == null && r.rows.length === 0 && s.offset === 0 ? 0 : r.rowCount;\n  if (\n    !Number.isSafeInteger(count) ||\n    count < 0 ||\n    s.offset + r.rows.length > count ||\n    (!r.rows.length && s.offset < count)\n  )\n    throw Error(\"Invalid analytics page count\");\n  const rows = r.rows.map((x) => {\n    if (\n      !Array.isArray(x.dimensionValues) ||\n      x.dimensionValues.length !== 1 ||\n      typeof x.dimensionValues[0] !== \"string\" ||\n      !Array.isArray(x.metricValues) ||\n      x.metricValues.length !== g.metrics.length ||\n      x.metricValues.some((v) => typeof v !== \"string\")\n    )\n      throw Error(\"Invalid analytics row\");\n    return [x.dimensionValues[0], ...x.metricValues];\n  });\n  const tables = s.tables.map((x) =>\n    Array.isArray(x)\n      ? [...x]\n      : (() => {\n          throw Error(\"Invalid report table\");\n        })(),\n  );\n  tables[s.index].push(...rows);\n  const offset = s.offset + rows.length,\n    finished = offset === count,\n    index = finished ? s.index + 1 : s.index;\n  return { state: { index, offset: finished ? 0 : offset, day: s.day, tables }, more: index < 6 };\n}\n"
      },
      "n_95e96db58f261114": {
        "name": "Prepare the three comparisons",
        "imports": [],
        "source": "export default function prepare({ state }) {\n  if (\n    !state ||\n    state.index !== 6 ||\n    !Array.isArray(state.tables) ||\n    state.tables.length !== 6 ||\n    state.tables.some((x) => !Array.isArray(x))\n  )\n    throw Error(\"Incomplete analytics reports\");\n  const columns = [\n    [\"unifiedScreenName\", \"screenPageViews\", \"activeUsers\", \"screenPageViewsPerUser\", \"eventCount\"],\n    [\n      \"landingPagePlusQueryString\",\n      \"activeUsers\",\n      \"engagedSessions\",\n      \"engagementRate\",\n      \"eventCount\",\n      \"organicGoogleSearchAveragePosition\",\n      \"organicGoogleSearchClickThroughRate\",\n      \"organicGoogleSearchClicks\",\n      \"organicGoogleSearchImpressions\",\n    ],\n    [\n      \"country\",\n      \"activeUsers\",\n      \"newUsers\",\n      \"engagementRate\",\n      \"engagedSessions\",\n      \"eventCount\",\n      \"totalUsers\",\n      \"sessions\",\n    ],\n  ];\n  const pair = (i) =>\n    JSON.stringify({\n      columns: columns[i / 2],\n      recent: state.tables[i],\n      previous: state.tables[i + 1],\n    });\n  return { pageData: pair(0), searchData: pair(2), countryData: pair(4) };\n}\n"
      },
      "n_004ee787511b831c": {
        "name": "Prepare the Baserow entry",
        "imports": [],
        "source": "export default function row({ page, search, country, blog }) {\n  for (const x of [page, search, country])\n    if (!x || typeof x.text !== \"string\" || !x.text.trim()) throw Error(\"Invalid AI report\");\n  if (typeof blog !== \"string\" || !blog.trim() || blog.startsWith(\"YOUR_\"))\n    throw Error(\"Configure blog name\");\n  return {\n    row: {\n      Name: new Date().toISOString(),\n      \"Page Views\": page.text.trim(),\n      \"Search Report\": search.text.trim(),\n      \"Country Views\": country.text.trim(),\n      Blog: blog.trim(),\n    },\n  };\n}\n"
      }
    }
  },
