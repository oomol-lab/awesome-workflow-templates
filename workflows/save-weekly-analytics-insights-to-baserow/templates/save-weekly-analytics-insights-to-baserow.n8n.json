      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const propertyId='YOUR_PROPERTY_ID';if(!/^\\d+$/.test(propertyId))throw Error('Configure a Google Analytics property ID');const day=new Date().toISOString().slice(0,10),d=n=>new Date(Date.parse(day+'T00:00:00Z')+n*86400000).toISOString().slice(0,10);return [{json:{propertyId,day,recentStart:d(-7),recentEnd:d(-1),previousStart:d(-14),previousEnd:d(-8)}}];"
      },
      "id": "save-weekly-analytics-insights-to-baserow-2"
    },
