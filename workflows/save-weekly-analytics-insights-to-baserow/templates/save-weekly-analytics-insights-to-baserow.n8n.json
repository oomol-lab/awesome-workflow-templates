    {
      "name": "Prepare the three comparisons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function prepare({state}){if(!state||state.index!==6||!Array.isArray(state.tables)||state.tables.length!==6||state.tables.some(x=>!Array.isArray(x)))throw Error('Incomplete analytics reports');const columns=[['unifiedScreenName','screenPageViews','activeUsers','screenPageViewsPerUser','eventCount'],['landingPagePlusQueryString','activeUsers','engagedSessions','engagementRate','eventCount','organicGoogleSearchAveragePosition','organicGoogleSearchClickThroughRate','organicGoogleSearchClicks','organicGoogleSearchImpressions'],['country','activeUsers','newUsers','engagementRate','engagedSessions','eventCount','totalUsers','sessions']];const pair=i=>JSON.stringify({columns:columns[i/2],recent:state.tables[i],previous:state.tables[i+1]});return{pageData:pair(0),searchData:pair(2),countryData:pair(4)}}\n\nconst names=[\"Get Page Engagement Stats for this week\",\"Get Page Engagement Stats for prior week\",\"Get Google Search Results for this week\",\"Get Google Search Results for prior week\",\"Get Country views data for this week\",\"Get Country views data for prior week\"],lengths=[4,4,8,8,7,7],tables=[];for(let i=0;i<names.length;i++){const pages=$(names[i]).all(),rows=[];let count=null;for(const p of pages){const r=p.json?.body;if(!r||typeof r!=='object'||!Array.isArray(r.rows??[]))throw Error('Invalid analytics response');const c=r.rowCount??0;if(!Number.isSafeInteger(c)||c<0||(count!==null&&count!==c))throw Error('Analytics row count changed');count=c;rows.push(...(r.rows??[]))}if(count===null||count!==rows.length)throw Error('Incomplete analytics response');tables.push(rows.map(x=>{if(!Array.isArray(x.dimensionValues)||x.dimensionValues.length!==1||typeof x.dimensionValues[0]?.value!=='string'||!Array.isArray(x.metricValues)||x.metricValues.length!==lengths[i]||x.metricValues.some(v=>typeof v?.value!=='string'))throw Error('Invalid analytics row');return [x.dimensionValues[0].value,...x.metricValues.map(v=>v.value)]}))}return [{json:prepare({state:{index:6,tables}})}];"
      },
      "id": "save-weekly-analytics-insights-to-baserow-9"
    },
