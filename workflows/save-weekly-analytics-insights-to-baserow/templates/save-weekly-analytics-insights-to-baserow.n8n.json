    {
      "name": "Prepare the Baserow entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function row({page,search,country,blog}){for(const x of [page,search,country])if(!x||typeof x.text!=='string'||!x.text.trim())throw Error('Invalid AI report');if(typeof blog!=='string'||!blog.trim()||blog.startsWith('YOUR_'))throw Error('Configure blog name');return{row:{Name:new Date().toISOString(),'Page Views':page.text.trim(),'Search Report':search.text.trim(),'Country Views':country.text.trim(),Blog:blog.trim()}}}\n\nreturn [{json:row({page:$('Analyze page engagement').first().json.output,search:$('Analyze search performance').first().json.output,country:$('Analyze country views').first().json.output,blog:'YOUR_BLOG_NAME'})}];"
      },
      "id": "save-weekly-analytics-insights-to-baserow-17"
    },
