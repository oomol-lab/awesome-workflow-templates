        "url": "={{ 'https://analyticsdata.googleapis.com/v1beta/properties/' + $('Prepare report dates').first().json.propertyId + ':runReport' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAnalyticsOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {dateRanges:[{startDate:$('Prepare report dates').first().json.recentStart,endDate:$('Prepare report dates').first().json.recentEnd}],dimensions:[{\"name\":\"unifiedScreenName\"}],metrics:[{\"name\":\"screenPageViews\"},{\"name\":\"activeUsers\"},{\"name\":\"screenPageViewsPerUser\"},{\"name\":\"eventCount\"}],keepEmptyRows:true,limit:10000,offset:0} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "offset",
                    "value": "={{ $pageCount * 10000 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ (() => { const b=$response.body;if(!b||typeof b!=='object')throw Error('Invalid analytics page');const rows=b.rows??[],count=b.rowCount??0;if(!Array.isArray(rows)||!Number.isSafeInteger(count)||count<0||rows.length>10000||(!Number.isSafeInteger($pageCount))||$pageCount<1)throw Error('Invalid analytics page count');const consumed=($pageCount-1)*10000+rows.length;if(consumed>count||(consumed<count&&rows.length!==10000))throw Error('Incomplete analytics page');return consumed===count; })() }}",
              "limitPagesFetched": false
            }
          }
