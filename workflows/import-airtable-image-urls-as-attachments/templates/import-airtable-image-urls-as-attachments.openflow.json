      "n_12edfa448300d7d0": {
        "name": "Collect the next page",
        "imports": [],
        "source": "export default function collectImagePages({records,offset,previousState}) {\n  if (!Array.isArray(records)) throw new Error('Missing Airtable records');\n  const state=previousState ?? {records:[],seen:[]};\n  if (!Array.isArray(state.records)||!Array.isArray(state.seen)) throw new Error('Invalid pagination state');\n  if (offset!==null && (typeof offset!=='string'||!offset||state.seen.includes(offset))) throw new Error('Invalid or repeated Airtable offset');\n  return {state:{records:[...state.records,...records],seen:offset===null?state.seen:[...state.seen,offset]},offset:offset??\"unused\",more:offset!==null};\n}\n"
      },
      "n_58e5550cf638b5fa": {
        "name": "Prepare the next attachment",
        "imports": [],
        "source": "export default function nextImageUpdate({pageState,previousState}) {\n  const index=previousState?.index ?? 0, records=pageState.records;\n  if (!Array.isArray(records)||!Number.isInteger(index)||index<0||index>records.length) throw new Error('Invalid update state');\n  if(index===records.length) return {state:{index},more:false,records:[{id:\"unused\",fields:{}}],count:index};\n  const record=records[index],url=record?.fields?.['Image source URL'];\n  if(typeof record?.id!=='string'||!record.id||typeof url!=='string'||!url.trim())throw new Error('Missing record ID or image URL');\n  return {state:{index:index+1},more:true,records:[{id:record.id,fields:{'Image attachment':[{url}]}}],count:index+1};\n}\n"
      }
    }
