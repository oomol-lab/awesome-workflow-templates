{
  "nodes": [
    {
      "id": "import-airtable-image-urls-as-attachments-0",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        1000,
        720
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "import-airtable-image-urls-as-attachments-1",
      "name": "Get all records with an image URL",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1200,
        720
      ],
      "parameters": {
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_TABLE_ID"
        },
        "options": {},
        "operation": "search",
        "filterByFormula": "=NOT({Image source URL} = '')",
        "returnAll": true
      },
      "typeVersion": 2
    },
    {
      "id": "import-airtable-image-urls-as-attachments-2",
      "name": "Update attachment field with images",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1400,
        720
      ],
      "parameters": {
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "Image attachment": "={{ [{url: $json[\"Image source URL\"]}] }}"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "type": "string",
              "defaultMatch": true,
              "canBeUsedToMatch": true
            },
            {
              "id": "Image attachment",
              "displayName": "Image attachment",
              "type": "array",
              "canBeUsedToMatch": false
            }
          ]
        },
        "options": {},
        "operation": "update"
      },
      "typeVersion": 2
    }
  ],
  "pinData": {},
  "connections": {
