{
  "nodes": [
    {
      "name": "Start manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "id": "save-first-gmail-attachments-to-drive-0"
    },
    {
      "name": "Gmail1",
      "type": "n8n-nodes-base.gmail",
      "position": [
        -34.5,
        449.5
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "simple": false,
        "filters": {
          "labelIds": [
            "YOUR_GMAIL_LABEL_ID"
          ],
          "readStatus": "both"
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "typeVersion": 2,
      "id": "save-first-gmail-attachments-to-drive-1"
    },
    {
      "name": "Upload File1",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        115.5,
        449.5
      ],
      "parameters": {
        "name": "={{$binary.attachment_0.fileName}}",
        "parents": [
          "YOUR_DRIVE_FOLDER_ID"
        ],
        "binaryData": true,
        "resolveData": true,
        "authentication": "oAuth2",
        "binaryPropertyName": "attachment_0"
      },
      "typeVersion": 1,
      "id": "save-first-gmail-attachments-to-drive-2"
    },
    {
      "name": "Get attachment Link",
      "type": "n8n-nodes-base.set",
      "position": [
        280,
        450
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mp4_attachment",
              "value": "={{$json[\"webViewLink\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "save-first-gmail-attachments-to-drive-3"
    }
  ],
  "connections": {
    "Start manually": {
      "main": [
        [
          {
            "node": "Gmail1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail1": {
      "main": [
        [
          {
            "node": "Upload File1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload File1": {
      "main": [
        [
          {
            "node": "Get attachment Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Save First Gmail Attachments to Drive",
  "active": false,
  "pinData": {}
}
