    {
      "id": "scan-indicators-with-virustotal-and-greynoise-8",
      "name": "Expand webhook indicators",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $(\"Webhook\").first().json.body;\nreturn (body.data ?? []).map((item) => ({\n  json: { indicator: item.url ?? item.ip, email: body.email },\n}));\n"
      },
      "position": [
        520,
        200
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-9",
      "name": "Read form indicator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { indicator: $json.url, email: $json.Email } }];\n"
      },
      "position": [
        780,
        200
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-10",
      "name": "Process one indicator",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "position": [
        1040,
        200
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-11",
      "name": "Prepare indicator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const indicator = String($json.indicator ?? \"\");\nconst host = indicator.includes(\"://\")\n  ? indicator.split(\"://\")[1].split(\"/\")[0]\n  : indicator.split(\"/\")[0];\nconst isIp = /^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$/.test(host),\n  rawIp = isIp && indicator === host,\n  scanUrl = indicator.includes(\"://\") ? indicator : \"https://\" + indicator;\nreturn { json: { indicator, email: $json.email, host, isIp, rawIp, scanUrl } };\n"
      },
      "position": [
        1300,
        200
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-12",
      "name": "Already an IP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isIp }}",
              "value2": true
            }
          ]
        }
      },
      "position": [
        0,
        400
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-13",
      "name": "Resolve domain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "https://dns.google/resolve",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $json.host }}"
            },
            {
              "name": "type",
              "value": "A"
            }
          ]
        },
        "options": {}
      },
      "position": [
        260,
        400
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-14",
      "name": "Select IP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $(\"Prepare indicator\").first().json,\n  ip = x.isIp ? x.host : $json.Answer?.filter((a) => a.type === 1).at(-1)?.data;\nif (!ip) throw Error(\"No IPv4 DNS answer\");\nreturn { json: { ...x, ip } };\n"
      },
      "position": [
        520,
        400
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-15",
      "name": "Read GreyNoise RIOT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ 'https://api.greynoise.io/v2/riot/'+$('Select IP').first().json.ip }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "position": [
        780,
        400
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-16",
      "name": "Read GreyNoise context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ 'https://api.greynoise.io/v2/noise/context/'+$('Select IP').first().json.ip }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "position": [
        1040,
        400
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-17",
      "name": "Bare IP indicator?",
