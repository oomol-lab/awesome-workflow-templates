    {
      "id": "scan-indicators-with-virustotal-and-greynoise-23",
      "name": "Analysis complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data.attributes.status }}",
              "operation": "equal",
              "value2": "completed"
            }
          ]
