      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-18",
      "name": "Request VirusTotal IP rescan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://www.virustotal.com/api/v3/ip_addresses/'+$('Select IP').first().json.ip+'/analyse' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "virusTotalApi",
        "options": {}
      },
      "position": [
        0,
        600
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-19",
      "name": "Start VirusTotal scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://www.virustotal.com/api/v3/urls",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Select IP').first().json.scanUrl }}"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "virusTotalApi",
        "options": {}
      },
      "position": [
        260,
        600
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-20",
      "name": "Select analysis ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $json.data?.id;\nif (!id) throw Error(\"VirusTotal returned no analysis ID\");\nreturn { json: { id } };\n"
      },
      "position": [
        520,
        600
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-21",
      "name": "Wait five seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
