      },
      "position": [
        1300,
        600
      ]
    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-24",
      "name": "Prepare scan report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const report = function report({ indicator, ip, email, analysis, riot, context }) {\n  const a = analysis.attributes,\n    s = a.stats,\n    r = a.results;\n  if (!s || !r) throw Error(\"VirusTotal result missing\");\n  const block = r.BlockList?.result ?? \"n/a\",\n    phish = r.OpenPhish?.result ?? \"n/a\",\n    location = context.metadata?.region\n      ? `${context.metadata.region} ${context.metadata.country ?? \"\"}`\n      : \"n/a\",\n    tags = (context.tags ?? []).join(\", \") || \"None\",\n    trust = riot.trust_level ?? context.trust_level ?? \"Not trusted\",\n    classification = context.classification ?? \"safe\",\n    category = context.category ?? \"n/a\",\n    total = (s.harmless ?? 0) + (s.malicious ?? 0) + (s.suspicious ?? 0) + (s.undetected ?? 0),\n    text = `Successfully scanned ${indicator}${ip !== indicator ? \" (\" + ip + \")\" : \"\"}\\n\\nVirusTotal Report (${total} scans)\\n${s.harmless ?? 0} Harmless\\n${s.malicious ?? 0} Malicious\\n${s.suspicious ?? 0} Suspicious\\n${s.undetected ?? 0} Undetected\\n${s.timeout ?? 0} Timed out\\nBlockList: ${block}\\nOpenPhish: ${phish}\\nSummary: ${(s.suspicious ?? 0) + (s.malicious ?? 0) === 0 ? \"✅ Harmless\" : \"🚨 Malicious\"}\\n\\nGreyNoise Report\\nTrust Level: ${trust}\\nClassification: ${classification}\\nLocation: ${location}\\nCategory: ${category}\\nTags: ${tags}`;\n  return { text, email, subject: indicator + \" Scan Report\" };\n};\n\nconst x = $(\"Select IP\").first().json;\nreturn {\n  json: report({\n    indicator: x.indicator,\n    ip: x.ip,\n    email: x.email,\n    analysis: $json.data,\n    riot: $(\"Read GreyNoise RIOT\").first().json,\n    context: $(\"Read GreyNoise context\").first().json,\n  }),\n};\n"
      },
      "position": [
        0,
        800
      ]
    },
