    },
    {
      "id": "scan-indicators-with-virustotal-and-greynoise-22",
      "name": "Read VirusTotal analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ 'https://www.virustotal.com/api/v3/analyses/'+$('Select analysis ID').first().json.id }}",
