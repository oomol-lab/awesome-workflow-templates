    "modules": {
      "n_441314b682179c15": {
        "name": "Set the recent window",
        "imports": [],
        "source": "export default function window() {\n  return { after: new Date(Date.now() - 30 * 60000).toISOString() };\n}\n"
      },
      "n_9550966c4380c8f1": {
        "name": "Prepare video details",
        "imports": [],
        "source": "export default function select({ body, statusCode }) {\n  if (statusCode < 200 || statusCode >= 300 || !body || !Array.isArray(body.items))\n    throw Error(\"YouTube search failed\");\n  if (body.items.length === 0) return { found: false, title: \"\", description: \"\", url: \"\" };\n  if (body.items.length !== 1) throw Error(\"Unexpected search result\");\n  const x = body.items[0];\n  if (\n    !/^[A-Za-z0-9_-]{1,128}$/.test(x?.id?.videoId || \"\") ||\n    typeof x.snippet?.title !== \"string\" ||\n    typeof x.snippet?.description !== \"string\"\n  )\n    throw Error(\"Invalid video\");\n  return {\n    found: true,\n    title: x.snippet.title,\n    description: x.snippet.description,\n    url: \"https://youtu.be/\" + x.id.videoId,\n  };\n}\n"
      },
      "n_259b01dd237fe2a0": {
        "name": "Validate the post",
        "imports": [],
        "source": "export default function validate({ result, url }) {\n  const text = typeof result === \"string\" ? result.trim() : \"\";\n  if (!text || Array.from(text).length > 140 || !text.includes(url))\n    throw Error(\"Post must include the video link and fit 140 characters\");\n  return { text };\n}\n"
      }
    }
