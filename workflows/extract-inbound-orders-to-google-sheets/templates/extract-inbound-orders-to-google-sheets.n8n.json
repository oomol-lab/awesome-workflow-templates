    {
      "id": "extract-inbound-orders-to-google-sheets-6",
      "name": "Format Purchase Order Lines",
      "type": "n8n-nodes-base.code",
      "position": [
        -120,
        -80
      ],
      "parameters": {
        "jsCode": "function rows({ result }) {\n  if (\n    !result ||\n    typeof result.purchase_order !== \"string\" ||\n    !result.purchase_order.trim() ||\n    typeof result.expected_delivery_date !== \"string\" ||\n    !/^\\d{4}-\\d{2}-\\d{2}$/.test(result.expected_delivery_date) ||\n    !Array.isArray(result.lines) ||\n    !result.lines.length\n  )\n    throw Error(\"Invalid order extraction\");\n  const values = result.lines.map((x) => {\n    if (\n      !x ||\n      typeof x.sku !== \"string\" ||\n      !x.sku.trim() ||\n      !Number.isFinite(x.quantity) ||\n      x.quantity <= 0\n    )\n      throw Error(\"Invalid order line\");\n    return [result.purchase_order, result.expected_delivery_date, x.sku, x.quantity];\n  });\n  return { values };\n}\n\nreturn $input.all().flatMap((item, i) =>\n  rows({ result: item.json.output }).values.map((v) => ({\n    json: { purchase_order: v[0], expected_delivery_date: v[1], sku: v[2], quantity: v[3] },\n    pairedItem: { item: i },\n  })),\n);\n"
      },
      "typeVersion": 2
    }
  ],
