    "modules": {
      "n_362a322c4b11e28d": {
        "name": "Compare the fruit examples",
        "imports": [],
        "source": "export default function compare() {\n  const a = [\n      { fruit: \"apple\", color: \"green\" },\n      { fruit: \"orange\", color: \"orange\" },\n      { fruit: \"grape\", color: \"green\" },\n      { fruit: \"strawberry\", color: \"red\" },\n      { fruit: \"banana\", color: \"yellow\" },\n    ],\n    b = [\n      { fruit: \"apple\", color: \"green\" },\n      { fruit: \"grape\", color: \"purple\" },\n      { fruit: \"orange\", color: \"orange\" },\n      { fruit: \"kiwi\", color: \"mostly green\" },\n      { fruit: \"banana\", color: \"yellow\" },\n    ],\n    aOnly = [],\n    same = [],\n    different = [],\n    bOnly = [];\n  for (const x of a) {\n    const y = b.find((v) => v.fruit === x.fruit);\n    if (!y) aOnly.push(x);\n    else if (x.color === y.color) same.push(x);\n    else\n      different.push({\n        keys: { fruit: x.fruit },\n        same: { fruit: x.fruit },\n        different: { color: { inputA: x.color, inputB: y.color } },\n      });\n  }\n  for (const x of b) if (!a.some((v) => v.fruit === x.fruit)) bOnly.push(x);\n  return { aOnly, same, different, bOnly };\n}\n"
      }
    }
  },
