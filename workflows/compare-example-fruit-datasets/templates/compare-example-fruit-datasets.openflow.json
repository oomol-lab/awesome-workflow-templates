      "n_362a322c4b11e28d": {
        "name": "Compare the fruit examples",
        "imports": [],
        "source": "export default function compare(){const a=[{fruit:'apple',color:'green'},{fruit:'orange',color:'orange'},{fruit:'grape',color:'green'},{fruit:'strawberry',color:'red'},{fruit:'banana',color:'yellow'}],b=[{fruit:'apple',color:'green'},{fruit:'grape',color:'purple'},{fruit:'orange',color:'orange'},{fruit:'kiwi',color:'mostly green'},{fruit:'banana',color:'yellow'}],aOnly=[],same=[],different=[],bOnly=[];for(const x of a){const y=b.find(v=>v.fruit===x.fruit);if(!y)aOnly.push(x);else if(x.color===y.color)same.push(x);else different.push({keys:{fruit:x.fruit},same:{fruit:x.fruit},different:{color:{inputA:x.color,inputB:y.color}}})}for(const x of b)if(!a.some(v=>v.fruit===x.fruit))bOnly.push(x);return{aOnly,same,different,bOnly}}\n"
      }
    }
