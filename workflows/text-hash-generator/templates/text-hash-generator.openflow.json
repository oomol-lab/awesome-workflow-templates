      "n_aa7f51453dbc86cb": {
        "name": "Generate MD5 text checksum",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\n\nexport default function hashText({ text }) {\n  return { data: createHash(\"md5\").update(text, \"utf8\").digest(\"hex\") };\n}\n"
      }
