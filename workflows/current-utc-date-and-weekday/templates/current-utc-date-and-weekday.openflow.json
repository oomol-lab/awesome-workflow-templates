      "n_af97a866334e3686": {
        "name": "Format one UTC instant",
        "imports": [],
        "source": "export default function currentUtcDay() {\n  const instant = new Date(Date.now());\n  const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n  return { date_today: instant.toISOString(), day_today: weekdays[instant.getUTCDay()] };\n}\n"
      }
