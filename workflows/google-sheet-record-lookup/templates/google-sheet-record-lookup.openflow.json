    "modules": {
      "n_98284d5b6e5d883b": {
        "name": "Prepare sheet lookup",
        "imports": [],
        "source": "export function lookupRequest({ operation, query }) {\n  if (![\"column_names\", \"column_values\", \"row\"].includes(operation))\n    throw new Error(\"Use column_names, column_values, or row.\");\n  if (query != null && typeof query !== \"string\") throw new Error(\"The lookup query must be text.\");\n  const text = query ?? \"\";\n  if (operation === \"column_values\" && !text.trim())\n    throw new Error(\"Supply the exact column name.\");\n  if (operation === \"row\" && (!/^[1-9]\\d*$/.test(text) || !Number.isSafeInteger(Number(text))))\n    throw new Error(\"Supply a positive physical row number as text.\");\n  return { operation, query: text };\n}\n\nexport default function prepareSheetLookup({ operation, query, spreadsheetId, range }) {\n  const lookup = lookupRequest({ operation, query });\n  if (\n    typeof spreadsheetId !== \"string\" ||\n    !/^[A-Za-z0-9_-]+$/.test(spreadsheetId) ||\n    /YOUR_SPREADSHEET_ID/.test(spreadsheetId)\n  )\n    throw new Error(\"Configure your Google spreadsheet ID before running.\");\n  if (typeof range !== \"string\" || !/^'(?:[^'\\u0000-\\u001f\\u007f]|'')+'$/.test(range))\n    throw new Error(\"Configure the complete tab as a single-quoted A1 sheet name.\");\n  return { ...lookup, spreadsheetId, range };\n}\n"
      },
      "n_bca4cc234f6fbc62": {
        "name": "Select sheet records",
        "imports": [],
        "source": "export function lookupSheet({ values, majorDimension = \"ROWS\", operation, query }) {\n  if (\n    majorDimension !== \"ROWS\" ||\n    !Array.isArray(values) ||\n    values.some((row) => !Array.isArray(row))\n  )\n    throw new Error(\"Google Sheets must return row-oriented cell values.\");\n  const isEmpty = (value) => value == null || value === \"\";\n  const nonempty = (row) => row.some((value) => !isEmpty(value));\n  const headerIndex = values.findIndex(nonempty);\n  if (headerIndex < 0) return { response: \"[]\" };\n  const headers = values[headerIndex];\n  if (\n    headers.some((name) => typeof name !== \"string\" || !name.trim() || name === \"row_number\") ||\n    new Set(headers).size !== headers.length\n  )\n    throw new Error(\"Use unique nonempty text headers; row_number is reserved.\");\n  const columns = [\"row_number\", ...headers];\n  const records = [];\n  for (let index = headerIndex + 1; index < values.length; index++) {\n    const cells = values[index];\n    if (!nonempty(cells)) continue;\n    if (cells.slice(headers.length).some((value) => !isEmpty(value)))\n      throw new Error(\"Every populated column needs a header.\");\n    records.push(\n      Object.fromEntries([\n        [\"row_number\", index + 1],\n        ...headers.map((name, column) => [name, cells[column] ?? \"\"]),\n      ]),\n    );\n  }\n  let result;\n  if (operation === \"column_names\") result = columns;\n  else if (operation === \"column_values\") {\n    if (!columns.includes(query)) throw new Error(\"The requested column does not exist.\");\n    result = records.map((record) =>\n      Object.fromEntries([\n        [\"row_number\", record.row_number],\n        [query, record[query]],\n      ]),\n    );\n  } else if (operation === \"row\")\n    result = records.filter((record) => record.row_number === Number(query));\n  else throw new Error(\"Use column_names, column_values, or row.\");\n  return { response: JSON.stringify(result) };\n}\n\nexport default function formatSheetLookup(input) {\n  return lookupSheet(input);\n}\n"
      }
