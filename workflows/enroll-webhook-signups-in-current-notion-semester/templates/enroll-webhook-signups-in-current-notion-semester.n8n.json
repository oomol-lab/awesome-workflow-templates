{
  "nodes": [
    {
      "name": "Sign Up",
      "type": "n8n-nodes-base.webhook",
      "notes": "Example Input Data: {\"name\":\"John Doe\",\"email\":\"doe.j@northeastern.edu\"}",
      "position": [
        720,
        130
      ],
      "parameters": {
        "path": "sign-up",
        "httpMethod": "POST",
        "authentication": "basicAuth",
        "options": {}
      },
      "notesInFlow": true,
      "typeVersion": 1,
      "id": "enroll-webhook-signups-in-current-notion-semester-0"
    },
    {
      "name": "Prepare signup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body;\nif (\n  typeof b?.name !== \"string\" ||\n  !b.name.trim() ||\n  typeof b?.email !== \"string\" ||\n  !b.email.trim()\n)\n  throw Error(\"Provide name and email\");\nconst userSourceId = \"YOUR_USER_DATA_SOURCE_ID\",\n  semesterSourceId = \"YOUR_SEMESTER_DATA_SOURCE_ID\";\nif ([userSourceId, semesterSourceId].some((x) => x.startsWith(\"YOUR_\")))\n  throw Error(\"Configure both data source IDs\");\nreturn [{ json: { name: b.name.trim(), email: b.email.trim(), userSourceId, semesterSourceId } }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-1"
    },
    {
      "name": "Find current semester",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.notion.com/v1/data_sources/'+$('Prepare signup').first().json.semesterSourceId+'/query' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{property:'Is Current?',checkbox:{equals:true}},page_size:2}) }}",
        "options": {}
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-2"
    },
    {
      "name": "Check current semester",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function semester({ output }) {\n  if (\n    !output ||\n    !Array.isArray(output.results) ||\n    output.results.length !== 1 ||\n    output.has_more !== false ||\n    typeof output.results[0]?.id !== \"string\" ||\n    !output.results[0].id\n  )\n    throw Error(\"Exactly one current semester is required\");\n  return { semesterId: output.results[0].id };\n}\n\nreturn [{ json: semester({ output: $input.first().json }) }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-3"
    },
    {
      "name": "Find user by email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.notion.com/v1/data_sources/'+$('Prepare signup').first().json.userSourceId+'/query' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{property:'Email',email:{equals:$('Prepare signup').first().json.email}},page_size:2}) }}",
        "options": {}
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-4"
    },
    {
      "name": "Check user match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function user({ output, name, email, userSourceId }) {\n  if (\n    !output ||\n    !Array.isArray(output.results) ||\n    output.has_more !== false ||\n    output.results.length > 1\n  )\n    throw Error(\"Ambiguous user email\");\n  const page = output.results[0];\n  if (page && (!page.id || !page.properties?.Semesters?.id))\n    throw Error(\"User relation property is missing\");\n  return {\n    exists: !!page,\n    userId: page?.id ?? \"\",\n    propertyId: page?.properties?.Semesters?.id ?? \"\",\n    parent: { data_source_id: userSourceId },\n    properties: { Name: { title: [{ text: { content: name } }] }, Email: { email } },\n  };\n}\n\nconst p = $(\"Prepare signup\").first().json;\nreturn [\n  {\n    json: user({\n      output: $input.first().json,\n      name: p.name,\n      email: p.email,\n      userSourceId: p.userSourceId,\n    }),\n  },\n];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-5"
    },
    {
      "name": "Existing user?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "exists",
              "leftValue": "={{ $json.exists }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-6"
    },
    {
      "name": "Use existing user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { userId: $json.userId, propertyId: $json.propertyId } }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-7"
    },
    {
      "name": "Create user",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({parent:$json.parent,properties:$json.properties}) }}",
        "options": {}
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-8"
    },
    {
      "name": "Confirm created user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function created({ output }) {\n  if (\n    typeof output?.id !== \"string\" ||\n    !output.id ||\n    typeof output.properties?.Semesters?.id !== \"string\" ||\n    !output.properties.Semesters.id\n  )\n    throw Error(\"Created user not confirmed; inspect Notion before retry\");\n  return { userId: output.id, propertyId: output.properties.Semesters.id };\n}\n\nreturn [{ json: created({ output: $input.first().json }) }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-9"
    },
    {
      "name": "Resolve user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (\n  typeof $json.userId !== \"string\" ||\n  !$json.userId ||\n  typeof $json.propertyId !== \"string\" ||\n  !$json.propertyId\n)\n  throw Error(\"Missing user relation\");\nreturn [{ json: { userId: $json.userId, propertyId: $json.propertyId } }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-10"
    },
    {
      "name": "Read semester relations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.notion.com/v1/pages/'+$('Resolve user').first().json.userId+'/properties/'+encodeURIComponent($('Resolve user').first().json.propertyId)+'?page_size=100' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://api.notion.com/v1/pages/'+$('Resolve user').first().json.userId+'/properties/'+encodeURIComponent($('Resolve user').first().json.propertyId)+'?page_size=100'+($pageCount===0?'':'&start_cursor='+encodeURIComponent($response.body.next_cursor)) }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ (()=>{const b=$response.body;if(b?.object!=='list'||!Array.isArray(b.results)||typeof b.has_more!=='boolean'||(b.has_more&&(typeof b.next_cursor!=='string'||!b.next_cursor)))throw Error('Invalid relation page');return !b.has_more})() }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-11"
    },
    {
      "name": "Collect existing semesters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = [];\nfor (const { json } of $input.all()) {\n  const b = json.body;\n  if (b?.object !== \"list\" || !Array.isArray(b.results)) throw Error(\"Invalid relation page\");\n  for (const x of b.results) {\n    if (typeof x?.relation?.id !== \"string\" || !x.relation.id) throw Error(\"Invalid relation\");\n    all.push(x.relation.id);\n  }\n}\nconst id = $(\"Check current semester\").first().json.semesterId,\n  unique = [id, ...all.filter((x) => x !== id)];\nif (unique.length > 100) throw Error(\"Notion cannot set more than 100 relations in one request\");\nreturn [{ json: { properties: { Semesters: { relation: unique.map((id) => ({ id })) } } } }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-12"
    },
    {
      "name": "Add current semester",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://api.notion.com/v1/pages/'+$('Resolve user').first().json.userId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({properties:$json.properties}) }}",
        "options": {}
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-13"
    },
    {
      "name": "Confirm enrollment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if ($json.id !== $(\"Resolve user\").first().json.userId) throw Error(\"Notion update not confirmed\");\nreturn [{ json: { accepted: true } }];\n"
      },
      "id": "enroll-webhook-signups-in-current-notion-semester-14"
    }
  ],
  "connections": {
    "Sign Up": {
      "main": [
        [
          {
            "node": "Prepare signup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare signup": {
      "main": [
        [
          {
            "node": "Find current semester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find current semester": {
      "main": [
        [
          {
            "node": "Check current semester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check current semester": {
      "main": [
        [
          {
            "node": "Find user by email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find user by email": {
      "main": [
        [
          {
            "node": "Check user match",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check user match": {
      "main": [
        [
          {
