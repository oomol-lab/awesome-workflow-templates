            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Use existing user": {
      "main": [
        [
          {
            "node": "Resolve user",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create user": {
      "main": [
        [
          {
            "node": "Confirm created user",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm created user": {
      "main": [
        [
          {
            "node": "Resolve user",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve user": {
      "main": [
        [
          {
            "node": "Read semester relations",
            "type": "main",
            "index": 0
          }
        ]
      ]
