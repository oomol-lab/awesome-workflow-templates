    "modules": {
      "n_92bf9db53cc1e025": {
        "name": "Prepare the position URL",
        "imports": [],
        "source": "export default function () {\n  return {url:'https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps='+Math.floor(Date.now()/1000)};\n}\n"
      },
      "n_7dede0bda6fbbe9a": {
        "name": "Prepare the position message",
        "imports": [],
        "source": "export default function position({body}){const p=Array.isArray(body)?body[0]:null;if(!p||typeof p.name!=='string'||!Number.isFinite(p.latitude)||!Number.isFinite(p.longitude)||!Number.isFinite(p.timestamp))throw Error('Invalid ISS position');return{message:JSON.stringify({Name:p.name,Latitude:p.latitude,Longitude:p.longitude,Timestamp:p.timestamp})};}\n"
      },
      "n_2cabad9f8fc1403a": {
        "name": "Sign the SQS request",
        "imports": [],
        "source": "import{createHash,createHmac}from'node:crypto';export default function sign({queueUrl,message,accessKeyId,secretAccessKey,sessionToken}){const m=/^https:\\/\\/sqs\\.([a-z0-9-]+)\\.amazonaws\\.com(\\.cn)?\\/(\\d{12})\\/([A-Za-z0-9_-]{1,80})$/.exec(queueUrl??'');if(!m)throw Error('Configure a standard SQS queue URL');if(typeof message!=='string'||!message||typeof accessKeyId!=='string'||!accessKeyId.trim()||typeof secretAccessKey!=='string'||!secretAccessKey.trim()||(sessionToken!=null&&typeof sessionToken!=='string'))throw Error('Configure message and AWS credentials');const region=m[1],host='sqs.'+region+'.amazonaws.com'+(m[2]??''),path='/'+m[3]+'/'+m[4],enc=x=>encodeURIComponent(x).replace(/[!'()*]/g,c=>'%'+c.charCodeAt(0).toString(16).toUpperCase()),body='Action=SendMessage&Version=2012-11-05&MessageBody='+enc(message),timestamp=new Date().toISOString().replace(/[:-]|\\.\\d{3}/g,''),date=timestamp.slice(0,8),headers={'content-type':'application/x-www-form-urlencoded',host,'x-amz-date':timestamp,...(sessionToken?{'x-amz-security-token':sessionToken}:{})},names=Object.keys(headers).sort(),signed=names.join(';'),canonicalHeaders=names.map(n=>n+':'+headers[n].trim().replace(/\\s+/g,' ')+'\\n').join(''),hash=x=>createHash('sha256').update(x).digest('hex'),hmac=(k,x)=>createHmac('sha256',k).update(x).digest(),scope=date+'/'+region+'/sqs/aws4_request',canonical=['POST',path,'',canonicalHeaders,signed,hash(body)].join('\\n'),tosign=['AWS4-HMAC-SHA256',timestamp,scope,hash(canonical)].join('\\n'),key=hmac(hmac(hmac(hmac('AWS4'+secretAccessKey,date),region),'sqs'),'aws4_request'),signature=createHmac('sha256',key).update(tosign).digest('hex');return{url:queueUrl,body,authorization:'AWS4-HMAC-SHA256 Credential='+accessKeyId+'/'+scope+', SignedHeaders='+signed+', Signature='+signature,amzDate:timestamp};}\n"
      },
      "n_23bd3f892bfb5a3a": {
        "name": "Confirm the message ID",
        "imports": [],
        "source": "export default function result({body}){if(typeof body!=='string')throw Error('SQS did not return XML');const m=/<(?:[A-Za-z_][\\w.-]*:)?MessageId>\\s*([A-Za-z0-9-]+)\\s*<\\/(?:[A-Za-z_][\\w.-]*:)?MessageId>/.exec(body);if(!m)throw Error('SQS did not confirm a message ID');return{messageId:m[1]};}\n"
      }
    }
