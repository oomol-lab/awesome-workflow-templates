    "modules": {
      "n_92bf9db53cc1e025": {
        "name": "Prepare the position URL",
        "imports": [],
        "source": "export default function () {\n  return {\n    url:\n      \"https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps=\" +\n      Math.floor(Date.now() / 1000),\n  };\n}\n"
      },
      "n_7dede0bda6fbbe9a": {
        "name": "Prepare the position message",
        "imports": [],
        "source": "export default function position({ body }) {\n  const p = Array.isArray(body) ? body[0] : null;\n  if (\n    !p ||\n    typeof p.name !== \"string\" ||\n    !Number.isFinite(p.latitude) ||\n    !Number.isFinite(p.longitude) ||\n    !Number.isFinite(p.timestamp)\n  )\n    throw Error(\"Invalid ISS position\");\n  return {\n    message: JSON.stringify({\n      Name: p.name,\n      Latitude: p.latitude,\n      Longitude: p.longitude,\n      Timestamp: p.timestamp,\n    }),\n  };\n}\n"
      },
      "n_2cabad9f8fc1403a": {
        "name": "Sign the SQS request",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nexport default function sign({ queueUrl, message, accessKeyId, secretAccessKey, sessionToken }) {\n  const m =\n    /^https:\\/\\/sqs\\.([a-z0-9-]+)\\.amazonaws\\.com(\\.cn)?\\/(\\d{12})\\/([A-Za-z0-9_-]{1,80})$/.exec(\n      queueUrl ?? \"\",\n    );\n  if (!m) throw Error(\"Configure a standard SQS queue URL\");\n  if (\n    typeof message !== \"string\" ||\n    !message ||\n    typeof accessKeyId !== \"string\" ||\n    !accessKeyId.trim() ||\n    typeof secretAccessKey !== \"string\" ||\n    !secretAccessKey.trim() ||\n    (sessionToken != null && typeof sessionToken !== \"string\")\n  )\n    throw Error(\"Configure message and AWS credentials\");\n  const region = m[1],\n    host = \"sqs.\" + region + \".amazonaws.com\" + (m[2] ?? \"\"),\n    path = \"/\" + m[3] + \"/\" + m[4],\n    enc = (x) =>\n      encodeURIComponent(x).replace(\n        /[!'()*]/g,\n        (c) => \"%\" + c.charCodeAt(0).toString(16).toUpperCase(),\n      ),\n    body = \"Action=SendMessage&Version=2012-11-05&MessageBody=\" + enc(message),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8),\n    headers = {\n      \"content-type\": \"application/x-www-form-urlencoded\",\n      host,\n      \"x-amz-date\": timestamp,\n      ...(sessionToken ? { \"x-amz-security-token\": sessionToken } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signed = names.join(\";\"),\n    canonicalHeaders = names\n      .map((n) => n + \":\" + headers[n].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\"),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, x) => createHmac(\"sha256\", k).update(x).digest(),\n    scope = date + \"/\" + region + \"/sqs/aws4_request\",\n    canonical = [\"POST\", path, \"\", canonicalHeaders, signed, hash(body)].join(\"\\n\"),\n    tosign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    key = hmac(hmac(hmac(hmac(\"AWS4\" + secretAccessKey, date), region), \"sqs\"), \"aws4_request\"),\n    signature = createHmac(\"sha256\", key).update(tosign).digest(\"hex\");\n  return {\n    url: queueUrl,\n    body,\n    authorization:\n      \"AWS4-HMAC-SHA256 Credential=\" +\n      accessKeyId +\n      \"/\" +\n      scope +\n      \", SignedHeaders=\" +\n      signed +\n      \", Signature=\" +\n      signature,\n    amzDate: timestamp,\n  };\n}\n"
      },
      "n_23bd3f892bfb5a3a": {
        "name": "Confirm the message ID",
        "imports": [],
        "source": "export default function result({ body }) {\n  if (typeof body !== \"string\") throw Error(\"SQS did not return XML\");\n  const m =\n    /<(?:[A-Za-z_][\\w.-]*:)?MessageId>\\s*([A-Za-z0-9-]+)\\s*<\\/(?:[A-Za-z_][\\w.-]*:)?MessageId>/.exec(\n      body,\n    );\n  if (!m) throw Error(\"SQS did not confirm a message ID\");\n  return { messageId: m[1] };\n}\n"
      }
    }
