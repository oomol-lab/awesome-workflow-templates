        "jsCode": "const text = String($json.output ?? \"\")\n  .trim()\n  .replace(/^```(?:json)?\\s*/i, \"\")\n  .replace(/\\s*```$/, \"\");\nlet invoice;\ntry {\n  invoice = JSON.parse(text);\n} catch {\n  throw Error(\"Invalid invoice JSON\");\n}\nif (\n  !invoice ||\n  Array.isArray(invoice) ||\n  typeof invoice !== \"object\" ||\n  [\n    \"invoice_date\",\n    \"invoice_number\",\n    \"purchase_order_number\",\n    \"supplier_name\",\n    \"supplier_address\",\n    \"supplier_vat_id\",\n    \"customer_name\",\n    \"customer_address\",\n    \"customer_vat_id\",\n    \"shipping_addresses\",\n    \"line_items\",\n    \"subtotal_without_vat\",\n    \"subtotal_with_vat\",\n    \"total_price\",\n  ].some((k) => typeof invoice[k] !== \"string\")\n)\n  throw Error(\"Invalid invoice object\");\nreturn { json: { invoice } };\n"
