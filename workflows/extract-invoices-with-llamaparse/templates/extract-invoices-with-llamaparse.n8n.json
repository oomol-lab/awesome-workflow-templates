        "mode": "runOnceForEachItem",
        "jsCode": "const s = $json.job?.status;\nif ([\"PENDING\", \"RUNNING\"].includes(s)) return { json: { ready: false } };\nif (\n  s !== \"COMPLETED\" ||\n  !Array.isArray($json.markdown?.pages) ||\n  $json.markdown.pages.some((p) => p.success !== true)\n)\n  throw Error(\"Parse failed or incomplete\");\nreturn {\n  json: { ready: true, markdown: $json.markdown.pages.map((p) => p.markdown).join(\"\\n\\n\") },\n};\n"
