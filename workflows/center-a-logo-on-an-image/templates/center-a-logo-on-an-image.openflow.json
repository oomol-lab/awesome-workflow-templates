    "modules": {
      "n_a4b2227cd2255e07": {
        "name": "Upload background image",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async function upload(\n  { backgroundUrl, acknowledge, resolution, recoveredUrl },\n  ctx,\n) {\n  const u = new URL(backgroundUrl);\n  if (u.protocol !== \"https:\") throw Error(\"Background must be an HTTPS URL\");\n  const key = \"watermark-upload:\" + createHash(\"sha256\").update(u.href).digest(\"hex\");\n  let state = await ctx.state.get(key);\n  if (state?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending Cloudinary upload \" + key);\n    if (resolution === \"confirmed\") {\n      const r = new URL(recoveredUrl);\n      if (\n        r.protocol !== \"https:\" ||\n        r.hostname !== \"res.cloudinary.com\" ||\n        !r.pathname.includes(\"/image/upload/\")\n      )\n        throw Error(\"Enter the verified Cloudinary image URL\");\n      state = { status: \"done\", asset: { secureUrl: r.href } };\n      await ctx.state.set(key, state);\n      return { asset: state.asset };\n    }\n  }\n  if (state?.status === \"done\") return { asset: state.asset };\n  await ctx.state.set(key, { status: \"pending\" });\n  const r = await ctx.actions.call(\"cloudinary.upload_asset\", {\n    resourceType: \"image\",\n    fileUrl: u.href,\n  });\n  const a = r?.asset;\n  if (!a?.assetId || !a?.publicId || !a?.secureUrl) throw Error(\"Cloudinary upload not confirmed\");\n  const asset = { secureUrl: a.secureUrl };\n  await ctx.state.set(key, { status: \"done\", asset });\n  return { asset };\n}\n"
      },
      "n_3871bbfc6bb8c519": {
        "name": "Center logo and return image",
        "imports": [],
        "source": "export default async function composite({ asset, overlayUrl }, ctx) {\n  const url = new URL(asset?.secureUrl);\n  if (\n    url.protocol !== \"https:\" ||\n    url.hostname !== \"res.cloudinary.com\" ||\n    !url.pathname.includes(\"/image/upload/\")\n  )\n    throw Error(\"Invalid Cloudinary image URL\");\n  const overlay = new URL(overlayUrl);\n  if (overlay.protocol !== \"https:\") throw Error(\"Overlay must be a public HTTPS URL\");\n  const encoded = Buffer.from(overlay.href).toString(\"base64\");\n  url.pathname = url.pathname.replace(\n    \"/image/upload/\",\n    \"/image/upload/l_fetch:\" + encoded + \"/fl_layer_apply,g_center/f_jpg/\",\n  );\n  const r = await ctx.fetch(url.href);\n  if (!r.ok || !(r.headers.get(\"content-type\") ?? \"\").startsWith(\"image/jpeg\"))\n    throw Error(\"Composite image unavailable\");\n  const bytes = new Uint8Array(await r.arrayBuffer());\n  if (!bytes.length) throw Error(\"Empty image\");\n  return {\n    file: await ctx.artifact.put(bytes, { name: \"watermarked.jpg\", mediaType: \"image/jpeg\" }),\n  };\n}\n"
      }
