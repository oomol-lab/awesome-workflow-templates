{
  "nodes": [
    {
      "id": "share-drive-folder-files-and-create-download-links-0",
      "name": "Manual Execute Workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "notes": "Optional",
      "position": [
        0,
        300
      ],
      "parameters": {},
      "notesInFlow": true,
      "typeVersion": 1
    },
    {
      "id": "share-drive-folder-files-and-create-download-links-1",
      "name": "Set Folder ID",
      "type": "n8n-nodes-base.set",
      "notes": "Enter desired Folder",
      "position": [
        250,
        300
      ],
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "Folder ID",
              "stringValue": "YOUR_FOLDER_ID"
            }
          ]
        },
        "options": {}
      },
      "notesInFlow": true,
      "typeVersion": 3.2
    },
    {
      "name": "Validate folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $json[\"Folder ID\"];\nif (typeof id !== \"string\" || !id.trim() || id.startsWith(\"YOUR_\"))\n  throw Error(\"Configure folder ID\");\nreturn $input.all();\n"
      },
      "id": "share-drive-folder-files-and-create-download-links-2",
      "position": [
        500,
        300
      ]
    },
    {
      "id": "share-drive-folder-files-and-create-download-links-3",
      "name": "Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        750,
        300
      ],
      "parameters": {
        "limit": 100,
        "options": {
          "spaces": [
            "*"
          ],
          "corpora": "allDrives"
        },
        "operation": "list",
        "queryString": "={{ \"'\" + $json['Folder ID'].replace(/\\\\/g,'\\\\\\\\').replace(/'/g,\"\\\\'\") + \"' in parents\" }}",
        "authentication": "oAuth2",
        "useQueryString": true
      },
      "typeVersion": 1
    },
    {
      "id": "share-drive-folder-files-and-create-download-links-4",
      "name": "Change Status",
      "type": "n8n-nodes-base.googleDrive",
      "notes": "Make Files Public to anyone with a link",
      "position": [
        1000,
        300
      ],
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "supportsAllDrives": true
        },
        "operation": "share",
        "permissionsUi": {
          "permissionsValues": {
            "role": "reader",
            "type": "anyone"
          }
        },
        "authentication": "oAuth2",
        "resource": "file"
      },
      "notesInFlow": true,
      "typeVersion": 3
    },
    {
      "name": "Create download links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const file = $(\"Google Drive\").item.json;\nif (typeof $json.id !== \"string\" || !$json.id) throw Error(\"Permission not confirmed\");\nreturn {\n  json: {\n    name: file.name,\n    link:\n      \"https://drive.google.com/uc?id=\" +\n      encodeURIComponent(file.id) +\n      \"&export=download&confirm=t\",\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "share-drive-folder-files-and-create-download-links-5",
      "position": [
        1250,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Manual Execute Workflow": {
      "main": [
        [
          {
            "node": "Set Folder ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Folder ID": {
      "main": [
        [
          {
            "node": "Validate folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate folder": {
      "main": [
        [
          {
            "node": "Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive": {
      "main": [
        [
          {
            "node": "Change Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Change Status": {
      "main": [
        [
          {
            "node": "Create download links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Share Drive Folder Files and Create Download Links",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
