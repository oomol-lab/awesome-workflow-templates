    "modules": {
      "n_4472013a1195d9ea": {
        "name": "Convert the recipe to XML",
        "imports": [],
        "source": "export default function cocktailXml({ body }) {\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    Object.keys(body).length !== 1 ||\n    !Object.hasOwn(body, \"drinks\") ||\n    !(body.drinks === null || Array.isArray(body.drinks))\n  )\n    throw Error(\"Expected a CocktailDB drinks response\");\n  const values = body.drinks ?? [],\n    lines = [];\n  for (const drink of values) {\n    if (!drink || typeof drink !== \"object\" || Array.isArray(drink)) throw Error(\"Invalid drink\");\n    for (const [name, value] of Object.entries(drink)) {\n      if (\n        !/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(name) ||\n        !(value === null || [\"string\", \"number\", \"boolean\"].includes(typeof value))\n      )\n        throw Error(\"Unsupported cocktail field\");\n      const text = value === null ? \"\" : String(value);\n      if (\n        /[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\ufffe\\uffff]/.test(text) ||\n        /[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?<![\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]/.test(text)\n      )\n        throw Error(\"Invalid XML character\");\n      const escaped = text\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\\r/g, \"&#xD;\");\n      lines.push(escaped ? \"  <\" + name + \">\" + escaped + \"</\" + name + \">\" : \"  <\" + name + \"/>\");\n    }\n  }\n  return {\n    data:\n      '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\n' +\n      (lines.length ? \"<drinks>\\n\" + lines.join(\"\\n\") + \"\\n</drinks>\" : \"<drinks/>\"),\n  };\n}\n"
      }
    }
