    "modules": {
      "n_4472013a1195d9ea": {
        "name": "Convert the recipe to XML",
        "imports": [],
        "source": "export default function cocktailXml({body}) {\n if(!body||typeof body!=='object'||Array.isArray(body)||Object.keys(body).length!==1||!Object.hasOwn(body,'drinks')||!(body.drinks===null||Array.isArray(body.drinks)))throw Error('Expected a CocktailDB drinks response');\n const values=body.drinks??[],lines=[];\n for(const drink of values){if(!drink||typeof drink!=='object'||Array.isArray(drink))throw Error('Invalid drink');for(const [name,value] of Object.entries(drink)){\n  if(!/^[A-Za-z_][A-Za-z0-9_.-]*$/.test(name)||!(value===null||['string','number','boolean'].includes(typeof value)))throw Error('Unsupported cocktail field');\n  const text=value===null?'':String(value);if(/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\ufffe\\uffff]/.test(text)||/[\\uD800-\\uDBFF](?![\\uDC00-\\uDFFF])|(?<![\\uD800-\\uDBFF])[\\uDC00-\\uDFFF]/.test(text))throw Error('Invalid XML character');\n  const escaped=text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\r/g,'&#xD;');lines.push(escaped?'  <'+name+'>'+escaped+'</'+name+'>':'  <'+name+'/>');\n }}\n return {data:'<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\n'+(lines.length?'<drinks>\\n'+lines.join('\\n')+'\\n</drinks>':'<drinks/>')};\n}\n"
      }
    }
