    "modules": {
      "n_c655960b46c5b9f4": {
        "name": "Configure the inbox and destination",
        "imports": [],
        "source": "function pollWindow(at, saved, channel, mention) {\n  if (!/^\\d{17,20}$/.test(channel) || (mention && !/^\\d{17,20}$/.test(mention))) {\n    throw new Error(\"Configure a private Discord channel ID and optional user ID.\");\n  }\n  const scheduled = Date.parse(at);\n  if (!Number.isFinite(scheduled)) throw new Error(\"Missing schedule timestamp.\");\n  const now = Math.max(scheduled, Date.now());\n  if (saved?.nextAt > now) return null;\n  const before = Math.floor(now / 1000) * 1000;\n  const since = saved?.since ?? before - 60000;\n  return {\n    key: \"github-notifications:\" + channel,\n    channel,\n    mention,\n    now,\n    before,\n    since,\n    query: {\n      since: new Date(since).toISOString().replace(\".000Z\", \"Z\"),\n      before: new Date(before).toISOString().replace(\".000Z\", \"Z\"),\n      all: \"false\",\n      per_page: \"50\",\n    },\n  };\n}\n\nexport default async ({ at, channel, mention }, ctx) => {\n  const key = \"github-notifications:\" + channel;\n  const window = pollWindow(at, await ctx.state.get(key), channel, mention);\n  if (window) await ctx.state.set(key, { since: window.since, nextAt: window.now + 60000 });\n  return { window, channel, ready: window !== null };\n};\n"
      },
      "n_9898e55dc839e35d": {
        "name": "Select the next notification page",
        "imports": [],
        "source": "export default ({ window, state }) => ({\n  query: { ...window.query, page: String((state?.page ?? 0) + 1) },\n});\n"
      },
      "n_928afdaf9c9d9dd9": {
        "name": "Collect the notification summaries",
        "imports": [],
        "source": "function nextNotificationPage(headers) {\n  const link = headers?.link ?? headers?.Link ?? \"\";\n  for (const segment of link.split(/,(?=\\s*<)/)) {\n    if (!/;\\s*rel=\"next\"\\s*$/i.test(segment)) continue;\n    const match = /^\\s*<https:\\/\\/api\\.github\\.com\\/notifications\\?([^<>]+)>\\s*;/i.exec(segment);\n    const pageText = match?.[1].match(/(?:^|&)page=(\\d+)(?:&|$)/)?.[1];\n    const page = Number(pageText);\n    if (!Number.isSafeInteger(page) || page < 2)\n      throw new Error(\"Unexpected GitHub pagination link.\");\n    return page;\n  }\n  return null;\n}\n\nfunction notificationLine(thread, window) {\n  if (thread?.unread !== true) return null;\n  const updated = Date.parse(thread.updated_at);\n  if (!Number.isFinite(updated))\n    throw new Error(\"GitHub returned a notification without a valid update date.\");\n  if (updated <= window.since || updated >= window.before) return null;\n  const safeText = (text, length) =>\n    String(text ?? \"\")\n      .replace(/[\\u0000-\\u001f\\u007f\\u202a-\\u202e\\u2066-\\u2069]/g, \" \")\n      .trim()\n      .slice(0, length)\n      .replace(/@/g, \"@\\u200b\")\n      .replace(/</g, \"‹\")\n      .replace(/>/g, \"›\")\n      .replace(/[\\\\`*_{}\\[\\]()#+.!|~]/g, \"\\\\$&\");\n  const reason = safeText(thread.reason, 60) || \"notification\";\n  const title = safeText(thread.subject?.title, 280) || \"Untitled notification\";\n  const url = thread.subject?.url;\n  const path =\n    typeof url === \"string\" &&\n    url.length <= 400 &&\n    /^https:\\/\\/api\\.github\\.com\\/repos\\/([A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+)\\/(.+)$/.exec(url);\n  let link = \"\";\n  if (\n    path &&\n    /^[A-Za-z0-9._~/-]+$/.test(path[2]) &&\n    ![...path[1].split(\"/\"), ...path[2].split(\"/\")].some((x) => x === \".\" || x === \"..\")\n  ) {\n    const kind = /^(issues|pulls|discussions|commits)\\/([A-Za-z0-9]+)$/.exec(path[2]);\n    if (kind) {\n      const route = {\n        issues: \"issues\",\n        pulls: \"pull\",\n        discussions: \"discussions\",\n        commits: \"commit\",\n      }[kind[1]];\n      link = \"https://github.com/\" + path[1] + \"/\" + route + \"/\" + kind[2];\n    } else link = url;\n  }\n  if (typeof thread.id !== \"string\" || !thread.id)\n    throw new Error(\"GitHub returned a notification without an ID.\");\n  return {\n    id: thread.id + \":\" + updated,\n    line: \"- [\" + reason + \"] \" + title + (link ? \" <\" + link + \">\" : \"\"),\n  };\n}\n\nfunction readNotificationPage(previous, window, status, headers, body) {\n  const state = previous ?? { page: 0, interval: 60, lines: [], ids: [] };\n  const seconds = Number(headers?.[\"x-poll-interval\"]);\n  const retry = Number(headers?.[\"retry-after\"]);\n  const reset = Number(headers?.[\"x-ratelimit-reset\"]) - Math.floor(window.now / 1000);\n  const positive = (value) => (Number.isSafeInteger(value) && value > 0 ? value : 0);\n  state.interval = Math.max(\n    state.interval,\n    positive(seconds),\n    positive(retry),\n    (status === 403 || status === 429) && headers?.[\"x-ratelimit-remaining\"] === \"0\"\n      ? positive(reset)\n      : 0,\n  );\n  state.page++;\n  state.more = false;\n  if (status === 304 && state.page === 1) return state;\n  if (status !== 200 || !Array.isArray(body)) {\n    state.error = \"GitHub notification read failed\" + (status ? \" (HTTP \" + status + \").\" : \".\");\n    return state;\n  }\n  try {\n    const ids = new Set(state.ids);\n    for (const thread of body) {\n      const item = notificationLine(thread, window);\n      if (!item || ids.has(item.id)) continue;\n      ids.add(item.id);\n      state.lines.push(item.line);\n    }\n    state.ids = [...ids];\n    const next = nextNotificationPage(headers);\n    if (next !== null && (next !== state.page + 1 || state.page >= 20)) {\n      throw new Error(\"GitHub notification pagination did not complete.\");\n    }\n    state.more = next !== null;\n  } catch (cause) {\n    state.error = cause.message;\n  }\n  return state;\n}\n\nfunction notificationCheckpoint(window, state) {\n  return {\n    since: state.error ? window.since : window.before - 1000,\n    nextAt: Math.max(window.now, Date.now()) + state.interval * 1000,\n  };\n}\n\nexport default async ({ window, status, headers, body, previous }, ctx) => {\n  const state = readNotificationPage(previous, window, status, headers, body);\n  const checkpoint = notificationCheckpoint(window, state);\n  await ctx.state.set(window.key, { ...checkpoint, since: window.since });\n  return { state, more: state.more };\n};\n"
      },
      "n_8d46a2a7d4580332": {
        "name": "Save the poll window",
        "imports": [],
        "source": "function notificationCheckpoint(window, state) {\n  return {\n    since: state.error ? window.since : window.before - 1000,\n    nextAt: Math.max(window.now, Date.now()) + state.interval * 1000,\n  };\n}\n\nfunction discordBatches(window, lines) {\n  if (!lines.length) return [];\n  const split = [];\n  let content =\n    \"Unread GitHub notifications\" + (window.mention ? \" <@\" + window.mention + \">\" : \"\") + \":\";\n  for (const line of lines) {\n    if (content.length + line.length + 1 > 1900) {\n      split.push(content);\n      content = \"Unread GitHub notifications (continued):\";\n    }\n    content += \"\\n\" + line;\n  }\n  split.push(content);\n  return split.map((text, index) => ({\n    content: text,\n    allowed_mentions: { parse: [], users: index === 0 && window.mention ? [window.mention] : [] },\n    flags: 4,\n  }));\n}\n\nexport default async ({ window, state }, ctx) => {\n  if (state.error) throw new Error(state.error);\n  const messages = discordBatches(window, state.lines);\n  await ctx.state.set(window.key, notificationCheckpoint(window, state));\n  return { messages, count: state.lines.length };\n};\n"
      },
      "n_ed72de6c262f5d9b": {
        "name": "Select the next Discord message",
        "imports": [],
        "source": "export default ({ messages, previous, channel }) => {\n  const index = (previous ?? -1) + 1;\n  const msg = messages[index];\n  return {\n    index,\n    more: !!msg,\n    channel,\n    content: msg?.content ?? \"\",\n    allowed: msg?.allowed_mentions ?? null,\n  };\n};\n"
      },
      "n_5b351d281bd7658d": {
        "name": "Check the Discord receipt",
        "imports": [],
        "source": "function discordConfirmed(reply, channel, content) {\n  return (\n    typeof reply?.id === \"string\" &&\n    !!reply.id &&\n    reply.channel_id === channel &&\n    reply.content === content\n  );\n}\n\nexport default ({ reply, channel, content }) => {\n  if (!discordConfirmed(reply, channel, content))\n    throw new Error(\n      \"Check the Discord channel before manually reposting an unconfirmed notification.\",\n    );\n  return {};\n};\n"
      }
    },
