    "modules": {
      "n_045e34123066b639": {
        "name": "Collect contact pages",
        "imports": [],
        "source": "export default function pages({ previousState, response, statusCode }) {\n  let state = previousState ?? { contacts: [], seen: [], cursor: null };\n  if (!Array.isArray(state.contacts) || !Array.isArray(state.seen)) throw Error(\"Invalid state\");\n  if (response != null) {\n    if (\n      statusCode < 200 ||\n      statusCode >= 300 ||\n      !Array.isArray(response.contacts) ||\n      typeof response[\"has-more\"] !== \"boolean\"\n    )\n      throw Error(\"Invalid HubSpot page\");\n    const more = response[\"has-more\"],\n      cursor = response[\"vid-offset\"];\n    if (more && (!Number.isSafeInteger(cursor) || cursor < 0 || state.seen.includes(cursor)))\n      throw Error(\"Invalid or repeated cursor\");\n    state = {\n      contacts: state.contacts.concat(response.contacts),\n      seen: more ? state.seen.concat(cursor) : state.seen,\n      cursor: more ? cursor : null,\n    };\n  }\n  return {\n    state,\n    more: response == null || state.cursor !== null,\n    params: {\n      count: 100,\n      limit: 250,\n      ...(state.cursor !== null ? { vidOffset: state.cursor } : {}),\n    },\n    contacts: state.contacts,\n  };\n}\n"
      }
    }
