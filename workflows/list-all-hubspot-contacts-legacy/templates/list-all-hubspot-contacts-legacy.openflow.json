    "modules": {
      "n_045e34123066b639": {
        "name": "Collect contact pages",
        "imports": [],
        "source": "export default function pages({previousState,response,statusCode}){let state=previousState??{contacts:[],seen:[],cursor:null};if(!Array.isArray(state.contacts)||!Array.isArray(state.seen))throw Error('Invalid state');if(response!=null){if(statusCode<200||statusCode>=300||!Array.isArray(response.contacts)||typeof response['has-more']!=='boolean')throw Error('Invalid HubSpot page');const more=response['has-more'],cursor=response['vid-offset'];if(more&&(!Number.isSafeInteger(cursor)||cursor<0||state.seen.includes(cursor)))throw Error('Invalid or repeated cursor');state={contacts:state.contacts.concat(response.contacts),seen:more?state.seen.concat(cursor):state.seen,cursor:more?cursor:null}}return{state,more:response==null||state.cursor!==null,params:{count:100,limit:250,...(state.cursor!==null?{vidOffset:state.cursor}:{})},contacts:state.contacts}}\n"
      }
