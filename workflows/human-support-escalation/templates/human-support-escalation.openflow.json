    "modules": {
      "n_89bb4eb733f8dbec": {
        "name": "Check contact email",
        "imports": [],
        "source": "export const supportMessagePrefix =\n  \"A user had a question the bot couldn't answer. Here's their message: \";\n\nexport default function prepareHumanSupport({ chatInput }) {\n  if (typeof chatInput !== \"string\" || !chatInput.trim())\n    throw new Error(\"Supply the question or support request as text.\");\n  const hasEmail = /([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\\.[a-zA-Z0-9_-]+)/i.test(chatInput);\n  const text = supportMessagePrefix + chatInput;\n  if (hasEmail && text.length > 40000)\n    throw new Error(\"The support message exceeds the 40,000-character budget.\");\n  return { hasEmail, text };\n}\n"
      },
      "n_fa6aefc6f0abac74": {
        "name": "Confirm support notification",
        "imports": [],
        "source": "export const missingEmailResponse =\n  \"I'm sorry I don't know the answer. Please repeat your question and include your email address so I can request help.\";\nexport const supportNotifiedResponse =\n  \"Thank you for getting in touch. I've messaged a human to help.\";\n\nexport default function humanSupportReply({ delivered, ts, channelId }) {\n  if (!delivered) return { response: missingEmailResponse };\n  if (typeof ts !== \"string\" || !ts.trim() || typeof channelId !== \"string\" || !channelId.trim())\n    throw new Error(\"Slack did not acknowledge the support message.\");\n  return { response: supportNotifiedResponse };\n}\n"
      },
      "n_11b89d3fc62da5fe": {
        "name": "Request contact email",
        "imports": [],
        "source": "export const missingEmailResponse =\n  \"I'm sorry I don't know the answer. Please repeat your question and include your email address so I can request help.\";\nexport const supportNotifiedResponse =\n  \"Thank you for getting in touch. I've messaged a human to help.\";\n\nexport default function humanSupportReply({ delivered, ts, channelId }) {\n  if (!delivered) return { response: missingEmailResponse };\n  if (typeof ts !== \"string\" || !ts.trim() || typeof channelId !== \"string\" || !channelId.trim())\n    throw new Error(\"Slack did not acknowledge the support message.\");\n  return { response: supportNotifiedResponse };\n}\n"
      }
