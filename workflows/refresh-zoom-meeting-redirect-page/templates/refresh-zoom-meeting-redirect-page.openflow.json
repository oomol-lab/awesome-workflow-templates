      "n_004fdc6ef6dfb637": {
        "name": "Check the 360-day schedule",
        "imports": [],
        "source": "export default function scheduled({anchorDate,instant}){if(typeof anchorDate!=='string'||!/^\\d{4}-\\d{2}-\\d{2}$/.test(anchorDate))throw Error('Set the UTC start date as YYYY-MM-DD');const start=Date.parse(anchorDate+'T00:00:00Z');if(!Number.isFinite(start)||new Date(start).toISOString().slice(0,10)!==anchorDate)throw Error('Invalid UTC start date');const now=instant==null?Date.now():Date.parse(instant);if(!Number.isFinite(now))throw Error('Invalid current time');const today=Date.parse(new Date(now).toISOString().slice(0,10)+'T00:00:00Z'),days=(today-start)/86400000;return {run:days>=0&&days%360===0};}\n"
      },
      "n_89deaa7963ae2572": {
        "name": "Prepare the redirect",
        "imports": [],
        "source": "export default function redirect({meeting}){const url=meeting?.joinUrl;if(typeof url!=='string'||!/^https:\\/\\/(?:[a-z0-9-]+\\.)*zoom\\.us\\//i.test(url)||/[\\s\"'<>]/.test(url))throw Error('Zoom returned an invalid join URL');const safe=url.replaceAll('&','&amp;');return {url,content:'<meta http-equiv=\"refresh\" content=\"0;'+safe+'\">\\n<p>Redirecting, please wait a moment. Meeting will begin shortly…</p>'};}\n"
      },
      "n_49db88e1ad77f321": {
        "name": "Confirm the redirect",
        "imports": [],
        "source": "export default function confirmPage({page,url}){\n const content=page?.content?.rendered;if(typeof content!=='string'||typeof url!=='string')throw Error('WordPress returned no redirect content');\n const tags=content.match(/<meta\\b[^>]*>/gi)??[];\n const found=tags.some(tag=>{if(!/\\bhttp-equiv\\s*=\\s*[\"']refresh[\"']/i.test(tag))return false;const value=tag.match(/\\bcontent\\s*=\\s*([\"'])(.*?)\\1/i)?.[2];if(typeof value!=='string')return false;const decoded=value.replace(/&amp;|&#0*38;|&#x0*26;/gi,'&');return decoded==='0;'+url;});\n if(!found)throw Error('WordPress did not return the expected redirect; check its HTML policy and page');return {message:'Zoom recurring meeting updated!\\n'+url};\n}\n"
      }
    }
