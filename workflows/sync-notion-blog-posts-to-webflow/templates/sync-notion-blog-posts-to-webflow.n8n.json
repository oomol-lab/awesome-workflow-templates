    {
      "id": "sync-notion-blog-posts-to-webflow-17",
      "name": "Turn blocks into HTML1",
      "type": "n8n-nodes-base.code",
      "position": [
        230,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const escape = (value) =>\n  String(value)\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#39;\");\nfunction rich(items) {\n  if (!Array.isArray(items)) throw Error(\"Missing block rich text\");\n  return items\n    .map((item) => {\n      let text = escape(item.plain_text ?? item.text?.content ?? \"\");\n      const a = item.annotations ?? {};\n      if (a.bold) text = `<strong>${text}</strong>`;\n      if (a.italic) text = `<em>${text}</em>`;\n      const link = item.href ?? item.text?.link?.url;\n      if (link) {\n        const url = new URL(link);\n        if (![\"https:\", \"http:\"].includes(url.protocol)) throw Error(\"Unsupported link URL\");\n        text = `<a href=\"${escape(url.href)}\">${text}</a>`;\n      }\n      return text;\n    })\n    .join(\"\");\n}\nfunction render({ blocks }) {\n  if (!Array.isArray(blocks)) throw Error(\"Invalid blocks\");\n  let html = \"\",\n    list = null;\n  const close = () => {\n    if (list) html += `</${list}>`;\n    list = null;\n  };\n  for (const block of blocks) {\n    const t = block.type,\n      data = block[t];\n    if (!data || block.has_children) throw Error(\"Unsupported or nested Notion block\");\n    if (t === \"bulleted_list_item\" || t === \"numbered_list_item\") {\n      const tag = t === \"bulleted_list_item\" ? \"ul\" : \"ol\";\n      if (tag !== list) {\n        close();\n        list = tag;\n        html += `<${tag}>`;\n      }\n      html += `<li>${rich(data.rich_text ?? data.text)}</li>`;\n      continue;\n    }\n    close();\n    if ([\"paragraph\", \"heading_1\", \"heading_2\", \"heading_3\", \"quote\", \"code\"].includes(t)) {\n      const tag = {\n        paragraph: \"p\",\n        heading_1: \"h1\",\n        heading_2: \"h2\",\n        heading_3: \"h3\",\n        quote: \"blockquote\",\n        code: \"pre\",\n      }[t];\n      const content = rich(data.rich_text ?? data.text);\n      html +=\n        t === \"code\"\n          ? `<pre><code>${content}</code></pre>`\n          : `<${tag}>${content || (t === \"paragraph\" ? \" \" : \"\")}</${tag}>`;\n    } else if (t === \"image\") {\n      const url = new URL(data.file?.url ?? data.external?.url);\n      if (url.protocol !== \"https:\") throw Error(\"Image URL must use HTTPS\");\n      const caption = rich(data.caption ?? []);\n      html += `<figure><img src=\"${escape(url.href)}\" alt=\"${escape((data.caption ?? []).map((x) => x.plain_text ?? x.text?.content ?? \"\").join(\"\"))}\"><figcaption>${caption}</figcaption></figure>`;\n    } else throw Error(\"Unsupported Notion block: \" + t);\n  }\n  close();\n  return { html };\n}\n\nconst items = $input.all().map((x) => x.json);\nconst blocks = items.length === 1 && Object.keys(items[0]).length === 0 ? [] : items;\nconst result = render({ blocks });\nreturn [{ json: { newRichText: result.html }, pairedItem: { item: 0 } }];\n"
      },
      "typeVersion": 2
    },
