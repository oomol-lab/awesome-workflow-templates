    {
      "id": "sync-notion-blog-posts-to-webflow-10",
      "name": "Slug uniqueness checker and differentiator1",
      "type": "n8n-nodes-base.code",
      "notes": "Add a number to the slug if it's not unique",
      "position": [
        460,
        160
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nreturn $input.all().map((item, i) => {\n  const p = item.json;\n  const slug =\n    String(p.property_slug ?? \"\") ||\n    String(p.name ?? \"\")\n      .toLowerCase()\n      .normalize(\"NFKD\")\n      .replace(/[^a-z0-9]+/g, \"-\")\n      .replace(/^-|-$/g, \"\");\n  if (!slug || seen.has(slug)) throw Error(\"Missing or duplicate selected Notion slug\");\n  seen.add(slug);\n  return { json: { ...p, property_slug: slug }, pairedItem: { item: i } };\n});\n"
      },
      "notesInFlow": true,
      "typeVersion": 2
    },
