        "name": "Confirm queued Mailgun email",
        "imports": [],
        "source": "function readMailgunQueuedMessage(raw) {\n  if (!raw || typeof raw !== 'object' || Array.isArray(raw) || typeof raw.id !== 'string' || raw.id.length === 0) throw new Error('Mailgun did not return a queued message ID');\n  return raw;\n}\nexport default function mailgunEmailResult({ raw }) {\n  return { message: readMailgunQueuedMessage(raw) };\n}\n"
      }
