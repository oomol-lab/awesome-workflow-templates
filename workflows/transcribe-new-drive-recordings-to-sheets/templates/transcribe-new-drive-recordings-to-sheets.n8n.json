{
  "nodes": [
    {
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1240,
        1120
      ],
      "parameters": {
        "range": "A:D",
        "options": {},
        "sheetId": "YOUR_SPREADSHEET_ID",
        "operation": "append",
        "authentication": "oAuth2"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-0"
    },
    {
      "name": "AWS Transcribe 2",
      "type": "n8n-nodes-base.awsTranscribe",
      "position": [
        920,
        1120
      ],
      "parameters": {
        "operation": "get",
        "transcriptionJobName": "={{$json[\"Key\"]}}"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-1"
    },
    {
      "name": "AWS Transcribe 1",
      "type": "n8n-nodes-base.awsTranscribe",
      "position": [
        600,
        1120
      ],
      "parameters": {
        "transcriptionJobName": "={{ 'drive-' + $('Google Drive Trigger1').item.json.id }}",
        "mediaFileUri": "={{ 's3://YOUR_S3_BUCKET/' + $('Google Drive Trigger1').item.json.id + '/' + $('Google Drive Trigger1').item.json.name }}",
        "detectLanguage": false,
        "languageCode": "en-US",
        "options": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-2"
    },
    {
      "name": "AWS S3 1",
      "type": "n8n-nodes-base.awsS3",
      "position": [
        280,
        1120
      ],
      "parameters": {
        "operation": "upload",
        "bucketName": "YOUR_S3_BUCKET",
        "fileName": "={{ $('Google Drive Trigger1').item.json.id + '/' + $('Google Drive Trigger1').item.json.name }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "tagsUi": {
          "tagsValues": [
            {
              "key": "source",
              "value": "gdrive"
            }
          ]
        },
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-3"
    },
    {
      "name": "AWS S3 2",
      "type": "n8n-nodes-base.awsS3",
      "position": [
        440,
        1120
      ],
      "parameters": {
        "options": {},
        "operation": "getAll",
        "bucketName": "mybucket"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-4"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        1080,
        1120
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "transcription_date",
              "value": "={{ $('AWS Transcribe 1').item.json.CreationTime }}"
            }
          ],
          "string": [
            {
              "name": "recording_name",
              "value": "={{ $('Google Drive Trigger1').item.json.name }}"
            },
            {
              "name": "recording_link",
              "value": "={{ $('Google Drive Trigger1').item.json.webViewLink || '' }}"
            },
            {
              "name": "transcription",
              "value": "={{$json[\"transcript\"]}}"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-5"
    },
    {
      "name": "Google Drive Trigger1",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "position": [
        120,
        1120
      ],
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "triggerOn": "specificFolder",
        "folderToWatch": "YOUR_DRIVE_FOLDER_ID"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-6"
    },
    {
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "position": [
        760,
        1120
      ],
      "parameters": {
        "resume": "webhook",
        "options": {
          "responsePropertyName": "transcript"
        },
        "responseMode": "lastNode"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-7"
    }
  ],
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "AWS Transcribe 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS S3 1": {
      "main": [
        [
          {
            "node": "AWS S3 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS S3 2": {
      "main": [
        [
          {
            "node": "AWS Transcribe 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS Transcribe 1": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS Transcribe 2": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive Trigger1": {
      "main": [
        [
          {
            "node": "AWS S3 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Transcribe New Drive Recordings to Sheets",
  "active": false,
  "pinData": {}
}
