      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        2860,
        0
      ],
      "parameters": {
        "range": "A:D",
        "options": {},
        "sheetId": "YOUR_SPREADSHEET_ID",
        "operation": "append",
        "authentication": "oAuth2"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-13"
    },
    {
