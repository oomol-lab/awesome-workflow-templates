{
  "nodes": [
    {
      "name": "Google Drive Trigger1",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "triggerOn": "specificFolder",
        "folderToWatch": "YOUR_DRIVE_FOLDER_ID"
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-0"
    },
    {
      "name": "File not processed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'file:' + $('Google Drive Trigger1').item.json.id }}"
            }
          ]
        }
      },
      "id": "transcribe-new-drive-recordings-to-sheets-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Reserve file",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'file:' + $('Google Drive Trigger1').item.json.id }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "transcribe-new-drive-recordings-to-sheets-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Restore Drive event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Google Drive Trigger1\").item.json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "transcribe-new-drive-recordings-to-sheets-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Download Drive recording",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Google Drive Trigger1').item.json.id }}"
        },
        "options": {}
      },
      "id": "transcribe-new-drive-recordings-to-sheets-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "AWS S3 1",
      "type": "n8n-nodes-base.awsS3",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "upload",
        "bucketName": "YOUR_S3_BUCKET",
        "fileName": "={{ $('Google Drive Trigger1').item.json.id + '/' + $('Google Drive Trigger1').item.json.name }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "tagsUi": {
          "tagsValues": [
            {
              "key": "source",
              "value": "gdrive"
            }
          ]
        },
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-5"
    },
    {
      "name": "AWS Transcribe 1",
      "type": "n8n-nodes-base.awsTranscribe",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "transcriptionJobName": "={{ 'drive-' + $('Google Drive Trigger1').item.json.id }}",
        "mediaFileUri": "={{ 's3://YOUR_S3_BUCKET/' + $('Google Drive Trigger1').item.json.id + '/' + $('Google Drive Trigger1').item.json.name }}",
        "detectLanguage": false,
        "languageCode": "en-US",
        "options": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-6"
    },
    {
      "name": "Wait for transcription",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "seconds"
      },
      "id": "transcribe-new-drive-recordings-to-sheets-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Check Transcribe status",
      "type": "n8n-nodes-base.awsTranscribe",
      "position": [
        1760,
        0
      ],
      "parameters": {
        "operation": "get",
        "transcriptionJobName": "={{ $('AWS Transcribe 1').item.json.TranscriptionJobName }}",
        "returnTranscript": false
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-8"
    },
    {
      "name": "Check job outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.TranscriptionJobStatus === \"FAILED\") throw Error(\"Transcribe job failed\");\nreturn {\n  json: { done: $json.TranscriptionJobStatus === \"COMPLETED\" },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "transcribe-new-drive-recordings-to-sheets-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Job complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "transcribe-new-drive-recordings-to-sheets-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Read completed transcript",
      "type": "n8n-nodes-base.awsTranscribe",
      "position": [
        2420,
        0
      ],
      "parameters": {
        "operation": "get",
        "transcriptionJobName": "={{ $('AWS Transcribe 1').item.json.TranscriptionJobName }}",
        "returnTranscript": true,
        "simple": true
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-11"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "transcription_date",
              "value": "={{ $('AWS Transcribe 1').item.json.CreationTime }}"
            }
          ],
          "string": [
            {
              "name": "recording_name",
              "value": "={{ $('Google Drive Trigger1').item.json.name }}"
            },
            {
              "name": "recording_link",
              "value": "={{ $('Google Drive Trigger1').item.json.webViewLink || '' }}"
            },
            {
              "name": "transcription",
              "value": "={{$json[\"transcript\"]}}"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 1,
      "id": "transcribe-new-drive-recordings-to-sheets-12"
    },
