      },
      "typeVersion": 3
    },
    {
      "id": "index-mitre-attack-in-qdrant-7",
      "name": "Embed JSON in Qdrant Collection",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "insert",
        "options": {},
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "mitre"
        }
      },
      "typeVersion": 1,
      "onError": "continueErrorOutput"
    },
    {
      "name": "Check file version",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "mitre-index:YOUR_FILE_VERSION"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "index-mitre-attack-in-qdrant-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Inspect file checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\")\n  throw Error(\"Inspect Qdrant before clearing the pending version checkpoint\");\nreturn { json: { done: $json.status === \"done\" } };\n"
      },
      "id": "index-mitre-attack-in-qdrant-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Version already indexed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "index-mitre-attack-in-qdrant-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Reserve file version",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "mitre-index:YOUR_FILE_VERSION",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-mitre-attack-in-qdrant-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Confirm file version",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "mitre-index:YOUR_FILE_VERSION"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-mitre-attack-in-qdrant-12",
      "position": [
        2640,
        0
      ]
    },
