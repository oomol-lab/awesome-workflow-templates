    "modules": {
      "n_217a38892bfedfe3": {
        "name": "Configure Mealie",
        "imports": [],
        "source": "export default function config({ baseUrl, categoryId }) {\n  if (\n    typeof baseUrl !== \"string\" ||\n    !/^https?:\\/\\/[^\\/?#@\\s]+(?:\\/[^?#\\s]*)?$/i.test(baseUrl) ||\n    baseUrl.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure a Mealie base URL without credentials\");\n  if (typeof categoryId !== \"string\" || categoryId.includes(\"YOUR_\"))\n    throw Error(\"Configure a Mealie category ID or leave it empty\");\n  const base = baseUrl.replace(/\\/+$/, \"\");\n  return {\n    base,\n    readUrl:\n      base +\n      \"/api/recipes?perPage=100\" +\n      (categoryId.trim() ? \"&categories=\" + encodeURIComponent(categoryId.trim()) : \"\"),\n    postUrl: base + \"/api/households/mealplans\",\n  };\n}\n"
      },
      "n_9ef65b2c34bd041a": {
        "name": "Choose dinner plans",
        "imports": [],
        "source": "export default function plan({ body, count, offset }) {\n  if (!body || !Array.isArray(body.items)) throw Error(\"Mealie did not return a recipe list\");\n  const items = body.items;\n  if (\n    !Number.isInteger(count) ||\n    count < 1 ||\n    count > 100 ||\n    !Number.isInteger(offset) ||\n    offset < 0 ||\n    offset > 365\n  )\n    throw Error(\"Configure a recipe count from 1 to 100 and a day offset from 0 to 365\");\n  if (items.length < count) throw Error(\"Not enough recipes for the requested meal count\");\n  if (items.some((x) => !x || typeof x.id !== \"string\" || !x.id || typeof x.name !== \"string\"))\n    throw Error(\"A recipe is missing its ID or name\");\n  const ids = items.map((x) => x.id);\n  if (new Set(ids).size !== ids.length) throw Error(\"Recipe IDs must be unique\");\n  const shuffled = [...items];\n  for (let i = shuffled.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n  }\n  const today = new Date();\n  today.setUTCHours(0, 0, 0, 0);\n  return {\n    plans: shuffled.slice(0, count).map((r, i) => {\n      const d = new Date(today);\n      d.setUTCDate(d.getUTCDate() + offset + i);\n      return {\n        date: d.toISOString().slice(0, 10),\n        entryType: \"dinner\",\n        recipeId: r.id,\n        name: r.name,\n      };\n    }),\n  };\n}\n"
      },
      "n_9b0f8b6b2c2bf5de": {
        "name": "Prepare the next dinner",
        "imports": [],
        "source": "export default function next({ plans, previousState, body }) {\n  const i = previousState?.index ?? 0;\n  if (\n    i > 0 &&\n    (!body ||\n      !Number.isSafeInteger(body.id) ||\n      body.recipeId !== plans[i - 1].recipeId ||\n      body.date !== plans[i - 1].date)\n  )\n    throw Error(\"Mealie did not confirm the previous meal\");\n  return {\n    state: { index: i + 1 },\n    more: i < plans.length,\n    body: i < plans.length ? plans[i] : {},\n    count: i,\n  };\n}\n"
      }
    }
