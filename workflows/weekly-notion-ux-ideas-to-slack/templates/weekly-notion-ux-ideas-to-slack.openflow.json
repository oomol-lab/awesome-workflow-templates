    "modules": {
      "n_42cbdd82c37bf03a": {
        "name": "Count new UX ideas",
        "imports": [],
        "source": "export default async function count({ previous, sourceId, typeProperty }, context) {\n  if (\n    !sourceId ||\n    sourceId.startsWith(\"YOUR_\") ||\n    !typeProperty ||\n    typeProperty.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure the Notion data source and multi-select property\");\n  const s = previous ?? {\n    since: new Date(Date.now() - 7 * 86400000).toISOString(),\n    cursor: null,\n    cursors: [],\n    ids: [],\n  };\n  const args = {\n    dataSourceId: sourceId,\n    pageSize: 100,\n    filter: { timestamp: \"created_time\", created_time: { on_or_after: s.since } },\n  };\n  if (s.cursor) args.startCursor = s.cursor;\n  const page = await context.actions.call(\"notion.query_data_source\", args);\n  if (!page || !Array.isArray(page.results) || typeof page.has_more !== \"boolean\")\n    throw Error(\"Invalid Notion page\");\n  if (\n    page.has_more &&\n    (typeof page.next_cursor !== \"string\" ||\n      !page.next_cursor ||\n      s.cursors.includes(page.next_cursor))\n  )\n    throw Error(\"Invalid Notion cursor\");\n  const ids = new Set(s.ids);\n  for (const row of page.results) {\n    const p = row?.properties?.[typeProperty];\n    if (\n      row?.object !== \"page\" ||\n      typeof row.id !== \"string\" ||\n      !row.id ||\n      p?.type !== \"multi_select\" ||\n      !Array.isArray(p.multi_select)\n    )\n      throw Error(\"Invalid Notion page or UX property\");\n    if (p.multi_select.some((x) => x.name === \"UX\")) ids.add(row.id);\n  }\n  const state = {\n    ...s,\n    ids: [...ids],\n    cursor: page.has_more ? page.next_cursor : null,\n    cursors: page.has_more ? [...s.cursors, page.next_cursor] : s.cursors,\n  };\n  return {\n    state,\n    more: page.has_more,\n    text: `Yay, we added *${ids.size} new UX ideas* in the last 7 days :tada:`,\n  };\n}\n"
      }
    }
