    "modules": {
      "n_7a671d0745874ef3": {
        "name": "Read inventory update",
        "imports": [],
        "source": "export default function prepare({ body, shop }) {\n  const available = body.available;\n  const match = String(body.admin_graphql_api_id || \"\").match(/[?&]inventory_item_id=(\\d+)/);\n  if (!match) throw Error(\"Missing inventory item ID in Shopify inventory level ID\");\n  return {\n    alert: available === 0 || (available > 0 && available < 4),\n    sold: available === 0,\n    url: `https://${shop}/admin/api/2026-07/graphql.json`,\n    body: {\n      query:\n        \"query Inventory($id: ID!) { inventoryItem(id: $id) { id variant { title inventoryQuantity product { title featuredImage { url } } } } }\",\n      variables: { id: \"gid://shopify/InventoryItem/\" + match[1] },\n    },\n  };\n}\n"
      },
      "n_74625ca91f6c1d87": {
        "name": "Prepare Discord alert",
        "imports": [],
        "source": "export default function embed({ body, sold }) {\n  if (body.errors?.length || !body.data?.inventoryItem?.variant)\n    throw Error(\"Shopify inventory item unavailable\");\n  const variant = body.data.inventoryItem.variant,\n    product = variant.product;\n  const embed = {\n    title: product.title,\n    description: sold ? \"This product is sold out!\" : \"This product is running out of stock!\",\n    color: sold ? 16711680 : 16776960,\n    fields: [\n      { name: \"Remaining Inventory\", value: String(variant.inventoryQuantity), inline: false },\n      { name: \"Product Variant\", value: variant.title, inline: true },\n    ],\n    footer: { text: \"Alert from inventory management system\" },\n  };\n  if (product.featuredImage?.url) embed.image = { url: product.featuredImage.url };\n  return { body: { embeds: [embed] } };\n}\n"
      }
    }
