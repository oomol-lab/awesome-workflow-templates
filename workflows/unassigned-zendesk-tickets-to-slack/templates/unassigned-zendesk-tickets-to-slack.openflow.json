    "modules": {
      "n_f2376d24c6f8a953": {
        "name": "Collect matching tickets",
        "imports": [],
        "source": "export default function collect({ previousState, body, statusCode, bodyEncoding }) {\n  const state = previousState === null ? { page: 1, tickets: [], count: null } : previousState;\n  if (!state || !Number.isInteger(state.page) || !Array.isArray(state.tickets))\n    throw Error(\"Invalid search state\");\n  if (previousState !== null) {\n    if (\n      statusCode < 200 ||\n      statusCode >= 300 ||\n      bodyEncoding !== null ||\n      !body ||\n      !Array.isArray(body.results) ||\n      !Number.isInteger(body.count) ||\n      body.count < 0\n    )\n      throw Error(\"Zendesk search failed or returned an invalid page\");\n    if (body.count > 1000) throw Error(\"Zendesk search exceeds the 1000-result limit\");\n    if (state.count !== null && state.count !== body.count)\n      throw Error(\"Zendesk search changed while paging\");\n    const ids = new Set(state.tickets.map((t) => t.id));\n    for (const ticket of body.results) {\n      if (\n        !ticket ||\n        !Number.isSafeInteger(ticket.id) ||\n        ticket.id < 1 ||\n        typeof ticket.url !== \"string\" ||\n        typeof ticket.status !== \"string\" ||\n        typeof ticket.subject !== \"string\" ||\n        ids.has(ticket.id)\n      )\n        throw Error(\"Invalid or duplicate Zendesk ticket\");\n      ids.add(ticket.id);\n      state.tickets.push({\n        id: ticket.id,\n        url: ticket.url,\n        status: ticket.status,\n        subject: ticket.subject,\n      });\n    }\n    state.count = body.count;\n    if (\n      state.tickets.length > state.count ||\n      (body.next_page == null && state.tickets.length !== state.count) ||\n      (body.next_page != null && body.results.length === 0)\n    )\n      throw Error(\"Incomplete Zendesk search\");\n    if (body.next_page == null)\n      return {\n        state,\n        more: false,\n        query: {\n          query: \"type:ticket assignee:none status<pending\",\n          per_page: 100,\n          page: state.page,\n        },\n        tickets: state.tickets,\n      };\n    if (state.page >= 10) throw Error(\"Zendesk search exceeds the 1000-result limit\");\n    state.page++;\n  }\n  return {\n    state,\n    more: true,\n    query: { query: \"type:ticket assignee:none status<pending\", per_page: 100, page: state.page },\n    tickets: state.tickets,\n  };\n}\n"
      },
      "n_e10bd2c891b11baa": {
        "name": "Prepare ticket summary",
        "imports": [],
        "source": "export default function summarize({ tickets }) {\n  if (!Array.isArray(tickets)) throw Error(\"Expected Zendesk tickets\");\n  const escape = (value) =>\n    value\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replace(/[\\r\\n]+/g, \" \")\n      .replace(/[*_~`]/g, (char) => ({ \"*\": \"＊\", _: \"＿\", \"~\": \"～\", \"`\": \"｀\" })[char]);\n  let message = \"*Unassigned Tickets*\\n\\n\";\n  for (const t of tickets) {\n    if (\n      !t ||\n      !Number.isSafeInteger(t.id) ||\n      t.id < 1 ||\n      typeof t.url !== \"string\" ||\n      typeof t.status !== \"string\" ||\n      typeof t.subject !== \"string\"\n    )\n      throw Error(\"Invalid Zendesk ticket\");\n    const match = /^https:\\/\\/([a-z0-9-]+\\.zendesk\\.com)\\/api\\/v2\\/tickets\\/(\\d+)\\.json$/i.exec(\n      t.url,\n    );\n    if (!match || Number(match[2]) !== t.id) throw Error(\"Invalid ticket URL\");\n    message += `*<https://${match[1]}/agent/tickets/${t.id}|${t.id}>* [${escape(t.status.toUpperCase())}] - ${escape(t.subject)}\\n`;\n  }\n  if (message.length > 40000) throw Error(\"Slack message exceeds 40000 characters\");\n  return { message, hasTickets: tickets.length > 0 };\n}\n"
      }
