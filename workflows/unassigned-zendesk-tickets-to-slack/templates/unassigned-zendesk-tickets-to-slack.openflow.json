    "modules": {
      "n_f2376d24c6f8a953": {
        "name": "Collect matching tickets",
        "imports": [],
        "source": "export default function collect({previousState,body,statusCode,bodyEncoding}) {\n  const state = previousState === null ? {page:1,tickets:[],count:null} : previousState;\n  if (!state || !Number.isInteger(state.page) || !Array.isArray(state.tickets)) throw Error('Invalid search state');\n  if (previousState !== null) {\n    if (statusCode < 200 || statusCode >= 300 || bodyEncoding !== null || !body || !Array.isArray(body.results) || !Number.isInteger(body.count) || body.count < 0) throw Error('Zendesk search failed or returned an invalid page');\n    if (body.count > 1000) throw Error('Zendesk search exceeds the 1000-result limit');\n    if (state.count !== null && state.count !== body.count) throw Error('Zendesk search changed while paging');\n    const ids = new Set(state.tickets.map(t=>t.id));\n    for (const ticket of body.results) {\n      if (!ticket || !Number.isSafeInteger(ticket.id) || ticket.id < 1 || typeof ticket.url !== 'string' || typeof ticket.status !== 'string' || typeof ticket.subject !== 'string' || ids.has(ticket.id)) throw Error('Invalid or duplicate Zendesk ticket');\n      ids.add(ticket.id); state.tickets.push({id:ticket.id,url:ticket.url,status:ticket.status,subject:ticket.subject});\n    }\n    state.count=body.count;\n    if (state.tickets.length > state.count || (body.next_page == null && state.tickets.length !== state.count) || (body.next_page != null && body.results.length === 0)) throw Error('Incomplete Zendesk search');\n    if (body.next_page == null) return {state,more:false,query:{query:'type:ticket assignee:none status<pending',per_page:100,page:state.page},tickets:state.tickets};\n    if (state.page >= 10) throw Error('Zendesk search exceeds the 1000-result limit');\n    state.page++;\n  }\n  return {state,more:true,query:{query:'type:ticket assignee:none status<pending',per_page:100,page:state.page},tickets:state.tickets};\n}\n"
      },
      "n_e10bd2c891b11baa": {
        "name": "Prepare ticket summary",
        "imports": [],
        "source": "export default function summarize({tickets}) {\n  if (!Array.isArray(tickets)) throw Error('Expected Zendesk tickets');\n  const escape = value => value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replace(/[\\r\\n]+/g,' ').replace(/[*_~`]/g, char => ({'*':'＊','_':'＿','~':'～','`':'｀'})[char]);\n  let message='*Unassigned Tickets*\\n\\n';\n  for (const t of tickets) {\n    if (!t || !Number.isSafeInteger(t.id) || t.id < 1 || typeof t.url !== 'string' || typeof t.status !== 'string' || typeof t.subject !== 'string') throw Error('Invalid Zendesk ticket');\n    const match = /^https:\\/\\/([a-z0-9-]+\\.zendesk\\.com)\\/api\\/v2\\/tickets\\/(\\d+)\\.json$/i.exec(t.url);\n    if (!match || Number(match[2]) !== t.id) throw Error('Invalid ticket URL');\n    message += `*<https://${match[1]}/agent/tickets/${t.id}|${t.id}>* [${escape(t.status.toUpperCase())}] - ${escape(t.subject)}\\n`;\n  }\n  if (message.length > 40000) throw Error('Slack message exceeds 40000 characters');\n  return {message,hasTickets:tickets.length>0};\n}\n"
      }
