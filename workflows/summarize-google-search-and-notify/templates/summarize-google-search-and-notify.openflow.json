    "modules": {
      "n_4c2397811deeb4cf": {
        "name": "Prepare search request",
        "imports": [],
        "source": "export default function prepare({ query, zone }) {\n  return {\n    body: {\n      zone,\n      url: \"https://www.google.com/search?q=\" + encodeURIComponent(query),\n      format: \"raw\",\n    },\n  };\n}\n"
      },
      "n_db4a710772f6a336": {
        "name": "Prepare notification",
        "imports": [],
        "source": "export default function prepare({ result, summary }) {\n  return { body: { search_summary: summary, search_result: result } };\n}\n"
      }
