    {
      "id": "summarize-google-search-and-notify-4",
      "name": "Google Search Data Extractor",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "position": [
        960,
        -440
      ],
      "parameters": {
        "text": "={{ $json.data }}",
        "options": {
          "systemPromptTemplate": "You are an expert HTML extractor. Your job is to analyze the search result and \nstrip out the html, css, scripts and produce a textual data."
        },
        "attributes": {
          "attributes": [
            {
              "name": "textual_response",
              "description": "Textual Response"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "summarize-google-search-and-notify-5",
      "name": "Perform Google Search Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        720,
        -440
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.brightdata.com/request",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {zone:$json.zone,url:\"https://www.google.com/search?q=\"+encodeURIComponent($json.search_query),format:\"raw\"} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "summarize-google-search-and-notify-6",
      "name": "Set Google Search Query",
      "type": "n8n-nodes-base.set",
      "position": [
        440,
        -440
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "3aedba66-f447-4d7a-93c0-8158c5e795f9",
              "name": "search_query",
              "type": "string",
              "value": "Bright Data"
            },
            {
              "id": "4e7ee31d-da89-422f-8079-2ff2d357a0ba",
              "name": "zone",
              "type": "string",
              "value": "YOUR_SERP_ZONE"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "summarize-google-search-and-notify-notify",
      "name": "Send search results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://example.com/YOUR_WEBHOOK",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {search_summary:$json.response.text,search_result:$(\"Google Search Data Extractor\").first().json.output.textual_response} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      }
    }
  ],
