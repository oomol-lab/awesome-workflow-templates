    "modules": {
      "n_fd5297610ea920ad": {
        "name": "Prepare window and recipients",
        "imports": [],
        "source": "export function prepareEmailSummaryWindow({ searchScope, recipient, cc }, anchor) {\n  const cleanAddress = (value) => {\n    if (typeof value !== 'string' || !/^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/u.test(value.trim())) throw new Error('Configure a plain recipient email address.');\n    return value.trim();\n  };\n  if (typeof searchScope !== 'string' || !searchScope.trim() || searchScope.includes('YOUR_GMAIL_SEARCH_SCOPE')) throw new Error('Configure the Gmail search scope.');\n  const to = cleanAddress(recipient);\n  if (!Array.isArray(cc)) throw new Error('CC must be an array of plain email addresses.');\n  const copies = cc.map(cleanAddress), end = new Date(anchor).getTime();\n  if (!Number.isSafeInteger(end) || end < Date.UTC(2000, 0, 2)) throw new Error('Invalid captured execution time.');\n  const offset = 330 * 60 * 1000, local = new Date(end + offset);\n  const today = Date.UTC(local.getUTCFullYear(), local.getUTCMonth(), local.getUTCDate());\n  const start = today - 86400000 - offset, endSeconds = Math.floor(end / 1000);\n  const startDate = new Date(start + offset).toISOString().slice(0, 10);\n  const endLabel = local.toISOString().slice(0, 16).replace('T', ' ');\n  return { query: '(' + searchScope.trim() + ') after:' + Math.floor(start / 1000) + ' before:' + endSeconds,\n    recipient: to, cc: copies, windowStart: new Date(start).toISOString(), windowEnd: new Date(endSeconds * 1000).toISOString(),\n    subject: 'Email summary | ' + startDate + ' 00:00 to ' + endLabel + ' Asia/Kolkata' };\n}\n\nexport default function prepareWindow(input) {\n  return prepareEmailSummaryWindow(input, new Date().toISOString());\n}\n"
      },
      "n_14d9bda825945c2d": {
        "name": "List all matching message IDs",
        "imports": [],
        "source": "export default async function listAllMatchingMessages({ query }, context) {\n  const messageIds = [], seenTokens = new Set();\n  let pageToken;\n  do {\n    context.signal?.throwIfAborted();\n    const page = await context.actions.call('gmail.fetch_emails', { query, maxResults: 100, detail: 'ids', includeSpamTrash: false, ...(pageToken ? { pageToken } : {}) });\n    if (!page || !Array.isArray(page.messages)) throw new Error('Gmail did not return a message page.');\n    for (const message of page.messages) {\n      if (typeof message?.messageId !== 'string' || !message.messageId) throw new Error('Gmail returned a missing message ID.');\n      messageIds.push(message.messageId);\n    }\n    const next = page.nextPageToken;\n    if (next == null || next === '') break;\n    if (typeof next !== 'string' || seenTokens.has(next)) throw new Error('Gmail returned an invalid or repeated page token.');\n    seenTokens.add(next); pageToken = next;\n  } while (true);\n  return { messageIds, count: messageIds.length };\n}\n"
      },
      "n_b6f004db11f59971": {
        "name": "No matching email",
        "imports": [],
        "source": "export default function empty(input){return {status:\"no_matching_email\",messageId:null,count:0,...input};}"
      },
      "n_7d3a6a6d22f9286c": {
        "name": "Read headers and snippets",
        "imports": [],
        "source": "export function emailSummaryFields(message, id, alreadyDecoded = false) {\n  if (typeof id !== 'string' || !id || !message || message.messageId !== id || (message.snippet != null && typeof message.snippet !== 'string')) throw new Error('Gmail returned a different message or invalid snippet.');\n  const headers = message.payload?.headers ?? [];\n  if (!Array.isArray(headers)) throw new Error('Gmail did not return message headers.');\n  const header = (name) => {\n    const values = headers.filter((entry) => typeof entry?.name === 'string' && entry.name.toLowerCase() === name);\n    if (values.some((entry) => typeof entry.value !== 'string')) throw new Error('Gmail returned an invalid header.');\n    return values.map((entry) => entry.value).join(', ');\n  };\n  const rawSnippet = message.snippet ?? '';\n  const snippet = alreadyDecoded ? rawSnippet : rawSnippet.replace(/&amp;|&lt;|&gt;|&#39;|&quot;/gu, (entity) => ({ '&amp;': '&', '&lt;': '<', '&gt;': '>', '&#39;': \"'\", '&quot;': '\"' })[entity]);\n  return { id, From: header('from'), To: header('to'), CC: header('cc'), snippet };\n}\n\nexport default async function readSummaryMessages({ messageIds }, context) {\n  if (!Array.isArray(messageIds) || messageIds.some((id) => typeof id !== 'string' || !id)) throw new Error('Invalid Gmail message IDs.');\n  const messages = [];\n  for (const messageId of messageIds) {\n    context.signal?.throwIfAborted();\n    const message = await context.actions.call('gmail.fetch_message_by_message_id', { messageId, format: 'metadata' });\n    messages.push(emailSummaryFields(message, messageId));\n  }\n  return { emailData: JSON.stringify(messages), count: messages.length };\n}\n"
      },
      "n_a89b4ae1c6feace9": {
        "name": "Format safe summary email",
        "imports": [],
        "source": "export function formatEmailSummary(summary) {\n  const nonblank = (value) => typeof value === 'string' && value.trim().length > 0;\n  if (!summary || !Array.isArray(summary.summary_of_emails) || !Array.isArray(summary.actions)\n    || summary.summary_of_emails.some((value) => !nonblank(value))\n    || summary.actions.some((value) => !value || !nonblank(value.name) || !nonblank(value.action))) throw new Error('The model did not return a complete email summary.');\n  const escape = (value) => value.replace(/[&<>\"']/gu, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[character]);\n  const points = summary.summary_of_emails.map((value) => '<li>' + escape(value) + '</li>').join('');\n  const actions = summary.actions.map((value) => '<li><strong>' + escape(value.name) + ':</strong> ' + escape(value.action) + '</li>').join('');\n  return '<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Email summary</title></head><body><h1>Email summary</h1><h2>Summary of emails</h2><ul>' + points + '</ul><h2>Actions</h2><ul>' + actions + '</ul></body></html>';\n}\n\nexport default function prepareEmail({ summary }) {\n  return { html: formatEmailSummary(summary) };\n}\n"
      },
      "n_6ef0b5aa2ed2d83c": {
        "name": "Confirm sent email",
        "imports": [],
        "source": "export default function confirmEmail({ messageId, count, windowStart, windowEnd }) {\n  if (typeof messageId !== 'string' || !messageId.trim()) throw new Error('Gmail did not confirm a sent message ID.');\n  return { status: 'sent', messageId, count, windowStart, windowEnd };\n}\n"
      }
    }
