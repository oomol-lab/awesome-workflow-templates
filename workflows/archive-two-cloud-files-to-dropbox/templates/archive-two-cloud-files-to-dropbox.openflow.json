        "source": "function configureArchive({ firstUrl, firstName, secondUrl, secondName, destination }) {\n  const urls = [firstUrl, secondUrl];\n  if (\n    !urls.every(\n      (url) =>\n        typeof url === \"string\" && /^https:\\/\\/[a-z0-9.-]+(?::\\d{1,5})?\\/[^\\s#\\\\]*$/i.test(url),\n    ) ||\n    firstUrl === secondUrl\n  )\n    throw new Error(\"Enter two distinct direct HTTPS file URLs\");\n  const names = [firstName, secondName];\n  if (\n    !names.every(\n      (name) =>\n        typeof name === \"string\" &&\n        name.length > 0 &&\n        name.length <= 180 &&\n        name === name.trim() &&\n        !/[<>:\"/\\\\|?*\\u0000-\\u001f]/.test(name) &&\n        !name.endsWith(\".\") &&\n        !Object.hasOwn(Object.prototype, name),\n    ) ||\n    firstName.toLowerCase() === secondName.toLowerCase()\n  ) {\n    throw new Error(\"Use two distinct filenames without directory components\");\n  }\n  const parts = typeof destination === \"string\" ? destination.split(\"/\") : [];\n  if (\n    parts.length < 2 ||\n    parts[0] !== \"\" ||\n    destination.length > 512 ||\n    !/\\.zip$/i.test(parts.at(-1)) ||\n    parts\n      .slice(1)\n      .some((part) => !part || part === \".\" || part === \"..\" || /[\\\\\\u0000-\\u001f]/.test(part))\n  ) {\n    throw new Error(\"Enter a full Dropbox path ending in a ZIP filename\");\n  }\n  return { firstUrl, firstName, secondUrl, secondName, destination, archiveName: parts.at(-1) };\n}\nexport default configureArchive;\n"
      },
      "n_8ec1539f868217db": {
        "name": "Build the two-file ZIP",
        "imports": [],
        "source": "import { deflateRawSync } from \"node:zlib\";\nfunction validateDownload({ status, size }) {\n  if (status !== 200) throw new Error(\"Both downloads must return a complete file\");\n  if (!Number.isSafeInteger(size) || size < 0 || size > 1024 * 1024) {\n    throw new Error(\"Each source file must be at most 1 MiB\");\n  }\n}\nfunction crc32(bytes) {\n  const table = new Uint32Array(256);\n  for (let index = 0; index < table.length; index++) {\n    let crc = index;\n    for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0);\n    table[index] = crc;\n  }\n  let crc = 0xffffffff;\n  for (const byte of bytes) crc = (crc >>> 8) ^ table[(crc ^ byte) & 255];\n  return (crc ^ 0xffffffff) >>> 0;\n}\nfunction zipFiles(entries) {\n  const localParts = [],\n    directoryParts = [];\n  let offset = 0,\n    directorySize = 0;\n  for (const { name, bytes } of entries) {\n    const filename = new TextEncoder().encode(name);\n    // Keep DEFLATE inputs and worst-case output within the sandbox's native zlib boundary.\n    const deflated = bytes.length <= 1020 * 1024 ? deflateRawSync(bytes) : bytes;\n    const compressed = deflated.length < bytes.length;\n    const data = compressed ? deflated : bytes;\n    const crc = crc32(bytes);\n    const local = new DataView(new ArrayBuffer(30));\n    local.setUint32(0, 0x04034b50, true);\n    local.setUint16(4, 20, true);\n    local.setUint16(6, 0x0800, true); // UTF-8 filenames\n    local.setUint16(8, compressed ? 8 : 0, true);\n    local.setUint16(12, 0x21, true); // 1980-01-01 in DOS date format\n    local.setUint32(14, crc, true);\n    local.setUint32(18, data.length, true);\n    local.setUint32(22, bytes.length, true);\n    local.setUint16(26, filename.length, true);\n\n    const central = new DataView(new ArrayBuffer(46));\n    central.setUint32(0, 0x02014b50, true);\n    central.setUint16(4, 20, true);\n    new Uint8Array(central.buffer).set(new Uint8Array(local.buffer, 4, 26), 6);\n    central.setUint32(42, offset, true);\n    localParts.push(new Uint8Array(local.buffer), filename, data);\n    directoryParts.push(new Uint8Array(central.buffer), filename);\n    offset += local.byteLength + filename.length + data.length;\n    directorySize += central.byteLength + filename.length;\n  }\n  const end = new DataView(new ArrayBuffer(22));\n  end.setUint32(0, 0x06054b50, true);\n  end.setUint16(8, entries.length, true);\n  end.setUint16(10, entries.length, true);\n  end.setUint32(12, directorySize, true);\n  end.setUint32(16, offset, true);\n  const archive = new Uint8Array(offset + directorySize + end.byteLength);\n  let written = 0;\n  for (const part of [...localParts, ...directoryParts, new Uint8Array(end.buffer)]) {\n    archive.set(part, written);\n    written += part.length;\n  }\n  return archive;\n}\nexport default async function archive(\n  { first, second, firstName, secondName, firstStatus, secondStatus, archiveName },\n  context,\n) {\n  validateDownload({ status: firstStatus, size: first.size });\n  validateDownload({ status: secondStatus, size: second.size });\n  const firstBytes = await context.artifact.open(first);\n  const secondBytes = await context.artifact.open(second);\n  const bytes = zipFiles([\n    { name: firstName, bytes: firstBytes },\n    { name: secondName, bytes: secondBytes },\n  ]);\n  return {\n    zip: await context.artifact.put(bytes, { name: archiveName, mediaType: \"application/zip\" }),\n  };\n}\n"
      },
      "n_74a54e3868ec748e": {
        "name": "Prepare the ZIP for Dropbox",
        "imports": [],
        "source": "export default async function prepare({ zip }, context) {\n  const bytes = await context.artifact.open(zip);\n  // Complete groups of three bytes keep padding solely at the end of the archive.\n  const chunkSize = 12288;\n  let contentBase64 = \"\";\n  for (let offset = 0; offset < bytes.length; offset += chunkSize) {\n    contentBase64 += btoa(String.fromCharCode(...bytes.subarray(offset, offset + chunkSize)));\n  }\n  return { contentBase64 };\n}\n"
      }
    },
    "features": [
      "http-request-artifacts"
    ]
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
