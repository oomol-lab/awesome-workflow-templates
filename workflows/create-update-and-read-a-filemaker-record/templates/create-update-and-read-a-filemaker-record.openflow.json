    "modules": {
      "n_3efd0a9032bc37eb": {
        "name": "Prepare the record",
        "imports": [],
        "source": "export default function config({server,database,layout,firstName,lastName,country}){for(const x of [server,database,layout,firstName,lastName,country])if(typeof x!=='string'||!x.trim())throw Error('All settings are required');if(!/^https:\\/\\/[^/\\s]+$/.test(server))throw Error('Use the HTTPS FileMaker server origin');const url=server+'/fmi/data/vLatest/databases/'+encodeURIComponent(database)+'/layouts/'+encodeURIComponent(layout)+'/records';return{url,body:{fieldData:{first_name:firstName,last_name:lastName}},country}}\n"
      },
      "n_b078c35e3ddfc229": {
        "name": "Prepare the country update",
        "imports": [],
        "source": "export default function created({body,url,country}){if(!body||!Array.isArray(body.messages)||body.messages.some(m=>m.code!=='0')||!body.response||!/^\\d+$/.test(String(body.response.recordId))||!/^\\d+$/.test(String(body.response.modId)))throw Error('FileMaker did not confirm record creation');return{url:url+'/'+body.response.recordId,body:{fieldData:{address_country:country},modId:body.response.modId}}}\n"
      },
      "n_3e05155b4fc7237f": {
        "name": "Confirm the update",
        "imports": [],
        "source": "export default function confirm({body,url}){if(!body||!Array.isArray(body.messages)||body.messages.some(m=>m.code!=='0')||!body.response||!/^\\d+$/.test(String(body.response.modId)))throw Error('FileMaker did not confirm update');return{url}}\n"
      },
      "n_b98f4a062bfc9f1e": {
        "name": "Check the returned record",
        "imports": [],
        "source": "export default function result({body}){if(!body||!Array.isArray(body.messages)||body.messages.some(m=>m.code!=='0')||!Array.isArray(body.response?.data)||body.response.data.length!==1)throw Error('FileMaker did not return one record');return{record:body.response.data[0]}}\n"
      }
    }
