    "modules": {
      "n_345dd6f6a558cc12": {
        "name": "Read the sender and pull request",
        "imports": [],
        "source": "export default function event({ body }) {\n  const login = body?.sender?.login,\n    url = body?.pull_request?.html_url;\n  if (typeof login !== \"string\" || !login.trim() || typeof url !== \"string\")\n    throw Error(\"Pull request event is missing its sender or URL\");\n  const parsed = new URL(url);\n  if (\n    parsed.protocol !== \"https:\" ||\n    parsed.hostname !== \"github.com\" ||\n    parsed.username ||\n    parsed.password\n  )\n    throw Error(\"Invalid GitHub pull request URL\");\n  return { login, url };\n}\n"
      },
      "n_7f7596b524af7f46": {
        "name": "Check the public email",
        "imports": [],
        "source": "export default function email({ user }) {\n  const value = user?.email;\n  if (value == null || value === \"\") return { available: false, email: \"-\" };\n  if (typeof value !== \"string\" || !value.trim()) throw Error(\"Invalid public email\");\n  return { available: true, email: value.trim() };\n}\n"
      },
      "n_36d033a268fdbb79": {
        "name": "Prepare the next note",
        "imports": [],
        "source": "export default function next({ items, url, previousState }) {\n  if (!Array.isArray(items)) throw Error(\"Invalid Pipedrive search results\");\n  let index = previousState?.index ?? 0;\n  if (!Number.isSafeInteger(index) || index < 0 || index > items.length)\n    throw Error(\"Invalid iteration state\");\n  while (index < items.length) {\n    const person = items[index++]?.item;\n    if (!Number.isSafeInteger(person?.id) || person.id < 1 || typeof person.name !== \"string\")\n      throw Error(\"Invalid Pipedrive person\");\n    if (person.name === \"\") continue;\n    const safe = url\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replaceAll('\"', \"&quot;\")\n      .replaceAll(\"'\", \"&#39;\");\n    return {\n      more: true,\n      state: { index },\n      body: { person_id: person.id, content: \"Created a PR \\n\" + safe },\n    };\n  }\n  return { more: false, state: { index }, body: {} };\n}\n"
      },
      "n_f6fa16e5ce475ec8": {
        "name": "Check the note result",
        "imports": [],
        "source": "export default function ({ statusCode, body }) {\n  if (statusCode < 200 || statusCode >= 300 || !body || body.success !== true)\n    throw Error(\"Pipedrive note creation failed\");\n  return {};\n}\n"
      }
    }
