    "modules": {
      "n_abe2bc937513c0ae": {
        "name": "Prepare reminders",
        "imports": [],
        "source": "export default function invoiceReminders({ values, timezone, signature, now }) {\n  if (!Array.isArray(values)) throw new Error(\"Invoice values must be an array.\");\n  if (!values.length) return { reminders: [], count: 0 };\n  const headers = values[0];\n  const required = [\"Numero\", \"Cliente\", \"Email\", \"Importo\", \"Scadenza\", \"Stato\"];\n  if (!Array.isArray(headers) || required.some((header) => !headers.includes(header)))\n    throw new Error(\"Invoice sheet headers must include \" + required.join(\", \") + \".\");\n  for (const header of required)\n    if (headers.filter((name) => name === header).length !== 1)\n      throw new Error(\"Duplicate invoice header: \" + header);\n  const dateParts = new Intl.DateTimeFormat(\"en-GB\", {\n    timeZone: timezone,\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n  }).formatToParts(now ? new Date(now) : new Date());\n  const part = (name) => Number(dateParts.find((value) => value.type === name).value);\n  const today = Date.UTC(part(\"year\"), part(\"month\") - 1, part(\"day\"));\n  const reminders = [];\n  for (const [sourceIndex, row] of values.slice(1).entries()) {\n    if (!Array.isArray(row)) throw new Error(\"Invoice row must be an array.\");\n    const invoice = Object.fromEntries(headers.map((header, index) => [header, row[index] ?? \"\"]));\n    if (String(invoice.Stato).trim().toLowerCase() === \"pagata\") continue;\n    const match = /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/.exec(String(invoice.Scadenza).trim());\n    if (!match) continue;\n    const [, day, month, year] = match.map(Number);\n    const due = new Date(Date.UTC(year, month - 1, day));\n    if (\n      due.getUTCFullYear() !== year ||\n      due.getUTCMonth() !== month - 1 ||\n      due.getUTCDate() !== day\n    )\n      continue;\n    const daysRemaining = Math.round((due.getTime() - today) / 86400000);\n    if (daysRemaining > 3) continue;\n    const to = String(invoice.Email).trim();\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(to))\n      throw new Error(\"Invalid email for invoice \" + invoice.Numero + \".\");\n    const overdue = daysRemaining < 0;\n    const dueText = `${String(day).padStart(2, \"0\")}/${String(month).padStart(2, \"0\")}/${year}`;\n    reminders.push({\n      to,\n      daysRemaining,\n      sourceIndex,\n      subject: `Promemoria: fattura ${invoice.Numero} ${overdue ? \"scaduta\" : \"in scadenza\"}`,\n      body: `Gentile ${invoice.Cliente},\\n\\nle ricordiamo che la fattura n. ${invoice.Numero} di € ${invoice.Importo} ${overdue ? \"risulta scaduta il\" : \"è in scadenza il\"} ${dueText}.\\n\\nSe il pagamento è già stato effettuato, la preghiamo di ignorare questo messaggio.\\n\\nPer qualsiasi chiarimento siamo a disposizione.\\n\\nCordiali saluti,\\n${signature}`,\n    });\n  }\n  return { reminders, count: reminders.length };\n}\n"
      },
      "n_dbe2dd78f837b72f": {
        "name": "Prepare next reminder",
        "imports": [],
        "source": "export default function nextReminder({ reminders, previousState, lastMessageId }) {\n  if (!Array.isArray(reminders)) throw new Error(\"Expected the complete prepared reminder array.\");\n  let sent = [];\n  if (previousState === null) {\n    if (lastMessageId !== null) throw new Error(\"Unexpected Gmail receipt before delivery starts.\");\n  } else {\n    if (\n      !previousState ||\n      !Array.isArray(previousState.sent) ||\n      previousState.sent.length >= reminders.length\n    )\n      throw new Error(\"Invalid reminder delivery state.\");\n    if (typeof lastMessageId !== \"string\" || !lastMessageId.trim())\n      throw new Error(\"Gmail returned no sent message identifier; inspect Sent before retrying.\");\n    sent = [\n      ...previousState.sent,\n      { to: reminders[previousState.sent.length].to, messageId: lastMessageId },\n    ];\n  }\n  const reminder = reminders[sent.length];\n  return {\n    state: { sent },\n    sent,\n    count: sent.length,\n    more: sent.length < reminders.length,\n    to: reminder?.to ?? \"\",\n    subject: reminder?.subject ?? \"\",\n    body: reminder?.body ?? \"\",\n  };\n}\n"
      }
    }
  },
