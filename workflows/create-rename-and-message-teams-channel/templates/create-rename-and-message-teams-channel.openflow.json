    "modules": {
      "n_ffbfdbeb8575faef": {
        "name": "Prepare channel",
        "imports": [],
        "source": "export default function setup({ teamId, name }) {\n  return {\n    url: `https://graph.microsoft.com/v1.0/teams/${encodeURIComponent(teamId)}/channels`,\n    body: { displayName: name },\n  };\n}\n"
      },
      "n_4de9307d0093f318": {
        "name": "Prepare rename",
        "imports": [],
        "source": "export default function created({ body, teamId, name }) {\n  if (typeof body?.id !== \"string\" || !body.id) throw Error(\"Channel creation returned no ID\");\n  return {\n    channelId: body.id,\n    url: `https://graph.microsoft.com/v1.0/teams/${encodeURIComponent(teamId)}/channels/${encodeURIComponent(body.id)}`,\n    body: { displayName: name },\n  };\n}\n"
      },
      "n_6e223a1e9c139242": {
        "name": "Prepare message",
        "imports": [],
        "source": "export default function prepare({ message }) {\n  return { body: { contentType: \"text\", content: message } };\n}\n"
      }
    }
