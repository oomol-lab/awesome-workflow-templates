        "name": "Prepare the SMS",
        "imports": [],
        "source": "export default function prepare({to,from,message}){return {body:{to,text:message,from:from??''}};}\n"
      },
      "n_03b3dea3e49b274b": {
        "name": "Check the response",
        "imports": [],
        "source": "export default function check({body}){if(!body||typeof body!=='object'||body.success!=='100')throw Error('seven did not accept the complete SMS request; inspect recipient statuses before retrying');return{response:body};}\n"
      }
