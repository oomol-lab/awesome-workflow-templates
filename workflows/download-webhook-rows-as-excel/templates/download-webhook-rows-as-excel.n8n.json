        "operation": "toFile",
        "fileFormat": "xlsx"
      },
      "typeVersion": 1,
      "id": "download-webhook-rows-as-excel-2"
    },
    {
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1020,
        0
      ],
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "content-disposition",
                "value": "=attachment; filename=\"{{$node[\"Webhook\"].json[\"query\"][\"filename\"]? $node[\"Webhook\"].json[\"query\"][\"filename\"] : \"Export\"}}.xlsx\""
              }
            ]
          }
        },
        "respondWith": "binary"
      },
      "typeVersion": 1,
      "id": "download-webhook-rows-as-excel-3"
    },
    {
      "id": "download-webhook-rows-as-excel-choose",
      "name": "Choose delivery mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ...$input.first().json, deliveryMode: \"direct\" } }];\n"
      }
    },
    {
      "id": "download-webhook-rows-as-excel-gate",
      "name": "Relay selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "mode",
              "leftValue": "={{ $json.deliveryMode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "download-webhook-rows-as-excel-relay",
      "name": "Convert with Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        -100
      ],
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://YOUR_OPEN_FLOW_HOST/v1/webhooks/YOUR_ENDPOINT",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { rows: $(\"Webhook\").first().json.body } }}",
        "options": {}
      }
    },
    {
      "id": "download-webhook-rows-as-excel-binary",
      "name": "Decode workbook",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        700,
        -100
      ],
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "base64",
        "options": {
          "fileName": "Export.xlsx",
          "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        }
      }
    }
  ],
