    "modules": {
      "n_4ebaf347edde1202": {
        "name": "Select the feedback answer",
        "imports": [],
        "source": "export default function select({ response, question }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (\n    !Array.isArray(fields) ||\n    !Array.isArray(answers) ||\n    typeof question !== \"string\" ||\n    !question.trim()\n  )\n    throw Error(\"Configure a feedback question\");\n  const matches = fields.filter((f) => f?.title === question);\n  if (matches.length !== 1) throw Error(\"Expected one matching feedback question\");\n  const answer = answers.filter((a) => a?.field?.id === matches[0].id);\n  if (answer.length !== 1 || typeof answer[0].text !== \"string\" || !answer[0].text.trim())\n    throw Error(\"Expected a text answer\");\n  return { text: answer[0].text };\n}\n"
      },
      "n_8975eddd9abc3186": {
        "name": "Analyze feedback sentiment",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nexport default async function detect(\n  { text, region, accessKeyId, secretAccessKey, sessionToken },\n  context,\n) {\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Missing feedback\");\n  if (typeof region !== \"string\" || !/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))\n    throw Error(\"Configure AWS region\");\n  const required = (v, n) => {\n      if (typeof v !== \"string\" || !v.trim()) throw Error(\"Select AWS \" + n + \" secret Variable\");\n      return v.trim();\n    },\n    id = required(accessKeyId, \"access key ID\"),\n    secret = required(secretAccessKey, \"secret access key\");\n  if (sessionToken != null && typeof sessionToken !== \"string\")\n    throw Error(\"Invalid AWS session token\");\n  const token = sessionToken?.trim() ?? \"\",\n    service = \"comprehend\",\n    host = service + \".\" + region + \".amazonaws.com\" + (region.startsWith(\"cn-\") ? \".cn\" : \"\"),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, v) => createHmac(\"sha256\", k).update(v).digest(),\n    body = JSON.stringify({ Text: text, LanguageCode: \"en\" }),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8),\n    headers = {\n      \"content-type\": \"application/x-amz-json-1.1\",\n      host,\n      \"x-amz-date\": timestamp,\n      \"x-amz-target\": \"Comprehend_20171127.DetectSentiment\",\n      ...(token ? { \"x-amz-security-token\": token } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signedHeaders = names.join(\";\"),\n    canonicalHeaders = names\n      .map((n) => n + \":\" + headers[n].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\"),\n    scope = date + \"/\" + region + \"/\" + service + \"/aws4_request\",\n    canonical = [\"POST\", \"/\", \"\", canonicalHeaders, signedHeaders, hash(body)].join(\"\\n\"),\n    toSign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    signingKey = hmac(hmac(hmac(hmac(\"AWS4\" + secret, date), region), service), \"aws4_request\"),\n    signature = createHmac(\"sha256\", signingKey).update(toSign).digest(\"hex\");\n  delete headers.host;\n  headers.authorization =\n    \"AWS4-HMAC-SHA256 Credential=\" +\n    id +\n    \"/\" +\n    scope +\n    \", SignedHeaders=\" +\n    signedHeaders +\n    \", Signature=\" +\n    signature;\n  let response;\n  try {\n    response = await context.fetch(\"https://\" + host + \"/\", { method: \"POST\", headers, body });\n  } catch {\n    throw Error(\"Sentiment request failed\");\n  }\n  if (!response.ok) throw Error(\"Sentiment request failed\");\n  const data = await response.json();\n  if (\n    ![\"POSITIVE\", \"NEGATIVE\", \"NEUTRAL\", \"MIXED\"].includes(data?.Sentiment) ||\n    typeof data?.SentimentScore?.Negative !== \"number\"\n  )\n    throw Error(\"Invalid sentiment response\");\n  return { sentiment: data.Sentiment, negativeScore: data.SentimentScore.Negative };\n}\n"
      },
      "n_833eb18e35a84c31": {
        "name": "Prepare the alert",
        "imports": [],
        "source": "export default function message({ text, sentiment, negativeScore }) {\n  if (\n    typeof text !== \"string\" ||\n    typeof negativeScore !== \"number\" ||\n    !Number.isFinite(negativeScore)\n  )\n    throw Error(\"Invalid feedback\");\n  return {\n    negative: sentiment === \"NEGATIVE\",\n    message:\n      \"You got new feedback with a score of \" + negativeScore + \". Here is what it says:\" + text,\n  };\n}\n"
      }
    }
