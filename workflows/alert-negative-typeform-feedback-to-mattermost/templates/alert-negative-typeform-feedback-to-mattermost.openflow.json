    "modules": {
      "n_4ebaf347edde1202": {
        "name": "Select the feedback answer",
        "imports": [],
        "source": "export default function select({response,question}){const fields=response?.definition?.fields,answers=response?.answers;if(!Array.isArray(fields)||!Array.isArray(answers)||typeof question!=='string'||!question.trim())throw Error('Configure a feedback question');const matches=fields.filter(f=>f?.title===question);if(matches.length!==1)throw Error('Expected one matching feedback question');const answer=answers.filter(a=>a?.field?.id===matches[0].id);if(answer.length!==1||typeof answer[0].text!=='string'||!answer[0].text.trim())throw Error('Expected a text answer');return{text:answer[0].text}}\n"
      },
      "n_8975eddd9abc3186": {
        "name": "Analyze feedback sentiment",
        "imports": [],
        "source": "import{createHash,createHmac}from'node:crypto';export default async function detect({text,region,accessKeyId,secretAccessKey,sessionToken},context){if(typeof text!=='string'||!text.trim())throw Error('Missing feedback');if(typeof region!=='string'||!/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))throw Error('Configure AWS region');const required=(v,n)=>{if(typeof v!=='string'||!v.trim())throw Error('Select AWS '+n+' secret Variable');return v.trim()},id=required(accessKeyId,'access key ID'),secret=required(secretAccessKey,'secret access key');if(sessionToken!=null&&typeof sessionToken!=='string')throw Error('Invalid AWS session token');const token=sessionToken?.trim()??'',service='comprehend',host=service+'.'+region+'.amazonaws.com'+(region.startsWith('cn-')?'.cn':''),hash=x=>createHash('sha256').update(x).digest('hex'),hmac=(k,v)=>createHmac('sha256',k).update(v).digest(),body=JSON.stringify({Text:text,LanguageCode:'en'}),timestamp=new Date().toISOString().replace(/[:-]|\\.\\d{3}/g,''),date=timestamp.slice(0,8),headers={'content-type':'application/x-amz-json-1.1',host,'x-amz-date':timestamp,'x-amz-target':'Comprehend_20171127.DetectSentiment',...(token?{'x-amz-security-token':token}:{})},names=Object.keys(headers).sort(),signedHeaders=names.join(';'),canonicalHeaders=names.map(n=>n+':'+headers[n].trim().replace(/\\s+/g,' ')+'\\n').join(''),scope=date+'/'+region+'/'+service+'/aws4_request',canonical=['POST','/','',canonicalHeaders,signedHeaders,hash(body)].join('\\n'),toSign=['AWS4-HMAC-SHA256',timestamp,scope,hash(canonical)].join('\\n'),signingKey=hmac(hmac(hmac(hmac('AWS4'+secret,date),region),service),'aws4_request'),signature=createHmac('sha256',signingKey).update(toSign).digest('hex');delete headers.host;headers.authorization='AWS4-HMAC-SHA256 Credential='+id+'/'+scope+', SignedHeaders='+signedHeaders+', Signature='+signature;let response;try{response=await context.fetch('https://'+host+'/',{method:'POST',headers,body})}catch{throw Error('Sentiment request failed')};if(!response.ok)throw Error('Sentiment request failed');const data=await response.json();if(!['POSITIVE','NEGATIVE','NEUTRAL','MIXED'].includes(data?.Sentiment)||typeof data?.SentimentScore?.Negative!=='number')throw Error('Invalid sentiment response');return {sentiment:data.Sentiment,negativeScore:data.SentimentScore.Negative}}\n"
      },
      "n_833eb18e35a84c31": {
        "name": "Prepare the alert",
        "imports": [],
        "source": "export default function message({text,sentiment,negativeScore}){if(typeof text!=='string'||typeof negativeScore!=='number'||!Number.isFinite(negativeScore))throw Error('Invalid feedback');return{negative:sentiment==='NEGATIVE',message:'You got new feedback with a score of '+negativeScore+'. Here is what it says:'+text}}\n"
      }
