{
  "nodes": [
    {
      "name": "Typeform Trigger",
      "type": "n8n-nodes-base.typeformTrigger",
      "position": [
        200,
        400
      ],
      "parameters": {
        "formId": "YOUR_TYPEFORM_FORM_ID"
      },
      "typeVersion": 1,
      "id": "alert-negative-typeform-feedback-to-mattermost-0"
    },
    {
      "name": "Select the feedback answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const question='What did you think about the event?'; const text=$json[question]; if(typeof text!=='string'||!text.trim()) throw Error('Expected a text answer'); return {json:{text}};"
      },
      "id": "alert-negative-typeform-feedback-to-mattermost-1"
    },
    {
      "name": "AWS Comprehend",
      "type": "n8n-nodes-base.awsComprehend",
      "position": [
        400,
        400
      ],
      "parameters": {
        "resource": "text",
        "operation": "detectSentiment",
        "languageCode": "en",
        "text": "={{ $json.text }}"
      },
      "typeVersion": 1,
      "id": "alert-negative-typeform-feedback-to-mattermost-2"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        600,
        400
      ],
      "parameters": {
        "conditions": {
          "number": [],
          "string": [
            {
              "value1": "={{$json[\"Sentiment\"]}}",
              "value2": "NEGATIVE"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "alert-negative-typeform-feedback-to-mattermost-3"
    },
    {
      "name": "Mattermost",
      "type": "n8n-nodes-base.mattermost",
      "position": [
        810,
        300
      ],
      "parameters": {
        "message": "=You got new feedback with a score of {{ $json.SentimentScore.Negative }}. Here is what it says:{{ $('Select the feedback answer').first().json.text }}",
        "channelId": "YOUR_MATTERMOST_CHANNEL_ID",
        "attachments": [],
        "otherOptions": {}
      },
      "typeVersion": 1,
      "id": "alert-negative-typeform-feedback-to-mattermost-4"
    }
  ],
  "connections": {
    "Typeform Trigger": {
      "main": [
        [
          {
            "node": "Select the feedback answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select the feedback answer": {
      "main": [
        [
          {
            "node": "AWS Comprehend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AWS Comprehend": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF": {
      "main": [
        [
          {
            "node": "Mattermost",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "name": "Alert Negative Typeform Feedback to Mattermost",
  "active": false,
  "pinData": {}
}
