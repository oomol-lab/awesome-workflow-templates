    {
      "name": "Build safe summary block",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4620,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function format({ answer, post, base }) {\n  let x;\n  try {\n    x = JSON.parse(answer);\n  } catch {\n    throw Error(\"Invalid summary JSON\");\n  }\n  if (\n    !Array.isArray(x.points) ||\n    x.points.length !== 4 ||\n    x.points.some((s) => typeof s !== \"string\" || !s.trim()) ||\n    typeof x.label !== \"string\" ||\n    !x.label.trim()\n  )\n    throw Error(\"Expected four points and translated label\");\n  const esc = (s) =>\n    s.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n  const summary =\n    '<!-- wp:html --><div class=\"wp-block-group has-background\" style=\"background-color:#f8faff; border-radius:4px; padding:10px;\"><p style=\"font-style:normal; font-weight:1000; font-size:1.1em; margin:0 0 10px 0;\"><strong>✨ ' +\n    esc(x.label) +\n    \"</strong> :</p>\" +\n    x.points.map((s) => \"<li>\" + esc(s) + \"</li>\").join(\"\") +\n    '</div><!-- /wp:html --><!-- wp:separator --><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><!-- /wp:separator -->';\n  return {\n    summary,\n    content: summary + \" \" + post.content.raw,\n    excerpt: post.excerpt.rendered,\n    postId: post.id,\n    values: [\n      [\n        String(post.id),\n        summary,\n        post.link || \"\",\n        String(base).replace(/\\/$/, \"\") + \"/wp-admin/post.php?post=\" + post.id + \"&action=edit\",\n        new Date().toISOString(),\n      ],\n    ],\n    notice:\n      \"📄 New WordPress Post Updated with AI Summary: \" +\n      (post.title?.rendered || \"\") +\n      \" \" +\n      (post.link || \"\") +\n      \" (ID \" +\n      post.id +\n      \")\",\n  };\n}\nconst p = $(\"WordPress - Get Post2\").item.json;\nreturn {\n  json: format({ answer: $json.message?.content, post: p, base: \"https://YOUR_WORDPRESS_SITE\" }),\n};\n"
      },
      "id": "add-ai-summaries-to-wordpress-posts-21"
    },
