    "modules": {
      "n_5be4e513fa0cb968": {
        "name": "Confirm execution request",
        "imports": [],
        "source": "function readRundeckExecution(body, statusCode) {\n  if (!Number.isInteger(statusCode) || statusCode < 200 || statusCode >= 300 || !body || typeof body !== 'object' || Array.isArray(body) || body.error === true) {\n    throw new Error('Rundeck did not accept the execution request');\n  }\n  const id = body.id;\n  if (!(typeof id === 'number' && Number.isInteger(id) && id > 0) && !(typeof id === 'string' && /^[0-9]+$/.test(id) && !/^0+$/.test(id))) {\n    throw new Error('Rundeck did not return an execution ID');\n  }\n  return body;\n}\nexport default async function rundeckResult({ body, statusCode }) {\n  return { execution: readRundeckExecution(body, statusCode) };\n}\n"
      }
    }
