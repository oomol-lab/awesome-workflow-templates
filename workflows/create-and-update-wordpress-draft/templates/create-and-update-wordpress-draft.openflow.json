    "modules": {
      "n_fd6417d8abbb0c30": {
        "name": "Prepare the draft content",
        "imports": [],
        "source": "export default function wordpressPostPlan({ post, content }) {\n  if (!post || !Number.isSafeInteger(post.id) || post.id <= 0) throw new Error('WordPress did not return a valid post ID; inspect the site before retrying');\n  if (typeof content !== 'string') throw new Error('Invalid post content');\n  return { postId: post.id, content };\n}\n"
      },
      "n_55daf7c39ffee282": {
        "name": "Confirm the updated post",
        "imports": [],
        "source": "export default function wordpressPostConfirm({ created, updated, postId }) {\n  if (!created || created.id !== postId || !updated || updated.id !== postId) throw new Error('WordPress did not confirm the same post ID; inspect the site before retrying');\n  return { created, updated };\n}\n"
      }
    }
