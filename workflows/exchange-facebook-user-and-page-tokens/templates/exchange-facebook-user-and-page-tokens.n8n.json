{
  "name": "Exchange Facebook User and Page Tokens",
  "tags": [],
  "nodes": [
    {
      "id": "exchange-facebook-user-and-page-tokens-start",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        480,
        280
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "exchange-facebook-user-and-page-tokens-exchange",
      "name": "Get long-lived user token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        280
      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v27.0/oauth/access_token",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "fb_exchange_token"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "exchange-facebook-user-and-page-tokens-pages",
      "name": "Get Page tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        280
      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v27.0/YOUR_APP_SCOPED_USER_ID/accounts",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $json.access_token }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "When clicking ‘Test workflow’": {
      "main": [
        [
          {
            "node": "Get long-lived user token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get long-lived user token": {
      "main": [
        [
          {
            "node": "Get Page tokens",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
