    "modules": {
      "n_e82bdc439a5bb8e9": {
        "name": "Exchange and retrieve tokens",
        "imports": [],
        "source": "export default async function exchange({ appId, appSecret, shortToken, userId }, context) {\n  if (\n    !appId ||\n    !appSecret ||\n    !shortToken ||\n    !userId ||\n    appId.startsWith(\"YOUR_\") ||\n    userId.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure the Facebook app, user, and secret variables\");\n  const exchange = new URL(\"https://graph.facebook.com/v27.0/oauth/access_token\");\n  exchange.searchParams.set(\"grant_type\", \"fb_exchange_token\");\n  exchange.searchParams.set(\"client_id\", appId);\n  exchange.searchParams.set(\"client_secret\", appSecret);\n  exchange.searchParams.set(\"fb_exchange_token\", shortToken);\n  let first;\n  try {\n    first = await context.fetch(exchange.href);\n  } catch {\n    throw Error(\"Token exchange failed or its result is unknown\");\n  }\n  if (!first.ok) throw Error(\"Token exchange was rejected\");\n  const user = await first.json();\n  if (typeof user?.access_token !== \"string\" || !user.access_token)\n    throw Error(\"Token exchange returned no user token\");\n  const accounts = new URL(\n    \"https://graph.facebook.com/v27.0/\" + encodeURIComponent(userId) + \"/accounts\",\n  );\n  accounts.searchParams.set(\"access_token\", user.access_token);\n  let response;\n  try {\n    response = await context.fetch(accounts.href);\n  } catch {\n    throw Error(\"Page token lookup failed\");\n  }\n  if (!response.ok) throw Error(\"Page token lookup was rejected\");\n  const pages = await response.json();\n  if (!Array.isArray(pages?.data)) throw Error(\"Page token lookup returned an invalid response\");\n  return { user, pages };\n}\n"
      }
    }
  },
