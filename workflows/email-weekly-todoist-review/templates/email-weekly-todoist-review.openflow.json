    "modules": {
      "n_328044f67b9aa3d0": {
        "name": "Collect completed tasks",
        "imports": [],
        "source": "export default function collect({ previousState, body, statusCode, bodyEncoding, until }) {\n  let s = previousState;\n  if (!s) {\n    const t = until == null ? Date.now() : Number(until);\n    if (!Number.isFinite(t)) throw Error(\"Invalid review time\");\n    s = {\n      since: new Date(t - 604800000).toISOString(),\n      until: new Date(t).toISOString(),\n      items: [],\n      cursors: [],\n      pages: 0,\n      cursor: null,\n    };\n  } else {\n    if (statusCode < 200 || statusCode >= 300) throw Error(\"Todoist request failed\");\n    let b = body;\n    if (typeof b === \"string\") {\n      try {\n        b = JSON.parse(b);\n      } catch {\n        throw Error(\"Invalid Todoist response\");\n      }\n    }\n    if (\n      !b ||\n      !Array.isArray(b.items) ||\n      !(b.next_cursor === null || typeof b.next_cursor === \"string\")\n    )\n      throw Error(\"Invalid Todoist page\");\n    if (b.next_cursor !== null && (!b.next_cursor || s.cursors.includes(b.next_cursor)))\n      throw Error(\"Invalid or repeated cursor\");\n    s = {\n      ...s,\n      items: [...s.items, ...b.items],\n      pages: s.pages + 1,\n      cursor: b.next_cursor,\n      cursors: b.next_cursor ? [...s.cursors, b.next_cursor] : s.cursors,\n    };\n    if (s.pages >= 100 && s.cursor) throw Error(\"Too many Todoist pages\");\n  }\n  const more = s.pages === 0 || s.cursor !== null;\n  return {\n    state: s,\n    more,\n    query: {\n      since: s.since,\n      until: s.until,\n      limit: 100,\n      ...(s.cursor ? { cursor: s.cursor } : {}),\n    },\n    items: s.items,\n  };\n}\n"
      },
      "n_c0c8f399a3e217f2": {
        "name": "Prepare the email",
        "imports": [],
        "source": "export default function summarize({ items, ignoredProjects }) {\n  if (\n    !Array.isArray(items) ||\n    !Array.isArray(ignoredProjects) ||\n    ignoredProjects.some((x) => typeof x !== \"string\")\n  )\n    throw Error(\"Invalid review configuration\");\n  const groups = {};\n  for (const item of items) {\n    if (\n      typeof item.project_id !== \"string\" ||\n      typeof item.content !== \"string\" ||\n      typeof item.completed_at !== \"string\" ||\n      !Number.isFinite(Date.parse(item.completed_at))\n    )\n      throw Error(\"Invalid completed task\");\n    if (ignoredProjects.includes(item.project_id)) continue;\n    const date = new Date(item.completed_at).toISOString().slice(0, 10);\n    (groups[date] ??= []).push(item.content);\n  }\n  const esc = (s) =>\n    s\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  let html = \"<h1>Completed Items</h1>\";\n  for (const [date, contents] of Object.entries(groups))\n    html += `<h2>${date}</h2><ul>` + contents.map((x) => `<li>${esc(x)}</li>`).join(\"\") + \"</ul>\";\n  return { html, hasItems: Object.keys(groups).length > 0 };\n}\n"
      }
    }
