    "modules": {
      "n_328044f67b9aa3d0": {
        "name": "Collect completed tasks",
        "imports": [],
        "source": "export default function collect({previousState,body,statusCode,bodyEncoding,until}) {\n let s=previousState;\n if(!s){const t=until==null?Date.now():Number(until);if(!Number.isFinite(t))throw Error('Invalid review time');s={since:new Date(t-604800000).toISOString(),until:new Date(t).toISOString(),items:[],cursors:[],pages:0,cursor:null};}\n else {if(statusCode<200||statusCode>=300)throw Error('Todoist request failed');let b=body;if(typeof b==='string'){try{b=JSON.parse(b)}catch{throw Error('Invalid Todoist response')}}if(!b||!Array.isArray(b.items)||!(b.next_cursor===null||typeof b.next_cursor==='string'))throw Error('Invalid Todoist page');if(b.next_cursor!==null&&(!b.next_cursor||s.cursors.includes(b.next_cursor)))throw Error('Invalid or repeated cursor');s={...s,items:[...s.items,...b.items],pages:s.pages+1,cursor:b.next_cursor,cursors:b.next_cursor?[...s.cursors,b.next_cursor]:s.cursors};if(s.pages>=100&&s.cursor)throw Error('Too many Todoist pages');}\n const more=s.pages===0||s.cursor!==null;return {state:s,more,query:{since:s.since,until:s.until,limit:100,...(s.cursor?{cursor:s.cursor}:{})},items:s.items};\n}\n"
      },
      "n_c0c8f399a3e217f2": {
        "name": "Prepare the email",
        "imports": [],
        "source": "export default function summarize({items,ignoredProjects}) {if(!Array.isArray(items)||!Array.isArray(ignoredProjects)||ignoredProjects.some(x=>typeof x!=='string'))throw Error('Invalid review configuration');const groups={};for(const item of items){if(typeof item.project_id!=='string'||typeof item.content!=='string'||typeof item.completed_at!=='string'||!Number.isFinite(Date.parse(item.completed_at)))throw Error('Invalid completed task');if(ignoredProjects.includes(item.project_id))continue;const date=new Date(item.completed_at).toISOString().slice(0,10);(groups[date]??=[]).push(item.content)}const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');let html='<h1>Completed Items</h1>';for(const [date,contents] of Object.entries(groups))html+=`<h2>${date}</h2><ul>`+contents.map(x=>`<li>${esc(x)}</li>`).join('')+'</ul>';return {html,hasItems:Object.keys(groups).length>0};}\n"
      }
    }
