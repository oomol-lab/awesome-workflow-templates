    "modules": {
      "n_ea5a97d99225a352": {
        "name": "Prepare user page",
        "imports": [],
        "source": "export default function ({ baseUrl, cursor }) {\n  if (typeof baseUrl !== \"string\" || !/^https:\\/\\//.test(baseUrl))\n    throw Error(\"Configure HTTPS n8n base URL\");\n  const target = baseUrl.replace(/\\/$/, \"\") + \"/api/v1/users\";\n  return {\n    target,\n    url: target + \"?limit=100\" + (cursor ? \"&cursor=\" + encodeURIComponent(cursor) : \"\"),\n  };\n}\n"
      },
      "n_85f60a778d9e6b7b": {
        "name": "Collect users",
        "imports": [],
        "source": "export default function ({ body, previous }) {\n  if (!Array.isArray(body?.data)) throw Error(\"Invalid user page\");\n  const seen = previous?.seen ?? [],\n    cursor = body.nextCursor ?? \"\";\n  if (cursor && (typeof cursor !== \"string\" || seen.includes(cursor)))\n    throw Error(\"Invalid user cursor\");\n  return {\n    state: {\n      users: [...(previous?.users ?? []), ...body.data],\n      seen: cursor ? [...seen, cursor] : seen,\n    },\n    cursor,\n    more: !!cursor,\n  };\n}\n"
      },
      "n_76c5acc6ff67fc84": {
        "name": "Select next invitation",
        "imports": [],
        "source": "export default async function ({ rows, users, previous, previousResult, acknowledgeEmail }, ctx) {\n  const saved = (await ctx.state.get(\"invite-checkpoint\")) ?? { pending: null, done: [] };\n  if (saved.pending) {\n    if (acknowledgeEmail !== saved.pending)\n      throw Error(\"Inspect invitation before acknowledging \" + saved.pending);\n    saved.done.push(saved.pending);\n    saved.pending = null;\n    await ctx.state.set(\"invite-checkpoint\", saved);\n  }\n  if (!Array.isArray(rows) || !Array.isArray(users?.users)) throw Error(\"Missing list\");\n  const present = new Set([\n    ...users.users.map((u) => String(u.email ?? \"\").toLowerCase()),\n    ...saved.done,\n  ]);\n  const emails = [\n    ...new Set(\n      rows\n        .slice(1)\n        .map((r) =>\n          String(r[0] ?? \"\")\n            .trim()\n            .toLowerCase(),\n        )\n        .filter(Boolean),\n    ),\n  ];\n  if (emails.some((x) => !/^\\S+@\\S+\\.\\S+$/.test(x))) throw Error(\"Invalid email\");\n  const results = [...(previous?.results ?? [])];\n  if (previousResult) results.push(previousResult);\n  let i = previous?.index ?? 0;\n  while (i < emails.length && present.has(emails[i])) i++;\n  return {\n    state: { index: i + 1, results },\n    more: i < emails.length,\n    email: emails[i] ?? \"\",\n    results,\n  };\n}\n"
      },
      "n_333f543be8e3f951": {
        "name": "Mark invitation pending",
        "imports": [],
        "source": "export default async function ({ email }, ctx) {\n  const s = (await ctx.state.get(\"invite-checkpoint\")) ?? { pending: null, done: [] };\n  if (s.pending) throw Error(\"Existing pending invitation\");\n  s.pending = email;\n  await ctx.state.set(\"invite-checkpoint\", s);\n  return { email };\n}\n"
      },
      "n_aa94bf953e15b812": {
        "name": "Prepare invitation",
        "imports": [],
        "source": "export default function ({ email }) {\n  return { body: [{ email, role: \"global:member\" }] };\n}\n"
      },
      "n_2dbd70c224f137dc": {
        "name": "Confirm invitation",
        "imports": [],
        "source": "export default async function ({ body, email }, ctx) {\n  if (\n    !Array.isArray(body) ||\n    body.length !== 1 ||\n    body[0]?.error ||\n    body[0]?.user?.email?.toLowerCase() !== email ||\n    !body[0]?.user?.id\n  )\n    throw Error(\"Invitation not confirmed; inspect n8n\");\n  const s = await ctx.state.get(\"invite-checkpoint\");\n  if (s?.pending !== email) throw Error(\"Checkpoint mismatch\");\n  s.pending = null;\n  s.done.push(email);\n  await ctx.state.set(\"invite-checkpoint\", s);\n  return { result: body[0] };\n}\n"
      }
    }
  },
