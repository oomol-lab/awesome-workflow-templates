    "modules": {
      "n_45adf9c3b5413a82": {
        "name": "Prepare tools and attributes",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default function ({ event, baseId, attributesTable, toolsTable }) {\n  const parsed = JSON.parse(event);\n  if (!Array.isArray(parsed.tools)) throw Error(\"Expected tools array\");\n  const hash = (x) => createHash(\"md5\").update(x.trim().toLowerCase()).digest(\"hex\"),\n    attrs = [],\n    names = new Map(),\n    tools = [];\n  for (const t of parsed.tools) {\n    if (\n      !t ||\n      typeof t.name !== \"string\" ||\n      !t.name.trim() ||\n      !Array.isArray(t.attributes) ||\n      !Array.isArray(t.similar)\n    )\n      throw Error(\"Invalid extracted tool\");\n    const name = t.name.trim();\n    for (const a of t.attributes) {\n      if (typeof a !== \"string\" || !a.trim()) throw Error(\"Invalid attribute\");\n      if (!attrs.includes(a.trim())) attrs.push(a.trim());\n    }\n    for (const name2 of [name, ...t.similar]) {\n      if (typeof name2 !== \"string\" || !name2.trim()) throw Error(\"Invalid similar tool\");\n      const key = hash(name2);\n      if (!names.has(key)) names.set(key, name2.trim());\n    }\n    tools.push({\n      name,\n      hash: hash(name),\n      attributes: t.attributes.map((x) => x.trim()),\n      similar: t.similar.map((x) => hash(x)),\n    });\n  }\n  if (!baseId || !attributesTable || !toolsTable) throw Error(\"Configure Airtable base and tables\");\n  return {\n    initial: {\n      baseId,\n      attributesTable,\n      toolsTable,\n      attrs,\n      names: [...names].map(([hash, name]) => ({ hash, name })),\n      tools,\n    },\n  };\n}\n"
      },
      "n_52d40b1974472d64": {
        "name": "Prepare next Airtable batch",
        "imports": [],
        "source": "export default function ({ initial, previous, response }) {\n  let s = previous\n    ? structuredClone(previous)\n    : { ...initial, phase: \"attrs\", index: 0, attrIds: {}, toolIds: {}, toolFields: {} };\n  if (previous) {\n    if (\n      !response ||\n      !Array.isArray(response.records) ||\n      response.records.length !== s.pending.length\n    )\n      throw Error(\"Airtable returned incomplete batch\");\n    for (const r of response.records) {\n      if (!r.id || !r.fields) throw Error(\"Airtable record missing ID or fields\");\n      if (s.phase === \"attrs\") {\n        const name = r.fields.Name;\n        if (!s.pending.includes(name)) throw Error(\"Unexpected attribute\");\n        s.attrIds[name] = r.id;\n      } else if (s.phase === \"names\") {\n        const hash = r.fields.Hash;\n        if (!s.pending.includes(hash)) throw Error(\"Unexpected tool\");\n        s.toolIds[hash] = r.id;\n        s.toolFields[hash] = r.fields;\n      }\n    }\n    s.index += s.pending.length;\n    s.pending = [];\n  }\n  for (;;) {\n    if (s.phase === \"attrs\" && s.index >= s.attrs.length) {\n      s.phase = \"names\";\n      s.index = 0;\n      continue;\n    }\n    if (s.phase === \"names\" && s.index >= s.names.length) {\n      s.phase = \"links\";\n      s.index = 0;\n      continue;\n    }\n    if (s.phase === \"links\" && s.index >= s.tools.length)\n      return {\n        state: s,\n        more: false,\n        url: \"https://api.airtable.com/v0/unused/unused\",\n        body: {},\n        count: s.tools.length,\n      };\n    break;\n  }\n  let records, merge, table;\n  if (s.phase === \"attrs\") {\n    let chunk = s.attrs.slice(s.index, s.index + 10);\n    s.pending = chunk;\n    records = chunk.map((Name) => ({ fields: { Name } }));\n    merge = \"Name\";\n    table = s.attributesTable;\n  } else if (s.phase === \"names\") {\n    let chunk = s.names.slice(s.index, s.index + 10);\n    s.pending = chunk.map((x) => x.hash);\n    records = chunk.map((x) => ({ fields: { Name: x.name, Hash: x.hash } }));\n    merge = \"Hash\";\n    table = s.toolsTable;\n  } else {\n    let chunk = s.tools.slice(s.index, s.index + 10);\n    s.pending = chunk.map((x) => x.hash);\n    records = chunk.map((t) => {\n      const fields = s.toolFields[t.hash] || {},\n        id = s.toolIds[t.hash];\n      if (!id) throw Error(\"Missing tool ID\");\n      const attributes = t.attributes.map((x) => {\n          if (!s.attrIds[x]) throw Error(\"Missing attribute ID\");\n          return s.attrIds[x];\n        }),\n        similar = t.similar.map((x) => {\n          if (!s.toolIds[x]) throw Error(\"Missing similar ID\");\n          return s.toolIds[x];\n        });\n      return {\n        id,\n        fields: {\n          Attributes: [...new Set([...(fields.Attributes || []), ...attributes])],\n          Similar: [...new Set([...(fields.Similar || []), ...similar])],\n        },\n      };\n    });\n    table = s.toolsTable;\n  }\n  return {\n    state: s,\n    more: true,\n    url: `https://api.airtable.com/v0/${encodeURIComponent(s.baseId)}/${encodeURIComponent(table)}`,\n    body: { ...(merge ? { performUpsert: { fieldsToMergeOn: [merge] } } : {}), records },\n    count: 0,\n  };\n}\n"
      }
