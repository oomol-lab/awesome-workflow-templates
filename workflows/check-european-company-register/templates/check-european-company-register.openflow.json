    "modules": {
      "n_9dd7f0db130a8194": {
        "name": "Prepare the register query",
        "imports": [],
        "source": "export default function input({body}){const query=body.data?.['Company name or registration number'],country=body.data?.Country;if(typeof query!=='string'||!query.trim()||!['cz','ee','fi','fr','no','pl','sk'].includes(country))throw Error('A company query and supported country are required');return{input:{queries:[query.trim()],countries:[country],maxResultsPerQuery:5,onlyActive:false}};}\n"
      },
      "n_8128fa871028a8ea": {
        "name": "Check lookup status",
        "imports": [],
        "source": "export default function run({initial,current,previous}){const x=current??initial;if(!x||typeof x.id!=='string'||!x.id||typeof x.status!=='string')throw Error('Invalid Apify run');if(previous?.id&&previous.id!==x.id)throw Error('Apify run changed');if(['FAILED','ABORTED','TIMED-OUT'].includes(x.status))throw Error('Registry run failed: '+x.status);const done=x.status==='SUCCEEDED';if(done&&(!x.defaultDatasetId||!x.defaultKeyValueStoreId))throw Error('Registry run is missing its dataset or summary store');const count=(previous?.count??0)+1;if(!done&&count>90)throw Error('Registry run did not complete in time');return{state:{id:x.id,count},done,runId:x.id,datasetId:x.defaultDatasetId??'pending',storeId:x.defaultKeyValueStoreId??'pending'};}\n"
      },
      "n_f3db9182507bec87": {
        "name": "Locate the lookup summary",
        "imports": [],
        "source": "export default function summary({storeId}){if(typeof storeId!=='string'||!/^[a-zA-Z0-9_-]+$/.test(storeId))throw Error('Invalid Apify summary store');return{endpoint:'/v2/key-value-stores/'+encodeURIComponent(storeId)+'/records/SUMMARY'};}\n"
      },
      "n_3cb084eac6509496": {
        "name": "Classify the company records",
        "imports": [],
        "source": "export default function result({items,summary,status}){if(status!==200||!summary||typeof summary!=='object'||Array.isArray(summary))throw Error('Registry run summary is unavailable');if(!Array.isArray(items)||items.length>5)throw Error('Invalid registry result count');const records=items.map(x=>{if(!x||typeof x.name!=='string'||typeof x.status!=='string')throw Error('Invalid company record');if(x.status.toLowerCase()==='active')return{verdict:'ok',company:x.name,registrationNumber:x.registrationNumber??null,country:x.countryName??null,legalForm:x.legalFormCode??null,address:x.address??null,vatNumber:x.vatNumber??null,registryUrl:x.registryUrl??null,registryUpdatedAt:x.registryUpdatedAt??null};return{verdict:'check by hand',company:x.name,status:x.status,statusRaw:x.statusRaw??null,dissolvedAt:x.dissolvedAt??null,registryUrl:x.registryUrl??null};});return{records,summary};}\n"
      }
    }
