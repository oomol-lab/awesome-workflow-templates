    "modules": {
      "n_9dd7f0db130a8194": {
        "name": "Prepare the register query",
        "imports": [],
        "source": "export default function input({ body }) {\n  const query = body.data?.[\"Company name or registration number\"],\n    country = body.data?.Country;\n  if (\n    typeof query !== \"string\" ||\n    !query.trim() ||\n    ![\"cz\", \"ee\", \"fi\", \"fr\", \"no\", \"pl\", \"sk\"].includes(country)\n  )\n    throw Error(\"A company query and supported country are required\");\n  return {\n    input: {\n      queries: [query.trim()],\n      countries: [country],\n      maxResultsPerQuery: 5,\n      onlyActive: false,\n    },\n  };\n}\n"
      },
      "n_8128fa871028a8ea": {
        "name": "Check lookup status",
        "imports": [],
        "source": "export default function run({ initial, current, previous }) {\n  const x = current ?? initial;\n  if (!x || typeof x.id !== \"string\" || !x.id || typeof x.status !== \"string\")\n    throw Error(\"Invalid Apify run\");\n  if (previous?.id && previous.id !== x.id) throw Error(\"Apify run changed\");\n  if ([\"FAILED\", \"ABORTED\", \"TIMED-OUT\"].includes(x.status))\n    throw Error(\"Registry run failed: \" + x.status);\n  const done = x.status === \"SUCCEEDED\";\n  if (done && (!x.defaultDatasetId || !x.defaultKeyValueStoreId))\n    throw Error(\"Registry run is missing its dataset or summary store\");\n  const count = (previous?.count ?? 0) + 1;\n  if (!done && count > 90) throw Error(\"Registry run did not complete in time\");\n  return {\n    state: { id: x.id, count },\n    done,\n    runId: x.id,\n    datasetId: x.defaultDatasetId ?? \"pending\",\n    storeId: x.defaultKeyValueStoreId ?? \"pending\",\n  };\n}\n"
      },
      "n_f3db9182507bec87": {
        "name": "Locate the lookup summary",
        "imports": [],
        "source": "export default function summary({ storeId }) {\n  if (typeof storeId !== \"string\" || !/^[a-zA-Z0-9_-]+$/.test(storeId))\n    throw Error(\"Invalid Apify summary store\");\n  return { endpoint: \"/v2/key-value-stores/\" + encodeURIComponent(storeId) + \"/records/SUMMARY\" };\n}\n"
      },
      "n_3cb084eac6509496": {
        "name": "Classify the company records",
        "imports": [],
        "source": "export default function result({ items, summary, status }) {\n  if (status !== 200 || !summary || typeof summary !== \"object\" || Array.isArray(summary))\n    throw Error(\"Registry run summary is unavailable\");\n  if (!Array.isArray(items) || items.length > 5) throw Error(\"Invalid registry result count\");\n  const records = items.map((x) => {\n    if (!x || typeof x.name !== \"string\" || typeof x.status !== \"string\")\n      throw Error(\"Invalid company record\");\n    if (x.status.toLowerCase() === \"active\")\n      return {\n        verdict: \"ok\",\n        company: x.name,\n        registrationNumber: x.registrationNumber ?? null,\n        country: x.countryName ?? null,\n        legalForm: x.legalFormCode ?? null,\n        address: x.address ?? null,\n        vatNumber: x.vatNumber ?? null,\n        registryUrl: x.registryUrl ?? null,\n        registryUpdatedAt: x.registryUpdatedAt ?? null,\n      };\n    return {\n      verdict: \"check by hand\",\n      company: x.name,\n      status: x.status,\n      statusRaw: x.statusRaw ?? null,\n      dissolvedAt: x.dissolvedAt ?? null,\n      registryUrl: x.registryUrl ?? null,\n    };\n  });\n  return { records, summary };\n}\n"
      }
    }
  },
