    "modules": {
      "n_e28b3360978759d4": {
        "name": "Prepare email lookup",
        "imports": [],
        "source": "export default function prepare({email}) { if(typeof email!=='string'||!email)throw Error('Enter an email address');return{body:{processor:'check-email-exists',params:{email}}}; }\n"
      },
      "n_480eed487752e0af": {
        "name": "Check deliverability",
        "imports": [],
        "source": "export default function results({body}){const rows=Array.isArray(body)?body:[body];return{results:rows.map(response=>({response,deliverable:response?.message?.response==='deliverable'}))}}\n"
      }
    }
