        "name": "Prepare the notification",
        "imports": [],
        "source": "export default function notice({event,metadataId,recordId}){if(!event||!metadataId||!recordId)throw Error('Missing event details');const esc=x=>x.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');return {subject:'Record Deleted in TwentyCRM',body:`Object metadata ID: ${metadataId}\\nRecord ID: ${recordId}`,text:`event: ${esc(event)}\\nevent_id: ${esc(metadataId)}\\nrecord_id: ${esc(recordId)}`}}\n"
