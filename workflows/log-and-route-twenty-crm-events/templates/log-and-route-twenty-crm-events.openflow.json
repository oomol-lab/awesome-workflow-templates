        "name": "Verify and read the event",
        "imports": [],
        "source": "import {createHmac} from 'node:crypto';\nexport default function verify({body,headers,secret}){if(!body||typeof body!=='object'||Array.isArray(body)||!headers||typeof headers!=='object'||typeof secret!=='string'||!secret)throw Error('Configure Twenty webhook secret');const h=Object.fromEntries(Object.entries(headers).map(([k,v])=>[k.toLowerCase(),v])),timestamp=h['x-twenty-webhook-timestamp'],signature=h['x-twenty-webhook-signature'];if(typeof timestamp!=='string'||!/^\\d{13}$/.test(timestamp)||Math.abs(Date.now()-Number(timestamp))>900000||typeof signature!=='string'||!/^[0-9a-f]{64}$/.test(signature))throw Error('Invalid Twenty webhook signature or timestamp');const expected=createHmac('sha256',secret).update(timestamp+':'+JSON.stringify(body)).digest('hex');let diff=0;for(let i=0;i<64;i++)diff|=expected.charCodeAt(i)^signature.charCodeAt(i);if(diff)throw Error('Invalid Twenty webhook signature');const event=body.eventName,meta=body.objectMetadata,record=body.record;if(typeof event!=='string'||!/^.+\\.[^.]+$/.test(event)||!meta||typeof meta.id!=='string'||!meta.id||!record||typeof record.id!=='string'||!record.id)throw Error('Invalid Twenty record event');const type=typeof meta.nameSingular==='string'?meta.nameSingular:'',typename=typeof record.__typename==='string'?record.__typename:'';return {deleted:['delete','deleted'].includes(event.split('.')[1]),event,metadataId:meta.id,recordId:record.id,values:[[event,meta.id,type,record.id,typename]]}}\n"
      },
