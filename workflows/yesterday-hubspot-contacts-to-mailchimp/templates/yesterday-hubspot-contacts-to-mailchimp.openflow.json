    "modules": {
      "n_71ee43198c37766e": {
        "name": "Calculate yesterday in UTC",
        "imports": [],
        "source": "export default function yesterdayWindow() {\n  const now = new Date(),\n    today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());\n  return {\n    filterGroups: [\n      {\n        filters: [\n          { propertyName: \"createdate\", operator: \"GTE\", value: String(today - 86400000) },\n          { propertyName: \"createdate\", operator: \"LT\", value: String(today) },\n        ],\n      },\n    ],\n  };\n}\n"
      },
      "n_e3cc71fd054cffc7": {
        "name": "Prepare the next contact",
        "imports": [],
        "source": "export default function nextContact({ results, previousState, listId }) {\n  if (typeof listId !== \"string\" || !listId.trim() || listId === \"YOUR_MAILCHIMP_AUDIENCE_ID\")\n    throw new Error(\"Configure the Mailchimp audience ID\");\n  const index = previousState?.index ?? 0;\n  if (\n    !Array.isArray(results) ||\n    results.length > 100 ||\n    !Number.isInteger(index) ||\n    index < 0 ||\n    index > results.length\n  )\n    throw new Error(\"Invalid HubSpot result state\");\n  if (index === 0)\n    for (const r of results) {\n      const p = r?.properties;\n      if (\n        typeof p?.email !== \"string\" ||\n        !p.email.trim() ||\n        typeof p.firstname !== \"string\" ||\n        typeof p.lastname !== \"string\"\n      )\n        throw new Error(\"Each HubSpot contact needs email, first name and last name text\");\n    }\n  if (index === results.length)\n    return { state: { index }, more: false, endpoint: \"/unused\", body: {}, count: index };\n  const p = results[index].properties;\n  return {\n    state: { index: index + 1 },\n    more: true,\n    endpoint: \"/lists/\" + encodeURIComponent(listId) + \"/members\",\n    body: {\n      email_address: p.email,\n      status: \"subscribed\",\n      merge_fields: { FNAME: p.firstname, LNAME: p.lastname },\n    },\n    count: index + 1,\n  };\n}\n"
      },
      "n_d671842b1a2fa255": {
        "name": "Check the member response",
        "imports": [],
        "source": "export default function memberResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding)\n    throw new Error(\"Mailchimp did not return a completed member result (HTTP \" + statusCode + \")\");\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    typeof body.id !== \"string\" ||\n    !body.id ||\n    typeof body.email_address !== \"string\" ||\n    typeof body.status !== \"string\"\n  )\n    throw new Error(\"Mailchimp returned an unexpected member response\");\n  return { member: body };\n}\n"
      }
    }
