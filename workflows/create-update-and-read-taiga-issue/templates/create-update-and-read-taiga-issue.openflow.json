    "modules": {
      "n_be62e33eb47244e5": {
        "name": "Configure the issue",
        "imports": [],
        "source": "export default function configure({ project, subject }) {if(!Number.isSafeInteger(project)||project<=0)throw Error('Enter your Taiga project ID');if(typeof subject!=='string'||!subject.trim())throw Error('Enter a subject');return{project,subject}}\n"
      },
      "n_100ede5a6d297961": {
        "name": "Create the issue",
        "imports": [],
        "source": "export default async function createIssue({project,subject},context){return await context.actions.call('taiga.create_issue',{project,subject});}\n"
      },
      "n_174e63f9b06858e9": {
        "name": "Use the created issue ID",
        "imports": [],
        "source": "export default function createdId({ issue }) {if(!Number.isSafeInteger(issue.id)||issue.id<=0)throw Error('Missing issue ID');return{id:issue.id}}\n"
      },
      "n_4cb1058118f05aa9": {
        "name": "Prepare the description update",
        "imports": [],
        "source": "export default function issueId({issue,expectedId,description}){if(issue.id!==expectedId||!Number.isSafeInteger(issue.version))throw Error('Unexpected issue ID or version');return{id:expectedId,version:issue.version,description}}\n"
      },
      "n_8fbc8f246fec4c89": {
        "name": "Update the description",
        "imports": [],
        "source": "export default async function updateIssue({issueId,version,description},context){return await context.actions.call('taiga.update_issue',{issueId,version,description});}\n"
      },
      "n_1b2beff668fd0a8b": {
        "name": "Confirm the issue update",
        "imports": [],
        "source": "export default function confirm({issue,expectedId}){if(issue.id!==expectedId)throw Error('Unexpected issue ID');return{id:expectedId}}\n"
      }
    }
