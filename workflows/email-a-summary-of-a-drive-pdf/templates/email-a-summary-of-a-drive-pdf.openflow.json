      "n_908587a21b2f4bff": {
        "name": "Read the PDF bytes",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function stage({ file, fileId }, context) {\n  if (\n    !file ||\n    file.fileId !== fileId ||\n    file.mimeType !== \"application/pdf\" ||\n    typeof file.name !== \"string\" ||\n    !file.name.toLowerCase().endsWith(\".pdf\") ||\n    !Number.isInteger(file.sizeBytes) ||\n    file.sizeBytes <= 0 ||\n    file.sizeBytes > 700000 ||\n    typeof file.transitUrl !== \"string\" ||\n    !/^https:\\/\\//.test(file.transitUrl)\n  )\n    throw Error(\"Invalid PDF metadata or file size\");\n  const r = await context.fetch(file.transitUrl, { method: \"GET\" });\n  if (!r.ok) throw Error(\"PDF transit download failed\");\n  const b = Buffer.from(await r.arrayBuffer());\n  if (b.length !== file.sizeBytes || b.subarray(0, 5).toString() !== \"%PDF-\")\n    throw Error(\"Invalid or incomplete PDF\");\n  return { fileName: file.name, fileContent: b.toString(\"base64\") };\n}\n"
      },
      "n_d2dfe579e44e6f6f": {
        "name": "Check the extracted text",
        "imports": [],
        "source": "export default function check({ textLayer, errors, operationStatus }) {\n  if (\n    !Array.isArray(errors) ||\n    errors.length ||\n    typeof textLayer !== \"string\" ||\n    !textLayer.trim() ||\n    (operationStatus != null && operationStatus !== \"Completed\")\n  )\n    throw Error(\"PDF text extraction failed or returned no text\");\n  return { text: textLayer };\n}\n"
      },
      "n_7f614f4747aee0c7": {
        "name": "Prepare the email",
        "imports": [],
        "source": "export default function mail({ summary }) {\n  if (typeof summary !== \"string\" || !summary.trim()) throw Error(\"Summary is empty\");\n  const date = new Date().toLocaleString(\"en-GB\", { timeZone: \"Africa/Lagos\" });\n  return {\n    body:\n      \"Quick summary of your document\\n\\n\" + summary + \"\\n\\nDate processed (Africa/Lagos): \" + date,\n  };\n}\n"
      }
    }
  },
