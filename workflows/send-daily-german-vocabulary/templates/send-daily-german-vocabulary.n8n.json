          }
        ],
        [
          {
            "node": "Save vocabulary to Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save vocabulary to Airtable": {
      "main": [
        [
          {
            "node": "Confirm saved record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm saved record": {
      "main": [
        [
          {
            "node": "Save one word at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare five words for SMS": {
      "main": [
        [
          {
            "node": "Send the vocabulary SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send the vocabulary SMS": {
      "main": [
