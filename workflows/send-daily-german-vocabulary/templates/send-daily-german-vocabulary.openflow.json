    "modules": {
      "n_3e717e0b6c623ba2": {
        "name": "Configure the destinations",
        "imports": [],
        "source": "export default function config({baseId,table,from,to}){for(const [k,v]of Object.entries({baseId,table,from,to}))if(typeof v!=='string'||!v.trim()||v.startsWith('YOUR_'))throw Error('Configure '+k);if(!/^[0-9]{7,15}$/.test(to))throw Error('Set destination as international digits without +');return{baseId,table,from,to}}\n"
      },
      "n_12eea03a105fcbf7": {
        "name": "Extract unique title words",
        "imports": [],
        "source": "export default async function words({ids},context){if(!Array.isArray(ids)||ids.length<3)throw Error('Fewer than three top stories');let words=[];for(const id of ids.slice(0,3)){if(!Number.isSafeInteger(id)||id<=0)throw Error('Invalid story ID');const r=await context.actions.call('hackernews.get_item',{id});if(!r||r.id!==id||typeof r.title!=='string'||!r.title.trim())throw Error('Invalid story');for(const w of r.title.split(' '))if(w&&!/\\d/.test(w)&&!words.includes(w))words.push(w)}if(words.length<5)throw Error('Fewer than five words');return{words}}\n"
      },
      "n_fb73890b694dcf7c": {
        "name": "Translate each word",
        "imports": [],
        "source": "export default async function translate({words,previous},context){if(!Array.isArray(words)||words.length<5)throw Error('Invalid words');const s=previous??{index:0,items:[]};if(s.index>=words.length)return{state:s,more:false};const word=words[s.index],r=await context.actions.call('lingvanex_translation_api.translate_text',{q:word,target:'de',format:'text'});if(!Array.isArray(r?.translations)||r.translations.length!==1||typeof r.translations[0].translatedText!=='string'||!r.translations[0].translatedText.trim())throw Error('Translation missing');const n={index:s.index+1,items:s.items.concat({english:word,german:r.translations[0].translatedText})};return{state:n,more:n.index<words.length}}\n"
      },
      "n_f08d636af4746f73": {
        "name": "Prepare Airtable records",
        "imports": [],
        "source": "export default function next({state,previous}){const i=previous?.index??0;if(!Array.isArray(state.items)||state.items.length<5)throw Error('Invalid translations');const batch=state.items.slice(i,i+10);return{state:{index:i+batch.length},more:batch.length>0,records:batch.length?batch.map(x=>({fields:{'English word':x.english,'Translated word':x.german}})):[{fields:{'English word':'-','Translated word':'-'}}],expected:batch.length}}\n"
      },
      "n_67a0896af392c136": {
        "name": "Confirm saved records",
        "imports": [],
        "source": "export default function confirm({records,expected}){if(!Array.isArray(records)||records.length!==expected||records.some(x=>typeof x.id!=='string'||!x.id))throw Error('Airtable create was not confirmed');return{confirmed:records.length}}\n"
      },
      "n_6a50dc8aae4f9a7c": {
        "name": "Prepare five words for SMS",
        "imports": [],
        "source": "export default function message({state,from,to}){if(!Array.isArray(state.items)||state.items.length<5)throw Error('Not enough words');return{from,to,text:'Good morning, here are your words for today\\n'+state.items.slice(0,5).map(x=>x.english+' : '+x.german).join(', ')}}\n"
      },
      "n_2969264aae6588bc": {
        "name": "Confirm SMS submission",
        "imports": [],
        "source": "export default function confirm({messageCount,messages}){if(messageCount<1||!Array.isArray(messages)||messages.length!==messageCount||messages.some(x=>x.status!=='0'||!x.messageId))throw Error('SMS submission not confirmed');return{accepted:messageCount}}\n"
      }
    }
