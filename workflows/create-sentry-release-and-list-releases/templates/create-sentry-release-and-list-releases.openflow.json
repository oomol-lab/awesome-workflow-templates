    "modules": {
      "n_b5aed3834a5a359d": {
        "name": "Configure the release",
        "imports": [],
        "source": "export default function sentryReleasePlan({ organization, project, version, releaseUrl }) {\n  for (const [name, value] of Object.entries({ organization, project, version, releaseUrl }))\n    if (typeof value !== \"string\" || !value.trim() || value.startsWith(\"YOUR_\"))\n      throw new Error(\"Set \" + name);\n  if (!/^https:\\/\\//i.test(releaseUrl)) throw new Error(\"Set a public HTTPS release URL\");\n  return {\n    endpoint: \"/organizations/\" + encodeURIComponent(organization) + \"/releases/\",\n    body: { version, projects: [project], url: releaseUrl },\n    organization,\n    version,\n  };\n}\n"
      },
      "n_c952b2521ffd2a9a": {
        "name": "Confirm the release",
        "imports": [],
        "source": "export default function sentryReleaseCreated({\n  statusCode,\n  body,\n  bodyEncoding,\n  endpoint,\n  version,\n}) {\n  if (\n    !Number.isInteger(statusCode) ||\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding != null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body.version !== version\n  )\n    throw new Error(\"Sentry did not confirm the release; inspect it before retrying\");\n  return { release: body, endpoint };\n}\n"
      },
      "n_d7394a55aa1d1f52": {
        "name": "Track release pages",
        "imports": [],
        "source": "export default function sentryReleasePages({\n  endpoint,\n  previousState,\n  statusCode,\n  body,\n  headers,\n  bodyEncoding,\n}) {\n  let state;\n  if (previousState == null)\n    state = { started: false, done: false, cursor: \"\", seen: [], releases: [] };\n  else {\n    if (\n      !previousState.started ||\n      previousState.done ||\n      !Array.isArray(previousState.seen) ||\n      !Array.isArray(previousState.releases)\n    )\n      throw new Error(\"Invalid Sentry pagination state\");\n    if (\n      !Number.isInteger(statusCode) ||\n      statusCode < 200 ||\n      statusCode >= 300 ||\n      bodyEncoding != null ||\n      !Array.isArray(body) ||\n      !headers ||\n      typeof headers.link !== \"string\"\n    )\n      throw new Error(\"Sentry page or pagination Link is invalid\");\n    const links = [...headers.link.matchAll(/<([^>]+)>\\s*;\\s*([^,]*)/g)];\n    const next = links.filter((m) => /(?:^|;)\\s*rel=\"?next\"?(?:\\s*;|\\s*$)/i.test(m[2]));\n    if (next.length !== 1) throw new Error(\"Sentry pagination next link is missing or ambiguous\");\n    const params = next[0][2];\n    const results = params.match(/(?:^|;)\\s*results=\"?(true|false)\"?(?:\\s*;|\\s*$)/i);\n    if (!results) throw new Error(\"Sentry pagination results flag is missing\");\n    let cursor = \"\",\n      done = results[1].toLowerCase() === \"false\";\n    if (!done) {\n      const prefix = \"https://sentry.io/api/0\" + endpoint + \"?\";\n      const href = next[0][1];\n      if (!href.startsWith(prefix))\n        throw new Error(\"Sentry next link does not match the requested endpoint\");\n      const pairs = href.slice(prefix.length).split(\"&\").filter(Boolean),\n        cursors = pairs.filter((p) => p.startsWith(\"cursor=\"));\n      if (cursors.length !== 1) throw new Error(\"Sentry cursor is missing or ambiguous\");\n      try {\n        cursor = decodeURIComponent(cursors[0].slice(7));\n      } catch {\n        throw new Error(\"Invalid Sentry cursor encoding\");\n      }\n      if (!cursor || previousState.seen.includes(cursor))\n        throw new Error(\"Sentry cursor repeated or empty\");\n    }\n    state = {\n      started: true,\n      done,\n      cursor,\n      seen: done ? previousState.seen : previousState.seen.concat([cursor]),\n      releases: previousState.releases.concat(body),\n    };\n  }\n  return {\n    state: { ...state, started: true },\n    more: !state.done,\n    query: state.cursor ? { cursor: state.cursor } : {},\n    releases: state.releases,\n    count: state.releases.length,\n  };\n}\n"
      }
    }
  },
