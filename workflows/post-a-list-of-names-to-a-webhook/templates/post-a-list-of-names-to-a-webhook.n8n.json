{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "post-a-list-of-names-to-a-webhook-start"
    },
    {
      "id": "post-a-list-of-names-to-a-webhook-names",
      "name": "Enter names",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const names = []; return names.map(name => ({json:{name}}));"
      }
    },
    {
      "id": "post-a-list-of-names-to-a-webhook-loop",
      "name": "Process one name",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "post-a-list-of-names-to-a-webhook-post",
      "name": "Post the name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://example.com/your-endpoint",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({name:$json.name}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Enter names",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enter names": {
      "main": [
        [
          {
            "node": "Process one name",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process one name": {
      "main": [
        [],
        [
          {
            "node": "Post the name",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post the name": {
      "main": [
        [
          {
            "node": "Process one name",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Post a List of Names to a Webhook",
  "active": false,
  "pinData": {}
}
