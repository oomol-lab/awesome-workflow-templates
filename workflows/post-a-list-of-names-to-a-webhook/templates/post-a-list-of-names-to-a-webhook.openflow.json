    "modules": {
      "n_7f77e43e5b06aea1": {
        "name": "Prepare the next name",
        "imports": [],
        "source": "export default function next({ names, previous }) {\n  if (!Array.isArray(names) || names.some((x) => typeof x !== \"string\" || !x.trim()))\n    throw Error(\"Enter an array of non-empty names\");\n  const i = previous?.index ?? 0;\n  if (!Number.isInteger(i) || i < 0 || i > names.length) throw Error(\"Invalid iteration\");\n  return {\n    more: i < names.length,\n    body: { name: names[i] ?? \"\" },\n    state: { index: Math.min(i + 1, names.length) },\n  };\n}\n"
      }
    }
