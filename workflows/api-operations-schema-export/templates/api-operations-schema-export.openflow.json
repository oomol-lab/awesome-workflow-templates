    "modules": {
      "n_8dd3be9babe890a8": {
        "name": "Prepare operations export",
        "imports": [],
        "source": "export default function prepareOperationsExport({ service, url, spreadsheetId, range, eventType }) {\n  if (eventType != null && eventType !== 'generate') throw new Error('This component handles only generate requests.');\n  if (typeof service !== 'string' || !service.trim()) throw new Error('Supply the exact service name used in the operations sheet.');\n  if (typeof url !== 'string' || !url.trim()) throw new Error('Supply the service documentation URL.');\n  if (typeof spreadsheetId !== 'string' || !/^[A-Za-z0-9_-]+$/.test(spreadsheetId) || /YOUR_SPREADSHEET_ID/.test(spreadsheetId)) throw new Error('Configure your operations spreadsheet ID.');\n  if (typeof range !== 'string' || !/^'(?:[^'\\u0000-\\u001f\\u007f]|'')+'$/.test(range)) throw new Error('Configure the complete operations tab as a single-quoted A1 sheet name.');\n  return { service, url, spreadsheetId, range, createdAt: new Date().toISOString() };\n}\n"
      },
      "n_026cbbf70e840614": {
        "name": "Build custom operations JSON",
        "imports": [],
        "source": "function sheetTable({ values, majorDimension = \"ROWS\" }) {\n  if (majorDimension !== \"ROWS\" || !Array.isArray(values) || values.some((row) => !Array.isArray(row)))\n    throw Error(\"Google Sheets must return row-oriented cell values.\");\n  const isEmpty = (value) => value == null || value === \"\", nonempty = (row) => row.some((value) => !isEmpty(value)), headerIndex = values.findIndex(nonempty);\n  if (headerIndex < 0)\n    return { columns: [], records: [] };\n  const headers = values[headerIndex];\n  if (headers.some((name) => typeof name !== \"string\" || !name.trim() || name === \"row_number\") || new Set(headers).size !== headers.length)\n    throw Error(\"Use unique nonempty text headers; row_number is reserved.\");\n  const columns = [\"row_number\", ...headers], records = [];\n  for (let index = headerIndex + 1;index < values.length; index++) {\n    const cells = values[index];\n    if (!nonempty(cells))\n      continue;\n    if (cells.slice(headers.length).some((value) => !isEmpty(value)))\n      throw Error(\"Every populated column needs a header.\");\n    records.push(Object.fromEntries([[\"row_number\", index + 1], ...headers.map((name, column) => [name, cells[column] ?? \"\"])]));\n  }\n  return { columns, records };\n}\n\nexport default function buildOperationsExport({ values, majorDimension, service, url, createdAt }) {\n  const table = sheetTable({ values, majorDimension });\n  const required = ['service', 'resource', 'operation', 'description', 'url', 'method'];\n  if (table.columns.length && required.some(name => !table.columns.includes(name))) throw new Error('The operations tab needs service, resource, operation, description, url and method columns.');\n  const groups = new Map();\n  let operationCount = 0;\n  for (const row of table.records) {\n    if (String(row.service) !== service) continue;\n    for (const key of ['resource', 'operation', 'url', 'method']) if (typeof row[key] !== 'string' || !row[key].trim()) throw new Error('Each matching operation needs resource, operation, url and method text.');\n    if (typeof row.description !== 'string') throw new Error('Operation descriptions must be text.');\n    if (row.documentation_url != null && typeof row.documentation_url !== 'string') throw new Error('Method documentation URLs must be text when supplied.');\n    const resource = row.resource.toLowerCase().trim().replace(/\\bapi\\b/g, '').replace(/\\s+/g, ' ').trim();\n    if (!resource) continue;\n    if (!groups.has(resource)) groups.set(resource, { resource: resource[0].toUpperCase() + resource.slice(1), operations: [] });\n    const description = row.description.trim(), period = description.indexOf('.');\n    const operation = row.operation.trim();\n    groups.get(resource).operations.push({ operation: operation[0].toUpperCase() + operation.slice(1), description: period > 0 ? description.slice(0, period + 1) : description, ApiUrl: row.url, method: row.method.trim().toUpperCase(), method_documentation_url: row.documentation_url || '' });\n    operationCount++;\n  }\n  if (typeof createdAt !== 'string' || Number.isNaN(Date.parse(createdAt))) throw new Error('The export needs its run-start timestamp.');\n  const timestamp = new Date(createdAt).toISOString().slice(0, 19).replace(/[-:]/g, '').replace('T', '_') + 'Z';\n  const prefix = service.replace(/[^\\p{L}\\p{N}_-]+/gu, '_').replace(/^_+|_+$/g, '').toLowerCase() || 'service';\n  const filename = prefix + '_api_operations_' + timestamp + '.json';\n  const text = JSON.stringify({ documentation_url: url, endpoints: [...groups.values()] }, null, 4);\n  if (new TextEncoder().encode(text).byteLength > 5000000) throw new Error('The generated JSON text exceeds the 5,000,000-byte content budget.');\n  return { hasOperations: operationCount > 0, operationCount, filename, text };\n}\n"
      },
      "n_b71d35ed4a3c3b6a": {
        "name": "Confirm saved export",
        "imports": [],
        "source": "export default function operationsExportReply({ exported, id, filename }) {\n  if (!exported) return { exported: false, response: { id: null, filename: null } };\n  if (typeof id !== 'string' || !id.trim() || typeof filename !== 'string' || !filename.trim()) throw new Error('Google Drive did not acknowledge the created export file.');\n  return { exported: true, response: { id, filename } };\n}\n"
      },
      "n_2ba023d28e8f0797": {
        "name": "Return no operations",
        "imports": [],
        "source": "export default function operationsExportReply({ exported, id, filename }) {\n  if (!exported) return { exported: false, response: { id: null, filename: null } };\n  if (typeof id !== 'string' || !id.trim() || typeof filename !== 'string' || !filename.trim()) throw new Error('Google Drive did not acknowledge the created export file.');\n  return { exported: true, response: { id, filename } };\n}\n"
      }
    }
