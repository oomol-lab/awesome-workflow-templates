    "modules": {
      "n_215965562a8370c3": {
        "name": "Read author and feedback",
        "imports": [],
        "source": "export default function prepareTestimonial(inputs) {\n  const fields = inputs.body?.data?.fields;\n  if (!Array.isArray(fields)) throw new Error('Expected data.fields with author first and feedback second.');\n  const Author = fields[0]?.value;\n  const Content = fields[1]?.value;\n  if (typeof Author !== 'string' || !Author.trim() || typeof Content !== 'string' || !Content.trim()) throw new Error('Author and feedback must be nonempty text fields.');\n  const Created = new Date().toISOString();\n  return { Author, Content, Created, URL: '', request: { document: { type: 'PLAIN_TEXT', content: Content }, encodingType: 'UTF16' } };\n}\n"
      },
      "n_3ea3fc33f6fa38ad": {
        "name": "Validate form score",
        "imports": [],
        "source": "export default function readSentiment(inputs) {\n  const body = inputs.body;\n  const score = body?.documentSentiment?.score;\n  if (!body || typeof body !== 'object' || Array.isArray(body) || body.error || typeof score !== 'number' || !Number.isFinite(score) || score < -1 || score > 1) throw new Error('The sentiment service did not return a valid document score.');\n  return { score };\n}\n"
      },
      "n_efd6bcb0b6e51600": {
        "name": "Select Strapi entry fields",
        "imports": [],
        "source": "export default function prepareStrapiPayload(inputs) {\n  const { Author, Content, Created, URL } = inputs;\n  return { record: { Content, Author, Created, URL }, body: { data: { Content, Author, Created, URL } } };\n}\n"
      },
      "n_1510a0c28efc80cd": {
        "name": "Confirm captured entry",
        "imports": [],
        "source": "export default function testimonialResult(inputs) {\n  if (inputs.body === null) return { result: { status: 'ignored', score: inputs.score, entry: null } };\n  const body = inputs.body;\n  const entry = body?.data;\n  if (!body || typeof body !== 'object' || body.error || !entry || typeof entry !== 'object' || Array.isArray(entry) || !(typeof entry.documentId === 'string' && entry.documentId || typeof entry.id === 'number' && Number.isFinite(entry.id) || typeof entry.id === 'string' && entry.id)) throw new Error('Strapi did not confirm a created entry.');\n  return { result: { status: 'captured', score: inputs.score, entry } };\n}\n"
      },
      "n_db6c2974a6e33b11": {
        "name": "Return ignored feedback",
        "imports": [],
        "source": "export default function testimonialResult(inputs) {\n  if (inputs.body === null) return { result: { status: 'ignored', score: inputs.score, entry: null } };\n  const body = inputs.body;\n  const entry = body?.data;\n  if (!body || typeof body !== 'object' || body.error || !entry || typeof entry !== 'object' || Array.isArray(entry) || !(typeof entry.documentId === 'string' && entry.documentId || typeof entry.id === 'number' && Number.isFinite(entry.id) || typeof entry.id === 'string' && entry.id)) throw new Error('Strapi did not confirm a created entry.');\n  return { result: { status: 'captured', score: inputs.score, entry } };\n}\n"
      }
    }
