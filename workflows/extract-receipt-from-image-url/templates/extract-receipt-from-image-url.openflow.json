    "modules": {
      "n_47a9fd185229b600": {
        "name": "Prepare the receipt request",
        "imports": [],
        "source": "export default function prepare({ receiptUrl, modelId }) {\n  if (\n    typeof receiptUrl !== \"string\" ||\n    !/^https:\\/\\/[^\\s/?#@]+(?:[/?#][^\\s]*)?$/i.test(receiptUrl) ||\n    receiptUrl.includes(\"openflow-mindee-form-7d1b8e6f\")\n  )\n    throw Error(\"Enter a direct HTTPS receipt URL without credentials\");\n  if (\n    typeof modelId !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(modelId)\n  )\n    throw Error(\"Configure the Mindee Receipt model ID\");\n  const b = \"openflow-mindee-form-7d1b8e6f\";\n  return {\n    modelId,\n    body: `--${b}\\r\\nContent-Disposition: form-data; name=\"model_id\"\\r\\n\\r\\n${modelId}\\r\\n--${b}\\r\\nContent-Disposition: form-data; name=\"url\"\\r\\n\\r\\n${receiptUrl}\\r\\n--${b}--\\r\\n`,\n  };\n}\n"
      },
      "n_1790a77db1f867b0": {
        "name": "Check the accepted job",
        "imports": [],
        "source": "export default function job({ body, modelId, statusCode }) {\n  const j = body?.job;\n  if (\n    statusCode !== 202 ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(j?.id ?? \"\") ||\n    j.model_id !== modelId\n  )\n    throw Error(\"Mindee returned an invalid job\");\n  return { jobId: j.id, url: `https://api-v2.mindee.net/v2/jobs/${j.id}?redirect=false` };\n}\n"
      },
      "n_ee3d8c8aea1067d7": {
        "name": "Validate the job status",
        "imports": [],
        "source": "export default function status({ body, jobId, previousState }) {\n  const attempt = (previousState?.attempt ?? 0) + 1,\n    j = body?.job;\n  if (!Number.isInteger(attempt) || attempt > 200 || j?.id !== jobId)\n    throw Error(\"Invalid Mindee job status\");\n  if (j.status === \"Failed\") throw Error(\"Mindee receipt processing failed\");\n  if (j.status === \"Processing\") {\n    if (attempt >= 200) throw Error(\"Mindee did not finish within the polling window\");\n    return {\n      state: { attempt },\n      ready: false,\n      resultUrl: \"https://api-v2.mindee.net/v2/products/extraction/results/unused\",\n    };\n  }\n  if (\n    j.status !== \"Processed\" ||\n    !/^https:\\/\\/api-v2\\.mindee\\.net\\/v2\\/products\\/extraction\\/results\\/[0-9a-f-]{36}$/i.test(\n      j.result_url ?? \"\",\n    )\n  )\n    throw Error(\"Invalid Mindee result URL\");\n  return { state: { attempt }, ready: true, resultUrl: j.result_url };\n}\n"
      },
      "n_04f43e1704be97c2": {
        "name": "Check the receipt result",
        "imports": [],
        "source": "export default function result({ body, jobId }) {\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body.inference?.job?.id !== jobId ||\n    !body.inference?.result?.fields ||\n    typeof body.inference.result.fields !== \"object\"\n  )\n    throw Error(\"Mindee returned an invalid receipt result\");\n  return { receipt: body };\n}\n"
      }
    }
