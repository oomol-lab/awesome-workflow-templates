    "modules": {
      "n_c64405d22b2ac4b2": {
        "name": "Prepare next generation step",
        "imports": [],
        "source": "export default async function next(\n  {\n    requestId,\n    prompt,\n    aspect,\n    duration,\n    loop,\n    callback,\n    resolution,\n    acknowledge,\n    outcome,\n    generationId,\n  },\n  ctx,\n) {\n  if (!/^[A-Za-z0-9_-]{1,80}$/.test(requestId) || !prompt.trim())\n    throw Error(\"Configure a unique request ID and prompt\");\n  if (\n    ![\"1:1\", \"16:9\", \"9:16\", \"4:3\", \"3:4\", \"21:9\", \"9:21\"].includes(aspect) ||\n    ![\"5s\", \"9s\"].includes(duration) ||\n    ![\"540p\", \"720p\", \"1080p\", \"4k\"].includes(resolution)\n  )\n    throw Error(\"Invalid video settings\");\n  if (callback && !/^https:\\/\\//.test(callback)) throw Error(\"Callback must be HTTPS\");\n  const key = \"luma-video:\" + requestId,\n    spec = { prompt, aspect, duration, loop, callback, resolution },\n    same = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n  let s = await ctx.state.get(key);\n  if (s && !same(s.spec, spec)) throw Error(\"Request settings changed; use a new request ID\");\n  if (!s) {\n    const moves = [\n      \"Static\",\n      \"Move Left\",\n      \"Move Right\",\n      \"Move Up\",\n      \"Move Down\",\n      \"Push In\",\n      \"Pull Out\",\n      \"Zoom In\",\n      \"Zoom Out\",\n      \"Pan Left\",\n      \"Pan Right\",\n      \"Orbit Left\",\n      \"Orbit Right\",\n      \"Crane Up\",\n      \"Crane Down\",\n    ];\n    s = {\n      phase: \"generation-pending\",\n      spec,\n      motion: moves[Math.floor(Math.random() * moves.length)],\n    };\n    await ctx.state.set(key, s);\n    return {\n      phase: \"submit\",\n      key,\n      body: {\n        model: \"ray-2\",\n        prompt: prompt + \"; camera motion: \" + s.motion,\n        aspect_ratio: aspect,\n        duration,\n        loop,\n        resolution,\n        ...(callback ? { callback_url: callback } : {}),\n      },\n      records: [{ fields: {} }],\n    };\n  }\n  if (s.phase === \"generation-pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(outcome))\n      throw Error(\"Inspect pending generation \" + key);\n    if (outcome === \"absent\") {\n      await ctx.state.set(key, null);\n      return next(\n        {\n          requestId,\n          prompt,\n          aspect,\n          duration,\n          loop,\n          callback,\n          resolution,\n          acknowledge: \"\",\n          outcome: \"\",\n          generationId: \"\",\n        },\n        ctx,\n      );\n    }\n    if (!/^[0-9a-f-]{36}$/i.test(generationId)) throw Error(\"Enter confirmed generation ID\");\n    s.phase = \"generated\";\n    s.generationId = generationId;\n    await ctx.state.set(key, s);\n  }\n  if (s.phase === \"record-pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(outcome))\n      throw Error(\"Inspect pending Airtable record \" + key);\n    if (outcome === \"confirmed\") {\n      s.phase = \"done\";\n      await ctx.state.set(key, s);\n    } else {\n      s.phase = \"generated\";\n      await ctx.state.set(key, s);\n    }\n  }\n  if (s.phase === \"generated\") {\n    s.phase = \"record-pending\";\n    await ctx.state.set(key, s);\n    return {\n      phase: \"record\",\n      key,\n      body: {},\n      records: [\n        {\n          fields: {\n            \"Generation ID\": s.generationId,\n            Status: \"In progress\",\n            Prompt: prompt,\n            Aspect: aspect,\n            Length: duration,\n            Model: \"ray-2\",\n            Resolution: resolution,\n            \"Cluster ID\": requestId,\n          },\n        },\n      ],\n    };\n  }\n  if (s.phase === \"done\") return { phase: \"done\", key, body: {}, records: [{ fields: {} }] };\n  throw Error(\"Invalid generation state\");\n}\n"
      },
      "n_a7a2a45125cce9c3": {
        "name": "Save generation ID",
        "imports": [],
        "source": "export default async function f({ key, body }, ctx) {\n  const s = await ctx.state.get(key);\n  if (s?.phase !== \"generation-pending\" || !/^[0-9a-f-]{36}$/i.test(body?.id ?? \"\"))\n    throw Error(\"Inspect generation result\");\n  s.phase = \"generated\";\n  s.generationId = body.id;\n  await ctx.state.set(key, s);\n  return { ok: true };\n}\n"
      },
      "n_641445774ee85f07": {
        "name": "Confirm generation record",
        "imports": [],
        "source": "export default async function f({ key, records }, ctx) {\n  const s = await ctx.state.get(key);\n  if (\n    s?.phase !== \"record-pending\" ||\n    records?.length !== 1 ||\n    !records[0].id ||\n    records[0].fields?.[\"Generation ID\"] !== s.generationId\n  )\n    throw Error(\"Inspect Airtable record\");\n  s.phase = \"done\";\n  await ctx.state.set(key, s);\n  return { ok: true };\n}\n"
      }
    }
  },
