          ]
        },
        "operation": "update",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "record_pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "luma-video-11",
      "position": [
        2530,
        0
      ]
    },
    {
      "name": "Prepare Airtable record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare generation\").item.json,\n  s = p.spec.settings;\nif (!/^[0-9a-f-]{36}$/i.test(p.generationId ?? \"\")) throw Error(\"Invalid generation ID\");\nreturn {\n  json: {\n    fields: {\n      \"Generation ID\": p.generationId,\n      Status: \"In progress\",\n      Prompt: s.prompt + \", \" + p.spec.motion,\n      Aspect: s.aspect,\n      Length: s.duration,\n      Model: \"ray-2\",\n      Resolution: s.resolution,\n      \"Cluster ID\": s.requestId,\n    },\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "luma-video-12",
      "position": [
        2760,
        0
      ]
    },
    {
      "name": "Log generation in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Generation ID": "={{ $json.fields[\"Generation ID\"] }}",
            "Status": "={{ $json.fields[\"Status\"] }}",
            "Prompt": "={{ $json.fields[\"Prompt\"] }}",
            "Aspect": "={{ $json.fields[\"Aspect\"] }}",
            "Length": "={{ $json.fields[\"Length\"] }}",
            "Model": "={{ $json.fields[\"Model\"] }}",
            "Resolution": "={{ $json.fields[\"Resolution\"] }}",
            "Cluster ID": "={{ $json.fields[\"Cluster ID\"] }}"
          },
          "schema": []
        },
        "options": {
          "typecast": true
        }
      },
      "id": "luma-video-13",
      "position": [
        2990,
        0
      ]
    },
    {
      "name": "Verify Airtable record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const expected = $(\"Prepare Airtable record\").item.json.fields[\"Generation ID\"];\nif (!$json.id || $json.fields?.[\"Generation ID\"] !== expected)\n  throw Error(\"Inspect Airtable result\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "luma-video-14",
      "position": [
        3220,
        0
      ]
    },
    {
      "name": "Confirm Airtable record",
      "type": "n8n-nodes-base.dataTable",
