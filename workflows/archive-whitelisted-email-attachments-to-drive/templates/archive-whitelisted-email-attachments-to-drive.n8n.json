    {
      "name": "Lookup in Sheets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function select({ values, sender, payload }) {\n  if (!Array.isArray(values) || !Array.isArray(values[0])) throw Error(\"Whitelist sheet is empty\");\n  const h = values[0],\n    e = h.indexOf(\"email\"),\n    c = h.indexOf(\"company\");\n  if (e < 0 || c < 0 || h.lastIndexOf(\"email\") !== e || h.lastIndexOf(\"company\") !== c)\n    throw Error(\"Whitelist requires unique email and company headers\");\n  if (typeof sender !== \"string\") throw Error(\"Invalid sender\");\n  const address = (sender.match(/<([^<>]+)>\\s*$/)?.[1] ?? sender).trim();\n  if (!/^[^\\s<>@,]+@[^\\s<>@,]+$/.test(address)) throw Error(\"Invalid sender address\");\n  const matches = values.slice(1).filter((r) => Array.isArray(r) && r[e] === address);\n  if (matches.length > 1) throw Error(\"Duplicate whitelist entry\");\n  if (!matches.length) return { match: false, company: \"\", date: \"\", month: \"\", address };\n  const company = matches[0][c];\n  if (typeof company !== \"string\" || !company.trim()) throw Error(\"Missing company\");\n  const dates = (payload?.headers ?? [])\n    .filter((x) => typeof x?.name === \"string\" && x.name.toLowerCase() === \"date\")\n    .map((x) => x.value);\n  if (dates.length !== 1 || typeof dates[0] !== \"string\")\n    throw Error(\"Missing or ambiguous Date header\");\n  const d = new Date(dates[0]);\n  if (!Number.isFinite(d.getTime())) throw Error(\"Invalid Date header\");\n  return {\n    match: true,\n    company,\n    date: dates[0],\n    month: d.toISOString().slice(0, 7).replace(\"-\", \"/\"),\n    address,\n  };\n}\n\nconst msg = $(\"Gmail Trigger\").item.json;\nconst r = select({\n  values: $json.values ?? [],\n  sender: msg.from?.value?.[0]?.address,\n  payload: { headers: [{ name: \"Date\", value: msg.date }] },\n});\nreturn r.match ? { json: { company: r.company } } : null;\n"
      },
      "id": "archive-whitelisted-email-attachments-to-drive-13"
    }
