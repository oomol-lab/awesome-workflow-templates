    {
      "name": "Lookup in Sheets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function select({values,sender,payload}){\n if(!Array.isArray(values)||!Array.isArray(values[0]))throw Error('Whitelist sheet is empty');const h=values[0],e=h.indexOf('email'),c=h.indexOf('company');if(e<0||c<0||h.lastIndexOf('email')!==e||h.lastIndexOf('company')!==c)throw Error('Whitelist requires unique email and company headers');\n if(typeof sender!=='string')throw Error('Invalid sender');const address=(sender.match(/<([^<>]+)>\\s*$/)?.[1]??sender).trim();if(!/^[^\\s<>@,]+@[^\\s<>@,]+$/.test(address))throw Error('Invalid sender address');const matches=values.slice(1).filter(r=>Array.isArray(r)&&r[e]===address);if(matches.length>1)throw Error('Duplicate whitelist entry');if(!matches.length)return {match:false,company:'',date:'',month:'',address};const company=matches[0][c];if(typeof company!=='string'||!company.trim())throw Error('Missing company');const dates=(payload?.headers??[]).filter(x=>typeof x?.name==='string'&&x.name.toLowerCase()==='date').map(x=>x.value);if(dates.length!==1||typeof dates[0]!=='string')throw Error('Missing or ambiguous Date header');const d=new Date(dates[0]);if(!Number.isFinite(d.getTime()))throw Error('Invalid Date header');return {match:true,company,date:dates[0],month:d.toISOString().slice(0,7).replace('-','/'),address};\n}\n\nconst msg=$('Gmail Trigger').item.json;const r=select({values:$json.values??[],sender:msg.from?.value?.[0]?.address,payload:{headers:[{name:'Date',value:msg.date}]}});return r.match?{json:{company:r.company}}:null;"
      },
      "id": "archive-whitelisted-email-attachments-to-drive-13"
    }
