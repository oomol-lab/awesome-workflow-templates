    {
      "id": "pair-invoice-files",
      "name": "Pair invoice files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const files = Object.values($binary || {}),\n  pdf = files.filter((x) => /\\.pdf$/i.test(x.fileName || \"\")),\n  xml = files.filter((x) => /\\.xml$/i.test(x.fileName || \"\"));\nif (pdf.length !== 1 || xml.length !== 1) throw Error(\"Expected one PDF and one XML\");\nreturn { json: {}, binary: { data: pdf[0], xml: xml[0] } };\n"
      }
    },
    {
      "id": "1132645b-9270-4581-9707-59bec4ee2417",
      "name": "Extract PDF Data",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        2420,
        0
      ],
      "parameters": {
        "options": {
          "joinPages": true
        },
        "operation": "pdf"
      },
      "typeVersion": 1
    },
    {
      "id": "215b29f9-0e0a-4989-a6d3-65faa5941729",
      "name": "Extract XML Data",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        2640,
