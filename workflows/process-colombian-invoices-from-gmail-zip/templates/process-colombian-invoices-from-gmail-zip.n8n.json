    {
      "id": "prepare-invoice-prompt",
      "name": "Prepare invoice prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.text,\n  xml = $json.data;\nif (\n  typeof text !== \"string\" ||\n  !text.trim() ||\n  typeof xml !== \"string\" ||\n  !xml.trim() ||\n  text.length > 30000 ||\n  xml.length > 30000 ||\n  /<!DOCTYPE|<!ENTITY/i.test(xml)\n)\n  throw Error(\"Invalid or oversized invoice\");\nreturn {\n  json: {\n    prompt:\n      \"Extrae de la factura colombiana PDF y XML. Devuelve solamente JSON con Tipo (Factura o Nota Crédito), Numero_Factura, Fecha_Emision YYYY-MM-DD, CUFE, NIT_Emisor, Razon_Social_Emisor, NIT_Receptor, Valor_Antes_Impuesto, Impuesto, Total y Resumen_Compra. NIT sin dígito; importes números. No inventes datos. PDF:\\n\" +\n      text +\n      \"\\nXML:\\n\" +\n      xml,\n  },\n};\n"
      }
    },
    {
      "id": "extract-invoice-with-gemini",
      "name": "Extract invoice with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({contents:[{parts:[{text:$json.prompt}]}],generationConfig:{response_mime_type:'application/json',temperature:0}}) }}",
        "options": {}
      }
    },
    {
      "id": "validate-invoice",
      "name": "Validate invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json.candidates?.[0];\nif (c?.finishReason !== \"STOP\") throw Error(\"Incomplete invoice\");\nconst x = JSON.parse(c.content.parts.map((p) => p.text || \"\").join(\"\"));\nconst req = [\n  \"Tipo\",\n  \"Numero_Factura\",\n  \"Fecha_Emision\",\n  \"CUFE\",\n  \"NIT_Emisor\",\n  \"Razon_Social_Emisor\",\n  \"NIT_Receptor\",\n  \"Resumen_Compra\",\n];\nif (\n  req.some((k) => typeof x[k] !== \"string\" || !x[k].trim()) ||\n  ![\"Factura\", \"Nota Crédito\"].includes(x.Tipo) ||\n  !/^\\d{4}-\\d{2}-\\d{2}$/.test(x.Fecha_Emision) ||\n  !/^\\d+$/.test(x.NIT_Emisor) ||\n  !/^\\d+$/.test(x.NIT_Receptor) ||\n  !/^[-A-Za-z0-9_]+$/.test(x.Numero_Factura) ||\n  [\"Valor_Antes_Impuesto\", \"Impuesto\", \"Total\"].some(\n    (k) => typeof x[k] !== \"number\" || !Number.isFinite(x[k]),\n  ) ||\n  Math.abs(x.Valor_Antes_Impuesto + x.Impuesto - x.Total) > 0.01\n)\n  throw Error(\"Invalid invoice totals or fields\");\nreturn { json: { invoice: x } };\n"
      }
    },
