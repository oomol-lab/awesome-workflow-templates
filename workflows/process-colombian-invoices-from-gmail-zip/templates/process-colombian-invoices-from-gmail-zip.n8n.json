      "parameters": {
        "options": {},
        "operation": "xml",
        "binaryPropertyName": "xml"
      },
      "typeVersion": 1
    },
    {
      "id": "pair-extracted-text",
      "name": "Pair extracted text",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2860,
        0
