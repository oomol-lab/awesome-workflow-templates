    {
      "id": "select-zip-attachments",
      "name": "Select ZIP attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const [i, item] of $input.all().entries()) {\n  if (!item.json.id) throw Error(\"Missing message ID\");\n  for (const [k, v] of Object.entries(item.binary || {}))\n    if ((v.fileName || \"\").toLowerCase().endsWith(\".zip\"))\n      out.push({\n        json: { messageId: item.json.id, attachmentKey: k },\n        binary: { data: v },\n        pairedItem: { item: i },\n      });\n}\nreturn out;\n"
      }
    },
    {
      "id": "one-zip-at-a-time",
      "name": "One ZIP at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "load-invoice-state",
      "name": "Load invoice state",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'col-invoice:'+$('One ZIP at a time').item.json.messageId+':'+$('One ZIP at a time').item.json.attachmentKey }}"
            }
          ]
        },
        "operation": "get",
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "check-invoice-state",
      "name": "Check invoice state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.item_key);\nif (rows.length > 1) throw Error(\"Duplicate invoice state\");\nif (rows[0]?.status === \"pending\") throw Error(\"Inspect pending invoice writes\");\nif (rows[0] && rows[0].status !== \"done\") throw Error(\"Invalid invoice state\");\nreturn [{ json: { needed: !rows.length } }];\n"
      }
    },
    {
      "id": "invoice-needs-processing",
      "name": "Invoice needs processing",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.needed }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
