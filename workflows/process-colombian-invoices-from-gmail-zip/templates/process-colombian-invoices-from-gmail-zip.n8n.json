    {
      "id": "fetch-resumed-message",
      "name": "Fetch resumed message",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $json.body.messageId }}",
        "simple": false,
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
