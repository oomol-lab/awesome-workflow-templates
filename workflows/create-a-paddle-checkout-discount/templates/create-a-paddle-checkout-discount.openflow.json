        "name": "Prepare the discount",
        "imports": [],
        "source": "export default function paddleDiscount({code}) {\n if(typeof code!=='string'||! /^[A-Za-z0-9]{1,32}$/.test(code)||code==='YOURCODE')throw Error('Set a unique Paddle discount code using letters and numbers');\n return {body:{description:'EUR 2 checkout discount',type:'flat',amount:'200',currency_code:'EUR',enabled_for_checkout:true,code,recur:false}};\n}\n"
      }
