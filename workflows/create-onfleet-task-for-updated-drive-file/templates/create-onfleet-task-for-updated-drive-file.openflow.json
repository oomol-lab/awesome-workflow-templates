    "modules": {
      "n_b13233953b3941ed": {
        "name": "Match the watched file",
        "imports": [],
        "source": "export default function match({ events, fileId }) {\n  if (!Array.isArray(events) || typeof fileId !== \"string\" || !fileId || fileId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the watched Drive file ID\");\n  const hits = events.filter(\n    (e) => e?.eventType === \"file_updated\" && e?.itemType === \"file\" && e?.fileId === fileId,\n  );\n  if (hits.length > 1) throw Error(\"Duplicate watched file events\");\n  return { matched: hits.length === 1 };\n}\n"
      }
    }
