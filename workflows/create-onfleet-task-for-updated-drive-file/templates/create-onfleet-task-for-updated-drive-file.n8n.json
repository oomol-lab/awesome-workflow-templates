{
  "name": "Create an Onfleet Task for an Updated Drive File",
  "nodes": [
    {
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "position": [
        460,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFile",
        "fileToWatch": "YOUR_GOOGLE_DRIVE_FILE_ID",
        "event": "fileUpdated"
      },
      "typeVersion": 1,
      "id": "create-onfleet-task-for-updated-drive-file-0"
    },
    {
      "name": "Create the Onfleet task",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://onfleet.com/api/v2/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"destination\":{\"address\":{\"unparsed\":\"YOUR_DESTINATION_ADDRESS\"}},\"recipients\":[{\"name\":\"YOUR_RECIPIENT_NAME\",\"phone\":\"YOUR_RECIPIENT_PHONE\"}]}",
        "options": {}
      },
      "typeVersion": 4.2,
      "id": "create-onfleet-task-for-updated-drive-file-1"
    }
  ],
  "active": false,
