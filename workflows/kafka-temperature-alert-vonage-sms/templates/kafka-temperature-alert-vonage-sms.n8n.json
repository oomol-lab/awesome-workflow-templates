{
  "name": "Kafka Temperature Alert by Vonage SMS",
  "nodes": [
    {
      "name": "Kafka Trigger",
      "type": "n8n-nodes-base.kafkaTrigger",
      "position": [
        490,
        260
      ],
      "parameters": {
        "topic": "YOUR_TOPIC",
        "groupId": "YOUR_CONSUMER_GROUP",
        "options": {
          "jsonParseMessage": true
        }
      },
      "typeVersion": 1,
      "id": "kafka-temperature-alert-vonage-sms-0"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        690,
        260
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$node[\"Kafka Trigger\"].json[\"message\"][\"temp\"]}}",
              "value2": 50,
              "operation": "larger"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "kafka-temperature-alert-vonage-sms-1"
    },
    {
      "name": "Vonage",
      "type": "n8n-nodes-base.vonage",
      "position": [
        890,
        160
      ],
      "parameters": {
        "from": "Vonage APIs",
        "message": "=Alert!\nThe value of temp is {{$node[\"Kafka Trigger\"].json[\"message\"][\"temp\"]}}.",
        "additionalFields": {},
        "to": "15555550123"
      },
      "typeVersion": 1,
      "id": "kafka-temperature-alert-vonage-sms-2"
    },
    {
      "name": "NoOp",
      "type": "n8n-nodes-base.noOp",
      "position": [
        890,
        360
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "kafka-temperature-alert-vonage-sms-3"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "IF": {
      "main": [
        [
          {
            "node": "Vonage",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NoOp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kafka Trigger": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
