{
  "name": "Post to X with an Airtop Profile",
  "tags": [
    {
      "id": "gNiDOCnjqCXR7phD",
      "name": "Marketing",
      "createdAt": "2025-04-15T01:08:25.516Z",
      "updatedAt": "2025-04-15T01:08:25.516Z"
    },
    {
      "id": "zKNO4Omjzfu6J25M",
      "name": "Demo",
      "createdAt": "2025-04-15T18:59:57.364Z",
      "updatedAt": "2025-04-15T18:59:57.364Z"
    }
  ],
  "nodes": [
    {
      "id": "post-to-x-with-airtop-profile-0",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {
          "buttonLabel": "Post on X",
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Interaction completed. Verify publication on X."
            }
          }
        },
        "formTitle": "Post on X",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Airtop profile name",
              "placeholder": "e.g. my-x-profile",
              "requiredField": true
            },
            {
              "fieldLabel": "Text to post",
              "placeholder": "e.g. This X post was made with Airtop and n8n",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "formDescription": "Enter the <a href=\"https://docs.airtop.ai/guides/how-to/saving-a-profile\" target=\"_blank\">Airtop Profile</a> and the content you would like to post on x.com"
      },
      "typeVersion": 2.2
    },
    {
      "id": "post-to-x-with-airtop-profile-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "position": [
        220,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "airtop_profile"
            },
            {
              "name": "post_text"
            }
          ]
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "post-to-x-with-airtop-profile-2",
      "name": "Parameters",
      "type": "n8n-nodes-base.set",
      "position": [
        440,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "e612bf63-72bd-4b61-82c9-786a90b58b7b",
              "name": "airtop_profile",
              "type": "string",
              "value": "={{ $json[\"Airtop profile name\"] || $json.airtop_profile }}"
            },
            {
              "id": "567e5e7d-4efd-4d0a-a93c-6c7aed02c305",
              "name": "post_text",
              "type": "string",
              "value": "={{ $json[\"Text to post\"] || $json.post_text }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "name": "Choose mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.airtop_profile || !$json.post_text) throw Error(\"Missing profile or text\");\nreturn {\n  json: {\n    submissionId: $execution.id,\n    profile: $json.airtop_profile,\n    text: $json.post_text,\n    mode: \"direct\",\n  },\n};\n"
      },
      "id": "post-to-x-with-airtop-profile-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $('Choose mode').first().json.mode === 'relay' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "post-to-x-with-airtop-profile-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Forward post request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Choose mode').first().json }}",
        "options": {}
      },
      "id": "post-to-x-with-airtop-profile-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Verify relay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status !== \"interaction-complete-verify-on-x\") throw Error(\"Unknown relay result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "post-to-x-with-airtop-profile-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "id": "post-to-x-with-airtop-profile-7",
      "name": "Create session",
      "type": "n8n-nodes-base.airtop",
      "position": [
        1540,
        0
      ],
      "parameters": {
        "profileName": "={{ $('Choose mode').first().json.profile }}",
        "timeoutMinutes": 5,
        "saveProfileOnTermination": true
      },
      "typeVersion": 1
    },
    {
      "id": "post-to-x-with-airtop-profile-8",
      "name": "Create window",
      "type": "n8n-nodes-base.airtop",
      "position": [
        1760,
        0
      ],
      "parameters": {
        "url": "https://x.com/",
        "resource": "window",
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Post not attempted",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'x-post:' + $('Choose mode').first().json.submissionId }}"
            }
          ]
        }
      },
      "id": "post-to-x-with-airtop-profile-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Reserve X interaction",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'x-post:' + $('Choose mode').first().json.submissionId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "post-to-x-with-airtop-profile-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Restore browser window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Create window\").first().json };\n"
      },
      "id": "post-to-x-with-airtop-profile-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "id": "post-to-x-with-airtop-profile-12",
      "name": "Type text",
      "type": "n8n-nodes-base.airtop",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "text": "={{ $('Choose mode').first().json.text }}",
        "resource": "interaction",
        "operation": "type",
        "pressEnterKey": true,
        "additionalFields": {},
        "elementDescription": "\"What's happening?\" text box on top"
      },
      "typeVersion": 1
    },
    {
      "id": "post-to-x-with-airtop-profile-13",
      "name": "Click on Post",
      "type": "n8n-nodes-base.airtop",
      "position": [
        2860,
        0
      ],
      "parameters": {
        "resource": "interaction",
        "additionalFields": {
          "visualScope": "viewport"
        },
        "elementDescription": "Click on the Post button "
      },
      "typeVersion": 1
    },
    {
      "id": "post-to-x-with-airtop-profile-14",
      "name": "End session",
      "type": "n8n-nodes-base.airtop",
      "position": [
        3080,
        0
      ],
      "parameters": {
        "operation": "terminate"
      },
      "typeVersion": 1
    }
  ],
  "active": false,
  "pinData": {},
