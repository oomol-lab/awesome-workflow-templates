    "modules": {
      "n_46c95f48bc8358c0": {
        "name": "Prepare Airtop session",
        "imports": [],
        "source": "export default function f({ body }) {\n  if (!body?.profile || !body?.text) throw Error(\"Missing post\");\n  return { request: { configuration: { profileName: body.profile, timeoutMinutes: 5 } } };\n}\n"
      },
      "n_3185cc902382a112": {
        "name": "Check session",
        "imports": [],
        "source": "export default function session({ body }) {\n  const x = body?.data;\n  if (!x || typeof x.id !== \"string\" || !/^[-a-z0-9]+$/i.test(x.id) || body.errors?.length)\n    throw Error(\"Invalid Airtop session\");\n  const base = \"https://api.airtop.ai/api/v1/sessions/\" + encodeURIComponent(x.id);\n  if (![\"initializing\", \"running\", \"active\"].includes(x.status))\n    throw Error(\"Invalid Airtop session state\");\n  return {\n    windowUrl: base + \"/windows\",\n    terminateUrl: base,\n    ready: x.status === \"running\" || x.status === \"active\",\n  };\n}\n"
      },
      "n_e4e992c9883ae923": {
        "name": "Evaluate readiness",
        "imports": [],
        "source": "export default function poll({ body, previous, sessionUrl }) {\n  const count = (previous?.sessionUrl === sessionUrl ? previous.count : 0) + 1;\n  if (body?.errors?.length || ![\"initializing\", \"running\", \"active\"].includes(body?.data?.status))\n    throw Error(\"Invalid Airtop session status\");\n  if (count >= 60 && body.data.status === \"initializing\")\n    throw Error(\"Airtop session did not become ready\");\n  return { state: { count, sessionUrl }, ready: body.data.status !== \"initializing\" };\n}\n"
      },
      "n_e43d78ad730c9330": {
        "name": "Prepare profile saving",
        "imports": [],
        "source": "export default function f({ body, sessionUrl }) {\n  return { url: sessionUrl + \"/save-profile-on-termination/\" + encodeURIComponent(body.profile) };\n}\n"
      },
      "n_07477f6fae80019d": {
        "name": "Check X window",
        "imports": [],
        "source": "export default function context({ body, sessionUrl }) {\n  const id = body?.data?.windowId;\n  if (!/^[a-z0-9-]+$/i.test(id || \"\") || body?.errors?.length) throw Error(\"Invalid Airtop window\");\n  return {\n    typeUrl: sessionUrl + \"/windows/\" + id + \"/type\",\n    clickUrl: sessionUrl + \"/windows/\" + id + \"/click\",\n  };\n}\n"
      },
      "n_26cfc072867eb2bd": {
        "name": "Reserve X interaction",
        "imports": [],
        "source": "export default async function reserve({ body, acknowledge, resolution }, ctx) {\n  const submissionId = String(body?.submissionId || ctx.runId || \"\").trim();\n  if (!submissionId || !body?.profile || !body?.text) throw Error(\"Missing post\");\n  const key = \"x-post:\" + submissionId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") throw Error(\"Post already reconciled\");\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Verify X post before retrying \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      throw Error(\"Post marked confirmed; stop\");\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    request: {\n      text: body.text,\n      pressEnterKey: true,\n      elementDescription: '\"What\\'s happening?\" text box on top',\n      configuration: {},\n    },\n  };\n}\n"
      },
      "n_c86080c2c3d71917": {
        "name": "Check typing response",
        "imports": [],
        "source": "export default function f({ body }) {\n  if (!body || body.errors?.length) throw Error(\"Unknown typing result\");\n  return { ok: true };\n}\n"
      },
      "n_28c862170521c81e": {
        "name": "Check click response",
        "imports": [],
        "source": "export default function f({ body }) {\n  if (!body || body.errors?.length) throw Error(\"Unknown click result\");\n  return { ok: true };\n}\n"
      }
