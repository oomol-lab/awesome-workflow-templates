    "modules": {
      "n_515f0823c553bda3": {
        "name": "Read the business email",
        "imports": [],
        "source": "function formEmail(value) {\n  const email = typeof value === \"string\" ? value.trim().toLowerCase() : \"\";\n  if (\n    email.length > 254 ||\n    !/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$/.test(\n      email,\n    )\n  ) {\n    throw new Error(\"A business email address is required\");\n  }\n  return email;\n}\nexport default ({ body }) => ({ email: formEmail(body.Email) });\n"
      },
      "n_f8db1ee1d2c73cab": {
        "name": "Check the email verification",
        "imports": [],
        "source": "function verify({ email, result }) {\n  const status = result?.status;\n  if (typeof status !== \"string\") throw new Error(\"Hunter did not return a verification status\");\n  if (status !== \"valid\") return { valid: false };\n  if (typeof result.email !== \"string\" || result.email.toLowerCase() !== email.toLowerCase()) {\n    throw new Error(\"Hunter verification does not match the submitted email\");\n  }\n  return { valid: true };\n}\n\nexport default function check({ email, reply }) {\n  return verify({ email, result: reply.data });\n}\n"
      },
      "n_81b09b930a506746": {
        "name": "Match the person and domain",
        "imports": [],
        "source": "function matchHunterLead({ email, enrichment }) {\n  const person = enrichment?.data?.person;\n  const company = enrichment?.data?.company;\n  const domain = email.slice(email.lastIndexOf(\"@\") + 1);\n  const normalized = (value) => (typeof value === \"string\" ? value.trim().toLowerCase() : \"\");\n  const skip = { ready: false, properties: {}, filterGroups: [] };\n  if (\n    !person ||\n    !company ||\n    person.fuzzy === true ||\n    normalized(person.email) !== email ||\n    normalized(person.employment?.domain) !== domain ||\n    normalized(company.domain) !== domain\n  )\n    return skip;\n\n  const clean = (value) => (typeof value === \"string\" ? value.trim() : \"\");\n  const count = company.metrics?.employeesCount;\n  const range = clean(company.metrics?.employees);\n  const size =\n    Number.isSafeInteger(count) && count >= 0\n      ? String(count)\n      : /^\\d+(?:-\\d+|\\+)?$/.test(range)\n        ? range\n        : \"\";\n  const values = {\n    firstname: clean(person.name?.givenName),\n    lastname: clean(person.name?.familyName),\n    jobtitle: clean(person.employment?.title),\n    company: clean(person.employment?.name) || clean(company.name),\n    hunter_company_size: size,\n  };\n  const fields = Object.entries(values).filter(([, value]) => value !== \"\");\n  if (fields.length === 0) return skip;\n  return {\n    ready: true,\n    properties: { email, ...Object.fromEntries(fields) },\n    filterGroups: [{ filters: [{ propertyName: \"email\", operator: \"EQ\", value: email }] }],\n  };\n}\nexport default matchHunterLead;\n"
      },
      "n_7bf106c436fb9281": {
        "name": "Check the contact match",
        "imports": [],
        "source": "function verifyContactReceipt(record, email, expectedId) {\n  const id = record?.id;\n  if (\n    typeof id !== \"string\" ||\n    !/^[1-9]\\d*$/.test(id) ||\n    record.archived === true ||\n    (expectedId && expectedId !== \"0\" && id !== expectedId) ||\n    typeof record.properties?.email !== \"string\" ||\n    record.properties.email.toLowerCase() !== email\n  ) {\n    throw new Error(\"HubSpot did not confirm the submitted contact\");\n  }\n  return id;\n}\nfunction chooseContact({ search, email }) {\n  const records = search?.results ?? search?.records ?? search?.objects ?? search?.items;\n  if (\n    !Array.isArray(records) ||\n    records.length > 1 ||\n    search.paging?.next ||\n    search.paging?.nextAfter ||\n    (typeof search.total === \"number\" && search.total !== records.length)\n  ) {\n    throw new Error(\"HubSpot did not return a unique contact lookup\");\n  }\n  return records.length\n    ? { recordId: verifyContactReceipt(records[0], email), exists: true }\n    : { recordId: \"0\", exists: false };\n}\nexport default chooseContact;\n"
      },
      "n_5d07ddfb8a540ee8": {
        "name": "Confirm the saved contact",
        "imports": [],
        "source": "function verifyContactReceipt(record, email, expectedId) {\n  const id = record?.id;\n  if (\n    typeof id !== \"string\" ||\n    !/^[1-9]\\d*$/.test(id) ||\n    record.archived === true ||\n    (expectedId && expectedId !== \"0\" && id !== expectedId) ||\n    typeof record.properties?.email !== \"string\" ||\n    record.properties.email.toLowerCase() !== email\n  ) {\n    throw new Error(\"HubSpot did not confirm the submitted contact\");\n  }\n  return id;\n}\nexport default ({ record, email, expectedId }) => ({\n  contactId: verifyContactReceipt(record, email, expectedId),\n});\n"
      }
