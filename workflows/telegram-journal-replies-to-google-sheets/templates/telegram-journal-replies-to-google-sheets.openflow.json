    "modules": {
      "n_d3077b860751b942": {
        "name": "Check the dated journal reply",
        "imports": [],
        "source": "export default function telegramJournalReply({ body, botUsername, userUsername }) {\n  if (\n    typeof botUsername !== \"string\" ||\n    !botUsername.trim() ||\n    botUsername === \"YOUR_BOT_USERNAME\" ||\n    typeof userUsername !== \"string\" ||\n    !userUsername.trim() ||\n    userUsername === \"YOUR_USERNAME\"\n  )\n    throw new Error(\"Set the bot and user usernames without @\");\n  const message = body?.message;\n  const reply = message?.reply_to_message;\n  if (\n    !message ||\n    !reply ||\n    message.from?.username !== userUsername ||\n    reply.from?.username !== botUsername ||\n    typeof message.text !== \"string\"\n  )\n    return { accepted: false, entry: \"\", date: \"\", values: [] };\n  if (typeof reply.text !== \"string\" || !reply.text.includes(\":\"))\n    throw new Error(\"The bot prompt must contain a colon followed by the journal date\");\n  const date = reply.text.split(\":\")[1].replace(/\\s/g, \"\");\n  const entry = message.text;\n  return { accepted: true, entry, date, values: [[entry, date]] };\n}\n"
      },
      "n_aa6f1913b5cb7a62": {
        "name": "Confirm the journal entry",
        "imports": [],
        "source": "export default function telegramJournalConfirm({ entry, date, updatedRows }) {\n  if (updatedRows !== 1)\n    throw new Error(\"The sheet did not confirm one row; inspect it before replaying\");\n  return { entry, date, updatedRows };\n}\n"
      }
    }
