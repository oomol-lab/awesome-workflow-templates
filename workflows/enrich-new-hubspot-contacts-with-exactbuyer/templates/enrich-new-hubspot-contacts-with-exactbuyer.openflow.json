    "modules": {
      "n_a7fb7e76c6a45bb2": {
        "name": "Check contact creation event",
        "imports": [],
        "source": "function readCreation(body) {\n  const id = body?.contactId;\n  const contactId = typeof id === \"number\" && Number.isSafeInteger(id) ? String(id) : id;\n  if (\n    body?.event !== \"contact.creation\" ||\n    typeof contactId !== \"string\" ||\n    !/^[1-9]\\d*$/.test(contactId)\n  ) {\n    throw new Error(\"Expected a HubSpot contact.creation event with a Record ID\");\n  }\n  return { contactId };\n}\nexport default ({ body }) => readCreation(body);\n"
      },
      "n_ff85f8d1ba1655c8": {
        "name": "Prepare email lookup",
        "imports": [],
        "source": "function buildLookup({ contactId, record }) {\n  if (record?.id !== contactId || record.archived)\n    throw new Error(\"HubSpot returned a different or archived contact\");\n  const email = record.properties?.email;\n  const hasEmail = typeof email === \"string\" && /^[^\\s@]+@[^\\s@]+$/.test(email.trim());\n  const endpoint = \"https://api.exactbuyer.com/v1/enrich\";\n  const url = hasEmail\n    ? endpoint +\n      \"?email=\" +\n      encodeURIComponent(email.trim()) +\n      \"&required=work_email%2Cpersonal_email%2Cemail\"\n    : endpoint;\n  return { hasEmail, url, email: hasEmail ? email.trim() : \"\" };\n}\nexport default buildLookup;\n"
      },
      "n_08cc21d675258000": {
        "name": "Map matched contact fields",
        "imports": [],
        "source": "function mapResult({ status, body, queryEmail }) {\n  if (status === 404) return { matched: false, properties: {} };\n  if (\n    status !== 200 ||\n    !body?.result ||\n    typeof body.result !== \"object\" ||\n    Array.isArray(body.result)\n  ) {\n    throw new Error(\"ExactBuyer lookup failed (HTTP \" + status + \")\");\n  }\n  const { result } = body;\n  const normalizeEmail = (entry) => (typeof entry === \"string\" ? entry.trim().toLowerCase() : \"\");\n  const optionalList = (entry) => (Array.isArray(entry) ? entry : []);\n  const addresses = [\n    result.current_work_email,\n    ...optionalList(result.other_current_work_emails).map((entry) => entry?.work_email),\n    ...optionalList(result.personal_emails),\n  ];\n  const expected = normalizeEmail(queryEmail);\n  if (!expected || !addresses.some((address) => normalizeEmail(address) === expected)) {\n    return { matched: false, properties: {} };\n  }\n  const source = {\n    firstname: result.first_name,\n    lastname: result.last_name,\n    gender: result.gender,\n    school: result.education?.[0]?.school?.name,\n    country: result.location?.country,\n    jobtitle: result.employment?.job?.title,\n    company: result.employment?.name,\n    company_size: result.employment?.size,\n    phone: result.phone_numbers?.[0]?.E164,\n  };\n  const properties = Object.fromEntries(\n    Object.entries(source)\n      .filter(\n        ([, entry]) =>\n          (typeof entry === \"string\" && entry.trim()) ||\n          (typeof entry === \"number\" && Number.isFinite(entry)),\n      )\n      .map(([key, entry]) => [key, String(entry).trim()]),\n  );\n  return { matched: Object.keys(properties).length > 0, properties };\n}\nexport default mapResult;\n"
      },
      "n_878c8dda5af1222d": {
        "name": "Confirm the updated contact ID",
        "imports": [],
        "source": "function confirmUpdate({ contactId, record }) {\n  if (record?.id !== contactId || record.archived)\n    throw new Error(\"HubSpot did not confirm the requested contact update\");\n  return { contactId };\n}\nexport default confirmUpdate;\n"
      }
    },
