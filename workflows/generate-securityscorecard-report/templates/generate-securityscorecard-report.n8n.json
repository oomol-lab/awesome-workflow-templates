{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "generate-securityscorecard-report-0"
    },
    {
      "name": "Set scorecard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function input({ identifier }) {\n  if (typeof identifier !== \"string\" || !identifier.trim())\n    throw Error(\"Enter a scorecard domain or ID\");\n  return { identifier: identifier.trim(), body: { scorecard_identifier: identifier.trim() } };\n}\n\nreturn [{ json: input({ identifier: \"\" }) }];\n"
      },
      "id": "generate-securityscorecard-report-1"
    },
    {
      "name": "Request report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.securityscorecard.io/reports/full-scorecard-json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "generate-securityscorecard-report-2"
    },
    {
      "name": "Read report ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function created({ body, statusCode, bodyEncoding }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    typeof body?.id !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.id)\n  )\n    throw Error(\"Report request not confirmed\");\n  return { id: body.id };\n}\n\nconst r = $input.first().json;\nreturn [{ json: created({ body: r.body, statusCode: r.statusCode, bodyEncoding: null }) }];\n"
      },
      "id": "generate-securityscorecard-report-3"
    },
    {
      "name": "Wait for report",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      },
      "id": "generate-securityscorecard-report-4"
    },
    {
      "name": "Read recent reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://api.securityscorecard.io/reports/recent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "generate-securityscorecard-report-5"
    },
    {
      "name": "Find requested report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function poll({ body, statusCode, bodyEncoding, id, previous }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body)\n  )\n    throw Error(\"Invalid recent reports response\");\n  const entries = body.entries ?? [];\n  if (!Array.isArray(entries)) throw Error(\"Invalid recent reports\");\n  const matches = entries.filter((x) => x?.id === id);\n  if (matches.length > 1) throw Error(\"Duplicate report ID\");\n  const url = matches[0]?.download_url,\n    count = (previous?.count ?? 0) + 1;\n  if (url != null && url !== \"\") {\n    if (\n      typeof url !== \"string\" ||\n      !/^https:\\/\\/api\\.securityscorecard\\.io\\/reports\\/files\\/[^\\s#\\\\]+$/.test(url) ||\n      /%2e|%5c/i.test(url.split(\"?\")[0]) ||\n      url.split(\"?\")[0].includes(\"..\")\n    )\n      throw Error(\"Unexpected report URL\");\n    return { state: { count }, done: true, url };\n  }\n  if (count >= 60) throw Error(\"Report not available after 60 checks\");\n  return { state: { count }, done: false, url: \"\" };\n}\n\nconst r = $input.first().json;\nreturn [\n  {\n    json: poll({\n      body: r.body,\n      statusCode: r.statusCode,\n      bodyEncoding: null,\n      id: $(\"Read report ID\").first().json.id,\n      previous: { count: $runIndex },\n    }),\n  },\n];\n"
      },
      "id": "generate-securityscorecard-report-6"
    },
    {
      "name": "Report ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ready",
              "leftValue": "={{ $json.done }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "generate-securityscorecard-report-7"
    },
    {
      "name": "SecurityScorecard2",
      "type": "n8n-nodes-base.securityScorecard",
      "position": [
        850,
        300
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "resource": "report",
        "operation": "download"
      },
      "typeVersion": 1,
      "id": "generate-securityscorecard-report-8"
    }
  ],
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set scorecard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set scorecard": {
      "main": [
        [
          {
            "node": "Request report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request report": {
      "main": [
        [
          {
            "node": "Read report ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read report ID": {
      "main": [
        [
          {
            "node": "Wait for report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for report": {
      "main": [
        [
          {
            "node": "Read recent reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read recent reports": {
      "main": [
        [
          {
            "node": "Find requested report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find requested report": {
      "main": [
        [
          {
            "node": "Report ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report ready?": {
      "main": [
        [
          {
            "node": "SecurityScorecard2",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Generate a SecurityScorecard Report",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
