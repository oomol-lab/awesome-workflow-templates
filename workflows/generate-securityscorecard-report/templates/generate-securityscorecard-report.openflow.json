    "modules": {
      "n_bc100521ae3440b4": {
        "name": "Prepare report request",
        "imports": [],
        "source": "export default function input({ identifier }) {\n  if (typeof identifier !== \"string\" || !identifier.trim())\n    throw Error(\"Enter a scorecard domain or ID\");\n  return { identifier: identifier.trim(), body: { scorecard_identifier: identifier.trim() } };\n}\n"
      },
      "n_2b3c3f239c5b3d5a": {
        "name": "Read report ID",
        "imports": [],
        "source": "export default function created({ body, statusCode, bodyEncoding }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    typeof body?.id !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.id)\n  )\n    throw Error(\"Report request not confirmed\");\n  return { id: body.id };\n}\n"
      },
      "n_fb6df6721bea4d2a": {
        "name": "Find requested report",
        "imports": [],
        "source": "export default function poll({ body, statusCode, bodyEncoding, id, previous }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body)\n  )\n    throw Error(\"Invalid recent reports response\");\n  const entries = body.entries ?? [];\n  if (!Array.isArray(entries)) throw Error(\"Invalid recent reports\");\n  const matches = entries.filter((x) => x?.id === id);\n  if (matches.length > 1) throw Error(\"Duplicate report ID\");\n  const url = matches[0]?.download_url,\n    count = (previous?.count ?? 0) + 1;\n  if (url != null && url !== \"\") {\n    if (\n      typeof url !== \"string\" ||\n      !/^https:\\/\\/api\\.securityscorecard\\.io\\/reports\\/files\\/[^\\s#\\\\]+$/.test(url) ||\n      /%2e|%5c/i.test(url.split(\"?\")[0]) ||\n      url.split(\"?\")[0].includes(\"..\")\n    )\n      throw Error(\"Unexpected report URL\");\n    return { state: { count }, done: true, url };\n  }\n  if (count >= 60) throw Error(\"Report not available after 60 checks\");\n  return { state: { count }, done: false, url: \"\" };\n}\n"
      },
      "n_7b94856e0d5a04bc": {
        "name": "Confirm download",
        "imports": [],
        "source": "export default function result({ statusCode }) {\n  if (statusCode < 200 || statusCode >= 300) throw Error(\"Report download failed\");\n  return { ok: true };\n}\n"
      }
    }
