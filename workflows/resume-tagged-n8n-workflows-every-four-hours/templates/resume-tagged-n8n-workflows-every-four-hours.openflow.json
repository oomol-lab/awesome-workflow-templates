    "modules": {
      "n_ca3231242832c771": {
        "name": "Select workflow page",
        "imports": [],
        "source": "export default function page({ cursor }) {\n  return { cursor: cursor || null };\n}\n"
      },
      "n_d4c3707b54115512": {
        "name": "Find inactive workflow",
        "imports": [],
        "source": "export default function next({ workflows, cursor, nextCursor, previous }) {\n  let index = previous?.cursor === cursor ? previous.index : 0;\n  while (index < workflows.length && workflows[index].active !== false) index++;\n  if (index < workflows.length)\n    return {\n      state: { cursor, index: index + 1 },\n      found: true,\n      workflowId: workflows[index].id,\n      hasNext: false,\n      nextCursor: \"\",\n    };\n  return {\n    state: { cursor, index },\n    found: false,\n    workflowId: \"unused\",\n    hasNext: !!nextCursor,\n    nextCursor: nextCursor ?? \"\",\n  };\n}\n"
      }
    }
