    "modules": {
      "n_c643582a8249c679": {
        "name": "Find new rows",
        "imports": [],
        "source": "export default async function plan({values,chatId},context){\n  if(!chatId || chatId.startsWith('YOUR_')) throw new Error('Set the Mattermost channel ID');\n  if(!Array.isArray(values)) throw new Error('Expected sheet rows');\n  const old=await context.state.get('sheet-ids'),ids=old===null?[]:old;\n  if(!Array.isArray(ids)) throw new Error('Invalid saved sheet state');\n  if(!values.length)return {rows:[],ids,chatId};\n  const headers=values[0],names=['ID','Name','Email'],indexes=names.map(n=>headers.indexOf(n));\n  const data=values.slice(1).filter(r=>r.some((_,i)=>Boolean(headers[i])));\n  if(!data.length)return {rows:[],ids,chatId};\n  if(indexes.some((i,j)=>i<0 || headers.lastIndexOf(names[j])!==i)) throw new Error('Sheet needs unique ID, Name and Email headers');\n  const rows=data.map(r=>({id:r[indexes[0]],name:r[indexes[1]]??null,email:r[indexes[2]]??null})),selected=[];\n  for(let i=rows.length-1;i>=0;i--){if(ids.includes(rows[i].id))break;selected.push(rows[i]);}\n  if(rows.some(r=>r.id===undefined || r.id===null || r.id==='')) throw new Error('Every row needs an ID');\n  const current=rows.map(r=>r.id);\n  await context.state.set('sheet-ids',current);\n  return {rows:selected,ids:current,chatId};\n}\n"
      },
      "n_4abd3fb9bf08d82f": {
        "name": "Prepare next notice",
        "imports": [],
        "source": "export default function next({rows,chatId,previousState}){\n const index=previousState===null?0:previousState.index+1;\n if(index>=rows.length)return {state:{index},more:false,channelId:chatId,text:'-',count:rows.length};\n const row=rows[index],v=x=>x==null?'undefined':String(x);\n return {state:{index},more:true,channelId:chatId,text:`New information was added to your Google Sheet.\\nID: ${v(row.id)}\\nName: ${v(row.name)}\\nEmail: ${v(row.email)}`,count:rows.length};\n}\n"
      }
    }
