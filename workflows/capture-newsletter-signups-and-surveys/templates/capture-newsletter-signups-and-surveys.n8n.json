        "mode": "runOnceForEachItem",
        "jsCode": "const email = String($json.Email ?? \"\")\n  .trim()\n  .toLowerCase();\nif (!email) throw Error(\"Missing email\");\nreturn {\n  json: {\n    submissionId: $execution.id,\n    email,\n    date: String($json.submittedAt ?? new Date().toISOString()),\n    mode: \"direct\",\n  },\n};\n"
      },
