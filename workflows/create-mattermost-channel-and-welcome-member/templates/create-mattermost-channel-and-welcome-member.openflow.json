    "modules": {
      "n_3946fb80f1841793": {
        "name": "Choose team, user and channel",
        "imports": [],
        "source": "export default function mattermostChannelPlan(input) {\n  const text = (value, label) => { if (typeof value !== 'string' || !value.trim() || value.trim().startsWith('YOUR_')) throw new Error('Set ' + label); return value.trim(); };\n  const id = (value, label) => { const result = text(value, label); if (!/^[a-z0-9]{26}$/.test(result)) throw new Error(label + ' must be a 26-character Mattermost ID'); return result; };\n  const teamId = id(input.teamId, 'teamId'), userId = id(input.userId, 'userId'), channelName = text(input.channelName, 'channelName'), displayName = text(input.displayName, 'displayName'), message = text(input.message, 'message');\n  return { createBody: { team_id: teamId, name: channelName, display_name: displayName, type: 'O' }, userId, message };\n}\n"
      },
      "n_fdab896882491641": {
        "name": "Confirm the new channel",
        "imports": [],
        "source": "export default function mattermostChannelReceipt(input) {\n  const succeeded = input.httpSucceeded === true || (Number.isInteger(input.statusCode) && input.statusCode >= 200 && input.statusCode < 300);\n  if (!succeeded || !input.channel || typeof input.channel !== 'object' || Array.isArray(input.channel)) throw new Error('Channel creation was not confirmed. It may already have created a channel; inspect Mattermost before replaying.');\n  const channel = input.channel, expected = input.createBody;\n  if (typeof channel.id !== 'string' || !/^[a-z0-9]{26}$/.test(channel.id) || channel.team_id !== expected.team_id || channel.name !== expected.name || channel.display_name !== expected.display_name || channel.type !== 'O') throw new Error('Unexpected created channel. It may already exist; inspect Mattermost before replaying.');\n  return { channel, channelId: channel.id, memberEndpoint: '/channels/' + encodeURIComponent(channel.id) + '/members', memberBody: { user_id: input.userId }, message: input.message };\n}\n"
      },
      "n_060e701f59487807": {
        "name": "Confirm channel membership",
        "imports": [],
        "source": "export default function mattermostMemberReceipt(input) {\n  const membership = input.membership;\n  const succeeded = input.httpSucceeded === true || (Number.isInteger(input.statusCode) && input.statusCode >= 200 && input.statusCode < 300);\n  if (!succeeded || !membership || typeof membership !== 'object' || Array.isArray(membership) || membership.channel_id !== input.channel.id || membership.user_id !== input.userId) throw new Error('Channel membership was not confirmed. The channel/member may already have changed; inspect Mattermost before replaying.');\n  return { channel: input.channel, membership, channelId: input.channel.id, message: input.message };\n}\n"
      },
      "n_4c635c4fc181023d": {
        "name": "Keep the complete API results",
        "imports": [],
        "source": "export default function mattermostOnboardingResult(input) {\n  const post = input.post;\n  if (!post || typeof post !== 'object' || Array.isArray(post) || typeof post.id !== 'string' || !/^[a-z0-9]{26}$/.test(post.id) || post.channel_id !== input.channel.id || post.message !== input.message) throw new Error('Welcome post was not confirmed. The channel, membership and post may already exist; inspect Mattermost before replaying.');\n  return { channel: input.channel, membership: input.membership, post, rawPost: input.rawPost };\n}\n"
