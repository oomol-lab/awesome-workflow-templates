        "source": "export default function mattermostOnboardingResult(input) {\n  const post = input.post;\n  if (\n    !post ||\n    typeof post !== \"object\" ||\n    Array.isArray(post) ||\n    typeof post.id !== \"string\" ||\n    !/^[a-z0-9]{26}$/.test(post.id) ||\n    post.channel_id !== input.channel.id ||\n    post.message !== input.message\n  )\n    throw new Error(\n      \"Welcome post was not confirmed. The channel, membership and post may already exist; inspect Mattermost before replaying.\",\n    );\n  return { channel: input.channel, membership: input.membership, post, rawPost: input.rawPost };\n}\n"
