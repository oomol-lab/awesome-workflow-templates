    "modules": {
      "n_3946fb80f1841793": {
        "name": "Choose team, user and channel",
        "imports": [],
        "source": "export default function mattermostChannelPlan(input) {\n  const text = (value, label) => {\n    if (typeof value !== \"string\" || !value.trim() || value.trim().startsWith(\"YOUR_\"))\n      throw new Error(\"Set \" + label);\n    return value.trim();\n  };\n  const id = (value, label) => {\n    const result = text(value, label);\n    if (!/^[a-z0-9]{26}$/.test(result))\n      throw new Error(label + \" must be a 26-character Mattermost ID\");\n    return result;\n  };\n  const teamId = id(input.teamId, \"teamId\"),\n    userId = id(input.userId, \"userId\"),\n    channelName = text(input.channelName, \"channelName\"),\n    displayName = text(input.displayName, \"displayName\"),\n    message = text(input.message, \"message\");\n  return {\n    createBody: { team_id: teamId, name: channelName, display_name: displayName, type: \"O\" },\n    userId,\n    message,\n  };\n}\n"
      },
      "n_fdab896882491641": {
        "name": "Confirm the new channel",
        "imports": [],
        "source": "export default function mattermostChannelReceipt(input) {\n  const succeeded =\n    input.httpSucceeded === true ||\n    (Number.isInteger(input.statusCode) && input.statusCode >= 200 && input.statusCode < 300);\n  if (\n    !succeeded ||\n    !input.channel ||\n    typeof input.channel !== \"object\" ||\n    Array.isArray(input.channel)\n  )\n    throw new Error(\n      \"Channel creation was not confirmed. It may already have created a channel; inspect Mattermost before replaying.\",\n    );\n  const channel = input.channel,\n    expected = input.createBody;\n  if (\n    typeof channel.id !== \"string\" ||\n    !/^[a-z0-9]{26}$/.test(channel.id) ||\n    channel.team_id !== expected.team_id ||\n    channel.name !== expected.name ||\n    channel.display_name !== expected.display_name ||\n    channel.type !== \"O\"\n  )\n    throw new Error(\n      \"Unexpected created channel. It may already exist; inspect Mattermost before replaying.\",\n    );\n  return {\n    channel,\n    channelId: channel.id,\n    memberEndpoint: \"/channels/\" + encodeURIComponent(channel.id) + \"/members\",\n    memberBody: { user_id: input.userId },\n    message: input.message,\n  };\n}\n"
      },
      "n_060e701f59487807": {
        "name": "Confirm channel membership",
        "imports": [],
        "source": "export default function mattermostMemberReceipt(input) {\n  const membership = input.membership;\n  const succeeded =\n    input.httpSucceeded === true ||\n    (Number.isInteger(input.statusCode) && input.statusCode >= 200 && input.statusCode < 300);\n  if (\n    !succeeded ||\n    !membership ||\n    typeof membership !== \"object\" ||\n    Array.isArray(membership) ||\n    membership.channel_id !== input.channel.id ||\n    membership.user_id !== input.userId\n  )\n    throw new Error(\n      \"Channel membership was not confirmed. The channel/member may already have changed; inspect Mattermost before replaying.\",\n    );\n  return {\n    channel: input.channel,\n    membership,\n    channelId: input.channel.id,\n    message: input.message,\n  };\n}\n"
