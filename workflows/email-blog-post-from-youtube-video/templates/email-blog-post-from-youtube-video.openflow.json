    "modules": {
      "n_d7989b534934781c": {
        "name": "Check the transcript",
        "imports": [],
        "source": "export default function transcript({ body, statusCode }) {\n  if (statusCode !== 200 || typeof body?.transcript !== \"string\" || !body.transcript.trim())\n    throw Error(\"Transcript unavailable\");\n  return { text: body.transcript };\n}\n"
      },
      "n_cf2d505d18c05312": {
        "name": "Validate the blog draft",
        "imports": [],
        "source": "export default function blog({ result }) {\n  let x;\n  try {\n    x = JSON.parse(result);\n  } catch {\n    throw Error(\"Invalid blog JSON\");\n  }\n  for (const k of [\"title\", \"blogImagePrompt\", \"description\", \"content\"])\n    if (typeof x[k] !== \"string\" || !x[k].trim()) throw Error(\"Missing blog field: \" + k);\n  return {\n    body: { model: \"FLUX.1-dev\", input: { prompt: x.blogImagePrompt } },\n    subject: x.title,\n    text: \"Description: \" + x.description + \"\\n\\nContent:\\n\" + x.content,\n  };\n}\n"
      },
      "n_7e9038de94cba32f": {
        "name": "Check the generated image URL",
        "imports": [],
        "source": "export default function image({ body, statusCode }) {\n  if (\n    statusCode !== 200 ||\n    !Array.isArray(body?.images) ||\n    typeof body.images[0]?.url !== \"string\" ||\n    !body.images[0].url.startsWith(\"https://\")\n  )\n    throw Error(\"Image generation failed\");\n  return { url: body.images[0].url };\n}\n"
      },
      "n_8ae3c5b685987cd7": {
        "name": "Email the draft and image",
        "imports": [],
        "source": "export default async function send({ to, subject, text, url }, context) {\n  const result = await context.actions.call(\"gmail.send_email\", {\n    to,\n    subject,\n    body: text,\n    isHtml: false,\n    attachments: [{ filename: \"blog-image\", fileUrl: url }],\n  });\n  return { messageId: result.messageId };\n}\n"
      }
    }
