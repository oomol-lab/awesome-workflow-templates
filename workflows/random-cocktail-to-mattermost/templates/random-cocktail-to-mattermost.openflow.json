      "n_7304d1e05926d882": {
        "name": "Prepare cocktail message",
        "imports": [],
        "source": "export default function cocktailNotice({body,request}){\n const d=body?.drinks?.[0],id=request?.channel_id;\n if(typeof id!=='string'||!id.trim())throw Error('Webhook needs channel_id');\n if(!d||[d.strDrink,d.strInstructions,d.strGlass,d.strDrinkThumb].some(x=>typeof x!=='string'||!x))throw Error('Cocktail response lacks required fields');\n return{channelId:id,message:`Why not try ${d.strDrink}?\\n${d.strInstructions} Serve in ${d.strGlass}.`,props:{attachments:[{image_url:d.strDrinkThumb}]}};\n}\n"
      }
