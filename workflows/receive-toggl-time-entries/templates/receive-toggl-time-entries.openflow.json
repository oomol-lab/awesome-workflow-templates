    "modules": {
      "n_a1ff1fce52dd4f6b": {
        "name": "Prepare time window",
        "imports": [],
        "source": "export default async function window({ recoveryEnd }, context) {\n  const now = new Date().toISOString(),\n    start = (await context.state.get(\"toggl-last-checked\")) ?? now.slice(0, 10),\n    end = recoveryEnd ? new Date(recoveryEnd).toISOString() : now;\n  if (Date.parse(end) <= Date.parse(start) || Date.parse(end) > Date.parse(now))\n    throw Error(\"Recovery end must follow the cursor and not be in the future\");\n  const url = new URL(\"https://api.track.toggl.com/api/v9/me/time_entries\");\n  url.searchParams.set(\"start_date\", start);\n  url.searchParams.set(\"end_date\", end);\n  return { url: url.toString(), end, password: \"api_token\" };\n}\n"
      },
      "n_172d924e51a5cc98": {
        "name": "Save cursor and return entries",
        "imports": [],
        "source": "export default async function save({ entries, end }, context) {\n  if (!Array.isArray(entries)) throw Error(\"Toggl did not return an array\");\n  if (entries.length >= 1000)\n    throw Error(\n      \"Toggl may have truncated the 1000-entry window; shorten the interval or recover entries before advancing\",\n    );\n  await context.state.set(\"toggl-last-checked\", end);\n  return { entries };\n}\n"
      }
    }
