        "name": "Format temperature",
        "imports": [],
        "source": "export default function weatherMessage({ weather }) {\n  if (\n    weather?.cod !== 200 ||\n    typeof weather?.main?.temp !== \"number\" ||\n    !Number.isFinite(weather.main.temp)\n  )\n    throw Error(\"OpenWeather response has no current temperature\");\n  return { message: `Hey! The temperature outside is ${weather.main.temp}°C.` };\n}\n"
