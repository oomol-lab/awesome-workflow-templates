    "modules": {
      "n_487862944f677cd9": {
        "name": "Read latest releases",
        "imports": [],
        "source": "export default async function readReleases({ repositories }, context) {\n  const releases = [];\n  for (const { owner, repo } of repositories) {\n    const release = await context.actions.github.get_latest_release({ owner, repo });\n    releases.push({ owner, repo, release });\n  }\n  return { releases };\n}\n"
      },
      "n_d4725e82691f40fa": {
        "name": "Select releases from last day",
        "imports": [],
        "source": "export default function recentReleases({ releases }) {\n  const cutoff = Date.now() - 24 * 60 * 60 * 1000;\n  const escape = (value) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const notifications = [];\n  for (const [index, { owner, repo, release }] of releases.entries()) {\n    const published = typeof release.published_at === 'string' ? Date.parse(release.published_at) : NaN;\n    if (!Number.isFinite(published)) throw new Error('Release is missing a valid publication timestamp');\n    if (!(published > cutoff)) continue;\n    const name = release.name || release.tag_name;\n    if (typeof name !== 'string' || !name || typeof release.html_url !== 'string' || !release.html_url) throw new Error('Release is missing its name or URL');\n    const body = release.body ?? '';\n    if (typeof body !== 'string') throw new Error('Release body must be text or null');\n    notifications.push({\n      text: `:tada: New release for *${escape(owner + '/' + repo)}* - ${escape(name)}\\n\\n${escape(body.slice(0, 500))}\\n\\n${release.html_url}`,\n      sourceIndex: index,\n    });\n  }\n  return { notifications, count: notifications.length };\n}\n"
      },
      "n_01c9650c72dba164": {
        "name": "Send release alerts",
        "imports": [],
        "source": "export default async function sendReleaseAlerts({ notifications, channelId }, context) {\n  const sent = [];\n  for (const { text } of notifications) {\n    sent.push(await context.actions.slack.post_message({ channelId, text }));\n  }\n  return { sent, count: sent.length };\n}\n"
      }
    }
