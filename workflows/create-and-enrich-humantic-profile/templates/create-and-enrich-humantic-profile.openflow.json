    "modules": {
      "n_7dc431f614024d28": {
        "name": "Validate profile inputs",
        "imports": [],
        "source": "export default function ({ profileUrl, resumeUrl, requestId }) {\n  if (\n    !/^https:\\/\\/www\\.linkedin\\.com\\/in\\/[^/?#]+\\/?$/i.test(profileUrl) ||\n    !/^https:\\/\\//i.test(resumeUrl) ||\n    !requestId.trim()\n  )\n    throw Error(\"Provide a LinkedIn profile, HTTPS resume URL, and unique request ID\");\n  return { id: profileUrl, resumeUrl, key: \"humantic:\" + requestId };\n}\n"
      },
      "n_aa1e874f72f8fa28": {
        "name": "Reserve profile creation",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  if (await ctx.state.get(key))\n    throw Error(\"Inspect existing profile request before retry: \" + key);\n  await ctx.state.set(key, { stage: \"create-pending\" });\n  return { ok: true };\n}\n"
      },
      "n_8eb616468bba8adb": {
        "name": "Confirm profile and reserve update",
        "imports": [],
        "source": "export default async function ({ key, id, resumeUrl, body }, ctx) {\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    !body.metadata ||\n    body.metadata.status === \"ERROR\" ||\n    (body.results?.userid && body.results.userid !== id)\n  )\n    throw Error(\"Unknown or mismatched create outcome; inspect Humantic\");\n  await ctx.state.set(key, { stage: \"update-pending\", id });\n  return { relay: { id, resumeUrl } };\n}\n"
      },
      "n_af3e4f94395e28d7": {
        "name": "Confirm resume update",
        "imports": [],
        "source": "export default async function ({ key, id, body }, ctx) {\n  if (\n    !body ||\n    body.id !== id ||\n    !body.response?.metadata ||\n    body.response.metadata.status === \"ERROR\"\n  )\n    throw Error(\"Unknown update outcome; inspect Humantic\");\n  await ctx.state.set(key, { stage: \"updated\", id });\n  return { id };\n}\n"
      }
    }
  },
