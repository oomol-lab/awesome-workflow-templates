    "modules": {
      "n_850db4ec775c848a": {
        "name": "Select completed video",
        "imports": [],
        "source": "export default function select({ body }) {\n  if (!body || typeof body !== \"object\") throw Error(\"Invalid callback\");\n  const assets = body.assets ?? {},\n    video = assets.video;\n  if (!video) return { ready: false, id: \"\", video: \"\", thumb: \"\" };\n  if (typeof body.id !== \"string\" || !body.id || typeof video !== \"string\")\n    throw Error(\"Invalid generation\");\n  return {\n    ready: true,\n    id: body.id,\n    video,\n    thumb: typeof assets.image === \"string\" ? assets.image : \"\",\n  };\n}\n"
      },
      "n_29fabf7aa6156315": {
        "name": "Find generation record",
        "imports": [],
        "source": "export default async function find({ id, video, thumb, baseId, table }, context) {\n  if (!baseId || baseId.startsWith(\"YOUR_\") || !table || table.startsWith(\"YOUR_\"))\n    throw Error(\"Configure Airtable\");\n  const escaped = id.replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\");\n  const data = await context.actions.call(\"airtable.list_records\", {\n    baseId,\n    tableIdOrName: table,\n    filterByFormula: \"{Generation ID}='\" + escaped + \"'\",\n    maxRecords: 1,\n  });\n  if (!Array.isArray(data.records)) throw Error(\"Invalid Airtable response\");\n  if (!data.records.length) throw Error(\"No matching generation record\");\n  const r = data.records[0];\n  if (!r.id || r.fields?.[\"Generation ID\"] !== id) throw Error(\"Mismatched generation\");\n  return {\n    records: [{ id: r.id, fields: { Status: \"Done\", \"Video URL\": video, \"Thumb URL\": thumb } }],\n  };\n}\n"
      }
