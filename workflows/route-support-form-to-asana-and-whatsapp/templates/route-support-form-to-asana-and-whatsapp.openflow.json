    "modules": {
      "n_67f4431f9a1f9cb5": {
        "name": "Read support request",
        "imports": [],
        "source": "export default function input({ response }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers)) throw Error(\"Expected Typeform response\");\n  function value(title) {\n    const f = fields.filter((x) => x.title === title);\n    if (f.length !== 1) throw Error(\"Missing form field \" + title);\n    const a = answers.filter((x) => x.field?.id === f[0].id);\n    if (a.length !== 1) throw Error(\"Missing answer \" + title);\n    return a[0][a[0].type];\n  }\n  const name = value(\"What is your name?\"),\n    phone = value(\"What is your phone number?\"),\n    problem = value(\"What is your problem?\");\n  if (\n    typeof name !== \"string\" ||\n    !name ||\n    typeof phone !== \"string\" ||\n    !phone ||\n    typeof problem !== \"string\" ||\n    !problem ||\n    typeof response.submitted_at !== \"string\"\n  )\n    throw Error(\"Invalid form answers\");\n  if (name.length > 3900) throw Error(\"Name too long for WhatsApp\");\n  return {\n    phone: phone.replace(/^\\+/, \"\"),\n    problem,\n    taskName: \"Support Ticket -  \" + response.submitted_at,\n    message:\n      \"Hello \" +\n      name +\n      \",\\n\\nThank you for filling out the contact form.\\nOur customer support team will get back to you as soon as possible.\",\n  };\n}\n"
      }
    }
  },
