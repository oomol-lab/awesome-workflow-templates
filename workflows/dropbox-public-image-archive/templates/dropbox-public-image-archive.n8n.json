{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        50,
        200
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "dropbox-public-image-archive-0"
    },
    {
      "name": "Dropbox",
      "type": "n8n-nodes-base.dropbox",
      "position": [
        250,
        200
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "folder",
        "operation": "create",
        "path": "/n8n"
      },
      "typeVersion": 1,
      "id": "dropbox-public-image-archive-1"
    },
    {
      "name": "Dropbox1",
      "type": "n8n-nodes-base.dropbox",
      "position": [
        650,
        200
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "file",
        "operation": "upload",
        "path": "={{ $node[\"Dropbox\"].parameter.path + \"/file.png\" }}",
        "binaryData": true,
        "binaryPropertyName": "data"
      },
      "typeVersion": 1,
      "id": "dropbox-public-image-archive-2"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        450,
        200
      ],
      "parameters": {
        "authentication": "none",
        "requestMethod": "GET",
        "url": "https://n8n.io/n8n-logo.png",
        "responseFormat": "file",
        "dataPropertyName": "data",
        "options": {}
      },
      "typeVersion": 1,
      "id": "dropbox-public-image-archive-3"
    },
    {
      "name": "Dropbox2",
      "type": "n8n-nodes-base.dropbox",
      "position": [
        850,
        200
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "folder",
        "operation": "list",
        "path": "={{ $node[\"Dropbox\"].parameter.path }}",
        "returnAll": false,
        "limit": 100,
        "filters": {}
      },
      "typeVersion": 1,
      "id": "dropbox-public-image-archive-4"
    }
  ],
  "connections": {
    "Dropbox": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dropbox1": {
      "main": [
        [
          {
            "node": "Dropbox2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Dropbox1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Dropbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Dropbox Public Image Archive",
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "active": false,
  "pinData": {}
}
