    "modules": {
      "n_633564d370b2d38a": {
        "name": "Validate the title and fixed site",
        "imports": [],
        "source": "function planBuild(body, siteId, enabled) {\n  if (!enabled || typeof siteId !== \"string\" || !/^[a-z0-9-]{8,80}$/i.test(siteId)) {\n    return {\n      ready: false,\n      siteId: \"\",\n      title: \"\",\n      status: 503,\n      body: {\n        error: \"Configure the Netlify site and webhook authentication before enabling builds.\",\n      },\n    };\n  }\n  const title = typeof body?.data?.title === \"string\" ? body.data.title.trim() : \"\";\n  if (!title || title.length > 200 || /[\\u0000-\\u001f\\u007f]/.test(title)) {\n    return {\n      ready: false,\n      siteId: \"\",\n      title: \"\",\n      status: 400,\n      body: { error: \"Send data.title with 1–200 characters on one line.\" },\n    };\n  }\n  return { ready: true, siteId, title };\n}\nexport default ({ body, siteId, enableBuilds }) => {\n  const plan = planBuild(body, siteId, enableBuilds);\n  return { plan, ready: plan.ready };\n};\n"
      },
      "n_0df83d6717e55a34": {
        "name": "Use the validated site and title",
        "imports": [],
        "source": "export default ({ plan }) => ({ siteId: plan.siteId, title: plan.title });\n"
      },
      "n_30d78554555e6130": {
        "name": "Check the Netlify receipt",
        "imports": [],
        "source": "function buildReceipt(build, siteId, title) {\n  const validId = (id) => typeof id === \"string\" && /^[a-z0-9_-]{1,128}$/i.test(id);\n  if (\n    !validId(build?.id) ||\n    !validId(build?.deploy_id) ||\n    (build.site_id != null && build.site_id !== siteId)\n  ) {\n    return {\n      status: 502,\n      body: {\n        error: \"Netlify did not confirm the build. Check the site before repeating the request.\",\n      },\n    };\n  }\n  return { status: 202, body: { siteId, title, buildId: build.id, deployId: build.deploy_id } };\n}\nexport default ({ build, siteId, title }) => buildReceipt(build, siteId, title);\n"
      },
      "n_4ff058e0bbbf883b": {
        "name": "Return the request error",
        "imports": [],
        "source": "export default ({ plan }) => ({ status: plan.status, body: plan.body });\n"
      }
    },
