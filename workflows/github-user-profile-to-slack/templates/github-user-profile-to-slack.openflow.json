      "n_9d576838a4cf7893": {
        "name": "Prepare the bounded GitHub query",
        "imports": [],
        "source": "export default function githubUserQuery({ body }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body))\n    throw new Error(\"Expected a JSON object containing text and channel_id\");\n  const username = body.text,\n    channelId = body.channel_id;\n  if (typeof username !== \"string\" || !/^[a-z\\d](?:[a-z\\d-]{0,37}[a-z\\d])?$/i.test(username))\n    throw new Error(\"text must be one GitHub username, without whitespace\");\n  if (typeof channelId !== \"string\" || !/^[CDG][A-Z0-9]{2,31}$/.test(channelId))\n    throw new Error(\n      \"channel_id must identify a Slack conversation accessible to the selected connection\",\n    );\n  const query =\n    \"query LookupGitHubUser($login: String!) { user(login: $login) { name company location avatarUrl email pullRequests(last: 25) { edges { node { commits(last: 25) { nodes { commit { author { email name } } } } } } } } }\";\n  return {\n    username,\n    channelId,\n    request: { query, variables: { login: username }, operationName: \"LookupGitHubUser\" },\n  };\n}\n"
      },
      "n_2014401874d96597": {
        "name": "Collect the matching profile emails",
        "imports": [],
        "source": "export default function githubUserProfile({ body, statusCode, bodyEncoding, username }) {\n  if (!Number.isInteger(statusCode) || statusCode < 200 || statusCode >= 300)\n    throw new Error(\"GitHub profile query failed with HTTP \" + statusCode);\n  if (bodyEncoding != null || !body || typeof body !== \"object\" || Array.isArray(body))\n    throw new Error(\"Expected a JSON GitHub GraphQL response\");\n  if (body.errors != null && (!Array.isArray(body.errors) || body.errors.length))\n    throw new Error(\"GitHub returned GraphQL errors; partial profile data is not posted\");\n  const profile = body.data?.user;\n  if (!profile || typeof profile !== \"object\" || Array.isArray(profile))\n    throw new Error(\"GitHub did not return the requested user\");\n  for (const key of [\"name\", \"company\", \"location\"])\n    if (profile[key] != null && typeof profile[key] !== \"string\")\n      throw new Error(\"Invalid GitHub profile \" + key);\n  if (\n    typeof profile.email !== \"string\" ||\n    typeof profile.avatarUrl !== \"string\" ||\n    !/^https:\\/\\/[^\\s/?#@<>\"'\\\\]+(?:[/?#][^\\s<>\"'\\\\]*)?$/.test(profile.avatarUrl)\n  )\n    throw new Error(\"Invalid GitHub profile email or avatar URL\");\n  const edges = profile.pullRequests?.edges;\n  if (!Array.isArray(edges) || edges.length > 25)\n    throw new Error(\"Expected at most 25 pull requests\");\n  const candidates = profile.email ? [profile.email] : [];\n  let commitsScanned = 0;\n  for (const edge of edges) {\n    const nodes = edge?.node?.commits?.nodes;\n    if (!Array.isArray(nodes) || nodes.length > 25)\n      throw new Error(\"Expected at most 25 commits per pull request\");\n    for (const node of nodes) {\n      commitsScanned++;\n      if (!node?.commit || typeof node.commit !== \"object\")\n        throw new Error(\"Invalid GitHub pull-request commit\");\n      const author = node.commit.author;\n      if (author == null) continue;\n      if (\n        typeof author !== \"object\" ||\n        (author.name != null && typeof author.name !== \"string\") ||\n        (author.email != null && typeof author.email !== \"string\")\n      )\n        throw new Error(\"Invalid GitHub commit author\");\n      const matches =\n        typeof author.name === \"string\" &&\n        ((typeof profile.name === \"string\" &&\n          profile.name.length > 0 &&\n          author.name.includes(profile.name)) ||\n          author.name === username);\n      if (matches && author.email) candidates.push(author.email);\n    }\n  }\n  const emails = [...new Set(candidates)].filter(\n    (email) => !/^[^@]+@(?:users\\.)?noreply\\.github\\.com$/i.test(email),\n  );\n  const escape = (text) =>\n    text.replaceAll(\"&\", \"&amp;\").replaceAll(\"<\", \"&lt;\").replaceAll(\">\", \"&gt;\");\n  const text =\n    \"Name: \" +\n    (profile.name ?? \"\") +\n    \"\\nEmail: \" +\n    emails.join(\", \") +\n    \"\\nCompany: \" +\n    (profile.company ?? \"\") +\n    \"\\nLocation: \" +\n    (profile.location ?? \"\");\n  const chunks = [];\n  let chunk = \"\";\n  for (const character of text) {\n    const escaped = escape(character);\n    if (chunk.length + escaped.length > 3800) {\n      chunks.push(chunk);\n      chunk = \"\";\n    }\n    chunk += escaped;\n  }\n  if (chunk) chunks.push(chunk);\n  const title = \"GitHub Details for: \" + username;\n  const parts = chunks.map((content, index) => [\n    {\n      title: chunks.length > 1 ? title + \" (\" + (index + 1) + \"/\" + chunks.length + \")\" : title,\n      text: content,\n      fallback: title,\n      mrkdwn_in: [],\n      ...(index === 0 ? { thumb_url: profile.avatarUrl } : {}),\n    },\n  ]);\n  return { profile, emails, parts, pullRequestsScanned: edges.length, commitsScanned };\n}\n"
      },
      "n_72ea91468dd3d5fc": {
        "name": "Prepare the next profile attachment",
        "imports": [],
        "source": "export default function githubUserProgress({\n  parts,\n  channelId,\n  previousState,\n  messageTs,\n  messageChannelId,\n}) {\n  if (\n    !Array.isArray(parts) ||\n    !parts.length ||\n    typeof channelId !== \"string\" ||\n    !/^[CDG][A-Z0-9]{2,31}$/.test(channelId)\n  )\n    throw new Error(\"Expected the profile attachments and Slack conversation\");\n  let state;\n  if (previousState == null) state = { index: 0, receipts: [] };\n  else {\n    if (\n      !Number.isInteger(previousState.index) ||\n      previousState.index < 1 ||\n      previousState.index > parts.length ||\n      !Array.isArray(previousState.receipts) ||\n      previousState.receipts.length !== previousState.index - 1\n    )\n      throw new Error(\"Invalid profile notification progress\");\n    if (\n      typeof messageTs !== \"string\" ||\n      !/^\\d+\\.\\d+$/.test(messageTs) ||\n      messageChannelId !== channelId\n    )\n      throw new Error(\"Slack did not confirm the requested channel; a message may already exist\");\n    state = {\n      index: previousState.index,\n      receipts: [...previousState.receipts, { ts: messageTs, channelId: messageChannelId }],\n    };\n  }\n  const attachments = parts[state.index];\n  if (attachments == null)\n    return { state, more: false, attachments: parts[0], channelId, count: state.receipts.length };\n  if (\n    !Array.isArray(attachments) ||\n    attachments.length !== 1 ||\n    typeof attachments[0].text !== \"string\" ||\n    attachments[0].text.length > 3800\n  )\n    throw new Error(\"Invalid profile attachment part\");\n  return {\n    state: { index: state.index + 1, receipts: state.receipts },\n    more: true,\n    attachments,\n    channelId,\n    count: state.receipts.length,\n  };\n}\n"
