        "name": "Prepare person lookup",
        "imports": [],
        "source": "export default function person({ email }) {\n  if (typeof email !== \"string\" || !email) throw Error(\"Enter an email address\");\n  return {\n    url: \"https://person-stream.clearbit.com/v2/people/find?email=\" + encodeURIComponent(email),\n  };\n}\n"
      }
