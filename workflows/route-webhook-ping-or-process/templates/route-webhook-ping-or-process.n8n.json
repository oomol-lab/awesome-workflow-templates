{
  "name": "Route Webhook Ping or Process",
  "nodes": [
    {
      "id": "route-webhook-ping-or-process-0",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        200,
        300
      ],
      "parameters": {
        "path": "route-webhook-ping-or-process",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "typeVersion": 2
    },
    {
      "id": "route-webhook-ping-or-process-1",
      "name": "Notas & Testes",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -120,
        80
      ],
      "parameters": {
        "color": 7,
        "width": 720,
        "height": 380,
        "content": "## Template: Orquestrador Webhook Escalável\n\n- Objetivo: Roteia ações (ping/process) e responde rápido.\n- Teste rápido (Terminal):\n```bash\ncurl -X POST http://<SEU_N8N>/webhook/template/scalable-orchestrator \\\n  -H 'Content-Type: application/json' \\\n  -d '{\\\"action\\\":\\\"process\\\",\\\"payload\\\":{\\\"id\\\":1,\\\"text\\\":\\\"olá\\\"}}'\n```\n- Produção: Troque 'HTTP Service A' para sua API/serviço com credenciais.\n- Resiliência: HTTP possui retry automático (2x).\n"
      },
      "typeVersion": 1
    },
    {
      "id": "route-webhook-ping-or-process-2",
      "name": "Parse Input",
      "type": "n8n-nodes-base.set",
      "position": [
        460,
        300
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "in_action",
              "name": "action",
              "type": "string",
              "value": "={{ $json.body?.action || 'ping' }}"
            },
            {
              "id": "in_payload",
              "name": "payload",
              "type": "object",
              "value": "={{ $json.body?.payload || {id:123,text:'hello'} }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "route-webhook-ping-or-process-3",
      "name": "Route by action",
      "type": "n8n-nodes-base.switch",
      "position": [
        720,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "ping",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "ping"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "process",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "process"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
      "typeVersion": 3
    },
    {
      "id": "route-webhook-ping-or-process-4",
      "name": "HTTP Service A",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        980,
        360
      ],
      "parameters": {
        "url": "https://httpbin.org/post",
        "method": "POST",
        "specifyBody": "json",
        "sendBody": true,
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "retryOnFail": true,
          "maxRetries": 2
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "route-webhook-ping-or-process-5",
      "name": "Compose Ping",
      "type": "n8n-nodes-base.set",
      "position": [
        980,
        220
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "ok1",
              "name": "ok",
              "type": "boolean",
              "value": true
            },
            {
              "id": "msg1",
              "name": "message",
              "type": "string",
              "value": "pong"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "route-webhook-ping-or-process-6",
      "name": "Compose Result",
      "type": "n8n-nodes-base.set",
      "position": [
        1240,
        360
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "ok2",
              "name": "ok",
              "type": "boolean",
              "value": true
            },
            {
              "id": "data2",
              "name": "data",
              "type": "object",
              "value": "={{ $json.json || {} }}"
            },
            {
              "id": "src2",
              "name": "source",
              "type": "string",
              "value": "serviceA"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "route-webhook-ping-or-process-7",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1500,
        280
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "typeVersion": 1.1
    },
    {
      "id": "route-webhook-ping-or-process-relay-hook",
      "name": "Open Flow relay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        650
      ],
      "disabled": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "route-webhook-ping-or-process-relay",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "route-webhook-ping-or-process-forward",
      "name": "Forward complete request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        650
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_OPENFLOW_HOST/webhook/YOUR_FLOW",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json.body)} }}",
        "options": {}
      }
    },
    {
      "id": "route-webhook-ping-or-process-relay-response",
      "name": "Return Open Flow response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        800,
        650
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Parse Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Input": {
      "main": [
        [
          {
            "node": "Route by action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by action": {
      "main": [
        [
          {
            "node": "Compose Ping",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP Service A",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Service A": {
      "main": [
        [
          {
            "node": "Compose Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose Ping": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose Result": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open Flow relay webhook": {
      "main": [
        [
          {
            "node": "Forward complete request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward complete request": {
      "main": [
        [
          {
            "node": "Return Open Flow response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "pinData": {}
}
