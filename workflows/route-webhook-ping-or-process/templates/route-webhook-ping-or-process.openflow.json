    "modules": {
      "n_821ddae89b0cd84c": {
        "name": "Read request",
        "imports": [],
        "source": "export default function parse({ body }) {\n  const event = JSON.parse(body.event),\n    action = event?.action || \"ping\",\n    payload = event?.payload || { id: 123, text: \"hello\" };\n  if (action !== \"ping\" && action !== \"process\") throw Error(\"Unsupported action\");\n  return { process: action === \"process\", payload };\n}\n"
      },
      "n_f37be53a8bb7de00": {
        "name": "Compose service response",
        "imports": [],
        "source": "export default function compose({ body }) {\n  return { response: { ok: true, data: body?.json || {}, source: \"serviceA\" } };\n}\n"
      },
      "n_fc127fa7a065df2c": {
        "name": "Compose ping response",
        "imports": [],
        "source": "export default function ping() {\n  return { response: { ok: true, message: \"pong\" } };\n}\n"
      },
      "n_b0d00112cf1b93f9": {
        "name": "Select response",
        "imports": [],
        "source": "export default function select({ ping, service }) {\n  return { response: service ?? ping };\n}\n"
      }
    }
