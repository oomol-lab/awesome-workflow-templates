    "modules": {
      "n_630e10da3a7019cc": {
        "name": "Choose application step",
        "imports": [],
        "source": "export default function route({ body }) {\n  if (![\"extract\", \"submit\"].includes(body.stage)) throw Error(\"Unknown application step\");\n  return { stage: body.stage, text: body.text, submissionId: body.submissionId };\n}\n"
      },
      "n_160808323eb6c8ea": {
        "name": "Store extracted fields",
        "imports": [],
        "source": "export default async function save({ form, submissionId }, ctx) {\n  await ctx.state.set(\"response:\" + submissionId, { form });\n  return { ok: true };\n}\n"
      },
      "n_236530c5a472726c": {
        "name": "Prepare applicant record",
        "imports": [],
        "source": "export default async function prepare(\n  { body, baseId, tableId, acknowledge, resolution, confirmedId },\n  ctx,\n) {\n  if (!body?.submissionId || !body?.fields || typeof body.fields !== \"object\")\n    throw Error(\"Missing application\");\n  if (!baseId || !tableId || baseId.includes(\"YOUR_\") || tableId.includes(\"YOUR_\"))\n    throw Error(\"Configure Airtable destination\");\n  const key = \"application:\" + body.submissionId,\n    s = await ctx.state.get(key);\n  if (s?.status === \"done\")\n    return { write: false, recordId: s.recordId, key, records: [{ fields: {} }], baseId, tableId };\n  if (s?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown Airtable creation \" + key);\n    if (resolution === \"confirmed\") {\n      if (!confirmedId) throw Error(\"Enter confirmed Airtable record ID\");\n      await ctx.state.set(key, { status: \"done\", recordId: confirmedId });\n      return {\n        write: false,\n        recordId: confirmedId,\n        key,\n        records: [{ fields: {} }],\n        baseId,\n        tableId,\n      };\n    }\n  }\n  const allowed = [\n      \"Name\",\n      \"Address\",\n      \"Email\",\n      \"Telephone\",\n      \"Education\",\n      \"Skills & Technologies\",\n      \"Years of Experience\",\n      \"Cover Letter\",\n    ],\n    fields = Object.fromEntries(allowed.map((k) => [k, String(body.fields[k] ?? \"\")]));\n  fields[\"Submitted By\"] = String(body.submittedBy || \"\");\n  await ctx.state.set(key, { status: \"pending\" });\n  return { write: true, recordId: \"\", key, records: [{ fields }], baseId, tableId };\n}\n"
      },
      "n_fd1c30bcc6d9f3b1": {
        "name": "Confirm applicant creation",
        "imports": [],
        "source": "export default async function confirm({ key, records, submissionId }, ctx) {\n  const id = records?.[0]?.id;\n  if (!id || records.length !== 1) throw Error(\"Airtable creation outcome unknown\");\n  await ctx.state.set(key, { status: \"done\", recordId: id });\n  await ctx.state.set(\"response:\" + submissionId, { recordId: id });\n  return { ok: true };\n}\n"
      },
      "n_d937f7b0182dc308": {
        "name": "Use confirmed applicant",
        "imports": [],
        "source": "export default async function existing({ recordId, submissionId }, ctx) {\n  await ctx.state.set(\"response:\" + submissionId, { recordId });\n  return { ok: true };\n}\n"
      },
      "n_b9625aab73f0b44d": {
        "name": "Return application step",
        "imports": [],
        "source": "export default async function response({ submissionId }, ctx) {\n  const body = await ctx.state.get(\"response:\" + submissionId);\n  if (!body) throw Error(\"Missing response\");\n  await ctx.state.set(\"response:\" + submissionId, null);\n  return { body };\n}\n"
      }
    }
  },
