    "modules": {
      "n_093d0849559cf852": {
        "name": "Select next contact",
        "imports": [],
        "source": "export default function next({ body, previous }) {\n  const e = body.event;\n  if (!e || !Array.isArray(e.object_keys)) throw Error(\"Expected a Keap REST Hook event\");\n  const index = previous?.index ?? 0,\n    item = e.object_keys[index];\n  if (!item) return { more: false, state: { index }, url: \"\", id: \"\" };\n  const id = String(item.id ?? \"\");\n  if (!/^\\d+$/.test(id)) throw Error(\"Expected numeric contact ID\");\n  return {\n    more: true,\n    state: { index: index + 1 },\n    id,\n    url: `https://api.infusionsoft.com/crm/rest/v1/contacts/${id}`,\n  };\n}\n"
      },
      "n_e250d4d122e6a43b": {
        "name": "Select mailing address",
        "imports": [],
        "source": "export default function address({ body }) {\n  if (!Array.isArray(body?.addresses)) throw Error(\"Contact has no addresses\");\n  const a =\n    body.addresses.find((x) => x.field === \"BILLING\") ??\n    body.addresses.find((x) => x.field === \"SHIPPING\") ??\n    body.addresses[0];\n  if (!a?.line1) throw Error(\"Contact has no mailing address\");\n  const opt = (x) => (typeof x === \"string\" && x.trim() ? x : null);\n  return {\n    primary: a.line1,\n    secondary: opt(a.line2),\n    city: opt(a.locality),\n    state: opt((a.region_code ?? a.region)?.replace(/^US-/i, \"\")),\n    zip: opt(a.postal_code ?? a.zip_code),\n  };\n}\n"
      },
      "n_20c7e9aa52f884fe": {
        "name": "Prepare deliverability tag",
        "imports": [],
        "source": "export default function tag({ verification, id, deliverableTag, otherTag }) {\n  const status = verification?.deliverability;\n  if (typeof status !== \"string\" || !status) throw Error(\"Lob returned no deliverability\");\n  const chosen = status === \"deliverable\" ? deliverableTag : otherTag;\n  if (!/^\\d+$/.test(chosen) || !Number.isSafeInteger(Number(chosen)))\n    throw Error(\"Configure numeric Keap tag IDs\");\n  return {\n    deliverable: status === \"deliverable\",\n    url: `https://api.infusionsoft.com/crm/rest/v1/contacts/${id}/tags`,\n    body: { tagIds: [Number(chosen)] },\n  };\n}\n"
      }
    }
  },
