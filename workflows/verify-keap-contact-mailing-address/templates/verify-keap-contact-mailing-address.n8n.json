    {
      "id": "verify-keap-contact-mailing-address-get",
      "name": "Read Keap contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.infusionsoft.com/crm/rest/v1/contacts/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {}
      }
    },
    {
      "id": "verify-keap-contact-mailing-address-address",
      "name": "Select mailing address",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const list = $json.addresses;\nif (!Array.isArray(list)) throw Error(\"Contact has no addresses\");\nconst a =\n  list.find((x) => x.field === \"BILLING\") ?? list.find((x) => x.field === \"SHIPPING\") ?? list[0];\nif (!a?.line1) throw Error(\"Contact has no mailing address\");\nreturn {\n  json: {\n    address: a.line1,\n    address2: a.line2 ?? \"\",\n    city: a.locality ?? \"\",\n    state: (a.region_code ?? a.region ?? \"\").replace(/^US-/i, \"\"),\n    zip: a.postal_code ?? a.zip_code ?? \"\",\n  },\n};\n"
      }
    }
  ],
