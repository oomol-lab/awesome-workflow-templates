    "modules": {
      "n_ea3fc0804263ba79": {
        "name": "Reserve publication",
        "imports": [],
        "source": "export default async function prepare({ body, acknowledge, resolution }, ctx) {\n  const platforms = [\"instagram\", \"linkedin\", \"facebook\", \"x\", \"tiktok\", \"threads\"];\n  if (\n    !body?.submissionId ||\n    !body?.account ||\n    !body?.caption ||\n    !platforms.includes(body.platform) ||\n    ![\"image/jpeg\", \"video/mp4\"].includes(body.mime)\n  )\n    throw Error(\"Missing publishing fields\");\n  const u = new URL(body.mediaUrl);\n  if (u.protocol !== \"https:\" || u.username || u.password)\n    throw Error(\"Media needs a public HTTPS URL\");\n  if (body.platform === \"facebook\" && !body.facebookPageId)\n    throw Error(\"Facebook Page ID required\");\n  const key = \"social:\" + body.submissionId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") throw Error(\"Already published\");\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending publication \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      throw Error(\"Publication marked confirmed; stop\");\n    }\n  }\n  const boundary = \"OpenFlowUploadPostBoundary7d9b\",\n    parts = [\n      [\"title\", body.caption],\n      [\"user\", body.account],\n      [\"platform[]\", body.platform],\n      [body.mime === \"image/jpeg\" ? \"photos[]\" : \"video\", u.href],\n      ...(body.platform === \"facebook\" ? [[\"facebook_page_id\", body.facebookPageId]] : []),\n    ];\n  if (parts.some(([, v]) => String(v).includes(boundary))) throw Error(\"Invalid field content\");\n  const payload =\n    parts\n      .map(\n        ([name, v]) =>\n          \"--\" +\n          boundary +\n          '\\r\\nContent-Disposition: form-data; name=\"' +\n          name +\n          '\"\\r\\n\\r\\n' +\n          String(v) +\n          \"\\r\\n\",\n      )\n      .join(\"\") +\n    \"--\" +\n    boundary +\n    \"--\\r\\n\";\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    url:\n      body.mime === \"image/jpeg\"\n        ? \"https://api.upload-post.com/api/upload_photos\"\n        : \"https://api.upload-post.com/api/upload\",\n    payload,\n  };\n}\n"
      },
      "n_7274ef458df37fdc": {
        "name": "Read platform result",
        "imports": [],
        "source": "export default async function result({ body, key, submission }, ctx) {\n  const entry = body?.results?.[submission.platform];\n  let status;\n  if (entry?.success === true) {\n    status = \"published\";\n    await ctx.state.set(key, { status: \"done\" });\n  } else if (typeof body?.request_id === \"string\" && body.request_id) status = \"processing\";\n  else if (entry?.success === false) status = \"failed\";\n  else throw Error(\"Unknown publication result; inspect Upload-Post before retrying\");\n  return {\n    response: JSON.stringify({ status, requestId: body?.request_id || \"\", result: entry || null }),\n  };\n}\n"
      }
    }
