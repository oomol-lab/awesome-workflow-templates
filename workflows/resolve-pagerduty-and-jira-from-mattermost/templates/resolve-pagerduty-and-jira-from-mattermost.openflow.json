      "n_fd3b1d210e577065": {
        "name": "Validate the action",
        "imports": [],
        "source": "export default function planResolution({body,secret,from,transitionId,announcementChannel}){\n if(typeof secret!=='string'||secret.length<24||secret==='YOUR_ACTION_SECRET')throw Error('Configure a strong action secret');if(typeof body?.context?.action_secret!=='string'||body.context.action_secret!==secret)throw Error('Invalid action secret');const incident=body?.context?.pagerduty_incident,channel=body?.channel_id,key=body?.context?.jira_key;if(typeof incident!=='string'||!incident.trim()||typeof channel!=='string'||!channel.trim()||typeof key!=='string'||!/^[A-Za-z][A-Za-z0-9_]*-[1-9][0-9]*$/.test(key))throw Error('Missing or invalid incident, channel or Jira key');if(typeof from!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(from))throw Error('Configure PagerDuty user email');if(typeof transitionId!=='string'||!/^\\d+$/.test(transitionId))throw Error('Configure Jira transition ID');if(typeof announcementChannel!=='string'||!announcementChannel.trim()||announcementChannel==='YOUR_ANNOUNCEMENT_CHANNEL_ID')throw Error('Configure announcement channel');return{incidentId:incident,channelId:channel,from,announcementChannel,transitionId,endpoint:'/issue/'+encodeURIComponent(key)+'/transitions',jiraBody:{transition:{id:transitionId}}};\n}\n"
      },
      "n_498236b8e1feb1df": {
        "name": "Confirm incident resolution",
        "imports": [],
        "source": "export default function confirmResolution({incident,incidentId}){if(!incident||incident.id!==incidentId||incident.status!=='resolved')throw Error('PagerDuty did not confirm resolution');const summary=typeof incident.summary==='string'&&incident.summary.trim()?incident.summary:incidentId;return{announcement:'🎉 The incident ('+summary+') was resolved by the lovely folks in the on-call team!'};}\n"
      },
      "n_5e0ced6a3567f1cb": {
        "name": "Confirm Jira transition",
        "imports": [],
        "source": "export default function confirmJiraTransition({statusCode}){if(statusCode!==204)throw Error('Jira did not confirm transition; inspect the issue before retrying');return{message:'💪 This issue got closed in PagerDuty and Jira.'};}\n"
      }
    }
