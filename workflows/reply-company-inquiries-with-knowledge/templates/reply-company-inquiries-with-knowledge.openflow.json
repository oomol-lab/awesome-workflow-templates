          "modules": {
            "n_9b03a1326216c519": {
              "name": "Prepare inquiry",
              "imports": [],
              "source": "export default function ({ payload }) {\n  if (\n    typeof payload.subject !== \"string\" ||\n    typeof payload.body !== \"string\" ||\n    !payload.body.trim()\n  )\n    throw Error(\"Missing inquiry text\");\n  return { subject: payload.subject, body: payload.body };\n}\n"
            },
            "n_1d520fc9ca960462": {
              "name": "Return response",
              "imports": [],
              "source": "export default function ({ response }) {\n  const x = typeof response === \"string\" ? JSON.parse(response) : response;\n  if (\n    typeof x?.eligible !== \"boolean\" ||\n    typeof x.summary !== \"string\" ||\n    typeof x.reply !== \"string\" ||\n    (x.eligible && !x.reply.trim())\n  )\n    throw Error(\"Invalid inquiry response\");\n  return { body: JSON.stringify(x) };\n}\n"
            }
          }
        }
