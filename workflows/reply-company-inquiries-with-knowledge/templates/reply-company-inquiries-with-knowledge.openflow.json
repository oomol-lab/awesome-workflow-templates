              "name": "Validate embedding",
              "imports": [],
              "source": "export default function ({ response }) {\n  const vector = response?.data?.[0]?.embedding;\n  if (\n    !Array.isArray(vector) ||\n    vector.length !== 1536 ||\n    vector.some((x) => typeof x !== \"number\" || !Number.isFinite(x))\n  )\n    throw Error(\"Invalid 1536-dimensional embedding\");\n  return { vector };\n}\n"
            },
            "n_da0086f869c4b33a": {
              "name": "Return company documents",
              "imports": [],
              "source": "export default function ({ points }) {\n  if (!Array.isArray(points) || !points.length) throw Error(\"No company knowledge found\");\n  return { result: JSON.stringify(points.map((x) => x.payload)) };\n}\n"
            }
