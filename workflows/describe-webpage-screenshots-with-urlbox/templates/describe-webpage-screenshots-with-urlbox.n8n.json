      "name": "Verify screenshot digest",
      "id": "describe-webpage-screenshots-with-urlbox-restore",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { actualDigest, digest } = $input.item.json;\nif (actualDigest !== digest) throw new Error(\"Screenshot digest does not match URLbox\");\nconst screenshot = $(\"Check the downloaded PNG\").item.binary;\nreturn { json: {}, binary: screenshot };\n"
