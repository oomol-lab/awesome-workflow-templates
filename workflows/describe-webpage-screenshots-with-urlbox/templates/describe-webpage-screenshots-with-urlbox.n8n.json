        "mode": "runOnceForEachItem",
        "jsCode": "function checkDescription(value) {\n  if (typeof value !== \"string\" || !value.trim() || value.length > 4096) {\n    throw new Error(\"The model did not return a complete description\");\n  }\n  return value.trim();\n}\nconst reply = $input.item.json.choices?.[0];\nif (reply?.finish_reason !== \"stop\" || reply.message?.refusal)\n  throw new Error(\"The model did not complete screenshot analysis\");\nconst { website_name, url } = $(\"Set the webpage and instructions\").item.json;\nreturn { json: { website_name, url, description: checkDescription(reply.message?.content) } };\n"
