    {
      "name": "Check the downloaded PNG",
      "id": "describe-webpage-screenshots-with-urlbox-inspect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function checkImage({ bytes, mime, size }) {\n  const signature = [137, 80, 78, 71, 13, 10, 26, 10];\n  if (\n    mime !== \"image/png\" ||\n    bytes.length !== size ||\n    !signature.every((value, index) => bytes[index] === value)\n  ) {\n    throw new Error(\"Downloaded screenshot is not the expected PNG\");\n  }\n}\nconst item = $input.item;\nconst bytes = await helpers.getBinaryDataBuffer($itemIndex, \"data\");\ncheckImage({ bytes, mime: item.binary.data.mimeType, size: item.json.size });\nreturn item;\n"
      },
