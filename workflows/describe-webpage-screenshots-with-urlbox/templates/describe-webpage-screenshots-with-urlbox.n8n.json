    {
      "name": "Set the webpage and instructions",
      "id": "describe-webpage-screenshots-with-urlbox-config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function configure({ website_name, url, instruction }) {\n  if (\n    typeof website_name !== \"string\" ||\n    !website_name.trim() ||\n    typeof instruction !== \"string\" ||\n    !instruction.trim()\n  ) {\n    throw new Error(\"Enter the webpage name and description instructions\");\n  }\n  if (typeof url !== \"string\" || !/^https?:\\/\\/[^\\s/?#@]+(?:[/?#][^\\s]*)?$/i.test(url)) {\n    throw new Error(\"Enter a public HTTP or HTTPS webpage URL\");\n  }\n  return {\n    website_name: website_name.trim(),\n    url,\n    instruction,\n    request: { url, full_page: true, format: \"png\", save_hashes: true },\n  };\n}\nconst settings = {\n  website_name: \"n8n\",\n  url: \"https://n8n.io/\",\n  instruction:\n    \"Your input is a screenshot of a website. Describe the content of the website in one sentence.\",\n};\nreturn [{ json: configure(settings) }];\n"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "ca9f0357-a596-4453-b351-fdd8d47c81ad",
      "name": "Capture the page with URLbox",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.urlbox.com/v1/render/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "name": "Check screenshot URL and digest",
      "id": "describe-webpage-screenshots-with-urlbox-render",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function checkRender(body) {\n  const url = body?.renderUrl;\n  const digest = body?.hashes?.file;\n  if (\n    typeof url !== \"string\" ||\n    !/^https:\\/\\/renders\\.urlbox\\.com\\/[^?#\\s]+(?:\\?[^#\\s]*)?$/.test(url)\n  ) {\n    throw new Error(\"URLbox did not return a trusted screenshot URL\");\n  }\n  if (typeof digest !== \"string\" || !/^[a-f0-9]{64}$/i.test(digest)) {\n    throw new Error(\"URLbox did not return a valid screenshot digest\");\n  }\n  if (!Number.isSafeInteger(body.size) || body.size < 8 || body.size > 2 * 1024 * 1024) {\n    throw new Error(\"URLbox screenshot size is invalid or exceeds 2 MiB\");\n  }\n  return { url, digest: digest.toLowerCase(), size: body.size };\n}\nreturn { json: checkRender($input.item.json) };\n"
      },
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Download screenshot",
      "id": "describe-webpage-screenshots-with-urlbox-download",
