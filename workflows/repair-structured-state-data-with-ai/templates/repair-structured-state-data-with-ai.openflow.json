    "modules": {
      "n_e5678019b1109243": {
        "name": "Check the answer",
        "imports": [],
        "source": "export default function parse({ text }) {\n  let result,\n    error = \"\";\n  try {\n    result = JSON.parse(text);\n    if (\n      !result ||\n      !Array.isArray(result.states) ||\n      result.states.length !== 5 ||\n      !result.states.every(\n        (s) =>\n          s &&\n          typeof s.state === \"string\" &&\n          Array.isArray(s.cities) &&\n          s.cities.length === 3 &&\n          s.cities.every(\n            (c) =>\n              c &&\n              typeof c.name === \"string\" &&\n              typeof c.population === \"number\" &&\n              Number.isFinite(c.population),\n          ),\n      )\n    )\n      throw new Error(\n        \"Expected five states with three cities, each with a name and numeric population.\",\n      );\n  } catch (e) {\n    error = String(e.message);\n    result = { states: [] };\n  }\n  return { valid: !error, result, error, completion: text };\n}\n"
      },
      "n_a11dd88c5cc8f973": {
        "name": "Keep valid answer",
        "imports": [],
        "source": "export default function pass({ result }) {\n  return { result };\n}\n"
      },
      "n_739b42f33a5ef2e6": {
        "name": "Validate repaired answer",
        "imports": [],
        "source": "export default function confirm({ text }) {\n  const result = JSON.parse(text);\n  if (\n    !result ||\n    !Array.isArray(result.states) ||\n    result.states.length !== 5 ||\n    !result.states.every(\n      (s) =>\n        s &&\n        typeof s.state === \"string\" &&\n        Array.isArray(s.cities) &&\n        s.cities.length === 3 &&\n        s.cities.every(\n          (c) =>\n            c &&\n            typeof c.name === \"string\" &&\n            typeof c.population === \"number\" &&\n            Number.isFinite(c.population),\n        ),\n    )\n  )\n    throw new Error(\"The repaired answer does not match the required format.\");\n  return { result };\n}\n"
      }
    }
