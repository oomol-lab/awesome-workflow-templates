    {
      "name": "Normalize essay URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let p = $json.essay;\nif (typeof p !== \"string\" || !p) throw Error(\"Invalid link\");\nif (/^https?:\\/\\/www\\.paulgraham\\.com\\//i.test(p))\n  p = p.replace(/^https?:\\/\\/www\\.paulgraham\\.com\\//i, \"\");\nelse if (p.startsWith(\"/\")) p = p.slice(1);\nif (!/^[a-z0-9_./-]+$/i.test(p) || p.includes(\"..\") || p.startsWith(\"/\"))\n  throw Error(\"Unexpected link\");\nreturn { json: { url: \"https://www.paulgraham.com/\" + p } };\n"
      },
      "id": "summarize-three-essays-5",
      "position": [
        1100,
        0
