    "modules": {
      "n_5d117c9011792041": {
        "name": "Select first three links",
        "imports": [],
        "source": "export default function ({ html }) {\n  if (typeof html !== \"string\" || !html) throw Error(\"Missing index HTML\");\n  const hrefs = [],\n    seen = new Set();\n  for (const m of html.matchAll(/<a[^>]+href=[\"']([^\"'#?]+\\.html)[\"'][^>]*>/gi)) {\n    const h = m[1];\n    if (/^(?:index|articles|rss)\\.html$/i.test(h)) continue;\n    let path = h;\n    if (/^https?:\\/\\/www\\.paulgraham\\.com\\//i.test(path))\n      path = path.replace(/^https?:\\/\\/www\\.paulgraham\\.com\\//i, \"\");\n    else if (path.startsWith(\"/\")) path = path.slice(1);\n    if (!/^[a-z0-9_./-]+$/i.test(path) || path.includes(\"..\") || path.startsWith(\"/\")) continue;\n    const u = \"https://www.paulgraham.com/\" + path;\n    if (!seen.has(u)) {\n      seen.add(u);\n      hrefs.push(u);\n      if (hrefs.length === 3) break;\n    }\n  }\n  if (!hrefs.length) throw Error(\"No essay links found\");\n  return { urls: hrefs };\n}\n"
      },
      "n_c3a9690357bb7838": {
        "name": "Choose an essay",
        "imports": [],
        "source": "export default function next({ urls, previous, collected }) {\n  const index = previous?.index ?? 0,\n    url = urls[index],\n    pages = collected?.pages ?? previous?.pages ?? [];\n  return {\n    state: { index: index + (url ? 1 : 0), pages },\n    more: !!url,\n    url: url ?? \"https://www.paulgraham.com/\",\n  };\n}\n"
      },
      "n_6ca3809370e02a32": {
        "name": "Read essay title",
        "imports": [],
        "source": "export default function ({ html, url }) {\n  if (typeof html !== \"string\" || !html) throw Error(\"Missing essay HTML\");\n  const m = html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i);\n  const title = (m?.[1] || url)\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n  return { title: title || url, html };\n}\n"
      },
      "n_c1e06613e382f22a": {
        "name": "Collect essay page",
        "imports": [],
        "source": "export default function page({ url, title, html, previous }) {\n  if (!title.trim() || !html) throw Error(\"Missing title or essay\");\n  return { state: { pages: [...(previous?.pages ?? []), { url, title, html }] } };\n}\n"
      },
      "n_4d5a684f728bca71": {
        "name": "Split all essays into chunks",
        "imports": [],
        "source": "export default function parts({ pages }) {\n  const parts = [];\n  for (const p of pages) {\n    for (let i = 0; i < p.html.length; i += 4000)\n      parts.push({ url: p.url, text: p.html.slice(i, i + 4000) });\n  }\n  return { parts };\n}\n"
      },
      "n_12a5eb5a80dafbbb": {
        "name": "Choose a chunk",
        "imports": [],
        "source": "export default function next({ parts, previous, collected }) {\n  const index = previous?.index ?? 0,\n    p = parts[index],\n    summaries = collected?.summaries ?? previous?.summaries ?? [];\n  return {\n    state: { index: index + (p ? 1 : 0), summaries },\n    more: !!p,\n    url: p?.url ?? \"\",\n    text: p?.text ?? \"\",\n  };\n}\n"
      },
      "n_4fadc8c61d7c78ef": {
        "name": "Collect chunk summaries",
        "imports": [],
        "source": "export default function collect({ url, summary, previous }) {\n  if (!summary.trim()) throw Error(\"Empty chunk summary\");\n  return { state: { summaries: [...(previous?.summaries ?? []), { url, summary }] } };\n}\n"
      },
      "n_4dc7094bc48fbd3d": {
        "name": "Choose essay summaries",
        "imports": [],
        "source": "export default function next({ pages, summaries, previous, collected }) {\n  const index = previous?.index ?? 0,\n    p = pages[index],\n    results = collected?.results ?? previous?.results ?? [],\n    text = p\n      ? summaries\n          .filter((x) => x.url === p.url)\n          .map((x) => x.summary)\n          .join(\"\\n\\n\")\n      : \"\";\n  if (p && !text) throw Error(\"Missing chunk summaries\");\n  return {\n    state: { index: index + (p ? 1 : 0), results },\n    more: !!p,\n    url: p?.url ?? \"\",\n    title: p?.title ?? \"\",\n    text,\n  };\n}\n"
      },
      "n_1265f1b2c64ec789": {
        "name": "Collect essay result",
        "imports": [],
        "source": "export default function result({ url, title, summary, previous }) {\n  if (typeof title !== \"string\" || !title.trim() || typeof summary !== \"string\" || !summary.trim())\n    throw Error(\"Missing title or summary\");\n  return { state: { results: [...(previous?.results ?? []), { url, title, summary }] } };\n}\n"
      }
