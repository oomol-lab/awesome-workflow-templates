    "modules": {
      "n_67079c7318749ee4": {
        "name": "Read the event feedback answer",
        "imports": [],
        "source": "export default function typeformEventFeedback({ response, questionTitle }) {\n  if (!response || !Array.isArray(response.answers) || !Array.isArray(response.definition?.fields)) throw new Error('Expected a complete Typeform response');\n  if (typeof questionTitle !== 'string' || !questionTitle.trim()) throw new Error('Configure the feedback question title');\n  const fields = response.definition.fields.filter(field => field?.title === questionTitle);\n  if (fields.length !== 1 || typeof fields[0].id !== 'string' || !fields[0].id || response.definition.fields.filter(field => field?.id === fields[0].id).length !== 1) throw new Error('The feedback question title must identify one field');\n  const answers = response.answers.filter(answer => answer?.field?.id === fields[0].id);\n  if (answers.length !== 1 || answers[0].type !== 'text' || typeof answers[0].text !== 'string' || !answers[0].text.trim()) throw new Error('One nonblank text feedback answer is required');\n  return { feedback: answers[0].text };\n}\n"
      },
      "n_057edb96a2c7cc6b": {
        "name": "Sign the Comprehend request",
        "imports": [],
        "source": "import { createHash, createHmac } from 'node:crypto';\n\nexport default function comprehendSignedRequest({ feedback, region, languageCode, accessKeyId, secretAccessKey, sessionToken }) {\n  if (typeof feedback !== 'string' || !feedback.trim()) throw new Error('Feedback text is missing');\n  if (typeof region !== 'string' || !/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region)) throw new Error('Configure a valid AWS region');\n  if (!['en', 'es', 'fr', 'de', 'it', 'pt', 'ar', 'hi', 'ja', 'ko', 'zh', 'zh-TW'].includes(languageCode)) throw new Error('Configure a supported Comprehend language code');\n  const required = (value, name) => { if (typeof value !== 'string' || !value.trim()) throw new Error('Select the AWS ' + name + ' secret Variable'); return value.trim(); };\n  const keyId = required(accessKeyId, 'access key ID'), secret = required(secretAccessKey, 'secret access key');\n  if (sessionToken != null && typeof sessionToken !== 'string') throw new Error('The AWS session token must be text');\n  const token = sessionToken?.trim() ?? '', service = 'comprehend', host = service + '.' + region + '.amazonaws.com' + (region.startsWith('cn-') ? '.cn' : '');\n  const body = JSON.stringify({ Text: feedback, LanguageCode: languageCode }), timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, ''), date = timestamp.slice(0, 8);\n  const headers = { 'content-type': 'application/x-amz-json-1.1', host, 'x-amz-date': timestamp, 'x-amz-target': 'Comprehend_20171127.DetectSentiment', ...(token ? { 'x-amz-security-token': token } : {}) };\n  const names = Object.keys(headers).sort(), signedHeaders = names.join(';'), canonicalHeaders = names.map(name => name + ':' + headers[name].trim().replace(/\\s+/g, ' ') + '\\n').join('');\n  const hash = value => createHash('sha256').update(value).digest('hex'), hmac = (key, value) => createHmac('sha256', key).update(value).digest();\n  const scope = date + '/' + region + '/' + service + '/aws4_request', canonical = ['POST', '/', '', canonicalHeaders, signedHeaders, hash(body)].join('\\n');\n  const toSign = ['AWS4-HMAC-SHA256', timestamp, scope, hash(canonical)].join('\\n');\n  const signingKey = hmac(hmac(hmac(hmac('AWS4' + secret, date), region), service), 'aws4_request'), signature = createHmac('sha256', signingKey).update(toSign).digest('hex');\n  delete headers.host;\n  headers.authorization = 'AWS4-HMAC-SHA256 Credential=' + keyId + '/' + scope + ', SignedHeaders=' + signedHeaders + ', Signature=' + signature;\n  return { url: 'https://' + host + '/', body, headers };\n}\n"
      },
      "n_ea2fa9b4c52ab563": {
        "name": "Check the returned sentiment",
        "imports": [],
        "source": "export default function comprehendFeedbackDecision({ assessment, feedback }) {\n  if (!assessment || typeof assessment !== 'object' || Array.isArray(assessment) || !['POSITIVE', 'NEGATIVE', 'NEUTRAL', 'MIXED'].includes(assessment.Sentiment)) throw new Error('Comprehend did not return a valid sentiment');\n  for (const name of ['Positive', 'Negative', 'Neutral', 'Mixed']) {\n    const score = assessment.SentimentScore?.[name];\n    if (typeof score !== 'number' || !Number.isFinite(score) || score < 0 || score > 1) throw new Error('Comprehend did not return a valid ' + name + ' confidence');\n  }\n  if (typeof feedback !== 'string' || !feedback.trim()) throw new Error('Original feedback text is missing');\n  return { assessment, negative: assessment.Sentiment === 'NEGATIVE', message: 'You got new feedback with a score of ' + assessment.SentimentScore.Negative + '. Here is what it says:' + feedback };\n}\n"
      },
      "n_19f0a7ca712c806c": {
        "name": "Confirm the feedback post",
        "imports": [],
        "source": "export default function mattermostFeedbackPosted({ post, assessment }) {\n  if (!post || typeof post !== 'object' || Array.isArray(post) || typeof post.id !== 'string' || !post.id.trim()) throw new Error('Mattermost did not return a saved post ID');\n  return { posted: true, assessment, post };\n}\n"
      },
      "n_a5ac59cffd4b9240": {
        "name": "Keep nonnegative feedback silent",
        "imports": [],
        "source": "export default function negativeFeedbackSkipped({ assessment }) {\n  return { posted: false, assessment, post: null };\n}\n"
      }
    }
