    "modules": {
      "n_065bb5152b64770f": {
        "name": "Set site and article",
        "imports": [],
        "source": "function preparePost({ siteId, title, content, status }) {\n  if (typeof siteId !== \"string\" || !/^[1-9]\\d{0,19}$/.test(siteId)) {\n    throw new Error(\"Set the numeric WordPress.com site ID\");\n  }\n  if (\n    typeof title !== \"string\" ||\n    !title.trim() ||\n    typeof content !== \"string\" ||\n    !content.trim()\n  ) {\n    throw new Error(\"Enter a post title and body\");\n  }\n  if (status !== \"draft\" && status !== \"publish\") {\n    throw new Error(\"Choose draft or publish for the post status\");\n  }\n  return {\n    url: \"https://public-api.wordpress.com/wp/v2/sites/\" + siteId + \"/posts?_fields=id,status,type\",\n    payload: { title, content, status },\n    requestedStatus: status,\n  };\n}\nexport default preparePost;\n"
      },
      "n_8de6e58fd4e2aaf7": {
        "name": "Confirm the new post ID",
        "imports": [],
        "source": "function confirmPost({ statusCode, response, expectedStatus }) {\n  if (statusCode >= 400 && statusCode < 500 && statusCode !== 408) {\n    throw new Error(\"WordPress.com rejected the post request (HTTP \" + statusCode + \")\");\n  }\n  const unknown = \"WordPress.com did not confirm creation. Check the site before retrying\";\n  if (statusCode !== 201) throw new Error(unknown + \" (HTTP \" + statusCode + \")\");\n  let post;\n  try {\n    post = JSON.parse(response);\n  } catch {\n    throw new Error(unknown);\n  }\n  if (\n    !Number.isSafeInteger(post?.id) ||\n    post.id < 1 ||\n    post.type !== \"post\" ||\n    post.status !== expectedStatus\n  ) {\n    throw new Error(unknown);\n  }\n  return { postId: post.id, status: post.status };\n}\nexport default confirmPost;\n"
      }
