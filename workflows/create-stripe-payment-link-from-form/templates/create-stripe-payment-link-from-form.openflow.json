    "modules": {
      "n_a97a3240c790f3f5": {
        "name": "Validate the EUR price",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const title = body?.title,\n    price = body?.price;\n  if (\n    typeof title !== \"string\" ||\n    !title.trim() ||\n    typeof price !== \"number\" ||\n    !Number.isFinite(price) ||\n    price <= 0\n  )\n    throw Error(\"Provide title and a positive EUR price\");\n  const cents = Math.round(price * 100);\n  if (cents < 1 || !Number.isSafeInteger(cents) || Math.abs(price * 100 - cents) > 1e-7)\n    throw Error(\"Price must be in whole euro cents\");\n  return {\n    product: {\n      name: title.trim(),\n      \"default_price_data[unit_amount]\": cents,\n      \"default_price_data[currency]\": \"eur\",\n    },\n  };\n}\n"
      },
      "n_6d57cf3456f56839": {
        "name": "Read the created price",
        "imports": [],
        "source": "export default function product({ response }) {\n  if (\n    typeof response?.id !== \"string\" ||\n    !response.id.startsWith(\"prod_\") ||\n    typeof response.default_price !== \"string\" ||\n    !response.default_price.startsWith(\"price_\")\n  )\n    throw Error(\"Stripe did not confirm product and default price\");\n  return { link: { \"line_items[0][price]\": response.default_price, \"line_items[0][quantity]\": 1 } };\n}\n"
      },
      "n_a81d48128d9d6bb4": {
        "name": "Validate the payment link",
        "imports": [],
        "source": "export default function result({ response }) {\n  if (\n    typeof response?.id !== \"string\" ||\n    !response.id.startsWith(\"plink_\") ||\n    typeof response.url !== \"string\"\n  )\n    throw Error(\"Stripe did not confirm payment link\");\n  let u;\n  try {\n    u = new URL(response.url);\n  } catch {\n    throw Error(\"Invalid payment link URL\");\n  }\n  if (u.protocol !== \"https:\") throw Error(\"Invalid payment link URL\");\n  return { location: u.href, body: { url: u.href } };\n}\n"
      }
    }
