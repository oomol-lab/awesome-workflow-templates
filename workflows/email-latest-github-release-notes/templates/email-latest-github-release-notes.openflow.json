    "modules": {
      "n_e97a5a11559e27a6": {
        "name": "Prepare release notes",
        "imports": [],
        "source": "export default function prepare({ release }) {\n  if (\n    !release ||\n    typeof release !== \"object\" ||\n    !(typeof release.body === \"string\" || release.body == null)\n  )\n    throw Error(\"Invalid release notes\");\n  return {\n    hasBody: Object.hasOwn(release, \"body\"),\n    body: { text: release.body ?? \"\", mode: \"markdown\" },\n  };\n}\n"
      },
      "n_3203793362b61023": {
        "name": "Check rendered HTML",
        "imports": [],
        "source": "export default function html({ body, statusCode, bodyEncoding }) {\n  if (statusCode < 200 || statusCode >= 300 || bodyEncoding !== null)\n    throw Error(\"Markdown rendering failed\");\n  if (body === null) return { html: \"\" };\n  if (typeof body !== \"string\") throw Error(\"Markdown rendering did not return HTML\");\n  return { html: body };\n}\n"
      }
    }
