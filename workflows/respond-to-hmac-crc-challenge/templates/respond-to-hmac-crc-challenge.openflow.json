      "n_c62fda267c7e8087": {
        "name": "Sign challenge",
        "imports": [],
        "source": "import { createHmac } from \"node:crypto\";\nexport default function challenge({ query, secret }) {\n  if (typeof query?.crc_token !== \"string\" || !query.crc_token || !secret)\n    throw Error(\"Configure a secret and provide crc_token\");\n  return {\n    response: {\n      response_token:\n        \"sha256=\" + createHmac(\"sha256\", secret).update(query.crc_token).digest(\"base64\"),\n    },\n  };\n}\n"
      }
