    "modules": {
      "n_5901885bb72e8864": {
        "name": "Choose next Google Doc",
        "imports": [],
        "source": "export default function f({ events, previous }) {\n  const list = (Array.isArray(events) ? events : []).filter(\n    (e) => e?.fileId && e.mimeType === \"application/vnd.google-apps.document\",\n  );\n  const i = previous?.i ?? 0;\n  const e = list[i];\n  if (!e)\n    return { state: { i }, more: false, documentId: \".\", body: { id: \"\", name: \"\", email: \"\" } };\n  return {\n    state: { i: i + 1 },\n    more: true,\n    documentId: e.fileId,\n    body: {\n      id: e.fileId,\n      name: e.lastModifyingUser?.displayName || \"\",\n      email: e.lastModifyingUser?.emailAddress || \"\",\n    },\n  };\n}\n"
      },
      "n_25435e2f6594f93f": {
        "name": "Reserve summary append",
        "imports": [],
        "source": "export default async function f({ body, summary, spreadsheetId, acknowledge, resolution }, ctx) {\n  if (\n    !body?.id ||\n    !spreadsheetId ||\n    typeof body.name !== \"string\" ||\n    typeof body.email !== \"string\" ||\n    !summary?.summary?.trim()\n  )\n    throw Error(\"Missing document or summary\");\n  const key = \"doc-summary:\" + body.id,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\")\n    return { key, write: false, range: \"Summaries!A:C\", spreadsheetId, values: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending sheet append \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, write: false, range: \"Summaries!A:C\", spreadsheetId, values: [] };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    write: true,\n    range: \"Summaries!A:C\",\n    spreadsheetId,\n    values: [[body.name, body.email, summary.summary]],\n  };\n}\n"
      },
      "n_a91248aa99ee92ca": {
        "name": "Confirm summary append",
        "imports": [],
        "source": "export default async function f({ key, id, actual, rows }, ctx) {\n  if (!id || actual !== id || rows !== 1) throw Error(\"Unknown summary append\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    },
