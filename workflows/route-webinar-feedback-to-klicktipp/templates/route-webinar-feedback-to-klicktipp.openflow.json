        "source": "export default function prepare({ body, listId, customFields }) {\n  const v = body;\n  if (!v || typeof v !== \"object\" || typeof v[\"4\"] !== \"string\" || !v[\"4\"].includes(\"@\"))\n    throw Error(\"Email required\");\n  if (!Number.isSafeInteger(listId) || listId <= 0) throw Error(\"Configure opt-in process ID\");\n  const keys = [\"feedback\", \"rating\", \"comments\", \"choice\", \"webinar\"];\n  if (\n    !customFields ||\n    keys.some((k) => !/^field\\d+$/.test(customFields[k] || \"\")) ||\n    new Set(keys.map((k) => customFields[k])).size !== 5\n  )\n    throw Error(\"Configure five distinct custom fields\");\n  const birthday = Date.parse(String(v[\"6\"]) + \"T00:00:00Z\"),\n    match = /^(\\d{2})\\.(\\d{2})\\.(\\d{4}) (\\d{2}):(\\d{2})$/.exec(v[\"13\"] || \"\");\n  if (!Number.isFinite(birthday) || !match) throw Error(\"Invalid dates\");\n  const [, day, month, year, hour, minute] = match,\n    webinar = Date.parse(`${year}-${month}-${day}T${hour}:${minute}:00Z`);\n  if (!Number.isFinite(webinar)) throw Error(\"Invalid webinar date\");\n  const rating = Number(v[\"8\"]);\n  if (!Number.isFinite(rating)) throw Error(\"Invalid rating\");\n  let extra = [];\n  try {\n    extra = v[\"11\"] ? JSON.parse(v[\"11\"]) : [];\n  } catch {\n    extra = [];\n  }\n  if (!Array.isArray(extra)) extra = [extra];\n  const tags = [v[\"8\"] || null, v[\"13\"] || null, ...extra].filter((x) => x !== null);\n  if (tags.some((x) => typeof x !== \"string\" || !x.trim())) throw Error(\"Invalid tag\");\n  const fields = {\n    fieldFirstName: String(v[\"1\"] || \"\"),\n    fieldLastName: String(v[\"3\"] || \"\"),\n    fieldBirthday: String(Math.floor(birthday / 1000)),\n    [customFields.feedback]: String(v[\"7\"] || \"\"),\n    [customFields.rating]: String(rating * 100),\n    [customFields.comments]: String(v[\"9\"] || \"\"),\n    [customFields.choice]: String(v[\"12.1\"] || \"\"),\n    [customFields.webinar]: String(Math.floor(webinar / 1000)),\n  };\n  const phone = String(v[\"5\"] || \"\")\n    .replace(/^\\+/, \"00\")\n    .replace(/[^0-9]/g, \"\");\n  return {\n    email: v[\"4\"],\n    subscriber: { email: v[\"4\"], ...(phone ? { smsnumber: phone } : {}), listid: listId, fields },\n    tags: [...new Set(tags)],\n  };\n}\n"
      },
      "n_3415cd9e43045f09": {
        "name": "Confirm subscriber",
        "imports": [],
        "source": "export default function confirm({ body, email }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body) || !body.id)\n    throw Error(\"Subscriber not confirmed\");\n  return { email };\n}\n"
      },
      "n_6c3348d5686ea615": {
        "name": "Resolve the next tag",
        "imports": [],
        "source": "export default function next({ tags, all, state, created }) {\n  let s;\n  if (state == null) {\n    if (!all || typeof all !== \"object\" || Array.isArray(all)) throw Error(\"Invalid tag list\");\n    s = { remaining: tags, ids: [], lookup: all };\n  } else {\n    s = state;\n    if (created != null) {\n      if (!Array.isArray(created) || !Number.isSafeInteger(created[0]) || created[0] <= 0)\n        throw Error(\"Tag creation not confirmed\");\n      s = { ...s, ids: [...s.ids, created[0]] };\n    }\n  }\n  while (s.remaining.length) {\n    const [name, ...remaining] = s.remaining,\n      match = Object.entries(s.lookup).find(([, v]) => v === name);\n    s = { ...s, remaining };\n    if (match) {\n      const id = Number(match[0]);\n      if (!Number.isSafeInteger(id) || id <= 0) throw Error(\"Invalid tag ID\");\n      s.ids.push(id);\n      continue;\n    }\n    return { state: s, more: true, request: { name }, tagIds: [] };\n  }\n  return { state: s, more: false, request: {}, tagIds: s.ids };\n}\n"
      },
      "n_462e9e81c450ae0b": {
        "name": "Prepare tag assignment",
        "imports": [],
        "source": "export default function tag({ email, tagIds }) {\n  return { body: { email, tagids: tagIds }, hasTags: tagIds.length > 0 };\n}\n"
      },
      "n_7026b0856ae05414": {
        "name": "Confirm tag assignment",
        "imports": [],
        "source": "export default function result({ body, email }) {\n  if (!Array.isArray(body) || body.length !== 1 || body[0] !== true)\n    throw Error(\"Tag assignment not confirmed\");\n  return { result: { email, tagged: true } };\n}\n"
      }
    }
  },
