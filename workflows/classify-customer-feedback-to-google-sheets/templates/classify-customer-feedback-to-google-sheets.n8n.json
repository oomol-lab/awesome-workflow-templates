    {
      "name": "Make the feedback row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $(\"Submit form with customer feedback\").first().json,\n  r = $input.first().json;\nif (\n  r.finish_reason === \"length\" ||\n  typeof r.message?.content !== \"string\" ||\n  !r.message.content.trim()\n)\n  throw Error(\"Invalid model result\");\nreturn [\n  {\n    json: {\n      Timestamp: f.submittedAt,\n      Category: f[\"What is your feedback about?\"],\n      \"Customer Feedback\": f[\"Your feedback\"],\n      \"Customer Name\": f.Name,\n      \"Customer contact\": f[\"How do we get in touch with you?\"] ?? \"\",\n      \"Entered by\": \"Form\",\n      Sentiment: r.message.content.trim(),\n    },\n  },\n];\n"
      },
      "id": "classify-customer-feedback-to-google-sheets-2",
      "position": [
        520,
        300
      ]
    },
