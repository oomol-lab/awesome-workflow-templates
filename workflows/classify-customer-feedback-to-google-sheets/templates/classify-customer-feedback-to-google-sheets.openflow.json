    "modules": {
      "n_66ec263eae7d3c1a": {
        "name": "Prepare feedback",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  if (\n    !body ||\n    typeof body.name !== \"string\" ||\n    !body.name.trim() ||\n    typeof body.category !== \"string\" ||\n    !body.category.trim() ||\n    typeof body.feedback !== \"string\" ||\n    !body.feedback.trim() ||\n    (body.contact != null && typeof body.contact !== \"string\")\n  )\n    throw Error(\"Provide name, category and feedback\");\n  return {\n    form: {\n      name: body.name,\n      category: body.category,\n      feedback: body.feedback,\n      contact: body.contact ?? \"\",\n      submittedAt: new Date().toISOString(),\n    },\n    feedback: body.feedback,\n  };\n}\n"
      },
      "n_3c22737eddf361b7": {
        "name": "Make the feedback row",
        "imports": [],
        "source": "export default function row({ form, sentiment }) {\n  if (typeof sentiment !== \"string\" || !sentiment.trim())\n    throw Error(\"Model returned an empty sentiment\");\n  return {\n    values: [\n      [\n        form.submittedAt,\n        form.category,\n        form.feedback,\n        form.name,\n        form.contact,\n        \"Form\",\n        sentiment.trim(),\n      ],\n    ],\n  };\n}\n"
      }
    }
