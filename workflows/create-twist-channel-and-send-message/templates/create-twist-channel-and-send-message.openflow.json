    "modules": {
      "n_5f603d6fd9668380": {
        "name": "Prepare the channel",
        "imports": [],
        "source": "export default function prepare({ workspaceId, userId }) {\n  return { body: { workspace_id: workspaceId, name: \"n8n-docs\", user_ids: [userId] } };\n}\n"
      },
      "n_b99253fb0ac5f19f": {
        "name": "Prepare the description",
        "imports": [],
        "source": "export default function update({ channel }) {\n  if (\n    !channel ||\n    typeof channel !== \"object\" ||\n    !Number.isSafeInteger(channel.id) ||\n    channel.id <= 0 ||\n    typeof channel.name !== \"string\" ||\n    !channel.name\n  )\n    throw Error(\"Twist did not return a channel ID and name\");\n  return {\n    body: { id: channel.id, description: \"Discussion for documentation\" },\n    name: channel.name,\n  };\n}\n"
      },
      "n_2f9f8e1af32eddec": {
        "name": "Prepare the message",
        "imports": [],
        "source": "export default function message({ workspaceId, userId, conversationId, name }) {\n  return {\n    body: {\n      conversation_id: conversationId,\n      workspace_id: workspaceId,\n      content:\n        \"Hey [Recipient](twist-mention://\" +\n        userId +\n        \")!\\nYou have been added to the \" +\n        name +\n        \" channel.\\nClick on the button below to quickly navigate to the documentation website.\",\n      actions: [\n        {\n          url: \"https://docs.n8n.io\",\n          type: \"action\",\n          action: \"open_url\",\n          button_text: \"Documentation site\",\n        },\n      ],\n    },\n  };\n}\n"
      }
    }
