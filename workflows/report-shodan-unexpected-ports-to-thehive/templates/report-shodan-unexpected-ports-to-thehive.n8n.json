        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'shodan:' + $('Validate watched IP').item.json.week + ':' + $('Validate watched IP').item.json.ip }}",
