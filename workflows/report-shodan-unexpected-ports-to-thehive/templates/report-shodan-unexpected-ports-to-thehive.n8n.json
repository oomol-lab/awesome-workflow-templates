    {
      "id": "report-shodan-unexpected-ports-to-thehive-11",
      "name": "Scan each IP",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2420,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.shodan.io/shodan/host/' + encodeURIComponent($('Validate watched IP').item.json.ip) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth"
      },
      "typeVersion": 4.2
    },
    {
      "name": "Prepare incident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Validate watched IP\").item.json;\nif ($json.ip_str !== p.ip) throw Error(\"Shodan host does not match requested IP\");\nif (!Array.isArray($json.data)) throw Error(\"Shodan response lacks services\");\nconst bad = $json.data.filter((s) => Number.isInteger(s.port) && !p.ports.includes(s.port));\nreturn {\n  json: {\n    has: bad.length > 0,\n    title: \"Unexpected ports for \" + p.ip,\n    reference: p.ip + \":\" + p.week,\n    description:\n      \"Unexpected open ports:\\n\\n\" +\n      bad\n        .map(\n          (s) =>\n            \"- port \" +\n            s.port +\n            \"; hostnames \" +\n            (s.hostnames ?? $json.hostnames ?? []).join(\", \") +\n            \"; \" +\n            String(s.description ?? \"\") +\n            \" \" +\n            String(s.data ?? \"\"),\n        )\n        .join(\"\\n\"),\n  },\n};\n"
      },
      "id": "report-shodan-unexpected-ports-to-thehive-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Unexpected ports found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.has }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "report-shodan-unexpected-ports-to-thehive-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "id": "report-shodan-unexpected-ports-to-thehive-14",
      "name": "Create TheHive alert",
      "type": "n8n-nodes-base.theHive",
      "position": [
        3080,
        0
      ],
      "parameters": {
        "date": "={{$now}}",
        "tags": "={{ $('Validate watched IP').item.json.ip }}",
        "type": "Unexpected open port",
        "title": "={{ $('Prepare incident').item.json.title }}",
        "source": "n8n",
        "sourceRef": "={{ $('Prepare incident').item.json.reference }}",
        "description": "={{ $('Prepare incident').item.json.description }}",
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Verify alert or relay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json._id && !$json.id && $json.status !== \"completed\") throw Error(\"Unknown alert result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "report-shodan-unexpected-ports-to-thehive-15",
      "position": [
        3300,
        0
      ]
    },
    {
      "name": "Confirm IP report",
      "type": "n8n-nodes-base.dataTable",
