    {
      "id": "report-shodan-unexpected-ports-to-thehive-1",
      "name": "Get watched IPs & Ports",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "YOUR_WATCHLIST_ENDPOINT",
        "options": {}
      },
      "typeVersion": 4.1
    },
    {
      "id": "report-shodan-unexpected-ports-to-thehive-2",
      "name": "For each IP",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [
        440,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "typeVersion": 3
    },
    {
      "name": "Validate watched IP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { ip, ports } = $json;\nif (\n  typeof ip !== \"string\" ||\n  !ip ||\n  !/^[0-9a-fA-F:.]+$/.test(ip) ||\n  !Array.isArray(ports) ||\n  ports.some((p) => !Number.isInteger(p) || p < 1 || p > 65535)\n)\n  throw Error(\"Invalid watched IP or allowed ports\");\nreturn { json: { ip, ports, week: $now.startOf(\"week\").toISODate(), mode: \"direct\" } };\n"
      },
      "id": "report-shodan-unexpected-ports-to-thehive-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "IP not processed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'shodan:' + $('Validate watched IP').item.json.week + ':' + $('Validate watched IP').item.json.ip }}"
            }
          ]
        }
      },
      "id": "report-shodan-unexpected-ports-to-thehive-4",
      "position": [
        880,
        0
      ]
    },
