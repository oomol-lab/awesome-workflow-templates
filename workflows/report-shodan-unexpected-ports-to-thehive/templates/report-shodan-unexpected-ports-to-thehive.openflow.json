    "modules": {
      "n_b496a9a89cb7accc": {
        "name": "Validate IP and ports",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const ip = String(body.ip || \"\").trim(),\n    ports = body.ports,\n    week = String(body.week || \"\");\n  if (\n    !ip ||\n    !/^[0-9a-fA-F:.]+$/.test(ip) ||\n    !Array.isArray(ports) ||\n    ports.some((p) => !Number.isInteger(p) || p < 1 || p > 65535) ||\n    !/^\\d{4}-\\d\\d-\\d\\d$/.test(week)\n  )\n    throw Error(\"Expected IP, allowed ports and week date\");\n  return { ip, ports, week };\n}\n"
      },
      "n_b830fcc798a923e7": {
        "name": "Find and reserve unexpected ports",
        "imports": [],
        "source": "export default async function plan({ host, ip, ports, week, acknowledge, resolution }, ctx) {\n  if (host?.ip_str !== ip) throw Error(\"Shodan host does not match requested IP\");\n  if (!Array.isArray(host?.data)) throw Error(\"Shodan response lacks services\");\n  const bad = host.data.filter((x) => Number.isInteger(x.port) && !ports.includes(x.port));\n  const key = \"shodan:\" + week + \":\" + ip,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\")\n    return { send: false, key, title: \"No alert\", description: \"\", reference: \"none\", tags: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect TheHive alert \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { send: false, key, title: \"No alert\", description: \"\", reference: \"none\", tags: [] };\n    }\n  }\n  if (bad.length === 0) {\n    if (old?.status === \"pending\") await ctx.state.set(key, null);\n    return { send: false, key, title: \"No alert\", description: \"\", reference: \"none\", tags: [] };\n  }\n  const lines = bad.map(\n    (x) =>\n      `- port ${x.port}; hostnames ${(x.hostnames ?? host.hostnames ?? []).join(\", \")}; ${String(x.description ?? \"\")} ${String(x.data ?? \"\")}`,\n  );\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    send: true,\n    key,\n    title: \"Unexpected ports for \" + ip,\n    description: \"Unexpected open ports:\\n\\n\" + lines.join(\"\\n\"),\n    reference: ip + \":\" + week,\n    tags: [ip],\n  };\n}\n"
      },
      "n_08766f6a8b4983af": {
        "name": "Confirm alert",
        "imports": [],
        "source": "export default async function f({ key, alert }, ctx) {\n  if (!alert?._id) throw Error(\"Unknown alert result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_0a5640696148f606": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
  },
