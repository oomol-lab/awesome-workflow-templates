    "modules": {
      "n_f9fe5bcdba365328": {
        "name": "Format refund notification",
        "imports": [],
        "source": "export default function refundMessage({ body }) {\n  const escape = (text) => text.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n  if (!Number.isSafeInteger(body.id) || body.id < 1)\n    throw new Error(\"WooCommerce order ID is missing or invalid\");\n  for (const field of [\"status\", \"total\", \"currency\", \"date_modified\"])\n    if (typeof body[field] !== \"string\") throw new Error(\"WooCommerce order is missing \" + field);\n  const money =\n    typeof body.currency_symbol === \"string\" && body.currency_symbol\n      ? body.currency_symbol + body.total\n      : body.currency + \" \" + body.total;\n  const footer = \"*Order updated:* \" + escape(body.date_modified);\n  if (footer.length > 300) throw new Error(\"Order timestamp exceeds Slack footer size\");\n  const text = \":x: A refund has been issued :x:\";\n  return {\n    text,\n    attachments: [\n      {\n        color: \"#FF0000\",\n        fallback: text,\n        fields: [\n          { title: \"Order ID\", value: String(body.id), short: true },\n          { title: \"Status\", value: escape(body.status), short: true },\n          { title: \"Total\", value: escape(money), short: true },\n        ],\n        footer,\n      },\n    ],\n  };\n}\n"
      },
      "n_b0aecb00b36ccae1": {
        "name": "Read order total and status",
        "imports": [],
        "source": "export default function orderAmount({ body }) {\n  if (\n    typeof body.total !== \"string\" ||\n    !/^\\d+(?:\\.\\d+)?$/.test(body.total) ||\n    !Number.isFinite(Number(body.total))\n  )\n    throw new Error(\"WooCommerce order total must be a nonnegative decimal string\");\n  if (typeof body.status !== \"string\" || !body.status)\n    throw new Error(\"WooCommerce order status is missing\");\n  return { total: Number(body.total), status: body.status };\n}\n"
      }
