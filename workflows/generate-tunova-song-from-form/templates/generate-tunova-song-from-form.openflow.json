    "modules": {
      "n_fe6da791dd358ce0": {
        "name": "Prepare the generation request",
        "imports": [],
        "source": "import { randomUUID } from \"node:crypto\";\nfunction prepareSong(prompt, instrumental, reference, generatedReference) {\n  if (typeof prompt !== \"string\" || !prompt.trim() || prompt.trim().length > 2000) {\n    throw new Error(\"Enter a song prompt of 1–2,000 characters.\");\n  }\n  if (typeof instrumental !== \"boolean\")\n    throw new Error(\"Choose whether the song is instrumental.\");\n  const hasReference = reference != null && reference !== \"\";\n  const key = hasReference ? reference : generatedReference;\n  if (\n    typeof key !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(key)\n  ) {\n    throw new Error(\"Use a random UUID v4 as your submission reference, or leave it blank.\");\n  }\n  return {\n    key: \"song-form-\" + key.toLowerCase(),\n    body: { prompt: prompt.trim(), make_instrumental: instrumental, model: \"v6\" },\n  };\n}\nexport default ({ body }) =>\n  prepareSong(body.prompt, body.instrumental ?? false, body.reference, randomUUID());\n"
      },
      "n_7962540f541f808f": {
        "name": "Confirm the job ID",
        "imports": [],
        "source": "function acceptedSongJob(reply, statusCode) {\n  const jobId = reply?.job_id;\n  if (statusCode !== 202 || typeof jobId !== \"string\" || !/^[a-zA-Z0-9_-]{1,128}$/.test(jobId)) {\n    throw new Error(\"Tunova did not confirm a job ID. Check Tunova before submitting again.\");\n  }\n  return { jobId, url: \"https://api.tunova.ai/api/jobs/\" + jobId };\n}\nexport default ({ body, statusCode }) => acceptedSongJob(body, statusCode);\n"
      },
      "n_a0c250f99bf12190": {
        "name": "Read the job status and first track",
        "imports": [],
        "source": "function readSongJob(reply, statusCode, jobId) {\n  const status = reply?.status;\n  if (\n    statusCode !== 200 ||\n    reply?.job_id !== jobId ||\n    ![\"queued\", \"processing\", \"submitted\", \"complete\", \"failed\"].includes(status)\n  ) {\n    throw new Error(\"Tunova did not return a valid status for the submitted job.\");\n  }\n  const result = { job_id: jobId, status, audio_url: null, title: null };\n  if (status !== \"complete\") return result;\n\n  const clip = Array.isArray(reply.clips) ? reply.clips[0] : undefined;\n  if (\n    typeof clip?.audio_url !== \"string\" ||\n    !/^https:\\/\\/(?:[a-z\\d](?:[a-z\\d-]*[a-z\\d])?\\.)+[a-z]{2,}(?:[/?#][^\\s\\\\\"<>]*)?$/i.test(\n      clip.audio_url,\n    )\n  ) {\n    throw new Error(\"Tunova marked the job complete without a valid first audio URL.\");\n  }\n  result.audio_url = clip.audio_url;\n  result.title = typeof clip.title === \"string\" && clip.title.trim() ? clip.title : null;\n  return result;\n}\nexport default ({ body, statusCode, jobId }) => readSongJob(body, statusCode, jobId);\n"
      }
