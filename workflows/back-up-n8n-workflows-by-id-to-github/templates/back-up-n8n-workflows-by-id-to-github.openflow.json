ject.entries(x).sort(([a], [b]) => a.localeCompare(b))));\n    if (sort(JSON.parse(s.existing)) === sort(s.queue[s.index])) {\n      s.index++;\n      s.phase = \"item\";\n    } else s.phase = \"write\";\n    delete s.existing;\n  }\n  await ctx.state.set(\"workflow-backup\", s);\n  return { ok: true };\n}\n\nexport default async function run({ statusCode, body }, ctx) {\n  return result({ kind: \"get\", statusCode, body }, ctx);\n}\n"
