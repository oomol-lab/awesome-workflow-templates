        "source": "import { Buffer } from \"node:buffer\";\nexport default async function next({ baseUrl, owner, repo, path, acknowledge }, ctx) {\n  if (\n    !/^https:\\/\\//.test(baseUrl) ||\n    baseUrl.includes(\"YOUR_\") ||\n    [owner, repo].some((x) => !x || x.includes(\"YOUR_\"))\n  )\n    throw Error(\"Configure n8n URL, GitHub repository, \");\n  let s = await ctx.state.get(\"workflow-backup\");\n  if (!s) {\n    s = {\n      phase: \"list\",\n      cursor: null,\n      nextCursor: null,\n      queue: [],\n      index: 0,\n      total: 0,\n      failed: 0,\n      pending: null,\n    };\n    await ctx.state.set(\"workflow-backup\", s);\n  }\n  if (s.pending) {\n    if (acknowledge !== s.pending) throw Error(\"Inspect external write \" + s.pending);\n    if (s.pending === \"slack:start\") s.phase = \"list\";\n    else if (s.pending === \"slack:complete\") s.phase = \"done\";\n    else if (s.pending.startsWith(\"slack:fail:\")) {\n      s.index++;\n      s.phase = \"item\";\n    } else if (s.pending.startsWith(\"github:\")) {\n      s.index++;\n      s.phase = \"item\";\n    }\n    s.pending = null;\n    await ctx.state.set(\"workflow-backup\", s);\n  }\n  for (;;) {\n    let action = s.phase,\n      url = \"https://api.github.com/\",\n      body = {},\n      text = \".\",\n      item = s.queue[s.index];\n    if (action === \"item\") {\n      if (!item) {\n        if (s.nextCursor) {\n          s.cursor = s.nextCursor;\n          s.nextCursor = null;\n          s.phase = \"list\";\n        } else s.phase = \"done\";\n        await ctx.state.set(\"workflow-backup\", s);\n        continue;\n      }\n      if (!item.id) throw Error(\"Workflow must include id\");\n      s.filePath = path\n        .replace(/^\\/+|\\/+$/g, \"\")\n        .split(\"/\")\n        .filter(Boolean)\n        .concat(String(item.id) + \".json\")\n        .map(encodeURIComponent)\n        .join(\"/\");\n      s.phase = \"get\";\n      await ctx.state.set(\"workflow-backup\", s);\n      continue;\n    }\n    if (action === \"list\")\n      url =\n        baseUrl.replace(/\\/$/, \"\") +\n        \"/api/v1/workflows?limit=100\" +\n        (s.cursor ? \"&cursor=\" + encodeURIComponent(s.cursor) : \"\");\n    if (action === \"get\" || action === \"raw\" || action === \"write\")\n      url =\n        \"https://api.github.com/repos/\" +\n        encodeURIComponent(owner) +\n        \"/\" +\n        encodeURIComponent(repo) +\n        \"/contents/\" +\n        s.filePath;\n    if (action === \"write\") {\n      const sorted = Object.fromEntries(\n        Object.entries(item).sort(([a], [b]) => a.localeCompare(b)),\n      );\n      body = {\n        message: (item.name ?? item.id) + \" (\" + (s.sha ? \"different\" : \"new\") + \")\",\n        content: Buffer.from(JSON.stringify(sorted, null, 2)).toString(\"base64\"),\n        ...(s.sha ? { sha: s.sha } : {}),\n      };\n      s.pending = \"github:\" + item.id;\n      await ctx.state.set(\"workflow-backup\", s);\n    }\n    if (action === \"start\" || action === \"complete\" || action === \"failure\") {\n      text =\n        action === \"start\"\n          ? \"Starting workflow backup\"\n          : action === \"complete\"\n            ? \"Backup completed: \" + s.total + \" workflows; \" + s.failed + \" failed\"\n            : \"Failed to back up workflow \" + item.id;\n      s.pending = action === \"failure\" ? \"slack:fail:\" + item.id : \"slack:\" + action;\n      await ctx.state.set(\"workflow-backup\", s);\n    }\n    if (action === \"done\") {\n      await ctx.state.set(\"workflow-backup\", null);\n    }\n    return { action, url, body, text };\n  }\n}\n"
      },
      "n_d0a36a0043b5e122": {
        "name": "Confirm list",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nasync function result({ kind, statusCode, body }, ctx) {\n  const s = await ctx.state.get(\"workflow-backup\");\n  if (!s) throw Error(\"Missing backup state\");\n  if (kind === \"start\") {\n    s.pending = null;\n    s.phase = \"list\";\n  } else if (kind === \"complete\") {\n    s.pending = null;\n    s.phase = \"done\";\n  } else if (kind === \"failure\") {\n    s.pending = null;\n    s.index++;\n    s.phase = \"item\";\n  } else if (kind === \"list\") {\n    if (statusCode !== 200 || !Array.isArray(body.data)) throw Error(\"Cannot list n8n workflows\");\n    s.queue = body.data;\n    s.index = 0;\n    s.total += body.data.length;\n    s.nextCursor = body.nextCursor ?? null;\n    s.phase = \"item\";\n  } else if (kind === \"get\") {\n    if (statusCode === 404) {\n      s.sha = null;\n      s.phase = \"write\";\n    } else if (statusCode === 200 && typeof body.sha === \"string\") {\n      s.sha = body.sha;\n      if (body.content) {\n        s.existing = Buffer.from(body.content.replace(/\\s/g, \"\"), \"base64\").toString(\"utf8\");\n        s.phase = \"compare\";\n      } else s.phase = \"raw\";\n    } else throw Error(\"GitHub read failed \" + statusCode);\n  } else if (kind === \"raw\") {\n    if (statusCode === 200 && typeof body === \"string\") {\n      s.existing = body;\n      s.phase = \"compare\";\n    } else throw Error(\"GitHub read failed \" + statusCode);\n  } else if (kind === \"write\") {\n    if (statusCode === 200 || statusCode === 201) {\n      s.pending = null;\n      s.index++;\n      s.phase = \"item\";\n    } else if (statusCode >= 400 && statusCode < 500) {\n      s.pending = null;\n      await ctx.state.set(\"workflow-backup\", s);\n      throw Error(\"GitHub write rejected \" + statusCode);\n    } else throw Error(\"Inspect uncertain GitHub write \" + s.queue[s.index].id);\n  }\n  if (s.phase === \"compare\") {\n    const sort = (x) =>\n      JSON.stringify(Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))));\n    if (sort(JSON.parse(s.existing)) === sort(s.queue[s.index])) {\n      s.index++;\n      s.phase = \"item\";\n    } else s.phase = \"write\";\n    delete s.existing;\n  }\n  await ctx.state.set(\"workflow-backup\", s);\n  return { ok: true };\n}\n\nexport default async function run({ statusCode, body }, ctx) {\n  return result({ kind: \"list\", statusCode, body }, ctx);\n}\n"
      },
