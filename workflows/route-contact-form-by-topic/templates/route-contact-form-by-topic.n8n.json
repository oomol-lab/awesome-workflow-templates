        "specifyBody": "json",
        "jsonBody": "={{ {kind:\"classify\",name:$json.form.Name,email:$json.form.Email,message:$json.form.Message,submittedAt:$json.form.submittedAt,category:\"\",recipient:\"\"} }}",
