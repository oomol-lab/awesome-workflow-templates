    {
      "id": "route-contact-form-by-topic-choose-mode",
      "name": "Choose mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mode = \"direct\";\nif (![\"direct\", \"relay\"].includes(mode)) throw Error(\"Choose direct or relay\");\nreturn { json: { mode, form: $json } };\n"
      },
      "position": [
        0,
        0
      ]
    },
