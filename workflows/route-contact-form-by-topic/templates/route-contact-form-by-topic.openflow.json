    "modules": {
      "n_28cd626bb627d537": {
        "name": "Choose department",
        "imports": [],
        "source": "export default function route({ classification, name, email, message, submittedAt }) {\n  const category = classification.category;\n  const routes = {\n    \"Request Quote\": \"YOUR_QUOTE_DEPARTMENT_EMAIL\",\n    \"Product info\": \"YOUR_PRODUCT_DEPARTMENT_EMAIL\",\n    \"General problem\": \"YOUR_GENERAL_DEPARTMENT_EMAIL\",\n    Order: \"YOUR_ORDER_DEPARTMENT_EMAIL\",\n    other: \"YOUR_OTHER_DEPARTMENT_EMAIL\",\n  };\n  const recipient = routes[category];\n  if (!recipient) throw Error(\"Invalid classification\");\n  return { response: { name, email, message, submittedAt, category, recipient } };\n}\n"
      },
      "n_49eebd815063d8e2": {
        "name": "Prepare contact log row",
        "imports": [],
        "source": "export default function row({ name, email, message, submittedAt, category, recipient }) {\n  return { values: [[submittedAt, name, email, message, category, JSON.stringify([recipient])]] };\n}\n"
      },
      "n_ea49f40ff98f6cd3": {
        "name": "Return step response",
        "imports": [],
        "source": "export default function result({ selected, updated }) {\n  if (selected != null) return { response: selected };\n  if (updated != null) return { response: { logged: true } };\n  throw Error(\"Missing result\");\n}\n"
      }
    }
  },
