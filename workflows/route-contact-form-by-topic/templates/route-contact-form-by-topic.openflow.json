    "modules": {
      "n_055e70617bc2abf2": {
        "name": "Choose department",
        "imports": [],
        "source": "export default function ({ classification, body, quote, product, general, order, other }) {\n  const routes = {\n    \"Request Quote\": quote,\n    \"Product info\": product,\n    \"General problem\": general,\n    Order: order,\n    other,\n  };\n  const category = classification?.category;\n  const to = routes[category];\n  if (!to || to.includes(\"YOUR_\")) throw Error(\"Configure department recipient\");\n  if (!body?.name || !body?.email || !body?.message) throw Error(\"Missing contact fields\");\n  return {\n    to,\n    subject: \"[Contact] \" + category,\n    emailBody: \"Name: \" + body.name + \"\\nEmail: \" + body.email + \"\\n\\nMessage:\\n\" + body.message,\n    values: [[new Date().toISOString(), body.name, body.email, body.message, category, to]],\n  };\n}\n"
      }
    },
