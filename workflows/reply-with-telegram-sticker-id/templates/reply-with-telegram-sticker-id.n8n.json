{
  "nodes": [
    {
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        450,
        300
      ],
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "typeVersion": 1,
      "id": "reply-with-telegram-sticker-id-0"
    },
    {
      "name": "Return Sticker",
      "type": "n8n-nodes-base.telegram",
      "position": [
        850,
        200
      ],
      "parameters": {
        "text": "={{ `Hi ${$json.message.from?.first_name || 'there'}!\\nThe ID of the sticker is: ${$json.message.sticker.file_id}\\nIt is part of the sticker-set: ${$json.message.sticker.set_name || 'not available'}` }}",
        "chatId": "={{ $json.message.chat.id }}",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "reply-with-telegram-sticker-id-1"
    },
    {
      "name": "Return no Sticker found",
      "type": "n8n-nodes-base.telegram",
      "position": [
        850,
        400
      ],
      "parameters": {
        "text": "={{ `Hi ${$json.message.from?.first_name || 'there'}!\\nYour message did not contain any sticker.` }}",
        "chatId": "={{ $json.message.chat.id }}",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "reply-with-telegram-sticker-id-2"
    },
    {
      "name": "Look for Sticker",
      "type": "n8n-nodes-base.if",
      "position": [
        650,
        300
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!$json.message.sticker }}",
              "value2": true
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "reply-with-telegram-sticker-id-3"
    }
  ],
  "connections": {
    "Look for Sticker": {
      "main": [
        [
          {
            "node": "Return Sticker",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return no Sticker found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Look for Sticker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Reply with a Telegram Sticker ID",
  "active": false,
  "pinData": {}
}
