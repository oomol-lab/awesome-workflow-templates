    "modules": {
      "n_e7d152535524dbb3": {
        "name": "Select authorized command",
        "imports": [],
        "source": "export default async function (\n  { body, allowedChatId, marketingId, salesId, baseUrl, acknowledgeId },\n  ctx,\n) {\n  const none = { more: false, url: \"\", workflowId: \"\", active: false, updateId: \"\" };\n  if (\n    !/^-?\\d+$/.test(allowedChatId ?? \"\") ||\n    !marketingId ||\n    marketingId.startsWith(\"YOUR_\") ||\n    !salesId ||\n    salesId.startsWith(\"YOUR_\") ||\n    !/^https:\\/\\//.test(baseUrl ?? \"\")\n  )\n    throw Error(\"Configure chat, workflow IDs and HTTPS n8n URL\");\n  const msg = body?.message;\n  if (String(msg?.chat?.id ?? \"\") !== allowedChatId || typeof msg?.text !== \"string\") return none;\n  const match = msg.text.trim().match(/^\\/(start|stop)\\s+(marketing|sales)$/i);\n  if (!match) return none;\n  if (!Number.isSafeInteger(body.update_id)) throw Error(\"Missing Telegram update ID\");\n  const id = String(body.update_id),\n    action = match[1].toLowerCase(),\n    target = match[2].toLowerCase(),\n    workflowId = target === \"marketing\" ? marketingId : salesId,\n    s = (await ctx.state.get(\"telegram-control\")) ?? { pending: null, queue: [], done: [] };\n  if (!s.done.includes(id) && s.pending?.id !== id && !s.queue.some((x) => x.id === id)) {\n    s.queue.push({ id, action, workflowId });\n    await ctx.state.set(\"telegram-control\", s);\n  }\n  if (s.pending) {\n    if (acknowledgeId !== s.pending.id) throw Error(\"Inspect pending command \" + s.pending.id);\n    s.done.push(s.pending.id);\n    s.pending = null;\n    await ctx.state.set(\"telegram-control\", s);\n  }\n  if (!s.queue.length) return none;\n  const item = s.queue.shift();\n  s.pending = item;\n  await ctx.state.set(\"telegram-control\", s);\n  return {\n    more: true,\n    updateId: item.id,\n    workflowId: item.workflowId,\n    active: item.action === \"start\",\n    url:\n      baseUrl.replace(/\\/+$/, \"\") +\n      \"/api/v1/workflows/\" +\n      encodeURIComponent(item.workflowId) +\n      \"/\" +\n      (item.action === \"start\" ? \"activate\" : \"deactivate\"),\n  };\n}\n"
      },
      "n_de8833a0964b7366": {
        "name": "Confirm workflow state",
        "imports": [],
        "source": "export default async function ({ response, updateId, workflowId, active }, ctx) {\n  if (response?.id !== workflowId || response.active !== active)\n    throw Error(\"Workflow status not confirmed\");\n  const s = await ctx.state.get(\"telegram-control\");\n  if (s?.pending?.id !== updateId) throw Error(\"Pending command mismatch\");\n  s.done.push(updateId);\n  s.pending = null;\n  await ctx.state.set(\"telegram-control\", s);\n  return { done: true };\n}\n"
      }
