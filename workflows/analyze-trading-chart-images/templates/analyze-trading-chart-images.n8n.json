        "mode": "runOnceForEachItem",
        "jsCode": "if (!$binary?.data) throw Error(\"Send an image as binary.data\");\nconst id = $json.headers?.[\"x-request-id\"];\nif (typeof id !== \"string\" || !id.trim()) throw Error(\"Set a unique X-Request-ID header\");\nreturn { json: { submissionId: id.trim() }, binary: $binary };\n"
