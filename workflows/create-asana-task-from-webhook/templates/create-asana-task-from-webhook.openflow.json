    "modules": {
      "n_9855b9f8a9ad5fdf": {
        "name": "Read the task name",
        "imports": [],
        "source": "export default function asanaTaskQuery({ query }) {\n  const value = query?.parameter;\n  if (typeof value !== 'string' || !value.trim()) throw new Error('Provide one nonblank parameter query value for the task name');\n  return { name: value.trim() };\n}\n"
      },
      "n_5b8af3f0598fe0a1": {
        "name": "Create the task in Asana",
        "imports": [],
        "source": "export default async function createAsanaTask({name,workspaceId,projectIds},context){return await context.actions.call('asana.create_task',{name,workspaceId,projectIds,includeFields:['gid','name','permalink_url']});}\n"
      },
      "n_070d63ba899b5916": {
        "name": "Confirm the saved task link",
        "imports": [],
        "source": "export default function asanaTaskResponse({ task }) {\n  if (!task || typeof task !== 'object' || Array.isArray(task) || typeof task.gid !== 'string' || !task.gid.trim()) throw new Error('Asana did not return a saved task ID; check the project before retrying');\n  if (typeof task.permalink_url !== 'string' || !/^https:\\/\\/app\\.asana\\.com\\/\\S+$/.test(task.permalink_url)) throw new Error('Asana did not return a valid task permalink; the task may already exist');\n  return { task, response: 'Created Asana Task:  ' + task.permalink_url };\n}\n"
      }
    }
