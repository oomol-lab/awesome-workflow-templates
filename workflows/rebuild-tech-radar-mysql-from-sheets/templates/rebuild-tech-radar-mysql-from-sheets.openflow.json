    "modules": {
      "n_649c4d1a41caa385": {
        "name": "Reserve monthly refresh",
        "imports": [],
        "source": "export default async function plan({ values, ack, resolution }, ctx) {\n  const names = [\n    \"name\",\n    \"ring\",\n    \"quadrant\",\n    \"isStrategicDirection\",\n    \"isUsedByChildCompany1\",\n    \"isUsedByChildCompany2\",\n    \"isUsedByChildCompany3\",\n    \"isNew\",\n    \"status\",\n    \"description\",\n  ];\n  if (!Array.isArray(values)) throw Error(\"Invalid sheet data\");\n  let rows = [];\n  if (values.length) {\n    let header = values[0],\n      idx = names.map((n) => header.indexOf(n));\n    if (idx.some((i) => i < 0)) throw Error(\"Missing required column\");\n    rows = values\n      .slice(1)\n      .filter((r) => r.some((x) => x !== \"\" && x !== null))\n      .map((r) => Object.fromEntries(names.map((n, i) => [n, r[idx[i]] ?? \"\"])));\n  }\n  const runId = new Date().toISOString().slice(0, 7),\n    key = \"radar-refresh:\" + runId;\n  let s = await ctx.state.get(key);\n  if (s?.phase === \"pending\") {\n    if (ack !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending refresh \" + key);\n    if (resolution === \"confirmed\") {\n      s.phase = \"done\";\n      await ctx.state.set(key, s);\n    } else s.phase = \"ready\";\n  }\n  if (s?.phase === \"done\") return { key, runId, action: \"done\", request: { runId, rows } };\n  await ctx.state.set(key, { phase: \"pending\" });\n  return { key, runId, action: \"send\", request: { runId, rows } };\n}\n"
      },
      "n_d9987aca49211568": {
        "name": "Confirm monthly refresh",
        "imports": [],
        "source": "export default async function confirm({ key, runId, status, body }, ctx) {\n  if (status !== 200 || body?.runId !== runId || body?.status !== \"done\")\n    throw Error(\"Inspect MySQL refresh\");\n  let s = await ctx.state.get(key);\n  if (s?.phase !== \"pending\") throw Error(\"Missing pending refresh\");\n  await ctx.state.set(key, { phase: \"done\" });\n  return { ok: true };\n}\n"
      }
