    "modules": {
      "n_e0d874ce1dfade52": {
        "name": "Find today’s company meetings",
        "imports": [],
        "source": "export default async function meetings({ calendarId }, context) {\n  if (!calendarId || calendarId.startsWith(\"YOUR_\")) throw Error(\"Configure calendar ID\");\n  const now = new Date(),\n    start = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())),\n    end = new Date(start.getTime() + 86400000);\n  let token = null,\n    seen = new Set(),\n    events = [];\n  do {\n    const page = await context.actions.call(\"googlecalendar.list_events\", {\n      calendarId,\n      timeMin: start.toISOString(),\n      timeMax: end.toISOString(),\n      singleEvents: true,\n      maxResults: 250,\n      ...(token ? { pageToken: token } : {}),\n    });\n    if (!Array.isArray(page.items)) throw Error(\"Invalid calendar response\");\n    for (const e of page.items)\n      if (typeof e.summary === \"string\" && /^(call with|meeting with)\\s+/i.test(e.summary)) {\n        const company = e.summary\n          .toLowerCase()\n          .replace(/^(call with|meeting with)\\s+/, \"\")\n          .trim();\n        if (company) events.push({ summary: e.summary, company });\n      }\n    const next = page.nextPageToken ?? null;\n    if (next && seen.has(next)) throw Error(\"Repeated calendar cursor\");\n    if (next) seen.add(next);\n    token = next;\n  } while (token);\n  return { events };\n}\n"
      },
      "n_b6a5d79494f92c1e": {
        "name": "Get news for next meeting",
        "imports": [],
        "source": "export default async function next(\n  { events, previousState, apiKey, recipient, newsAge, maxArticles },\n  context,\n) {\n  if (\n    !Array.isArray(events) ||\n    !recipient ||\n    recipient.includes(\"YOUR_\") ||\n    !apiKey ||\n    !Number.isInteger(newsAge) ||\n    newsAge < 0 ||\n    !Number.isInteger(maxArticles) ||\n    maxArticles < 1 ||\n    maxArticles > 100\n  )\n    throw Error(\"Configure recipient and NewsAPI key\");\n  const index = previousState?.index ?? 0;\n  if (index === events.length)\n    return { state: { index }, more: false, to: recipient, subject: \"-\", body: \"-\" };\n  const e = events[index],\n    now = new Date(),\n    from = new Date(now.getTime() - newsAge * 86400000).toISOString().slice(0, 10),\n    url = new URL(\"https://newsapi.org/v2/everything\");\n  for (const [k, v] of Object.entries({\n    q: e.company,\n    from,\n    sortBy: \"publishedAt\",\n    language: \"en\",\n    pageSize: String(maxArticles),\n    searchIn: \"title\",\n  }))\n    url.searchParams.set(k, v);\n  const r = await context.fetch(url.href, { headers: { \"X-Api-Key\": apiKey } });\n  if (!r.ok) throw Error(\"NewsAPI request failed\");\n  const data = await r.json();\n  if (!Array.isArray(data.articles)) throw Error(\"Invalid NewsAPI response\");\n  const esc = (v) =>\n    String(v ?? \"\").replace(\n      /[&<>\"']/g,\n      (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n    );\n  const rows = data.articles\n    .map((a) => {\n      let link = \"\";\n      try {\n        const u = new URL(a.url);\n        if ([\"https:\", \"http:\"].includes(u.protocol)) link = u.href;\n      } catch {}\n      return (\n        '<tr><td><a href=\"' +\n        esc(link) +\n        '\">' +\n        esc(a.title) +\n        \"</a><p>\" +\n        esc(a.description ?? a.content) +\n        \"</p><b>Source:</b> \" +\n        esc(a.source?.name) +\n        \"</td></tr>\"\n      );\n    })\n    .join(\"\");\n  return {\n    state: { index: index + 1 },\n    more: true,\n    to: recipient,\n    subject: \"Latest news for \" + e.company,\n    body: \"<table>\" + rows + \"</table>\",\n  };\n}\n"
      }
    }
