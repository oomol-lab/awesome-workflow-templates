{
  "nodes": [
    {
      "id": "sync-tagged-n8n-workflows-to-notion-0",
      "name": "Every 15 minutes UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        560,
        340
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "sync-tagged-n8n-workflows-to-notion-1",
      "name": "Read tagged workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [
        780,
        340
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "tags": "sync-to-notion"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Prepare the workflows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function next({ state, previous, instanceUrl, dataSourceId }) {\n  if (\n    !Array.isArray(state?.items) ||\n    typeof instanceUrl !== \"string\" ||\n    !/^https:\\/\\/[^/?#\\s]+\\/$/i.test(instanceUrl) ||\n    instanceUrl.includes(\"YOUR_\") ||\n    typeof dataSourceId !== \"string\" ||\n    !dataSourceId ||\n    dataSourceId.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure an HTTPS instance URL and Notion data source ID\");\n  const i = previous?.index ?? 0;\n  if (!Number.isInteger(i) || i < 0) throw Error(\"Invalid workflow index\");\n  if (i >= state.items.length) return { state: { index: i }, more: false, item: {}, dataSourceId };\n  const w = state.items[i];\n  if (\n    !w ||\n    typeof w.id !== \"string\" ||\n    !w.id ||\n    typeof w.name !== \"string\" ||\n    !w.name ||\n    typeof w.active !== \"boolean\" ||\n    typeof w.createdAt !== \"string\" ||\n    !Number.isFinite(Date.parse(w.createdAt)) ||\n    typeof w.updatedAt !== \"string\" ||\n    !Number.isFinite(Date.parse(w.updatedAt)) ||\n    !w.settings ||\n    typeof w.settings !== \"object\" ||\n    Array.isArray(w.settings)\n  )\n    throw Error(\"Invalid workflow data\");\n  return {\n    state: { index: i + 1 },\n    more: true,\n    item: {\n      id: w.id,\n      name: w.name,\n      active: w.active,\n      createdAt: w.createdAt,\n      updatedAt: w.updatedAt,\n      errorWorkflow: !!w.settings.errorWorkflow,\n      url: instanceUrl + \"workflow/\" + encodeURIComponent(w.id),\n      envId: \"internal-\" + w.id,\n    },\n    dataSourceId,\n  };\n}\n\nconst items = $input.all().map((x) => x.json),\n  out = [];\nlet previous = null;\nwhile (true) {\n  const x = next({\n    state: { items },\n    previous,\n    instanceUrl: \"https://YOUR_N8N_HOST/\",\n    dataSourceId: \"YOUR_NOTION_DATA_SOURCE_ID\",\n  });\n  if (!x.more) break;\n  out.push({\n    json: { item: x.item, dataSourceId: x.dataSourceId },\n    pairedItem: { item: out.length },\n  });\n  previous = x.state;\n}\nreturn out;\n"
      },
      "id": "sync-tagged-n8n-workflows-to-notion-2"
    },
    {
      "name": "Sync one workflow at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "sync-tagged-n8n-workflows-to-notion-3"
    },
    {
      "name": "Find the inventory entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://api.notion.com/v1/data_sources/\" + encodeURIComponent($json.dataSourceId) + \"/query\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{property:\"env id\",rich_text:{equals:$json.item.envId}},page_size:2}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "id": "sync-tagged-n8n-workflows-to-notion-4"
    },
    {
      "name": "Prepare the inventory entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function decide({ result, item, dataSourceId }) {\n  if (\n    !result ||\n    !Array.isArray(result.results) ||\n    typeof result.has_more !== \"boolean\" ||\n    result.has_more ||\n    result.results.length > 1\n  )\n    throw Error(\"Ambiguous Notion workflow match\");\n  const existing = result.results[0];\n  if (existing && (existing.object !== \"page\" || typeof existing.id !== \"string\" || !existing.id))\n    throw Error(\"Invalid Notion match\");\n  const text = (x) => [{ text: { content: String(x) } }],\n    props = {\n      Name: { title: text(item.name) },\n      \"env id\": { rich_text: text(item.envId) },\n      \"URL (dev)\": { url: item.url },\n      \"isActive (dev)\": { checkbox: item.active },\n      \"Workflow created at\": { date: { start: item.createdAt } },\n      \"Workflow updated at\": { date: { start: item.updatedAt } },\n      \"Error workflow setup\": { checkbox: item.errorWorkflow },\n    };\n  return {\n    create: !existing,\n    pageId: existing?.id ?? \"unused\",\n    parent: { data_source_id: dataSourceId },\n    properties: props,\n  };\n}\n\nconst x = $(\"Sync one workflow at a time\").item.json;\nreturn [\n  {\n    json: decide({ result: $input.first().json, item: x.item, dataSourceId: x.dataSourceId }),\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "sync-tagged-n8n-workflows-to-notion-5"
    },
    {
      "name": "Create a new entry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "create",
              "leftValue": "={{ $json.create }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "sync-tagged-n8n-workflows-to-notion-6"
    },
    {
      "name": "Create the inventory entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({parent:$json.parent,properties:$json.properties}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "id": "sync-tagged-n8n-workflows-to-notion-7"
    },
    {
      "name": "Update the inventory entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ \"https://api.notion.com/v1/pages/\" + encodeURIComponent($json.pageId) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({properties:$json.properties}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      },
      "id": "sync-tagged-n8n-workflows-to-notion-8"
    },
    {
      "name": "Confirm the inventory write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function confirm({ page }) {\n  if (!page || page.object !== \"page\" || typeof page.id !== \"string\" || !page.id)\n    throw Error(\"Notion write was not confirmed\");\n  return { ok: true };\n}\n\nreturn [{ json: confirm({ page: $input.first().json }), pairedItem: { item: 0 } }];\n"
      },
      "id": "sync-tagged-n8n-workflows-to-notion-9"
    }
  ],
  "pinData": {},
