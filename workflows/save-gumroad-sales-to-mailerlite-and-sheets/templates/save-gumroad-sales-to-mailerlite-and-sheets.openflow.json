    "modules": {
      "n_c38663437defee48": {
        "name": "Prepare subscriber and sale",
        "imports": [],
        "source": "export default function sale({ body }) {\n  const { email, ip_country, sale_timestamp, product_name } = body.event;\n  if (!email || !sale_timestamp || !product_name) throw Error(\"Missing Gumroad sale fields\");\n  return {\n    request: { email, fields: { country: ip_country || \"\" } },\n    values: [[sale_timestamp, product_name, email, ip_country || \"\"]],\n  };\n}\n"
      },
      "n_4c81bdc53059bd7f": {
        "name": "Prepare group assignment",
        "imports": [],
        "source": "export default function group({ status, body, groupId }) {\n  const id = body?.data?.id;\n  if (status < 200 || status >= 300 || !id || !groupId || groupId.startsWith(\"YOUR_\"))\n    throw Error(\"Subscriber creation or group configuration failed\");\n  return {\n    url: `https://connect.mailerlite.com/api/subscribers/${encodeURIComponent(id)}/groups/${encodeURIComponent(groupId)}`,\n  };\n}\n"
      },
      "n_4f32c905a260b441": {
        "name": "Confirm group assignment",
        "imports": [],
        "source": "export default function confirm({ status, values }) {\n  if (status < 200 || status >= 300) throw Error(\"MailerLite group assignment failed\");\n  return { values };\n}\n"
      }
    }
