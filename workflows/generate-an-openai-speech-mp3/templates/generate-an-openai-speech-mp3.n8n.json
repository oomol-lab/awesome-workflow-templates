      ],
      "parameters": {
        "color": 4,
        "width": 273,
        "height": 278,
        "content": "### Input\n\nSet input_text to at most 4096 characters and voice to a supported tts-1 voice, initially alloy. Keep your OpenAI key in the credential. The text is sent to OpenAI for speech generation."
      },
      "typeVersion": 1
    },
    {
      "id": "generate-an-openai-speech-mp3-7",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1020,
        620
      ],
      "parameters": {
        "color": 4,
        "width": 299,
        "height": 278,
        "content": "### Output and availability\n\nThe HTTP node returns an MP3 in binary field data. No automatic retries are configured. Disclose that the recording is AI-generated when sharing it. OpenAI has announced tts-1 shutdown on 2027-01-06; plan migration before then. https://developers.openai.com/api/docs/guides/text-to-speech"
      },
      "typeVersion": 1
    },
    {
      "id": "generate-an-openai-speech-mp3-8",
      "name": "Validate Speech Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prepare = function prepare({input_text,voice}){if(typeof input_text!=='string'||!input_text.trim()||Array.from(input_text).length>4096)throw Error('Supply text with 1–4096 characters');const selected=voice||'alloy';if(!['alloy','ash','coral','echo','fable','onyx','nova','sage','shimmer'].includes(selected))throw Error('Unsupported voice');return{input_text,voice:selected}}\n\nreturn $input.all().map((item,index)=>({json:prepare(item.json),pairedItem:{item:index}}));"
      }
    },
    {
      "id": "generate-an-openai-speech-mp3-9",
      "name": "Validate Audio File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst result = [];\nfor (let index = 0; index < items.length; index++) {\n  const item = items[index];\n  const audio = item.binary?.data;\n  const type = typeof audio?.mimeType === 'string' ? audio.mimeType.split(';')[0].trim().toLowerCase() : '';\n  if (!['audio/mpeg', 'audio/mp3', 'application/octet-stream'].includes(type)) throw new Error('The speech response is not MP3 audio.');\n  const bytes = await this.helpers.getBinaryDataBuffer(index, 'data');\n  if (!bytes.length) throw new Error('The speech response is empty.');\n  result.push({...item, binary:{...item.binary,data:{...audio,fileName:'speech.mp3',mimeType:'audio/mpeg'}},pairedItem:{item:index}});\n}\nreturn result;\n"
      }
    }
  ],
