    "modules": {
      "n_4edfa86bac813768": {
        "name": "Validate speech input",
        "imports": [],
        "source": "export default function prepare({input_text,voice}){if(typeof input_text!=='string'||!input_text.trim()||Array.from(input_text).length>4096)throw Error('Supply text with 1–4096 characters');const selected=voice||'alloy';if(!['alloy','ash','coral','echo','fable','onyx','nova','sage','shimmer'].includes(selected))throw Error('Unsupported voice');return{input_text,voice:selected}}\n"
      },
      "n_78e5b70d5e5d0ecd": {
        "name": "Save audio artifact",
        "imports": [],
        "source": "import { Buffer } from 'node:buffer';\n\nexport default async function saveSpeech({ content_base64, content_type }, context) {\n  if (typeof content_base64 !== 'string' || !content_base64 || content_base64.length % 4 !== 0 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(content_base64)) throw new Error('The speech response does not contain valid base64 audio.');\n  const mediaType = typeof content_type === 'string' ? content_type.split(';')[0].trim().toLowerCase() : '';\n  if (!['audio/mpeg', 'audio/mp3', 'application/octet-stream'].includes(mediaType)) throw new Error('The speech response is not MP3 audio.');\n  const bytes = new Uint8Array(Buffer.from(content_base64, 'base64'));\n  if (!bytes.length || Buffer.from(bytes).toString('base64') !== content_base64) throw new Error('The speech response is empty or has invalid base64 padding.');\n  return { audio: await context.artifact.put(bytes, { name: 'speech.mp3', mediaType: 'audio/mpeg' }) };\n}\n"
      }
    }
