{
  "name": "Rocket.Chat Message Sender",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "rocketchat-message-sender-0"
    },
    {
      "name": "Rocketchat",
      "type": "n8n-nodes-base.rocketchat",
      "position": [
        450,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "postMessage",
        "channel": "#YOUR_CHANNEL",
        "text": "YOUR_MESSAGE_TEXT",
        "options": {},
        "jsonParameters": false,
        "attachments": []
      },
      "typeVersion": 1,
      "id": "rocketchat-message-sender-1"
    },
    {
      "id": "rocketchat-message-sender-check",
      "name": "Confirm Rocket.Chat message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function readRocketMessage(message, success) {\n  if (\n    success !== true ||\n    !message ||\n    typeof message !== \"object\" ||\n    Array.isArray(message) ||\n    typeof message._id !== \"string\" ||\n    message._id.length === 0 ||\n    typeof message.rid !== \"string\" ||\n    message.rid.length === 0 ||\n    typeof message.msg !== \"string\"\n  )\n    throw new Error(\"Rocket.Chat did not confirm a sent message\");\n  return message;\n}\nfunction rocketChatResult({ message, success }) {\n  return { message: readRocketMessage(message, success) };\n}\n\nreadRocketMessage($json.message, $json.success);\nreturn { json: $json };\n"
      }
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Rocketchat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rocketchat": {
      "main": [
        [
          {
            "node": "Confirm Rocket.Chat message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
