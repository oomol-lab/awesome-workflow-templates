    "modules": {
      "n_b4f3d4e1add44844": {
        "name": "Confirm Rocket.Chat message",
        "imports": [],
        "source": "function readRocketMessage(message, success) {\n  if (\n    success !== true ||\n    !message ||\n    typeof message !== \"object\" ||\n    Array.isArray(message) ||\n    typeof message._id !== \"string\" ||\n    message._id.length === 0 ||\n    typeof message.rid !== \"string\" ||\n    message.rid.length === 0 ||\n    typeof message.msg !== \"string\"\n  )\n    throw new Error(\"Rocket.Chat did not confirm a sent message\");\n  return message;\n}\nexport default function rocketChatResult({ message, success }) {\n  return { message: readRocketMessage(message, success) };\n}\n"
      }
    }
