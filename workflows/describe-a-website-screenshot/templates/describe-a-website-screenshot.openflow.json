    "modules": {
      "n_92fc22598087ab6e": {
        "name": "Choose a website",
        "imports": [],
        "source": "export default function prepare({websiteName,url}){if(typeof websiteName!=='string'||!websiteName.trim())throw Error('Enter a website name');let u;try{u=new URL(url)}catch{throw Error('Enter a valid HTTP or HTTPS URL')}if(!['http:','https:'].includes(u.protocol)||u.username||u.password)throw Error('Enter a public HTTP or HTTPS URL without credentials');return{body:{url:u.href,full_page:true},websiteName:websiteName.trim(),url:u.href}}\n"
      },
      "n_09c3d1f5e7fa50e1": {
        "name": "Prepare vision request",
        "imports": [],
        "source": "export default function vision({response}){const u=response?.renderUrl;if(typeof u!=='string'||!/^https:\\/\\//i.test(u))throw Error('URLbox did not return a screenshot URL');return{input:[{role:'user',content:[{type:'input_text',text:'Your input is a screenshot of a website. Describe the content of the website in one sentence.'},{type:'input_image',image_url:u}]}]}}\n"
      },
      "n_dfce561e31f55177": {
        "name": "Keep website and description together",
        "imports": [],
        "source": "export default function result({response,websiteName,url}){const text=typeof response?.output_text==='string'?response.output_text:(Array.isArray(response?.output)?response.output.flatMap(x=>Array.isArray(x.content)?x.content.filter(y=>y.type==='output_text'&&typeof y.text==='string').map(y=>y.text):[]).join('\\n'):'');if(response?.status!=='completed'||!text.trim())throw Error('Vision analysis did not return a completed description');return{result:{websiteName,url,description:text.trim()}}}\n"
      }
    }
  },
