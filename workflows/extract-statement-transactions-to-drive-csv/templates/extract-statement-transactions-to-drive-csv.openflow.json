    "modules": {
      "n_7596fa1ee79aa934": {
        "name": "Read statement text",
        "imports": [],
        "source": "export default function unpack({ body }) {\n  if (!body?.text) throw Error(\"Missing statement text\");\n  return { text: body.text };\n}\n"
      },
      "n_48d70bb8b092f7d9": {
        "name": "Prepare CSV upload",
        "imports": [],
        "source": "export default async function prepare({ body, csv, relayUrl, acknowledge, resolution }, ctx) {\n  if (!body?.fileId || !body?.text) throw Error(\"Missing source ID or statement text\");\n  if (!/^https:\\/\\//.test(relayUrl)) throw Error(\"Configure HTTPS CSV relay\");\n  const raw = String(csv).trim();\n  if (!raw || raw.startsWith(\"```\") || !raw.split(/\\r?\\n/, 1)[0].toLowerCase().includes(\"category\"))\n    throw Error(\"Expected CSV with a category header\");\n  const key = \"csv:\" + body.fileId,\n    s = await ctx.state.get(key);\n  if (s?.status === \"done\") return { send: false, key, url: relayUrl, request: {} };\n  if (s?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown Drive upload \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { send: false, key, url: relayUrl, request: {} };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { send: true, key, url: relayUrl, request: { fileId: body.fileId, csv: raw } };\n}\n"
      },
      "n_d2462d1b5f586036": {
        "name": "Confirm Drive upload",
        "imports": [],
        "source": "export default async function confirm({ key, statusCode, body }, ctx) {\n  if (statusCode !== 200 || !body?.fileId) throw Error(\"Drive upload outcome unknown\");\n  await ctx.state.set(key, { status: \"done\", fileId: body.fileId });\n  return { ok: true };\n}\n"
      }
    }
