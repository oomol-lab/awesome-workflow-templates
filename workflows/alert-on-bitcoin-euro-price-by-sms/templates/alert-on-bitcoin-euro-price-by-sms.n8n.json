{
  "name": "Alert on Bitcoin Euro Price by SMS",
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        590,
        500
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "alert-on-bitcoin-euro-price-by-sms-0"
    },
    {
      "name": "CoinGecko",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        790,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=eur",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2,
      "id": "alert-on-bitcoin-euro-price-by-sms-1"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        990,
        500
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$node[\"CoinGecko\"].json[\"bitcoin\"][\"eur\"]}}",
              "value2": 9000,
              "operation": "largerEqual"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "alert-on-bitcoin-euro-price-by-sms-2"
    },
    {
      "name": "Twilio",
      "type": "n8n-nodes-base.twilio",
      "position": [
        1190,
        400
      ],
      "parameters": {
        "to": "YOUR_RECIPIENT_NUMBER",
        "from": "YOUR_TWILIO_NUMBER",
        "message": "=The price went up! The new price is {{$node[\"CoinGecko\"].json[\"bitcoin\"][\"eur\"]}}"
      },
      "typeVersion": 1,
      "id": "alert-on-bitcoin-euro-price-by-sms-3"
    },
    {
      "name": "NoOp",
      "type": "n8n-nodes-base.noOp",
      "position": [
        1190,
        600
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "alert-on-bitcoin-euro-price-by-sms-4"
    }
  ],
  "active": false,
  "settings": {
    "timezone": "UTC"
  },
  "connections": {
    "IF": {
      "main": [
        [
          {
            "node": "Twilio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NoOp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron": {
      "main": [
        [
          {
            "node": "CoinGecko",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CoinGecko": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
