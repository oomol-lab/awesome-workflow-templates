    "modules": {
      "n_bbd6ccfe93ddcedb": {
        "name": "Check the threshold",
        "imports": [],
        "source": "export default function alert({ prices, threshold, to, from }) {\n  const price = prices?.bitcoin?.eur;\n  if (typeof price !== \"number\" || !Number.isFinite(price) || price < 0)\n    throw Error(\"CoinGecko returned no valid Bitcoin EUR price\");\n  if (typeof threshold !== \"number\" || !Number.isFinite(threshold) || threshold < 0)\n    throw Error(\"Set a nonnegative EUR threshold\");\n  for (const n of [to, from])\n    if (typeof n !== \"string\" || !/^\\+[1-9]\\d{7,14}$/.test(n))\n      throw Error(\"Set Twilio numbers in E.164 format\");\n  return {\n    matched: price >= threshold,\n    to,\n    from,\n    message: `The price went up! The new price is ${price}`,\n  };\n}\n"
      }
    }
