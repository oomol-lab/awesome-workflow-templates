    "modules": {
      "n_e6c6de9ae30f8318": {
        "name": "Select authorized resume",
        "imports": [],
        "source": "export default async function next({ body, allowedChatId, acknowledgeId }, ctx) {\n  if (!/^-?\\d+$/.test(allowedChatId)) throw Error(\"Configure the allowed Telegram chat ID\");\n  const s = (await ctx.state.get(\"resume-reports\")) ?? { queue: [], pending: null, done: [] },\n    m = body?.message,\n    id = String(body?.update_id ?? \"\");\n  if (\n    String(m?.chat?.id ?? \"\") === allowedChatId &&\n    typeof m?.document?.file_id === \"string\" &&\n    /^\\d+$/.test(id) &&\n    !s.done.includes(id) &&\n    !s.queue.some((x) => x.id === id)\n  ) {\n    s.queue.push({ id, chatId: allowedChatId, fileId: m.document.file_id });\n    await ctx.state.set(\"resume-reports\", s);\n  }\n  if (s.pending) {\n    if (acknowledgeId !== s.pending)\n      throw Error(\"Inspect Telegram PDF delivery for update \" + s.pending);\n    s.done.push(s.pending);\n    s.queue = s.queue.filter((x) => x.id !== s.pending);\n    s.pending = null;\n    await ctx.state.set(\"resume-reports\", s);\n  }\n  if (!s.queue.length) return { more: false, id: \"\", chatId: \"\", body: {} };\n  const x = s.queue[0];\n  return { more: true, id: x.id, chatId: x.chatId, body: { fileId: x.fileId } };\n}\n"
      },
      "n_4dc70bc970418071": {
        "name": "Validate extracted text",
        "imports": [],
        "source": "export default async function text({ response }) {\n  if (typeof response?.text !== \"string\" || !response.text.trim())\n    throw Error(\"The PDF did not contain readable text\");\n  return { text: response.text };\n}\n"
      },
      "n_b90086c86e2387df": {
        "name": "Format resume as HTML",
        "imports": [],
        "source": "export default async function render({ resume, id, chatId }) {\n  const e = (x) =>\n      String(x ?? \"\")\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\"),\n    list = (x) => (Array.isArray(x) ? x : []),\n    p = resume.personal_info ?? {},\n    sections = [\n      [\n        \"Personal info\",\n        [\n          [\"Name\", p.name],\n          [\"Address\", p.address],\n          [\"Email\", p.email],\n          [\"GitHub\", p.github],\n          [\"LinkedIn\", p.linkedin],\n        ],\n      ],\n      [\n        \"Employment history\",\n        list(resume.employment_history).map((x) => [\n          [\"Position\", x.position],\n          [\"Company\", x.company],\n          [\"Duration\", x.duration],\n          [\"Responsibilities\", list(x.responsibilities).join(\"; \")],\n        ]),\n      ],\n      [\n        \"Education\",\n        list(resume.education).map((x) => [\n          [\"Institution\", x.institution],\n          [\"Start year\", x.start_year],\n          [\"Degree\", x.degree],\n        ]),\n      ],\n      [\n        \"Projects\",\n        list(resume.projects).map((x) => [\n          [\"Name\", x.name],\n          [\"Year\", x.year],\n          [\"Description\", x.description],\n          [\"Technologies\", list(x.technologies).join(\", \")],\n        ]),\n      ],\n      [\n        \"Volunteering\",\n        list(resume.volunteering).map((x) => [\n          [\"Activity\", x.activity],\n          [\"Location\", x.location],\n          [\"Date\", x.date],\n          [\"Description\", x.description],\n        ]),\n      ],\n      [\n        \"Technologies\",\n        [\n          [\"Programming languages\", list(resume.programming_languages?.languages).join(\", \")],\n          [\"Tools\", list(resume.programming_languages?.tools).join(\", \")],\n          [\"Methodologies\", list(resume.programming_languages?.methodologies).join(\", \")],\n        ],\n      ],\n    ];\n  const html =\n    '<!doctype html><html><head><meta charset=\"utf-8\"><title>Resume</title></head><body>' +\n    sections\n      .map(\n        ([title, data]) =>\n          \"<h2>\" +\n          e(title) +\n          \"</h2>\" +\n          (data.length && Array.isArray(data[0][0]) ? data : [data])\n            .map(\n              (group) =>\n                \"<p>\" + group.map(([k, v]) => \"<b>\" + e(k) + \":</b> \" + e(v)).join(\"<br>\") + \"</p>\",\n            )\n            .join(\"\"),\n      )\n      .join(\"\") +\n    \"</body></html>\";\n  const filename =\n    (String(p.name ?? \"resume\")\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, \"-\")\n      .replace(/^-|-$/g, \"\") || \"resume\") + \".pdf\";\n  return { body: { id, chatId, html, filename } };\n}\n"
      },
      "n_436cdb4338c558a1": {
        "name": "Checkpoint PDF delivery",
        "imports": [],
        "source": "export default async function pending({ id }, ctx) {\n  const s = await ctx.state.get(\"resume-reports\");\n  if (!s || s.queue[0]?.id !== id || s.pending) throw Error(\"Resume report state mismatch\");\n  s.pending = id;\n  await ctx.state.set(\"resume-reports\", s);\n  return { ok: true };\n}\n"
      },
      "n_75a4ce965847617a": {
        "name": "Confirm PDF delivery",
        "imports": [],
        "source": "export default async function done({ id, response }, ctx) {\n  if (response?.ok !== true) throw Error(\"PDF delivery not confirmed\");\n  const s = await ctx.state.get(\"resume-reports\");\n  if (!s || s.pending !== id) throw Error(\"Resume report state mismatch\");\n  s.pending = null;\n  s.queue.shift();\n  s.done.push(id);\n  await ctx.state.set(\"resume-reports\", s);\n  return { ok: true };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
