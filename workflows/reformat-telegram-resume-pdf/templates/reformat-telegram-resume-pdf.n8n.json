    {
      "id": "reformat-telegram-resume-pdf-final-16",
      "name": "Parse resume data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1660,
        120
      ],
      "parameters": {
        "prompt": "={{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "Your task is to extract all necessary data such as first name, last name, experience, known technologies etc. from the provided resume text and return in well-unified JSON format. Do not make things up."
            }
          ]
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "reformat-telegram-resume-pdf-final-17",
      "name": "Format structured resume",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "async function render({ resume, id, chatId }) {\n  const e = (x) =>\n      String(x ?? \"\")\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\"),\n    list = (x) => (Array.isArray(x) ? x : []),\n    p = resume.personal_info ?? {},\n    sections = [\n      [\n        \"Personal info\",\n        [\n          [\"Name\", p.name],\n          [\"Address\", p.address],\n          [\"Email\", p.email],\n          [\"GitHub\", p.github],\n          [\"LinkedIn\", p.linkedin],\n        ],\n      ],\n      [\n        \"Employment history\",\n        list(resume.employment_history).map((x) => [\n          [\"Position\", x.position],\n          [\"Company\", x.company],\n          [\"Duration\", x.duration],\n          [\"Responsibilities\", list(x.responsibilities).join(\"; \")],\n        ]),\n      ],\n      [\n        \"Education\",\n        list(resume.education).map((x) => [\n          [\"Institution\", x.institution],\n          [\"Start year\", x.start_year],\n          [\"Degree\", x.degree],\n        ]),\n      ],\n      [\n        \"Projects\",\n        list(resume.projects).map((x) => [\n          [\"Name\", x.name],\n          [\"Year\", x.year],\n          [\"Description\", x.description],\n          [\"Technologies\", list(x.technologies).join(\", \")],\n        ]),\n      ],\n      [\n        \"Volunteering\",\n        list(resume.volunteering).map((x) => [\n          [\"Activity\", x.activity],\n          [\"Location\", x.location],\n          [\"Date\", x.date],\n          [\"Description\", x.description],\n        ]),\n      ],\n      [\n        \"Technologies\",\n        [\n          [\"Programming languages\", list(resume.programming_languages?.languages).join(\", \")],\n          [\"Tools\", list(resume.programming_languages?.tools).join(\", \")],\n          [\"Methodologies\", list(resume.programming_languages?.methodologies).join(\", \")],\n        ],\n      ],\n    ];\n  const html =\n    '<!doctype html><html><head><meta charset=\"utf-8\"><title>Resume</title></head><body>' +\n    sections\n      .map(\n        ([title, data]) =>\n          \"<h2>\" +\n          e(title) +\n          \"</h2>\" +\n          (data.length && Array.isArray(data[0][0]) ? data : [data])\n            .map(\n              (group) =>\n                \"<p>\" + group.map(([k, v]) => \"<b>\" + e(k) + \":</b> \" + e(v)).join(\"<br>\") + \"</p>\",\n            )\n            .join(\"\"),\n      )\n      .join(\"\") +\n    \"</body></html>\";\n  const filename =\n    (String(p.name ?? \"resume\")\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, \"-\")\n      .replace(/^-|-$/g, \"\") || \"resume\") + \".pdf\";\n  return { body: { id, chatId, html, filename } };\n}\n\nconst result = await render({ resume: $json, id: \"\", chatId: \"\" });\nreturn [{ json: { output: result.body.html } }];\n"
      }
    },
