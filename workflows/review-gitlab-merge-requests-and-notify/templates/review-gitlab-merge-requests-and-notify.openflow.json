    "modules": {
      "n_a11a94b3762163c3": {
        "name": "Identify merge request",
        "imports": [],
        "source": "export default function event({ body }) {\n  const e = body?.event ?? body,\n    p = e?.project?.path_with_namespace,\n    a = e?.object_attributes,\n    i = a?.iid,\n    commit = a?.last_commit?.id;\n  if (\n    e?.object_kind !== \"merge_request\" ||\n    typeof p !== \"string\" ||\n    !p ||\n    !Number.isInteger(i) ||\n    i < 1 ||\n    typeof commit !== \"string\" ||\n    !commit\n  )\n    throw Error(\"Invalid merge request event\");\n  const base = \"/projects/\" + encodeURIComponent(p) + \"/merge_requests/\" + i;\n  return {\n    event: {\n      project: p,\n      iid: i,\n      commit,\n      author: a?.last_commit?.author?.email ?? \"\",\n      user: e?.user?.name ?? \"\",\n      name: e?.project?.name ?? p,\n    },\n    endpoint: base + \"/changes\",\n    noteEndpoint: base + \"/notes\",\n  };\n}\n"
      },
      "n_a51a18fc3be3273c": {
        "name": "Check changes",
        "imports": [],
        "source": "export default function diff({ body, statusCode, bodyEncoding, event }) {\n  if (\n    statusCode !== 200 ||\n    bodyEncoding ||\n    !Array.isArray(body?.changes) ||\n    typeof body.web_url !== \"string\"\n  )\n    throw Error(\"Invalid merge request changes\");\n  if (body.iid !== event.iid) throw Error(\"Merge request mismatch\");\n  return {\n    changed: body.changes.length > 0,\n    diff: JSON.stringify(\n      body.changes.map((x) => ({ old_path: x.old_path, new_path: x.new_path, diff: x.diff })),\n    ),\n    url: body.web_url,\n  };\n}\n"
      },
      "n_be7181c3046145cb": {
        "name": "Select recipients",
        "imports": [],
        "source": "export default function recipients({ event, mapping, global }) {\n  const specific = mapping[event.project] ?? [],\n    all = [...specific, ...global, event.author].filter(Boolean);\n  if (\n    !all.length ||\n    all.some((x) => typeof x !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(x) || x.includes(\"YOUR_\"))\n  )\n    throw Error(\"Configure recipients\");\n  return { to: [...new Set(all)].join(\", \") };\n}\n"
      },
      "n_1bbcaad24e38e564": {
        "name": "Reserve merge request comment",
        "imports": [],
        "source": "export default async function reserve({ event, operation, acknowledge, resolution }, ctx) {\n  const key =\n      \"gitlab-review:\" + event.project + \":\" + event.iid + \":\" + event.commit + \":\" + operation,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, write: false };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, write: false };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, write: true };\n}\n"
      },
      "n_052a0319cf1e2def": {
        "name": "Prepare comment",
        "imports": [],
        "source": "export default function f({ text }) {\n  return { body: { body: text } };\n}\n"
      },
      "n_79dd91561c7cd58f": {
        "name": "Confirm comment",
        "imports": [],
        "source": "export default async function f({ key, body, statusCode }, ctx) {\n  if (statusCode < 200 || statusCode >= 300 || !body?.id)\n    throw Error(\"Unknown GitLab comment result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_78e5a4f5aed8fd78": {
        "name": "Reserve review email",
        "imports": [],
        "source": "export default async function reserve({ event, operation, acknowledge, resolution }, ctx) {\n  const key =\n      \"gitlab-review:\" + event.project + \":\" + event.iid + \":\" + event.commit + \":\" + operation,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, write: false };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, write: false };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, write: true };\n}\n"
      },
      "n_ff5b0e7f5ec25a7e": {
        "name": "Prepare email",
        "imports": [],
        "source": "export default function f({ event, text }) {\n  return { subject: \"Merge request review - \" + event.project + \" !\" + event.iid, body: text };\n}\n"
      },
      "n_af681b559cb05854": {
        "name": "Confirm review email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown Gmail result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
