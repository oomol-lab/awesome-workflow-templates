        "name": "Route and name items",
        "imports": [],
        "source": "export default function branches() {\n  const rows = [{ id: 0 }, { id: 1 }],\n    zero = [],\n    other = [];\n  for (const row of rows)\n    (row.id === 0 ? zero : other).push({ ...row, name: row.id === 0 ? \"n8n\" : \"nodemation\" });\n  return { zero, other };\n}\n"
