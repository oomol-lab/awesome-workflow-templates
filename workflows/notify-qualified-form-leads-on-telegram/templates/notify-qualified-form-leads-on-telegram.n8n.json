    },
    {
      "id": "notify-qualified-form-leads-on-telegram-hunter",
      "name": "Validate Hunter result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"n8n Form Trigger\").item.json[\"What's your business email?\"];\nif (\n  typeof $json.email !== \"string\" ||\n  typeof e !== \"string\" ||\n  $json.email.toLowerCase() !== e.trim().toLowerCase() ||\n  ![\"valid\", \"invalid\", \"accept_all\", \"webmail\", \"disposable\", \"unknown\"].includes($json.status)\n)\n  throw Error(\"Incomplete Hunter assessment\");\nreturn { json: $json };\n"
      }
    },
    {
      "id": "notify-qualified-form-leads-on-telegram-fit",
      "name": "Validate customer fit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"Verify email with Hunter\").item.json.email,\n  f = $json.properties?.customer_fit;\nif (\n  typeof $json.email !== \"string\" ||\n  $json.email.toLowerCase() !== e.toLowerCase() ||\n  !f ||\n  typeof f.score !== \"number\" ||\n  !Number.isFinite(f.score) ||\n  typeof (f.top_signals_formated ?? f.top_signals_formatted) !== \"string\"\n)\n  throw Error(\"Incomplete customer fit\");\nif (\n  (\n    \"⭐ New hot lead: \" +\n    $json.email +\n    \"...\\n\\n\" +\n    (f.top_signals_formated ?? f.top_signals_formatted)\n  ).length > 4096\n)\n  throw Error(\"Telegram message exceeds limit\");\nreturn { json: $json };\n"
      }
    }
