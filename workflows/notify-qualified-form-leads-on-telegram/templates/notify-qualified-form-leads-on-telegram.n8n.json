        500,
        560
      ],
      "parameters": {
        "text": "=⭐ New hot lead: {{ $json.email }}... \n\n{{ $json.properties.customer_fit.top_signals_formated ?? $json.properties.customer_fit.top_signals_formatted }}",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "additionalFields": {}
      },
