        "imports": [],
        "source": "export default function weatherMessage({weather}){if(weather?.cod!==200||typeof weather?.main?.temp!=='number'||!Number.isFinite(weather.main.temp))throw Error('OpenWeather response has no current temperature');return{message:`Hey! The temperature outside is ${weather.main.temp}°C.`}}\n"
