    "modules": {
      "n_367c99e1c166aa77": {
        "name": "Validate server and request",
        "imports": [],
        "source": "export default function f({ body, headers, secret, server, engine }) {\n  const token = Object.entries(headers).find(([k]) => k.toLowerCase() === \"authorization\")?.[1];\n  let valid =\n    !!secret &&\n    token === secret &&\n    body.server_domain === server &&\n    body.command === \"container_information_inspect\" &&\n    /^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,200}$/.test(body.domain);\n  if (!valid) throw Error(\"Invalid request\");\n  return {\n    valid,\n    url: valid\n      ? engine.replace(/\\/$/, \"\") + \"/v1.44/containers/\" + encodeURIComponent(body.domain) + \"/json\"\n      : engine,\n    result: { status: \"error\", message: \"Invalid request\", data: \"\" },\n  };\n}\n"
      },
      "n_50753f2120c5fcf8": {
        "name": "Format inspection result",
        "imports": [],
        "source": "export default function f({ status, body }) {\n  if (status === 404) return { result: { status: \"success\", message: \"\", data: { inspect: {} } } };\n  if (status < 200 || status >= 300 || !body || typeof body !== \"object\")\n    return { result: { status: \"error\", message: \"Docker inspection failed\", data: \"\" } };\n  return { result: { status: \"success\", message: \"\", data: { inspect: [body] } } };\n}\n"
      }
    }
