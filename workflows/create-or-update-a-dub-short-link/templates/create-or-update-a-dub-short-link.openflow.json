    "modules": {
      "n_14ae0e92db471f51": {
        "name": "Configure the link",
        "imports": [],
        "source": "export default function prepare({ url, projectSlug, domain, key }) {\n  if (!/^https?:\\/\\//.test(url) || !projectSlug || projectSlug.startsWith(\"YOUR_\"))\n    throw Error(\"Set a destination URL and project slug\");\n  return {\n    body: {\n      url,\n      comments: \"Updated using N8N.io workflow: dub.co URL Shortener\",\n      ...(domain ? { domain } : {}),\n      ...(key ? { key } : {}),\n    },\n    projectSlug,\n    domain,\n    key,\n  };\n}\n"
      },
      "n_443fa7b677f1fd5e": {
        "name": "Check creation result",
        "imports": [],
        "source": "export default function decide({ statusCode, body, domain, key }) {\n  if (statusCode >= 200 && statusCode < 300) {\n    if (typeof body?.shortLink !== \"string\" || !body.shortLink)\n      throw Error(\"Created short link missing\");\n    return { conflict: false, shortLink: body.shortLink };\n  }\n  if (\n    statusCode === 409 &&\n    body?.error?.code === \"conflict\" &&\n    body.error.message === \"Duplicate key: This short link already exists.\" &&\n    domain &&\n    key\n  )\n    return { conflict: true, shortLink: \"\" };\n  throw Error(\"Dub creation failed; check the error and configure domain and key for a duplicate\");\n}\n"
      },
      "n_8094c5e2e9e77443": {
        "name": "Keep new short link",
        "imports": [],
        "source": "export default function keep({ shortLink }) {\n  return { shortLink };\n}\n"
      },
      "n_d40b459f2ed54fba": {
        "name": "Confirm the existing link",
        "imports": [],
        "source": "export default function existing({ statusCode, body, domain, key }) {\n  if (statusCode !== 200 || !body?.id || body.domain !== domain || body.key !== key)\n    throw Error(\"Existing link not confirmed for this domain and key\");\n  return { id: body.id };\n}\n"
      },
      "n_00d0dab94d068b30": {
        "name": "Choose link endpoint",
        "imports": [],
        "source": "export default function path({ id }) {\n  return { endpoint: \"/links/\" + encodeURIComponent(id) };\n}\n"
      },
      "n_73cc080ab603105e": {
        "name": "Confirm updated link",
        "imports": [],
        "source": "export default function result({ statusCode, body }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    typeof body?.shortLink !== \"string\" ||\n    !body.shortLink\n  )\n    throw Error(\"Updated link not confirmed\");\n  return { shortLink: body.shortLink };\n}\n"
      }
    }
  },
