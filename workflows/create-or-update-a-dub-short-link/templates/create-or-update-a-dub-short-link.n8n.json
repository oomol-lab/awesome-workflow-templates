    },
    {
      "id": "create-or-update-a-dub-short-link-11",
      "name": "Done",
      "type": "n8n-nodes-base.set",
      "position": [
        1240,
        1060
      ],
      "parameters": {
        "options": {}
      },
      "typeVersion": 3.2
    },
    {
      "name": "Check creation result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x=$json,a=$('API Auth').first().json;if(x.statusCode>=200&&x.statusCode<300&&x.body?.shortLink)return {json:{route:'created',body:x.body}};if(x.statusCode===409&&x.body?.error?.code==='conflict'&&x.body.error.message==='Duplicate key: This short link already exists.'&&a['Custom Domain']&&a['Custom Slug'])return {json:{route:'conflict',body:x.body}};throw new Error('Dub creation failed or duplicate lookup lacks domain/key');"
      },
      "id": "create-or-update-a-dub-short-link-12"
    },
    {
      "name": "Confirm existing link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a=$('API Auth').first().json,b=$json.body;if(!b?.id||b.domain!==a['Custom Domain']||b.key!==a['Custom Slug'])throw new Error('Existing link not confirmed');return {json:{body:b}};"
      },
      "id": "create-or-update-a-dub-short-link-13"
    }
