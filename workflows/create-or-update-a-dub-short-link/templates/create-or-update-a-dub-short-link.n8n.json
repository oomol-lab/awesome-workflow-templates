              "batchInterval": 60000
            }
          },
          "redirect": {
            "redirect": {}
          },
          "response": {
            "response": {
              "neverError": false,
              "fullResponse": true
            }
          },
          "allowUnauthorizedCerts": false
        },
        "jsonBody": "={{ {url:$('API Auth').first().json['Long URL'],comments:'Updated using N8N.io workflow: dub.co URL Shortener',...($('API Auth').first().json['Custom Domain']?{domain:$('API Auth').first().json['Custom Domain']}:{}),...($('API Auth').first().json['Custom Slug']?{key:$('API Auth').first().json['Custom Slug']}:{})} }}",
        "sendBody": true,
        "sendQuery": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "queryParameters": {
          "parameters": [
            {
              "name": "projectSlug",
              "value": "={{ $('API Auth').item.json[\"Project Slug\"] }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "notesInFlow": true,
      "typeVersion": 4.1,
      "alwaysOutputData": false
    },
    {
