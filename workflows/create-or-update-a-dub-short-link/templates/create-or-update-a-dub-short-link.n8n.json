    {
      "id": "create-or-update-a-dub-short-link-4",
      "name": "Sticky Note6",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        486,
        460
      ],
      "parameters": {
        "width": 655.6800599837106,
        "height": 462.29577922809585,
        "content": "# README\n\n## Dub.co API Workflow Configuration\n| Required | Input Field           | Description                                      |\n|----------|-----------------------|--------------------------------------------------|\n|✓| **`Dub API Key`**     | _API Key for Dub.co integration._                 |\n|✓| **`Long URL`**               | _The long URL to be shortened._                    |\n| | **`Custom Slug`**           | _Slug is the path of shortened URL - default is random 7 characters._               |\n|✓| **`Project Slug`**                  | _Enter Your Dub project slug, The slug for the project to create links for. E.g. for app.dub.co/acme, the project slug is 'acme'._                   |\n| | **`Custom Domain`** | _Custom domain linked to Dub.co._                 |\n\n\n\n\n\n\n\nYou'll need to add the details listed above in the \"API Auth\" node by clicking on it and filling the fields ==>"
      },
      "typeVersion": 1
    },
    {
      "id": "create-or-update-a-dub-short-link-5",
      "name": "API Auth",
      "type": "n8n-nodes-base.set",
      "position": [
        1240,
        820
      ],
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "Long URL",
              "stringValue": "https://n8n.io"
            },
            {
              "name": "Custom Slug",
              "stringValue": ""
            },
            {
              "name": "Project Slug",
              "stringValue": "YOUR_PROJECT_SLUG"
            },
            {
              "name": "Custom Domain",
              "stringValue": ""
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.2
    },
    {
      "id": "create-or-update-a-dub-short-link-6",
      "name": "CREATE",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Create Link",
      "position": [
        1540,
        560
      ],
      "parameters": {
        "url": "https://api.dub.co/links",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 10,
              "batchInterval": 60000
            }
          },
          "redirect": {
            "redirect": {}
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "allowUnauthorizedCerts": false
        },
        "jsonBody": "={{ {url:$('API Auth').first().json['Long URL'],comments:'Updated using N8N.io workflow: dub.co URL Shortener',...($('API Auth').first().json['Custom Domain']?{domain:$('API Auth').first().json['Custom Domain']}:{}),...($('API Auth').first().json['Custom Slug']?{key:$('API Auth').first().json['Custom Slug']}:{})} }}",
        "sendBody": true,
        "sendQuery": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "queryParameters": {
          "parameters": [
            {
              "name": "projectSlug",
              "value": "={{ $json[\"Project Slug\"] }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "notesInFlow": true,
      "typeVersion": 4.1,
      "alwaysOutputData": false
    },
    {
      "id": "create-or-update-a-dub-short-link-7",
      "name": "IF Slug available",
      "type": "n8n-nodes-base.if",
      "position": [
        1760,
        560
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "value2": "created",
              "operation": "equal"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "create-or-update-a-dub-short-link-8",
