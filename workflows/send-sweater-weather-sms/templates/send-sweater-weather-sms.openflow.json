    "modules": {
      "n_e8e4b420b160df4e": {
        "name": "Check feels-like temperature",
        "imports": [],
        "source": "export default function evaluate({ weather }) {\n  const t = weather?.main?.feels_like;\n  if (String(weather?.cod) !== \"200\" || typeof t !== \"number\" || !Number.isFinite(t))\n    throw Error(\"Invalid current weather response\");\n  return { cold: t < 18, body: `Wear a sweater today, it is ${t}°C outside right now.` };\n}\n"
      }
    }
