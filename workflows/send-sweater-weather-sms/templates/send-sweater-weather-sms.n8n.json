{
  "name": "Send a Sweater Weather SMS",
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        0,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 14,
              "minute": 0
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "send-sweater-weather-sms-0"
    },
    {
      "name": "OpenWeatherMap",
      "type": "n8n-nodes-base.openWeatherMap",
      "position": [
        250,
        300
      ],
      "parameters": {
        "cityName": "berlin,de",
        "format": "metric"
      },
      "typeVersion": 1,
      "id": "send-sweater-weather-sms-1"
    },
    {
      "name": "Check weather",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function evaluate({ weather }) {\n  const t = weather?.main?.feels_like;\n  if (String(weather?.cod) !== \"200\" || typeof t !== \"number\" || !Number.isFinite(t))\n    throw Error(\"Invalid current weather response\");\n  return { cold: t < 18, body: `Wear a sweater today, it is ${t}°C outside right now.` };\n}\n\nreturn { json: evaluate({ weather: $json }) };\n"
      },
      "id": "send-sweater-weather-sms-2",
      "position": [
        500,
        300
      ]
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        750,
        300
      ],
      "parameters": {
        "combineOperation": "all",
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.cold }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "send-sweater-weather-sms-3"
    },
    {
      "name": "Twilio",
      "type": "n8n-nodes-base.twilio",
      "position": [
        1000,
        300
      ],
      "parameters": {
        "to": "YOUR_RECIPIENT_NUMBER",
        "from": "YOUR_TWILIO_NUMBER",
        "message": "={{ $json.body }}"
      },
      "typeVersion": 1,
      "id": "send-sweater-weather-sms-4"
    }
  ],
  "active": false,
  "settings": {
    "timezone": "UTC",
    "executionOrder": "v1"
  },
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "OpenWeatherMap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWeatherMap": {
      "main": [
        [
          {
            "node": "Check weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check weather": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF": {
      "main": [
        [
          {
            "node": "Twilio",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {}
}
