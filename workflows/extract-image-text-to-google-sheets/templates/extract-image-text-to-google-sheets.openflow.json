    "modules": {
      "n_4678df8443ecb32b": {
        "name": "Read image text",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nexport default async function recognize(\n  { imageUrl, region, accessKeyId, secretAccessKey, sessionToken },\n  context,\n) {\n  if (\n    typeof imageUrl !== \"string\" ||\n    !imageUrl.startsWith(\"https://\") ||\n    imageUrl.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure an HTTPS image URL\");\n  if (typeof region !== \"string\" || !/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))\n    throw Error(\"Configure AWS region\");\n  if (!accessKeyId || !secretAccessKey) throw Error(\"Bind AWS credential secrets\");\n  const image = await context.fetch(imageUrl);\n  if (!image.ok) throw Error(\"Image download failed\");\n  const bytes = await image.bytes();\n  if (!bytes.length) throw Error(\"Empty image\");\n  const service = \"rekognition\",\n    host = service + \".\" + region + \".amazonaws.com\" + (region.startsWith(\"cn-\") ? \".cn\" : \"\"),\n    body = JSON.stringify({ Image: { Bytes: Buffer.from(bytes).toString(\"base64\") } }),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8);\n  const headers = {\n      \"content-type\": \"application/x-amz-json-1.1\",\n      host,\n      \"x-amz-date\": timestamp,\n      \"x-amz-target\": \"RekognitionService.DetectText\",\n      ...(sessionToken ? { \"x-amz-security-token\": sessionToken } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signed = names.join(\";\"),\n    canonicalHeaders = names.map((k) => k + \":\" + headers[k].trim() + \"\\n\").join(\"\"),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, x) => createHmac(\"sha256\", k).update(x).digest(),\n    scope = date + \"/\" + region + \"/\" + service + \"/aws4_request\",\n    canonical = [\"POST\", \"/\", \"\", canonicalHeaders, signed, hash(body)].join(\"\\n\"),\n    toSign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    key = hmac(hmac(hmac(hmac(\"AWS4\" + secretAccessKey, date), region), service), \"aws4_request\");\n  headers.authorization =\n    \"AWS4-HMAC-SHA256 Credential=\" +\n    accessKeyId +\n    \"/\" +\n    scope +\n    \", SignedHeaders=\" +\n    signed +\n    \", Signature=\" +\n    createHmac(\"sha256\", key).update(toSign).digest(\"hex\");\n  delete headers.host;\n  const response = await context.fetch(\"https://\" + host + \"/\", { method: \"POST\", headers, body });\n  if (!response.ok) throw Error(\"Rekognition failed\");\n  const result = await response.json();\n  if (!Array.isArray(result.TextDetections)) throw Error(\"Invalid Rekognition response\");\n  const text = result.TextDetections.slice(1, 6)\n      .map((x) => x?.DetectedText)\n      .filter((x) => typeof x === \"string\")\n      .join(\" \"),\n    name = decodeURIComponent(new URL(imageUrl).pathname.split(\"/\").pop() || \"image\");\n  return { values: [[name, imageUrl, text, text.toLowerCase()]] };\n}\n"
      }
