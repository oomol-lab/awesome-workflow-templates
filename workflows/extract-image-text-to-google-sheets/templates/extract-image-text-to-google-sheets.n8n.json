    {
      "id": "extract-image-text-to-google-sheets-format",
      "name": "Format image text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        700
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const text = (item.json.TextDetections ?? [])\n    .slice(1, 6)\n    .map((x) => x?.DetectedText)\n    .filter((x) => typeof x === \"string\")\n    .join(\" \");\n  const image = $(\"HTTP Request\").item;\n  return {\n    json: {\n      img_name: image.binary.data.fileName,\n      img_link: $(\"HTTP Request\").params.url,\n      img_txt: text,\n      lowerText: text.toLowerCase(),\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      }
    }
  ],
