    "modules": {
      "n_14f8180bf0fa91c6": {
        "name": "Set workspace and read ticket fields",
        "imports": [],
        "source": "function prepareProject(payload, workspaceId) {\n  const fields = payload?.attributes;\n  const identifier = (value) =>\n    (typeof value === \"string\" && value.trim().length > 0) || Number.isSafeInteger(value);\n  if (\n    !fields ||\n    !identifier(fields.number) ||\n    !identifier(fields.id) ||\n    typeof fields.customer_business_then_name !== \"string\" ||\n    !fields.customer_business_then_name.trim()\n  ) {\n    return {\n      ready: false,\n      status: 400,\n      response: { error: \"Supply the Syncro ticket number, customer name and ID.\" },\n    };\n  }\n  if (\n    typeof workspaceId !== \"string\" ||\n    !/^[A-Za-z0-9_-]+$/.test(workspaceId) ||\n    workspaceId === \"YOUR_CLOCKIFY_WORKSPACE_ID\"\n  ) {\n    return {\n      ready: false,\n      status: 503,\n      response: { error: \"Select a Clockify workspace before enabling this webhook.\" },\n    };\n  }\n  const name =\n    \"Ticket \" + fields.number + \" - \" + fields.customer_business_then_name + \" [\" + fields.id + \"]\";\n  return {\n    ready: true,\n    endpoint: \"/workspaces/\" + workspaceId + \"/projects\",\n    request: { name },\n    name,\n    workspaceId,\n  };\n}\nexport default ({ body, workspaceId }) => {\n  const plan = prepareProject(body, workspaceId);\n  return { plan, ready: plan.ready, endpoint: plan.endpoint ?? \"\", request: plan.request ?? {} };\n};\n"
      },
      "n_ffafa362c9397d57": {
        "name": "Check Clockify project creation",
        "imports": [],
        "source": "function projectReceipt(status, response, expected) {\n  if (\n    status !== 201 ||\n    !response ||\n    typeof response !== \"object\" ||\n    Array.isArray(response) ||\n    typeof response.id !== \"string\" ||\n    !response.id.trim() ||\n    response.name !== expected.name ||\n    response.workspaceId !== expected.workspaceId\n  ) {\n    return {\n      status: 502,\n      body: {\n        error:\n          \"Clockify did not confirm the project. Check the workspace before sending this ticket again.\",\n      },\n    };\n  }\n  return { status: 200, body: [response] };\n}\nexport default ({ status, body, plan }) => projectReceipt(status, body, plan);\n"
      },
      "n_3c8dfaaedd071f16": {
        "name": "Return the ticket or setup error",
        "imports": [],
        "source": "export default ({ plan }) => ({ status: plan.status, body: plan.response });\n"
      }
