{
  "nodes": [
    {
      "id": "email-recent-n8n-release-notes-0",
      "name": "Fetch Github Repo Releases",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        640,
        240
      ],
      "parameters": {
        "url": "https://api.github.com/repos/n8n-io/n8n/releases/latest",
        "options": {}
      },
      "typeVersion": 4.2
    },
    {
      "id": "email-recent-n8n-release-notes-1",
      "name": "Split Out Content",
      "type": "n8n-nodes-base.splitOut",
      "position": [
        1100,
        140
      ],
      "parameters": {
        "options": {},
        "fieldToSplitOut": "body"
      },
      "typeVersion": 1
    },
    {
      "id": "email-recent-n8n-release-notes-2",
      "name": "Convert Markdown to HTML",
      "type": "n8n-nodes-base.markdown",
      "position": [
        1280,
        140
      ],
      "parameters": {
        "mode": "markdownToHtml",
        "options": {},
        "markdown": "={{ $json.body }}",
        "destinationKey": "html"
      },
      "typeVersion": 1
    },
    {
      "id": "email-recent-n8n-release-notes-3",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        380,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "email-recent-n8n-release-notes-4",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        540,
        140
      ],
      "parameters": {
        "width": 288,
        "height": 300,
        "content": "Change **url** for Github Repo here"
      },
      "typeVersion": 1
    },
    {
      "id": "email-recent-n8n-release-notes-5",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1420,
        60
      ],
      "parameters": {
        "width": 288,
        "height": 300,
        "content": "Change **to Email** here"
      },
      "typeVersion": 1
    },
    {
      "id": "email-recent-n8n-release-notes-6",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        1520,
        140
      ],
      "parameters": {
        "html": "={{ $json.html }}",
        "options": {},
        "subject": "New n8n release",
        "toEmail": "YOUR_RECIPIENT_EMAIL",
        "fromEmail": "YOUR_SENDER_EMAIL"
      },
      "typeVersion": 2.1
    },
    {
      "id": "email-recent-n8n-release-notes-7",
      "name": "If new release in the last day",
      "type": "n8n-nodes-base.if",
      "position": [
        860,
        240
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "77d364d3-a340-49d2-abf8-e38d7dceb8d6",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "leftValue": "={{ $json.published_at.toDateTime() }}",
              "rightValue": "={{ DateTime.utc().minus(1, 'days') }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "email-recent-n8n-release-notes-hook",
      "name": "SMTP relay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        300,
        600
      ],
      "disabled": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "email-recent-n8n-release-notes",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "email-recent-n8n-release-notes-unpack",
      "name": "Read email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        600
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.body?.html !== \"string\") throw Error(\"Missing email HTML\");\nreturn { json: { html: $json.body.html } };\n"
      }
    },
    {
      "id": "email-recent-n8n-release-notes-relay-mail",
      "name": "SMTP relay email",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        800,
        600
      ],
      "parameters": {
        "html": "={{ $json.html }}",
        "options": {},
        "subject": "New n8n release",
        "toEmail": "YOUR_RECIPIENT_EMAIL",
        "fromEmail": "YOUR_SENDER_EMAIL"
      },
      "typeVersion": 2.1
    },
    {
      "id": "email-recent-n8n-release-notes-respond",
      "name": "Confirm SMTP submission",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1050,
        600
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Send Email": {
      "main": [
        []
      ]
    },
    "Daily Trigger": {
      "main": [
        [
          {
            "node": "Fetch Github Repo Releases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out Content": {
      "main": [
        [
          {
            "node": "Convert Markdown to HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert Markdown to HTML": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Github Repo Releases": {
      "main": [
        [
          {
            "node": "If new release in the last day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If new release in the last day": {
      "main": [
        [
          {
            "node": "Split Out Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP relay webhook": {
      "main": [
        [
          {
            "node": "Read email HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read email HTML": {
      "main": [
        [
          {
            "node": "SMTP relay email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP relay email": {
      "main": [
        [
          {
            "node": "Confirm SMTP submission",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Email Recent n8n Release Notes",
  "active": false,
  "settings": {
    "timezone": "UTC"
  }
}
