    "modules": {
      "n_9e0da1baf0be59c0": {
        "name": "Prepare Google Books URLs",
        "imports": [],
        "source": "export default function bookRequest({ volumeId, shelfId }) {\n  if ([volumeId, shelfId].some((value) => typeof value !== 'string' || !value)) throw new Error('Configure the Google Books volume and bookshelf IDs');\n  const root = 'https://www.googleapis.com/books/v1/';\n  return { volumeUrl: root + 'volumes/' + encodeURIComponent(volumeId), addUrl: root + 'mylibrary/bookshelves/' + encodeURIComponent(shelfId) + '/addVolume', listUrl: root + 'mylibrary/bookshelves/' + encodeURIComponent(shelfId) + '/volumes' };\n}\n"
      },
      "n_1893fba05c562a65": {
        "name": "Read fetched volume ID",
        "imports": [],
        "source": "export default function bookVolume({ body }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || typeof body.id !== 'string' || !body.id) throw new Error('Google Books did not return a valid volume record');\n  return { volumeId: body.id, volume: body };\n}\n"
      },
      "n_c2ff6ca5499379b1": {
        "name": "Confirm bookshelf addition",
        "imports": [],
        "source": "export default function addedToShelf({ body, statusCode }) {\n  if (![200, 204].includes(statusCode) || body !== null && body !== '') throw new Error('Google Books did not confirm the completed bookshelf addition');\n  return { added: true };\n}\n"
      },
      "n_42095303b5829194": {
        "name": "Read bookshelf results",
        "imports": [],
        "source": "export default function shelfResult({ body, volume }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || body.items != null && (!Array.isArray(body.items) || body.items.some((item) => !item || typeof item !== 'object' || Array.isArray(item)))) throw new Error('Google Books returned an invalid bookshelf page');\n  if (body.items === null) throw new Error('Google Books returned invalid bookshelf items');\n  return { volume, shelfPage: body, items: body.items ?? [], count: body.items?.length ?? 0 };\n}\n"
      }
    }
