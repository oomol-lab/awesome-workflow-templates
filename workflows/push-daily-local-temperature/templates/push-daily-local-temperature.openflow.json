    "modules": {
      "n_32883593dc8b1b1c": {
        "name": "Set the city and device",
        "imports": [],
        "source": "function weatherDestination(city, country, lat, lon, device) {\n  if (\n    typeof city !== \"string\" ||\n    !city.trim() ||\n    typeof country !== \"string\" ||\n    !/^[A-Z]{2}$/.test(country) ||\n    !Number.isFinite(lat) ||\n    Math.abs(lat) > 90 ||\n    !Number.isFinite(lon) ||\n    Math.abs(lon) > 180\n  ) {\n    throw new Error(\n      \"Set one city, its two-letter country code, and decimal latitude and longitude\",\n    );\n  }\n  if (\n    typeof device !== \"string\" ||\n    !/^[A-Za-z0-9_-]{1,25}$/.test(device) ||\n    device === \"YOUR_DEVICE_NAME\"\n  ) {\n    throw new Error(\"Set one named Pushover device\");\n  }\n  return { city: city.trim(), country, lat, lon, device };\n}\n\nexport default ({ city, country, lat, lon, device }) => ({\n  place: weatherDestination(city, country, lat, lon, device),\n  lat,\n  lon,\n});\n"
      },
