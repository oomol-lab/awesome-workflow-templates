        "name": "Check location and temperature",
        "imports": [],
        "source": "function celsiusReading(data, place) {\n  const degrees = data?.main?.temp;\n  const coords = data?.coord;\n  if (String(data?.cod) !== \"200\" || !Number.isFinite(degrees)) {\n    throw new Error(\"OpenWeather did not return a current numerical temperature\");\n  }\n  function normalizeCity(value) {\n    return typeof value === \"string\" ? value.normalize(\"NFKC\").trim().toLowerCase() : \"\";\n  }\n  if (\n    data.sys?.country !== place.country ||\n    normalizeCity(data.name) !== normalizeCity(place.city) ||\n    !Number.isFinite(coords?.lat) ||\n    !Number.isFinite(coords?.lon) ||\n    Math.abs(coords.lat - place.lat) > 0.005 ||\n    Math.abs(coords.lon - place.lon) > 0.005\n  ) {\n    throw new Error(\"OpenWeather did not confirm the configured city and coordinates\");\n  }\n  return {\n    device: place.device,\n    title: \"Today's Weather Update\",\n    message: \"Hey! The temperature outside is \" + degrees + \"°C.\",\n  };\n}\n\nexport default ({ weather, place }) => ({ notification: celsiusReading(weather, place) });\n"
      },
      "n_60e6562c1f4d16b2": {
        "name": "Validate device and send push",
        "imports": [],
        "source": "function checkDevice(result, device) {\n  if (result?.status !== 1 || !Array.isArray(result.devices) || !result.devices.includes(device)) {\n    throw new Error(\"Pushover did not confirm that the configured device is active for this user\");\n  }\n}\n\nfunction checkPush(result) {\n  if (result?.status !== 1 || typeof result.request !== \"string\" || !result.request.trim()) {\n    throw new Error(\"Pushover did not confirm the notification\");\n  }\n  return result.request;\n}\n\nexport default async ({ notification, userKey }, context) => {\n  if (typeof userKey !== \"string\" || !/^[A-Za-z0-9]{30}$/.test(userKey)) {\n    throw new Error(\"Bind a personal Pushover User Key\");\n  }\n  const destination = { user: userKey, device: notification.device };\n  const validated = await context.actions.call(\"pushover.validate_user_or_group\", destination);\n  checkDevice(validated, destination.device);\n  const receipt = await context.actions.call(\"pushover.send_message\", {\n    ...destination,\n    title: notification.title,\n    message: notification.message,\n    priority: 0,\n  });\n  return { requestId: checkPush(receipt) };\n};\n"
      }
    },
    "features": []
  },
