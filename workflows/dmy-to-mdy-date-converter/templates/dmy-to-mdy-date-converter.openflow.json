    "modules": {
      "n_88a0207a2eaa730c": {
        "name": "Validate and format calendar date",
        "imports": [],
        "source": "function convertDmyDate(value) {\n  if (typeof value !== \"string\" || value.length !== 10)\n    throw new Error(\"Enter a date in DD/MM/YYYY format\");\n  const match = /^([0-9]{2})\\/([0-9]{2})\\/([0-9]{4})$/.exec(value);\n  if (!match) throw new Error(\"Enter a date in DD/MM/YYYY format\");\n  const [, dayText, monthText, yearText] = match;\n  const day = Number(dayText),\n    month = Number(monthText),\n    year = Number(yearText);\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n  const monthDays = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (month < 1 || month > 12 || day < 1 || day > monthDays[month - 1])\n    throw new Error(\"Enter a valid calendar date\");\n  return monthText + \"/\" + dayText + \"/\" + yearText;\n}\nexport default async function dmyDate({ value }) {\n  return { data: convertDmyDate(value) };\n}\n"
      }
    }
  },
