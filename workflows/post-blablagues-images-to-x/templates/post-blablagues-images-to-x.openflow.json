    "modules": {
      "n_04d57978ba69b556": {
        "name": "Check the image URL and caption",
        "imports": [],
        "source": "function parseBlablagues(body, extraImageHost = \"\") {\n  let payload;\n  try {\n    payload = JSON.parse(body);\n  } catch {\n    throw Error(\"Blablagues did not return a JSON image record.\");\n  }\n  const { media, text } = payload?.data?.content ?? {};\n  const host =\n    typeof media === \"string\"\n      ? /^https:\\/\\/([a-z0-9.-]+)\\/[^#\\s\\\\]+$/i.exec(media)?.[1].toLowerCase()\n      : \"\";\n  const allowed =\n    host === \"blablagues.net\" ||\n    Boolean(host?.endsWith(\".blablagues.net\")) ||\n    (Boolean(host) &&\n      /^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$/i.test(extraImageHost) &&\n      host === extraImageHost.toLowerCase());\n  if (!allowed || typeof text !== \"string\")\n    throw Error(\"Blablagues did not return an approved image URL and its caption.\");\n  const credit = \"https://www.blablagues.net/\";\n  return { url: media, text: text.trim() ? text.trim() + \"\\n\\n\" + credit : credit };\n}\nexport default ({ body, statusCode, extraImageHost }) => {\n  if (statusCode !== 200) throw Error(\"Blablagues did not return a successful image record.\");\n  return parseBlablagues(body, extraImageHost);\n};\n"
      },
      "n_143b11a65ee0e3c4": {
        "name": "Validate the downloaded image",
        "imports": [],
        "source": "function checkImage(bytes, mime) {\n  const type = String(mime ?? \"\")\n    .split(\";\", 1)[0]\n    .trim()\n    .toLowerCase();\n  if (bytes.length < 12 || bytes.length > 2 * 1024 * 1024)\n    throw Error(\"The image must be within 2 MiB.\");\n  const png = [137, 80, 78, 71, 13, 10, 26, 10].every((byte, i) => bytes[i] === byte);\n  const jpeg = bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255;\n  const webp =\n    bytes[0] === 82 &&\n    bytes[1] === 73 &&\n    bytes[2] === 70 &&\n    bytes[3] === 70 &&\n    bytes[8] === 87 &&\n    bytes[9] === 69 &&\n    bytes[10] === 66 &&\n    bytes[11] === 80;\n  const gif =\n    bytes[0] === 71 &&\n    bytes[1] === 73 &&\n    bytes[2] === 70 &&\n    bytes[3] === 56 &&\n    (bytes[4] === 55 || bytes[4] === 57) &&\n    bytes[5] === 97;\n  if (type === \"image/gif\" && gif) return { mimeType: type, fileName: \"blablagues.gif\" };\n  if (type === \"image/png\" && png) return { mimeType: type, fileName: \"blablagues.png\" };\n  if (type === \"image/jpeg\" && jpeg) return { mimeType: type, fileName: \"blablagues.jpg\" };\n  if (type === \"image/webp\" && webp) return { mimeType: type, fileName: \"blablagues.webp\" };\n  throw Error(\"Blablagues did not return a valid PNG, JPEG, GIF or WebP image.\");\n}\nexport default async ({ file, statusCode }, context) => {\n  if (statusCode !== 200) throw Error(\"Blablagues did not return a complete image.\");\n  if (file.size > 2097152) throw Error(\"The image must be within 2 MiB.\");\n  const bytes = await context.artifact.open(file);\n  const metadata = checkImage(bytes, file.mediaType);\n  let mediaBase64 = \"\";\n  for (let i = 0; i < bytes.length; i += 12288)\n    mediaBase64 += btoa(String.fromCharCode(...bytes.subarray(i, i + 12288)));\n  return { ...metadata, mediaBase64 };\n};\n"
      },
      "n_83f11d263b9e4f64": {
        "name": "Check the X media receipt",
        "imports": [],
        "source": "function confirmUpload(id, raw) {\n  const processing = raw?.data?.processing_info;\n  if (\n    typeof id !== \"string\" ||\n    !/^\\d+$/.test(id) ||\n    (processing && processing.state !== \"succeeded\")\n  ) {\n    throw Error(\"X did not confirm a ready media upload.\");\n  }\n  return [id];\n}\nexport default ({ id, raw }) => ({ mediaIds: confirmUpload(id, raw) });\n"
      },
      "n_2bb38abee2a83cdb": {
        "name": "Confirm the X post",
        "imports": [],
        "source": "function confirmPost(id) {\n  if (typeof id !== \"string\" || !/^\\d+$/.test(id))\n    throw Error(\"X did not confirm the post. Check the account before retrying.\");\n  return id;\n}\nexport default ({ id }) => ({ id: confirmPost(id) });\n"
      }
    },
    "features": [
      "http-request-artifacts"
    ]
  },
