        "jsCode": "const a = $input.all();\nif (a.length !== 1) throw Error(\"Duplicate checkpoint\");\nconst s = a[0].json.status;\nif (s && s !== \"done\") throw Error(\"Inspect pending reply before retry\");\nreturn [{ json: { done: s === \"done\" }, pairedItem: { item: 0 } }];\n"
