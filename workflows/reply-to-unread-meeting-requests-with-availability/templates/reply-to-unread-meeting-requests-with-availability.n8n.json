{
  "name": "Reply to Unread Meeting Requests with Availability",
  "tags": [],
  "nodes": [
    {
      "id": "reply-to-unread-meeting-requests-with-availability-0",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "filters": {
          "readStatus": "unread",
          "includeSpamTrash": false
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id || !$json.threadId) throw Error(\"Missing Gmail message identity\");\nreturn { json: { ...$json, mode: \"direct\" } };\n"
      },
      "id": "reply-to-unread-meeting-requests-with-availability-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "mode",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "reply-to-unread-meeting-requests-with-availability-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Forward email to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {messageId:$json.id,threadId:$json.threadId,from:$json.From || '',subject:$json.Subject || '',snippet:$json.snippet || ''} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "reply-to-unread-meeting-requests-with-availability-3",
      "position": [
        660,
        0
      ]
    },
