    {
      "name": "Format calendar availability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input\n  .all()\n  .map((x) => x.json)\n  .filter((e) => e.status === \"confirmed\" && e.start?.dateTime)\n  .sort((a, b) => Date.parse(a.start.dateTime) - Date.parse(b.start.dateTime));\nreturn [\n  {\n    json: {\n      response: JSON.stringify(a.map((e) => ({ start: e.start, end: e.end, summary: e.summary }))),\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "reply-to-unread-meeting-requests-with-availability-15",
      "position": [
        3300,
        0
      ]
    },
