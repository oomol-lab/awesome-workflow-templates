        "name": "Read calendar availability",
        "imports": [],
        "source": "export default async function calendar({ calendarId, timeZone }, ctx) {\n  if (!calendarId || calendarId.includes(\"YOUR_\")) throw Error(\"Configure calendar\");\n  Intl.DateTimeFormat(\"en\", { timeZone });\n  const now = new Date(),\n    start = new Date(now.getTime() - 86400000),\n    end = new Date(now);\n  end.setUTCMonth(end.getUTCMonth() + 1);\n  let token = null,\n    seen = new Set(),\n    events = [];\n  do {\n    const page = await ctx.actions.call(\"googlecalendar.list_events\", {\n      calendarId,\n      timeMin: start.toISOString(),\n      timeMax: end.toISOString(),\n      timeZone,\n      singleEvents: true,\n      maxResults: 250,\n      ...(token ? { pageToken: token } : {}),\n    });\n    if (!Array.isArray(page.items)) throw Error(\"Invalid calendar page\");\n    events.push(\n      ...page.items\n        .filter((e) => e.status === \"confirmed\" && e.start?.dateTime)\n        .map((e) => ({\n          start: e.start,\n          end: e.end,\n          status: e.status,\n          transparency: e.transparency,\n        })),\n    );\n    token = page.nextPageToken ?? null;\n    if (token && seen.has(token)) throw Error(\"Repeated calendar cursor\");\n    if (token) seen.add(token);\n  } while (token);\n  events.sort((a, b) => Date.parse(a.start.dateTime) - Date.parse(b.start.dateTime));\n  return { events: JSON.stringify(events), now: now.toISOString(), timeZone };\n}\n"
      },
      "n_25ea910ff8cdc4b4": {
        "name": "Reserve reply",
        "imports": [],
        "source": "export default async function reserve({ body, acknowledge, resolution }, ctx) {\n  if (!body?.messageId || !body?.threadId) throw Error(\"Missing message identity\");\n  const key = \"appointment-reply:\" + body.messageId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, send: false };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending reply \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, send: false };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_3beb09ea9d437fe6": {
        "name": "Confirm reply",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown reply result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_1b90436d6fdccdcf": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f({ appointment }) {\n  return { body: JSON.stringify({ appointment, status: appointment ? \"replied\" : \"ignored\" }) };\n}\n"
      }
    }
  },
