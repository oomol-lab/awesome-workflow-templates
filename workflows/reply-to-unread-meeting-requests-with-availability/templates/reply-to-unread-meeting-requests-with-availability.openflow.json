    "modules": {
      "n_2ffbbad9d19f7c2a": {
        "name": "Read email fields",
        "imports": [],
        "source": "export default function f({ body }) {\n  for (const k of [\"messageId\", \"threadId\", \"from\", \"subject\", \"snippet\"])\n    if (typeof body[k] !== \"string\") throw Error(\"Invalid email\");\n  if (!body.messageId || !body.threadId) throw Error(\"Missing message identity\");\n  return body;\n}\n"
      },
      "n_a3e61d1f99da3239": {
        "name": "Read classification",
        "imports": [],
        "source": "export default function f({ result }) {\n  if (typeof result.appointment !== \"boolean\") throw Error(\"Invalid classification\");\n  return { appointment: result.appointment };\n}\n"
      },
