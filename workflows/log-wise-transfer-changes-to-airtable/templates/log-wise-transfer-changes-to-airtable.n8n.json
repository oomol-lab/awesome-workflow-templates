{
  "nodes": [
    {
      "name": "Wise Trigger",
      "type": "n8n-nodes-base.wiseTrigger",
      "position": [
        450,
        280
      ],
      "parameters": {
        "event": "tranferStateChange",
        "profileId": "YOUR_PROFILE_ID"
      },
      "typeVersion": 1,
      "id": "log-wise-transfer-changes-to-airtable-0"
    },
    {
      "name": "Wise",
      "type": "n8n-nodes-base.wise",
      "position": [
        650,
        280
      ],
      "parameters": {
        "resource": "transfer",
        "transferId": "={{$json[\"data\"][\"resource\"][\"id\"]}}"
      },
      "typeVersion": 1,
      "id": "log-wise-transfer-changes-to-airtable-1"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        850,
        280
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Transfer ID",
              "value": "={{$json[\"id\"]}}"
            },
            {
              "name": "Date",
              "value": "={{$json[\"created\"]}}"
            },
            {
              "name": "Reference",
              "value": "={{$json[\"reference\"]}}"
            },
            {
              "name": "Amount",
              "value": "={{$json[\"sourceValue\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "log-wise-transfer-changes-to-airtable-2"
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1050,
        280
      ],
      "parameters": {
        "table": "YOUR_TABLE_NAME",
        "options": {},
        "operation": "append",
        "application": "YOUR_BASE_ID"
      },
      "typeVersion": 1,
      "id": "log-wise-transfer-changes-to-airtable-3"
    },
    {
      "id": "log-wise-transfer-changes-to-airtable-mode",
      "name": "Choose delivery mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mode = \"direct\";\nif (![\"direct\", \"relay\"].includes(mode)) throw Error(\"Choose direct or relay\");\nreturn { json: { mode, event: $json } };\n"
      }
    },
    {
      "id": "log-wise-transfer-changes-to-airtable-gate",
      "name": "Route delivery mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.mode === 'direct' ? 0 : 1 }}",
        "options": {}
      }
    },
    {
      "id": "log-wise-transfer-changes-to-airtable-direct",
      "name": "Select Wise event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $json.event };\n"
      }
    },
    {
      "id": "log-wise-transfer-changes-to-airtable-relay",
      "name": "Forward event to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPENFLOW_WEBHOOK_URL",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.event }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wise": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wise Trigger": {
      "main": [
        [
          {
            "node": "Choose delivery mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Choose delivery mode": {
      "main": [
        [
          {
            "node": "Route delivery mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route delivery mode": {
      "main": [
        [
          {
            "node": "Select Wise event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Forward event to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select Wise event": {
      "main": [
        [
          {
            "node": "Wise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Log Wise Transfer Changes to Airtable",
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
