    "modules": {
      "n_6f28b1b3f0450b02": {
        "name": "Select transfer",
        "imports": [],
        "source": "export default function main({ body }) {\n  const id = body?.data?.resource?.id;\n  if (body?.event_type !== \"transfers#state-change\" || !Number.isSafeInteger(id) || id <= 0)\n    throw new Error(\"Expected a Wise transfer state change with an integer transfer ID\");\n  return { url: `https://api.wise.com/v1/transfers/${id}`, id };\n}\n"
      },
      "n_2412e36b8e183836": {
        "name": "Prepare Airtable record",
        "imports": [],
        "source": "export default function main({ transfer, id }) {\n  if (\n    transfer?.id !== id ||\n    typeof transfer.created !== \"string\" ||\n    typeof transfer.reference !== \"string\" ||\n    typeof transfer.sourceValue !== \"number\"\n  )\n    throw new Error(\"Wise transfer response is incomplete or does not match the event\");\n  return {\n    records: [\n      {\n        fields: {\n          \"Transfer ID\": String(transfer.id),\n          Date: transfer.created,\n          Reference: transfer.reference,\n          Amount: String(transfer.sourceValue),\n        },\n      },\n    ],\n  };\n}\n"
      }
    }
