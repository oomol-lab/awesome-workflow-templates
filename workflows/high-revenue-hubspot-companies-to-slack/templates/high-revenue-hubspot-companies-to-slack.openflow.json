      "n_091a6fa32885aa30": {
        "name": "Set the five-minute window",
        "imports": [],
        "source": "export default function windowFilter(){return {filterGroups:[{filters:[{propertyName:'hs_lastmodifieddate',operator:'GTE',value:String(Date.now()-300000)}]}]};}\n"
      },
      "n_70fb2a57a6550c63": {
        "name": "Collect company pages",
        "imports": [],
        "source": "export default function collectLeads({results,paging,previousState}){\n  const state=previousState??{records:[],seen:[]};if(!Array.isArray(results)||!Array.isArray(state.records)||!Array.isArray(state.seen))throw Error('Invalid HubSpot page');\n  const cursor=paging?.nextAfter??null;if(cursor!==null&&(typeof cursor!=='string'||!cursor||state.seen.includes(cursor)))throw Error('Invalid or repeated HubSpot cursor');\n  const records=[...state.records,...results];if(records.length>=10000)throw Error('HubSpot search result limit reached; no notifications sent');\n  return {state:{records,seen:cursor?[...state.seen,cursor]:state.seen},more:cursor!==null,after:cursor??'unused'};\n}\n"
      },
      "n_c7cbf28e8afe18ad": {
        "name": "Prepare high-revenue alerts",
        "imports": [],
        "source": "export default function prepareLeads({state}){\n  if(!Array.isArray(state?.records))throw Error('Invalid HubSpot results');const messages=[],esc=x=>String(x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  for(const r of state.records){const p=r?.properties;if(!p||typeof p!=='object'||Array.isArray(p))throw Error('Missing company properties');const raw=p.annualrevenue;if((typeof raw!=='string'&&typeof raw!=='number')||!String(raw).trim()||!Number.isFinite(Number(raw)))throw Error('Company has invalid annual revenue');const revenue=parseInt(String(raw),10);if(!Number.isFinite(revenue))throw Error('Company has invalid annual revenue');if(revenue<=5000000)continue;for(const k of ['name','website','numberofemployees'])if((typeof p[k]!=='string'&&typeof p[k]!=='number')||!String(p[k]).trim())throw Error('Qualifying company has missing details');const text=`New high-quality lead 🤑\\n*Company Name*: ${esc(p.name)} \\n*Website*: ${esc(p.website)}\\n*Revenue*: ${esc(raw)}\\n*Number of employees*: ${esc(p.numberofemployees)}`;if(text.length>4000)throw Error('Slack message too long');messages.push({text});}return {messages,hasMessages:messages.length>0};\n}\n"
      },
      "n_48fbef1a0d79fba6": {
        "name": "Prepare next alert",
        "imports": [],
        "source": "export default function nextMessage({messages,previousState,channelId}){if(typeof channelId!=='string'||!channelId)throw Error('Invalid Slack conversation');const index=previousState?.index??0;if(!Array.isArray(messages)||!Number.isInteger(index)||index<0||index>messages.length)throw Error('Invalid message state');return index===messages.length?{state:{index},more:false,text:'',channelId}:{state:{index:index+1},more:true,text:messages[index].text,channelId};}\n"
      }
    }
