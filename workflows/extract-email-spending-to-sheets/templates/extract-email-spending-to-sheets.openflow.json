    "modules": {
      "n_7a632c4902dbab7a": {
        "name": "Prepare transaction input",
        "imports": [],
        "source": "export default function prepare({ event }) {\n  const e = JSON.parse(event);\n  if (\n    !Number.isInteger(e.email_type) ||\n    ![0, 1, 2].includes(e.email_type) ||\n    typeof e.email_content !== \"string\" ||\n    !e.email_content.trim()\n  )\n    throw Error(\"Invalid spending record input\");\n  return {\n    prompt: `Email Date: ${e.email_date}\\nEmail Subject: ${e.email_subject}\\nEmail Source: ${e.email_type}\\nEmail Content:\\n${e.email_content}`,\n    emailType: e.email_type,\n  };\n}\n"
      },
      "n_c6b6a5c2b8fa4527": {
        "name": "Prepare expense row",
        "imports": [],
        "source": "export default function row({ record, emailType }) {\n  if (\n    typeof record.date !== \"string\" ||\n    !Number.isFinite(record.amount) ||\n    typeof record.category !== \"string\" ||\n    typeof record.currency !== \"string\"\n  )\n    throw Error(\"Incomplete transaction\");\n  return {\n    values: [\n      [\n        record.date,\n        record.service ?? \"\",\n        record.details ?? \"\",\n        record.amount,\n        record.category,\n        record.currency,\n        emailType === 2 ? \"\" : (record.card ?? \"\"),\n        \"openflow\",\n      ],\n    ],\n  };\n}\n"
      },
      "n_28991f378e3653c3": {
        "name": "Confirm append",
        "imports": [],
        "source": "export default function result({ updatedRows }) {\n  return { response: { ok: true, updatedRows } };\n}\n"
      }
    }
