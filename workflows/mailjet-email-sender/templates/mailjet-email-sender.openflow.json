    "modules": {
      "n_9f8c989d66e2ec6c": {
        "name": "Prepare plain-text email",
        "imports": [],
        "source": "export default function emailRequest({ fromEmail, toEmail, subject, text }) {\n  for (const [name, value] of Object.entries({ fromEmail, toEmail, subject, text }))\n    if (typeof value !== \"string\" || !value.trim()) throw new Error(name + \" is required\");\n  return {\n    body: {\n      Messages: [\n        { From: { Email: fromEmail }, To: [{ Email: toEmail }], Subject: subject, TextPart: text },\n      ],\n      SandboxMode: false,\n    },\n  };\n}\n"
      },
      "n_a5a58d32447e8621": {
        "name": "Confirm email acceptance",
        "imports": [],
        "source": "function readMailjetMessage(message) {\n  if (\n    !message ||\n    typeof message !== \"object\" ||\n    Array.isArray(message) ||\n    message.Status !== \"success\"\n  )\n    throw new Error(\"Mailjet did not accept the message\");\n  if (\n    !Array.isArray(message.To) ||\n    message.To.length !== 1 ||\n    message.To.some(\n      (recipient) =>\n        !recipient ||\n        typeof recipient.Email !== \"string\" ||\n        !(\n          (typeof recipient.MessageID === \"number\" && Number.isFinite(recipient.MessageID)) ||\n          (typeof recipient.MessageID === \"string\" && recipient.MessageID)\n        ) ||\n        typeof recipient.MessageUUID !== \"string\" ||\n        !recipient.MessageUUID,\n    )\n  )\n    throw new Error(\"Mailjet returned no accepted recipient identifier\");\n  return message;\n}\nexport default function emailResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding)\n    throw new Error(\"Mailjet did not return a completed Send API result (HTTP \" + statusCode + \")\");\n  if (!body || !Array.isArray(body.Messages) || body.Messages.length !== 1)\n    throw new Error(\"Mailjet returned an unexpected message batch\");\n  return { message: readMailjetMessage(body.Messages[0]) };\n}\n"
      }
    }
