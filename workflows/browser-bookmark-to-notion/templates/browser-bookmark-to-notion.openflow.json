      "n_1884b7f1ab58fb2c": {
        "name": "Prepare the bookmark",
        "imports": [],
        "source": "export default function prepareBookmark({ body, dataSourceId }) {\n  if (!dataSourceId || dataSourceId.startsWith(\"YOUR_\"))\n    throw new Error(\"Configure the Notion data source\");\n  if (!body || typeof body.url !== \"string\" || !body.url.trim())\n    throw new Error(\"Provide a nonempty bookmark URL\");\n  return {\n    parent: { data_source_id: dataSourceId },\n    properties: { Name: { title: [{ text: { content: body.url } }] } },\n  };\n}\n"
      }
    }
