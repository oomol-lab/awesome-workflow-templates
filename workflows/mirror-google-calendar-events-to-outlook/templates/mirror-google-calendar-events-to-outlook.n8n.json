    {
      "id": "mirror-google-calendar-events-to-outlook-prepare",
      "name": "Prepare Outlook event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"Read queued event\").item.json.event,\n  allDay = !!e.start?.date;\nfunction time(x) {\n  const raw = allDay ? x.date + \"T00:00:00Z\" : x.dateTime,\n    d = new Date(raw);\n  if (!Number.isFinite(d.getTime())) throw Error(\"Invalid event time\");\n  return { dateTime: d.toISOString().slice(0, 19), timeZone: \"UTC\" };\n}\nreturn {\n  json: {\n    body: {\n      subject: \"From private: \" + (e.summary || \"\"),\n      start: time(e.start),\n      end: time(e.end),\n      isAllDay: allDay,\n      body: {\n        contentType: \"text\",\n        content: (e.description != null ? e.description + \"\\n\" : \"\") + (e.htmlLink || \"\"),\n      },\n    },\n  },\n};\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-create",
      "name": "Create Outlook Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.microsoft.com/v1.0/me/calendars/' + encodeURIComponent('YOUR_OUTLOOK_CALENDAR_ID') + '/events' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-delete",
      "name": "Delete Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "DELETE",
        "url": "={{ 'https://graph.microsoft.com/v1.0/me/calendars/' + encodeURIComponent('YOUR_OUTLOOK_CALENDAR_ID') + '/events/' + encodeURIComponent($('Resolve cancellation').item.json.outlook_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "options": {}
      },
      "alwaysOutputData": true
    }
  ],
