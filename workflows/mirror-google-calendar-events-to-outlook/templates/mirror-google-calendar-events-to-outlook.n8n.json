    {
      "id": "mirror-google-calendar-events-to-outlook-resolve",
      "name": "Resolve cancellation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.id !== undefined);\nif (!rows.length) return [{ json: { matched: false } }];\nif (rows.length !== 1) throw Error(\"Duplicate Google event mapping\");\nconst r = rows[0];\nif (r.status !== \"created\" || !r.outlook_id)\n  throw Error(\"Event is pending; inspect Outlook and repair the mapping\");\nreturn [{ json: { matched: true, rowId: r.id, outlook_id: r.outlook_id, subject: r.subject } }];\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-gate",
      "name": "Mapping found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "matched",
              "leftValue": "={{ $json.matched }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
