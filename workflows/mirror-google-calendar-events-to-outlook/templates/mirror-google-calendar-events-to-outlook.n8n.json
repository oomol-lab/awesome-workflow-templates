    {
      "id": "mirror-google-calendar-events-to-outlook-lookup",
      "name": "Find mapping",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
