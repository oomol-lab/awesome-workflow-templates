{
  "name": "Mirror Google Calendar Events to Outlook",
  "tags": [],
  "nodes": [
    {
      "id": "mirror-google-calendar-events-to-outlook-0",
      "name": "Incoming Event Trigger",
      "type": "n8n-nodes-base.googleCalendarTrigger",
      "position": [
        500,
        360
      ],
      "parameters": {
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "eventCreated",
        "calendarId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_CALENDAR_ID"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-1",
      "name": "Cancel Event Trigger",
      "type": "n8n-nodes-base.googleCalendarTrigger",
      "position": [
        280,
        600
      ],
      "parameters": {
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "eventCancelled",
        "calendarId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_CALENDAR_ID"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-2",
      "name": "Send E-mail with details",
      "type": "n8n-nodes-base.microsoftOutlook",
      "position": [
        1060,
        620
      ],
      "parameters": {
        "subject": "={{ $('Resolve cancellation').item.json.subject + ' Cancelled' }}",
        "bodyContent": "<h1>Event cancelled via Google Calendar</h1>",
        "toRecipients": "YOUR_NOTIFICATION_EMAIL",
        "additionalFields": {
          "bodyContentType": "html"
        }
      },
      "typeVersion": 2
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-enqueue-created",
      "name": "Prepare created batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => ({\n  json: { kind: \"created\", payload: JSON.stringify(item.json), status: \"queued\" },\n  pairedItem: { item: index },\n}));\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-enqueue-cancelled",
      "name": "Prepare cancelled batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => ({\n  json: { kind: \"cancelled\", payload: JSON.stringify(item.json), status: \"queued\" },\n  pairedItem: { item: index },\n}));\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-queue-insert",
      "name": "Save incoming batch",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_QUEUE_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "kind": "={{ $json.kind }}",
            "payload": "={{ $json.payload }}",
            "status": "queued"
          },
          "schema": []
        },
        "options": {
          "optimizeBulk": true
        }
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-schedule",
      "name": "Process queued events every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-manual",
      "name": "Resume queued events",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-queue-read",
      "name": "Read queued and pending events",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_QUEUE_TABLE_ID"
        },
        "matchType": "anyCondition",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "queued"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        },
        "returnAll": true,
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "ASC"
      },
      "alwaysOutputData": true
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-select",
      "name": "Select oldest queued event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.id !== undefined)\n  .sort((a, b) => a.id - b.id);\nif (!rows.length) return [];\nconst pending = rows.find((r) => r.status === \"pending\");\nif (pending)\n  throw Error(\"Pending queue item \" + pending.id + \": inspect and resolve before resuming\");\nreturn [{ json: rows[0] }];\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-queue-reserve",
      "name": "Reserve queue item",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_QUEUE_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-unpack",
      "name": "Read queued event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json,\n  e = JSON.parse(row.payload);\nif (!e.id || ![\"created\", \"cancelled\"].includes(row.kind)) throw Error(\"Invalid queued event\");\nreturn { json: { queueId: row.id, kind: row.kind, event: e } };\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-route",
      "name": "New event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "created",
              "leftValue": "={{ $json.kind }}",
              "rightValue": "created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-create-lookup",
      "name": "Find existing mapping",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "google_id",
              "condition": "eq",
              "keyValue": "={{ $('Read queued event').item.json.event.id }}"
            }
          ]
        },
        "returnAll": true,
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-create-resolve",
      "name": "Check existing mapping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.id !== undefined);\nif (rows.length > 1) throw Error(\"Duplicate Google event mapping\");\nif (rows.length && rows[0].status !== \"created\" && rows[0].status !== \"cancelled\")\n  throw Error(\"Pending mapping; inspect Outlook and repair it\");\nreturn [{ json: { exists: rows.length > 0 } }];\n"
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-create-gate",
      "name": "Already mapped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "exists",
              "leftValue": "={{ $json.exists }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-pending",
      "name": "Reserve new event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "google_id": "={{ $('Read queued event').item.json.event.id }}",
            "subject": "={{ 'From private: ' + ($('Read queued event').item.json.event.summary || '') }}",
            "status": "pending-create",
            "outlook_id": ""
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "mirror-google-calendar-events-to-outlook-created",
      "name": "Confirm new event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
