    "modules": {
      "n_46f1d8306b1b0b41": {
        "name": "Mirror events safely",
        "imports": [],
        "source": "export default async function sync(\n  {\n    events,\n    tenantId,\n    clientId,\n    clientSecret,\n    mailbox,\n    calendarId,\n    notifyTo,\n    ackEventId,\n    ackOutlookId,\n    ackResolution,\n  },\n  context,\n) {\n  events = events ?? [];\n  if (!Array.isArray(events)) throw Error(\"Expected calendar events\");\n  const s = (await context.state.get(\"google-outlook-map\")) ?? {\n    events: {},\n    pending: null,\n    queue: [],\n  };\n  if (!s.events || typeof s.events !== \"object\" || !Array.isArray(s.queue))\n    throw Error(\"Invalid event mapping\");\n  for (const e of events) {\n    if (\n      !e ||\n      typeof e.eventId !== \"string\" ||\n      !e.eventId ||\n      ![\"created\", \"cancelled\"].includes(e.changeType)\n    )\n      throw Error(\"Invalid calendar event\");\n    if (!s.queue.some((q) => q.eventId === e.eventId && q.changeType === e.changeType))\n      s.queue.push(e);\n  }\n  await context.state.set(\"google-outlook-map\", s);\n  if (s.pending) {\n    if (ackEventId !== s.pending.eventId)\n      throw Error(\n        \"Pending event \" +\n          s.pending.eventId +\n          \": inspect Outlook and complete any missing action before acknowledging\",\n      );\n    if (s.pending.operation === \"create\") {\n      if (ackResolution === \"created\" && ackOutlookId) {\n        s.events[ackEventId] = { outlookId: ackOutlookId, subject: s.pending.subject };\n      } else if (ackResolution === \"absent\") {\n        delete s.events[ackEventId];\n      } else throw Error(\"Resolve create as created with Outlook ID or absent\");\n    } else {\n      if (ackResolution !== \"cancelled\")\n        throw Error(\"Finish cancellation and email, then acknowledge cancelled\");\n      delete s.events[ackEventId];\n    }\n    if (s.queue[0]?.eventId !== s.pending.eventId) throw Error(\"Pending queue mismatch\");\n    if (!(s.pending.operation === \"create\" && ackResolution === \"absent\")) s.queue.shift();\n    s.pending = null;\n    await context.state.set(\"google-outlook-map\", s);\n  }\n  if (!s.queue.length) return { created: 0, cancelled: 0 };\n  if (\n    !/^[a-zA-Z0-9.-]+$/.test(tenantId) ||\n    ![clientId, clientSecret, mailbox, calendarId, notifyTo].every(\n      (x) => typeof x === \"string\" && x.trim(),\n    )\n  )\n    throw Error(\"Configure Microsoft application and destination\");\n  let r;\n  try {\n    r = await context.fetch(\n      \"https://login.microsoftonline.com/\" + encodeURIComponent(tenantId) + \"/oauth2/v2.0/token\",\n      {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n        body:\n          \"client_id=\" +\n          encodeURIComponent(clientId) +\n          \"&client_secret=\" +\n          encodeURIComponent(clientSecret) +\n          \"&scope=\" +\n          encodeURIComponent(\"https://graph.microsoft.com/.default\") +\n          \"&grant_type=client_credentials\",\n      },\n    );\n  } catch {\n    throw Error(\"Microsoft token request failed\");\n  }\n  if (!r.ok) throw Error(\"Microsoft token request rejected\");\n  const token = (await r.json()).access_token;\n  if (typeof token !== \"string\" || !token) throw Error(\"Microsoft token missing\");\n  const user = \"https://graph.microsoft.com/v1.0/users/\" + encodeURIComponent(mailbox),\n    collection = user + \"/calendars/\" + encodeURIComponent(calendarId) + \"/events\",\n    headers = { authorization: \"Bearer \" + token, \"content-type\": \"application/json\" };\n  let created = 0,\n    cancelled = 0;\n  const request = async (url, init) => {\n    let response;\n    try {\n      response = await context.fetch(url, init);\n    } catch {\n      throw Error(\"Graph operation failed or outcome unknown\");\n    }\n    if (!response.ok) throw Error(\"Graph operation rejected or outcome unknown\");\n    return response;\n  };\n  while (s.queue.length) {\n    const e = s.queue[0];\n    if (!e || typeof e.eventId !== \"string\" || !e.eventId) throw Error(\"Missing Google event ID\");\n    const id = e.eventId;\n    if (e.changeType === \"created\") {\n      if (s.events[id]) {\n        s.queue.shift();\n        await context.state.set(\"google-outlook-map\", s);\n        continue;\n      }\n      const allDay = e.isAllDay === true;\n      function time(x) {\n        if (!x || typeof x !== \"object\") throw Error(\"Event time missing\");\n        const raw = allDay ? x.date + \"T00:00:00Z\" : x.dateTime,\n          d = new Date(raw);\n        if (!Number.isFinite(d.getTime())) throw Error(\"Invalid event time\");\n        return { dateTime: d.toISOString().slice(0, 19), timeZone: \"UTC\" };\n      }\n      const subject = \"From private: \" + (e.summary ?? \"\"),\n        body = {\n          subject,\n          start: time(e.start),\n          end: time(e.end),\n          isAllDay: allDay,\n          body: {\n            contentType: \"text\",\n            content: (e.description != null ? e.description + \"\\n\" : \"\") + (e.htmlLink ?? \"\"),\n          },\n        };\n      s.pending = { eventId: id, operation: \"create\", subject };\n      await context.state.set(\"google-outlook-map\", s);\n      const response = await request(collection, {\n          method: \"POST\",\n          headers,\n          body: JSON.stringify(body),\n        }),\n        result = await response.json();\n      if (typeof result?.id !== \"string\" || !result.id)\n        throw Error(\"Graph create returned no event ID; inspect Outlook\");\n      s.events[id] = { outlookId: result.id, subject };\n      s.pending = null;\n      await context.state.set(\"google-outlook-map\", s);\n      created++;\n    } else if (e.changeType === \"cancelled\") {\n      const match = s.events[id];\n      if (!match) {\n        s.queue.shift();\n        await context.state.set(\"google-outlook-map\", s);\n        continue;\n      }\n      s.pending = { eventId: id, operation: \"cancel\", subject: match.subject };\n      await context.state.set(\"google-outlook-map\", s);\n      await request(collection + \"/\" + encodeURIComponent(match.outlookId), {\n        method: \"DELETE\",\n        headers,\n      });\n      await request(user + \"/sendMail\", {\n        method: \"POST\",\n        headers,\n        body: JSON.stringify({\n          message: {\n            subject: match.subject + \" Cancelled\",\n            body: { contentType: \"HTML\", content: \"<h1>Event cancelled via Google Calendar</h1>\" },\n            toRecipients: [{ emailAddress: { address: notifyTo } }],\n          },\n        }),\n      });\n      delete s.events[id];\n      s.pending = null;\n      await context.state.set(\"google-outlook-map\", s);\n      cancelled++;\n    }\n    s.queue.shift();\n    await context.state.set(\"google-outlook-map\", s);\n  }\n  return { created, cancelled };\n}\n"
      }
    }
  },
