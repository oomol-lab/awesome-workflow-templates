        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (\n  !items.length ||\n  items.some((x) => x.json.error || typeof x.json.pageContent !== \"string\" || !x.json.pageContent)\n)\n  return [];\nreturn [{ json: {}, pairedItem: { item: 0 } }];\n"
      }
