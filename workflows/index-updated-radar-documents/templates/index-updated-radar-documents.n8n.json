      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((x, i) => {\n  if (!x.json.id || !x.json.modifiedTime) throw Error(\"Missing file version\");\n  return { ...x, pairedItem: { item: i } };\n});\n"
      }
