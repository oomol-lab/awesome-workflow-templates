    "modules": {
      "n_db9117dd2d6052ee": {
        "name": "Select changed contact",
        "imports": [],
        "source": "export default async function next(\n  { rows, previous, acknowledgeEmail, resolution, confirmedContactId },\n  context,\n) {\n  const saved = (await context.state.get(\"sheet-mautic\")) ?? { contacts: {}, pending: null };\n  if (saved.pending) {\n    const p = saved.pending;\n    if (acknowledgeEmail !== p.email || ![\"confirmed\", \"retry\"].includes(resolution))\n      throw Error(\n        \"Inspect the pending Mautic write for \" + p.email + \" and resolve it before continuing\",\n      );\n    if (resolution === \"confirmed\") {\n      const id = p.contactId || confirmedContactId;\n      if (!Number.isInteger(id) || id <= 0) throw Error(\"Provide the confirmed Mautic contact ID\");\n      saved.contacts[p.email] = { id, signature: p.signature };\n    }\n    saved.pending = null;\n    await context.state.set(\"sheet-mautic\", saved);\n  }\n  if (!Array.isArray(rows)) throw Error(\"Missing sheet rows\");\n  const headers = rows[0] ?? [],\n    index = previous?.index ?? 1;\n  if (!Number.isInteger(index) || index < 1 || index > Math.max(rows.length, 1))\n    throw Error(\"Invalid row index\");\n  if (index >= rows.length)\n    return {\n      state: { index },\n      more: false,\n      process: false,\n      update: false,\n      fields: { email: \"\", firstname: \"\", mobile: \"\" },\n      contactId: 1,\n      email: \"\",\n      signature: \"\",\n    };\n  const row = rows[index],\n    get = (k) => String(row[headers.indexOf(k)] ?? \"\"),\n    email = get(\"email\"),\n    firstname = get(\"firstname\"),\n    mobile = get(\"mobile\");\n  if (!email) throw Error(\"Sheet row \" + (index + 1) + \" has no email\");\n  const fields = { email, firstname, mobile },\n    signature = JSON.stringify([firstname, mobile]),\n    contact = saved.contacts[email];\n  return {\n    state: { index: index + 1 },\n    more: true,\n    process: !contact || contact.signature !== signature,\n    update: !!contact,\n    fields,\n    contactId: contact?.id ?? 1,\n    email,\n    signature,\n  };\n}\n"
      },
      "n_3661397d155e5d84": {
        "name": "Reserve contact write",
        "imports": [],
        "source": "export default async function reserve({ email, signature, contactId, update }, context) {\n  const saved = (await context.state.get(\"sheet-mautic\")) ?? { contacts: {}, pending: null };\n  if (saved.pending) throw Error(\"Resolve pending Mautic write\");\n  saved.pending = { email, signature, contactId: update ? contactId : null };\n  await context.state.set(\"sheet-mautic\", saved);\n  return { reserved: true };\n}\n"
      },
      "n_d78154d39dcc4876": {
        "name": "Confirm create",
        "imports": [],
        "source": "export default async function confirm({ contact, email }, context) {\n  const saved = await context.state.get(\"sheet-mautic\");\n  if (\n    !saved?.pending ||\n    saved.pending.email !== email ||\n    !Number.isInteger(contact?.id) ||\n    contact.id <= 0\n  )\n    throw Error(\"Invalid Mautic confirmation\");\n  if (saved.pending.contactId && saved.pending.contactId !== contact.id)\n    throw Error(\"Mautic contact ID mismatch\");\n  saved.contacts[email] = { id: contact.id, signature: saved.pending.signature };\n  saved.pending = null;\n  await context.state.set(\"sheet-mautic\", saved);\n  return { done: true };\n}\n"
      },
      "n_bf87650b5e224113": {
        "name": "Confirm update",
        "imports": [],
        "source": "export default async function confirm({ contact, email }, context) {\n  const saved = await context.state.get(\"sheet-mautic\");\n  if (\n    !saved?.pending ||\n    saved.pending.email !== email ||\n    !Number.isInteger(contact?.id) ||\n    contact.id <= 0\n  )\n    throw Error(\"Invalid Mautic confirmation\");\n  if (saved.pending.contactId && saved.pending.contactId !== contact.id)\n    throw Error(\"Mautic contact ID mismatch\");\n  saved.contacts[email] = { id: contact.id, signature: saved.pending.signature };\n  saved.pending = null;\n  await context.state.set(\"sheet-mautic\", saved);\n  return { done: true };\n}\n"
      }
    }
