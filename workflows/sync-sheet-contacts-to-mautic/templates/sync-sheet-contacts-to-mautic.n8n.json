{
  "nodes": [
    {
      "name": "Every five minutes",
      "type": "n8n-nodes-base.cron",
      "position": [
        40,
        750
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "unit": "minutes",
              "value": 5
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "sync-sheet-contacts-to-mautic-0"
    },
    {
      "name": "Read contact rows",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        240,
        750
      ],
      "parameters": {
        "range": "Data!A:P",
        "options": {
          "valueRenderMode": "FORMATTED_VALUE"
        },
        "sheetId": "YOUR_SPREADSHEET_ID"
      },
      "typeVersion": 1,
      "id": "sync-sheet-contacts-to-mautic-1"
    },
    {
      "name": "Create contact",
      "type": "n8n-nodes-base.mautic",
      "position": [
        450,
        750
      ],
      "parameters": {
        "email": "={{ $('Process contact').item.json.email }}",
        "options": {
          "rawData": true
        },
        "firstName": "={{ $('Process contact').item.json.firstname }}",
        "additionalFields": {
          "mobile": "={{ $('Process contact').item.json.mobile }}"
        }
      },
      "notesInFlow": false,
      "typeVersion": 1,
      "id": "sync-sheet-contacts-to-mautic-2"
    },
    {
      "id": "sync-sheet-contacts-to-mautic-3",
      "name": "No pending write",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        690,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-4",
      "name": "Process contact",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        840,
        500
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-5",
      "name": "Read contact state",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        990,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Process contact').item.json.email }}"
            }
          ]
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "sync-sheet-contacts-to-mautic-6",
      "name": "Contact exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1140,
        500
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "contact-id",
              "leftValue": "={{ $json.contactId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-7",
      "name": "Reserve new contact",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1290,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $('Process contact').item.json.email }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-8",
      "name": "Reserve update",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        1440,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Process contact').item.json.email }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-9",
      "name": "Update contact",
      "type": "n8n-nodes-base.mautic",
      "typeVersion": 1,
      "position": [
        1590,
        500
      ],
      "parameters": {
        "resource": "contact",
        "operation": "update",
        "contactId": "={{ $('Read contact state').item.json.contactId }}",
        "updateFields": {
          "email": "={{ $('Process contact').item.json.email }}",
          "firstName": "={{ $('Process contact').item.json.firstname }}",
          "mobile": "={{ $('Process contact').item.json.mobile }}"
        },
        "options": {
          "rawData": true
        }
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-10",
      "name": "Validate new contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!Number.isInteger($json.id) || $json.id <= 0) throw Error(\"Missing contact ID\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-11",
      "name": "Validate updated contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1890,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.id !== Number($(\"Read contact state\").item.json.contactId))\n  throw Error(\"Mautic contact mismatch\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-12",
      "name": "Confirm new contact",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2040,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Process contact').item.json.email }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "contactId": "={{ $json.id }}",
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "sync-sheet-contacts-to-mautic-13",
      "name": "Confirm updated contact",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2190,
        500
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Process contact').item.json.email }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every five minutes": {
      "main": [
        [
          {
            "node": "No pending write",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "No pending write": {
      "main": [
        [
          {
            "node": "Read contact rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read contact rows": {
      "main": [
        [
          {
            "node": "Process contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process contact": {
      "main": [
        [],
        [
          {
            "node": "Read contact state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read contact state": {
      "main": [
        [
          {
            "node": "Contact exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Contact exists?": {
      "main": [
        [
          {
            "node": "Reserve update",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reserve new contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve update": {
      "main": [
        [
          {
            "node": "Update contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update contact": {
      "main": [
        [
          {
            "node": "Validate updated contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate updated contact": {
      "main": [
        [
          {
            "node": "Confirm updated contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm updated contact": {
      "main": [
        [
          {
            "node": "Process contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve new contact": {
      "main": [
        [
          {
            "node": "Create contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create contact": {
      "main": [
        [
          {
            "node": "Validate new contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate new contact": {
      "main": [
        [
          {
            "node": "Confirm new contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm new contact": {
      "main": [
        [
          {
            "node": "Process contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Sync Google Sheet Contacts to Mautic",
  "active": false,
  "pinData": {}
}
