      ]
    },
    {
      "id": "wf-discord-restore",
      "name": "Restore submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: $(\"Validate submission\").first().json }];\n"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-find",
      "name": "Find channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let p = $(\"Validate submission\").first().json,\n  rows = $input\n    .all()\n    .map((x) => x.json)\n    .filter((x) => x.name === p.name && x.type === 0);\nif (rows.length > 1) throw Error(\"Ambiguous channel\");\nreturn [{ json: { ...p, channelId: rows[0]?.id ?? \"\" } }];\n"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-created",
      "name": "Restore new channel and content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $(\"Validate submission\").first().json;\nconst id = $input.first().json.id;\nif (!id) throw Error(\"Missing created channel ID\");\nreturn [{ json: { ...p, channelId: id } }];\n"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-after-notice",
