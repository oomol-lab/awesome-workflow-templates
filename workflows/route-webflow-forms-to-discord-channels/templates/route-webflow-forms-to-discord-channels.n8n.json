    {
      "id": "wf-discord-hook",
      "name": "Receive Webflow form submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "route-webflow-forms-to-discord-channels",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-prep",
      "name": "Validate submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body,\n  p = b?.payload;\nif (\n  b?.triggerType !== \"form_submission\" ||\n  p?.siteId !== \"YOUR_WEBFLOW_SITE_ID\" ||\n  !p?.id ||\n  !p?.name ||\n  !p?.data\n)\n  throw Error(\"Invalid submission\");\nconst name = p.name.toLowerCase().trim().replace(/\\s+/g, \"-\");\nif (!/^[\\p{L}\\p{N}_-]{1,100}$/u.test(name)) throw Error(\"Invalid channel name\");\nconst content =\n  \"New form submission:\\n\" +\n  Object.entries(p.data)\n    .map(([k, v]) => \"**\" + k + \"**: \" + (typeof v === \"string\" ? v : JSON.stringify(v)))\n    .join(\"\\n\");\nif (content.length > 2000) throw Error(\"Message too long\");\nreturn { json: { id: p.id, name, content } };\n"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-check",
      "name": "Check submission",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'webflow-discord:'+$('Validate submission').first().json.id }}"
            }
          ]
        },
        "operation": "rowNotExists"
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "wf-discord-reserve",
      "name": "Reserve submission",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
