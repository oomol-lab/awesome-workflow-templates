{
  "nodes": [
    {
      "name": "Bitbucket Trigger",
      "type": "n8n-nodes-base.bitbucketTrigger",
      "position": [
        880,
        390
      ],
      "parameters": {
        "events": [
          "repo:push"
        ],
        "resource": "repository",
        "repository": "YOUR_BITBUCKET_REPOSITORY",
        "workspace": "YOUR_BITBUCKET_WORKSPACE"
      },
      "typeVersion": 1,
      "id": "receive-bitbucket-repository-pushes-0"
    },
    {
      "id": "receive-bitbucket-repository-pushes-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Bitbucket Trigger": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Receive Bitbucket Repository Pushes",
  "active": false,
  "pinData": {}
}
