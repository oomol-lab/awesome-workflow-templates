    "modules": {
      "n_d285d9b9765e609a": {
        "name": "Prepare request",
        "imports": [],
        "source": "export default function classifierRequest({ body }) {\n  if (body === null || typeof body !== \"object\" || !Object.hasOwn(body, \"request\")) {\n    throw new Error(\"Provide the request to classify in the request field\");\n  }\n  return { requestJson: JSON.stringify(body.request) };\n}\n"
      },
      "n_9cd34477df776c31": {
        "name": "Parse classification",
        "imports": [],
        "source": "export default function classifierResult({ text }) {\n  let parsed;\n  try {\n    const raw = text.trim();\n    try {\n      parsed = JSON.parse(raw);\n    } catch {\n      parsed = JSON.parse(raw.slice(raw.indexOf(\"{\"), raw.lastIndexOf(\"}\") + 1));\n    }\n    if (parsed === null || typeof parsed !== \"object\" || Array.isArray(parsed))\n      throw new Error(\"Expected an object\");\n  } catch {\n    parsed = { route: \"general\", priority: \"medium\", summary: \"Unable to classify\" };\n  }\n  const route = typeof parsed.route === \"string\" ? parsed.route.toLowerCase() : \"\";\n  const priority = typeof parsed.priority === \"string\" ? parsed.priority.toLowerCase() : \"\";\n  return {\n    response: {\n      received: true,\n      route: [\"support\", \"sales\", \"technical\", \"general\"].includes(route) ? route : \"general\",\n      priority: [\"high\", \"medium\", \"low\"].includes(priority) ? priority : \"medium\",\n      summary: typeof parsed.summary === \"string\" ? parsed.summary : \"\",\n    },\n  };\n}\n"
      }
    }
