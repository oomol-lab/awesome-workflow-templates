{
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        490,
        360
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-mqtt-0"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        690,
        360
      ],
      "parameters": {
        "url": "https://api.wheretheiss.at/v1/satellites/25544",
        "options": {}
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-mqtt-1"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        890,
        360
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Name",
              "value": "={{$json[\"name\"]}}"
            },
            {
              "name": "Latitude",
              "value": "={{$json[\"latitude\"]}}"
            },
            {
              "name": "Longitude",
              "value": "={{$json[\"longitude\"]}}"
            },
            {
              "name": "Timestamp",
              "value": "={{$json[\"timestamp\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-mqtt-2"
    },
    {
      "name": "MQTT",
      "type": "n8n-nodes-base.mqtt",
      "position": [
        1090,
        360
      ],
      "parameters": {
        "topic": "iss-position",
        "options": {}
      },
      "typeVersion": 1,
      "id": "publish-iss-position-to-mqtt-3"
    }
  ],
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "MQTT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Publish ISS Position to MQTT",
  "active": false,
  "pinData": {}
}
