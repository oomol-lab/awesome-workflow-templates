      "id": "8facdcd0-4b55-4693-9b15-25a6d2960d38",
      "name": "Set Demo Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -430,
        80
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.request_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "method": "GET"
      },
      "id": "54588bd7-abbe-450e-a618-143c05e742ef",
      "name": "Fetch API Records",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -180,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function normalizeApiRecords({ body, requiredFields }) {\n  const failure = failureKind => ({ records: [], failed: true, failureKind });\n  if (typeof requiredFields !== 'string') return failure('invalid_configuration');\n  const fields = requiredFields.split(',').map(field => field.trim()).filter(Boolean);\n  if (!fields.length) return failure('invalid_configuration');\n  const records = Array.isArray(body) ? body : body && typeof body === 'object' ? [body] : null;\n  if (!records) return failure('invalid_response');\n  if (!records.length) return failure('empty_response');\n  return {\n    records: records.map((record, index) => {\n      const missing = fields.filter(field => {\n        if (!record || typeof record !== 'object' || !Object.hasOwn(record, field)) return true;\n        const value = record[field];\n        return value === null || String(value).trim() === '';\n      });\n      return {\n        source_index: index,\n        record_id: record?.id ?? null,\n        name: String(record?.name ?? '').trim(),\n        email: String(record?.email ?? '').trim().toLowerCase(),\n        validation_status: missing.length ? 'invalid' : 'valid',\n        missing_fields: missing,\n        source_domain: record?.website ?? null,\n      };\n    }),\n    failed: false, failureKind: '',\n  };\n}\n\nreturn [{json:normalizeApiRecords({body:$input.first().json.body,requiredFields:$(\"Set Demo Configuration\").first().json.required_fields}),pairedItem:{item:0}}];\n"
      },
      "id": "6db98386-50d1-4880-b374-71701fe7ec10",
      "name": "Normalize and Validate Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -20
      ]
    },
    {
      "parameters": {},
      "id": "11d079f9-e61e-4513-96c6-fadf07b929c8",
      "name": "Validated Records",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        350,
        -20
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function failureRecord({ kind }) {\n  const messages = {\n    upstream_request_failed: 'The upstream API request failed after the bounded attempts.',\n    empty_response: 'The upstream API returned no records.',\n    invalid_response: 'The API response must be a JSON record or an array of records.',\n    invalid_configuration: 'Configure at least one required field name.',\n  };\n  if (!Object.hasOwn(messages, kind)) throw new Error('Unknown API failure category.');\n  return { outcome: {\n    status: 'failed', error: kind, message: messages[kind],\n    retryable: kind === 'upstream_request_failed', failed_at: new Date().toISOString(),\n    next_step: kind === 'upstream_request_failed' ? 'Verify the endpoint and its availability, then run the workflow again.' : 'Check the response format and required fields before running again.',\n  } };\n}\n\nreturn [{json:failureRecord({kind:$input.first().json.failureKind||\"upstream_request_failed\"}).outcome,pairedItem:{item:0}}];\n"
      },
      "id": "5a4ace78-3334-4103-9d51-e59c48e5138f",
      "name": "Safe Failure Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        190
      ]
    },
    {
