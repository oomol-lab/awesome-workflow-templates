            {
              "id": "api-failed",
              "leftValue": "={{ $json.failed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "emit-validated-api-records",
      "name": "Emit Validated Records",
