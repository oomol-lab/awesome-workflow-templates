    "modules": {
      "n_7e07c1fbfd480a72": {
        "name": "Fetch API records with retries",
        "imports": [],
        "source": "import { setTimeout as delay } from \"node:timers/promises\";\n\nexport async function requestRecords({ requestUrl }, context, wait = delay) {\n  for (let attempt = 0; attempt < 3; attempt++) {\n    context.signal.throwIfAborted();\n    try {\n      const url = new URL(requestUrl);\n      if (url.protocol !== \"https:\" || url.username || url.password)\n        throw new Error(\"Use a public HTTPS endpoint without URL credentials.\");\n      const signal = AbortSignal.any([context.signal, AbortSignal.timeout(10000)]);\n      const response = await context.fetch(url.href, { method: \"GET\", signal });\n      if (!response.ok) throw new Error(\"The API request did not succeed.\");\n      return { body: await response.json(), failed: false, failureKind: \"\" };\n    } catch {\n      context.signal.throwIfAborted();\n      if (attempt < 2) await wait(3000, undefined, { signal: context.signal });\n    }\n  }\n  return { body: null, failed: true, failureKind: \"upstream_request_failed\" };\n}\n\nexport default async function readApiRecords(input, context) {\n  return requestRecords(input, context);\n}\n"
      },
      "n_98a176331a4f4487": {
        "name": "Normalize and validate records",
        "imports": [],
        "source": "export default function normalizeApiRecords({ body, requiredFields }) {\n  const failure = (failureKind) => ({ records: [], failed: true, failureKind });\n  if (typeof requiredFields !== \"string\") return failure(\"invalid_configuration\");\n  const fields = requiredFields\n    .split(\",\")\n    .map((field) => field.trim())\n    .filter(Boolean);\n  if (!fields.length) return failure(\"invalid_configuration\");\n  const records = Array.isArray(body) ? body : body && typeof body === \"object\" ? [body] : null;\n  if (!records) return failure(\"invalid_response\");\n  if (!records.length) return failure(\"empty_response\");\n  return {\n    records: records.map((record, index) => {\n      const missing = fields.filter((field) => {\n        if (!record || typeof record !== \"object\" || !Object.hasOwn(record, field)) return true;\n        const value = record[field];\n        return value === null || String(value).trim() === \"\";\n      });\n      return {\n        source_index: index,\n        record_id: record?.id ?? null,\n        name: String(record?.name ?? \"\").trim(),\n        email: String(record?.email ?? \"\")\n          .trim()\n          .toLowerCase(),\n        validation_status: missing.length ? \"invalid\" : \"valid\",\n        missing_fields: missing,\n        source_domain: record?.website ?? null,\n      };\n    }),\n    failed: false,\n    failureKind: \"\",\n  };\n}\n"
      },
      "n_0cc2486b4b39e40a": {
        "name": "Validated record report",
        "imports": [],
        "source": "export default function ({ records }) {\n  return { outcome: { status: \"completed\", records } };\n}\n"
      },
      "n_11b145beae2d1500": {
        "name": "Safe request failure",
        "imports": [],
        "source": "export default function failureRecord({ kind }) {\n  const messages = {\n    upstream_request_failed: \"The upstream API request failed after the bounded attempts.\",\n    empty_response: \"The upstream API returned no records.\",\n    invalid_response: \"The API response must be a JSON record or an array of records.\",\n    invalid_configuration: \"Configure at least one required field name.\",\n  };\n  if (!Object.hasOwn(messages, kind)) throw new Error(\"Unknown API failure category.\");\n  return {\n    outcome: {\n      status: \"failed\",\n      error: kind,\n      message: messages[kind],\n      retryable: kind === \"upstream_request_failed\",\n      failed_at: new Date().toISOString(),\n      next_step:\n        kind === \"upstream_request_failed\"\n          ? \"Verify the endpoint and its availability, then run the workflow again.\"\n          : \"Check the response format and required fields before running again.\",\n    },\n  };\n}\n"
      },
      "n_94c4fff4c332bc05": {
        "name": "Safe response failure",
        "imports": [],
        "source": "export default function failureRecord({ kind }) {\n  const messages = {\n    upstream_request_failed: \"The upstream API request failed after the bounded attempts.\",\n    empty_response: \"The upstream API returned no records.\",\n    invalid_response: \"The API response must be a JSON record or an array of records.\",\n    invalid_configuration: \"Configure at least one required field name.\",\n  };\n  if (!Object.hasOwn(messages, kind)) throw new Error(\"Unknown API failure category.\");\n  return {\n    outcome: {\n      status: \"failed\",\n      error: kind,\n      message: messages[kind],\n      retryable: kind === \"upstream_request_failed\",\n      failed_at: new Date().toISOString(),\n      next_step:\n        kind === \"upstream_request_failed\"\n          ? \"Verify the endpoint and its availability, then run the workflow again.\"\n          : \"Check the response format and required fields before running again.\",\n    },\n  };\n}\n"
      }
    }
