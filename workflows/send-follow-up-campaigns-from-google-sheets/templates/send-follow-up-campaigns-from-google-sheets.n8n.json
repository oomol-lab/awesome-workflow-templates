        "url": "={{ \"https://sheets.googleapis.com/v4/spreadsheets/\" + encodeURIComponent($(\"Configure campaign\").first().json.spreadsheetId) + \"/values/\" + encodeURIComponent($(\"Prepare next contact\").item.json.pendingRange) + \"?valueInputOption=RAW\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {values:[[\"pending\"]]} }}",
        "options": {}
