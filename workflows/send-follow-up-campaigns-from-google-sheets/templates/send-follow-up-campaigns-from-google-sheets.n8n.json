    {
      "id": "send-follow-up-campaigns-from-google-sheets-check",
      "name": "Check for recipient replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function check({ body, statusCode }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    !body ||\n    !Array.isArray(body.messages) ||\n    !body.messages.length\n  )\n    throw Error(\"Cannot verify Gmail conversation\");\n  return {\n    unanswered: body.messages.every(\n      (m) =>\n        (Array.isArray(m.labelIds) && m.labelIds.includes(\"SENT\")) ||\n        (Array.isArray(m.labels) && m.labels.some((x) => x.id === \"SENT\")),\n    ),\n  };\n};\nreturn [{ json: fn({ body: $json, statusCode: 200 }), pairedItem: { item: 0 } }];\n"
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-unanswered",
      "name": "Still unanswered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        0,
