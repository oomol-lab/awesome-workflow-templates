    {
      "id": "send-follow-up-campaigns-from-google-sheets-config",
      "name": "Configure campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function config({ scheduledAt }) {\n  const spreadsheetId = \"YOUR_SPREADSHEET_ID\",\n    sheetName = \"Sheet1\",\n    subject = \"YOUR_SUBJECT\";\n  const templates = [\n    { day: 0, body: \"Hello {name},<br><br>Would you like to talk about {company}?\" },\n    { day: 3, body: \"Hello {name},<br><br>Following up on my earlier message.\" },\n    { day: 8, body: \"Hello {name},<br><br>One last follow-up.\" },\n  ];\n  const quoted = \"'\" + sheetName.replace(/'/g, \"''\") + \"'\";\n  return { spreadsheetId, sheetName, range: quoted, subject, templates, now: scheduledAt };\n};\nreturn [{ json: fn({ scheduledAt: new Date().toISOString() }) }];\n"
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-read",
      "name": "Read contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://sheets.googleapis.com/v4/spreadsheets/\" + encodeURIComponent($(\"Configure campaign\").first().json.spreadsheetId) + \"/values/\" + encodeURIComponent($(\"Configure campaign\").first().json.range) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-plan",
      "name": "Select campaign contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function plan({ values, now }) {\n  const header = [\"email\", \"name\", \"company\", \"first_emailed\", \"thread_id\", \"sequence\", \"pending\"];\n  if (!Array.isArray(values) || header.some((h, i) => values[0]?.[i] !== h))\n    throw Error(\"Expected headers email,name,company,first_emailed,thread_id,sequence,pending\");\n  const weekday = new Date(now).getUTCDay();\n  if (weekday === 0 || weekday === 6) return { contacts: [] };\n  const contacts = [],\n    seen = new Set();\n  for (let i = 1; i < values.length; i++) {\n    const [email = \"\", name = \"\", company = \"\", first = \"\", thread = \"\", seq = \"\", pending = \"\"] =\n      values[i];\n    const placeholders = Object.fromEntries(values[0].map((h, j) => [h, values[i][j] ?? \"\"]));\n    if (!email) continue;\n    if (seen.has(email.toLowerCase())) throw Error(\"Duplicate recipient email\");\n    seen.add(email.toLowerCase());\n    if (pending) continue;\n    if (!first && !thread && !seq)\n      contacts.push({ email, name, company, first, thread, seq: 0, row: i + 1, placeholders });\n    else if (first && thread && /^[1-9][0-9]*$/.test(String(seq)))\n      contacts.push({\n        email,\n        name,\n        company,\n        first,\n        thread,\n        seq: Number(seq),\n        row: i + 1,\n        placeholders,\n      });\n    else throw Error(\"Incomplete campaign state for \" + email);\n  }\n  return { contacts };\n};\nreturn fn({\n  values: $json.values ?? [],\n  now: $(\"Configure campaign\").first().json.now,\n}).contacts.map((x) => ({ json: x }));\n"
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-loop",
      "name": "Process contacts one by one",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-next",
      "name": "Prepare next contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function next({ contacts, previous, templates, subject, now, sheetName }) {\n  const index = previous?.index ?? 0,\n    c = contacts[index],\n    more = !!c,\n    t = more ? templates[c.seq] : null;\n  let due = false,\n    body = \"\";\n  if (t) {\n    const days = c.first ? (Date.parse(now) - Date.parse(c.first)) / 86400000 : 0;\n    due = Number.isFinite(days) && days >= t.day;\n    if (due)\n      body = t.body.replace(/\\{([a-zA-Z0-9_-]+)\\}/g, (_, k) => {\n        if (!(k in c.placeholders)) throw Error(\"Missing placeholder column \" + k);\n        return String(c.placeholders[k] ?? \"\")\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\");\n      });\n  }\n  const prefix = \"'\" + sheetName.replace(/'/g, \"''\") + \"'!\";\n  return {\n    state: { index: index + 1 },\n    more,\n    current: c ?? {},\n    due,\n    follow: !!c?.thread,\n    threadId: c?.thread ?? \"\",\n    to: c?.email ?? \"\",\n    subject,\n    body,\n    pendingRange: prefix + \"G\" + (c?.row ?? 2),\n    finalRange: prefix + \"D\" + (c?.row ?? 2) + \":G\" + (c?.row ?? 2),\n    now,\n  };\n};\nconst c = $(\"Configure campaign\").first().json;\nreturn [\n  {\n    json: fn({\n      contacts: [$json],\n      previous: null,\n      templates: c.templates,\n      subject: c.subject,\n      now: c.now,\n      sheetName: c.sheetName,\n    }),\n    pairedItem: { item: 0 },\n  },\n];\n"
      }
    },
