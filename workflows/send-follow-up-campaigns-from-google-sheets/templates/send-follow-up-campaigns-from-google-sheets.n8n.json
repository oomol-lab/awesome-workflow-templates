    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-confirm-pending-initial",
      "name": "Confirm initial pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function confirm({ updatedCells, expected }) {\n  if (updatedCells !== expected) throw Error(\"Sheet update was not confirmed\");\n  return { ok: true };\n};\nreturn [{ json: fn({ updatedCells: $json.updatedCells, expected: 1 }), pairedItem: { item: 0 } }];\n"
      }
    },
    {
      "id": "send-follow-up-campaigns-from-google-sheets-final-initial",
      "name": "Prepare initial confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fn = function final({ current, threadId, now }) {\n  if (!threadId)\n    throw Error(\"Sent message has no thread ID; inspect Gmail before clearing pending\");\n  return { values: [[current.first || now, threadId, String(current.seq + 1), \"\"]] };\n};\nreturn [\n  {\n    json: fn({\n      current: $(\"Prepare next contact\").item.json.current,\n      threadId: $json.threadId,\n      now: $(\"Configure campaign\").first().json.now,\n    }),\n    pairedItem: { item: 0 },\n  },\n];\n"
      }
    },
