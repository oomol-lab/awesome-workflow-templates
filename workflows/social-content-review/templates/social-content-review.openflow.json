    "modules": {
      "n_2b8b04cfca4dc3bc": {
        "name": "Parse platform drafts",
        "imports": [],
        "source": "export default function parseSocial({ text, topic, original = null }) {\n  const fields = [\"twitter\", \"linkedin\", \"reddit_title\", \"reddit_body\", \"instagram_caption\"];\n  let parsed;\n  try {\n    if (typeof text !== \"string\") throw new Error(\"Model output must be text.\");\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    if (!match) throw new Error(\"No JSON object found.\");\n    parsed = JSON.parse(match[0]);\n    if (\n      !parsed ||\n      Array.isArray(parsed) ||\n      fields.some((field) => typeof parsed[field] !== \"string\" || !parsed[field].trim())\n    )\n      throw new Error(\"Model output must contain all five nonempty social content fields.\");\n  } catch (error) {\n    if (original) return { result: { ...original, reviewed: false } };\n    throw new Error(\"Failed to parse AI response as complete content JSON: \" + error.message);\n  }\n  const content = Object.fromEntries(fields.map((field) => [field, parsed[field]]));\n  return {\n    result: original\n      ? { ...original, ...content, reviewed: true }\n      : { ...content, topic, generated_at: new Date().toISOString() },\n  };\n}\n"
      },
      "n_62a71ee62580e027": {
        "name": "Choose reviewed content",
        "imports": [],
        "source": "export default function parseSocial({ text, topic, original = null }) {\n  const fields = [\"twitter\", \"linkedin\", \"reddit_title\", \"reddit_body\", \"instagram_caption\"];\n  let parsed;\n  try {\n    if (typeof text !== \"string\") throw new Error(\"Model output must be text.\");\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    if (!match) throw new Error(\"No JSON object found.\");\n    parsed = JSON.parse(match[0]);\n    if (\n      !parsed ||\n      Array.isArray(parsed) ||\n      fields.some((field) => typeof parsed[field] !== \"string\" || !parsed[field].trim())\n    )\n      throw new Error(\"Model output must contain all five nonempty social content fields.\");\n  } catch (error) {\n    if (original) return { result: { ...original, reviewed: false } };\n    throw new Error(\"Failed to parse AI response as complete content JSON: \" + error.message);\n  }\n  const content = Object.fromEntries(fields.map((field) => [field, parsed[field]]));\n  return {\n    result: original\n      ? { ...original, ...content, reviewed: true }\n      : { ...content, topic, generated_at: new Date().toISOString() },\n  };\n}\n"
      }
