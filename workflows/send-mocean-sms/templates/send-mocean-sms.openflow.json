    "modules": {
      "n_5c92fc2d58f04dd3": {
        "name": "Configure the message",
        "imports": [],
        "source": "export default function smsPlan({ from, to, text }) {\n  for (const [key, value] of Object.entries({ from, to, text }))\n    if (typeof value !== \"string\" || !value.trim() || value.startsWith(\"YOUR_\"))\n      throw Error(\"Configure \" + key);\n  return { from, to, text };\n}\n"
      },
      "n_8503b656a9437e0b": {
        "name": "Check the submission response",
        "imports": [],
        "source": "export default function smsResult({ messages }) {\n  if (!Array.isArray(messages) || messages.length === 0)\n    throw Error(\"Mocean returned no per-recipient result\");\n  return { messages };\n}\n"
      }
    }
