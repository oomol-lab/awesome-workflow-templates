    "modules": {
      "n_a6622fc79183f38a": {
        "name": "Find team and Notion to-dos",
        "imports": [],
        "source": "async function listAll(context, id) {\n  let cursor,\n    all = [];\n  do {\n    const r = await context.actions.call(\"notion.list_block_children\", {\n      blockId: id,\n      pageSize: 100,\n      ...(cursor ? { startCursor: cursor } : {}),\n    });\n    if (!r || !Array.isArray(r.results) || typeof r.has_more !== \"boolean\")\n      throw Error(\"Invalid Notion block response\");\n    all.push(...r.results);\n    cursor = r.has_more ? r.next_cursor : null;\n    if (r.has_more && !cursor) throw Error(\"Missing Notion cursor\");\n  } while (cursor);\n  return all;\n}\nexport default async function load({ body, apiKey }, context) {\n  const input = body?.body ?? body,\n    pageUrl = input?.[\"Notion page URL\"],\n    teamName = input?.[\"Linear team name\"];\n  if (typeof pageUrl !== \"string\" || typeof teamName !== \"string\" || !teamName.trim())\n    throw Error(\"Supply a Notion page URL and Linear team name\");\n  const match = pageUrl.match(\n    /([a-f0-9]{32}|[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})(?:\\b|$)/i,\n  );\n  if (!match) throw Error(\"Cannot find a page ID in the Notion URL\");\n  let cursor = null,\n    teams = [];\n  do {\n    const res = await context.fetch(\"https://api.linear.app/graphql\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\", Authorization: apiKey },\n      body: JSON.stringify({\n        query:\n          \"query($name:String!,$after:String){teams(filter:{name:{eq:$name}},first:100,after:$after){nodes{id name} pageInfo{hasNextPage endCursor}}}\",\n        variables: { name: teamName, after: cursor },\n      }),\n    });\n    if (!res.ok) throw Error(\"Linear team query failed\");\n    const x = await res.json();\n    if (x.errors || !x.data?.teams) throw Error(\"Linear team query failed\");\n    teams.push(...x.data.teams.nodes);\n    cursor = x.data.teams.pageInfo.hasNextPage ? x.data.teams.pageInfo.endCursor : null;\n  } while (cursor);\n  if (teams.length !== 1) throw Error(\"Team name must match exactly one Linear team\");\n  const teamId = teams[0].id;\n  cursor = null;\n  let members = [];\n  do {\n    const res = await context.fetch(\"https://api.linear.app/graphql\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\", Authorization: apiKey },\n      body: JSON.stringify({\n        query:\n          \"query($id:String!,$after:String){team(id:$id){members(first:100,after:$after){nodes{id name} pageInfo{hasNextPage endCursor}}}}\",\n        variables: { id: teamId, after: cursor },\n      }),\n    });\n    if (!res.ok) throw Error(\"Linear members query failed\");\n    const x = await res.json();\n    if (x.errors || !x.data?.team?.members) throw Error(\"Linear members query failed\");\n    members.push(...x.data.team.members.nodes);\n    cursor = x.data.team.members.pageInfo.hasNextPage\n      ? x.data.team.members.pageInfo.endCursor\n      : null;\n  } while (cursor);\n  const blocks = await listAll(context, match[1]),\n    candidates = blocks.filter(\n      (b) =>\n        b.type === \"to_do\" &&\n        !b.to_do?.checked &&\n        !(b.to_do?.rich_text ?? b.to_do?.text ?? [])\n          .map((t) => t.plain_text ?? t.text?.content ?? \"\")\n          .join(\"\")\n          .startsWith(\"[In Linear\"),\n    );\n  return { pageUrl, teamId, members, candidates };\n}\n"
      },
      "n_893b1435a04dee3f": {
        "name": "Prepare next to-do",
        "imports": [],
        "source": "async function listAll(context, id) {\n  let cursor,\n    all = [];\n  do {\n    const r = await context.actions.call(\"notion.list_block_children\", {\n      blockId: id,\n      pageSize: 100,\n      ...(cursor ? { startCursor: cursor } : {}),\n    });\n    if (!r || !Array.isArray(r.results) || typeof r.has_more !== \"boolean\")\n      throw Error(\"Invalid Notion block response\");\n    all.push(...r.results);\n    cursor = r.has_more ? r.next_cursor : null;\n    if (r.has_more && !cursor) throw Error(\"Missing Notion cursor\");\n  } while (cursor);\n  return all;\n}\nfunction plain(a) {\n  return (a ?? []).map((t) => t.plain_text ?? t.text?.content ?? \"\").join(\"\");\n}\nfunction md(a) {\n  return (a ?? [])\n    .map((t) =>\n      t.text?.link?.url\n        ? \"[\" + (t.text.content ?? \"\") + \"](\" + t.text.link.url + \")\"\n        : (t.plain_text ?? t.text?.content ?? \"\"),\n    )\n    .join(\"\");\n}\nexport default async function next({ candidates, members, pageUrl, previous }, context) {\n  const index = previous?.index ?? 0,\n    root = candidates[index];\n  if (!root) return { state: { index }, more: false, current: {}, prompt: \"none\" };\n  const rich = root.to_do.rich_text ?? root.to_do.text ?? [],\n    first = plain(rich),\n    m = first.match(/^(?:\\[([^\\]]+)\\]\\s*)?(.+)$/s);\n  if (!m) throw Error(\"Notion to-do has no title\");\n  const title = m[2],\n    fragment = m[1] ?? \"\",\n    matches = fragment\n      ? members.filter((x) => x.name.toLowerCase().startsWith(fragment.toLowerCase()))\n      : [],\n    assigneeId = matches.length === 1 ? matches[0].id : \"\",\n    lines = [];\n  async function walk(id, depth) {\n    for (const b of await listAll(context, id)) {\n      const data = b[b.type] ?? {},\n        t = md(data.rich_text ?? data.text),\n        prefix =\n          b.type === \"bulleted_list_item\" || b.type === \"toggle\"\n            ? \"* \"\n            : b.type === \"numbered_list_item\"\n              ? \"1. \"\n              : b.type === \"to_do\"\n                ? \"+ [ ] \"\n                : \"\";\n      let line = prefix + t;\n      if (b.type === \"image\") line = \"![image](\" + (data[data.type]?.url ?? \"\") + \")\";\n      if (b.type === \"video\")\n        line = \"[Video](\" + pageUrl.split(\"?\")[0] + \"#\" + b.id.replaceAll(\"-\", \"\") + \")\";\n      lines.push(\"    \".repeat(depth) + line);\n      if (b.has_children && b.type !== \"child_page\" && b.type !== \"unsupported\")\n        await walk(b.id, depth + 1);\n    }\n  }\n  if (root.has_children) await walk(root.id, 0);\n  const anchor = pageUrl.split(\"?\")[0] + \"#\" + root.id.replaceAll(\"-\", \"\"),\n    description =\n      \"_Issue created automatically from a [Notion block](\" +\n      anchor +\n      \")_\" +\n      (fragment && !assigneeId ? \"\\nAssignee \" + fragment + \" not found or ambiguous\" : \"\") +\n      \"\\n\\n\" +\n      md(rich) +\n      \"\\n\" +\n      lines.join(\"\\n\");\n  return {\n    state: { index: index + 1 },\n    more: true,\n    current: { blockId: root.id, rich, title, assigneeId, description },\n    prompt: title,\n  };\n}\n"
      },
      "n_86aa82f1720c860c": {
        "name": "Prepare Linear issue fields",
        "imports": [],
        "source": "export default function prepare({ current, shortened, teamId }) {\n  const title = current.title.length <= 70 ? current.title : shortened?.title;\n  if (typeof title !== \"string\" || !title.trim()) throw Error(\"Missing concise issue title\");\n  return {\n    title,\n    teamId,\n    description: current.description,\n    assigneeId: current.assigneeId || null,\n  };\n}\n"
      },
      "n_79b58a76dd080f4d": {
        "name": "Mark Notion to-do pending",
        "imports": [],
        "source": "function writable(rich) {\n  return rich.map((t) => {\n    const type = t.type ?? \"text\";\n    if (![\"text\", \"mention\", \"equation\"].includes(type) || !t[type])\n      throw Error(\"Unsupported Notion rich text\");\n    return { type, [type]: t[type], ...(t.annotations ? { annotations: t.annotations } : {}) };\n  });\n}\nexport default async function pending({ current }, context) {\n  const r = await context.actions.call(\"notion.update_block\", {\n    blockId: current.blockId,\n    to_do: {\n      rich_text: [\n        { type: \"text\", text: { content: \"[In Linear pending] \" } },\n        ...writable(current.rich),\n      ],\n    },\n  });\n  if (r?.id !== current.blockId) throw Error(\"Pending marker was not confirmed\");\n  return { ok: true };\n}\n"
      },
      "n_30c9d863c0fa0aab": {
        "name": "Link issue in Notion",
        "imports": [],
        "source": "function writable(rich) {\n  return rich.map((t) => {\n    const type = t.type ?? \"text\";\n    if (![\"text\", \"mention\", \"equation\"].includes(type) || !t[type])\n      throw Error(\"Unsupported Notion rich text\");\n    return { type, [type]: t[type], ...(t.annotations ? { annotations: t.annotations } : {}) };\n  });\n}\nexport default async function final({ current, ticket_url }, context) {\n  if (!ticket_url) throw Error(\"Linear issue created but no URL returned; inspect before retry\");\n  const r = await context.actions.call(\"notion.update_block\", {\n    blockId: current.blockId,\n    to_do: {\n      rich_text: [\n        { type: \"text\", text: { content: \"[\" } },\n        { type: \"text\", text: { content: \"In Linear\", link: { url: ticket_url } } },\n        { type: \"text\", text: { content: \"] \" } },\n        ...writable(current.rich),\n      ],\n    },\n  });\n  if (r?.id !== current.blockId) throw Error(\"Notion link update was not confirmed\");\n  return { ok: true };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
