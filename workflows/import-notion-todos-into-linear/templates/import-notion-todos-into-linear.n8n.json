    {
      "id": "import-notion-todos-into-linear-15",
      "name": "Convert contents to Markdown",
      "type": "n8n-nodes-base.code",
      "position": [
        3750,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all(),\n  root = items[0]?.json;\nif (!root?.root_content) throw Error(\"Missing source Notion block\");\nfunction md(a) {\n  return (a ?? [])\n    .map((t) =>\n      t.text?.link?.url\n        ? \"[\" + (t.text.content ?? \"\") + \"](\" + t.text.link.url + \")\"\n        : (t.plain_text ?? t.text?.content ?? \"\"),\n    )\n    .join(\"\");\n}\nlet parents = [root.root_id],\n  lines = [md(root.root_content.rich_text ?? root.root_content.text)];\nfor (const { json: b } of items) {\n  if (!b.type) continue;\n  const data = b[b.type] ?? {},\n    text = md(data.rich_text ?? data.text),\n    prefix = [\"bulleted_list_item\", \"toggle\"].includes(b.type)\n      ? \"* \"\n      : b.type === \"numbered_list_item\"\n        ? \"1. \"\n        : b.type === \"to_do\"\n          ? \"+ [ ] \"\n          : \"\";\n  let line = prefix + text;\n  if (b.type === \"image\") line = \"![image](\" + (data[data.type]?.url ?? \"\") + \")\";\n  if (b.type === \"video\") line = \"[Video](\" + root.page_url + \"#\" + b.id.replaceAll(\"-\", \"\") + \")\";\n  const index = parents.indexOf(b.parent_id);\n  if (index >= 0) parents.splice(index + 1);\n  else parents.push(b.parent_id);\n  lines.push(\"    \".repeat(parents.length - 1) + line);\n}\nreturn [{ json: { markdown: lines }, pairedItem: { item: 0 } }];\n"
      },
      "typeVersion": 2
    },
