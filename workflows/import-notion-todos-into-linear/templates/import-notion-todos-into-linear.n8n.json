    {
      "id": "import-notion-todos-into-linear-5",
      "name": "Set assignee and title",
      "type": "n8n-nodes-base.code",
      "position": [
        1250,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst r = item.json.to_do.rich_text ?? item.json.to_do.text ?? [];\nconst first = r.map((t) => t.plain_text ?? t.text?.content ?? \"\").join(\"\"),\n  m = first.match(/^(?:\\[([^\\]]+)\\]\\s*)?(.+)$/s);\nif (!m) throw Error(\"Empty to-do title\");\nconst names = $(\"Fetch Linear team details\").first().json.data.teams.nodes[0].members.nodes,\n  fragment = m[1] ?? \"\",\n  matches = fragment\n    ? names.filter((x) => x.name.toLowerCase().startsWith(fragment.toLowerCase()))\n    : [];\nitem.json.title = m[2];\nitem.json.assignee_fragment = fragment;\nitem.json.assignee = matches.length === 1 ? matches[0] : null;\nitem.json.original_rich = r.map((t) => {\n  const type = t.type ?? \"text\";\n  if (![\"text\", \"mention\", \"equation\"].includes(type) || !t[type])\n    throw Error(\"Unsupported rich text\");\n  return { type, [type]: t[type], ...(t.annotations ? { annotations: t.annotations } : {}) };\n});\nreturn item;\n"
      },
      "typeVersion": 2
    },
