    "modules": {
      "n_32cd3a1011291177": {
        "name": "Set report destinations",
        "imports": [],
        "source": "function reportConfig(at, spreadsheetId, range, channelId, shop = null) {\n  if (\n    !/^[A-Za-z0-9_-]{10,}$/.test(spreadsheetId) ||\n    spreadsheetId.startsWith(\"YOUR_\") ||\n    !range.trim() ||\n    !/^[CG][A-Z0-9]{8,}$/.test(channelId)\n  ) {\n    throw new Error(\"Configure the report spreadsheet, A1 range and Slack channel ID.\");\n  }\n  if (shop !== null && !/^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$/.test(shop)) {\n    throw new Error(\"Configure the Shopify myshopify.com hostname.\");\n  }\n\n  const end = new Date(at);\n  const timestamp = end.getTime();\n  if (!Number.isFinite(timestamp)) throw new Error(\"The schedule timestamp is missing.\");\n  end.setUTCDate(end.getUTCDate() - ((end.getUTCDay() + 6) % 7));\n  end.setUTCHours(10, 0, 0, 0);\n  if (end.getTime() > timestamp) end.setUTCDate(end.getUTCDate() - 7);\n  const start = new Date(end.getTime() - 7 * 86400000);\n  return {\n    weekStart: start.toISOString(),\n    weekEnd: end.toISOString(),\n    spreadsheetId,\n    range,\n    channelId,\n    shop,\n  };\n}\nexport default (v) => ({\n  config: reportConfig(v.at, v.spreadsheetId, v.range, v.channelId),\n  spreadsheetId: v.spreadsheetId,\n  range: v.range,\n  channelId: v.channelId,\n});\n"
      },
      "n_ce2a8a4d556417a6": {
        "name": "Collect order pages",
        "imports": [],
        "source": "function orderQuery(config, cursor) {\n  const query = `query WeeklyOrderTotals($filter: String!, $after: String) {\n    shop { currencyCode myshopifyDomain }\n    orders(first: 100, after: $after, query: $filter, sortKey: CREATED_AT) {\n      nodes { id createdAt closed cancelledAt totalPriceSet { shopMoney { amount currencyCode } } }\n      pageInfo { hasNextPage endCursor }\n    }\n  }`;\n  const filter =\n    \"status:open AND created_at:>='\" +\n    config.weekStart +\n    \"' AND created_at:<'\" +\n    config.weekEnd +\n    \"'\";\n  return { query, variables: { filter, after: cursor } };\n}\n\nfunction collectOrders(state, config, status, response) {\n  if (\n    status !== 200 ||\n    (response?.errors && (!Array.isArray(response.errors) || response.errors.length))\n  ) {\n    throw new Error(\"Shopify rejected the order query.\");\n  }\n  const { shop, orders } = response?.data ?? {};\n  const { currencyCode: currency, myshopifyDomain } = shop ?? {};\n  const { hasNextPage, endCursor } = orders?.pageInfo ?? {};\n  if (\n    !/^[A-Z]{3}$/.test(currency ?? \"\") ||\n    !myshopifyDomain ||\n    (config.shop && config.shop !== myshopifyDomain) ||\n    (state && (state.currency !== currency || state.domain !== myshopifyDomain)) ||\n    !Array.isArray(orders?.nodes) ||\n    typeof hasNextPage !== \"boolean\"\n  ) {\n    throw new Error(\"Shopify returned an incomplete or mismatched order page.\");\n  }\n\n  const seen = new Set(state?.ids ?? []);\n  const cursors = state?.cursors ?? [];\n  if (\n    hasNextPage &&\n    (cursors.length >= 249 ||\n      !orders.nodes.length ||\n      typeof endCursor !== \"string\" ||\n      !endCursor ||\n      cursors.includes(endCursor))\n  ) {\n    throw new Error(\"Shopify order pagination did not advance.\");\n  }\n\n  let sum = BigInt(state?.sum ?? \"0\");\n  let scale = state?.scale ?? 2;\n  for (const order of orders.nodes) {\n    const id = order?.id;\n    const created = Date.parse(order?.createdAt);\n    const amount = order?.totalPriceSet?.shopMoney;\n    const parts =\n      typeof amount?.amount === \"string\" && /^(\\d+)(?:\\.(\\d{1,12}))?$/.exec(amount.amount);\n    if (\n      typeof id !== \"string\" ||\n      !id ||\n      seen.has(id) ||\n      order.closed !== false ||\n      order.cancelledAt !== null ||\n      !Number.isFinite(created) ||\n      created < Date.parse(config.weekStart) ||\n      created >= Date.parse(config.weekEnd) ||\n      amount?.currencyCode !== currency ||\n      !parts\n    ) {\n      throw new Error(\"Shopify returned a duplicate, ineligible or invalid-money order.\");\n    }\n    const decimals = parts[2] ?? \"\";\n    const nextScale = Math.max(scale, decimals.length);\n    sum =\n      sum * 10n ** BigInt(nextScale - scale) +\n      BigInt(parts[1] + decimals) * 10n ** BigInt(nextScale - decimals.length);\n    scale = nextScale;\n    seen.add(id);\n  }\n  return {\n    currency,\n    domain: myshopifyDomain,\n    ids: [...seen],\n    sum: String(sum),\n    scale,\n    cursor: hasNextPage ? endCursor : null,\n    cursors: hasNextPage ? [...cursors, endCursor] : cursors,\n  };\n}\n\nexport default ({ config, state, status, response }) => {\n  const next = status === null ? null : collectOrders(state, config, status, response);\n  return {\n    state: next,\n    more: next === null || next.cursor !== null,\n    body: orderQuery(config, next?.cursor ?? null),\n  };\n};\n"
      },
      "n_64ca9b16b1ed457b": {
        "name": "Calculate the weekly report",
        "imports": [],
        "source": "function weeklyReport(config, state) {\n  if (!state || state.cursor !== null || state.ids.length >= 25000) {\n    throw new Error(\"The Shopify order list is incomplete or reached the pagination limit.\");\n  }\n  const decimal = state.sum.padStart(state.scale + 1, \"0\");\n  const ordersSum = decimal.slice(0, -state.scale) + \".\" + decimal.slice(-state.scale);\n  const totalOrders = state.ids.length;\n  const { weekStart, weekEnd } = config;\n  const { currency } = state;\n  return {\n    values: [[totalOrders, ordersSum, currency, weekStart, weekEnd]],\n    text:\n      \"Shopify weekly report (\" +\n      weekStart +\n      \" to \" +\n      weekEnd +\n      \", end excluded): \" +\n      totalOrders +\n      \" open orders, \" +\n      currency +\n      \" \" +\n      ordersSum +\n      \" total.\",\n    summary: { weekStart, weekEnd, totalOrders, ordersSum, currency },\n  };\n}\nexport default ({ config, state }) => {\n  const report = weeklyReport(config, state);\n  return { report, values: report.values, text: report.text };\n};\n"
      },
      "n_516249c71caca31a": {
        "name": "Verify the spreadsheet row",
        "imports": [],
        "source": "function confirmSheet(config, report, receipt) {\n  if (\n    receipt?.spreadsheetId !== config.spreadsheetId ||\n    receipt.updatedRows !== 1 ||\n    !receipt.updatedRange ||\n    JSON.stringify(receipt.updatedData?.values) !== JSON.stringify(report.values)\n  ) {\n    throw new Error(\n      \"The spreadsheet append was not confirmed. Check the report sheet before retrying.\",\n    );\n  }\n}\n\nexport default ({ config, report, spreadsheetId, updatedRows, updatedRange, updatedData }) => {\n  confirmSheet(config, report, { spreadsheetId, updatedRows, updatedRange, updatedData });\n  return {};\n};\n"
      },
      "n_cfd81c3c0b573516": {
        "name": "Confirm the Slack message",
        "imports": [],
        "source": "function confirmSlack(config, channelId, ts) {\n  if (channelId !== config.channelId || typeof ts !== \"string\" || !ts) {\n    throw new Error(\n      \"The Slack message was not confirmed. Check the channel and report sheet before retrying.\",\n    );\n  }\n}\n\nexport default ({ config, report, channelId, ts }) => {\n  confirmSlack(config, channelId, ts);\n  return { summary: report.summary };\n};\n"
      }
