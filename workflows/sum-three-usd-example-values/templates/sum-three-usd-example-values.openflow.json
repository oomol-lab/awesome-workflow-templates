        "imports": [],
        "source": "export default function sumExample() {\n  const items = [{ amount_USD: 50 }, { amount_USD: 20 }, { amount_USD: 60 }];\n  let total = 0;\n  for (const item of items) total += item.amount_USD;\n  return { total_value: total };\n}\n"
