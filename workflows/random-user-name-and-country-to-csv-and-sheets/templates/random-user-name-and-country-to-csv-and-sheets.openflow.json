    "modules": {
      "n_f30cce03a15a8235": {
        "name": "Prepare CSV and sheet row",
        "imports": [],
        "source": "export default async function prepare({ body }, context) {\n  const user = body?.results?.[0];\n  if (!user?.name || !user?.location) throw Error(\"Random User response missing fields\");\n  const name = [user.name.first, user.name.last].join(\" \"),\n    country = user.location.country;\n  const esc = (value) => '\"' + String(value ?? \"\").replaceAll('\"', '\"\"') + '\"';\n  const csv = [\"name,country\", [name, country].map(esc).join(\",\")].join(\"\\r\\n\") + \"\\r\\n\";\n  const file = await context.artifact.put(new TextEncoder().encode(csv), {\n    name: \"users_spreadsheet.csv\",\n    mediaType: \"text/csv\",\n  });\n  return { file, values: [[name, country]] };\n}\n"
      }
    }
