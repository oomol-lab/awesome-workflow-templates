    "modules": {
      "n_88b11b2af9a3b518": {
        "name": "Configure customers",
        "imports": [],
        "source": "export default function f({ customers, runId, to }) {\n  return { customers, runId, to };\n}\n"
      },
      "n_587eb0b3c1580b0c": {
        "name": "Reserve customer invoice",
        "imports": [],
        "source": "export default async function next(\n  { customers, runId, to, previous, confirmed, acknowledge, resolution },\n  ctx,\n) {\n  if (!runId || runId.startsWith(\"YOUR_\") || !to || to.includes(\"YOUR_\"))\n    throw Error(\"Configure run ID and recipient\");\n  if (!customers.length) throw Error(\"Provide at least one customer\");\n  const all = [...customers].sort((a, b) => a.name.localeCompare(b.name));\n  if (\n    all.some((x) => !x.id || !x.name || !x.email || !x.created) ||\n    new Set(all.map((x) => x.id)).size !== all.length\n  )\n    throw Error(\"Each customer needs a unique ID, name, email and created date\");\n  const i = previous ? previous.index + (confirmed ? 1 : 0) : 0,\n    state = { index: i };\n  if (i >= all.length)\n    return { more: false, skip: false, state, key: \"\", subject: \"\", text: \"\", to };\n  const c = all[i],\n    key = \"invoice-demo:\" + runId + \":invoice:\" + c.id,\n    old = await ctx.state.get(key);\n  let skip = old?.status === \"done\";\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(resolution))\n      throw Error(\"Inspect invoice email: \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      skip = true;\n    }\n  }\n  if (!skip) await ctx.state.set(key, { status: \"pending\" });\n  return {\n    more: true,\n    skip,\n    state,\n    key,\n    to,\n    subject: \"Invoice for \" + c.name,\n    text: `Date: ${c.created}\\nTo: ${c.name} <${c.email}>\\nAddress: ${c.country || \"\"}\\nDetails:\\n- Design of HTML banners x 1 = 22.00€ + 4.62€ = 26.62€\\n- Design of PNG banners x 1 = 33.00€ + 6.93€ = 39.93€\\nTotal invoice: 66.55€`,\n  };\n}\n"
      },
      "n_f7023e01095bbfd7": {
        "name": "Confirm invoice email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown Gmail result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { confirmed: true };\n}\n"
      },
      "n_5d7010a957b99814": {
        "name": "Continue after invoice",
        "imports": [],
        "source": "export default function f() {\n  return { confirmed: true };\n}\n"
      },
      "n_19317185c337b8c1": {
        "name": "Reserve customer summary",
        "imports": [],
        "source": "export default async function summary({ customers, runId, to, acknowledge, resolution }, ctx) {\n  const key = \"invoice-demo:\" + runId + \":summary\",\n    old = await ctx.state.get(key);\n  let send = old?.status !== \"done\";\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(resolution))\n      throw Error(\"Inspect summary email: \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      send = false;\n    }\n  }\n  if (send) await ctx.state.set(key, { status: \"pending\" });\n  const esc = (s) =>\n      String(s)\n        .replaceAll(\"&\", \"&amp;\")\n        .replaceAll(\"<\", \"&lt;\")\n        .replaceAll(\">\", \"&gt;\")\n        .replaceAll('\"', \"&quot;\")\n        .replaceAll(\"'\", \"&#39;\"),\n    lines = [...customers]\n      .sort((a, b) => a.name.localeCompare(b.name))\n      .map((c) => \"<li>\" + esc(c.name) + \": \" + esc(c.email) + \"</li>\")\n      .join(\"\");\n  return { key, send, to, html: \"<p>Customers:</p><ul>\" + lines + \"</ul>\" };\n}\n"
      },
      "n_38745611859567ad": {
        "name": "Confirm summary email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown Gmail result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
