    {
      "name": "Render invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $(\"One customer at a time\").item.json;\nreturn {\n  json: {\n    subject: \"Invoice for \" + c.name,\n    text: `Date: ${c.created}\\nTo: ${c.name} <${c.email}>\\nAddress: ${c.country || \"\"}\\nDetails:\\n- Design of HTML banners x 1 = 22.00€ + 4.62€ = 26.62€\\n- Design of PNG banners x 1 = 33.00€ + 6.93€ = 39.93€\\nTotal invoice: 66.55€`,\n  },\n};\n"
      },
      "id": "email-customer-invoice-and-summary-7",
      "position": [
        1540,
        0
      ]
    },
