    {
      "name": "Configure customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const runId = \"YOUR_RUN_ID\",\n  customers = [];\nif (!runId || runId.startsWith(\"YOUR_\")) throw Error(\"Configure a unique run ID and customers\");\nif (!customers.length) throw Error(\"Provide at least one customer\");\nif (\n  customers.some((c) => !c.id || !c.name || !c.email || !c.created) ||\n  new Set(customers.map((c) => c.id)).size !== customers.length\n)\n  throw Error(\"Each customer needs unique id, name, email and created\");\ncustomers.sort((a, b) => a.name.localeCompare(b.name));\nreturn customers.map((c) => ({ json: { ...c, runId } }));\n"
      },
      "id": "email-customer-invoice-and-summary-1",
      "position": [
        220,
        0
      ]
    },
