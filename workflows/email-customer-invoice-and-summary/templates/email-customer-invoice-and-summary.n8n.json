    {
      "name": "Render summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = (s) =>\n  String(s)\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\\\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#39;\");\nconst cs = $(\"Configure customers\")\n  .all()\n  .map((x) => x.json);\nreturn {\n  json: {\n    html:\n      \"<p>Customers:</p><ul>\" +\n      cs.map((c) => \"<li>\" + esc(c.name) + \": \" + esc(c.email) + \"</li>\").join(\"\") +\n      \"</ul>\",\n  },\n};\n"
      },
      "id": "email-customer-invoice-and-summary-16",
      "position": [
        3520,
        0
      ]
