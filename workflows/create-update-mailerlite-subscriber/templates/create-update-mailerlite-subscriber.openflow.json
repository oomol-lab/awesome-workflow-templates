    "modules": {
      "n_3d03a7383168b4c1": {
        "name": "Validate subscriber details",
        "imports": [],
        "source": "export default function setup({ email, name, city }) {\n  if (\n    typeof email !== \"string\" ||\n    !/^\\S+@\\S+\\.\\S+$/.test(email.trim()) ||\n    typeof name !== \"string\" ||\n    !name.trim() ||\n    typeof city !== \"string\" ||\n    !city.trim()\n  )\n    throw Error(\"Enter an email, name and city\");\n  return { email: email.trim(), name: name.trim(), city: city.trim() };\n}\n"
      },
      "n_770637fb5c7f4829": {
        "name": "Create or update subscriber",
        "imports": [],
        "source": "export default async function create({ email, name }, context) {\n  return await context.actions.call(\"mailerlite.upsert_subscriber\", { email, fields: { name } });\n}\n"
      },
      "n_93d34d05f5298f2d": {
        "name": "Identify subscriber",
        "imports": [],
        "source": "export default function identify({ data, email }) {\n  if (\n    !data ||\n    typeof data.id !== \"string\" ||\n    !data.id ||\n    data.email?.toLowerCase() !== email.toLowerCase()\n  )\n    throw Error(\"MailerLite did not return the requested subscriber\");\n  return { id: data.id };\n}\n"
      },
      "n_452ffdf3f6b2010e": {
        "name": "Update city",
        "imports": [],
        "source": "export default async function update({ id, city }, context) {\n  return await context.actions.call(\"mailerlite.update_subscriber\", {\n    subscriber_id: id,\n    fields: { city },\n  });\n}\n"
      },
      "n_c49391187658b335": {
        "name": "Confirm update",
        "imports": [],
        "source": "export default function updated({ data, id }) {\n  if (!data || data.id !== id) throw Error(\"MailerLite did not confirm the same subscriber\");\n  return { ok: true };\n}\n"
      },
      "n_5d0fc627a94b1c25": {
        "name": "Verify subscriber",
        "imports": [],
        "source": "export default function result({ data, id, email, name, city }) {\n  if (\n    !data ||\n    data.id !== id ||\n    data.email?.toLowerCase() !== email.toLowerCase() ||\n    data.fields?.name !== name ||\n    data.fields?.city !== city\n  )\n    throw Error(\"MailerLite did not return the expected subscriber\");\n  return { subscriber: data };\n}\n"
      }
    }
