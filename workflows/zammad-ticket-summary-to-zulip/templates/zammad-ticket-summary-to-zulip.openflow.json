    "modules": {
      "n_89610406e1110e0b": {
        "name": "Count ticket states",
        "imports": [],
        "source": "export default function collect({ previousState, tickets, newId, openId, reminderId, closeId }) {\n  const ids = [newId, openId, reminderId, closeId];\n  if (ids.some((x) => !Number.isSafeInteger(x) || x < 1) || new Set(ids).size !== 4)\n    throw Error(\"Configure four distinct positive Zammad state IDs\");\n  if (previousState === null) {\n    if (tickets !== null) throw Error(\"Unexpected initial ticket page\");\n    return {\n      state: { page: 1, seen: [], counts: [0, 0, 0, 0] },\n      page: 1,\n      more: true,\n      hasTickets: false,\n      counts: [0, 0, 0, 0],\n    };\n  }\n  if (\n    !previousState ||\n    !Number.isSafeInteger(previousState.page) ||\n    !Array.isArray(previousState.seen) ||\n    !Array.isArray(previousState.counts) ||\n    !Array.isArray(tickets)\n  )\n    throw Error(\"Invalid Zammad page state\");\n  const seen = new Set(previousState.seen),\n    counts = [...previousState.counts];\n  for (const t of tickets) {\n    if (\n      !t ||\n      !Number.isSafeInteger(t.id) ||\n      t.id < 1 ||\n      !Number.isSafeInteger(t.state_id) ||\n      seen.has(t.id)\n    )\n      throw Error(\"Invalid or duplicate Zammad ticket\");\n    seen.add(t.id);\n    const index = ids.indexOf(t.state_id);\n    if (index !== -1) counts[index]++;\n  }\n  const state = { page: previousState.page + 1, seen: [...seen], counts };\n  return {\n    state,\n    page: state.page,\n    more: tickets.length > 0,\n    hasTickets: state.seen.length > 0,\n    counts,\n  };\n}\n"
      },
      "n_0658d606aeeee973": {
        "name": "Prepare the Zulip summary",
        "imports": [],
        "source": "export default function message({ counts, stream, topic }) {\n  if (\n    !Array.isArray(counts) ||\n    counts.length !== 4 ||\n    counts.some((x) => !Number.isSafeInteger(x) || x < 0) ||\n    typeof stream !== \"string\" ||\n    !stream.trim() ||\n    typeof topic !== \"string\" ||\n    !topic.trim()\n  )\n    throw Error(\"Configure the Zulip stream and topic\");\n  const [n, o, r, c] = counts;\n  return {\n    body: {\n      type: \"stream\",\n      to: stream.trim(),\n      topic: topic.trim(),\n      content: `:ticket: Support Tickets Summary:\\n* Open: ${o}\\n* New: ${n}\\n* Pending Close ${c}\\n* Pending Reminder ${r}`,\n    },\n  };\n}\n"
      },
      "n_3dda71f76bf5d817": {
        "name": "Confirm the Zulip message",
        "imports": [],
        "source": "export default function confirm({ body }) {\n  if (!body || body.result !== \"success\" || !Number.isSafeInteger(body.id) || body.id < 1)\n    throw Error(\"Zulip did not confirm the message\");\n  return { messageId: body.id };\n}\n"
      }
    }
