    "modules": {
      "n_9864d5cdf1cbcabc": {
        "name": "Collect six analytics reports",
        "imports": [],
        "source": "export default async function collect({propertyId,previous},context){\n const groups=[{dimension:'unifiedScreenName',metrics:['screenPageViews','activeUsers','screenPageViewsPerUser','eventCount']},{dimension:'landingPagePlusQueryString',metrics:['activeUsers','engagedSessions','engagementRate','eventCount','organicGoogleSearchAveragePosition','organicGoogleSearchClickThroughRate','organicGoogleSearchClicks','organicGoogleSearchImpressions']},{dimension:'country',metrics:['activeUsers','newUsers','engagementRate','engagedSessions','eventCount','totalUsers','sessions']}];\n if(typeof propertyId!=='string'||!/^\\d+$/.test(propertyId))throw Error('Configure a Google Analytics property ID');\n const day=new Date().toISOString().slice(0,10),d=(base,n)=>new Date(Date.parse(base+'T00:00:00Z')+n*86400000).toISOString().slice(0,10),s=previous??{index:0,offset:0,day,tables:[[],[],[],[],[],[]]};\n if(!Number.isSafeInteger(s.index)||s.index<0||s.index>=6||!Number.isSafeInteger(s.offset)||s.offset<0||!Array.isArray(s.tables)||s.tables.length!==6||typeof s.day!=='string')throw Error('Invalid report state');\n const g=groups[Math.floor(s.index/2)],recent=s.index%2===0,range={startDate:d(s.day,recent?-7:-14),endDate:d(s.day,recent?-1:-8)},result=await context.actions.call('google_analytics.run_report',{propertyId,dateRanges:[range],dimensions:[g.dimension],metrics:g.metrics,keepEmptyRows:true,limit:10000,offset:s.offset});\n const r=result?.report;if(!r||!Array.isArray(r.rows))throw Error('Invalid analytics response');const count=r.rowCount==null&&r.rows.length===0&&s.offset===0?0:r.rowCount;if(!Number.isSafeInteger(count)||count<0||s.offset+r.rows.length>count||(!r.rows.length&&s.offset<count))throw Error('Invalid analytics page count');\n const rows=r.rows.map(x=>{if(!Array.isArray(x.dimensionValues)||x.dimensionValues.length!==1||typeof x.dimensionValues[0]!=='string'||!Array.isArray(x.metricValues)||x.metricValues.length!==g.metrics.length||x.metricValues.some(v=>typeof v!=='string'))throw Error('Invalid analytics row');return [x.dimensionValues[0],...x.metricValues]});\n const tables=s.tables.map(x=>Array.isArray(x)?[...x]:(()=>{throw Error('Invalid report table')})());tables[s.index].push(...rows);const offset=s.offset+rows.length,finished=offset===count,index=finished?s.index+1:s.index;\n return {state:{index,offset:finished?0:offset,day:s.day,tables},more:index<6};\n}\n"
      },
      "n_ea342f805319f6e7": {
        "name": "Format the comparison",
        "imports": [],
        "source": "export default function format({state,recipient}){\n if(typeof recipient!=='string'||!recipient.includes('@')||recipient.includes('YOUR_'))throw Error('Configure a report recipient');if(!state||state.index!==6||!Array.isArray(state.tables)||state.tables.length!==6)throw Error('Incomplete report');\n const labels=[['Page','Page views','Active users','Views per user','Event count'],['Landing page','Active users','Engaged sessions','Engagement rate','Event count','Average position','Click-through rate','Clicks','Impressions'],['Country','Active users','New users','Engagement rate','Engaged sessions','Event count','Total users','Sessions']],sections=['Page engagement','Google Search','Country views'],escape=v=>String(v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));let html='<h1>Google Analytics report</h1>';\n for(let i=0;i<6;i++){if(!Array.isArray(state.tables[i]))throw Error('Invalid report table');html+='<h2>'+sections[Math.floor(i/2)]+' - '+(i%2?'previous seven days':'latest seven days')+'</h2>';const rows=state.tables[i];if(!rows.length){html+='<p>No data.</p>';continue}html+='<table><thead><tr>'+labels[Math.floor(i/2)].map(x=>'<th>'+escape(x)+'</th>').join('')+'</tr></thead><tbody>';for(const r of rows){if(!Array.isArray(r)||r.length!==labels[Math.floor(i/2)].length)throw Error('Invalid formatted row');html+='<tr>'+r.map(x=>'<td>'+escape(x)+'</td>').join('')+'</tr>'}html+='</tbody></table>'}return{to:recipient,subject:'Google Analytics report before '+state.day+' UTC',body:html};\n}\n"
      }
