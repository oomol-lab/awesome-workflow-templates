    "modules": {
      "n_187de45eb7afbf72": {
        "name": "Prepare task request",
        "imports": [],
        "source": "export default function (x) {\n  for (const k of [\n    \"taskId\",\n    \"requestId\",\n    \"caseId\",\n    \"workflowType\",\n    \"industry\",\n    \"applicantName\",\n    \"portalUrl\",\n  ])\n    if (typeof x[k] !== \"string\" || !x[k].trim())\n      throw Error(\"All task and case fields are required\");\n  if (!/^https?:\\/\\//i.test(x.portalUrl)) throw Error(\"Enter an HTTP portal URL\");\n  return {\n    url: \"https://api.komos.ai/public/v1/tasks/\" + encodeURIComponent(x.taskId) + \"/runs\",\n    key: \"komos:\" + x.taskId + \":\" + x.requestId,\n    body: {\n      clientRequestId: x.requestId,\n      inputs: {\n        case_id: x.caseId,\n        workflow_type: x.workflowType,\n        applicant_name: x.applicantName,\n        portal_url: x.portalUrl,\n        review_required: true,\n      },\n      metadata: {\n        source: \"openflow\",\n        use_case: \"regulated_browser_operations\",\n        industry: x.industry,\n      },\n    },\n  };\n}\n"
      },
      "n_773ff3664e5f3808": {
        "name": "Reserve task submission",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  const s = await ctx.state.get(key);\n  if (s) throw Error(\"Request already pending or submitted; inspect Komos run history: \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ok: true };\n}\n"
      },
      "n_ff6ed991bcc6f8f9": {
        "name": "Confirm queued run",
        "imports": [],
        "source": "export default async function ({ key, body }, ctx) {\n  if (!body || typeof body.id !== \"string\" || !body.id)\n    throw Error(\"Unknown Komos result; inspect run history\");\n  await ctx.state.set(key, { status: \"done\", runId: body.id });\n  return {\n    result: {\n      status: \"queued\",\n      komos_response: body,\n      next_step:\n        \"Review Komos run history for browser actions, logs, and human approval checkpoints.\",\n    },\n  };\n}\n"
      }
    }
