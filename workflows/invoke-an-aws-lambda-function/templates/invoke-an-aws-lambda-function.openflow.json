    "modules": {
      "n_5ff325a8f837a998": {
        "name": "Sign the Lambda request",
        "imports": [],
        "source": "import{createHash,createHmac}from'node:crypto';\nexport default function sign({functionName,region,accessKeyId,secretAccessKey,sessionToken}){for(const [k,v]of Object.entries({functionName,region,accessKeyId,secretAccessKey}))if(typeof v!=='string'||!v||v.startsWith('YOUR_'))throw Error('Configure '+k);if(!/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))throw Error('Invalid AWS region');const host='lambda.'+region+'.amazonaws.com'+(region.startsWith('cn-')?'.cn':''),path='/2015-03-31/functions/'+encodeURIComponent(functionName)+'/invocations',query='Qualifier=%24LATEST',body='',timestamp=new Date().toISOString().replace(/[:-]|\\.\\d{3}/g,''),date=timestamp.slice(0,8),headers={'content-type':'application/x-amz-json-1.0',host,'x-amz-date':timestamp,'x-amz-invocation-type':'RequestResponse',...(sessionToken?{'x-amz-security-token':sessionToken}:{})},names=Object.keys(headers).sort(),signedHeaders=names.join(';'),canonicalHeaders=names.map(k=>k+':'+headers[k].trim().replace(/\\s+/g,' ')+'\\n').join(''),hash=x=>createHash('sha256').update(x).digest('hex'),hmac=(k,v)=>createHmac('sha256',k).update(v).digest(),scope=date+'/'+region+'/lambda/aws4_request',canonical=['POST',path.replace(/%/g,'%25'),query,canonicalHeaders,signedHeaders,hash(body)].join('\\n'),toSign=['AWS4-HMAC-SHA256',timestamp,scope,hash(canonical)].join('\\n'),key=hmac(hmac(hmac(hmac('AWS4'+secretAccessKey,date),region),'lambda'),'aws4_request'),signature=createHmac('sha256',key).update(toSign).digest('hex');return{url:'https://'+host+path+'?'+query,authorization:'AWS4-HMAC-SHA256 Credential='+accessKeyId+'/'+scope+', SignedHeaders='+signedHeaders+', Signature='+signature,amzDate:timestamp,body};}\n"
      },
      "n_b7e357d03434e96e": {
        "name": "Check the invocation",
        "imports": [],
        "source": "export default function check({body,headers}){if(Object.entries(headers??{}).some(([k,v])=>k.toLowerCase()==='x-amz-function-error'&&v))throw Error('Lambda function failed');if(body&&typeof body==='object'&&body.errorMessage!==undefined)throw Error('Lambda function failed');return{result:body}}\n"
      }
