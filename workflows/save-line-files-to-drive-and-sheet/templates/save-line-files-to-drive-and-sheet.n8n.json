    {
      "name": "Prepare success reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare LINE event\").item.json,\n  e = p.event,\n  u = $(\"Verify direct upload\").item.json;\nreturn {\n  json: {\n    replyToken: e.replyToken,\n    messages: [\n      {\n        type: \"text\",\n        text: u.webContentLink || \"https://drive.google.com/file/d/\" + u.id + \"/view\",\n      },\n    ],\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "line-save-25"
    },
    {
      "name": "Prepare rejected reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"Prepare LINE event\").item.json.event;\nreturn {\n  json: {\n    replyToken: e.replyToken,\n    messages: [{ type: \"text\", text: \"This file type is not allowed.\" }],\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "line-save-26"
    },
    {
