      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {},
      "id": "line-save-30"
    },
    {
      "name": "Receive media job",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "line-media-upload",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "line-save-31"
    },
    {
      "name": "Validate media job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json.body ?? {},\n  id = x.requestId;\nif (\n  !/^[A-Za-z0-9_-]{8,128}$/.test(id ?? \"\") ||\n  !/^[A-Za-z0-9_-]+$/.test(x.messageId ?? \"\") ||\n  !/^[A-Za-z0-9_-]+$/.test(x.parent ?? \"\") ||\n  ![\"image\", \"video\", \"audio\", \"file\"].includes(x.type) ||\n  !Number.isFinite(x.timestamp)\n)\n  throw Error(\"Invalid media job\");\nreturn { json: { ...x }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-32"
    },
    {
      "name": "Check media job",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'line-job:'+ $('Validate media job').first().json.requestId }}"
            }
          ]
        },
        "operation": "rowNotExists"
      },
      "id": "line-save-33"
    },
    {
