          "value": {
            "item_key": "={{ 'line:'+ $('Prepare LINE event').item.json.event.webhookEventId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "line-save-8"
    },
    {
      "name": "Restore LINE event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Prepare LINE event\").item.json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-9"
    },
    {
      "name": "Allowed file type?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.allowed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "line-save-10"
    },
    {
      "name": "Select folder step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare LINE event\").item.json,\n  stage = $json.stage ?? 0,\n  parent = $json.parent ?? p.parent,\n  names = [...(p.byDate ? [p.date] : []), ...(p.byType ? [p.event.message.type] : [])],\n  name = names[stage];\nif (!/^[\\w-]+$/.test(parent) || (name && /[\\\\/\\x00-\\x1f]/.test(name)))\n  throw Error(\"Invalid folder\");\nreturn { json: { parent, stage, name: name ?? \"\", done: !name }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-11"
    },
    {
      "name": "Folder selection complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "line-save-12"
    },
    {
      "id": "line-save-13",
      "name": "Find matching folder",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        980,
        0
      ],
      "parameters": {
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $json.parent }}"
          },
          "whatToSearch": "folders"
        },
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType"
          ]
        },
        "resource": "fileFolder",
        "queryString": "={{ $json.name }}"
      },
      "typeVersion": 3,
      "alwaysOutputData": true
    },
    {
      "name": "Select matching folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const target = $(\"Select folder step\").first().json.name,\n  a = $input\n    .all()\n    .map((x) => x.json)\n    .filter(\n      (x) => x.id && x.name === target && x.mimeType === \"application/vnd.google-apps.folder\",\n    );\nif (a.length > 1) throw Error(\"Duplicate folders\");\nreturn [{ json: { exists: a.length === 1, id: a[0]?.id ?? \"\" }, pairedItem: { item: 0 } }];\n"
      },
      "id": "line-save-14"
    },
    {
      "name": "Folder exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
