        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id) throw Error(\"Inspect Drive upload\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-21"
    },
