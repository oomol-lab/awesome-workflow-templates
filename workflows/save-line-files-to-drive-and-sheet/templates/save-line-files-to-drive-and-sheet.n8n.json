      },
      "typeVersion": 4.2,
      "alwaysOutputData": true
    },
    {
      "name": "Verify LINE reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.statusCode < 200 || $json.statusCode >= 300 || !Number.isInteger($json.statusCode))\n  throw Error(\"Inspect LINE reply\");\nreturn { json: { ok: true }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-28"
    },
