    {
      "name": "Advance folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prior = $(\"Select folder step\").item.json,\n  id = $json.id;\nif (!id) throw Error(\"Inspect folder result\");\nreturn { json: { parent: id, stage: prior.stage + 1 }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-17"
    },
    {
      "name": "Prepare direct media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare LINE event\").item.json;\nreturn {\n  json: {\n    requestId: p.event.webhookEventId,\n    messageId: p.event.message.id,\n    parent: $json.parent,\n    type: p.event.message.type,\n    timestamp: p.event.timestamp,\n    reply: p.reply,\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "line-save-18"
    },
