    {
      "name": "Verify LINE log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const u = $(\"Verify direct upload\").item.json;\nif (!$json[\"File Name\"] || $json[\"File Name\"] !== u.name || !$json[\"Google Drive URL\"])\n  throw Error(\"Inspect Sheets append\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-23"
    },
    {
      "name": "Reply enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
