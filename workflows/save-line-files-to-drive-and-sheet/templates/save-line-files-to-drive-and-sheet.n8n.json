          "rawBody": true
        },
        "httpMethod": "POST"
      },
      "typeVersion": 1
    },
    {
      "name": "Verify LINE signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require(\"crypto\");\nconst raw = Buffer.from($binary?.data?.data ?? \"\", \"base64\"),\n  sig = String($json.headers?.[\"x-line-signature\"] ?? \"\"),\n  secret = $env.LINE_CHANNEL_SECRET,\n  relay = $env.LINE_RELAY_SECRET;\nif (!raw.length || !secret || !relay) throw Error(\"Missing LINE signature configuration\");\nconst want = crypto.createHmac(\"sha256\", secret).update(raw).digest(),\n  got = Buffer.from(sig, \"base64\");\nif (got.length !== want.length || !crypto.timingSafeEqual(got, want))\n  throw Error(\"Invalid LINE signature\");\nconst body = JSON.parse(raw.toString(\"utf8\"));\nreturn (body.events ?? [])\n  .filter(\n    (e) => e.type === \"message\" && [\"image\", \"video\", \"audio\", \"file\"].includes(e.message?.type),\n  )\n  .map((event, i) => {\n    const payload = Buffer.from(JSON.stringify(event), \"utf8\").toString(\"base64\"),\n      signature = crypto.createHmac(\"sha256\", relay).update(payload, \"utf8\").digest(\"base64\");\n    return { json: { event, payload, signature }, pairedItem: { item: 0 } };\n  });\n"
      },
      "id": "line-save-1"
    },
    {
      "name": "Configure processing mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, mode: \"direct\" }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "line-save-2"
    },
    {
      "name": "Forward to Open Flow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.mode }}",
              "rightValue": "forward",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "line-save-3"
    },
    {
      "name": "Forward verified event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_OPEN_FLOW_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {payload:$json.payload,signature:$json.signature} }}",
        "options": {}
      },
      "id": "line-save-4",
      "onError": "continueErrorOutput"
    },
    {
      "id": "line-save-5",
      "name": "Get Config",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1220,
        -200
      ],
      "parameters": {
        "range": "config!A1:H2",
        "options": {},
        "sheetId": "YOUR_SPREADSHEET_ID"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
    {
      "name": "Prepare LINE event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const event = $(\"Verify LINE signature\").item.json.event,\n  c = $json,\n  yes = (x) => x === true || String(x).toLowerCase() === \"true\";\nif (!event?.webhookEventId || !event.message?.id || !c[\"Parent Folder ID\"])\n  throw Error(\"Missing event or configuration\");\nconst allowed = String(c[\"Allow File Types\"] ?? \"\")\n    .split(\"|\")\n    .map((x) => x.trim().toLowerCase())\n    .includes(event.message.type),\n  date = String(\n    c.CurrentDate || new Date(event.timestamp).toISOString().slice(0, 10).replaceAll(\"-\", \"\"),\n  );\nreturn {\n  json: {\n    event,\n    allowed,\n    parent: String(c[\"Parent Folder ID\"]),\n    date,\n    byDate: yes(c[\"Store by Date\"]),\n    byType: yes(c[\"Store by File Type\"]),\n    reply: yes(c[\"Reply Enabled\"]),\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "line-save-6"
    },
    {
      "name": "Check LINE event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'line:'+ $('Prepare LINE event').item.json.event.webhookEventId }}"
            }
          ]
        },
        "operation": "rowNotExists"
      },
      "id": "line-save-7"
    },
    {
      "name": "Reserve LINE event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
