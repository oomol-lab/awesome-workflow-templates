    "modules": {
      "n_e1d3013e88466738": {
        "name": "Check the Reader content",
        "imports": [],
        "source": "export default function readerText({ body }) {\n  if (typeof body?.data?.content !== \"string\" || !body.data.content.trim())\n    throw new Error(\"Reader did not return page content\");\n  return { text: body.data.content };\n}\n"
      },
      "n_eb7774b663a3f4b7": {
        "name": "Map the book columns",
        "imports": [],
        "source": "export default function rows({ result }) {\n  if (!Array.isArray(result?.results)) throw new Error(\"Expected extracted book list\");\n  const fields = [\"title\", \"price\", \"availability\", \"image_url\", \"product_url\"];\n  const values = result.results.map((book, i) => {\n    if (!book || typeof book !== \"object\" || Array.isArray(book))\n      throw new Error(\"Invalid book \" + i);\n    return fields.map((k) => {\n      let value = book[k];\n      if (value == null) return \"\";\n      if (typeof value !== \"string\") throw new Error(\"Invalid \" + k);\n      return value;\n    });\n  });\n  return { values, count: values.length, hasRows: values.length > 0 };\n}\n"
      },
      "n_848523d5ea577ad6": {
        "name": "Confirm the appended rows",
        "imports": [],
        "source": "export default function confirm({ count, updatedRows, updatedCells }) {\n  if (updatedRows !== count || updatedCells !== count * 5)\n    throw new Error(\"Sheets did not confirm all book rows; inspect before replaying\");\n  return { count, status: \"appended\" };\n}\n"
      },
      "n_92c77d30ac388d00": {
