    "modules": {
      "n_f51744120a4c538b": {
        "name": "Prepare company lookup",
        "imports": [],
        "source": "export default function prepare({ name, country }) {\n  if (typeof name !== \"string\" || !name || typeof country !== \"string\")\n    throw Error(\"Enter a company name and country\");\n  return { body: { processor: \"get-company-by-name\", params: { name, country } } };\n}\n"
      },
      "n_d38a70f62d734d3e": {
        "name": "Check company names",
        "imports": [],
        "source": "export default function results({ body }) {\n  const rows = Array.isArray(body) ? body : [body];\n  return {\n    results: rows.map((response) => ({\n      response,\n      found: /.+/.test(String(response?.message?.name || \"\")),\n    })),\n  };\n}\n"
      }
    }
