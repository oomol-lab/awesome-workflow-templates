      "position": [
        640,
        510
      ],
      "parameters": {
        "functionCode": "item.company = \"Example Company\";\nitem.country = \"Spain\";\nreturn item;"
      },
      "typeVersion": 1,
      "id": "look-up-company-by-name-with-uproc-1"
    },
    {
      "name": "Get Company by Name",
      "type": "n8n-nodes-base.uproc",
      "position": [
        850,
        510
      ],
      "parameters": {
        "name": "={{$node[\"Create Company Item\"].json[\"company\"]}}",
        "tool": "getCompanyByName",
        "group": "company",
        "country": "={{$node[\"Create Company Item\"].json[\"country\"]}}",
        "additionalOptions": {}
      },
      "typeVersion": 1,
      "id": "look-up-company-by-name-with-uproc-2"
    },
    {
      "name": "Company Found?",
