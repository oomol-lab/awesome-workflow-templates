        1050,
        510
      ],
      "parameters": {
        "conditions": {
          "number": [],
          "string": [
            {
              "value1": "={{$node[\"Get Company by Name\"].json[\"message\"][\"name\"]}}",
              "value2": ".+",
              "operation": "regex"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "look-up-company-by-name-with-uproc-3"
    }
  ],
