    "modules": {
      "n_c1c6783643999a3e": {
        "name": "Validate contact details",
        "imports": [],
        "source": "export default function setup({givenName,familyName,company,title,domain}){for(const [k,v]of Object.entries({givenName,familyName,company,title,domain}))if(typeof v!=='string'||!v.trim())throw Error('Enter '+k);return {givenName:givenName.trim(),familyName:familyName.trim(),company:company.trim(),title:title.trim(),domain:domain.trim(),body:{names:[{givenName:givenName.trim(),familyName:familyName.trim(),middleName:''}]}};}\n"
      },
      "n_039fbc6e349cfdba": {
        "name": "Identify contact",
        "imports": [],
        "source": "export default function created({body}){const resourceName=body?.resourceName;if(typeof resourceName!=='string'||!/^people\\/[a-zA-Z0-9_-]+$/.test(resourceName))throw Error('Contact resource name missing');return {resourceName,url:'https://people.googleapis.com/v1/'+resourceName};}\n"
      },
      "n_5e358dc5b6980717": {
        "name": "Prepare organization update",
        "imports": [],
        "source": "export default function prepare({body,resourceName,company,title,domain}){if(body?.resourceName!==resourceName||!Array.isArray(body?.metadata?.sources))throw Error('Contact metadata missing');const sources=body.metadata.sources.filter(s=>s?.type==='CONTACT'&&typeof s.etag==='string'&&s.etag);if(sources.length!==1)throw Error('Expected one contact source with etag');return {url:'https://people.googleapis.com/v1/'+resourceName+':updateContact',body:{resourceName,metadata:{sources},organizations:[{name:company,title,domain,current:true}]}};}\n"
      },
      "n_8aaa64cd6611ba5d": {
        "name": "Verify the contact",
        "imports": [],
        "source": "export default function confirm({body,resourceName,company,title,domain}){if(body?.resourceName!==resourceName||!Array.isArray(body.organizations)||!body.organizations.some(o=>o.name===company&&o.title===title&&o.domain===domain&&o.current===true))throw Error('Updated contact does not match');return {contact:body};}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
