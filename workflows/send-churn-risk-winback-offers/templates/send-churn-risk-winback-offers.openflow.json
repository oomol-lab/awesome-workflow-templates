    "modules": {
      "n_781e77af37b83455": {
        "name": "Read customer",
        "imports": [],
        "source": "export default function f({ body }) {\n  return {\n    score: Number(body.predicted_churn_score),\n    categories: String(body.preferred_categories),\n  };\n}\n"
      },
      "n_6ea338cd44165f0c": {
        "name": "Reserve customer email",
        "imports": [],
        "source": "export default async function plan({ body, details, acknowledge, resolution }, ctx) {\n  const id = String(body.customer_id || \"\").trim(),\n    email = String(body.user_mail || \"\").trim(),\n    score = Number(body.predicted_churn_score),\n    day = String(body.day || \"\");\n  if (\n    !id ||\n    !email ||\n    !/^\\d{4}-\\d\\d-\\d\\d$/.test(day) ||\n    !Number.isFinite(score) ||\n    score <= 0.7 ||\n    score > 1\n  )\n    throw Error(\"Invalid customer, day or churn score\");\n  const key = \"churn:\" + day + \":\" + id,\n    old = await ctx.state.get(key);\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending email \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"sent\" });\n      return { send: false, key, to: email, details };\n    }\n  }\n  if (old?.status === \"sent\" || old?.status === \"logged\" || old?.status === \"log-pending\")\n    return { send: false, key, to: email, details };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { send: true, key, to: email, details };\n}\n"
      },
      "n_56cd2eb7c7fdf4a2": {
        "name": "Confirm customer email",
        "imports": [],
        "source": "export default async function sent({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Email result unknown\");\n  await ctx.state.set(key, { status: \"sent\" });\n  return { ok: true };\n}\n"
      },
      "n_256b156ec21842f2": {
        "name": "Reserve system log",
        "imports": [],
        "source": "export default async function plan({ key, body, acknowledge, resolution }, ctx) {\n  let old = await ctx.state.get(key);\n  if (old?.status === \"logged\") return { write: false, key, values: [] };\n  if (old?.status === \"log-pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending sheet log \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"logged\" });\n      return { write: false, key, values: [] };\n    }\n  } else if (old?.status !== \"sent\") throw Error(\"Email is not confirmed\");\n  await ctx.state.set(key, { status: \"log-pending\" });\n  return {\n    write: true,\n    key,\n    values: [[String(body.customer_id), \"SENT_WINBACK_OFFER\", new Date().toISOString()]],\n  };\n}\n"
      },
      "n_b15453c4260433d2": {
        "name": "Confirm system log",
        "imports": [],
        "source": "export default async function confirm({ key, updatedRows }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Sheet result unknown\");\n  await ctx.state.set(key, { status: \"logged\" });\n  return { ok: true };\n}\n"
      },
      "n_976a8d349af8a9d3": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
