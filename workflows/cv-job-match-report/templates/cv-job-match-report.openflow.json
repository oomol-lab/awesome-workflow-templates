    "modules": {
      "n_43dd371ad3ed7b06": {
        "name": "Validate resume and role input",
        "imports": [],
        "source": "export default function prepareCvInput({pdfUrl,jobDescription}) {\n  if(typeof pdfUrl!=='string'||!/^https?:\\/\\/[^/?#\\s@]+(?:[/?#]|$)/i.test(pdfUrl.trim())||/\\s/.test(pdfUrl.trim()))throw new Error('Provide a public HTTP or HTTPS PDF URL without embedded credentials.');\n  if(typeof jobDescription!=='string'||!jobDescription.trim())throw new Error('Provide the complete job description.');\n  return {pdfUrl:pdfUrl.trim(),jobDescription};\n}\n"
      },
      "n_585d9b67492bd96a": {
        "name": "Prepare full resume and role",
        "imports": [],
        "source": "export default function prepareCvText({pdfUrl,jobDescription,body}) {\n  if(typeof body!=='string'||!body.trim())throw new Error('The PDF extractor did not return inline resume text. No assessment was generated.');\n  return {reportInput:JSON.stringify({job_description:jobDescription,resume_text:body}),pdfUrl};\n}\n"
      },
      "n_a0b8cfdff5ec078b": {
        "name": "Validate the assessment report",
        "imports": [],
        "source": "export default function validateCvReport({result,pdfUrl}) {\n  const required=['percentage','summary','reasons-suit','reasons-notsuit'];\n  if(!result||typeof result!=='object'||Array.isArray(result)||Object.keys(result).some(k=>!required.includes(k)))throw new Error('The assessment must match the candidate evaluation structure.');\n  if(!Number.isInteger(result.percentage)||result.percentage<0||result.percentage>100||result.percentage%10!==0)throw new Error('The matching percentage must be0–100 in10-point steps.');\n  if(typeof result.summary!=='string'||!result.summary.trim())throw new Error('The assessment summary is empty.');\n  for(const key of ['reasons-suit','reasons-notsuit']){\n    if(!Array.isArray(result[key]))throw new Error('Assessment reasons must be arrays.');\n    for(const reason of result[key])if(!reason||typeof reason!=='object'||Array.isArray(reason)||Object.keys(reason).some(k=>!['name','text'].includes(k))||typeof reason.name!=='string'||!reason.name.trim()||typeof reason.text!=='string'||!reason.text.trim())throw new Error('Each assessment reason needs a name and text.');\n  }\n  return {evaluation:result,sourceUrl:pdfUrl};\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
