    {
      "name": "Prepare product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json.current;\nif (\"YOUR_COMPANY_ID\".includes(\"YOUR_\")) throw Error(\"Configure company ID\");\nif (!p || !Number.isSafeInteger(p.id) || !p.name || !Array.isArray(p.prices) || !p.prices.length)\n  throw Error(\"Missing product or prices\");\nfor (const x of p.prices)\n  if (\n    !/^[A-Za-z]{3}$/.test(x.currency) ||\n    typeof x.price !== \"number\" ||\n    Math.abs(x.price * 100 - Math.round(x.price * 100)) > 1e-6\n  )\n    throw Error(\"Invalid price\");\nreturn { json: { ...p, stripeId: \"pipedrive_YOUR_COMPANY_ID_\" + p.id } };\n"
      },
      "id": "create-stripe-products-from-pipedrive-1",
      "position": [
        220,
        0
      ]
    },
