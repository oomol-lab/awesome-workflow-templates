      "n_9695b5784c7a1a3a": {
        "name": "Authenticate product event",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default function event({ headers, body, expectedAuthorization, companyId }) {\n  const h = Object.entries(headers || {}).filter(([k]) => k.toLowerCase() === \"authorization\");\n  const secret = String(expectedAuthorization || \"\");\n  if (\n    !/^Basic [A-Za-z0-9+/]+={0,2}$/.test(secret) ||\n    Buffer.from(secret.slice(6), \"base64\").toString().indexOf(\":\") < 1\n  )\n    throw Error(\"Configure Basic authorization\");\n  let a = h.length === 1 ? String(h[0][1]) : \"\",\n    diff = a.length ^ secret.length;\n  for (let i = 0; i < Math.max(a.length, secret.length); i++)\n    diff |= (a.charCodeAt(i) || 0) ^ (secret.charCodeAt(i) || 0);\n  if (diff) throw Error(\"Unauthorized\");\n  if (\n    !/^\\d+$/.test(companyId) ||\n    String(body?.meta?.company_id) !== companyId ||\n    body?.meta?.entity !== \"product\" ||\n    body?.meta?.action !== \"create\" ||\n    body?.meta?.version !== \"2.0\"\n  )\n    throw Error(\"Unexpected Pipedrive event\");\n  const d = body.data;\n  if (\n    !d ||\n    !Number.isSafeInteger(d.id) ||\n    d.id < 1 ||\n    typeof d.name !== \"string\" ||\n    !d.name.trim() ||\n    !Array.isArray(d.prices) ||\n    !d.prices.length\n  )\n    throw Error(\"Product must include ID, name and prices\");\n  for (const p of d.prices) {\n    if (\n      !/^[A-Za-z]{3}$/.test(p.currency) ||\n      typeof p.price !== \"number\" ||\n      !Number.isSafeInteger(Math.round(p.price * 100)) ||\n      Math.abs(p.price * 100 - Math.round(p.price * 100)) > 1e-6\n    )\n      throw Error(\"Invalid price\");\n  }\n  return { product: { ...d, stripeId: \"pipedrive_\" + companyId + \"_\" + d.id } };\n}\n"
      },
      "n_75cad559e33ecffe": {
        "name": "Reserve Stripe product",
        "imports": [],
        "source": "export default async function plan({ product, acknowledge, resolution, confirmedId }, ctx) {\n  const key = \"pipedrive-product:\" + product.id,\n    old = await ctx.state.get(key);\n  let stripeId = old?.stripeId || \"\";\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(resolution))\n      throw Error(\"Inspect Stripe product; pending \" + key);\n    if (resolution === \"confirmed\") {\n      if (confirmedId !== product.stripeId) throw Error(\"Provide confirmed Stripe product ID\");\n      stripeId = confirmedId;\n      await ctx.state.set(key, { status: \"done\", stripeId });\n    }\n  }\n  if (stripeId)\n    return {\n      key,\n      create: false,\n      name: product.name,\n      description: product.description || \" \",\n      stripeId,\n    };\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    create: true,\n    name: product.name,\n    description: product.description || \" \",\n    stripeId: product.stripeId,\n  };\n}\n"
      },
      "n_58f759330abb3b61": {
        "name": "Confirm product",
        "imports": [],
        "source": "export default async function f({ key, product, expected }, ctx) {\n  if (!product?.id || product.id !== expected) throw Error(\"Unknown product result\");\n  await ctx.state.set(key, { status: \"done\", stripeId: product.id });\n  return { stripeId: product.id };\n}\n"
      },
      "n_1ef9132c9f067fe9": {
        "name": "Select and reserve a price",
        "imports": [],
        "source": "export default async function next(\n  { product, stripeId, previous, confirmed, acknowledge, resolution },\n  ctx,\n) {\n  if (!stripeId) throw Error(\"Missing Stripe product\");\n  const i = previous ? previous.index + (confirmed ? 1 : 0) : 0,\n    state = { index: i };\n  if (i >= product.prices.length)\n    return { more: false, skip: false, state, currency: \"usd\", amount: 0, key: \"\", stripeId };\n  const p = product.prices[i],\n    key = \"pipedrive-price:\" + product.id + \":\" + p.currency.toLowerCase(),\n    old = await ctx.state.get(key);\n  let skip = old?.status === \"done\";\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"absent\", \"confirmed\"].includes(resolution))\n      throw Error(\"Inspect Stripe price; pending \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      skip = true;\n    }\n  }\n  if (!skip) await ctx.state.set(key, { status: \"pending\" });\n  return {\n    more: true,\n    skip,\n    state,\n    currency: p.currency.toLowerCase(),\n    amount: Math.round(p.price * 100),\n    key,\n    stripeId,\n  };\n}\n"
      },
      "n_96ab708144c2d7b9": {
        "name": "Confirm price",
        "imports": [],
        "source": "export default async function f({ key, price, stripeId }, ctx) {\n  if (!price?.id || price.product !== stripeId) throw Error(\"Unknown price result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { confirmed: true };\n}\n"
      },
      "n_e18e9fd4da660f34": {
        "name": "Continue after existing price",
        "imports": [],
        "source": "export default function f() {\n  return { confirmed: true };\n}\n"
      },
      "n_2d32dedd1616f42e": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
