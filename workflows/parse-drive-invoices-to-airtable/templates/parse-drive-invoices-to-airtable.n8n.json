        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "parse-drive-invoices-to-airtable-20",
      "position": [
        4400,
        0
      ]
    },
    {
      "name": "Stop uncertain write",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {},
      "id": "parse-drive-invoices-to-airtable-21",
      "position": [
        4620,
        0
      ]
    },
