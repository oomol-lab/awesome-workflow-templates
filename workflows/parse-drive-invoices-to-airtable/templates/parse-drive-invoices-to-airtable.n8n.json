    {
      "name": "Inspect invoice checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect LlamaCloud and Airtable before retry\");\nreturn { json: { done: $json.status === \"done\" } };\n"
      },
      "id": "parse-drive-invoices-to-airtable-6",
      "position": [
        1320,
        0
      ]
    },
