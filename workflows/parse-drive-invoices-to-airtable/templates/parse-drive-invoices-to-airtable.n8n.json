            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "parse-drive-invoices-to-airtable-7",
      "position": [
