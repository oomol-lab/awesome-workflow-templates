    {
      "name": "Create parse job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.cloud.llamaindex.ai/api/v2/parse",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {file_id:$json.id,tier:\"agentic\",version:\"latest\"} }}",
        "options": {}
      },
      "onError": "continueErrorOutput",
      "id": "parse-drive-invoices-to-airtable-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Read parse result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ \"https://api.cloud.llamaindex.ai/api/v2/parse/\" + $(\"Create parse job\").item.json.id + \"?expand=markdown\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "parse-drive-invoices-to-airtable-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Check parse status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let s = $json.job?.status;\nif ([\"PENDING\", \"RUNNING\"].includes(s)) return { json: { ready: false } };\nif (\n  s !== \"COMPLETED\" ||\n  !Array.isArray($json.markdown?.pages) ||\n  !$json.markdown.pages.length ||\n  $json.markdown.pages.some((p) => p.success !== true)\n)\n  throw Error(\"Parse failed\");\nreturn {\n  json: { ready: true, markdown: $json.markdown.pages.map((p) => p.markdown).join(\"\\n\\n\") },\n};\n"
      },
      "id": "parse-drive-invoices-to-airtable-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Parse complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "parse-drive-invoices-to-airtable-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Wait for parsing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
