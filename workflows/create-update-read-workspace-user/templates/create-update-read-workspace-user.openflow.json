    "modules": {
      "n_1adfa6d075c80bd0": {
        "name": "Read created user ID",
        "imports": [],
        "source": "export default function userIdentity({ body }) {\n  if (!body || typeof body !== \"object\" || typeof body.id !== \"string\" || !body.id.trim())\n    throw Error(\"Directory API did not return a user ID\");\n  return {\n    id: body.id,\n    url: \"https://admin.googleapis.com/admin/directory/v1/users/\" + encodeURIComponent(body.id),\n  };\n}\n"
      },
      "n_c6371e50d99d7f97": {
        "name": "Confirm user identity",
        "imports": [],
        "source": "export default function confirm({ body, id }) {\n  if (!body || typeof body !== \"object\" || body.id !== id)\n    throw Error(\"Directory response did not refer to the created user\");\n  return { user: body };\n}\n"
      }
    }
