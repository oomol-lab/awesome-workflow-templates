    "modules": {
      "n_756172197fcc82cc": {
        "name": "Map customer fields",
        "imports": [],
        "source": "export default function prepare({ customers }) {\n  const now = new Date().toISOString(),\n    rows = customers.map((x) => [String(x.id), x.name, x.email, now]);\n  return {\n    has: rows.length > 0,\n    headers: [\"ID\", \"Full name\", \"Email\", \"Created time\"],\n    rows: rows.length ? rows : [[\"\", \"\", \"\", \"\"]],\n  };\n}\n"
      }
