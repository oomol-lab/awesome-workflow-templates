        1620,
        480
      ],
      "parameters": {
        "values": {
          "number": [],
          "string": [
            {
              "name": "ID",
              "value": "={{ String($json.id) }}"
            },
            {
              "name": "Full name",
              "value": "={{$json[\"name\"]}}"
            },
            {
              "name": "Email",
              "value": "={{$json[\"email\"]}}"
            },
            {
              "name": "Created time",
              "value": "={{$now}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "notesInFlow": false,
      "typeVersion": 1,
      "id": "map-customers-to-google-sheet-4"
