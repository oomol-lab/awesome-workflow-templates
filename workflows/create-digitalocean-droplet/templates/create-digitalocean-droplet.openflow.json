    "modules": {
      "n_4866378fabdc110e": {
        "name": "Validate Droplet parameters",
        "imports": [],
        "source": "function dropletRequest(config) {\n  const required = (key) => {\n    const value = config[key];\n    if (typeof value !== \"string\" || !value.trim())\n      throw new Error(\"Supply a nonempty \" + key + \".\");\n    return value.trim();\n  };\n  const { image } = config;\n  if (!(typeof image === \"string\" && image.trim()) && !(Number.isSafeInteger(image) && image > 0)) {\n    throw new Error(\"Supply an image slug or positive integer image ID.\");\n  }\n  const imageValue = typeof image === \"string\" ? image.trim() : image;\n  const normalized =\n    typeof imageValue === \"string\" && /^\\d+$/.test(imageValue) ? Number(imageValue) : imageValue;\n  if (typeof normalized === \"number\" && !(Number.isSafeInteger(normalized) && normalized > 0)) {\n    throw new Error(\"Supply a positive integer image ID.\");\n  }\n  return {\n    name: required(\"name\"),\n    region: required(\"region\"),\n    size: required(\"size\"),\n    image: normalized,\n  };\n}\nexport default (config) => ({ body: dropletRequest(config) });\n"
      },
      "n_bd86137794ac4bb9": {
        "name": "Confirm the acceptance receipt",
        "imports": [],
        "source": "function acceptedDroplet(status, body, expectedName) {\n  if (\n    status !== 202 ||\n    !Number.isSafeInteger(body?.droplet?.id) ||\n    body.droplet.id <= 0 ||\n    body.droplet.name !== expectedName\n  ) {\n    throw new Error(\n      \"DigitalOcean did not return a matching acceptance receipt. Check the account before running again.\",\n    );\n  }\n  return {\n    statusCode: status,\n    accepted: true,\n    dropletId: body.droplet.id,\n    droplet: body.droplet,\n    ...(body.links ? { links: body.links } : {}),\n  };\n}\nexport default ({ status, body, request }) => ({\n  receipt: acceptedDroplet(status, body, request.name),\n});\n"
      }
