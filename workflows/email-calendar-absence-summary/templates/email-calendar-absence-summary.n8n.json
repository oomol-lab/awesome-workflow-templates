            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize absences": {
      "main": [
        [
          {
            "node": "Send email to payroll",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Email Calendar Absence Summary",
  "active": false,
