    "modules": {
      "n_ce6e18725d8e1c86": {
        "name": "Summarize calendar absences",
        "imports": [],
        "source": "export default async function collect({ calendarId }, context) {\n  const now = new Date();\n  const previous = new Date(now);\n  previous.setUTCMonth(previous.getUTCMonth() - 1);\n  const groups = { Holiday: new Map(), Illness: new Map() };\n  let pageToken,\n    count = 0;\n  const seen = new Set();\n  do {\n    const page = await context.actions.call(\"googlecalendar.list_events\", {\n      calendarId,\n      timeMin: previous.toISOString(),\n      timeMax: now.toISOString(),\n      singleEvents: true,\n      maxResults: 2500,\n      ...(pageToken ? { pageToken } : {}),\n    });\n    for (const event of page.items || []) {\n      const type = event.summary?.includes(\"Holiday\")\n        ? \"Holiday\"\n        : event.summary?.includes(\"Illness\")\n          ? \"Illness\"\n          : null;\n      if (!type) continue;\n      if (!event.start?.date || !event.end?.date || typeof event.description !== \"string\")\n        throw Error(\"Matching events require all-day dates and a description\");\n      const days = (Date.parse(event.end.date) - Date.parse(event.start.date)) / 86400000;\n      if (!Number.isFinite(days)) throw Error(\"Invalid event dates\");\n      const name = event.description.split(\",\")[0];\n      groups[type].set(name, (groups[type].get(name) || 0) + parseInt(days));\n      count++;\n    }\n    pageToken = page.nextPageToken;\n    if (pageToken && seen.has(pageToken)) throw Error(\"Repeated page token\");\n    if (pageToken) seen.add(pageToken);\n  } while (pageToken);\n  let message = \"Here is a breakdown of absences for the last month.\\n\\n\";\n  for (const type of [\"Holiday\", \"Illness\"]) {\n    const rows = [...groups[type]].map(([name, days]) => `${name} had ${days} days\\n`).join(\"\");\n    message += rows\n      ? `${type} Events\\n${rows}${type === \"Holiday\" ? \"\\n\" : \"\"}`\n      : `No ${type} Events\\n`;\n  }\n  return { message, found: count > 0 };\n}\n"
      }
    }
  },
