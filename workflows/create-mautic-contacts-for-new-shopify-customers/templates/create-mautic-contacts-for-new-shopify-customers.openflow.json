        "imports": [],
        "source": "export default function prepare({ body, baseUrl }) {\n  return {\n    url: `${baseUrl.replace(/\\/$/, \"\")}/api/contacts/new`,\n    contact: { email: body.email, firstname: body.first_name, lastname: body.last_name },\n  };\n}\n"
