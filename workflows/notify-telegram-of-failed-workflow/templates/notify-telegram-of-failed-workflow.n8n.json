{
  "nodes": [
    {
      "id": "notify-telegram-of-failed-workflow-0",
      "name": "On Error",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [
        880,
        900
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "notify-telegram-of-failed-workflow-1",
      "name": "Set message",
      "type": "n8n-nodes-base.set",
      "position": [
        1140,
        900
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "={{ `⚠️ Workflow ${$json.workflow.name} failed to run!\\nExecution: ${$json.execution?.url || \"not available\"}` }}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1
    },
    {
      "id": "notify-telegram-of-failed-workflow-2",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1360,
        900
      ],
      "parameters": {
        "text": "={{ $json.message }}",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "typeVersion": 1.1
    }
  ],
  "pinData": {},
  "connections": {
    "On Error": {
      "main": [
        [
          {
            "node": "Set message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set message": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Notify Telegram of a Failed Workflow",
  "active": false
}
