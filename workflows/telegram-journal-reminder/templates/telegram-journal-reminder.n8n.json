{
  "name": "Telegram Journal Reminder",
  "nodes": [
    {
      "name": "Morning reminder",
      "type": "n8n-nodes-base.cron",
      "notes": "Trigger very morning",
      "position": [
        220,
        60
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 6,
              "minute": 0
            }
          ]
        }
      },
      "notesInFlow": true,
      "typeVersion": 1,
      "alwaysOutputData": true,
      "id": "telegram-journal-reminder-0"
    },
    {
      "name": "format reminder",
      "type": "n8n-nodes-base.code",
      "position": [
        460,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const format = function journalReminder() {\n  const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);\n  return { text: \"What did you do: \" + yesterday };\n};\n\nreturn { json: format() };\n"
      },
      "typeVersion": 2,
      "id": "telegram-journal-reminder-1"
    },
    {
      "name": "Send journal reminder",
      "type": "n8n-nodes-base.telegram",
      "position": [
        700,
        60
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "@YOUR_TELEGRAM_CHANNEL",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "typeVersion": 1,
      "id": "telegram-journal-reminder-2"
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "connections": {
    "format reminder": {
      "main": [
        [
          {
            "node": "Send journal reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Morning reminder": {
      "main": [
        [
          {
            "node": "format reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
