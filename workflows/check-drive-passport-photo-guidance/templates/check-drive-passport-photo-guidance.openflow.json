    "modules": {
      "n_ec4b138b70d34533": {
        "name": "Choose photo",
        "imports": [],
        "source": "export default function next({ photos, previous, result }) {\n  const list = Array.isArray(photos) ? photos : [];\n  const index = previous?.index ?? 0;\n  const results = previous?.results ?? [];\n  if (index > 0) {\n    if (!result || result.fileId !== list[index - 1].fileId)\n      throw Error(\"Photo result does not match input\");\n    results.push(result);\n  }\n  const photo = list[index];\n  if (!photo) return { more: false, state: { index, results }, body: {} };\n  if (!photo.fileId || !photo.name) throw Error(\"Each photo needs a name and Drive file ID\");\n  return { more: true, state: { index: index + 1, results }, body: photo };\n}\n"
      }
    }
