    },
    {
      "name": "Measure original bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bytes = await helpers.getBinaryDataBuffer($itemIndex, \"data\");\nreturn { json: { byteLength: bytes.length }, binary: $binary };\n"
      },
      "id": "check-drive-passport-photo-guidance-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Restore original photo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: { dimensions: $json, byteLength: $(\"Measure original bytes\").item.json.byteLength },\n  binary: $(\"Measure original bytes\").item.binary,\n};\n"
      },
      "id": "check-drive-passport-photo-guidance-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Combine photo checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $(\"Restore original photo\").item.json;\nconst p = $(\"Photos To List\").item.json;\nconst s = m.dimensions.size;\nconst width = Number(s?.width),\n  height = Number(s?.height),\n  bytes = m.byteLength;\nif (!width || !height || !bytes) throw Error(\"Missing original image metadata\");\nreturn {\n  json: {\n    name: p.name,\n    fileId: p.fileId,\n    relay: p.relay,\n    width,\n    height,\n    bytes,\n    digitalSizeValid: width >= 600 && height >= 750 && bytes >= 50000 && bytes <= 10000000,\n    visual: $json.output ?? $json,\n  },\n};\n"
      },
      "id": "check-drive-passport-photo-guidance-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Photo relay",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "check-drive-passport-photo-guidance-photo",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "check-drive-passport-photo-guidance-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Relay photo input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { name, fileId } = $json.body;\nif (!name || !fileId) throw Error(\"Missing photo name or file ID\");\nreturn { json: { data: [{ name, fileId, relay: true }] } };\n"
      },
      "id": "check-drive-passport-photo-guidance-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Return photo checks",
