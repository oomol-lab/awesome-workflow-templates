    "modules": {
      "n_4d9b708a5ca25555": {
        "name": "Check temperature",
        "imports": [],
        "source": "export default function temperature({ body }) {\n  const t = body?.event?.temp;\n  if (typeof t !== \"number\" || !Number.isFinite(t))\n    throw Error(\"RabbitMQ JSON message must contain numeric temp\");\n  return { alert: t > 50, text: `Alert!\\nThe value of temp is ${t}.` };\n}\n"
      }
