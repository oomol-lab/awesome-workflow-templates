{
  "name": "RabbitMQ Temperature Alert by Vonage SMS",
  "nodes": [
    {
      "name": "RabbitMQ",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "position": [
        520,
        220
      ],
      "parameters": {
        "queue": "YOUR_QUEUE",
        "options": {
          "onlyContent": true,
          "jsonParseBody": true
        }
      },
      "typeVersion": 1,
      "id": "rabbitmq-temperature-alert-vonage-sms-0"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        720,
        220
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$node[\"RabbitMQ\"].json[\"temp\"]}}",
              "value2": 50,
              "operation": "larger"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "rabbitmq-temperature-alert-vonage-sms-1"
    },
    {
      "name": "Vonage",
      "type": "n8n-nodes-base.vonage",
      "position": [
        930,
        120
      ],
      "parameters": {
        "message": "=Alert!\nThe value of temp is {{$node[\"RabbitMQ\"].json[\"temp\"]}}.",
        "additionalFields": {},
        "to": "15555550123",
        "from": "YOUR_SMS_SENDER"
      },
      "typeVersion": 1,
      "id": "rabbitmq-temperature-alert-vonage-sms-2"
    },
    {
      "name": "NoOp",
      "type": "n8n-nodes-base.noOp",
      "position": [
        920,
        370
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "rabbitmq-temperature-alert-vonage-sms-3"
    },
    {
      "id": "rabbitmq-temperature-alert-vonage-sms-choose",
      "name": "Choose delivery mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ...$input.first().json, deliveryMode: \"direct\" } }];\n"
      }
    },
    {
      "id": "rabbitmq-temperature-alert-vonage-sms-gate",
      "name": "Relay selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "mode",
              "leftValue": "={{ $json.deliveryMode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "rabbitmq-temperature-alert-vonage-sms-relay",
      "name": "Forward RabbitMQ message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        -100
      ],
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://YOUR_OPEN_FLOW_HOST/v1/webhooks/YOUR_ENDPOINT",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: $(\"RabbitMQ\").first().json} }}",
        "options": {}
      }
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "IF": {
      "main": [
        [
          {
            "node": "Vonage",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NoOp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RabbitMQ": {
      "main": [
        [
          {
            "node": "Choose delivery mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Choose delivery mode": {
      "main": [
        [
          {
            "node": "Relay selected?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Relay selected?": {
      "main": [
        [
          {
            "node": "Forward RabbitMQ message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
