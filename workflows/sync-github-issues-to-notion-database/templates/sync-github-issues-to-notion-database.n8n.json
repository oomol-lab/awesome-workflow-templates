{
  "nodes": [
    {
      "id": "sync-github-issues-to-notion-database-0",
      "name": "Trigger on issues",
      "type": "n8n-nodes-base.githubTrigger",
      "position": [
        860,
        500
      ],
      "parameters": {
        "authentication": "accessToken",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "your-github-owner"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "your-github-repo"
        },
        "events": [
          "issues"
        ],
        "options": {
          "insecureSSL": false
        }
      },
      "typeVersion": 1
    },
    {
      "id": "sync-github-issues-to-notion-database-1",
      "name": "Prepare issue change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function issueNotionPrepare({ body, dataSourceId }) {\n  const actions = [\"opened\", \"edited\", \"deleted\", \"closed\", \"reopened\"];\n  const action = body?.action;\n  if (!actions.includes(action))\n    return {\n      supported: false,\n      opened: false,\n      action: \"ignored\",\n      dataSourceId: \"\",\n      filter: {},\n      parent: {},\n      properties: {},\n      trash: false,\n    };\n  const issue = body.issue;\n  if (\n    !issue ||\n    !Number.isSafeInteger(issue.id) ||\n    issue.id <= 0 ||\n    typeof issue.title !== \"string\" ||\n    !issue.title.trim() ||\n    issue.title.length > 2000 ||\n    typeof issue.html_url !== \"string\" ||\n    !/^https:\\/\\/github\\.com\\//.test(issue.html_url)\n  )\n    throw Error(\"Invalid issue payload\");\n  if (\n    typeof dataSourceId !== \"string\" ||\n    !dataSourceId.trim() ||\n    dataSourceId === \"YOUR_NOTION_DATA_SOURCE_ID\"\n  )\n    throw Error(\"Configure Notion data source ID\");\n  const properties =\n    action === \"opened\"\n      ? {\n          Issue: { title: [{ text: { content: issue.title } }] },\n          \"Issue ID\": { number: issue.id },\n          Link: { url: issue.html_url },\n          Closed: { checkbox: false },\n        }\n      : action === \"edited\"\n        ? { Issue: { title: [{ text: { content: issue.title } }] } }\n        : action === \"closed\"\n          ? { Closed: { checkbox: true } }\n          : action === \"reopened\"\n            ? { Closed: { checkbox: false } }\n            : {};\n  return {\n    supported: true,\n    opened: action === \"opened\",\n    action,\n    dataSourceId,\n    filter: { property: \"Issue ID\", number: { equals: issue.id } },\n    parent: { data_source_id: dataSourceId },\n    properties,\n    trash: action === \"deleted\",\n  };\n}\n\nconst body = $input.first().json;\nconst result = issueNotionPrepare({\n  body: body.body ?? body,\n  dataSourceId: \"configured-n8n-database\",\n});\nreturn result.supported ? [{ json: result }] : [];\n"
      }
    },
    {
      "id": "sync-github-issues-to-notion-database-2",
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        1040,
        500
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $(\"Prepare issue change\").first().json.action }}",
              "value2": "opened"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "sync-github-issues-to-notion-database-3",
      "name": "Create database page",
      "type": "n8n-nodes-base.notion",
      "position": [
        1220,
        400
      ],
      "parameters": {
        "title": "={{ ($(\"Trigger on issues\").first().json.body ?? $(\"Trigger on issues\").first().json).issue.title }}",
        "resource": "databasePage",
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Issue ID|number",
              "numberValue": "={{ ($(\"Trigger on issues\").first().json.body ?? $(\"Trigger on issues\").first().json).issue.id }}"
            },
            {
              "key": "Link|url",
              "urlValue": "={{ ($(\"Trigger on issues\").first().json.body ?? $(\"Trigger on issues\").first().json).issue.html_url }}"
            },
            {
              "key": "Closed|checkbox",
              "checkboxValue": false
            }
          ]
        },
        "simple": false
      },
      "typeVersion": 2
    },
    {
      "id": "sync-github-issues-to-notion-database-4",
      "name": "Find database page",
      "type": "n8n-nodes-base.notion",
      "position": [
        1400,
        600
      ],
      "parameters": {
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "returnAll": true,
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "filterJson": "={{ JSON.stringify($(\"Prepare issue change\").first().json.filter) }}",
        "filterType": "json",
        "simple": false
      },
      "typeVersion": 2
    },
    {
      "id": "sync-github-issues-to-notion-database-5",
      "name": "Check the matching page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all();\nif (rows.length > 1) throw new Error(\"More than one Notion page matches this issue\");\nreturn rows;\n"
      }
    },
    {
      "id": "sync-github-issues-to-notion-database-6",
      "name": "Switch",
      "type": "n8n-nodes-base.switch",
      "position": [
        1580,
        600
      ],
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "edited"
            },
            {
              "output": 1,
              "value2": "deleted"
            },
            {
              "output": 2,
              "value2": "closed"
            },
            {
              "output": 3,
              "value2": "reopened"
            }
          ]
        },
        "value1": "={{ $(\"Prepare issue change\").first().json.action }}",
        "dataType": "string"
      },
      "typeVersion": 1
    },
    {
      "id": "sync-github-issues-to-notion-database-7",
      "name": "Edit issue",
      "type": "n8n-nodes-base.notion",
      "position": [
        1760,
        360
      ],
      "parameters": {
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "resource": "databasePage",
        "operation": "update",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Issue|title",
              "title": "={{ ($(\"Trigger on issues\").first().json.body ?? $(\"Trigger on issues\").first().json).issue.title }}"
            }
          ]
        },
        "simple": false
      },
      "typeVersion": 2
    },
    {
      "id": "sync-github-issues-to-notion-database-8",
      "name": "Delete issue",
      "type": "n8n-nodes-base.notion",
      "position": [
        1760,
        520
      ],
      "parameters": {
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "operation": "archive",
        "simple": false
      },
      "typeVersion": 2
    },
    {
      "id": "sync-github-issues-to-notion-database-9",
      "name": "Close issue",
      "type": "n8n-nodes-base.notion",
      "position": [
        1760,
        680
      ],
      "parameters": {
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "resource": "databasePage",
        "operation": "update",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Closed|checkbox",
              "checkboxValue": true
            }
          ]
        },
        "simple": false
      },
      "typeVersion": 2
    },
    {
      "id": "sync-github-issues-to-notion-database-10",
      "name": "Reopen issue",
      "type": "n8n-nodes-base.notion",
      "position": [
        1760,
        840
      ],
      "parameters": {
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "resource": "databasePage",
        "operation": "update",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Closed|checkbox",
              "checkboxValue": false
            }
          ]
        },
        "simple": false
      },
      "typeVersion": 2
    }
  ],
