    "modules": {
      "n_2c72d9810c70265b": {
        "name": "Prepare SQL requests",
        "imports": [],
        "source": "export default function prepare({ baseUrl }) {\n  const root = baseUrl.replace(/\\/$/, \"\") + \"/api/v1/sql/execute?query=\";\n  return {\n    create: root + encodeURIComponent(\"CREATE TABLE test (id INT, name STRING);\"),\n    insert: root + encodeURIComponent(\"INSERT INTO test (id, name) VALUES (0, 'Alex');\"),\n    select: root + encodeURIComponent(\"SELECT * FROM test;\"),\n  };\n}\n"
      }
    }
