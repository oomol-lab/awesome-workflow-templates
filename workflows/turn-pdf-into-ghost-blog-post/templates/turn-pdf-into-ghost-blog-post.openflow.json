    "modules": {
      "n_84d2d491a1aa38e9": {
        "name": "Authenticate submission",
        "imports": [],
        "source": "export default function f({ body, headers, expected }) {\n  const h = Object.entries(headers).find(([k]) => k.toLowerCase() === \"authorization\")?.[1];\n  if (!expected || h !== expected) throw Error(\"Unauthorized\");\n  return { requestId: body.requestId, text: body.text };\n}\n"
      },
      "n_3f34cff18796970f": {
        "name": "Check submission and prepare prompt",
        "imports": [],
        "source": "export default async function f({ requestId, text, acknowledge, resolution }, ctx) {\n  if (!/^[A-Za-z0-9_-]{16,128}$/.test(requestId) || !text.trim())\n    throw Error(\"Invalid request or empty PDF text\");\n  const key = \"pdf-blog:\" + requestId,\n    old = await ctx.state.get(key);\n  if (old) {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect existing checkpoint \" + key);\n    if (resolution === \"confirmed\") return { key, skip: true, prompt: \"already completed\" };\n    await ctx.state.set(key, null);\n  }\n  return {\n    key,\n    skip: false,\n    prompt:\n      \"Write a complete, original blog article from the PDF text below. Return only JSON with title and content fields. The title is under ten words and has no colon. Content is HTML with an introduction of 150–200 words, 6–8 chapters of 300–400 words each with H2 headings, and a conclusion of 200–250 words. Use paragraphs and blockquotes for source quotations, clear transitions, and a consistent professional voice. Preserve the source facts and do not invent quotations.\\n\\n\" +\n      text,\n  };\n}\n"
      },
      "n_6128ce27587b27dc": {
        "name": "Validate article and reserve Ghost write",
        "imports": [],
        "source": "export default async function f({ key, requestId, text }, ctx) {\n  if (!text) throw Error(\"Empty model response\");\n  let data;\n  try {\n    data = JSON.parse(text.replace(/^```(?:json)?\\s*/i, \"\").replace(/\\s*```$/, \"\"));\n  } catch {\n    throw Error(\"Invalid blog JSON\");\n  }\n  const title = typeof data.title === \"string\" ? data.title.trim() : \"\",\n    content =\n      typeof data.content === \"string\"\n        ? data.content.replace(/<h1\\b[^>]*>[\\s\\S]*?<\\/h1>/i, \"\").trim()\n        : \"\";\n  if (!title || !content) throw Error(\"Missing blog title or content\");\n  if (await ctx.state.get(key)) throw Error(\"Inspect existing checkpoint \" + key);\n  await ctx.state.set(key, { phase: \"pending\" });\n  return { body: { requestId, title, content } };\n}\n"
      },
      "n_9152da2d4cb18569": {
        "name": "Confirm Ghost creation",
        "imports": [],
        "source": "export default async function f({ key, status, body }, ctx) {\n  if (status < 200 || status >= 300 || !body?.id)\n    throw Error(\"Inspect Ghost before retrying \" + key);\n  const state = await ctx.state.get(key);\n  if (state?.phase !== \"pending\") throw Error(\"Missing checkpoint\");\n  await ctx.state.set(key, { phase: \"done\", id: body.id });\n  return { ok: true };\n}\n"
      }
    }
  },
