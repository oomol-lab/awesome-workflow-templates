    "modules": {
      "n_b77e1939bbab2d5d": {
        "name": "Select the uploaded receipt",
        "imports": [],
        "source": "export default function receiptForm({ response }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers))\n    throw Error(\"Expected a complete Typeform response\");\n  const ids = fields.filter((f) => f?.title === \"Upload receipt\").map((f) => f.id);\n  if (ids.length !== 1) throw Error(\"Expected one Upload receipt question\");\n  const matches = answers.filter((a) => a?.field?.id === ids[0] && a?.type === \"file_url\");\n  if (\n    matches.length !== 1 ||\n    typeof matches[0].file_url !== \"string\" ||\n    !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(matches[0].file_url)\n  )\n    throw Error(\"Expected one HTTPS receipt file URL\");\n  return { url: matches[0].file_url };\n}\n"
      },
      "n_62a8fdbaf8f15af0": {
        "name": "Submit the receipt to Mindee",
        "imports": [],
        "source": "export default async function enqueueReceipt({ url, modelId, apiKey }, context) {\n  if (\n    !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(url) ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(modelId) ||\n    typeof apiKey !== \"string\" ||\n    !apiKey.trim()\n  )\n    throw Error(\"Configure receipt URL, Mindee model ID and API key\");\n  const boundary = \"openflow-mindee-form-7d1b8e6f\";\n  if (url.includes(boundary)) throw Error(\"Invalid URL\");\n  const body = `--${boundary}\\r\\nContent-Disposition: form-data; name=\"model_id\"\\r\\n\\r\\n${modelId}\\r\\n--${boundary}\\r\\nContent-Disposition: form-data; name=\"url\"\\r\\n\\r\\n${url}\\r\\n--${boundary}--\\r\\n`;\n  const r = await context.fetch(\"https://api-v2.mindee.net/v2/products/extraction/enqueue\", {\n    method: \"POST\",\n    headers: { Authorization: apiKey, \"Content-Type\": \"multipart/form-data; boundary=\" + boundary },\n    body,\n  });\n  if (r.status !== 202) throw Error(\"Mindee enqueue failed or outcome unknown\");\n  const data = await r.json();\n  if (!/^[0-9a-f-]{36}$/i.test(data?.job?.id ?? \"\") || data.job.model_id !== modelId)\n    throw Error(\"Mindee returned an invalid job\");\n  return { jobId: data.job.id };\n}\n"
      },
      "n_f7fb0fceace8f30f": {
        "name": "Check the receipt job",
        "imports": [],
        "source": "export default async function pollReceipt({ jobId, apiKey, previousState }, context) {\n  const attempt = (previousState?.attempt ?? 0) + 1;\n  if (attempt > 200) throw Error(\"Mindee did not finish within the polling window\");\n  if (!/^[0-9a-f-]{36}$/i.test(jobId) || typeof apiKey !== \"string\" || !apiKey.trim())\n    throw Error(\"Invalid Mindee job or key\");\n  const r = await context.fetch(`https://api-v2.mindee.net/v2/jobs/${jobId}?redirect=false`, {\n    headers: { Authorization: apiKey },\n  });\n  if (!r.ok) throw Error(\"Mindee job lookup failed\");\n  const data = await r.json(),\n    job = data?.job;\n  if (job?.id !== jobId) throw Error(\"Mindee job mismatch\");\n  if (job.status === \"Failed\") throw Error(\"Mindee receipt processing failed\");\n  if (job.status === \"Processing\")\n    return {\n      state: { attempt },\n      ready: false,\n      resultUrl: \"https://api-v2.mindee.net/v2/products/extraction/results/unused\",\n    };\n  if (\n    job.status !== \"Processed\" ||\n    !/^https:\\/\\/api-v2\\.mindee\\.net\\/v2\\/products\\/extraction\\/results\\/[0-9a-f-]{36}$/i.test(\n      job.result_url ?? \"\",\n    )\n  )\n    throw Error(\"Invalid Mindee result URL\");\n  return { state: { attempt }, ready: true, resultUrl: job.result_url };\n}\n"
      },
      "n_688e4e2b12edf77c": {
        "name": "Read the receipt result",
        "imports": [],
        "source": "export default async function readReceipt({ resultUrl, jobId, apiKey }, context) {\n  if (\n    !/^https:\\/\\/api-v2\\.mindee\\.net\\/v2\\/products\\/extraction\\/results\\/[0-9a-f-]{36}$/i.test(\n      resultUrl,\n    )\n  )\n    throw Error(\"Invalid Mindee result URL\");\n  const r = await context.fetch(resultUrl, { headers: { Authorization: apiKey } });\n  if (!r.ok) throw Error(\"Mindee result request failed\");\n  return { data: await r.json() };\n}\n"
      },
      "n_6593792b436ffc28": {
        "name": "Map the expense fields",
        "imports": [],
        "source": "export default function receiptFields({ data, jobId, url }) {\n  if (data?.inference?.job?.id !== jobId) throw Error(\"Mindee result job mismatch\");\n  const f = data?.inference?.result?.fields;\n  if (!f || typeof f !== \"object\") throw Error(\"Missing receipt fields\");\n  const mapping = {\n      Amount: \"total_amount\",\n      Merchant: \"supplier_name\",\n      Date: \"date\",\n      Time: \"time\",\n      Category: \"purchase_category\",\n    },\n    fields = { \"Receipt URL\": url };\n  for (const [target, key] of Object.entries(mapping)) {\n    if (!Object.hasOwn(f, key) || !Object.hasOwn(f[key] ?? {}, \"value\"))\n      throw Error(\"Receipt model is missing \" + key);\n    const val = f[key].value;\n    if (val !== null && typeof val !== (target === \"Amount\" ? \"number\" : \"string\"))\n      throw Error(\"Invalid \" + key);\n    fields[target] = val;\n  }\n  return { records: [{ fields }] };\n}\n"
      }
    }
  },
