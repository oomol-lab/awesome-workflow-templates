{
  "name": "Typeform Receipts to Airtable",
  "nodes": [
    {
      "name": "Get Receipt",
      "type": "n8n-nodes-base.typeformTrigger",
      "position": [
        450,
        300
      ],
      "parameters": {
        "formId": "YOUR_TYPEFORM_FORM_ID",
        "simplifyAnswers": false,
        "onlyAnswers": false
      },
      "typeVersion": 1,
      "id": "typeform-receipts-to-airtable-0"
    },
    {
      "name": "Select the uploaded receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function receiptForm({ response }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers))\n    throw Error(\"Expected a complete Typeform response\");\n  const ids = fields.filter((f) => f?.title === \"Upload receipt\").map((f) => f.id);\n  if (ids.length !== 1) throw Error(\"Expected one Upload receipt question\");\n  const matches = answers.filter((a) => a?.field?.id === ids[0] && a?.type === \"file_url\");\n  if (\n    matches.length !== 1 ||\n    typeof matches[0].file_url !== \"string\" ||\n    !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(matches[0].file_url)\n  )\n    throw Error(\"Expected one HTTPS receipt file URL\");\n  return { url: matches[0].file_url };\n}\n\nreturn { json: receiptForm({ response: $json.form_response }) };\n"
      },
      "id": "typeform-receipts-to-airtable-1"
    },
    {
      "name": "Submit the receipt to Mindee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api-v2.mindee.net/v2/products/extraction/enqueue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model_id",
              "value": "YOUR_MINDEE_MODEL_ID"
            },
            {
              "name": "url",
              "value": "={{ $json.url }}"
            }
          ]
        },
        "options": {}
      },
      "id": "typeform-receipts-to-airtable-2"
    },
    {
      "name": "Validate the receipt job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (\n  !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(\n    $json.job?.id || \"\",\n  )\n)\n  throw Error(\"Mindee returned an invalid job ID\");\nreturn { json: { jobId: $json.job.id } };\n"
      },
      "id": "typeform-receipts-to-airtable-3"
    },
    {
      "name": "Wait for receipt processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "typeform-receipts-to-airtable-4"
    },
    {
      "name": "Check the receipt job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api-v2.mindee.net/v2/jobs/\" + $(\"Validate the receipt job\").first().json.jobId + \"?redirect=false\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "typeform-receipts-to-airtable-5"
    },
    {
      "name": "Check the job status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json.job;\nconst expected = $(\"Validate the receipt job\").first().json.jobId;\nif (\n  !job ||\n  job.id !== expected ||\n  job.status === \"Failed\" ||\n  (job.status === \"Processing\" && $runIndex >= 199)\n)\n  throw Error(\"Mindee job failed or timed out\");\nif (job.status !== \"Processing\" && job.status !== \"Processed\") throw Error(\"Invalid Mindee status\");\nif (\n  job.status === \"Processed\" &&\n  !/^https:\\/\\/api-v2\\.mindee\\.net\\/v2\\/products\\/extraction\\/results\\/[0-9a-f-]{36}$/i.test(\n    job.result_url || \"\",\n  )\n)\n  throw Error(\"Invalid result URL\");\nreturn { json: { ready: job.status === \"Processed\", resultUrl: job.result_url } };\n"
      },
      "id": "typeform-receipts-to-airtable-6"
    },
    {
      "name": "Is the receipt ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ready",
              "leftValue": "={{ $json.ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "typeform-receipts-to-airtable-7"
    },
    {
      "name": "Read the receipt result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.resultUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "typeform-receipts-to-airtable-8"
    },
    {
      "name": "Map the expense fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function receiptFields({ data, jobId, url }) {\n  if (data?.inference?.job?.id !== jobId) throw Error(\"Mindee result job mismatch\");\n  const f = data?.inference?.result?.fields;\n  if (!f || typeof f !== \"object\") throw Error(\"Missing receipt fields\");\n  const mapping = {\n      Amount: \"total_amount\",\n      Merchant: \"supplier_name\",\n      Date: \"date\",\n      Time: \"time\",\n      Category: \"purchase_category\",\n    },\n    fields = { \"Receipt URL\": url };\n  for (const [target, key] of Object.entries(mapping)) {\n    if (!Object.hasOwn(f, key) || !Object.hasOwn(f[key] ?? {}, \"value\"))\n      throw Error(\"Receipt model is missing \" + key);\n    const val = f[key].value;\n    if (val !== null && typeof val !== (target === \"Amount\" ? \"number\" : \"string\"))\n      throw Error(\"Invalid \" + key);\n    fields[target] = val;\n  }\n  return { records: [{ fields }] };\n}\n\nreturn {\n  json: receiptFields({\n    data: $json,\n    jobId: $(\"Validate the receipt job\").first().json.jobId,\n    url: $(\"Select the uploaded receipt\").first().json.url,\n  }).records[0].fields,\n};\n"
      },
      "id": "typeform-receipts-to-airtable-9"
    },
    {
      "name": "Save the expense",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "parameters": {
        "authentication": "airtableTokenApi",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "table": "YOUR_AIRTABLE_TABLE_ID",
        "operation": "append",
        "addAllFields": true,
        "options": {
          "typecast": false
        }
      },
      "id": "typeform-receipts-to-airtable-10"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "Get Receipt": {
      "main": [
        [
          {
            "node": "Select the uploaded receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select the uploaded receipt": {
      "main": [
        [
          {
            "node": "Submit the receipt to Mindee",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit the receipt to Mindee": {
      "main": [
        [
          {
            "node": "Validate the receipt job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate the receipt job": {
      "main": [
        [
          {
