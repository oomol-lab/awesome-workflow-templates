    {
      "name": "Collect lead rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leads = $input.all().map((x) => x.json);\nif (\n  !leads.length ||\n  leads.some((r) => !r[\"First Name\"] || !r[\"Full Name\"] || !r.Email || !r.Company)\n)\n  throw Error(\"CSV requires First Name, Full Name, Email and Company\");\nreturn [{ json: { fileId: $(\"One file at a time\").item.json.id, leads } }];\n"
      },
      "id": "create-lead-presentations-from-csv-7",
      "position": [
        1540,
        0
      ]
    },
