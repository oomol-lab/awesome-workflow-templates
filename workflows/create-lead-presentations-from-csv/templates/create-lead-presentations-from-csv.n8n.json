    {
      "name": "Choose lead step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n    .all()\n    .map((x) => x.json)\n    .filter((x) => x.item_key),\n  input = $(\"Collect lead rows\").item.json;\nif (rows.length > 1) throw Error(\"Duplicate file state\");\nif (!rows.length) return [{ json: { step: \"new\", payload: { ...input, index: 0 } } }];\nconst row = rows[0],\n  s = JSON.parse(row.payload);\nif (JSON.stringify({ fileId: s.fileId, leads: s.leads }) !== JSON.stringify(input))\n  throw Error(\"CSV changed\");\nif (row.status.startsWith(\"pending-\")) throw Error(\"Inspect pending write \" + row.status);\nif (\n  ![\"ready-move\", \"ready-fill\", \"ready-copy\", \"ready-replace\", \"ready-update\", \"done\"].includes(\n    row.status,\n  )\n)\n  throw Error(\"Invalid state\");\nreturn [{ json: { step: row.status, payload: s } }];\n"
      },
      "id": "create-lead-presentations-from-csv-12",
      "position": [
        2640,
        0
      ]
