    {
      "name": "Restore source file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json.body || $json;\nif (!r.fileId) throw Error(\"Provide original CSV fileId\");\nreturn { json: { id: r.fileId, mimeType: \"text/csv\" } };\n"
