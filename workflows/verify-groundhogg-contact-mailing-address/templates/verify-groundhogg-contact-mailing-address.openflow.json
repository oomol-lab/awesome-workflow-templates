    "modules": {
      "n_5ffaa52dbb74ec77": {
        "name": "Prepare contact address",
        "imports": [],
        "source": "export default function address({ body }) {\n  const event = body.event;\n  if (\n    !event ||\n    typeof event !== \"object\" ||\n    event.id == null ||\n    typeof event.address !== \"string\" ||\n    !event.address\n  )\n    throw Error(\"Expected contact ID and address\");\n  const optional = (x) => (typeof x === \"string\" && x.trim() ? x : null);\n  return {\n    id: String(event.id),\n    primary: event.address,\n    secondary: optional(event.address2),\n    city: optional(event.city),\n    state: optional(event.state),\n    zip: optional(event.zip_code),\n  };\n}\n"
      },
      "n_bd42c531303c9467": {
        "name": "Prepare contact tag",
        "imports": [],
        "source": "export default function tag({ verification, id }) {\n  const s = verification?.deliverability;\n  if (typeof s !== \"string\" || !s) throw Error(\"Lob returned no deliverability\");\n  return {\n    deliverable: s === \"deliverable\",\n    body: {\n      id,\n      tag: s === \"deliverable\" ? \"Mailing Address Deliverable\" : \"Mailing Address NOT Deliverable\",\n    },\n  };\n}\n"
      }
    }
