        "source": "export default function({range}){const values=range?.values;if(!Array.isArray(values))throw Error('Invalid sheet data');if(!values.length)return {rows:[]};const header=values[0],names=['Company Name','First Name','Last Name','Email'];if(!Array.isArray(header))throw Error('Invalid header');const cols=names.map(n=>{const i=header.indexOf(n);if(i<0||header.lastIndexOf(n)!==i)throw Error('Expected unique '+n+' header');return i});const rows=values.slice(1).filter(r=>Array.isArray(r)&&r.some(x=>x!==''&&x!=null)).map(r=>{const [company,first,last,email]=cols.map(i=>r[i]);if(![company,first,last,email].every(x=>typeof x==='string'&&x.trim())||/[\\r\\n\\x00]/.test(company)||!/^\\S+@\\S+\\.\\S+$/.test(email))throw Error('Every row needs company, first name, last name and email');return {company,first,last,email}});return{rows}}\n"
      },
      "n_c2e0e61cb8f48ae1": {
        "name": "Prepare next contact",
        "imports": [],
        "source": "export default function({rows,previousState}){const state=previousState??{index:0,accounts:{}};if(!Array.isArray(rows)||!Number.isInteger(state.index)||state.index<0||state.index>rows.length||!state.accounts||typeof state.accounts!=='object')throw Error('Invalid import state');if(state.index===rows.length)return {state,row:{},more:false,known:false,accountId:'',soql:'SELECT Id FROM Account LIMIT 1',company:'',count:state.index};const row=rows[state.index],id=Object.hasOwn(state.accounts,row.company)?state.accounts[row.company]:'',escaped=row.company.replace(/\\\\/g,'\\\\\\\\').replace(/'/g,\"\\\\'\");return {state,row,more:true,known:!!id,accountId:id,company:row.company,soql:\"SELECT Id, Name FROM Account WHERE Name = '\"+escaped+\"' LIMIT 2\",count:state.index}}\n"
      },
      "n_7f6e4282819ea10d": {
        "name": "Find account",
        "imports": [],
        "source": "export default async function({soql,knownId,company},ctx){const r=await ctx.actions.call('salesforce.query',{soql});if(!r||!Array.isArray(r.records)||r.done!==true||r.records.length>1)throw Error('Account name is ambiguous or query incomplete');if(!r.records.length)return {found:!!knownId,id:knownId};if(typeof r.records[0]?.Name!=='string')throw Error('Invalid account name');if(r.records[0].Name!==company)return {found:!!knownId,id:knownId};const id=r.records[0]?.Id;if(typeof id!=='string'||!/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(id))throw Error('Invalid account ID');if(knownId&&knownId!==id)throw Error('Account changed during import');return {found:true,id}}\n"
      },
      "n_accd00bf5c65ec60": {
        "name": "Create account",
        "imports": [],
        "source": "export default async function({row},ctx){const r=await ctx.actions.call('salesforce.create_record',{objectName:'Account',fields:{Name:row.company}});if(r?.success!==true||typeof r.id!=='string'||!/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(r.id))throw Error('Account creation was not confirmed');return{id:r.id}}\n"
      },
      "n_ca43a82142af1736": {
        "name": "Use found account",
        "imports": [],
        "source": "export default function({id}){return {id}}"
      },
      "n_1328d4c442324f18": {
        "name": "Upsert contact",
        "imports": [],
        "source": "export default async function({row,id},ctx){if(typeof id!=='string'||!/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(id))throw Error('Invalid account ID');const r=await ctx.actions.call('salesforce.upsert_record',{objectName:'Contact',externalIdField:'Email',externalId:row.email,fields:{FirstName:row.first,LastName:row.last,AccountId:id}});if(r?.success!==true)throw Error('Contact upsert was not confirmed');return{ok:true}}\n"
      },
      "n_f280702c17406fe9": {
        "name": "Remember account",
        "imports": [],
        "source": "export default function({state,row,id}){return {state:{index:state.index+1,accounts:{...state.accounts,[row.company]:id}}}}\n"
      }
    }
  },
