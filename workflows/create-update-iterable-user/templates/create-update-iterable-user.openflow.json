    "modules": {
      "n_37cc00c22e0c518f": {
        "name": "Prepare user requests",
        "imports": [],
        "source": "export default function setup({ region, email, name }) {\n  if (![\"us\", \"eu\"].includes(region)) throw Error(\"Choose us or eu\");\n  if (typeof email !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()))\n    throw Error(\"Enter a valid email\");\n  if (typeof name !== \"string\" || !name.trim()) throw Error(\"Enter a name\");\n  email = email.trim();\n  name = name.trim();\n  const base = region === \"us\" ? \"https://api.iterable.com\" : \"https://api.eu.iterable.com\";\n  return {\n    email,\n    name,\n    updateUrl: base + \"/api/users/update\",\n    getUrl: base + \"/api/users/getByEmail?\" + new URLSearchParams({ email }),\n    first: { email },\n    second: { email, dataFields: { Name: name } },\n  };\n}\n"
      },
      "n_395b7165732ae1f5": {
        "name": "Confirm user write",
        "imports": [],
        "source": "export default function check({ body }) {\n  if (!body || body.code !== \"Success\") throw Error(\"Iterable did not confirm the user update\");\n  return { ok: true };\n}\n"
      },
      "n_0d9bbb41b223b9e4": {
        "name": "Confirm name write",
        "imports": [],
        "source": "export default function check({ body }) {\n  if (!body || body.code !== \"Success\") throw Error(\"Iterable did not confirm the user update\");\n  return { ok: true };\n}\n"
      },
      "n_5ba616abc58daa0b": {
        "name": "Verify user",
        "imports": [],
        "source": "export default function verify({ body, email, name }) {\n  const user = body?.user;\n  if (!user || typeof user !== \"object\" || user.email !== email || user.dataFields?.Name !== name)\n    throw Error(\"Iterable did not return the expected user and Name\");\n  return { user };\n}\n"
      }
    }
