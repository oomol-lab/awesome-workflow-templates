{
  "name": "Create and Update an Iterable User",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        310,
        340
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-iterable-user-0"
    },
    {
      "name": "Set user details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const email = \"\",\n  name = \"\";\nif (!/^\\S+@\\S+\\.\\S+$/.test(email.trim()) || !name.trim()) throw Error(\"Enter email and name\");\nreturn [{ json: { email: email.trim(), name: name.trim() } }];\n"
      },
      "id": "create-update-iterable-user-1"
    },
    {
      "name": "Iterable",
      "type": "n8n-nodes-base.iterable",
      "position": [
        510,
        340
      ],
      "parameters": {
        "value": "={{ $(\"Set user details\").first().json.email }}",
        "identifier": "email",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "create-update-iterable-user-2"
    },
    {
      "name": "Iterable1",
      "type": "n8n-nodes-base.iterable",
      "position": [
        710,
        340
      ],
      "parameters": {
        "value": "={{ $(\"Set user details\").first().json.email }}",
        "identifier": "email",
        "additionalFields": {
          "dataFieldsUi": {
            "dataFieldValues": [
              {
                "key": "Name",
                "value": "={{ $(\"Set user details\").first().json.name }}"
              }
            ]
          }
        }
      },
      "typeVersion": 1,
      "id": "create-update-iterable-user-3"
    },
    {
      "name": "Iterable2",
      "type": "n8n-nodes-base.iterable",
      "position": [
        910,
        340
      ],
      "parameters": {
        "email": "={{ $(\"Set user details\").first().json.email }}",
        "operation": "get"
      },
      "typeVersion": 1,
      "id": "create-update-iterable-user-4"
    },
    {
      "name": "Verify user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $(\"Set user details\").first().json,\n  user = $input.first().json;\nif (!user || user.email !== input.email || user.dataFields?.Name !== input.name)\n  throw Error(\"Iterable did not return the expected user and Name\");\nreturn [{ json: user }];\n"
      },
      "id": "create-update-iterable-user-5"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set user details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set user details": {
      "main": [
        [
          {
            "node": "Iterable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterable": {
      "main": [
        [
          {
            "node": "Iterable1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterable1": {
      "main": [
        [
          {
            "node": "Iterable2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterable2": {
      "main": [
        [
          {
            "node": "Verify user",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
