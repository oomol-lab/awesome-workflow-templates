    "modules": {
      "n_db70dc0ec50f2b28": {
        "name": "Prepare certificate batch",
        "imports": [],
        "source": "export default function ({ issuer, course, recipients, requestId }) {\n  if (\n    !issuer.trim() ||\n    !course.trim() ||\n    !requestId.trim() ||\n    !Array.isArray(recipients) ||\n    !recipients.length ||\n    recipients.some((x) => typeof x.name !== \"string\" || !x.name.trim())\n  )\n    throw Error(\"Enter issuer, course, request ID and recipient names\");\n  return { key: \"attestify:\" + requestId, body: { issuer, course, recipients } };\n}\n"
      },
      "n_24bbad3da6ba04e5": {
        "name": "Reserve certificate issuance",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  if (await ctx.state.get(key))\n    throw Error(\"Issuance is pending or complete; inspect Attestify before retrying: \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ok: true };\n}\n"
      },
      "n_9751ec70274ef645": {
        "name": "Confirm issuance response",
        "imports": [],
        "source": "export default async function ({ key, body }, ctx) {\n  if (!body || typeof body !== \"object\" || Object.keys(body).length === 0)\n    throw Error(\"Unknown issuance result; inspect Attestify before retrying\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { response: body };\n}\n"
      }
    }
