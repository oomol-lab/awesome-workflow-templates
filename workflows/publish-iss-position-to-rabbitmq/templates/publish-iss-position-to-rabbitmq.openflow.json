    "modules": {
      "n_91cfb06d37047d26": {
        "name": "Prepare queue message",
        "imports": [],
        "source": "export default function prepare({ body, baseUrl, vhost, queue }) {\n  if (\n    typeof body?.name !== \"string\" ||\n    typeof body?.latitude !== \"number\" ||\n    typeof body?.longitude !== \"number\" ||\n    typeof body?.timestamp !== \"number\"\n  )\n    throw Error(\"Incomplete ISS position\");\n  if (!baseUrl || baseUrl.includes(\"YOUR_\") || !vhost || !queue)\n    throw Error(\"Configure RabbitMQ management URL, vhost and queue\");\n  const u = new URL(baseUrl);\n  if (u.protocol !== \"https:\") throw Error(\"Configure an HTTPS management URL\");\n  u.pathname =\n    u.pathname.replace(/\\/$/, \"\") +\n    \"/api/exchanges/\" +\n    encodeURIComponent(vhost) +\n    \"/amq.default/publish\";\n  u.search = \"\";\n  u.hash = \"\";\n  return {\n    url: u.href,\n    body: {\n      properties: {},\n      routing_key: queue,\n      payload: JSON.stringify({\n        Latitude: body.latitude,\n        Longitude: body.longitude,\n        Timestamp: body.timestamp,\n        Name: body.name,\n      }),\n      payload_encoding: \"string\",\n    },\n  };\n}\n"
      },
      "n_19902cc6dc3c8885": {
        "name": "Check routing result",
        "imports": [],
        "source": "export default function confirm({ body }) {\n  if (body?.routed !== true) throw Error(\"RabbitMQ did not route the message to a queue\");\n  return { routed: true };\n}\n"
      }
    }
