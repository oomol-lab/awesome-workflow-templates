    "modules": {
      "n_a841c3364c5c2e4d": {
        "name": "Prepare mailbox query",
        "imports": [],
        "source": "export default function request({ phase, session, mailboxes }) {\n  const account = session?.primaryAccounts?.[\"urn:ietf:params:jmap:mail\"];\n  if (!account) throw Error(\"JMAP session missing primary mail account\");\n  const using = [\"urn:ietf:params:jmap:core\", \"urn:ietf:params:jmap:mail\"];\n  if (phase === \"mailboxes\")\n    return {\n      body: {\n        using,\n        methodCalls: [[\"Mailbox/get\", { accountId: account, ids: null }, \"mailboxes\"]],\n      },\n    };\n  const m = mailboxes?.methodResponses?.find((x) => x[2] === \"mailboxes\");\n  const inbox = m?.[1]?.list?.find((x) => x.role === \"inbox\")?.id;\n  if (!inbox) throw Error(\"JMAP inbox missing\");\n  return {\n    body: {\n      using,\n      methodCalls: [\n        [\n          \"Email/query\",\n          {\n            accountId: account,\n            filter: { inMailbox: inbox, notKeyword: \"$seen\" },\n            sort: [{ property: \"receivedAt\", isAscending: false }],\n            limit: 3,\n            calculateTotal: true,\n          },\n          \"messages\",\n        ],\n        [\n          \"Email/get\",\n          {\n            accountId: account,\n            \"#ids\": { name: \"Email/query\", path: \"/ids\", resultOf: \"messages\" },\n            properties: [\"id\", \"receivedAt\", \"from\", \"subject\", \"keywords\"],\n          },\n          \"emails\",\n        ],\n      ],\n    },\n  };\n}\n"
      },
      "n_1efb17aa0a5d1cd9": {
        "name": "Prepare unread message query",
        "imports": [],
        "source": "export default function request({ phase, session, mailboxes }) {\n  const account = session?.primaryAccounts?.[\"urn:ietf:params:jmap:mail\"];\n  if (!account) throw Error(\"JMAP session missing primary mail account\");\n  const using = [\"urn:ietf:params:jmap:core\", \"urn:ietf:params:jmap:mail\"];\n  if (phase === \"mailboxes\")\n    return {\n      body: {\n        using,\n        methodCalls: [[\"Mailbox/get\", { accountId: account, ids: null }, \"mailboxes\"]],\n      },\n    };\n  const m = mailboxes?.methodResponses?.find((x) => x[2] === \"mailboxes\");\n  const inbox = m?.[1]?.list?.find((x) => x.role === \"inbox\")?.id;\n  if (!inbox) throw Error(\"JMAP inbox missing\");\n  return {\n    body: {\n      using,\n      methodCalls: [\n        [\n          \"Email/query\",\n          {\n            accountId: account,\n            filter: { inMailbox: inbox, notKeyword: \"$seen\" },\n            sort: [{ property: \"receivedAt\", isAscending: false }],\n            limit: 3,\n            calculateTotal: true,\n          },\n          \"messages\",\n        ],\n        [\n          \"Email/get\",\n          {\n            accountId: account,\n            \"#ids\": { name: \"Email/query\", path: \"/ids\", resultOf: \"messages\" },\n            properties: [\"id\", \"receivedAt\", \"from\", \"subject\", \"keywords\"],\n          },\n          \"emails\",\n        ],\n      ],\n    },\n  };\n}\n"
      }
