    "modules": {
      "n_68a519e1c3cf2b21": {
        "name": "Validate video request",
        "imports": [],
        "source": "export default function prepareVancineRequest({ model, prompt, size }) {\n  for (const [name, value] of Object.entries({ model, prompt, size })) {\n    if (typeof value !== 'string' || value.trim() === '' || /^YOUR_/i.test(value)) throw new Error('Configure a nonempty Vancine ' + name + '.');\n  }\n  return { body: { model, prompt, size } };\n}\n"
      },
      "n_d0c6ed7af4b499d6": {
        "name": "Check task status and poll limit",
        "imports": [],
        "source": "export default function collectVancineStatus({ submission, previousState, response, maxPolls }) {\n  if (!Number.isSafeInteger(maxPolls) || maxPolls < 1) throw new Error('maxPolls must be a positive integer.');\n  let state, status = 'queued', result_url = '', pending = true;\n  if (previousState === null) {\n    if (response !== null) throw new Error('Unexpected poll response before initialization.');\n    const taskId = submission?.task_id || submission?.id || submission?.data?.task_id || submission?.data?.id;\n    if (typeof taskId !== 'string' || taskId.trim() === '') throw new Error('Vancine submission returned no task ID; inspect the service before submitting again.');\n    state = { taskId, polls: 0 };\n  } else {\n    if (typeof previousState.taskId !== 'string' || previousState.taskId.trim() === '' || !Number.isSafeInteger(previousState.polls) || previousState.polls < 0 || previousState.polls >= maxPolls) throw new Error('Invalid Vancine polling state.');\n    state = { taskId: previousState.taskId, polls: previousState.polls + 1 };\n    if (!response || typeof response !== 'object' || Array.isArray(response)) throw new Error('Vancine returned no task status object.');\n    const data = response.data && typeof response.data === 'object' && !Array.isArray(response.data) ? response.data : {};\n    const reportedId = data.task_id || response.task_id || response.id || data.id;\n    if (reportedId !== undefined && reportedId !== state.taskId) throw new Error('The Vancine poll response belongs to another task.');\n    status = data.status || response.status;\n    if (typeof status !== 'string' || status.trim() === '') throw new Error('Vancine returned no task status.');\n    if (status === 'SUCCESS' || status === 'completed') {\n      result_url = data.result_url || response.metadata?.url || data.data?.content?.video_url || '';\n      if (typeof result_url !== 'string' || !/^https?:\\/\\/[^\\s<>]+$/i.test(result_url)) throw new Error('Completed Vancine task has no HTTP(S) result URL.');\n      pending = false;\n    } else if (status === 'FAILURE' || status === 'failed') {\n      const reason = data.fail_reason || data.error?.message || response.error?.message || 'unknown';\n      throw new Error('Seedance task ' + state.taskId + ' failed: ' + String(reason));\n    } else if (state.polls >= maxPolls) {\n      throw new Error('Polling exceeded ' + maxPolls + ' attempts for task ' + state.taskId + '; the remote task may still be running.');\n    }\n  }\n  return { state, task_id: state.taskId, pollUrl: 'https://vancine.com/v1/video/generations/' + encodeURIComponent(state.taskId), polls: state.polls, pending, status, result_url };\n}\n"
      }
    }
