    "modules": {
      "n_9834c2f2fed3b4fb": {
        "name": "Generate llms.txt",
        "imports": [],
        "source": "export default function generate({ body }) {\n  const { name, description, rows } = body;\n  if (\n    typeof name !== \"string\" ||\n    !name.trim() ||\n    typeof description !== \"string\" ||\n    !Array.isArray(rows)\n  )\n    throw Error(\"Expected site name, description and CSV rows\");\n  const pick = (r, keys) =>\n    keys.map((k) => r[k]).find((x) => x !== undefined && x !== null && String(x).trim() !== \"\") ??\n    \"\";\n  const lines = [];\n  for (const r of rows) {\n    const url = String(pick(r, [\"Address\", \"Adresse\", \"Dirección\", \"Indirizzo\"])),\n      title = String(pick(r, [\"Title 1\", \"Titre 1\", \"Titolo 1\", \"Título 1\", \"Titel 1\"])),\n      desc = String(pick(r, [\"Meta Description 1\", \"Meta description 1\"])),\n      status = Number(\n        pick(r, [\n          \"Status Code\",\n          \"Code HTTP\",\n          \"Status-Code\",\n          \"Código de respuesta\",\n          \"Codice di stato\",\n        ]),\n      ),\n      index = String(\n        pick(r, [\n          \"Indexability\",\n          \"Indexabilité\",\n          \"Indicizzabilità\",\n          \"Indexabilidad\",\n          \"Indexierbarkeit\",\n        ]),\n      ),\n      type = String(\n        pick(r, [\n          \"Content Type\",\n          \"Type de contenu\",\n          \"Tipo di contenuto\",\n          \"Tipo de contenido\",\n          \"Inhaltstyp\",\n        ]),\n      );\n    if (\n      status !== 200 ||\n      ![\"Indexable\", \"Indicizzabile\", \"Indexierbar\"].includes(index) ||\n      !type.includes(\"text/html\") ||\n      !url\n    )\n      continue;\n    const clean = (x) => x.replace(/[\\r\\n]+/g, \" \").trim();\n    lines.push(\"- [\" + clean(title) + \"](\" + clean(url) + \")\" + (desc ? \": \" + clean(desc) : \"\"));\n  }\n  return {\n    content: \"# \" + name.trim() + \"\\n> \" + description.trim() + \"\\n\\n\" + lines.join(\"\\n\"),\n    count: lines.length,\n  };\n}\n"
      },
      "n_df695e677aa66dff": {
        "name": "Prepare file receipt",
        "imports": [],
        "source": "export default function f({ content, count }) {\n  return { body: JSON.stringify({ content, count }) };\n}\n"
      }
