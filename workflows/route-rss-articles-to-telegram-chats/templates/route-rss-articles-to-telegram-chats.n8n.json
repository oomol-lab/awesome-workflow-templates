        "additionalFields": {
          "appendAttribution": false
        }
      },
      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-2"
    },
    {
      "name": "Telegram_Security",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1220,
        220
      ],
      "parameters": {
        "text": "={{ $('Prepare article').item.json.text }}",
        "chatId": "YOUR_SECURITY_CHAT_ID",
        "additionalFields": {
          "appendAttribution": false
        }
