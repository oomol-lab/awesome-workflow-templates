      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-3"
    },
    {
      "name": "RSS Source",
      "type": "n8n-nodes-base.function",
      "position": [
        -20,
        -20
      ],
      "parameters": {
        "functionCode": "return [\n  {\n    json: {\n      url: \"https://feeds.feedburner.com/UnikosHardware\",\n    },\n  },\n  {\n    json: {\n      url: \"http://www.ithome.com.tw/rss.php\",\n    },\n  },\n  {\n    json: {\n      url: \"http://feeds.feedburner.com/playpc\",\n    },\n  },\n  {\n    json: {\n      url: \"https://lab.ocf.tw/feed/\",\n    },\n  },\n  {\n    json: {\n      url: \"https://techcommunity.microsoft.com/plugins/custom/microsoft/o365/custom-blog-rss?tid=3754543230341459569&board=microsoft_365blog\",\n    },\n  },\n];\n"
      },
      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-4"
    },
    {
      "name": "Telegram_M365",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1220,
        -40
      ],
      "parameters": {
        "text": "={{ $('Prepare article').item.json.text }}",
        "chatId": "YOUR_M365_CHAT_ID",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-5"
    },
    {
      "name": "IF-2",
      "type": "n8n-nodes-base.if",
      "position": [
        880,
        240
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Prepare article').item.json.title }}",
              "value2": "資安|資訊安全|安全|外洩|監控|威脅|漏洞|封鎖|修補|攻擊|入侵|個資|隱私|私密|騙|社交工程|釣魚|駭|Security|security|Secure|secure",
              "operation": "regex"
            }
          ]
        },
        "combineOperation": "any"
      },
      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-6"
    },
    {
      "name": "IF-1",
      "type": "n8n-nodes-base.if",
      "position": [
        880,
        -20
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Prepare article').item.json.link }}",
              "value2": "techcommunity.microsoft.com",
              "operation": "contains"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "route-rss-articles-to-telegram-chats-7"
    },
    {
      "id": "route-rss-articles-to-telegram-chats-feeds",
      "name": "Loop feeds",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-items",
      "name": "Loop articles",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {
          "reset": "={{ $json.reset }}"
        }
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-wrap",
      "name": "Prepare feed items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => ({\n  json: { article: item.json, reset: true },\n  pairedItem: { item: index },\n}));\n"
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-again",
      "name": "Continue articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { reset: false } };\n"
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-nonempty",
      "name": "Feed has articles?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "nonempty",
              "leftValue": "={{ Object.keys($json).length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-prep",
      "name": "Prepare article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const feed = $(\"Loop feeds\").item.json.url,\n  e = $json.article;\nif (typeof e.title !== \"string\" || typeof e.link !== \"string\")\n  throw Error(\"Missing article title or link\");\nreturn { json: { ...e, key: feed + \"\\n\" + e.link, text: e.title + \"\\n\" + e.link } };\n"
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-exists",
      "name": "Existing article",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ $json.key }}"
            }
          ]
        },
        "operation": "rowExists"
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-missing",
      "name": "New article",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ $json.key }}"
            }
          ]
        },
        "operation": "rowNotExists"
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-pending",
      "name": "Mark article pending",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ $('Prepare article').item.json.key }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "route-rss-articles-to-telegram-chats-done",
      "name": "Mark article sent",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Mark article pending').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "sent"
          },
          "schema": []
        },
        "options": {}
      }
    }
