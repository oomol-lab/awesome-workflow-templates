    "modules": {
      "n_1d02e96c959b0fc0": {
        "name": "Prepare and sign SNS request",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nexport default function sign({\n  topicArn,\n  message,\n  subject,\n  accessKeyId,\n  secretAccessKey,\n  sessionToken,\n}) {\n  if (typeof topicArn !== \"string\") throw Error(\"Configure SNS topic ARN\");\n  const m =\n    /^arn:(aws|aws-us-gov|aws-cn):sns:([a-z0-9-]+):([0-9]{12}):([A-Za-z0-9_-]{1,256})$/.exec(\n      topicArn,\n    );\n  if (!m) throw Error(\"Configure a standard SNS topic ARN\");\n  if (\n    typeof message !== \"string\" ||\n    !message ||\n    typeof subject !== \"string\" ||\n    !subject ||\n    subject.length >= 100 ||\n    /[\\x00-\\x1f\\x7f]/.test(subject)\n  )\n    throw Error(\"Enter a message and a subject under 100 characters without line breaks\");\n  if (\n    typeof accessKeyId !== \"string\" ||\n    !accessKeyId.trim() ||\n    typeof secretAccessKey !== \"string\" ||\n    !secretAccessKey.trim()\n  )\n    throw Error(\"Configure AWS credentials\");\n  if (sessionToken != null && typeof sessionToken !== \"string\")\n    throw Error(\"Invalid session token\");\n  const region = m[2],\n    host = \"sns.\" + region + \".amazonaws.com\" + (m[1] === \"aws-cn\" ? \".cn\" : \"\"),\n    body =\n      \"Action=Publish&Version=2010-03-31&Message=\" +\n      encodeURIComponent(message) +\n      \"&TopicArn=\" +\n      encodeURIComponent(topicArn) +\n      \"&Subject=\" +\n      encodeURIComponent(subject),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8),\n    headers = {\n      \"content-type\": \"application/x-www-form-urlencoded\",\n      host,\n      \"x-amz-date\": timestamp,\n      ...(sessionToken ? { \"x-amz-security-token\": sessionToken } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signed = names.join(\";\"),\n    canonicalHeaders = names\n      .map((n) => n + \":\" + headers[n].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\"),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, x) => createHmac(\"sha256\", k).update(x).digest(),\n    scope = date + \"/\" + region + \"/sns/aws4_request\",\n    canonical = [\"POST\", \"/\", \"\", canonicalHeaders, signed, hash(body)].join(\"\\n\"),\n    tosign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    key = hmac(hmac(hmac(hmac(\"AWS4\" + secretAccessKey, date), region), \"sns\"), \"aws4_request\"),\n    signature = createHmac(\"sha256\", key).update(tosign).digest(\"hex\");\n  delete headers.host;\n  headers.authorization =\n    \"AWS4-HMAC-SHA256 Credential=\" +\n    accessKeyId +\n    \"/\" +\n    scope +\n    \", SignedHeaders=\" +\n    signed +\n    \", Signature=\" +\n    signature;\n  return {\n    url: \"https://\" + host + \"/\",\n    body,\n    authorization: headers.authorization,\n    amzDate: timestamp,\n  };\n}\n"
      },
      "n_c77f221ff7402325": {
        "name": "Read the message ID",
        "imports": [],
        "source": "export default function result({ body }) {\n  if (typeof body !== \"string\") throw Error(\"SNS did not return XML\");\n  const m =\n    /<(?:[A-Za-z_][\\w.-]*:)?MessageId>\\s*([A-Za-z0-9-]+)\\s*<\\/(?:[A-Za-z_][\\w.-]*:)?MessageId>/.exec(\n      body,\n    );\n  if (!m) throw Error(\"SNS did not confirm a message ID\");\n  return { messageId: m[1] };\n}\n"
      }
    }
