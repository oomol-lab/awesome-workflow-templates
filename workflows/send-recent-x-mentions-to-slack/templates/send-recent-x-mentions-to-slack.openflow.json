    "modules": {
      "n_3366187ddc00b9cc": {
        "name": "Set X query and Slack channel",
        "imports": [],
        "source": "function settings(query, channel, timestamp) {\n  const keyword = query.trim();\n  if (\n    !keyword ||\n    keyword === \"@YOUR_X_HANDLE\" ||\n    keyword.length > 512 ||\n    !/^[CG][A-Z0-9]{8,}$/.test(channel)\n  ) {\n    throw new Error(\"Set the X search query and a Slack channel ID\");\n  }\n  const time = typeof timestamp === \"string\" ? Date.parse(timestamp) : NaN;\n  if (!Number.isFinite(time)) throw new Error(\"The schedule did not provide a valid timestamp\");\n  const end = Math.floor(time / 600000) * 600000;\n  return { keyword, channel, start: end - 600000, end };\n}\n\nexport default ({ keyword, channel, scheduledAt }) => ({\n  config: settings(keyword, channel, scheduledAt),\n});\n"
      },
      "n_cc753c58d521e103": {
        "name": "Collect recent post IDs",
        "imports": [],
        "source": "function postRecord(id, date) {\n  const time = typeof date === \"string\" ? Date.parse(date) : NaN;\n  if (typeof id !== \"string\" || !/^[1-9]\\d{0,18}$/.test(id) || !Number.isFinite(time)) {\n    throw new Error(\"X returned a post without an exact string ID and creation time\");\n  }\n  return { id, time };\n}\n\nfunction timelinePage(envelope) {\n  const graph = envelope?.data?.data ?? envelope?.data;\n  const instructions = graph?.search_by_raw_query?.search_timeline?.timeline?.instructions;\n  if (\n    envelope?.code !== 200 ||\n    !Array.isArray(instructions) ||\n    envelope.errors?.length ||\n    envelope.data?.errors?.length ||\n    graph.errors?.length\n  ) {\n    throw new Error(\"TikHub did not return a complete X search timeline\");\n  }\n  const entries = instructions.flatMap(\n    (instruction) => instruction.entries ?? (instruction.entry ? [instruction.entry] : []),\n  );\n  const rows = [];\n  let cursor = null;\n  for (const entry of entries) {\n    const content = entry.content;\n    if (content?.cursorType === \"Bottom\") {\n      if (typeof content.value !== \"string\" || !content.value || content.value.length > 8192) {\n        throw new Error(\"TikHub returned an invalid X search cursor\");\n      }\n      cursor = content.value;\n    }\n    const items = content?.items?.map((item) => item.item?.itemContent) ?? [content?.itemContent];\n    for (const item of items) {\n      if (!item || item.promotedMetadata || entry.entryId?.startsWith(\"promoted-\")) continue;\n      const result = item.tweet_results?.result;\n      if (!result || [\"TweetTombstone\", \"TweetUnavailable\"].includes(result.__typename)) continue;\n      const tweet = result.tweet ?? result;\n      rows.push(postRecord(tweet.rest_id, tweet.legacy?.created_at));\n    }\n  }\n  return { rows, cursor };\n}\n\nfunction includeRecent(previous, rows, limits) {\n  const recent = new Map(previous.map((row) => [row.id, row]));\n  for (const row of rows) {\n    if (row.time <= limits.start || row.time > limits.end) continue;\n    const earlier = recent.get(row.id);\n    if (earlier && earlier.time !== row.time)\n      throw new Error(\"X returned inconsistent creation times for the same post\");\n    recent.set(row.id, row);\n  }\n  return [...recent.values()]\n    .sort((a, b) => b.time - a.time || b.id.length - a.id.length || b.id.localeCompare(a.id))\n    .slice(0, 50);\n}\n\nexport default ({ config, response, state }) => {\n  const page = state ? timelinePage(response) : { rows: [], cursor: null };\n  const posts = includeRecent(state?.posts ?? [], page.rows, config);\n  const cursors = state?.cursors ?? [];\n  const hasOlder = page.rows.length && page.rows.at(-1).time <= config.start;\n  const more = !state || (page.cursor !== null && posts.length < 50 && !hasOlder);\n  if (more && state && (cursors.includes(page.cursor) || cursors.length >= 7)) {\n    throw new Error(\"TikHub did not finish the recent search within eight pages\");\n  }\n  return {\n    state: { posts, cursors: page.cursor ? [...cursors, page.cursor] : cursors },\n    more,\n    request: {\n      query: {\n        keyword: config.keyword,\n        search_type: \"Latest\",\n        ...(page.cursor ? { cursor: page.cursor } : {}),\n      },\n    },\n  };\n};\n"
      },
      "n_ea5de388543b4c89": {
        "name": "Reserve the next unsent post",
        "imports": [],
        "source": "function slackText(id) {\n  return \"New mention on X\\nhttps://x.com/i/web/status/\" + id;\n}\n\nexport default async ({ collected, config, previous }, context) => {\n  if (previous === null) {\n    const cutoff = config.end - 7200000;\n    for (const key of await context.state.list()) {\n      const window = /^x-mention:(\\d+):/.exec(key);\n      if (window && Number(window[1]) < cutoff) await context.state.delete(key);\n    }\n  }\n  for (let index = (previous ?? -1) + 1; index < collected.posts.length; index++) {\n    const id = collected.posts[index].id;\n    const key = \"x-mention:\" + config.end + \":\" + config.channel + \":\" + id;\n    if (await context.state.insert(key, \"pending\"))\n      return { index, key, more: true, channel: config.channel, text: slackText(id) };\n  }\n  return { index: collected.posts.length, key: \"\", more: false, channel: config.channel, text: \"\" };\n};\n"
      },
      "n_d778cff0db44d345": {
        "name": "Confirm the Slack message",
        "imports": [],
        "source": "function checkSlack(receipt, channel) {\n  if (receipt.channel !== channel || !/^\\d+\\.\\d+$/.test(receipt.ts ?? \"\")) {\n    throw new Error(\"Slack did not confirm the message. Check the channel before replaying.\");\n  }\n}\n\nexport default async ({ expected, channel, ts, key }, context) => {\n  checkSlack({ channel, ts }, expected);\n  await context.state.set(key, \"confirmed\");\n  return {};\n};\n"
      }
    },
