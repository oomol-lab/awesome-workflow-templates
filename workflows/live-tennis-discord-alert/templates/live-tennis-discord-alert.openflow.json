      "n_a917022a1ac657d4": {
        "name": "Check and format matches",
        "imports": [],
        "source": "export default function prepareMatches({ body }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || !Array.isArray(body.data)) {\n    throw new Error('Live Tennis API must return an object with a data array.');\n  }\n  if (body.data.length > 50) throw new Error('The first match page exceeds the configured 50-item limit.');\n  const hasMore = body.meta?.has_more ?? null;\n  if (hasMore !== null && typeof hasMore !== 'boolean') throw new Error('Invalid match pagination metadata.');\n  const matches = [], ids = new Set();\n  for (const match of body.data) {\n    if (!match || typeof match !== 'object' || Array.isArray(match) || !Number.isSafeInteger(match.id) || match.id < 1) {\n      throw new Error('Every match must have a positive integer ID.');\n    }\n    const p1 = match.players?.p1?.name, p2 = match.players?.p2?.name, status = match.status;\n    if ([p1, p2, status].some(value => typeof value !== 'string' || !value.trim())) {\n      throw new Error('Every match must have both player names and a status.');\n    }\n    const text = `🎾 New live match: ${p1} vs ${p2} — ${status}`;\n    if (text.length > 2000) throw new Error('A match announcement exceeds Discord’s 2000-character limit.');\n    const id = String(match.id);\n    if (ids.has(id)) continue;\n    ids.add(id);\n    matches.push({ id, text });\n  }\n  return { matches, received: body.data.length, unique: matches.length, hasMore };\n}\n"
      },
      "n_e0138d5a53644ee4": {
        "name": "Announce new matches in Discord",
        "imports": [],
        "source": "export default async function announceMatches({ matches, channelId }, context) {\n  if (!Array.isArray(matches) || matches.length > 50 || matches.some(match => !match || typeof match.id !== 'string' || typeof match.text !== 'string' || !match.text || match.text.length > 2000)) {\n    throw new Error('Invalid deduplicated match announcements.');\n  }\n  let sent = 0;\n  for (const match of matches) {\n    if (context.signal.aborted) throw new Error('Match delivery was cancelled.');\n    await context.actions.call('discordbot.create_message', { channel_id: channelId, content: match.text });\n    sent++;\n  }\n  return { sent };\n}\n"
      }
