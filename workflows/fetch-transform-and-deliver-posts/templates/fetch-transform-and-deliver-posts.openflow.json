      "n_786db9dfd0576fc3": {
        "name": "Select next post",
        "imports": [],
        "source": "export default function next({ body, previous }) {\n  const posts = Array.isArray(body) ? body.slice(0, 10) : [];\n  const index = previous?.index ?? 0;\n  const post = posts[index];\n  return {\n    state: { index: index + 1 },\n    hasPost: Boolean(post),\n    post: post ? { id: post.id, title: post.title, userId: post.userId } : {},\n  };\n}\n"
      }
