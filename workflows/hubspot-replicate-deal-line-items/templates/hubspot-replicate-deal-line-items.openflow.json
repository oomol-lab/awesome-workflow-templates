    "modules": {
      "n_eb2455dcb9ecb90c": {
        "name": "Extract deal IDs",
        "imports": [],
        "source": "export default function parseIds({ query }) {\n  const won = String(query?.deal_id_won ?? \"\").trim();\n  const rawCreated = String(query?.deal_id_created ?? \"\").trim();\n  const match = rawCreated.match(/0-3-(\\d+)$/);\n  const created = match ? match[1] : rawCreated;\n  if (!won || !created) {\n    throw new Error(\"Missing required query parameters: deal_id_won and deal_id_created\");\n  }\n  return {\n    dealIdWon: won,\n    dealIdCreated: created,\n    assocBody: { inputs: [{ id: won }] },\n  };\n}\n"
      },
      "n_0745958ebe852342": {
        "name": "Prepare line item SKU request",
        "imports": [],
        "source": "export default function buildSkuRead({ response }) {\n  const results = Array.isArray(response?.results) ? response.results : [];\n  const ids = [];\n  const seen = new Set();\n  for (const row of results) {\n    const toList = Array.isArray(row?.to) ? row.to : [];\n    for (const rel of toList) {\n      const id = rel?.toObjectId != null ? String(rel.toObjectId).trim() : \"\";\n      if (id && !seen.has(id)) {\n        seen.add(id);\n        ids.push(id);\n      }\n    }\n  }\n  return {\n    hasLineItems: ids.length > 0,\n    body: {\n      idProperty: \"hs_object_id\",\n      inputs: ids.map((id) => ({ id })),\n      properties: [\"hs_object_id\", \"name\", \"hs_sku\"],\n    },\n  };\n}\n"
      },
      "n_dc620755bd56cdeb": {
        "name": "Prepare product lookup request",
        "imports": [],
        "source": "export default function buildProductRead({ response }) {\n  const results = Array.isArray(response?.results) ? response.results : [];\n  const skus = [];\n  const seen = new Set();\n  for (const row of results) {\n    const sku = row?.properties?.hs_sku != null ? String(row.properties.hs_sku).trim() : \"\";\n    if (sku && !seen.has(sku)) {\n      seen.add(sku);\n      skus.push(sku);\n    }\n  }\n  return {\n    hasSkus: skus.length > 0,\n    body: {\n      idProperty: \"hs_sku\",\n      inputs: skus.map((id) => ({ id })),\n      properties: [\n        \"idProperty\",\n        \"name\",\n        \"hs_object_id\",\n        \"recurringbillingfrequency\",\n        \"hs_price_eur\",\n      ],\n    },\n  };\n}\n"
      },
      "n_63d439ca8b88761e": {
        "name": "Prepare line item creation body",
        "imports": [],
        "source": "export default function buildCreateBody({ response, dealIdWon, dealIdCreated }) {\n  const results = Array.isArray(response?.results) ? response.results : [];\n  const productIds = [];\n  for (const row of results) {\n    const id = row?.id != null ? String(row.id).trim() : \"\";\n    if (id) productIds.push(id);\n  }\n  return {\n    hasProducts: productIds.length > 0,\n    body: {\n      inputs: productIds.map((id) => ({\n        associations: [\n          {\n            types: [\n              {\n                associationCategory: \"HUBSPOT_DEFINED\",\n                associationTypeId: 20,\n              },\n            ],\n            to: { id: dealIdCreated },\n          },\n        ],\n        properties: {\n          hs_product_id: id,\n          quantity: \"1\",\n        },\n      })),\n    },\n    slackText: `:white_check_mark: HubSpot deal line items replicated from deal ${dealIdWon} to deal ${dealIdCreated} (${productIds.length} item(s)).`,\n  };\n}\n"
      }
    }
  },
