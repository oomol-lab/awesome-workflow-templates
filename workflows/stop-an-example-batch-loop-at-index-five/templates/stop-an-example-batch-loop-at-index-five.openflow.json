      "n_d27887bc06f18619": {
        "name": "Process one example item",
        "imports": [],
        "source": "export default function step({state}) {\n  const visited=state ? [...state.visited] : [];\n  if (visited.length > 5) throw Error('Invalid batch state');\n  visited.push(visited.length);\n  return {state:{visited},more:visited.length<6,message:visited.length===6?'Loop Ended':''};\n}\n"
      }
