{
  "name": "Convert Potsdam Venue CSV to Excel",
  "tags": [],
  "nodes": [
    {
      "id": "convert-potsdam-venue-csv-to-excel-0",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        860,
        380
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "convert-potsdam-venue-csv-to-excel-1",
      "name": "Import CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "position": [
        1260,
        380
      ],
      "parameters": {
        "options": {
          "delimiter": ";",
          "headerRow": true
        },
        "fileFormat": "csv"
      },
      "typeVersion": 2
    },
    {
      "id": "convert-potsdam-venue-csv-to-excel-2",
      "name": "Download CSV",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1060,
        380
      ],
      "parameters": {
        "url": "https://opendata.potsdam.de/api/v2/catalog/datasets/veranstaltungsplaetze-potsdam/exports/csv",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "typeVersion": 4.1
    },
    {
      "id": "convert-potsdam-venue-csv-to-excel-3",
      "name": "Convert to Excel",
      "type": "n8n-nodes-base.spreadsheetFile",
      "position": [
        1460,
        380
      ],
      "parameters": {
        "options": {
          "fileName": "=converted_csv.{{ $parameter.fileFormat }}",
          "headerRow": true,
          "sheetName": "csv_page"
        },
        "operation": "toFile",
        "fileFormat": "xlsx"
      },
      "typeVersion": 2
    },
    {
      "id": "convert-potsdam-venue-csv-to-excel-4",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        820,
        177
      ],
      "parameters": {
        "width": 808,
        "height": 385,
        "content": "## Convert CSV to Excel (.xlsx)\n1. Click Execute Workflow to begin\n2. Download the data from the Web\n3. Import CSV binary data as a JSON\n4. Convert JSON to .xlsx file\n\nSource:\nhttps://data.europa.eu/data/datasets/veranstaltungsplaetze-potsdam-potsdam?locale=en"
      },
      "typeVersion": 1
    }
  ],
  "active": false,
