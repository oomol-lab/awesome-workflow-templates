      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function search({ query }) {\n  const first = query?.first_name,\n    last = query?.last_name;\n  if (typeof first !== \"string\" || typeof last !== \"string\" || !first || !last)\n    throw Error(\"Provide first_name and last_name\");\n  const url = `https://www.google.com/search?q=${encodeURIComponent(first)}+${encodeURIComponent(last)}`;\n  return {\n    response: `The URL of the Google search query for the term \"${first} ${last}\" is: ${url}`,\n  };\n}\n\nreturn { json: search({ query: $json.query }) };\n"
      }
    },
    {
