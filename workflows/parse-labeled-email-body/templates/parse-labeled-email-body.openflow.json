    "modules": {
      "n_3be66a1898296dfe": {
        "name": "Extract labeled values",
        "imports": [],
        "source": "export default function parse({body,labels}){const obj={},names=labels.split(',');names.forEach(function(label){const re=names.indexOf(label)===names.length-1?'\\\\b'+label+'\\\\b[: ]+([^$]+)':'\\\\b'+label+'\\\\b[: ]+([^\\\\n$]+)';const found=body.match(new RegExp(re,'i'));if(found&&found.length>1)obj[label]=found[1].trim()});return{fields:obj}}\n"
      }
    }
