    "modules": {
      "n_748c7df46a282b1c": {
        "name": "Validate affiliate details",
        "imports": [],
        "source": "export default function setup({firstname,lastname,email,programId,tag}){if([firstname,lastname,programId,tag].some(x=>typeof x!=='string'||!x.trim())||typeof email!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(email.trim())||! /^[A-Za-z0-9_-]+$/.test(programId))throw Error('Enter affiliate details, program ID and tag');return{firstname:firstname.trim(),lastname:lastname.trim(),email:email.trim(),programId,tag:tag.trim()};}\n"
      },
      "n_fec12ce00a34f5d8": {
        "name": "Create affiliate",
        "imports": [],
        "source": "export default async function create({firstname,lastname,email},context){const r=await context.actions.call('tapfiliate.create_affiliate',{firstname,lastname,email});const id=r?.affiliate?.id;if(typeof id!=='string'||! /^[A-Za-z0-9_-]+$/.test(id))throw Error('Tapfiliate did not return an affiliate ID');return{id};}\n"
      },
      "n_d9f6c742324f879f": {
        "name": "Prepare tag",
        "imports": [],
        "source": "export default function meta({id,tag}){return{endpoint:'/affiliates/'+encodeURIComponent(id)+'/meta-data/tag/',body:{value:tag}};}\n"
      },
      "n_4e5fc8affb20280b": {
        "name": "Prepare program enrollment",
        "imports": [],
        "source": "export default function enroll({body,statusCode,bodyEncoding,id,programId,tag}){if(statusCode!==200||bodyEncoding!=null||body?.value!==tag)throw Error('Tapfiliate did not confirm metadata');return{endpoint:'/programs/'+encodeURIComponent(programId)+'/affiliates/',body:{affiliate:{id}}};}\n"
      },
      "n_58b6f76b63cf1ba0": {
        "name": "Confirm enrollment",
        "imports": [],
        "source": "export default function result({body,statusCode,bodyEncoding,id}){if(![200,201].includes(statusCode)||bodyEncoding!=null||!body||body.id!==id)throw Error('Tapfiliate did not confirm the same affiliate');return{affiliate:{id:body.id,approved:body.approved??null,referralLink:body.referral_link?.link??null}};}\n"
      }
    }
  },
