    "modules": {
      "n_748c7df46a282b1c": {
        "name": "Validate affiliate details",
        "imports": [],
        "source": "export default function setup({ firstname, lastname, email, programId, tag }) {\n  if (\n    [firstname, lastname, programId, tag].some((x) => typeof x !== \"string\" || !x.trim()) ||\n    typeof email !== \"string\" ||\n    !/^\\S+@\\S+\\.\\S+$/.test(email.trim()) ||\n    !/^[A-Za-z0-9_-]+$/.test(programId)\n  )\n    throw Error(\"Enter affiliate details, program ID and tag\");\n  return {\n    firstname: firstname.trim(),\n    lastname: lastname.trim(),\n    email: email.trim(),\n    programId,\n    tag: tag.trim(),\n  };\n}\n"
      },
      "n_fec12ce00a34f5d8": {
        "name": "Create affiliate",
        "imports": [],
        "source": "export default async function create({ firstname, lastname, email }, context) {\n  const r = await context.actions.call(\"tapfiliate.create_affiliate\", {\n    firstname,\n    lastname,\n    email,\n  });\n  const id = r?.affiliate?.id;\n  if (typeof id !== \"string\" || !/^[A-Za-z0-9_-]+$/.test(id))\n    throw Error(\"Tapfiliate did not return an affiliate ID\");\n  return { id };\n}\n"
      },
      "n_d9f6c742324f879f": {
        "name": "Prepare tag",
        "imports": [],
        "source": "export default function meta({ id, tag }) {\n  return {\n    endpoint: \"/affiliates/\" + encodeURIComponent(id) + \"/meta-data/tag/\",\n    body: { value: tag },\n  };\n}\n"
      },
      "n_4e5fc8affb20280b": {
        "name": "Prepare program enrollment",
        "imports": [],
        "source": "export default function enroll({ body, statusCode, bodyEncoding, id, programId, tag }) {\n  if (statusCode !== 200 || bodyEncoding != null || body?.value !== tag)\n    throw Error(\"Tapfiliate did not confirm metadata\");\n  return {\n    endpoint: \"/programs/\" + encodeURIComponent(programId) + \"/affiliates/\",\n    body: { affiliate: { id } },\n  };\n}\n"
      },
      "n_58b6f76b63cf1ba0": {
        "name": "Confirm enrollment",
        "imports": [],
        "source": "export default function result({ body, statusCode, bodyEncoding, id }) {\n  if (![200, 201].includes(statusCode) || bodyEncoding != null || !body || body.id !== id)\n    throw Error(\"Tapfiliate did not confirm the same affiliate\");\n  return {\n    affiliate: {\n      id: body.id,\n      approved: body.approved ?? null,\n      referralLink: body.referral_link?.link ?? null,\n    },\n  };\n}\n"
      }
    }
  },
