{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        270,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-and-enroll-tapfiliate-affiliate-0"
    },
    {
      "name": "Set affiliate details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const firstname = \"\",\n  lastname = \"\",\n  email = \"\",\n  programId = \"\",\n  tag = \"\";\nif (\n  !firstname.trim() ||\n  !lastname.trim() ||\n  !/^\\S+@\\S+\\.\\S+$/.test(email.trim()) ||\n  !/^[A-Za-z0-9_-]+$/.test(programId) ||\n  !tag.trim()\n)\n  throw Error(\"Enter affiliate details, program ID and tag\");\nreturn [\n  {\n    json: {\n      firstname: firstname.trim(),\n      lastname: lastname.trim(),\n      email: email.trim(),\n      programId,\n      tag: tag.trim(),\n    },\n  },\n];\n"
      },
      "id": "create-and-enroll-tapfiliate-affiliate-1"
    },
    {
      "name": "Create affiliate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.tapfiliate.com/1.6/affiliates/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({firstname:$json.firstname,lastname:$json.lastname,email:$json.email}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-and-enroll-tapfiliate-affiliate-2"
    },
    {
      "name": "Prepare tag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $input.first().json.id,\n  s = $(\"Set affiliate details\").first().json;\nif (typeof id !== \"string\" || !/^[A-Za-z0-9_-]+$/.test(id)) throw Error(\"Missing affiliate ID\");\nreturn [\n  {\n    json: {\n      id,\n      tag: s.tag,\n      url:\n        \"https://api.tapfiliate.com/1.6/affiliates/\" + encodeURIComponent(id) + \"/meta-data/tag/\",\n    },\n  },\n];\n"
      },
      "id": "create-and-enroll-tapfiliate-affiliate-3"
    },
    {
      "name": "Set affiliate tag",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({value:$json.tag}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-and-enroll-tapfiliate-affiliate-4"
    },
    {
      "name": "Prepare enrollment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $(\"Set affiliate details\").first().json,\n  p = $(\"Prepare tag\").first().json;\nif ($input.first().json.value !== s.tag) throw Error(\"Tapfiliate did not confirm metadata\");\nreturn [\n  {\n    json: {\n      id: p.id,\n      url:\n        \"https://api.tapfiliate.com/1.6/programs/\" +\n        encodeURIComponent(s.programId) +\n        \"/affiliates/\",\n    },\n  },\n];\n"
      },
      "id": "create-and-enroll-tapfiliate-affiliate-5"
    },
    {
      "name": "Add to program",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({affiliate:{id:$json.id}}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-and-enroll-tapfiliate-affiliate-6"
    },
    {
      "name": "Confirm enrollment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input.first().json,\n  id = $(\"Prepare tag\").first().json.id;\nif (!a || a.id !== id) throw Error(\"Tapfiliate did not confirm the same affiliate\");\nreturn [\n  { json: { id: a.id, approved: a.approved ?? null, referralLink: a.referral_link?.link ?? null } },\n];\n"
      },
      "id": "create-and-enroll-tapfiliate-affiliate-7"
    }
  ],
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
