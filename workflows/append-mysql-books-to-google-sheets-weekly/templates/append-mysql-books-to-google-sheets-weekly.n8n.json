    },
    {
      "name": "Group MySQL rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { rows: $input.all().map((x) => x.json) } }];\n"
      },
