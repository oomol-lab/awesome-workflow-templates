      "name": "Restore MySQL rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $(\"Group MySQL rows\")\n  .first()\n  .json.rows.map((row) => ({ json: row, pairedItem: { item: 0 } }));\n"
