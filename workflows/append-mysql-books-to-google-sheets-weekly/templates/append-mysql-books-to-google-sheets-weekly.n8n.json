        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'books:' + $now.toFormat('yyyy-MM-dd') }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "append-mysql-books-to-google-sheets-weekly-4",
      "position": [
        880,
        0
      ]
    },
