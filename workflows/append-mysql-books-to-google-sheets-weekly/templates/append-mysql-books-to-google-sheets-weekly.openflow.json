        "source": "export default async function prepare(\n  { scheduledAt, body, headers, spreadsheetId, range, acknowledge, resolution },\n  ctx,\n) {\n  const d = new Date(scheduledAt);\n  if (!Number.isFinite(d.getTime()) || !spreadsheetId || spreadsheetId.includes(\"YOUR_\") || !range)\n    throw Error(\"Configure sheet and schedule\");\n  const rows = body?.rows;\n  if (!Array.isArray(rows)) throw Error(\"MySQL relay did not return rows\");\n  const head = headers?.[0];\n  if (!Array.isArray(head) || head.length === 0) throw Error(\"Sheet header row missing\");\n  const values = rows.map((r) => {\n      if (!r || typeof r !== \"object\" || Array.isArray(r)) throw Error(\"Invalid MySQL row\");\n      return head.map((k) => {\n        const name = String(k);\n        return r[name] === null || r[name] === undefined ? \"\" : String(r[name]);\n      });\n    }),\n    key = \"books:\" + d.toISOString().slice(0, 10);\n  let s = await ctx.state.get(key);\n  if (s?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending Sheets append \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, spreadsheetId, range, values, count: values.length, write: false };\n    }\n  }\n  if (!values.length || s?.status === \"done\")\n    return { key, spreadsheetId, range, values, count: values.length, write: false };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, spreadsheetId, range, values, count: values.length, write: true };\n}\n"
      },
      "n_dfb70b45ea6920c5": {
        "name": "Confirm rows appended",
        "imports": [],
        "source": "export default async function confirm({ key, count, updatedRows }, ctx) {\n  if (updatedRows !== count) throw Error(\"Sheets did not confirm all rows\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
