    "modules": {
      "n_16d6a3e97b69b690": {
        "name": "Select training file and model",
        "imports": [],
        "source": "export default function ({ fileId, model }) {\n  if (!fileId || !model) throw Error(\"Configure a Drive file ID and eligible base model\");\n  return { body: { fileId }, model };\n}\n"
      },
      "n_b15e4de8174dd3a5": {
        "name": "Prepare fine-tuning job",
        "imports": [],
        "source": "export default function ({ body, model }) {\n  if (!body || typeof body.id !== \"string\" || !body.id)\n    throw Error(\"Upload relay did not confirm a file ID\");\n  return { body: { training_file: body.id, model } };\n}\n"
      },
      "n_2e805e2088ea7092": {
        "name": "Read job ID",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (!body || typeof body.id !== \"string\" || !body.id)\n    throw Error(\"Fine-tuning job response has no ID\");\n  return { id: body.id };\n}\n"
      }
    }
