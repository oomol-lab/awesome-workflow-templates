      "n_a38382781e99690d": {
        "name": "Prepare the contact",
        "imports": [],
        "source": "export default function formTwoStores({ body }) {\n  const { name, city, email } = body;\n  if (![name, city, email].every((x) => typeof x === \"string\" && x.trim()))\n    throw Error(\"Name, city and email are required\");\n  const now = new Date().toISOString(),\n    date = now.slice(0, 10),\n    time = now.slice(11, 19),\n    fields = { Name: name, City: city, Email: email, Date: date, Time: time };\n  return {\n    records: [{ fields }],\n    values: [[name, city, email, date, time]],\n    email,\n    subject: \"Testing Text Message Delivery\",\n    subjectDated: \"Testing Text Message Delivery , ( \" + date + \" ) \",\n    message:\n      \"Dear \" +\n      name +\n      \" ..\\n\\nHey there! Just testing to see if this message goes through. Let me know if you receive it. \\n\\nThanks! \\nSupport Team\",\n  };\n}\n"
      }
    }
  },
