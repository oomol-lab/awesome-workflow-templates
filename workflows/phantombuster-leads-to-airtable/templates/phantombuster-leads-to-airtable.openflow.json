    "modules": {
      "n_10c67d560e1f3e12": {
        "name": "Set Phantom ID",
        "imports": [],
        "source": "export default function endpoint({agentId}){if(typeof agentId!=='string'||!agentId.trim())throw Error('Enter a Phantom ID');return {endpoint:'/agents/fetch-output?id='+encodeURIComponent(agentId.trim())};}\n"
      },
      "n_5a8a075e8fab861b": {
        "name": "Find the result container",
        "imports": [],
        "source": "export default function endpoint({body,statusCode,bodyEncoding}){if(statusCode<200||statusCode>=300||bodyEncoding)throw Error('Could not read Phantom output');const id=body?.containerId;if(typeof id!=='string'||!id.trim())throw Error('No container ID in Phantom output');return {endpoint:'/containers/fetch-result-object?id='+encodeURIComponent(id)};}\n"
      },
      "n_6f2fce2bda421841": {
        "name": "Prepare lead fields",
        "imports": [],
        "source": "export default function rows({body,statusCode,bodyEncoding}){if(statusCode<200||statusCode>=300||bodyEncoding)throw Error('Could not read container result');if(!body||!Object.hasOwn(body,'resultObject'))throw Error('Missing result object');if(body.resultObject===null)return {rows:[]};if(typeof body.resultObject!=='string')throw Error('Invalid result object');let parsed;try{parsed=JSON.parse(body.resultObject)}catch{throw Error('Invalid result JSON')};const items=Array.isArray(parsed)?parsed:[parsed];return {rows:items.map((x)=>{const name=x?.general?.fullName,email=x?.details?.mail,company=x?.jobs?.[0]?.companyName;if(typeof name!=='string'||!name.trim()||typeof email!=='string'||!email.trim()||typeof company!=='string'||!company.trim())throw Error('Each result needs general.fullName, details.mail and jobs[0].companyName');return {Name:name,Email:email,Company:company};})};}\n"
      },
      "n_d7bbd55d914772dc": {
        "name": "Prepare the next lead",
        "imports": [],
        "source": "export default function next({rows,previous}){const i=previous?.next??0;if(!Array.isArray(rows)||!Number.isInteger(i)||i<0||i>rows.length)throw Error('Invalid row state');return {state:{next:i+1},more:i<rows.length,records:i<rows.length?[{fields:rows[i]}]:[{fields:{}}]};}\n"
      },
      "n_63fa0812aa55a54d": {
        "name": "Confirm the record",
        "imports": [],
        "source": "export default function confirm({records}){if(!Array.isArray(records)||records.length!==1||typeof records[0]?.id!=='string'||!records[0].id)throw Error('Airtable did not confirm the record');return {};}\n"
      }
    }
