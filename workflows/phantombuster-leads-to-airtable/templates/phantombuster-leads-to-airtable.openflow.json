    "modules": {
      "n_10c67d560e1f3e12": {
        "name": "Set Phantom ID",
        "imports": [],
        "source": "export default function endpoint({ agentId }) {\n  if (typeof agentId !== \"string\" || !agentId.trim()) throw Error(\"Enter a Phantom ID\");\n  return { endpoint: \"/agents/fetch-output?id=\" + encodeURIComponent(agentId.trim()) };\n}\n"
      },
      "n_5a8a075e8fab861b": {
        "name": "Find the result container",
        "imports": [],
        "source": "export default function endpoint({ body, statusCode, bodyEncoding }) {\n  if (statusCode < 200 || statusCode >= 300 || bodyEncoding)\n    throw Error(\"Could not read Phantom output\");\n  const id = body?.containerId;\n  if (typeof id !== \"string\" || !id.trim()) throw Error(\"No container ID in Phantom output\");\n  return { endpoint: \"/containers/fetch-result-object?id=\" + encodeURIComponent(id) };\n}\n"
      },
      "n_6f2fce2bda421841": {
        "name": "Prepare lead fields",
        "imports": [],
        "source": "export default function rows({ body, statusCode, bodyEncoding }) {\n  if (statusCode < 200 || statusCode >= 300 || bodyEncoding)\n    throw Error(\"Could not read container result\");\n  if (!body || !Object.hasOwn(body, \"resultObject\")) throw Error(\"Missing result object\");\n  if (body.resultObject === null) return { rows: [] };\n  if (typeof body.resultObject !== \"string\") throw Error(\"Invalid result object\");\n  let parsed;\n  try {\n    parsed = JSON.parse(body.resultObject);\n  } catch {\n    throw Error(\"Invalid result JSON\");\n  }\n  const items = Array.isArray(parsed) ? parsed : [parsed];\n  return {\n    rows: items.map((x) => {\n      const name = x?.general?.fullName,\n        email = x?.details?.mail,\n        company = x?.jobs?.[0]?.companyName;\n      if (\n        typeof name !== \"string\" ||\n        !name.trim() ||\n        typeof email !== \"string\" ||\n        !email.trim() ||\n        typeof company !== \"string\" ||\n        !company.trim()\n      )\n        throw Error(\"Each result needs general.fullName, details.mail and jobs[0].companyName\");\n      return { Name: name, Email: email, Company: company };\n    }),\n  };\n}\n"
      },
      "n_d7bbd55d914772dc": {
        "name": "Prepare the next lead",
        "imports": [],
        "source": "export default function next({ rows, previous }) {\n  const i = previous?.next ?? 0;\n  if (!Array.isArray(rows) || !Number.isInteger(i) || i < 0 || i > rows.length)\n    throw Error(\"Invalid row state\");\n  return {\n    state: { next: i + 1 },\n    more: i < rows.length,\n    records: i < rows.length ? [{ fields: rows[i] }] : [{ fields: {} }],\n  };\n}\n"
      },
      "n_63fa0812aa55a54d": {
        "name": "Confirm the record",
        "imports": [],
        "source": "export default function confirm({ records }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id\n  )\n    throw Error(\"Airtable did not confirm the record\");\n  return {};\n}\n"
      }
    }
  },
