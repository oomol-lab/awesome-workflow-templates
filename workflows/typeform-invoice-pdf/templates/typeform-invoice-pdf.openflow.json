    "modules": {
      "n_f949c81ccc2936d4": {
        "name": "Build the two-item invoice",
        "imports": [],
        "source": "export default function typeformInvoiceData({ response, invoiceDefaults, templateId }) {\n  if (\n    !response ||\n    typeof response !== \"object\" ||\n    !Array.isArray(response.answers) ||\n    response.answers.length < 6\n  )\n    throw new Error(\"Expected the six invoice answers in the configured form order\");\n  const answers = response.answers;\n  const text = (index, type) => {\n    const answer = answers[index];\n    if (!answer || answer.type !== type || typeof answer[type] !== \"string\" || !answer[type].trim())\n      throw new Error(\"Missing or invalid invoice answer at position \" + (index + 1));\n    return answer[type];\n  };\n  const amount = (index) => {\n    const answer = answers[index];\n    if (\n      !answer ||\n      answer.type !== \"number\" ||\n      typeof answer.number !== \"number\" ||\n      !Number.isFinite(answer.number)\n    )\n      throw new Error(\"Missing or invalid invoice amount at position \" + (index + 1));\n    return \"EUR \" + answer.number;\n  };\n  const fields = [\n    \"company\",\n    \"invoice_no\",\n    \"invoice_date\",\n    \"invoice_due_date\",\n    \"address\",\n    \"website\",\n    \"document_id\",\n  ];\n  if (!invoiceDefaults || typeof invoiceDefaults !== \"object\" || Array.isArray(invoiceDefaults))\n    throw new Error(\"Configure the invoice issuer and document fields\");\n  const body = {};\n  for (const field of fields) {\n    if (typeof invoiceDefaults[field] !== \"string\" || !invoiceDefaults[field].trim())\n      throw new Error(\"Configure invoice field \" + field);\n    body[field] = invoiceDefaults[field];\n  }\n  body.email = text(1, \"email\");\n  body.company_bill_to = text(0, \"text\");\n  body.items = [\n    { item_name: text(2, \"text\"), price: amount(3) },\n    { item_name: text(4, \"text\"), price: amount(5) },\n  ];\n  if (typeof templateId !== \"string\" || !templateId.trim())\n    throw new Error(\"Configure the PDF template ID\");\n  return {\n    body,\n    url: \"https://api.apitemplate.io/v1/create?template_id=\" + encodeURIComponent(templateId),\n  };\n}\n"
      },
      "n_c03d80d26106c033": {
        "name": "Retain the complete PDF file",
        "imports": [],
        "source": "export default async function invoicePdfFile({ result, downloadHost }, context) {\n  if (\n    !result ||\n    typeof result !== \"object\" ||\n    Array.isArray(result) ||\n    result.status === \"error\" ||\n    typeof result.download_url !== \"string\"\n  )\n    throw new Error(\n      \"APITemplate.io did not confirm a downloadable PDF; creation may already have occurred\",\n    );\n  let url;\n  try {\n    url = new URL(result.download_url);\n  } catch {\n    throw new Error(\n      \"APITemplate.io returned an invalid download URL; creation may already have occurred\",\n    );\n  }\n  if (\n    typeof downloadHost !== \"string\" ||\n    !downloadHost ||\n    url.protocol !== \"https:\" ||\n    url.hostname !== downloadHost ||\n    url.username ||\n    url.password ||\n    url.port ||\n    url.hash\n  )\n    throw new Error(\n      \"The PDF download URL must use the configured HTTPS host; creation may already have occurred\",\n    );\n  const response = await context.fetch(url.href, { method: \"GET\" });\n  if (!response.ok)\n    throw new Error(\n      \"PDF download failed with HTTP \" + response.status + \"; creation may already have occurred\",\n    );\n  const bytes = new Uint8Array(await response.arrayBuffer());\n  if (\n    bytes.length === 0 ||\n    bytes.length < 5 ||\n    bytes[0] !== 37 ||\n    bytes[1] !== 80 ||\n    bytes[2] !== 68 ||\n    bytes[3] !== 70 ||\n    bytes[4] !== 45\n  )\n    throw new Error(\"The download did not contain a PDF; creation may already have occurred\");\n  const pdf = await context.artifact.put(bytes, {\n    name: \"invoice.pdf\",\n    mediaType: \"application/pdf\",\n  });\n  return { pdf, result, downloadUrl: result.download_url };\n}\n"
      }
