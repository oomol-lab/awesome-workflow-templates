    "modules": {
      "n_f949c81ccc2936d4": {
        "name": "Build the two-item invoice",
        "imports": [],
        "source": "export default function typeformInvoiceData({ response, invoiceDefaults, templateId }) {\n  if (!response || typeof response !== 'object' || !Array.isArray(response.answers) || response.answers.length < 6) throw new Error('Expected the six invoice answers in the configured form order');\n  const answers = response.answers;\n  const text = (index, type) => {\n    const answer = answers[index];\n    if (!answer || answer.type !== type || typeof answer[type] !== 'string' || !answer[type].trim()) throw new Error('Missing or invalid invoice answer at position ' + (index + 1));\n    return answer[type];\n  };\n  const amount = index => {\n    const answer = answers[index];\n    if (!answer || answer.type !== 'number' || typeof answer.number !== 'number' || !Number.isFinite(answer.number)) throw new Error('Missing or invalid invoice amount at position ' + (index + 1));\n    return 'EUR ' + answer.number;\n  };\n  const fields = ['company', 'invoice_no', 'invoice_date', 'invoice_due_date', 'address', 'website', 'document_id'];\n  if (!invoiceDefaults || typeof invoiceDefaults !== 'object' || Array.isArray(invoiceDefaults)) throw new Error('Configure the invoice issuer and document fields');\n  const body = {};\n  for (const field of fields) {\n    if (typeof invoiceDefaults[field] !== 'string' || !invoiceDefaults[field].trim()) throw new Error('Configure invoice field ' + field);\n    body[field] = invoiceDefaults[field];\n  }\n  body.email = text(1, 'email');\n  body.company_bill_to = text(0, 'text');\n  body.items = [{ item_name: text(2, 'text'), price: amount(3) }, { item_name: text(4, 'text'), price: amount(5) }];\n  if (typeof templateId !== 'string' || !templateId.trim()) throw new Error('Configure the PDF template ID');\n  return { body, url: 'https://api.apitemplate.io/v1/create?template_id=' + encodeURIComponent(templateId) };\n}\n"
      },
      "n_c03d80d26106c033": {
        "name": "Retain the complete PDF file",
        "imports": [],
        "source": "export default async function invoicePdfFile({ result, downloadHost }, context) {\n  if (!result || typeof result !== 'object' || Array.isArray(result) || result.status === 'error' || typeof result.download_url !== 'string') throw new Error('APITemplate.io did not confirm a downloadable PDF; creation may already have occurred');\n  let url;\n  try { url = new URL(result.download_url); } catch { throw new Error('APITemplate.io returned an invalid download URL; creation may already have occurred'); }\n  if (typeof downloadHost !== 'string' || !downloadHost || url.protocol !== 'https:' || url.hostname !== downloadHost || url.username || url.password || url.port || url.hash) throw new Error('The PDF download URL must use the configured HTTPS host; creation may already have occurred');\n  const response = await context.fetch(url.href, { method: 'GET' });\n  if (!response.ok) throw new Error('PDF download failed with HTTP ' + response.status + '; creation may already have occurred');\n  const bytes = new Uint8Array(await response.arrayBuffer());\n  if (bytes.length === 0 || bytes.length < 5 || bytes[0] !== 37 || bytes[1] !== 80 || bytes[2] !== 68 || bytes[3] !== 70 || bytes[4] !== 45) throw new Error('The download did not contain a PDF; creation may already have occurred');\n  const pdf = await context.artifact.put(bytes, { name: 'invoice.pdf', mediaType: 'application/pdf' });\n  return { pdf, result, downloadUrl: result.download_url };\n}\n"
      }
