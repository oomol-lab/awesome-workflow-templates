    "modules": {
      "n_918b55fe649ba325": {
        "name": "Validate lead details",
        "imports": [],
        "source": "export default function ({ body }) {\n  for (const key of [\"firstName\", \"company\", \"url\", \"offer\"])\n    if (typeof body?.[key] !== \"string\" || !body[key].trim())\n      throw Error(\"All lead fields are required\");\n  if (!/^https?:\\/\\//i.test(body.url)) throw Error(\"Enter an HTTP URL\");\n  return { ...body, request: { url: body.url } };\n}\n"
      },
      "n_75fcac63edb189ea": {
        "name": "Prepare website text",
        "imports": [],
        "source": "export default function ({ body }) {\n  const text =\n    typeof body?.text === \"string\" ? body.text.replace(/\\s+/g, \" \").trim().slice(0, 6000) : \"\";\n  return { text, enough: text.split(/\\s+/).filter(Boolean).length >= 40 };\n}\n"
      },
      "n_f41c30bb4c14727e": {
        "name": "Return draft JSON",
        "imports": [],
        "source": "export default function ({ draft }) {\n  return { body: JSON.stringify({ draft }) };\n}\n"
      },
      "n_af154c857eeffd07": {
        "name": "Request human review",
        "imports": [],
        "source": "export default function () {\n  return { body: JSON.stringify({ draft: \"[NEEDS-HUMAN] Insufficient website content.\" }) };\n}\n"
      }
