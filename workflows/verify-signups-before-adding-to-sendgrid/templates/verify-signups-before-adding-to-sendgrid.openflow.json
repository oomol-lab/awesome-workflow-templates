    "modules": {
      "n_7adf3995b815dbed": {
        "name": "Read the submitted email",
        "imports": [],
        "source": "export default function read({ body }) {\n  return { email: body.Email };\n}\n"
      },
      "n_e858446e85402d75": {
        "name": "Verify the submitted address",
        "imports": [],
        "source": "function verify({ email, result }) {\n  const status = result?.status;\n  if (typeof status !== \"string\") throw new Error(\"Hunter did not return a verification status\");\n  if (status !== \"valid\") return { valid: false };\n  if (typeof result.email !== \"string\" || result.email.toLowerCase() !== email.toLowerCase()) {\n    throw new Error(\"Hunter verification does not match the submitted email\");\n  }\n  return { valid: true };\n}\n\nexport default function evaluate({ email, reply }) {\n  return verify({ email, result: reply.data });\n}\n"
      },
      "n_537523daa496d8f2": {
        "name": "Configure SendGrid list",
        "imports": [],
        "source": "export default function configure({ email, listId }) {\n  if (!/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(listId)) {\n    throw new Error(\"Set the SendGrid Marketing Contacts list ID\");\n  }\n  return { body: { list_ids: [listId], contacts: [{ email }] } };\n}\n"
      },
      "n_201fecd43c21a3f0": {
        "name": "Read the SendGrid job ID",
        "imports": [],
        "source": "function readJobId(reply) {\n  const id = reply?.job_id;\n  if (typeof id !== \"string\" || !/^[A-Za-z0-9_-]{1,128}$/.test(id)) {\n    throw new Error(\"SendGrid did not return a usable import job ID\");\n  }\n  return id;\n}\nexport default function queued({ reply, statusCode }) {\n  if (statusCode !== 202) throw new Error(\"SendGrid did not queue the contact upsert\");\n  const jobId = readJobId(reply);\n  return { jobId, endpoint: \"/v3/marketing/contacts/imports/\" + jobId };\n}\n"
      },
      "n_7459fa7ded74432b": {
        "name": "Check import completion",
        "imports": [],
        "source": "function checkImport({ response, jobId, attempt }) {\n  if (\n    (response?.id != null && response.id !== jobId) ||\n    (response?.job_type != null && response.job_type !== \"upsert\")\n  ) {\n    throw new Error(\"SendGrid returned a different import job\");\n  }\n  if (response?.status === \"pending\") {\n    if (attempt >= 12) throw new Error(\"SendGrid import still pending: \" + jobId);\n    return { pending: true, attempt };\n  }\n  if (\n    response?.status !== \"completed\" ||\n    (response.results?.requested_count != null && response.results.requested_count !== 1) ||\n    (response.results?.errored_count ?? 0) !== 0\n  ) {\n    throw new Error(\"SendGrid import did not complete successfully: \" + jobId);\n  }\n  return { pending: false, attempt };\n}\nexport default function check({ response, statusCode, jobId, previous }) {\n  if (statusCode !== 200) throw new Error(\"Could not read SendGrid import status: \" + jobId);\n  return checkImport({ response, jobId, attempt: (previous ?? 0) + 1 });\n}\n"
      }
