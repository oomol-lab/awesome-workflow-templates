    "modules": {
      "n_6263400803a400e6": {
        "name": "Extract agreement details",
        "imports": [],
        "source": "export default function agreement({ body }) {\n  const event = body.event,\n    a = event?.agreement;\n  if (!a || !a.id || !a.status || !Array.isArray(a.participantSetsInfo))\n    throw Error(\"Adobe Sign event must include agreement id, status and participant sets\");\n  return {\n    webhookData: event,\n    agreementId: a.id,\n    participants: a.participantSetsInfo,\n    status: a.status,\n  };\n}\n"
      }
    }
