        "name": "Prepare idea and response",
        "imports": [],
        "source": "export default function prepare({ event, dataSourceId, titleProperty }) {\n  const { command, text, user_name } = event.event;\n  return {\n    command,\n    parent: { data_source_id: dataSourceId },\n    properties: {\n      [titleProperty]: { title: [{ text: { content: text } }] },\n      Creator: { rich_text: [{ text: { content: user_name } }] },\n    },\n  };\n}\n"
      },
