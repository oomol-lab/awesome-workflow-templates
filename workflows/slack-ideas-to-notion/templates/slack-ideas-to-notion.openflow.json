        "source": "export default function reply({ event, page }) {\n  const { text, user_id, response_url } = event.event;\n  if (typeof page.url !== \"string\" || !page.url)\n    throw Error(\"Notion did not return the created page URL\");\n  const message = `Thanks for adding the idea \\`${text}\\` <@${user_id}> :rocket: Please make sure to add some details and a hypothesis to it to make it easier for us to work with it.\\n\\n:point_right: <${page.url}|Add your details here>`;\n  return { responseUrl: response_url, body: { text: message } };\n}\n"
      }
    }
