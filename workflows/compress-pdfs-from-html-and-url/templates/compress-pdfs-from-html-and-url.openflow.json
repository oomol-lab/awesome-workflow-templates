    "modules": {
      "n_7c1edd74c839f15a": {
        "name": "Set HTML and PDF URL",
        "imports": [],
        "source": "function validateInputs({ html, pdfUrl }) {\n  if (typeof html !== \"string\" || !html.trim()) throw new Error(\"Enter HTML to convert\");\n  if (typeof pdfUrl !== \"string\" || !/^https?:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(pdfUrl)) {\n    throw new Error(\"Enter a direct HTTP or HTTPS PDF URL\");\n  }\n  return { html, pdfUrl };\n}\nexport default validateInputs;\n"
      },
      "n_0df4407c949d7352": {
        "name": "Check rendered PDF link",
        "imports": [],
        "source": "export default function check({ url }) {\n  if (typeof url !== \"string\" || !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(url)) {\n    throw new Error(\"PDF.co did not return an HTTPS download URL\");\n  }\n  return { url };\n}\n"
      },
      "n_590cee19b34c4112": {
        "name": "Check compressed HTML PDF link",
        "imports": [],
        "source": "export default function check({ url }) {\n  if (typeof url !== \"string\" || !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(url)) {\n    throw new Error(\"PDF.co did not return an HTTPS download URL\");\n  }\n  return { url };\n}\n"
      },
      "n_26defbff4a7f8edc": {
        "name": "Verify compressed HTML PDF",
        "imports": [],
        "source": "function requirePdf(bytes) {\n  if (bytes.length < 8 || String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\") {\n    throw new Error(\"The processor did not return PDF bytes\");\n  }\n}\nexport default async function check({ file }, context) {\n  const bytes = await context.artifact.open(file);\n  requirePdf(bytes);\n  if (file.mediaType === \"application/pdf\" && file.name === \"html-compressed.pdf\")\n    return { pdf: file };\n  return {\n    pdf: await context.artifact.put(bytes, {\n      name: \"html-compressed.pdf\",\n      mediaType: \"application/pdf\",\n    }),\n  };\n}\n"
      },
      "n_242b8cd5d87cf230": {
        "name": "Check compressed URL PDF link",
        "imports": [],
        "source": "export default function check({ url }) {\n  if (typeof url !== \"string\" || !/^https:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(url)) {\n    throw new Error(\"PDF.co did not return an HTTPS download URL\");\n  }\n  return { url };\n}\n"
      },
      "n_b4ed089d90ee60d6": {
        "name": "Verify compressed URL PDF",
        "imports": [],
        "source": "function requirePdf(bytes) {\n  if (bytes.length < 8 || String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\") {\n    throw new Error(\"The processor did not return PDF bytes\");\n  }\n}\nexport default async function check({ file }, context) {\n  const bytes = await context.artifact.open(file);\n  requirePdf(bytes);\n  if (file.mediaType === \"application/pdf\" && file.name === \"url-compressed.pdf\")\n    return { pdf: file };\n  return {\n    pdf: await context.artifact.put(bytes, {\n      name: \"url-compressed.pdf\",\n      mediaType: \"application/pdf\",\n    }),\n  };\n}\n"
      }
