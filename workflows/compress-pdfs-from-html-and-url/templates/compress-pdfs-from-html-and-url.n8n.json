        "jsCode": "function requirePdf(bytes) {\n  if (bytes.length < 8 || String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\") {\n    throw new Error(\"The processor did not return PDF bytes\");\n  }\n}\nconst item = $input.first();\nif (!item.binary?.data) throw new Error(\"The processor did not return PDF bytes\");\nrequirePdf(await helpers.getBinaryDataBuffer(0, \"data\"));\nreturn [item];\n"
