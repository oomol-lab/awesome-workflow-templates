    {
      "id": "d60193ff-0bf6-4692-83e2-d0e1e59c5656",
      "name": "Set HTML and PDF URL",
      "type": "n8n-nodes-base.code",
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function validateInputs({ html, pdfUrl }) {\n  if (typeof html !== \"string\" || !html.trim()) throw new Error(\"Enter HTML to convert\");\n  if (typeof pdfUrl !== \"string\" || !/^https?:\\/\\/[^\\s/?#]+(?:[/?#][^\\s]*)?$/i.test(pdfUrl)) {\n    throw new Error(\"Enter a direct HTTP or HTTPS PDF URL\");\n  }\n  return { html, pdfUrl };\n}\nconst html = \"<h1>Hello World</h1>\";\nconst pdfUrl = \"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\";\nreturn [{ json: validateInputs({ html, pdfUrl }) }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "b962ef3d-b0ad-4b21-bb15-61b6521bfd03",
      "name": "Convert HTML to PDF",
      "type": "@custom-js/n8n-nodes-pdf-toolkit.html2Pdf",
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "html2Pdf",
        "htmlInput": "={{ $json.html }}",
        "outputFilename": "rendered-html.pdf"
      },
      "notesInFlow": false,
      "typeVersion": 1
    },
    {
      "id": "988f427e-7eca-43e5-a77d-c69a92ec6158",
      "name": "Compress the rendered PDF",
      "type": "@custom-js/n8n-nodes-pdf-toolkit.CompressPDF",
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "compressPdf",
        "resource": "binary",
        "field_name": "data",
        "outputFilename": "html-compressed.pdf"
      },
      "typeVersion": 1
    },
    {
      "name": "Verify compressed HTML PDF",
      "id": "compress-pdfs-from-html-and-url-check-html",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function requirePdf(bytes) {\n  if (bytes.length < 8 || String.fromCharCode(...bytes.subarray(0, 5)) !== \"%PDF-\") {\n    throw new Error(\"The processor did not return PDF bytes\");\n  }\n}\nconst item = $input.first();\nif (!item.binary?.data) throw new Error(\"The processor did not return PDF bytes\");\nrequirePdf(await helpers.getBinaryDataBuffer(0, \"data\"));\nreturn [item];\n"
      },
      "position": [
        880,
        0
      ]
    },
    {
      "id": "492b07d3-4643-4d1e-acbb-b0a7b7fde350",
      "name": "Compress the PDF from the URL",
      "type": "@custom-js/n8n-nodes-pdf-toolkit.CompressPDF",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "compressPdf",
        "resource": "url",
        "field_name": "={{ $('Set HTML and PDF URL').first().json.pdfUrl }}",
        "outputFilename": "url-compressed.pdf"
      },
      "typeVersion": 1
    },
