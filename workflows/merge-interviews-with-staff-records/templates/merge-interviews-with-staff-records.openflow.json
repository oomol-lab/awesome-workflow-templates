    "modules": {
      "n_85d036c5eda4b97f": {
        "name": "Match interviewer IDs",
        "imports": [],
        "source": "export default function merge({ interviews, staff }) {\n  const byId = Object.create(null);\n  for (const person of staff) {\n    const id = person?.fields?.eid;\n    if (id) byId[String(id)] = person;\n  }\n  const merged = [];\n  for (const interview of interviews) {\n    const id = interview?.interviewers?.[0]?.id;\n    if (id === undefined || id === null || ![\"string\", \"number\"].includes(typeof id)) continue;\n    const person = byId[String(id)];\n    merged.push(person ? { ...interview, ...person } : interview);\n  }\n  return { merged };\n}\n"
      }
    }
  },
