    "modules": {
      "n_0885d9d7a7c52b79": {
        "name": "Prepare address and contact",
        "imports": [],
        "source": "export default function prepare({body,locationId}){const b=body??{},email=typeof b.email==='string'?b.email.trim():'',phone=typeof b.phone==='string'?b.phone.trim():'';if(!email&&!phone)throw Error('Contact email or phone is required');if(typeof b.address!=='string'||!b.address.trim())throw Error('A primary address is required');if(typeof locationId!=='string'||!locationId.trim()||locationId==='YOUR_LOCATION_ID')throw Error('Configure the HighLevel location ID');const city=typeof b.city==='string'&&b.city.trim()?b.city.trim():null,state=typeof b.state==='string'&&b.state.trim()?b.state.trim():null,zip=typeof b.zip_code==='string'&&b.zip_code.trim()?b.zip_code.trim():null;if(!zip&&!(city&&state))throw Error('Provide ZIP or both city and state');const secondary=typeof b.address2==='string'&&b.address2.trim()?b.address2.trim():null;return{primary:b.address.trim(),secondary,city,state,zip,contact:{locationId:locationId.trim(),...(email?{email}:{}),...(phone?{phone}:{})}}}\n"
      },
      "n_f9a1dd84d98fd50b": {
        "name": "Choose the deliverability tag",
        "imports": [],
        "source": "export default function plan({verification,contact}){const d=verification?.deliverability,allowed=['deliverable','deliverable_unnecessary_unit','deliverable_incorrect_unit','deliverable_missing_unit','undeliverable'];if(!allowed.includes(d))throw Error('Lob did not return a recognized deliverability status');const tag=d==='deliverable'?'Mailing Address Deliverable':'Mailing Address NOT Deliverable';return{body:contact,tag,deliverability:d}}\n"
      },
      "n_6b77506c4d62690c": {
        "name": "Confirm the contact",
        "imports": [],
        "source": "export default function contact({response,statusCode,tag,deliverability}){if(statusCode<200||statusCode>=300||typeof response?.contact?.id!=='string'||!response.contact.id)throw Error('HighLevel contact upsert was not confirmed; inspect before retrying');return{endpoint:'/contacts/'+encodeURIComponent(response.contact.id)+'/tags',body:{tags:[tag]},tag,deliverability,contactId:response.contact.id}}\n"
      },
      "n_d644c800bc79e3ca": {
        "name": "Confirm the tag",
        "imports": [],
        "source": "export default function confirm({response,statusCode,tag,deliverability,contactId}){if(statusCode<200||statusCode>=300||!Array.isArray(response?.tags)||!response.tags.includes(tag))throw Error('HighLevel tag was not confirmed; inspect the contact before retrying');return{result:{contactId,deliverability,tag}}}\n"
      }
    }
  },
