{
  "nodes": [
    {
      "id": "workflow-github-tag-0",
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "workflow-github-tag-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        240,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "workflow-github-tag-2",
      "name": "n8n",
      "type": "n8n-nodes-base.n8n",
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Process workflow",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "workflow-github-tag-3",
      "position": [
        720,
        0
      ]
    },
    {
      "name": "Prepare backup path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = String($json.id ?? \"\"),\n  tag = $json.tags?.[0]?.name;\nif (\n  !/^[\\w-]+$/.test(id) ||\n  (tag != null && (tag === \".\" || tag === \"..\" || !/^[-\\w.]+$/.test(tag)))\n)\n  throw Error(\"Invalid workflow ID or tag\");\nconst base = \"workflows\",\n  parts = base.split(\"/\").filter(Boolean);\nif (parts.some((x) => x === \".\" || x === \"..\" || !/^[-\\w.]+$/.test(x)))\n  throw Error(\"Invalid backup path\");\nconst path = [...parts, ...(tag ? [tag] : []), id + \".json\"].join(\"/\");\nreturn {\n  json: { id, path, owner: \"YOUR_GITHUB_OWNER\", repo: \"YOUR_GITHUB_REPO\" },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "workflow-github-tag-4",
      "position": [
        960,
        0
      ]
    },
    {
      "name": "Read workflow details",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "get",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        }
      },
      "id": "workflow-github-tag-5",
      "position": [
        1200,
        0
      ]
    },
    {
      "name": "Prepare GitHub read",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare backup path\").item.json;\nif (String($json.id) !== p.id) throw Error(\"Workflow ID mismatch\");\nconst { owner, repo } = p;\nreturn {\n  json: {\n    url:\n      \"https://api.github.com/repos/\" +\n      encodeURIComponent(owner) +\n      \"/\" +\n      encodeURIComponent(repo) +\n      \"/contents/\" +\n      p.path.split(\"/\").map(encodeURIComponent).join(\"/\"),\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
      "id": "workflow-github-tag-6",
      "position": [
        1440,
        0
      ]
    },
    {
      "name": "Read GitHub backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "workflow-github-tag-7",
      "position": [
        1680,
        0
      ]
    },
    {
      "name": "Read backup checkpoint",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'n8n-github:'+$('Prepare backup path').item.json.owner+'/'+$('Prepare backup path').item.json.repo+'/'+$('Prepare backup path').item.json.path }}"
            }
          ]
        },
        "operation": "get"
      },
      "id": "workflow-github-tag-8",
      "position": [
        1920,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "name": "Compare backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $input.all();\nif (state.length !== 1) throw Error(\"Duplicate checkpoint\");\nif (state[0].json.status === \"pending\") throw Error(\"Inspect pending GitHub write\");\nconst p = $(\"Prepare backup path\").item.json,\n  w = $(\"Read workflow details\").item.json,\n  r = $(\"Read GitHub backup\").item.json;\nif (String(w.id) !== p.id) throw Error(\"Workflow mismatch\");\nconst status = r.statusCode,\n  b = r.body;\nif (![200, 404].includes(status)) throw Error(\"GitHub read failed \" + status);\nconst sort = (x) =>\n  JSON.stringify(Object.fromEntries(Object.entries(x).sort(([a], [b]) => a.localeCompare(b))));\nconst content = sort(w);\nlet sha = null,\n  same = false;\nif (status === 200) {\n  if (b?.type !== \"file\" || b.path !== p.path || !b.sha || b.encoding !== \"base64\" || !b.content)\n    throw Error(\"Invalid GitHub file\");\n  sha = b.sha;\n  let old;\n  try {\n    old = JSON.parse(Buffer.from(b.content.replace(/\\s/g, \"\"), \"base64\").toString(\"utf8\"));\n  } catch {\n    throw Error(\"Invalid JSON\");\n  }\n  same = sort(old) === content;\n}\nconst { owner, repo } = p;\nreturn [\n  {\n    json: {\n      write: !same,\n      url:\n        \"https://api.github.com/repos/\" +\n        encodeURIComponent(owner) +\n        \"/\" +\n        encodeURIComponent(repo) +\n        \"/contents/\" +\n        p.path.split(\"/\").map(encodeURIComponent).join(\"/\"),\n      body: {\n        message: \"Back up workflow \" + p.id,\n        content: Buffer.from(content).toString(\"base64\"),\n        ...(sha ? { sha } : {}),\n      },\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "workflow-github-tag-9",
      "position": [
        2160,
        0
      ]
    },
    {
      "name": "Backup changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.write }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "workflow-github-tag-10",
      "position": [
        2400,
        0
      ]
    },
    {
      "name": "Reserve GitHub write",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'n8n-github:'+$('Prepare backup path').item.json.owner+'/'+$('Prepare backup path').item.json.repo+'/'+$('Prepare backup path').item.json.path }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "workflow-github-tag-11",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Restore GitHub request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Compare backup\").item.json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "workflow-github-tag-12",
      "position": [
        2880,
        0
      ]
    },
    {
      "name": "Write GitHub backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}"
      },
      "id": "workflow-github-tag-13",
      "position": [
        3120,
        0
      ]
    },
    {
      "name": "Verify GitHub write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (![200, 201].includes($json.statusCode) || !$json.body?.content?.sha)\n  throw Error(\"Inspect GitHub write result\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "workflow-github-tag-14",
      "position": [
        3360,
        0
      ]
    },
    {
      "name": "Confirm GitHub write",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'n8n-github:'+$('Prepare backup path').item.json.owner+'/'+$('Prepare backup path').item.json.repo+'/'+$('Prepare backup path').item.json.path }}"
            }
          ]
        },
        "operation": "delete"
      },
      "id": "workflow-github-tag-15",
      "position": [
        3600,
        0
      ]
    }
  ],
