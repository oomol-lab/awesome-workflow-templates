    "modules": {
      "n_b5cba2c168c9b9a5": {
        "name": "Validate contact details",
        "imports": [],
        "source": "export default function setup({ listId, email, initialName, updatedName }) {\n  if (\n    typeof listId !== \"string\" ||\n    !/^\\d+$/.test(listId) ||\n    !Number.isSafeInteger(Number(listId)) ||\n    Number(listId) < 1\n  )\n    throw Error(\"Enter a numeric list ID\");\n  if (typeof email !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()))\n    throw Error(\"Enter a valid email\");\n  if (\n    typeof initialName !== \"string\" ||\n    !initialName.trim() ||\n    typeof updatedName !== \"string\" ||\n    !updatedName.trim()\n  )\n    throw Error(\"Enter both names\");\n  return {\n    listId: Number(listId),\n    email: email.trim(),\n    initialName: initialName.trim(),\n    updatedName: updatedName.trim(),\n    url: \"https://api.egoiapp.com/lists/\" + listId + \"/contacts\",\n    body: { base: { email: email.trim(), first_name: initialName.trim() }, extra: [] },\n    update: { base: { first_name: updatedName.trim() }, extra: [] },\n  };\n}\n"
      },
      "n_1e5aa07d90b1433d": {
        "name": "Identify the contact",
        "imports": [],
        "source": "export default function created({ body, listId }) {\n  const id = body?.contact_id;\n  if (typeof id !== \"string\" || !/^[a-f0-9]{10}$/i.test(id))\n    throw Error(\"Contact ID missing or invalid\");\n  return { contactId: id, url: \"https://api.egoiapp.com/lists/\" + listId + \"/contacts/\" + id };\n}\n"
      },
      "n_95ef78ce6abe1756": {
        "name": "Verify the contact",
        "imports": [],
        "source": "export default function confirm({ body, contactId, email, updatedName }) {\n  const c = body?.base;\n  if (\n    !c ||\n    c.contact_id !== contactId ||\n    typeof c.email !== \"string\" ||\n    c.email.toLowerCase() !== email.toLowerCase() ||\n    c.first_name !== updatedName\n  )\n    throw Error(\"Returned contact does not match\");\n  return { contact: body };\n}\n"
      }
    }
