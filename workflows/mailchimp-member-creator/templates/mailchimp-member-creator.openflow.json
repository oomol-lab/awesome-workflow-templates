    "modules": {
      "n_12cefb600bf5ef25": {
        "name": "Prepare subscribed member",
        "imports": [],
        "source": "export default function memberRequest({ listId, email, firstName }) {\n  if (typeof listId !== \"string\" || !listId.trim()) throw new Error(\"Audience ID is required\");\n  if (typeof email !== \"string\" || !email.trim()) throw new Error(\"Email is required\");\n  if (typeof firstName !== \"string\" || !firstName.trim()) throw new Error(\"First name is required\");\n  return {\n    endpoint: \"/lists/\" + encodeURIComponent(listId) + \"/members\",\n    body: { email_address: email, status: \"subscribed\", merge_fields: { FNAME: firstName } },\n  };\n}\n"
      },
      "n_827db72724c688e6": {
        "name": "Read created member",
        "imports": [],
        "source": "export default function memberResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding)\n    throw new Error(\"Mailchimp did not return a completed member result (HTTP \" + statusCode + \")\");\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    typeof body.id !== \"string\" ||\n    !body.id ||\n    typeof body.email_address !== \"string\" ||\n    typeof body.status !== \"string\"\n  )\n    throw new Error(\"Mailchimp returned an unexpected member response\");\n  return { member: body };\n}\n"
      }
    }
