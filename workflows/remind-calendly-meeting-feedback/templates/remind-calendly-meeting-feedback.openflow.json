    "modules": {
      "n_cb0d9a7571ffdf33": {
        "name": "Read Calendly event",
        "imports": [],
        "source": "export default function read({ body }) {\n  const event = JSON.parse(body.event),\n    p = event.payload,\n    e = p?.scheduled_event,\n    u = new URL(e?.event_type);\n  if (\n    u.origin !== \"https://api.calendly.com\" ||\n    !/^\\/event_types\\/[A-Za-z0-9_-]+$/.test(u.pathname)\n  )\n    throw Error(\"Invalid Calendly event type URL\");\n  return { event, eventTypeUrl: u.toString() };\n}\n"
      },
      "n_81c487848b8ec73f": {
        "name": "Prepare activity and reminder",
        "imports": [],
        "source": "export default function prepare({ event, eventType, notesUrl }) {\n  const p = event.payload,\n    e = p.scheduled_event,\n    t = eventType.resource,\n    host = e.event_memberships?.[0]?.user_email ?? e.event_memberships?.[0]?.user_name;\n  if (!t?.name || !t?.kind || !p?.name || !e?.start_time || !e?.end_time || !host)\n    throw Error(\"Calendly event is missing meeting details\");\n  const durationMs = Math.max(1, Date.parse(e.end_time) + 15 * 60 * 1000 - Date.now());\n  if (!Number.isFinite(durationMs)) throw Error(\"Invalid meeting end time\");\n  return {\n    activity: { subject: `${t.name} with ${p.name} on ${e.start_time}`, type: \"call\" },\n    text: `${host}, today you had a ${t.name} ${t.kind} meeting with ${p.name}. Please write your notes from the call here ${notesUrl} and mark this message with ✅ when you're done.`,\n    durationMs,\n  };\n}\n"
      }
    }
