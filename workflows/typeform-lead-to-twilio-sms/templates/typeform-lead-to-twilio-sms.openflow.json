    "modules": {
      "n_f7e482f6d37183de": {
        "name": "Prepare the lead SMS",
        "imports": [],
        "source": "export default function leadMessage({response}){\n  if(!response||!Array.isArray(response.definition?.fields)||!Array.isArray(response.answers))throw Error('Expected the complete Typeform response');\n  const questions=[['Last name','And your *last name*?'],['First name',\"Let's start with your* first name.*\"],['Number of children','How many child do you have ?'],['Country','Lastly, [field:d566770d2197a78b], what country do you live in?'],['Email','What *email address* can we reach you at? This is only to get in touch, not to send spam.'],['Birth date','What is your birth date ?']];\n  const map=new Map();for(const f of response.definition.fields){if(typeof f?.id!=='string'||typeof f.title!=='string'||map.has(f.id))throw Error('Invalid form definition');map.set(f.id,f.title.replace(/\\{\\{/g,'[').replace(/\\}\\}/g,']'));}\n  const answers=new Map();for(const a of response.answers){const title=map.get(a?.field?.id);if(!title)throw Error('Answer has no matching question');if(answers.has(title))throw Error('Repeated answer title');let v=a[a.type];if(v&&typeof v==='object'&&!Array.isArray(v)&&Object.hasOwn(v,'label'))v=v.label;answers.set(title,v);}\n  const lines=questions.map(([label,title])=>{const v=answers.get(title);if((typeof v!=='string'&&typeof v!=='number')||!String(v).trim())throw Error('Missing or invalid '+label+' answer');return label+': '+String(v)});const body='New lead submission:\\n\\n'+lines.join('\\n');if(body.length>1600)throw Error('SMS body exceeds 1600 characters');return {body};\n}\n"
      }
    }
