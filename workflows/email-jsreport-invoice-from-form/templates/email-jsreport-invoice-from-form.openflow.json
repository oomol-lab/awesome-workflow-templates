      "n_29ff8fa28043d0b5": {
        "name": "Prepare invoice data",
        "imports": [],
        "source": "export default function input({ response, number, sellerName, sellerRoad, sellerCountry }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers)) throw Error(\"Expected Typeform response\");\n  function value(title) {\n    const f = fields.filter((x) => x.title === title);\n    if (f.length !== 1) throw Error(\"Missing form field \" + title);\n    const a = answers.filter((x) => x.field?.id === f[0].id);\n    if (a.length !== 1) throw Error(\"Missing answer \" + title);\n    return a[0][a[0].type];\n  }\n  const buyer = {\n      name: value(\"buyer name\"),\n      road: value(\"buyer road\"),\n      country: value(\"buyer country\"),\n    },\n    items = [\n      { name: value(\"Item 1 Name\"), price: Number(value(\"Item 1 Price\")) },\n      { name: value(\"Item 2 Name\"), price: Number(value(\"Item 2 Price\")) },\n    ];\n  if (\n    !buyer.name ||\n    !buyer.road ||\n    !buyer.country ||\n    items.some((x) => !x.name || !Number.isFinite(x.price))\n  )\n    throw Error(\"Invalid invoice fields\");\n  return {\n    body: {\n      template: { name: \"invoice-main\" },\n      data: {\n        number,\n        seller: { name: sellerName, road: sellerRoad, country: sellerCountry },\n        buyer,\n        items,\n      },\n    },\n  };\n}\n"
      },
      "n_729b77472a2fe526": {
        "name": "Render PDF with JSReport",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function render({ host, username, password, body, to }, context) {\n  if (/[\\r\\n]/.test(to)) throw Error(\"Invalid recipient\");\n  const response = await context.fetch(`https://${host}/api/report`, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      authorization: \"Basic \" + Buffer.from(username + \":\" + password).toString(\"base64\"),\n    },\n    body: JSON.stringify(body),\n  });\n  if (!response.ok) throw Error(\"JSReport request failed\");\n  const bytes = Buffer.from(await response.arrayBuffer());\n  if (!bytes.length || bytes.toString(\"ascii\", 0, 5) !== \"%PDF-\")\n    throw Error(\"JSReport did not return a PDF\");\n  const encoded = bytes.toString(\"base64\").replace(/.{1,76}/g, \"$&\\r\\n\");\n  const boundary = \"openflow-invoice-boundary\";\n  const mime = `To: ${to}\\r\\nSubject: New Facture\\r\\nMIME-Version: 1.0\\r\\nContent-Type: multipart/mixed; boundary=\"${boundary}\"\\r\\n\\r\\n--${boundary}\\r\\nContent-Type: text/plain; charset=UTF-8\\r\\n\\r\\nGood morning,\\r\\n\\r\\nPlease find your invoice.\\r\\n\\r\\nSincerely,\\r\\n--${boundary}\\r\\nContent-Type: application/pdf; name=\"invoice.pdf\"\\r\\nContent-Disposition: attachment; filename=\"invoice.pdf\"\\r\\nContent-Transfer-Encoding: base64\\r\\n\\r\\n${encoded}--${boundary}--\\r\\n`;\n  return {\n    body: {\n      raw: Buffer.from(mime)\n        .toString(\"base64\")\n        .replace(/\\+/g, \"-\")\n        .replace(/\\//g, \"_\")\n        .replace(/=+$/, \"\"),\n    },\n  };\n}\n"
      }
    }
