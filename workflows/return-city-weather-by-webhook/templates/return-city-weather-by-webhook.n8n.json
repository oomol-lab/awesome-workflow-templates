{
  "nodes": [
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        870,
        300
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "tempC",
              "value": "={{$json[\"main\"][\"temp\"]}}"
            },
            {
              "name": "humidity",
              "value": "={{$json[\"main\"][\"humidity\"]}}"
            },
            {
              "name": "windspeed",
              "value": "={{$json[\"wind\"][\"speed\"]}}"
            },
            {
              "name": "description",
              "value": "={{$json[\"weather\"][0][\"description\"]}}"
            },
            {
              "name": "city",
              "value": "={{ $json.name + ', ' + $json.sys.country }}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "return-city-weather-by-webhook-0"
    },
    {
      "name": "OpenWeatherMap",
      "type": "n8n-nodes-base.openWeatherMap",
      "position": [
        650,
        300
      ],
      "parameters": {
        "cityName": "={{$json[\"body\"][\"city\"]}}",
        "format": "metric"
      },
      "typeVersion": 1,
      "id": "return-city-weather-by-webhook-1"
    },
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        450,
        300
      ],
      "parameters": {
        "path": "city-weather",
        "options": {},
        "responseData": "allEntries",
        "responseMode": "lastNode",
        "httpMethod": "POST"
      },
      "typeVersion": 1,
      "id": "return-city-weather-by-webhook-2"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "OpenWeatherMap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWeatherMap": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Return City Weather by Webhook",
  "active": false,
  "pinData": {}
}
