    "modules": {
      "n_04aca4aa3b876f45": {
        "name": "Read the city",
        "imports": [],
        "source": "export default function city({body}){if(typeof body?.city!=='string'||!body.city.trim())throw Error('Provide body.city');return{city:body.city}}\n"
      },
      "n_4e1f7523af949203": {
        "name": "Summarize weather",
        "imports": [],
        "source": "export default function summary({weather}){if(weather?.cod!==200||!weather?.main||!weather?.wind||!weather?.weather?.[0]||!weather?.sys)throw Error('Missing weather data');return{response:[{tempC:weather.main.temp,humidity:weather.main.humidity,windspeed:weather.wind.speed,description:weather.weather[0].description,city:`${weather.name}, ${weather.sys.country}`}]}}\n"
      }
    }
