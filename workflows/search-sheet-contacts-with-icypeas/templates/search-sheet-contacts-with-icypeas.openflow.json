    "modules": {
      "n_1feaa9988d151af6": {
        "name": "Map every contact",
        "imports": [],
        "source": "export default function map({ values }) {\n  if (!Array.isArray(values)) throw Error(\"Expected sheet rows\");\n  if (!values.length) return { rows: [] };\n  const headers = values[0],\n    indexes = [\"firstname\", \"lastname\", \"company\"].map((x) => headers.indexOf(x));\n  if (indexes.some((i) => i < 0)) throw Error(\"Expected firstname, lastname, company headers\");\n  const rows = [];\n  for (const cells of values.slice(1)) {\n    if (!cells.some((x) => x !== \"\" && x != null)) continue;\n    const r = indexes.map((i) => String(cells[i] ?? \"\"));\n    if ((!r[0] && !r[1]) || !r[2]) throw Error(\"Each row needs a first or last name and company\");\n    rows.push(r);\n  }\n  return { rows };\n}\n"
      },
      "n_b0d4fad5c4a60a0b": {
        "name": "Prepare next batch",
        "imports": [],
        "source": "export default function next({ rows, previousState, body }) {\n  if (!Array.isArray(rows)) throw Error(\"Expected complete rows\");\n  let state;\n  if (previousState == null) state = { offset: 0, files: [] };\n  else {\n    if (!body || body.success !== true || typeof body.file !== \"string\" || !body.file)\n      throw Error(\"Icypeas did not confirm batch; it may have been submitted\");\n    state = {\n      offset: previousState.offset + previousState.size,\n      files: [...previousState.files, body.file],\n    };\n  }\n  const batch = rows.slice(state.offset, state.offset + 5000),\n    more = batch.length > 0;\n  state.size = batch.length;\n  return {\n    state,\n    more,\n    body: { name: \"Test\", task: \"email-search\", data: batch },\n    files: state.files,\n  };\n}\n"
      }
    }
