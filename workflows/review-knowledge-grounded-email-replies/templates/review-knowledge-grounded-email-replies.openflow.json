    "modules": {
      "n_0abe34f7fb0e7e29": {
        "name": "Prepare embedding request",
        "imports": [],
        "source": "export default function prepare({ event }) {\n  const x = JSON.parse(event);\n  if (![\"draft\", \"review\"].includes(x.kind) || typeof x.text !== \"string\" || !x.text.trim())\n    throw Error(\"Invalid email request\");\n  if (x.kind === \"review\" && (typeof x.draft !== \"string\" || typeof x.feedback !== \"string\"))\n    throw Error(\"Missing review data\");\n  return {\n    kind: x.kind,\n    body: {\n      model: \"text-embedding-3-small\",\n      input: x.kind === \"draft\" ? x.text : x.text + \"\\n\" + x.feedback,\n    },\n    text: x.text,\n    draft: x.draft ?? \"\",\n    feedback: x.feedback ?? \"\",\n  };\n}\n"
      },
      "n_ca2f67442c996c27": {
        "name": "Read embedding",
        "imports": [],
        "source": "export default function vector({ body }) {\n  const v = body?.data?.[0]?.embedding;\n  if (\n    !Array.isArray(v) ||\n    v.length !== 1536 ||\n    v.some((x) => typeof x !== \"number\" || !Number.isFinite(x))\n  )\n    throw Error(\"Invalid embedding\");\n  return { vector: v };\n}\n"
      },
      "n_f5552751c9f5ef37": {
        "name": "Prepare writing request",
        "imports": [],
        "source": "export default function prompt({ kind, text, draft, feedback, points }) {\n  return {\n    instruction:\n      kind === \"draft\"\n        ? `Write a professional business reply to this email summary, no more than 100 words. Return only the body.\\n${text}`\n        : `Review this email draft against the human feedback, keep it concise and within 100 words, and return only HTML using p, br, b, or i where useful.\\nDraft: ${draft}\\nFeedback: ${feedback}\\nOriginal summary: ${text}`,\n    context: JSON.stringify(points.map((x) => x.payload)),\n  };\n}\n"
      },
      "n_8bba2a33d8b047cf": {
        "name": "Return draft",
        "imports": [],
        "source": "export default function result({ text }) {\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Missing draft\");\n  return { response: { output: text } };\n}\n"
      }
    }
  },
