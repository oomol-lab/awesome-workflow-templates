      "n_ca7a5ab15f928c5b": {
        "name": "Process one example item",
        "imports": [],
        "source": "export default function step({state}) {\n  const visited=state ? [...state.visited] : [];\n  if (visited.length >= 10) throw Error('Invalid batch state');\n  visited.push(visited.length);\n  return {state:{visited},more:visited.length<10,message:visited.length===10?'No Items Left':''};\n}\n"
      }
