    "modules": {
      "n_22a4a24f6343b0c2": {
        "name": "Check user created event",
        "imports": [],
        "source": "export default function extractEvent({ body }) {\n  const topic = String(body?.topic ?? \"\").trim();\n  const item = body?.data?.item ?? {};\n  const userId = String(item?.id ?? \"\").trim();\n  const email = String(item?.email ?? \"\").trim();\n  const isUserCreated = topic === \"contact.user.created\" && Boolean(userId) && Boolean(email);\n  return {\n    isUserCreated,\n    userId,\n    email,\n  };\n}\n"
      },
      "n_0e60dfcf41e317eb": {
        "name": "Format Intercom contact payload",
        "imports": [],
        "source": "export default function prepareUpdate({ statusCode, response, userId, fallbackEmail }) {\n  const result = response && typeof response === \"object\" ? response.result : null;\n  if (statusCode < 200 || statusCode >= 300 || !result || typeof result !== \"object\") {\n    return {\n      found: false,\n      updateUrl: \"https://api.intercom.io/contacts\",\n      updateBody: {},\n    };\n  }\n  const profiles = Array.isArray(result.social_profiles)\n    ? result.social_profiles.map((p) => ({\n        type: \"social_profile\",\n        name: String(p?.network ?? \"\"),\n        url: String(p?.url ?? \"\"),\n      }))\n    : [];\n  const location = {\n    country: result.location?.country ?? null,\n    city: result.location?.city ?? null,\n    region: result.location?.region ?? null,\n  };\n  return {\n    found: true,\n    updateUrl: \"https://api.intercom.io/contacts/\" + encodeURIComponent(userId),\n    updateBody: {\n      email: String(result.current_work_email || fallbackEmail),\n      name: result.full_name ?? null,\n      phone: result.phone_numbers?.[0]?.E164 ?? null,\n      avatar: result.employment?.profile_pic_url ?? null,\n      social_profiles: profiles,\n      location,\n    },\n  };\n}\n"
      }
    }
