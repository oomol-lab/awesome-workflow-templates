        "jsCode": "const orgId = $(\"Validate organization\").item.json.orgId;\nif (!$json.id || String($json.org_id) !== orgId) throw Error(\"Inspect Pipedrive note\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "pipedrive-org-16",
