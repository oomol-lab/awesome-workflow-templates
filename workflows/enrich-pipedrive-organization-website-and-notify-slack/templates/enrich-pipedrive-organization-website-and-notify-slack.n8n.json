      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o = $(\"Validate organization\").item.json,\n  s = $(\"Choose organization step\").item.json.summary;\nif (!s) throw Error(\"Missing summary\");\nreturn {\n  json: { text: \"New Pipedrive organization: \" + o.orgName + \"\\n\\n\" + s },\n  pairedItem: { item: $itemIndex },\n};\n"
