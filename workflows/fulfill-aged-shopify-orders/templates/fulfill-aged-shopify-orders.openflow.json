    "modules": {
      "n_a2f896b2bf43e8c9": {
        "name": "Prepare Shopify orders page",
        "imports": [],
        "source": "const query =\n  'query Orders($after:String){orders(first:100,after:$after,query:\"status:open (fulfillment_status:unfulfilled OR fulfillment_status:partial)\"){edges{node{id createdAt fulfillmentOrders(first:1){edges{node{id status}}}}} pageInfo{hasNextPage endCursor}}}';\nexport default function page({ previous, store }) {\n  if (!/^[a-z0-9][a-z0-9-]*$/.test(store) || store === \"your-store\")\n    throw Error(\"Configure your Shopify store subdomain\");\n  return {\n    url: \"https://\" + store + \".myshopify.com/admin/api/2026-07/graphql.json\",\n    body: { query, variables: { after: previous?.cursor ?? null } },\n  };\n}\n"
      },
      "n_77799221b63af90a": {
        "name": "Collect orders",
        "imports": [],
        "source": "export default function collect({ previous, statusCode, body }) {\n  if (statusCode !== 200 || body?.errors?.length || !body?.data?.orders)\n    throw Error(\"Shopify orders query failed\");\n  const c = body.data.orders;\n  if (!Array.isArray(c.edges) || typeof c.pageInfo?.hasNextPage !== \"boolean\")\n    throw Error(\"Invalid Shopify page\");\n  const state = previous ?? { rows: [], seen: [] },\n    cursor = c.pageInfo.endCursor;\n  if (c.pageInfo.hasNextPage && (!cursor || state.seen.includes(cursor)))\n    throw Error(\"Invalid Shopify cursor\");\n  return {\n    state: {\n      rows: [...state.rows, ...c.edges.map((x) => x.node)],\n      seen: cursor ? [...state.seen, cursor] : state.seen,\n      cursor: cursor ?? null,\n    },\n    more: c.pageInfo.hasNextPage,\n  };\n}\n"
      },
      "n_a74f746b23a64429": {
        "name": "Reserve next fulfillment",
        "imports": [],
        "source": "const query =\n  \"mutation Fulfill($fulfillment:FulfillmentInput!){fulfillmentCreate(fulfillment:$fulfillment){fulfillment{id} userErrors{field message}}}\";\nexport default async function pick({ state, previous, acknowledge }, ctx) {\n  const old = await ctx.state.get(\"shopify-fulfill-pending\");\n  if (old) {\n    if (acknowledge !== old.fulfillmentOrderId)\n      throw Error(\"Inspect uncertain fulfillment \" + old.fulfillmentOrderId);\n    await ctx.state.set(\"shopify-fulfilled:\" + old.fulfillmentOrderId, true);\n    await ctx.state.set(\"shopify-fulfill-pending\", null);\n  }\n  for (let i = previous?.index ?? 0; i < state.rows.length; i++) {\n    const order = state.rows[i];\n    if (!order?.id || !Number.isFinite(Date.parse(order.createdAt))) throw Error(\"Invalid order\");\n    if (Date.now() - Date.parse(order.createdAt) <= 86400000) continue;\n    const fo = order.fulfillmentOrders?.edges?.[0]?.node;\n    if (!fo) continue;\n    if (!fo.id) throw Error(\"Missing fulfillment order ID\");\n    if (await ctx.state.get(\"shopify-fulfilled:\" + fo.id)) continue;\n    await ctx.state.set(\"shopify-fulfill-pending\", {\n      orderId: order.id,\n      fulfillmentOrderId: fo.id,\n    });\n    return {\n      more: true,\n      state: { index: i + 1 },\n      orderId: order.id,\n      fulfillmentOrderId: fo.id,\n      body: {\n        query,\n        variables: {\n          fulfillment: {\n            lineItemsByFulfillmentOrder: [{ fulfillmentOrderId: fo.id }],\n            notifyCustomer: true,\n          },\n        },\n      },\n    };\n  }\n  return {\n    more: false,\n    state: { index: state.rows.length },\n    orderId: \"\",\n    fulfillmentOrderId: \"\",\n    body: {},\n  };\n}\n"
      },
      "n_afb838283385eb3f": {
        "name": "Confirm fulfillment",
        "imports": [],
        "source": "export default async function confirm({ statusCode, body, state, fulfillmentOrderId }, ctx) {\n  const p = body?.data?.fulfillmentCreate;\n  if (\n    statusCode !== 200 ||\n    body?.errors?.length ||\n    !p ||\n    p.userErrors?.length ||\n    !p.fulfillment?.id\n  )\n    throw Error(\"Fulfillment result unknown or rejected; inspect Shopify\");\n  await ctx.state.set(\"shopify-fulfilled:\" + fulfillmentOrderId, true);\n  await ctx.state.set(\"shopify-fulfill-pending\", null);\n  return { state };\n}\n"
      }
    }
