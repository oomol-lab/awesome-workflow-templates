    {
      "name": "Validate fulfillment receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body,\n  p = b?.data?.fulfillmentCreate;\nif (\n  $json.statusCode !== 200 ||\n  b?.errors?.length ||\n  !p ||\n  p.userErrors?.length ||\n  !p.fulfillment?.id\n)\n  throw Error(\"Fulfillment result unknown or rejected; inspect Shopify\");\nreturn $input.item;\n"
      },
      "id": "fulfill-aged-shopify-orders-10",
      "position": [
