    {
      "name": "Create Shopify fulfillment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://' + $('Configure Shopify').first().json.store + '.myshopify.com/admin/api/2026-07/graphql.json' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {query:\"mutation Fulfill($fulfillment:FulfillmentInput!){fulfillmentCreate(fulfillment:$fulfillment){fulfillment{id} userErrors{field message}}}\",variables:{fulfillment:{lineItemsByFulfillmentOrder:[{fulfillmentOrderId:$(\"Select eligible fulfillment orders\").item.json.fulfillmentOrderId}],notifyCustomer:true}}} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "id": "fulfill-aged-shopify-orders-9",
