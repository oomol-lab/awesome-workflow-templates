    {
      "name": "Read unfulfilled orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://' + $('Configure Shopify').first().json.store + '.myshopify.com/admin/api/2026-07/graphql.json' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"query\":\"query Orders { orders(first:100,after:null,query:\\\"status:open (fulfillment_status:unfulfilled OR fulfillment_status:partial)\\\"){edges{node{id createdAt fulfillmentOrders(first:1){edges{node{id status}}}}} pageInfo{hasNextPage endCursor}} }\"}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "query",
                    "value": "={{ \"query Orders { orders(first:100,after:CURSOR,query:\\\"status:open (fulfillment_status:unfulfilled OR fulfillment_status:partial)\\\"){edges{node{id createdAt fulfillmentOrders(first:1){edges{node{id status}}}}} pageInfo{hasNextPage endCursor}} }\".replace(\"CURSOR\", JSON.stringify($response.body?.data?.orders?.pageInfo?.endCursor ?? null)) }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.data.orders.pageInfo.hasNextPage }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "id": "fulfill-aged-shopify-orders-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Select eligible fulfillment orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = $input.all(),\n  out = [];\nfor (const item of all) {\n  const b = item.json.body;\n  if (b.errors?.length || !b.data?.orders?.edges) throw Error(\"Shopify order query failed\");\n  for (const { node: o } of b.data.orders.edges) {\n    if (!o.id || !Number.isFinite(Date.parse(o.createdAt))) throw Error(\"Invalid order\");\n    if (Date.now() - Date.parse(o.createdAt) <= 86400000) continue;\n    const fo = o.fulfillmentOrders?.edges?.[0]?.node;\n    if (!fo) continue;\n    if (!fo.id) throw Error(\"Missing fulfillment order ID\");\n    out.push({ json: { orderId: o.id, fulfillmentOrderId: fo.id } });\n  }\n}\nreturn out;\n"
      },
      "id": "fulfill-aged-shopify-orders-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Loop orders",
      "type": "n8n-nodes-base.splitInBatches",
