    "modules": {
      "n_14b253485770eb64": {
        "name": "Read receipt file",
        "imports": [],
        "source": "export default function receipt({ body }) {\n  const file = body?.file;\n  if (\n    !file ||\n    typeof file.base64 !== \"string\" ||\n    !file.base64 ||\n    typeof file.name !== \"string\" ||\n    !file.name\n  )\n    throw Error(\"Telegram must provide a downloaded receipt\");\n  return { key: file.name, contentBase64: file.base64 };\n}\n"
      },
      "n_1a921c1dd8eea4ec": {
        "name": "Analyze receipt expense",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\n\nexport default async function textractSignedRequest(\n  { contentBase64, region, accessKeyId, secretAccessKey, sessionToken },\n  context,\n) {\n  if (typeof contentBase64 !== \"string\" || !contentBase64) throw new Error(\"Missing receipt bytes\");\n  if (typeof region !== \"string\" || !/^[a-z]{2}(?:-[a-z]+){1,2}-[0-9]+$/.test(region))\n    throw new Error(\"Configure a valid AWS region\");\n  const required = (value, name) => {\n    if (typeof value !== \"string\" || !value.trim())\n      throw new Error(\"Select the AWS \" + name + \" secret Variable\");\n    return value.trim();\n  };\n  const keyId = required(accessKeyId, \"access key ID\"),\n    secret = required(secretAccessKey, \"secret access key\");\n  if (sessionToken != null && typeof sessionToken !== \"string\")\n    throw new Error(\"The AWS session token must be text\");\n  const token = sessionToken?.trim() ?? \"\",\n    service = \"textract\",\n    host = service + \".\" + region + \".amazonaws.com\" + (region.startsWith(\"cn-\") ? \".cn\" : \"\");\n  const body = JSON.stringify({ Document: { Bytes: contentBase64 } }),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8);\n  const headers = {\n    \"content-type\": \"application/x-amz-json-1.1\",\n    host,\n    \"x-amz-date\": timestamp,\n    \"x-amz-target\": \"Textract.AnalyzeExpense\",\n    ...(token ? { \"x-amz-security-token\": token } : {}),\n  };\n  const names = Object.keys(headers).sort(),\n    signedHeaders = names.join(\";\"),\n    canonicalHeaders = names\n      .map((name) => name + \":\" + headers[name].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\");\n  const hash = (value) => createHash(\"sha256\").update(value).digest(\"hex\"),\n    hmac = (key, value) => createHmac(\"sha256\", key).update(value).digest();\n  const scope = date + \"/\" + region + \"/\" + service + \"/aws4_request\",\n    canonical = [\"POST\", \"/\", \"\", canonicalHeaders, signedHeaders, hash(body)].join(\"\\n\");\n  const toSign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\");\n  const signingKey = hmac(hmac(hmac(hmac(\"AWS4\" + secret, date), region), service), \"aws4_request\"),\n    signature = createHmac(\"sha256\", signingKey).update(toSign).digest(\"hex\");\n  delete headers.host;\n  headers.authorization =\n    \"AWS4-HMAC-SHA256 Credential=\" +\n    keyId +\n    \"/\" +\n    scope +\n    \", SignedHeaders=\" +\n    signedHeaders +\n    \", Signature=\" +\n    signature;\n  const response = await context.fetch(\"https://\" + host + \"/\", { method: \"POST\", headers, body });\n  if (!response.ok) throw new Error(\"Textract request failed\");\n  const result = await response.json();\n  if (!Array.isArray(result?.ExpenseDocuments)) throw new Error(\"Invalid Textract response\");\n  const fields = {};\n  for (const doc of result.ExpenseDocuments) {\n    if (!Array.isArray(doc.SummaryFields)) throw new Error(\"Invalid expense fields\");\n    for (const f of doc.SummaryFields) {\n      const name = f?.Type?.Text || f?.LabelDetection?.Text,\n        text = f?.ValueDetection?.Text;\n      if (typeof name !== \"string\" || typeof text !== \"string\")\n        throw new Error(\"Invalid expense field\");\n      fields[name] = text;\n    }\n  }\n  return { fields };\n}\n"
      },
      "n_36c44bc4df7eb314": {
        "name": "Select receipt fields",
        "imports": [],
        "source": "export default function fields({ summary, fieldNames }) {\n  const names = fieldNames\n    .split(\",\")\n    .map((s) => s.trim())\n    .filter(Boolean);\n  if (!names.length || names.some((n) => n.startsWith(\"YOUR_\")))\n    throw Error(\"Configure Airtable fields matching Textract summary keys\");\n  const mapped = {};\n  for (const name of names) if (summary[name] !== undefined) mapped[name] = summary[name];\n  if (!Object.keys(mapped).length) throw Error(\"No configured Textract fields were found\");\n  return { records: [{ fields: mapped }] };\n}\n"
      }
    }
