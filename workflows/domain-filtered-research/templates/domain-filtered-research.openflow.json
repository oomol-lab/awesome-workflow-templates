    "modules": {
      "n_6c95b1d8948cf582": {
        "name": "Prepare filtered research",
        "imports": [],
        "source": "export default function researchRequest({ user_prompt, system_prompt, domains }) {\n  if (typeof user_prompt !== \"string\" || !user_prompt.trim())\n    throw new Error(\"A research question is required.\");\n  if (typeof domains !== \"string\") throw new Error(\"Provide a comma-separated domain list.\");\n  const filters = domains\n    .split(\",\")\n    .map((domain) => domain.trim())\n    .filter(Boolean);\n  if (!filters.length) throw new Error(\"At least one search domain is required.\");\n  if (system_prompt != null && typeof system_prompt !== \"string\")\n    throw new Error(\"System instructions must be text.\");\n  return {\n    request: {\n      model: \"sonar\",\n      messages: [\n        {\n          role: \"system\",\n          content:\n            system_prompt?.trim() ||\n            \"Answer the question using retrieved sources. Cite sources and distinguish facts from uncertainty.\",\n        },\n        { role: \"user\", content: user_prompt.trim() },\n      ],\n      temperature: 0.2,\n      top_p: 0.9,\n      search_domain_filter: filters,\n      search_recency_filter: \"month\",\n      return_images: false,\n      top_k: 0,\n      stream: false,\n      presence_penalty: 0,\n      frequency_penalty: 1,\n    },\n  };\n}\n"
      },
      "n_605c2d8cf8b2a746": {
        "name": "Read answer and citations",
        "imports": [],
        "source": "export default function researchResult({ response }) {\n  const answer = response?.choices?.[0]?.message?.content;\n  if (typeof answer !== \"string\" || !answer.trim())\n    throw new Error(\"Perplexity returned no answer text.\");\n  const citations = response.citations ?? [];\n  if (!Array.isArray(citations) || citations.some((citation) => typeof citation !== \"string\"))\n    throw new Error(\"Perplexity citations must be a string array.\");\n  return { output: answer, citations };\n}\n"
      }
    }
  },
