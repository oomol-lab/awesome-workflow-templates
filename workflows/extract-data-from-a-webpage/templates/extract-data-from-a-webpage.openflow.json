    "modules": {
      "n_7eeee80b33d89f90": {
        "name": "Validate URL and fields",
        "imports": [],
        "source": "export default function ({ body }) {\n  const url = body?.url;\n  if (typeof url !== \"string\" || !/^https?:\\/\\//i.test(url)) throw Error(\"Provide an HTTP(S) URL\");\n  return {\n    url,\n    fields:\n      typeof body.extract_fields === \"string\" && body.extract_fields\n        ? body.extract_fields\n        : \"price,features,description\",\n    name: typeof body.name === \"string\" ? body.name : \"\",\n  };\n}\n"
      },
      "n_7d725a213693a725": {
        "name": "Read webpage text",
        "imports": [],
        "source": "export default function ({ body }) {\n  const html = typeof body === \"string\" ? body : \"\";\n  const text = html\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .slice(0, 4000);\n  if (!text) throw Error(\"Empty webpage\");\n  return { text };\n}\n"
      },
      "n_01a64996a026db0d": {
        "name": "Prepare JSON response",
        "imports": [],
        "source": "export default function ({ result }) {\n  return { body: JSON.stringify(result) };\n}\n"
      }
