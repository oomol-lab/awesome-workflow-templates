    "modules": {
      "n_0eb56dc8b827185d": {
        "name": "Read the alert",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const a = body?.attributes;\n  if (!a || typeof a !== \"object\" || typeof a.resolved !== \"boolean\" || a.id == null)\n    throw Error(\"Invalid Syncro alert\");\n  const alias = String(a.id),\n    trigger = a.properties?.trigger;\n  if (!alias || alias.length > 512 || typeof trigger !== \"string\")\n    throw Error(\"Missing alert ID or trigger\");\n  const relevant = trigger === \"agent_offline_trigger\";\n  if (!relevant || a.resolved)\n    return {\n      relevant,\n      resolved: a.resolved,\n      alias,\n      message: \"not applicable\",\n      description: \"not applicable\",\n    };\n  const name = a.computer_name,\n    customer = a.customer?.business_then_name,\n    details = a.formatted_output;\n  if ([name, customer, details].some((x) => typeof x !== \"string\" || !x))\n    throw Error(\"Missing alert details\");\n  const message = name + \" (\" + customer + \"): \" + details,\n    description = String(body.text ?? \"\") + \"\\n\" + String(body.link ?? \"\");\n  if (message.length > 130 || description.length > 15000)\n    throw Error(\"Alert exceeds Opsgenie limits\");\n  return { relevant: true, resolved: a.resolved, alias, message, description };\n}\n"
      }
    }
