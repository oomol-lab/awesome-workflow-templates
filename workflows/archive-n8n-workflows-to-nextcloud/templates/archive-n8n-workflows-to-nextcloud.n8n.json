{
  "name": "Archive n8n Workflows to Nextcloud",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "archive-n8n-workflows-to-nextcloud-0"
    },
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        220,
        0
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "custom",
              "cronExpression": "* */6 * * *"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "archive-n8n-workflows-to-nextcloud-1"
    },
    {
      "name": "List workflows",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "id": "archive-n8n-workflows-to-nextcloud-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "One workflow at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "archive-n8n-workflows-to-nextcloud-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Get workflow details",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "get",
        "workflowId": "={{ $('One workflow at a time').item.json.id }}"
      },
      "id": "archive-n8n-workflows-to-nextcloud-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Verify workflow details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const expected = $(\"One workflow at a time\").item.json;\nif ($json.id !== expected.id || $json.name !== expected.name) throw Error(\"Workflow mismatch\");\nreturn { json: $json };\n"
      },
      "id": "archive-n8n-workflows-to-nextcloud-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Backup not attempted",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}"
            }
          ]
        }
      },
      "id": "archive-n8n-workflows-to-nextcloud-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Backup already confirmed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "done"
            }
          ]
        }
      },
      "id": "archive-n8n-workflows-to-nextcloud-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Backup pending",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "id": "archive-n8n-workflows-to-nextcloud-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Reserve backup",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "archive-n8n-workflows-to-nextcloud-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Reserve overwrite",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "archive-n8n-workflows-to-nextcloud-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Restore workflow details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return $(\"Verify workflow details\").item;\n"
      },
      "id": "archive-n8n-workflows-to-nextcloud-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Move Binary Data",
      "type": "n8n-nodes-base.moveBinaryData",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "mode": "jsonToBinary",
        "options": {
          "useRawData": false
        }
      },
      "typeVersion": 1,
      "id": "archive-n8n-workflows-to-nextcloud-12"
    },
    {
      "name": "NextCloud1",
      "type": "n8n-nodes-base.nextCloud",
      "position": [
        2860,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "path": "={{ '/YOUR_FOLDER/' + $('One workflow at a time').item.json.name.replace(/[\\/\\\\]/g,'_') + '-' + $('One workflow at a time').item.json.id + '.json' }}",
        "binaryDataUpload": true,
        "binaryPropertyName": "data"
      },
      "typeVersion": 1,
      "alwaysOutputData": true,
      "id": "archive-n8n-workflows-to-nextcloud-13"
    },
    {
      "name": "Confirm backup",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'nextcloud-workflow:' + $('One workflow at a time').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "archive-n8n-workflows-to-nextcloud-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Stop for pending backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "throw Error(\"Inspect pending Nextcloud upload before retrying\");\n"
      },
      "id": "archive-n8n-workflows-to-nextcloud-15",
      "position": [
        3300,
        0
      ]
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "List workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron": {
      "main": [
        [
          {
            "node": "List workflows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List workflows": {
      "main": [
        [
          {
            "node": "One workflow at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get workflow details": {
      "main": [
        [
          {
            "node": "Verify workflow details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backup not attempted": {
      "main": [
        [
          {
            "node": "Reserve backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backup already confirmed": {
      "main": [
        [
          {
            "node": "Reserve overwrite",
