            "index": 0
          }
        ]
      ]
    },
    "Backup pending": {
      "main": [
        [
          {
            "node": "Stop for pending backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve backup": {
      "main": [
        [
          {
            "node": "Restore workflow details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve overwrite": {
      "main": [
        [
          {
            "node": "Restore workflow details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Restore workflow details": {
      "main": [
        [
          {
            "node": "Move Binary Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Move Binary Data": {
      "main": [
        [
          {
            "node": "NextCloud1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "NextCloud1": {
      "main": [
        [
          {
            "node": "Confirm backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm backup": {
      "main": [
        [
          {
            "node": "One workflow at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify workflow details": {
      "main": [
        [
          {
            "node": "Backup not attempted",
            "type": "main",
            "index": 0
          },
          {
            "node": "Backup already confirmed",
            "type": "main",
            "index": 0
          },
          {
            "node": "Backup pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One workflow at a time": {
      "main": [
        [],
        [
          {
            "node": "Get workflow details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
