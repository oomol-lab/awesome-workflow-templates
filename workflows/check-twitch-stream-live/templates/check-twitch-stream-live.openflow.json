    "modules": {
      "n_a47e5c799d0b1012": {
        "name": "Prepare the lookup",
        "imports": [],
        "source": "export default function prepare({login,clientId}){if(!login.trim()||!clientId.trim())throw Error('Enter a Twitch login and client ID');return{url:'https://api.twitch.tv/helix/streams?user_login='+encodeURIComponent(login.trim()),headers:{'Client-Id':clientId.trim()}}}\n"
      },
      "n_d9b1e5536a7a39e4": {
        "name": "Interpret the result",
        "imports": [],
        "source": "export default function normalize({response}){if(!response||!Array.isArray(response.data)||response.data.length>1)throw Error('Unexpected Twitch response');const x=response.data[0];if(!x)return{online:false,stream:null};if(typeof x.id!=='string'||typeof x.viewer_count!=='number'||typeof x.title!=='string'||typeof x.type!=='string'||typeof x.game_id!=='string')throw Error('Unexpected Twitch stream');return{online:true,stream:{id:x.id,viewersCount:x.viewer_count,title:x.title,type:x.type,game:x.game_id?{id:x.game_id}:null}}}\n"
      }
    }
