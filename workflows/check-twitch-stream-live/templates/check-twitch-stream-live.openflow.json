    "modules": {
      "n_a47e5c799d0b1012": {
        "name": "Prepare the lookup",
        "imports": [],
        "source": "export default function prepare({ login, clientId }) {\n  if (!login.trim() || !clientId.trim()) throw Error(\"Enter a Twitch login and client ID\");\n  return {\n    url: \"https://api.twitch.tv/helix/streams?user_login=\" + encodeURIComponent(login.trim()),\n    headers: { \"Client-Id\": clientId.trim() },\n  };\n}\n"
      },
      "n_d9b1e5536a7a39e4": {
        "name": "Interpret the result",
        "imports": [],
        "source": "export default function normalize({ response }) {\n  if (!response || !Array.isArray(response.data) || response.data.length > 1)\n    throw Error(\"Unexpected Twitch response\");\n  const x = response.data[0];\n  if (!x) return { online: false, stream: null };\n  if (\n    typeof x.id !== \"string\" ||\n    typeof x.viewer_count !== \"number\" ||\n    typeof x.title !== \"string\" ||\n    typeof x.type !== \"string\" ||\n    typeof x.game_id !== \"string\"\n  )\n    throw Error(\"Unexpected Twitch stream\");\n  return {\n    online: true,\n    stream: {\n      id: x.id,\n      viewersCount: x.viewer_count,\n      title: x.title,\n      type: x.type,\n      game: x.game_id ? { id: x.game_id } : null,\n    },\n  };\n}\n"
      }
    }
