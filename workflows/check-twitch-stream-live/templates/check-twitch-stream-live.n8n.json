        "content": "we need only to check the value of `stream` if `null` to know if the user offline. Any value will denote the user is online"
      },
      "typeVersion": 1
    },
    {
      "id": "check-twitch-stream-live-7",
      "name": "Map stream response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        400
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const data = item.json.data;\n  if (!Array.isArray(data) || data.length > 1) throw new Error(\"Unexpected Twitch response\");\n  const x = data[0];\n  if (\n    x &&\n    (typeof x.id !== \"string\" ||\n      typeof x.viewer_count !== \"number\" ||\n      typeof x.title !== \"string\" ||\n      typeof x.type !== \"string\" ||\n      typeof x.game_id !== \"string\")\n  )\n    throw new Error(\"Unexpected Twitch stream\");\n  return {\n    json: {\n      data: {\n        user: {\n          stream: x\n            ? {\n                id: x.id,\n                viewersCount: x.viewer_count,\n                title: x.title,\n                type: x.type,\n                game: x.game_id ? { id: x.game_id } : null,\n              }\n            : null,\n        },\n      },\n    },\n  };\n});\n"
      }
    }
