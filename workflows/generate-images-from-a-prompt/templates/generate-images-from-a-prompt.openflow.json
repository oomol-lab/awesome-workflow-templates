    "modules": {
      "n_d12630c9906a901d": {
        "name": "Create image files",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function files({ body }, context) {\n  if (!Array.isArray(body?.data) || !body.data.length) throw Error(\"No generated images\");\n  const files = [];\n  for (const [i, item] of body.data.entries()) {\n    if (typeof item.b64_json !== \"string\" || !item.b64_json) throw Error(\"Missing image data\");\n    const chunks = [];\n    let size = 0;\n    for (let offset = 0; offset < item.b64_json.length; offset += 131072) {\n      const c = Buffer.from(item.b64_json.slice(offset, offset + 131072), \"base64\");\n      chunks.push(c);\n      size += c.length;\n    }\n    if (!size) throw Error(\"Empty image\");\n    const bytes = new Uint8Array(size);\n    let at = 0;\n    for (const c of chunks) {\n      bytes.set(c, at);\n      at += c.length;\n    }\n    files.push(\n      await context.artifact.put(bytes, { name: `generated-${i + 1}.png`, mediaType: \"image/png\" }),\n    );\n  }\n  return { files };\n}\n"
      }
    }
