    "modules": {
      "n_5e27406d69ecc848": {
        "name": "List workflow pages",
        "imports": [],
        "source": "export default async function pages({ previous }, context) {\n  const s = previous ?? { items: [], cursor: null, seen: [] };\n  const r = await context.actions.call(\"n8n.list_workflows\", {\n    limit: 100,\n    ...(s.cursor ? { cursor: s.cursor } : {}),\n  });\n  if (!Array.isArray(r?.data)) throw Error(\"Invalid n8n workflow page\");\n  const c = r.nextCursor;\n  if (c !== null && (typeof c !== \"string\" || !c || s.seen.includes(c)))\n    throw Error(\"Invalid or repeated workflow cursor\");\n  return {\n    state: { items: s.items.concat(r.data), cursor: c, seen: c ? [...s.seen, c] : s.seen },\n    more: c !== null,\n  };\n}\n"
      },
      "n_3c645a9563d2fb41": {
        "name": "Select workflow",
        "imports": [],
        "source": "export default function next({ state, previous }) {\n  const index = previous?.index ?? 0,\n    items = state?.items;\n  if (!Array.isArray(items)) throw Error(\"Missing workflow list\");\n  if (index >= items.length) return { state: { index }, more: false, id: \"\", name: \"\" };\n  const x = items[index];\n  if (typeof x?.id !== \"string\" || !x.id || typeof x?.name !== \"string\" || !x.name)\n    throw Error(\"Invalid workflow\");\n  return { state: { index: index + 1 }, more: true, id: x.id, name: x.name };\n}\n"
      },
      "n_1b9c5bec2239387f": {
        "name": "Get workflow details",
        "imports": [],
        "source": "export default async function workflow({ id }, context) {\n  const w = await context.actions.call(\"n8n.get_workflow\", { workflowId: id });\n  if (\n    !w ||\n    w.id !== id ||\n    typeof w.name !== \"string\" ||\n    !Array.isArray(w.nodes) ||\n    typeof w.connections !== \"object\" ||\n    !w.connections\n  )\n    throw Error(\"Invalid n8n workflow\");\n  return { workflow: w };\n}\n"
      },
      "n_b55048602c95a433": {
        "name": "Reserve Drive backup",
        "imports": [],
        "source": "export default async function prepare(\n  { id, name, workflow, folder, acknowledge, resolution },\n  ctx,\n) {\n  if (\n    !id ||\n    !name ||\n    !folder ||\n    folder.includes(\"YOUR_\") ||\n    workflow?.id !== id ||\n    workflow?.name !== name\n  )\n    throw Error(\"Workflow details or folder mismatch\");\n  const date = new Date().toISOString().slice(0, 10),\n    key = \"workflow-backup:\" + date + \":\" + id,\n    old = await ctx.state.get(key),\n    filename = name.replace(/[\\/\\\\\\x00-\\x1f]/g, \"_\") + \"-\" + id + \".json\",\n    base = {\n      key,\n      write: false,\n      name: filename,\n      parents: [folder],\n      text: JSON.stringify(workflow, null, 2),\n    };\n  if (old?.status === \"done\") return base;\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect Drive pending \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return base;\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { ...base, write: true };\n}\n"
      },
      "n_5aa3a5d3dbf4eaca": {
        "name": "Confirm Drive backup",
        "imports": [],
        "source": "export default async function f({ key, id }, ctx) {\n  if (!id) throw Error(\"Unknown Drive upload\");\n  await ctx.state.set(key, { status: \"done\", fileId: id });\n  return { ok: true };\n}\n"
      }
    }
  },
