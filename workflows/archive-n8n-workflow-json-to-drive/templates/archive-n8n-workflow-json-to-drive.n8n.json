{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "archive-n8n-workflow-json-to-drive-0"
    },
    {
      "name": "Run Daily at 2:30am",
      "type": "n8n-nodes-base.cron",
      "position": [
        220,
        0
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 2,
              "minute": 30
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "archive-n8n-workflow-json-to-drive-1"
    },
    {
      "name": "List workflows",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "id": "archive-n8n-workflow-json-to-drive-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "One workflow at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "archive-n8n-workflow-json-to-drive-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Get workflow details",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "parameters": {
        "resource": "workflow",
        "operation": "get",
        "workflowId": "={{ $('One workflow at a time').item.json.id }}"
      },
      "id": "archive-n8n-workflow-json-to-drive-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Verify workflow details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const expected = $(\"One workflow at a time\").item.json;\nif ($json.id !== expected.id || $json.name !== expected.name) throw Error(\"Workflow mismatch\");\nreturn { json: $json };\n"
      },
      "id": "archive-n8n-workflow-json-to-drive-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Backup not attempted",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'workflow-backup:' + $now.toFormat('yyyy-MM-dd') + ':' + $('One workflow at a time').item.json.id }}"
            }
          ]
        }
      },
      "id": "archive-n8n-workflow-json-to-drive-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Backup already completed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'workflow-backup:' + $now.toFormat('yyyy-MM-dd') + ':' + $('One workflow at a time').item.json.id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "done"
            }
          ]
        }
      },
      "id": "archive-n8n-workflow-json-to-drive-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Backup pending",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'workflow-backup:' + $now.toFormat('yyyy-MM-dd') + ':' + $('One workflow at a time').item.json.id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "id": "archive-n8n-workflow-json-to-drive-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Stop for pending backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "throw Error(\"Inspect pending Drive upload before retrying\");\n"
      },
      "id": "archive-n8n-workflow-json-to-drive-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Reserve Drive backup",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'workflow-backup:' + $now.toFormat('yyyy-MM-dd') + ':' + $('One workflow at a time').item.json.id }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "archive-n8n-workflow-json-to-drive-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Restore workflow details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return $(\"Verify workflow details\").item;\n"
      },
      "id": "archive-n8n-workflow-json-to-drive-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Move Binary Data",
      "type": "n8n-nodes-base.moveBinaryData",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "mode": "jsonToBinary",
        "options": {
          "useRawData": false
        }
      },
      "typeVersion": 1,
      "id": "archive-n8n-workflow-json-to-drive-12"
    },
    {
      "name": "Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        2860,
        0
      ],
      "parameters": {
        "name": "={{ $('One workflow at a time').item.json.name.replace(/[\\/\\\\]/g,'_') + '-' + $('One workflow at a time').item.json.id + '.json' }}",
        "parents": [
          "YOUR_DRIVE_FOLDER_ID"
        ],
        "binaryData": true,
        "resolveData": true
      },
      "typeVersion": 1,
      "id": "archive-n8n-workflow-json-to-drive-13"
    },
    {
      "name": "Verify Drive result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id) throw Error(\"Unknown Drive upload\");\nreturn { json: { ok: true } };\n"
      },
      "id": "archive-n8n-workflow-json-to-drive-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Confirm Drive backup",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Reserve Drive backup').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "archive-n8n-workflow-json-to-drive-15",
      "position": [
        3300,
        0
      ]
    }
  ],
