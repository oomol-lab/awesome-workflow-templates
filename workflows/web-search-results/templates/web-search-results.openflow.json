    "modules": {
      "n_9d4a64015f0b50d3": {
        "name": "Validate search query",
        "imports": [],
        "source": "export default function ({ query }) {\n  if (typeof query !== \"string\" || !query.trim()) throw new Error(\"Enter a nonempty search query.\");\n  return { query: query.trim() };\n}\n"
      },
      "n_ee8784f01de5c1fc": {
        "name": "Read titles, links and snippets",
        "imports": [],
        "source": "export default function ({ results }) {\n  if (!Array.isArray(results) || results.length > 5)\n    throw new Error(\"Expected at most five Tavily search results.\");\n  return {\n    results: results.map((result) => {\n      if (\n        !result ||\n        typeof result !== \"object\" ||\n        Array.isArray(result) ||\n        typeof result.title !== \"string\" ||\n        typeof result.url !== \"string\" ||\n        typeof result.content !== \"string\"\n      )\n        throw new Error(\"A search result is missing its title, URL or snippet.\");\n      return { title: result.title, url: result.url, snippet: result.content };\n    }),\n  };\n}\n"
      }
    }
