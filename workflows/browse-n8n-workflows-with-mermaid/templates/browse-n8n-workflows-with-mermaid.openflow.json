    "modules": {
      "n_00ad01579aef7f0d": {
        "name": "Choose list or diagram",
        "imports": [],
        "source": "export default function plan({ query }) {\n  const id = query?.wfid == null ? \"\" : String(query.wfid);\n  if (id && !/^[A-Za-z0-9_-]+$/.test(id)) throw Error(\"Invalid workflow ID\");\n  return { workflowId: id || \"placeholder\", detail: !!id };\n}\n"
      },
      "n_62ec6d8d87303681": {
        "name": "Collect workflow pages",
        "imports": [],
        "source": "export default function collect({ data, nextCursor, previous }) {\n  const s = previous ?? { items: [], cursors: [] };\n  if (!Array.isArray(data) || !Array.isArray(s.items) || !Array.isArray(s.cursors))\n    throw Error(\"Invalid workflow list\");\n  const items = [\n      ...s.items,\n      ...data.map((w) => ({ id: String(w.id), name: String(w.name ?? \"\") })),\n    ],\n    cursor = nextCursor ?? null;\n  if (items.length > 10000) throw Error(\"Too many workflows\");\n  if (cursor !== null && (typeof cursor !== \"string\" || !cursor || s.cursors.includes(cursor)))\n    throw Error(\"Invalid workflow cursor\");\n  return {\n    more: cursor !== null,\n    cursor,\n    state: { items, cursors: cursor ? [...s.cursors, cursor] : s.cursors },\n  };\n}\n"
      },
      "n_0b1a2d77b066e314": {
        "name": "Render dashboard or diagram",
        "imports": [],
        "source": "export default function render({ detail, state, workflow, baseUrl }) {\n  if (detail) {\n    const w = workflow,\n      nodes = w.nodes.filter((x) => x.type !== \"n8n-nodes-base.stickyNote\"),\n      ids = new Map(nodes.map((x, i) => [x.name, \"N\" + i])),\n      labels = new Map(\n        nodes.map((x) => [\n          x.name,\n          String(x.name ?? \"\").replace(/[^\\w\\s-]/g, (c) => \"#\" + c.codePointAt(0) + \";\"),\n        ]),\n      ),\n      byName = new Map(nodes.map((x) => [x.name, x])),\n      shape = (name) => {\n        const id = ids.get(name),\n          label = '\\\"' + labels.get(name) + '\\\"',\n          type = byName.get(name)?.type;\n        return type === \"n8n-nodes-base.if\" || type === \"n8n-nodes-base.switch\"\n          ? id + \"{\" + label + \"}\"\n          : type === \"n8n-nodes-base.code\" || type === \"n8n-nodes-base.executeWorkflow\"\n            ? id + \"[[\" + label + \"]]\"\n            : type === \"n8n-nodes-base.wait\"\n              ? id + \"(\" + label + \")\"\n              : id + \"[\" + label + \"]\";\n      },\n      lines = [],\n      used = new Set();\n    for (const [from, groups] of Object.entries(w.connections ?? {})) {\n      if (!ids.has(from)) continue;\n      for (const [kind, outs] of Object.entries(groups ?? {}))\n        for (const edges of outs ?? [])\n          for (const e of edges ?? []) {\n            if (!ids.has(e.node)) continue;\n            lines.push(\n              shape(from) +\n                \" \" +\n                (kind === \"main\" ? \"-->\" : \"-.->|\" + String(kind).replace(/[^\\w-]/g, \"\") + \"|\") +\n                \" \" +\n                shape(e.node),\n            );\n            used.add(from);\n            used.add(e.node);\n          }\n    }\n    for (const n of nodes) if (!used.has(n.name)) lines.push(shape(n.name));\n    for (const n of nodes) if (n.disabled) lines.push(\"class \" + ids.get(n.name) + \" disabled\");\n    if (nodes.some((n) => n.disabled))\n      lines.push(\"classDef disabled stroke-dasharray: 5 5,opacity:0.5\");\n    return { body: \"flowchart LR\\n\" + lines.join(\"\\n\"), contentType: \"text/plain; charset=utf-8\" };\n  }\n  if (typeof baseUrl !== \"string\" || !/^https:\\/\\//.test(baseUrl) || baseUrl.includes(\"YOUR_\"))\n    throw Error(\"Configure n8n instance URL\");\n  const base = JSON.stringify(baseUrl.replace(/\\/+$/, \"\"))\n    .replace(/</g, \"\\\\u003c\")\n    .replace(/&/g, \"\\\\u0026\");\n  const data = JSON.stringify(state.items).replace(/</g, \"\\\\u003c\").replace(/&/g, \"\\\\u0026\");\n  return {\n    body: `<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>n8n workflows</title><script src=\"https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js\"></script><style>body{font:16px system-ui;max-width:960px;margin:3rem auto;padding:0 1rem}article{border:1px solid #ddd;border-radius:8px;margin:1rem 0;padding:1rem}button{padding:.5rem}</style></head><body><h1>n8n workflows</h1><main id=\"workflows\"></main><script>const workflows=${data},instanceUrl=${base};mermaid.initialize({startOnLoad:false,securityLevel:'strict'});const root=document.getElementById('workflows');for(const workflow of workflows){const card=document.createElement('article'),title=document.createElement('h2'),link=document.createElement('a'),button=document.createElement('button'),diagram=document.createElement('div');link.textContent=workflow.name;link.href=instanceUrl+'/workflow/'+encodeURIComponent(workflow.id);link.target='_blank';link.rel='noopener noreferrer';title.append(link);button.textContent='Show workflow';button.onclick=async()=>{if(diagram.dataset.loaded){diagram.hidden=!diagram.hidden;return}const url=new URL(location.href);url.search='';url.searchParams.set('wfid',workflow.id);const r=await fetch(url);if(!r.ok){diagram.textContent='Unable to load workflow';return}diagram.className='mermaid';diagram.textContent=await r.text();await mermaid.run({nodes:[diagram]});diagram.dataset.loaded='1'};card.append(title,button,diagram);root.append(card)}</script></body></html>`,\n    contentType: \"text/html; charset=utf-8\",\n  };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
