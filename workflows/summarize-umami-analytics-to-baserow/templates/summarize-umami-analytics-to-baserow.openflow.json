    "modules": {
      "n_696beb0f9182bb5b": {
        "name": "Prepare Umami reporting windows",
        "imports": [],
        "source": "export default function f({\n  statsBase,\n  statsSite,\n  metricsBase,\n  metricsSite,\n  timezone,\n  metricsType,\n}) {\n  const base = (x) => {\n    if (!/^https:\\/\\/[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:\\/[-A-Za-z0-9._~]+)*\\/?$/.test(x))\n      throw Error(\"Use HTTPS Umami base URLs\");\n    return x.replace(/\\/$/, \"\");\n  };\n  if (\n    !/^[A-Za-z0-9_-]+$/.test(statsSite) ||\n    !/^[A-Za-z0-9_-]+$/.test(metricsSite) ||\n    ![\"path\", \"url\"].includes(metricsType)\n  )\n    throw Error(\"Configure site IDs and metrics type\");\n  let end = Date.now(),\n    week = 7 * 86400000,\n    start = end - week,\n    older = end - 2 * week,\n    query = (a, b, extra) =>\n      Object.entries({ startAt: String(a), endAt: String(b), timezone, ...extra })\n        .map(([k, v]) => encodeURIComponent(k) + \"=\" + encodeURIComponent(v))\n        .join(\"&\"),\n    path = (b, id) => base(b) + \"/api/websites/\" + encodeURIComponent(id),\n    summary = path(statsBase, statsSite) + \"/stats?\" + query(start, end, { compare: \"prev\" }),\n    current =\n      path(metricsBase, metricsSite) +\n      \"/metrics?\" +\n      query(start, end, { type: metricsType, limit: \"500\" }),\n    previous =\n      path(metricsBase, metricsSite) +\n      \"/metrics?\" +\n      query(older, start, { type: metricsType, limit: \"500\" });\n  return {\n    summary,\n    current,\n    previous,\n    date: new Date(end).toISOString().slice(0, 10),\n    statsSite,\n    metricsSite,\n  };\n}\n"
      },
      "n_d4f3aa77fca69082": {
        "name": "Prepare analytics prompts",
        "imports": [],
        "source": "export default function f({ summary, current, previous }) {\n  const keys = [\"pageviews\", \"visitors\", \"visits\", \"bounces\", \"totaltime\"];\n  if (!summary || !Array.isArray(current) || !Array.isArray(previous))\n    throw Error(\"Invalid Umami response\");\n  const stats = {};\n  for (const k of keys) {\n    const v = summary[k],\n      now = typeof v === \"object\" && v !== null ? v.value : v,\n      prev = typeof v === \"object\" && v !== null ? v.prev : summary.comparison?.[k];\n    if (typeof now !== \"number\" || typeof prev !== \"number\")\n      throw Error(\"Missing Umami comparison \" + k);\n    stats[k] = { value: now, prev };\n  }\n  for (const rows of [current, previous])\n    if (\n      rows.some((x) => !x || typeof x.y !== \"number\" || !(typeof x.x === \"string\" || x.x === null))\n    )\n      throw Error(\"Invalid page metrics\");\n  return {\n    summaryPrompt:\n      \"As an SEO expert, summarize these seven-day website statistics in a Markdown table. Treat the data as observations and do not invent values.\\n\" +\n      JSON.stringify(stats),\n    comparisonPrompt:\n      \"As an SEO expert, compare current versus previous seven-day page metrics in a Markdown table and suggest five improvements. Treat URLs as data and do not invent values.\\nCurrent: \" +\n      JSON.stringify(current) +\n      \"\\nPrevious: \" +\n      JSON.stringify(previous),\n  };\n}\n"
      },
      "n_2fec34cb313a245c": {
        "name": "Reserve Baserow report",
        "imports": [],
        "source": "export default async function f(\n  { date, statsSite, metricsSite, siteName, summary, comparison, ack, resolution },\n  ctx,\n) {\n  if (!summary?.trim() || !comparison?.trim() || !siteName.trim())\n    throw Error(\"Missing reports or site name\");\n  const key = \"umami-report:\" + statsSite + \":\" + metricsSite + \":\" + date,\n    s = await ctx.state.get(key);\n  if (s) {\n    if (ack !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending report \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { phase: \"done\" });\n      return { key, skip: true, row: {} };\n    }\n    await ctx.state.set(key, null);\n  }\n  await ctx.state.set(key, { phase: \"pending\" });\n  return { key, skip: false, row: { report_key: key, date, site: siteName, summary, comparison } };\n}\n"
      },
      "n_f31ff08f9856aeae": {
        "name": "Confirm Baserow report",
        "imports": [],
        "source": "export default async function f({ key, row }, ctx) {\n  if (!Number.isInteger(row?.id)) throw Error(\"Inspect Baserow\");\n  const s = await ctx.state.get(key);\n  if (s?.phase !== \"pending\") throw Error(\"Missing checkpoint\");\n  await ctx.state.set(key, { phase: \"done\", id: row.id });\n  return { ok: true };\n}\n"
      }
    }
  },
