    "modules": {
      "n_ac61b02bea18f03f": {
        "name": "Prepare community profile URL",
        "imports": [],
        "source": "export default function profileRequest({ owner, repo }) {\n  if (typeof owner !== 'string' || !owner || typeof repo !== 'string' || !repo) throw new Error('Configure the repository owner and name');\n  return { endpoint: '/repos/' + encodeURIComponent(owner) + '/' + encodeURIComponent(repo) + '/community/profile' };\n}\n"
      },
      "n_dd1c682c17bde7df": {
        "name": "Read community health result",
        "imports": [],
        "source": "export default function profileResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding != null || !body || typeof body !== 'object' || Array.isArray(body) || typeof body.health_percentage !== 'number' || !Number.isFinite(body.health_percentage) || body.health_percentage < 0 || body.health_percentage > 100) throw new Error('GitHub did not return a completed community profile response');\n  return { profile: body };\n}\n"
      }
    }
