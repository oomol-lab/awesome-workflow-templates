    "modules": {
      "n_0c7b1293cae12058": {
        "name": "Read the course answers",
        "imports": [],
        "source": "export default function feedback({ response }) {\n  const fields = response?.definition?.fields,\n    answers = response?.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers))\n    throw Error(\"Expected a complete Typeform response\");\n  const field = (title) => {\n    const f = fields.filter((x) => x?.title === title);\n    if (f.length !== 1 || typeof f[0].id !== \"string\" || !f[0].id)\n      throw Error(\"Expected one \" + title + \" question\");\n    return f[0].id;\n  };\n  const ratingId = field(\"How useful was the course?\"),\n    opinionId = field(\"Your opinion on the course:\"),\n    ratings = answers.filter((x) => x?.field?.id === ratingId),\n    opinions = answers.filter((x) => x?.field?.id === opinionId);\n  if (\n    ratings.length !== 1 ||\n    ratings[0].type !== \"number\" ||\n    typeof ratings[0].number !== \"number\" ||\n    !Number.isFinite(ratings[0].number) ||\n    opinions.length > 1\n  )\n    throw Error(\"Invalid course feedback\");\n  if (opinions.length && !(opinions[0].type === \"text\" && typeof opinions[0].text === \"string\"))\n    throw Error(\"Invalid opinion\");\n  const usefulness = ratings[0].number,\n    opinion = opinions[0]?.text ?? \"\";\n  return { positive: usefulness >= 3, usefulness, opinion, values: [[usefulness, opinion]] };\n}\n"
      },
      "n_3517d98f39677eae": {
        "name": "Confirm positive append",
        "imports": [],
        "source": "export default function confirm({ updatedRows }) {\n  if (updatedRows !== 1) throw Error(\"Sheet append not confirmed\");\n  return {};\n}\n"
      },
      "n_61f974738ffdf9da": {
        "name": "Confirm negative append",
        "imports": [],
        "source": "export default function confirm({ updatedRows }) {\n  if (updatedRows !== 1) throw Error(\"Sheet append not confirmed\");\n  return {};\n}\n"
      }
    }
