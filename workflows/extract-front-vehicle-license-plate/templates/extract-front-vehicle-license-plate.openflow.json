    "modules": {
      "n_3addd2635196ad0d": {
        "name": "Prepare vision request",
        "imports": [],
        "source": "export default function request({ body }) {\n  const fileId = String(body.fileId || \"\");\n  if (!/^file-[A-Za-z0-9_-]+$/.test(fileId)) throw Error(\"Expected an OpenAI image file ID\");\n  return {\n    request: {\n      model: \"gpt-4o-mini\",\n      input: [\n        {\n          role: \"user\",\n          content: [\n            {\n              type: \"input_text\",\n              text: \"Extract the license plate on the front-most car. Return only the characters. If unreadable, return UNREADABLE.\",\n            },\n            { type: \"input_image\", file_id: fileId, detail: \"auto\" },\n          ],\n        },\n      ],\n    },\n  };\n}\n"
      },
      "n_ce1375eb840614c9": {
        "name": "Return extracted plate",
        "imports": [],
        "source": "export default function parse({ body }) {\n  if (body?.status !== \"completed\" || !Array.isArray(body.output))\n    throw Error(\"Vision response incomplete\");\n  const parts = body.output\n    .flatMap((x) => (Array.isArray(x.content) ? x.content : []))\n    .filter((x) => x.type === \"output_text\")\n    .map((x) => x.text)\n    .filter((x) => typeof x === \"string\");\n  const text = parts.join(\"\\n\").trim();\n  if (!text) throw Error(\"No plate returned\");\n  return { body: JSON.stringify({ text }) };\n}\n"
      }
    }
  },
