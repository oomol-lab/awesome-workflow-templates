{
  "name": "Extract Front Vehicle License Plate",
  "tags": [],
  "nodes": [
    {
      "id": "extract-front-vehicle-license-plate-0",
      "name": "FromTrigger",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {},
        "formTitle": "Read license plate",
        "formFields": {
          "values": [
            {
              "fieldType": "file",
              "fieldLabel": "Image",
              "requiredField": true,
              "acceptFileTypes": ".jpg, .png"
            }
          ]
        },
        "responseMode": "lastNode",
        "formDescription": "Upload a JPG or PNG image."
      },
      "typeVersion": 2.2
    },
    {
      "id": "extract-front-vehicle-license-plate-1",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "position": [
        220,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "1b8381dc-5b9a-42a2-8a67-cc706b433180",
              "name": "model",
              "type": "string",
              "value": "openai/gpt-4o"
            },
            {
              "id": "72aec130-ab56-4e61-b60b-9a31dd8d02e6",
              "name": "prompt",
              "type": "string",
              "value": "Extract the number of the license plate on the front-most car depicted in the attached image and return only the extracted characters without any other text or structure."
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "name": "Choose vision mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const mode = \"direct\";\nif (!$binary?.Image) throw Error(\"Missing image\");\nreturn { json: { ...$json, mode, submissionId: $execution.id }, binary: $binary };\n"
      },
      "id": "extract-front-vehicle-license-plate-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.mode === 'relay' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "extract-front-vehicle-license-plate-3",
      "position": [
        660,
        0
      ]
    },
    {
      "id": "extract-front-vehicle-license-plate-4",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        880,
        0
      ],
      "parameters": {
        "text": "={{ $json.prompt }}",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "Image"
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.5
    },
    {
      "id": "extract-front-vehicle-license-plate-5",
      "name": "OpenRouter LLM",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "model": "={{ $json.model }}",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Image not uploaded",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'plate-image:' + $('Choose vision mode').first().json.submissionId }}"
            }
          ]
        }
      },
      "id": "extract-front-vehicle-license-plate-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Reserve image upload",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'plate-image:' + $('Choose vision mode').first().json.submissionId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "extract-front-vehicle-license-plate-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Restore image binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $(\"Choose vision mode\").first();\nif (!item.binary?.Image) throw Error(\"Missing image\");\nreturn { json: {}, binary: { Image: item.binary.Image } };\n"
      },
      "id": "extract-front-vehicle-license-plate-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Upload image artifact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/files",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "purpose",
              "value": "vision"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "Image"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-front-vehicle-license-plate-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Verify image artifact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!/^file-[A-Za-z0-9_-]+$/.test($json.id ?? \"\")) throw Error(\"Unknown image upload\");\nreturn { json: { fileId: $json.id } };\n"
      },
      "id": "extract-front-vehicle-license-plate-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Forward image file ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fileId:$json.fileId} }}",
        "options": {}
      },
      "id": "extract-front-vehicle-license-plate-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Verify relay result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.text !== \"string\" || !$json.text.trim()) throw Error(\"Missing vision result\");\nreturn { json: { text: $json.text } };\n"
      },
      "id": "extract-front-vehicle-license-plate-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Confirm image processing",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Reserve image upload').first().json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "extract-front-vehicle-license-plate-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Show relay result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { text: $(\"Verify relay result\").first().json.text } };\n"
      },
      "id": "extract-front-vehicle-license-plate-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "id": "extract-front-vehicle-license-plate-15",
      "name": "FormResultPage",
      "type": "n8n-nodes-base.form",
      "position": [
        3300,
        0
      ],
      "parameters": {
        "options": {
          "formTitle": ""
        },
        "operation": "completion",
        "completionTitle": "Extracted information",
        "completionMessage": "={{ $json.text }}"
      },
      "typeVersion": 1
    }
  ],
  "active": false,
