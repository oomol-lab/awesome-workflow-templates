            "n_bd60b84d4f09776c": {
              "name": "Choose the next message",
              "imports": [],
              "source": "export default function next({events,previous}){const s=previous??{index:0};if(!Array.isArray(events))throw Error('Invalid Gmail events');if(s.index>=events.length)return{state:s,more:false,messageId:'',context:''};const e=events[s.index];if(!e||typeof e.messageId!=='string'||!e.messageId)throw Error('Missing Gmail message ID');return{state:{index:s.index+1},more:true,messageId:e.messageId,context:JSON.stringify(e)}}\n"
            },
            "kvdp8zvq8s": {
              "name": "Run one message agent",
              "imports": [],
              "source": "export default async function call({messageId,context},api){try{await api.workflows.call('label-one-message',{messageId,context});return{status:'completed'}}catch(error){if(error?.code==='workflow.canceled')throw error;return{status:'failed'}}}\n"
            }
          }
