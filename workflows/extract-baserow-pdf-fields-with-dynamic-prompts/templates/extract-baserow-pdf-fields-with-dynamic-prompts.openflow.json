    "modules": {
      "n_c20a174bcd965a15": {
        "name": "Select next prompted field",
        "imports": [],
        "source": "export default function ({ fields, previous, answer }) {\n  if (!Array.isArray(fields)) throw Error(\"Expected fields\");\n  let i = previous?.i ?? 0,\n    updates = previous?.updates ?? {};\n  if (previous) {\n    if (typeof answer !== \"string\" || !answer.trim()) throw Error(\"Empty model output\");\n    updates = { ...updates, [fields[i - 1].name]: answer.trim() };\n  }\n  if (i >= fields.length)\n    return { state: { i, updates }, more: false, description: \"\", type: \"\", name: \"\" };\n  const f = fields[i];\n  if (\n    !f ||\n    typeof f.name !== \"string\" ||\n    !f.name ||\n    typeof f.description !== \"string\" ||\n    !f.description ||\n    typeof f.type !== \"string\" ||\n    !f.type\n  )\n    throw Error(\"Invalid field definition\");\n  return {\n    state: { i: i + 1, updates },\n    more: true,\n    description: f.description,\n    type: f.type,\n    name: f.name,\n  };\n}\n"
      },
      "n_77ae4d32b633aacf": {
        "name": "Reserve row update",
        "imports": [],
        "source": "export default async function ({ tableId, rowId, updates }, ctx) {\n  if (\n    !Number.isSafeInteger(tableId) ||\n    tableId < 1 ||\n    !Number.isSafeInteger(rowId) ||\n    rowId < 1 ||\n    !updates ||\n    !Object.keys(updates).length\n  )\n    throw Error(\"Invalid update\");\n  const key = \"baserow-pdf:\" + tableId + \":\" + rowId;\n  if (await ctx.state.get(key)) throw Error(\"Uncertain prior update: inspect Baserow row\");\n  await ctx.state.set(key, { status: \"pending\", updates });\n  return {\n    key,\n    url:\n      \"https://api.baserow.io/api/database/rows/table/\" +\n      tableId +\n      \"/\" +\n      rowId +\n      \"/?user_field_names=true\",\n    body: updates,\n  };\n}\n"
      },
      "n_ec06af08e8811dd6": {
        "name": "Confirm row update",
        "imports": [],
        "source": "export default async function ({ key, rowId, body }, ctx) {\n  if (!body || body.id !== rowId) throw Error(\"Missing Baserow row receipt\");\n  await ctx.state.set(key, null);\n  return { done: true };\n}\n"
      },
      "n_6e9e75fb9ee79615": {
        "name": "Return row receipt",
        "imports": [],
        "source": "export default function ({ done }) {\n  return { response: { done } };\n}\n"
      }
    }
