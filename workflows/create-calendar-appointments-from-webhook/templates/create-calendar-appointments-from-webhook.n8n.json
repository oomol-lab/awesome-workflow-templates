{
  "name": "Create Calendar Appointments from a Webhook",
  "tags": [],
  "nodes": [
    {
      "id": "create-calendar-appointments-from-webhook-0",
      "name": "n8n_appointment",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -340,
        280
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-request",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "typeVersion": 2,
      "disabled": true
    },
    {
      "name": "Validate appointment request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body;\nif (!/^[A-Za-z0-9_-]{1,100}$/.test(b?.requestId || \"\") || !b.email || !b.appointmentDate)\n  throw Error(\"Valid request ID, email and date required\");\nreturn $input.all();\n"
      },
      "id": "create-calendar-appointments-from-webhook-1"
    },
    {
      "id": "create-calendar-appointments-from-webhook-2",
      "name": "Concert start date",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -80,
        280
      ],
      "parameters": {
        "text": "=Convert this date to a compatible format for Google Calendar APIs for the start date, and for the end date add 1 hour to the start date. Date: {{ $json.body.appointmentDate }}",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.6
    },
    {
      "id": "create-calendar-appointments-from-webhook-3",
      "name": "OpenAI Chat Model3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        -120,
        480
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "create-calendar-appointments-from-webhook-4",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        140,
        480
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"start\": {\n\t\t\t\"type\": \"string\"\n\t\t},\n\t\t\"end\": {\n\t\t\t\"type\": \"string\"\n\t\t}\n\t}\n}"
      },
      "typeVersion": 1.2
    },
    {
      "name": "Read appointment checkpoint",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'appointment:' + $('n8n_appointment').first().json.body.requestId }}"
            }
          ]
        }
      },
      "alwaysOutputData": true,
      "id": "create-calendar-appointments-from-webhook-5"
    },
    {
      "name": "Check appointment checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input.all();\nif (a.length !== 1) throw Error(\"Duplicate checkpoint\");\nconst s = a[0].json.status;\nif (s && s !== \"done\") throw Error(\"Inspect pending appointment before retry\");\nreturn [{ json: { done: s === \"done\" }, pairedItem: { item: 0 } }];\n"
      },
      "id": "create-calendar-appointments-from-webhook-6"
    },
    {
      "name": "Appointment confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "create-calendar-appointments-from-webhook-7"
    },
    {
      "name": "Reserve appointment",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'appointment:' + $('n8n_appointment').first().json.body.requestId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "create-calendar-appointments-from-webhook-8"
    },
    {
      "name": "Restore parsed date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $(\"Concert start date\").first().json.output;\nconst start = Date.parse(a?.start);\nif (!Number.isFinite(start)) throw Error(\"Invalid date\");\nreturn [\n  {\n    json: {\n      output: {\n        start: new Date(start).toISOString(),\n        end: new Date(start + 3600000).toISOString(),\n      },\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "id": "create-calendar-appointments-from-webhook-9"
    },
    {
      "id": "create-calendar-appointments-from-webhook-10",
      "name": "Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        300,
        280
      ],
      "parameters": {
        "end": "={{ $json.output.end }}",
        "start": "={{ $json.output.start }}",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_CALENDAR_ID"
        },
        "additionalFields": {
          "summary": "=Event title with {{ $('n8n_appointment').first().json.body.email }}",
          "description": "Event description"
        }
      },
      "typeVersion": 1.3
    },
    {
      "name": "Validate event receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (!$json.id) throw Error(\"Unknown Calendar result\");\nreturn $input.all();\n"
      },
      "id": "create-calendar-appointments-from-webhook-11"
    },
    {
      "name": "Confirm appointment",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'appointment:' + $('n8n_appointment').first().json.body.requestId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "create-calendar-appointments-from-webhook-12"
    },
