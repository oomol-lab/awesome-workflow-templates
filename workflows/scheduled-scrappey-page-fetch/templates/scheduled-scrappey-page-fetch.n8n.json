      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1280,
        240
      ],
      "parameters": {
        "url": "https://publisher.scrappey.com/api/v1",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({cmd: \"request.get\", url: $json.url}) }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "scheduled-scrappey-page-fetch-validate",
      "name": "Validate the page URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function setup({ url }) {\n  if (\n    typeof url !== \"string\" ||\n    !/^https?:\\/\\/[^\\/?#@\\s]+(?:[\\/?#][^\\s]*)?$/i.test(url) ||\n    url.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure an HTTP or HTTPS page URL without credentials\");\n  return { body: { cmd: \"request.get\", url } };\n}\n\nsetup({ url: $input.first().json.url });\nreturn $input.all();\n"
      }
    }
  ],
