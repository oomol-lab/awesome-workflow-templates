        "name": "Configure the page URL",
        "imports": [],
        "source": "export default function setup({ url }) {\n  if (\n    typeof url !== \"string\" ||\n    !/^https?:\\/\\/[^\\/?#@\\s]+(?:[\\/?#][^\\s]*)?$/i.test(url) ||\n    url.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure an HTTP or HTTPS page URL without credentials\");\n  return { body: { cmd: \"request.get\", url } };\n}\n"
      }
