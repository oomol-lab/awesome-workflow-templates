    "modules": {
      "n_43dd04703406d7e5": {
        "name": "Build morning context",
        "imports": [],
        "source": "export default function buildContext({ tasks, timezone }) {\n  if (!Array.isArray(tasks) || !tasks.every((task) => typeof task === 'string' && task.trim())) {\n    throw new Error('tasks must be a list of non-empty strings');\n  }\n  const date = new Date().toLocaleDateString('en-US', {\n    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: timezone,\n  });\n  const taskList = tasks.join('\\n- ');\n  return {\n    date,\n    tasks: taskList,\n    prompt: `Today is ${date}.\\n\\nMy tasks for today:\\n- ${taskList}\\n\\nPlease give me a motivating, concise morning brief (3-5 sentences) that:\\n1. Acknowledges today's date/day\\n2. Highlights the key priorities\\n3. Ends with one actionable focus tip`,\n  };\n}\n"
      },
      "n_ecd10232efa13b13": {
        "name": "Format LINE message",
        "imports": [],
        "source": "export default function lineText({ summary }) {\n  if (typeof summary !== 'string' || !summary.trim()) throw new Error('The model returned no morning brief');\n  const text = '🌅 Morning Brief\\n\\n' + summary;\n  if (text.length > 5000) throw new Error('The morning brief exceeds the LINE message limit');\n  return { texts: [text] };\n}\n"
      }
    }
