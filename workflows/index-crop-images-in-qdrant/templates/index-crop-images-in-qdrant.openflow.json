    "modules": {
      "n_c7b8feeafbddf9b7": {
        "name": "Prepare collection paths",
        "imports": [],
        "source": "export default function f({ collection }) {\n  if (!/^[A-Za-z0-9_-]+$/.test(collection)) throw Error(\"Invalid collection name\");\n  const path = \"/collections/\" + encodeURIComponent(collection);\n  return {\n    exists: path + \"/exists\",\n    collection: path,\n    index: path + \"/index\",\n    points: path + \"/points\",\n    create: { vectors: { voyage: { size: 1024, distance: \"Cosine\" } } },\n    indexBody: { field_name: \"crop_name\", field_schema: \"keyword\" },\n  };\n}\n"
      },
      "n_155f39bb6943a9d7": {
        "name": "Check collection response",
        "imports": [],
        "source": "export default function f({ status, body }) {\n  if (status !== 200 || typeof body?.result?.exists !== \"boolean\")\n    throw Error(\"Collection check failed\");\n  return { exists: body.result.exists };\n}\n"
      },
      "n_571e7c2d39949d0a": {
        "name": "Confirm collection creation",
        "imports": [],
        "source": "export default function f({ status, body }) {\n  if (status < 200 || status >= 300 || body?.result !== true)\n    throw Error(\"Collection creation uncertain; inspect and retry\");\n  return { ok: true };\n}\n"
      },
      "n_b2a3ee4d306edd93": {
        "name": "Confirm crop index",
        "imports": [],
        "source": "export default function f({ status, body }) {\n  if (status < 200 || status >= 300 || !body?.result) throw Error(\"Inspect Qdrant index\");\n  return { ok: true };\n}\n"
      },
      "n_80c1c69fedcf804a": {
        "name": "List the next image page",
        "imports": [],
        "source": "export default async function list({ bucket, prefix, previous }, ctx) {\n  const state = previous ?? { pageToken: \"\", done: false };\n  if (state.done) return { state, items: [], more: false };\n  if (!/^[a-z0-9][a-z0-9._-]{1,220}$/.test(bucket)) throw Error(\"Set bucket\");\n  const credential = await ctx.actions.call(\"gcloud_sts.get_federated_access_token\", {}),\n    access = credential?.accessToken;\n  if (typeof access !== \"string\" || !access) throw Error(\"Cloud Storage access token missing\");\n  const u = new URL(\n    \"https://storage.googleapis.com/storage/v1/b/\" + encodeURIComponent(bucket) + \"/o\",\n  );\n  u.searchParams.set(\"prefix\", prefix);\n  u.searchParams.set(\"maxResults\", \"4\");\n  if (state.pageToken) u.searchParams.set(\"pageToken\", state.pageToken);\n  const r = await ctx.fetch(u.href, { headers: { authorization: \"Bearer \" + access } });\n  if (!r.ok) throw Error(\"Cloud Storage listing failed\");\n  const data = await r.json();\n  if (data.items != null && !Array.isArray(data.items)) throw Error(\"Invalid object list\");\n  const items = (data.items ?? [])\n    .filter((x) => typeof x.name === \"string\" && /\\.(jpe?g|png|webp)$/i.test(x.name))\n    .map((x) => {\n      const parts = x.name.split(\"/\");\n      const crop = parts.at(-2)?.toLowerCase();\n      if (!crop) throw Error(\"Missing crop directory\");\n      return {\n        crop,\n        url:\n          \"https://storage.googleapis.com/\" +\n          encodeURIComponent(bucket) +\n          \"/\" +\n          parts.map(encodeURIComponent).join(\"/\"),\n        name: x.name,\n      };\n    })\n    .filter((x) => x.crop !== \"tomato\");\n  return {\n    state: { pageToken: data.nextPageToken ?? \"\", done: !data.nextPageToken },\n    items,\n    more: !!data.nextPageToken || items.length > 0,\n  };\n}\n"
      },
      "n_6649ce2323c9fe70": {
        "name": "Embed crop images with Voyage",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async function embed({ items, key }, ctx) {\n  if (!Array.isArray(items) || !key) throw Error(\"Configure Voyage key\");\n  if (!items.length) return { points: [] };\n  const r = await ctx.fetch(\"https://api.voyageai.com/v1/multimodalembeddings\", {\n    method: \"POST\",\n    headers: { authorization: \"Bearer \" + key, \"content-type\": \"application/json\" },\n    body: JSON.stringify({\n      inputs: items.map((x) => ({ content: [{ type: \"image_url\", image_url: x.url }] })),\n      model: \"voyage-multimodal-3\",\n      input_type: \"document\",\n    }),\n  });\n  if (!r.ok) throw Error(\"Voyage embedding failed\");\n  const data = await r.json();\n  if (!Array.isArray(data.data) || data.data.length !== items.length)\n    throw Error(\"Wrong embedding count\");\n  const ordered = [...data.data].sort((a, b) => a.index - b.index);\n  const points = ordered.map((x, i) => {\n    if (\n      x.index !== i ||\n      !Array.isArray(x.embedding) ||\n      x.embedding.length !== 1024 ||\n      x.embedding.some((n) => !Number.isFinite(n))\n    )\n      throw Error(\"Invalid embedding\");\n    let h = createHash(\"sha256\").update(items[i].url).digest(\"hex\");\n    h = h.slice(0, 12) + \"5\" + h.slice(13, 16) + \"8\" + h.slice(17, 32);\n    return {\n      id: `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20, 32)}`,\n      vector: { voyage: x.embedding },\n      payload: { crop_name: items[i].crop, image_path: items[i].url },\n    };\n  });\n  return { points };\n}\n"
      },
      "n_c3198cc464fb2998": {
        "name": "Prepare named vector points",
        "imports": [],
        "source": "export default function f({ points }) {\n  return { body: { points }, has: points.length > 0 };\n}\n"
      },
      "n_4301b6a0390bd071": {
        "name": "Confirm image points",
        "imports": [],
        "source": "export default function f({ status, body }) {\n  if (status < 200 || status >= 300 || body?.result?.status !== \"completed\")\n    throw Error(\"Qdrant write uncertain; rerun same dataset\");\n  return { ok: true };\n}\n"
      }
    }
