    "modules": {
      "n_392fc4493593a620": {
        "name": "Reserve invoice lines",
        "imports": [],
        "source": "export default async function ({ body }, ctx) {\n  const { messageId, attachmentId, fileName, lines, last } = body;\n  if (\n    typeof messageId !== \"string\" ||\n    !messageId ||\n    typeof attachmentId !== \"string\" ||\n    !attachmentId ||\n    typeof fileName !== \"string\" ||\n    !Array.isArray(lines) ||\n    !lines.length ||\n    typeof last !== \"boolean\"\n  )\n    throw Error(\"Invalid reviewed invoice payload\");\n  const key = \"cradl:\" + messageId + \":\" + attachmentId,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect spreadsheet before retrying this attachment\");\n  if (s?.status !== \"done\") await ctx.state.set(key, { status: \"pending\" });\n  return {\n    expected: lines.length,\n    key,\n    skip: s?.status === \"done\",\n    last,\n    messageId,\n    values: lines.map((line, i) => [messageId, fileName, i + 1, JSON.stringify(line)]),\n  };\n}\n"
      },
      "n_ff08f2a333fe416d": {
        "name": "Confirm invoice lines",
        "imports": [],
        "source": "export default async function ({ key, updatedRows, expected }, ctx) {\n  if (updatedRows !== expected) throw Error(\"Unknown spreadsheet append outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_b9fe3f8b1cd27552": {
        "name": "Reserve read status",
        "imports": [],
        "source": "export default async function ({ messageId }, ctx) {\n  const key = \"cradl-read:\" + messageId,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect Gmail before retrying read status\");\n  if (s?.status === \"done\") return { key, skip: true, ids: [messageId] };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, skip: false, ids: [messageId] };\n}\n"
      },
      "n_048aff743c550288": {
        "name": "Confirm read status",
        "imports": [],
        "source": "export default async function ({ key }, ctx) {\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
