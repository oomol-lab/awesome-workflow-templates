        "options": {},
        "operation": "download"
      },
      "typeVersion": 3
    },
    {
      "name": "Hash original video",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "data",
        "dataPropertyName": "originalHash",
        "encoding": "hex"
      },
      "id": "publish-drive-reels-to-instagram-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Fetch public video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ $('Get video metadata').item.json.webContentLink }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "publish-drive-reels-to-instagram-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Hash public video",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "data",
        "dataPropertyName": "publicHash",
        "encoding": "hex"
      },
      "id": "publish-drive-reels-to-instagram-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Verify public video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $(\"Get video metadata\").item.json,\n  hash = $(\"Hash original video\").item.json.originalHash;\nif (\n  !m.id ||\n  !m.name ||\n  !/^video\\//.test(m.mimeType || \"\") ||\n  !/^https:\\/\\//.test(m.webContentLink || \"\") ||\n  !hash ||\n  hash !== $json.publicHash ||\n  !/^video\\//.test($(\"Fetch public video\").item.binary?.data?.mimeType || \"\")\n)\n  throw Error(\"Public video bytes unavailable or differ from Drive original\");\nreturn {\n  json: {\n    fileId: m.id,\n    fileName: m.name,\n    videoUrl: m.webContentLink,\n    thumbnailUrl: m.thumbnailLink || \"\",\n  },\n};\n"
      },
      "id": "publish-drive-reels-to-instagram-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "id": "publish-drive-reels-to-instagram-10",
      "name": "AI Caption generated by OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=Generate a clear Instagram caption under 150 characters with a call to action and relevant hashtags for this video filename: {{ $('Verify public video').item.json.fileName }}"
            }
          ]
        },
        "simplify": false
      },
      "typeVersion": 1.8
    },
    {
      "name": "Prepare Reel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $(\"Verify public video\").item.json,\n  c = $json.choices?.[0]?.message?.content;\nif (!c) throw Error(\"Missing caption\");\nreturn { json: { ...v, caption: c, mode: \"direct\" } };\n"
      },
      "id": "publish-drive-reels-to-instagram-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Use Open Flow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.mode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
