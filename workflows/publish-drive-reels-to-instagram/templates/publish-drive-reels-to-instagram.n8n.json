    {
      "name": "Choose Reel step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((i) => i.json)\n  .filter((x) => x.item_key);\nif (rows.length > 1) throw Error(\"Duplicate state\");\nconst v = $(\"Prepare Reel\").first().json;\nlet s = rows.length ? JSON.parse(rows[0].payload) : v,\n  stage = rows.length ? rows[0].status : \"new\";\nif (s.fileId !== v.fileId || s.videoUrl !== v.videoUrl || s.fileName !== v.fileName)\n  throw Error(\"Video details changed\");\nif (stage.startsWith(\"pending-\")) throw Error(\"Inspect pending write\");\nreturn [{ json: { stage, payload: s } }];\n"
      },
      "id": "publish-drive-reels-to-instagram-16",
      "position": [
        3520,
        0
      ]
    },
    {
      "name": "Route Reel step",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "new",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "new"
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "ready-sheet",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ready-sheet"
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "ready-create",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ready-create"
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "ready-status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ready-status"
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "ready-publish",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "ready-publish"
            },
            {
              "conditions": {
                "options": {
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.stage }}",
                    "rightValue": "done",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "done"
            }
          ]
        },
        "options": {}
      },
