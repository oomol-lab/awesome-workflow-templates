        440,
        0
      ]
    },
    {
      "name": "Select file ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $json.id || $json.body?.fileId;\nif (!id) throw Error(\"Missing file ID\");\nreturn { json: { id } };\n"
      },
      "id": "publish-drive-reels-to-instagram-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Get video metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ 'https://www.googleapis.com/drive/v3/files/'+encodeURIComponent($json.id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,mimeType,webContentLink,thumbnailLink"
            }
          ]
        },
        "options": {}
      },
      "id": "publish-drive-reels-to-instagram-4",
      "position": [
        880,
        0
      ]
