    {
      "id": "publish-drive-reels-to-instagram-5",
      "name": "Post File Download in N8N (Google Drive Node)",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "id",
