    {
      "name": "Filter leaderboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const creators = $(\"stats_aggregate_creators\").first().json.body;\nconst workflows = $json.body;\nconst username = $(\"When Executed by Another Workflow\").first().json.username;\nif (!username || !Array.isArray(creators) || !Array.isArray(workflows))\n  throw Error(\"Invalid username or leaderboard\");\nconst creator = creators\n  .sort((a, b) => (b.sum_unique_weekly_inserters || 0) - (a.sum_unique_weekly_inserters || 0))\n  .slice(0, 25)\n  .find((x) => x.user?.username === username);\nconst selected = workflows\n  .sort((a, b) => (b.unique_weekly_inserters || 0) - (a.unique_weekly_inserters || 0))\n  .slice(0, 300)\n  .filter((x) => x.user?.username === username);\nreturn [\n  {\n    json: {\n      creator: creator || null,\n      workflows: creator\n        ? selected.map((x) => ({\n            template_url: x.template_url,\n            wf_detais: x.wf_detais,\n            unique_weekly_inserters: x.unique_weekly_inserters,\n            unique_monthly_inserters: x.unique_monthly_inserters,\n            unique_weekly_visitors: x.unique_weekly_visitors,\n            unique_monthly_visitors: x.unique_monthly_visitors,\n          }))\n        : [],\n    },\n  },\n];\n"
      },
      "id": "get-n8n-creator-leaderboard-statistics-3",
      "position": [
        660,
        0
      ]
    }
  ],
