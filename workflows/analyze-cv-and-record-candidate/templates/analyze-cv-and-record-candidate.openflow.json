    "modules": {
      "n_2ab1a31c4e914121": {
        "name": "Validate candidate",
        "imports": [],
        "source": "export default function ({ body }) {\n  for (const k of [\"submissionId\", \"name\", \"email\", \"text\"])\n    if (typeof body[k] !== \"string\" || !body[k].trim()) throw Error(\"Missing \" + k);\n  return { submissionId: body.submissionId, name: body.name, email: body.email, text: body.text };\n}\n"
      },
      "n_cbb9807f26eec73e": {
        "name": "Reserve candidate row",
        "imports": [],
        "source": "export default async function ({ id, analysis, name, email }, ctx) {\n  let a = analysis;\n  if (typeof a === \"string\")\n    try {\n      a = JSON.parse(a);\n    } catch {\n      throw Error(\"Invalid candidate analysis\");\n    }\n  for (const k of [\"telephone\", \"city\", \"birthdate\", \"education\", \"history\", \"skills\", \"summary\"])\n    if (typeof a[k] !== \"string\") throw Error(\"Missing analysis \" + k);\n  const key = \"cv:\" + id,\n    p = await ctx.state.get(key);\n  if (p?.status === \"pending\") throw Error(\"Inspect sheet before retry\");\n  if (p?.status === \"done\") return { key, skip: true, values: [[name, email]] };\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    skip: false,\n    values: [\n      [\n        new Date().toISOString(),\n        name,\n        email,\n        a.telephone,\n        a.city,\n        a.birthdate,\n        a.education,\n        a.history,\n        a.skills,\n        a.summary,\n      ],\n    ],\n  };\n}\n"
      },
      "n_604c7dcf69e980f1": {
        "name": "Confirm candidate row",
        "imports": [],
        "source": "export default async function ({ key, updatedRows }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Unknown sheet append result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
