    {
      "id": "manage-github-hooks-and-notify-telegram-5",
      "name": "Fields",
      "type": "n8n-nodes-base.code",
      "position": [
        280,
        1180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body,\n  h = $json.headers ?? {},\n  type = h[\"x-github-event\"],\n  repo = b.repository?.full_name;\nif (!repo) throw Error(\"Missing repository\");\nif (type === \"push\") {\n  const c = b.commits?.[0];\n  if (!c) return null;\n  return {\n    json: {\n      text:\n        \"[GitHub push] \" +\n        repo +\n        \"\\n\" +\n        (c.author?.name ?? \"\") +\n        \"\\n\" +\n        (c.message ?? \"\") +\n        \"\\nModified: \" +\n        (c.modified ?? []).join(\", \") +\n        \"\\n\" +\n        (c.url ?? \"\"),\n    },\n  };\n}\nif (type === \"pull_request\") {\n  const p = b.pull_request;\n  if (!p) throw Error(\"Missing pull request\");\n  return {\n    json: {\n      text:\n        \"[GitHub pull request] \" +\n        repo +\n        \"\\n\" +\n        (b.action ?? \"\") +\n        \" #\" +\n        (p.number ?? b.number ?? \"\") +\n        \" \" +\n        (p.title ?? \"\") +\n        \"\\n\" +\n        (p.html_url ?? \"\"),\n    },\n  };\n}\nreturn null;\n"
      },
      "typeVersion": 2
    },
    {
