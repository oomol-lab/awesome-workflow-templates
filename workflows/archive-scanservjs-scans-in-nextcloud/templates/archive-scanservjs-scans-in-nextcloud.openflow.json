    "modules": {
      "n_eeac39bb5dbe7856": {
        "name": "Configure scanner and archive folder",
        "imports": [],
        "source": "function configuredUrl(input, service) {\n  const url = input.trim().replace(/\\/+$/, \"\");\n  if (!/^https?:\\/\\/[^/?#@]+(?:\\/[^?#]*)?$/i.test(url) || /\\.example\\.invalid(?:\\/|$)/.test(url)) {\n    throw new Error(\"Set a reachable \" + service + \" HTTP URL\");\n  }\n  return url;\n}\nexport default function configure({ scanBase, nextcloudFolder }) {\n  return {\n    listUrl: configuredUrl(scanBase, \"ScanServJS\") + \"/api/v1/files\",\n    archive: configuredUrl(nextcloudFolder, \"Nextcloud WebDAV folder\"),\n  };\n}\n"
      },
      "n_1bbfa42e7cb79ae9": {
        "name": "Match scan and archive paths",
        "imports": [],
        "source": "function scanName(name) {\n  if (\n    typeof name !== \"string\" ||\n    !/^[ \\p{L}\\p{N}._-]+$/u.test(name) ||\n    name === \".\" ||\n    name === \"..\"\n  ) {\n    throw new Error(\"ScanServJS returned an invalid file name\");\n  }\n  return name;\n}\nexport default function prepare({ listing, listUrl, archive }) {\n  if (!Array.isArray(listing)) throw new Error(\"ScanServJS did not return a file list\");\n  const files = listing.map((entry) => {\n    const name = scanName(entry?.name);\n    const segment = encodeURIComponent(name);\n    return { downloadUrl: listUrl + \"/\" + segment, archiveUrl: archive + \"/\" + segment };\n  });\n  return { files };\n}\n"
      },
      "n_5c4694bef68eed79": {
        "name": "Select next scan to download",
        "imports": [],
        "source": "export default function select({ files, previous }) {\n  const saved = previous ?? [];\n  const current = files[saved.length];\n  return {\n    more: current !== undefined,\n    downloadUrl: current?.downloadUrl ?? \"https://example.invalid/\",\n    archiveUrl: current?.archiveUrl ?? \"https://example.invalid/\",\n    saved,\n  };\n}\n"
      },
      "n_eb33d44e2ff60425": {
        "name": "Pair the file with its archive path",
        "imports": [],
