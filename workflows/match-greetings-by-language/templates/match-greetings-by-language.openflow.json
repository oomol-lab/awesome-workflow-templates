    "modules": {
      "n_9577a3cae5a02c1f": {
        "name": "Match by language",
        "imports": [],
        "source": "export default function match({ people, greetings }) {\n  return {\n    matches: people.flatMap((person) =>\n      person.language === undefined\n        ? []\n        : greetings\n            .filter((g) => g.language !== undefined && g.language === person.language)\n            .map((g) => ({ ...person, ...g })),\n    ),\n  };\n}\n"
      }
    }
