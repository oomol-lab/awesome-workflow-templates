{
  "nodes": [
    {
      "name": "Github Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "position": [
        260,
        410
      ],
      "parameters": {
        "owner": "YOUR_GITHUB_OWNER",
        "events": [
          "*"
        ],
        "repository": "YOUR_GITHUB_REPOSITORY"
      },
      "typeVersion": 1,
      "id": "receive-github-repository-events-0"
    },
    {
      "id": "receive-github-repository-events-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Github Trigger": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Receive GitHub Repository Events",
  "active": false,
  "pinData": {}
}
