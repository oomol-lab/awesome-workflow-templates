    "modules": {
      "n_be5d9a5b965e3abf": {
        "name": "Prepare project pipeline lookup",
        "imports": [],
        "source": "export default function pipelineRequest({ vcs, projectSlug, pipelineNumber }) {\n  if (!['github', 'bitbucket'].includes(vcs)) throw new Error('Choose GitHub or Bitbucket');\n  if (typeof projectSlug !== 'string') throw new Error('Project slug is required');\n  const parts = projectSlug.split('/');\n  if (parts.length !== 2 || parts.some((part) => !part.trim() || part === '.' || part === '..')) throw new Error('Use an organization/repository project slug');\n  if (!Number.isSafeInteger(pipelineNumber) || pipelineNumber < 1) throw new Error('A positive pipeline number is required');\n  return { endpoint: '/project/' + vcs + '/' + parts.map(encodeURIComponent).join('/') + '/pipeline/' + pipelineNumber };\n}\n"
      },
      "n_f59eeeb833d34a95": {
        "name": "Read pipeline result",
        "imports": [],
        "source": "export default function pipelineResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding) throw new Error('CircleCI did not return a pipeline (HTTP ' + statusCode + ')');\n  if (!body || typeof body !== 'object' || Array.isArray(body) || typeof body.id !== 'string' || !body.id || !Number.isInteger(body.number) || typeof body.state !== 'string') throw new Error('CircleCI returned an unexpected pipeline response');\n  return { pipeline: body };\n}\n"
      }
    }
