    "modules": {
      "n_06d58b325d263ed8": {
        "name": "Prepare consulting invoice",
        "imports": [],
        "source": "export default function prepare({ customer, itemId }) {\n  return {\n    customerRef: { value: customer.Id },\n    lines: [{ amount: 100, description: \"Consulting service\", item_ref: { value: itemId } }],\n  };\n}\n"
      },
      "n_a257d48ced98eb10": {
        "name": "Prepare invoice delivery",
        "imports": [],
        "source": "export default function prepare({ invoice, realm, environment }) {\n  const host =\n    environment === \"sandbox\"\n      ? \"https://sandbox-quickbooks.api.intuit.com\"\n      : \"https://quickbooks.api.intuit.com\";\n  return {\n    url: `${host}/v3/company/${encodeURIComponent(realm)}/invoice/${encodeURIComponent(invoice.Id)}/send`,\n  };\n}\n"
      }
    }
  },
