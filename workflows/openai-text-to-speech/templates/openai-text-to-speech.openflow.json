    "modules": {
      "n_1dfcc0a72c29193a": {
        "name": "Validate speech input",
        "imports": [],
        "source": "export default function prepareSpeech({ input_text, voice }) {\n  if (typeof input_text !== \"string\" || !input_text.trim())\n    throw new Error(\"Input text is required.\");\n  if (Array.from(input_text).length > 4096)\n    throw new Error(\"Input text must contain at most 4096 characters.\");\n  const selected = voice == null || voice === \"\" ? \"alloy\" : voice;\n  if (\n    ![\"alloy\", \"ash\", \"coral\", \"echo\", \"fable\", \"onyx\", \"nova\", \"sage\", \"shimmer\"].includes(\n      selected,\n    )\n  )\n    throw new Error(\"Choose a supported tts-1 voice.\");\n  return { input_text, voice: selected };\n}\n"
      },
      "n_d4aa114b1fbfda6b": {
        "name": "Save audio artifact",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\n\nexport default async function saveSpeech({ content_base64, content_type }, context) {\n  if (\n    typeof content_base64 !== \"string\" ||\n    !content_base64 ||\n    content_base64.length % 4 !== 0 ||\n    !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(content_base64)\n  )\n    throw new Error(\"The speech response does not contain valid base64 audio.\");\n  const mediaType =\n    typeof content_type === \"string\" ? content_type.split(\";\")[0].trim().toLowerCase() : \"\";\n  if (![\"audio/mpeg\", \"audio/mp3\", \"application/octet-stream\"].includes(mediaType))\n    throw new Error(\"The speech response is not MP3 audio.\");\n  const bytes = new Uint8Array(Buffer.from(content_base64, \"base64\"));\n  if (!bytes.length || Buffer.from(bytes).toString(\"base64\") !== content_base64)\n    throw new Error(\"The speech response is empty or has invalid base64 padding.\");\n  return {\n    audio: await context.artifact.put(bytes, { name: \"speech.mp3\", mediaType: \"audio/mpeg\" }),\n  };\n}\n"
      }
    }
