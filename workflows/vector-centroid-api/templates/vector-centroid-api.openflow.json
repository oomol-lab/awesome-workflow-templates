    "modules": {
      "n_8449dea7448dceb8": {
        "name": "Parse vectors query parameter",
        "imports": [],
        "source": "export default function vectorRequest({ query }) {\n  if (typeof query.vectors !== \"string\" || !query.vectors)\n    return { vectors: null, error: \"Invalid input: Expected an array of vectors.\" };\n  try {\n    let nonFinite = false;\n    const vectors = JSON.parse(query.vectors, (_key, value) => {\n      if (typeof value === \"number\" && !Number.isFinite(value)) nonFinite = true;\n      return value;\n    });\n    if (nonFinite) return { vectors: null, error: \"Vectors must contain finite numbers.\" };\n    return { vectors, error: null };\n  } catch {\n    return { vectors: null, error: \"Invalid input: vectors must be valid JSON.\" };\n  }\n}\n"
      },
      "n_d5d885f06d2590e8": {
        "name": "Validate and average coordinates",
        "imports": [],
        "source": "export default function vectorCentroid({ vectors, error }) {\n  const fail = (error) => ({ result: { error } });\n  if (error) return fail(error);\n  if (!Array.isArray(vectors) || vectors.length === 0)\n    return fail(\"Invalid input: Expected an array of vectors.\");\n  if (!vectors.every(Array.isArray)) return fail(\"Each vector must be an array.\");\n  const dimension = vectors[0].length;\n  if (!vectors.every((vector) => vector.length === dimension))\n    return fail(\"Vectors have inconsistent dimensions.\");\n  if (\n    !vectors.every((vector) =>\n      vector.every((value) => typeof value === \"number\" && Number.isFinite(value)),\n    )\n  )\n    return fail(\"Vectors must contain finite numbers.\");\n  const centroid = Array.from({ length: dimension }, (_, index) => {\n    let scale = 0;\n    for (const vector of vectors) scale = Math.max(scale, Math.abs(vector[index]));\n    if (scale === 0) return 0;\n    let sum = 0,\n      correction = 0;\n    for (const vector of vectors) {\n      const adjusted = vector[index] / scale - correction;\n      const next = sum + adjusted;\n      correction = next - sum - adjusted;\n      sum = next;\n    }\n    return (sum / vectors.length) * scale;\n  });\n  if (!centroid.every(Number.isFinite)) return fail(\"Centroid exceeds the finite numeric range.\");\n  return { result: { centroid } };\n}\n"
      }
    }
