    "modules": {
      "n_1639425f028e5d6c": {
        "name": "Prepare failure details",
        "imports": [],
        "source": "export default function prepare({workflow,execution,error}){if(typeof workflow?.name!=='string'||!workflow.name||typeof execution?.runId!=='string'||!execution.runId||typeof error?.message!=='string')throw Error('Missing failure details');const name=workflow.name.replace(/[\\r\\n]+/g,' '),v=x=>typeof x==='string'&&x?x:'not available';return{subject:'Workflow failure: '+name,body:`Workflow: ${workflow.name}\\nRun ID: ${execution.runId}\\nNode ID: ${v(error.nodeId)}\\nJob ID: ${v(error.jobId)}\\nPath: ${Array.isArray(error.path)?JSON.stringify(error.path):'not available'}\\nError code: ${v(error.code)}\\nError: ${error.message}`}}\n"
      }
