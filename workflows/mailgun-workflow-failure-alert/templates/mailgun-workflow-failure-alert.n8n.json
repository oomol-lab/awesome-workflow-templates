{
  "nodes": [
    {
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [
        250,
        500
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "mailgun-workflow-failure-alert-0"
    },
    {
      "id": "mailgun-workflow-failure-alert-1",
      "name": "Prepare failure details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $input.first().json,\n  w = x.workflow ?? {},\n  e = x.execution ?? {},\n  err = e.error ?? {};\nif (typeof w.name !== \"string\" || !w.name) throw Error(\"Missing workflow name\");\nconst name = w.name.replace(/[\\r\\n]+/g, \" \"),\n  v = (x) => (typeof x === \"string\" && x ? x : \"not available\");\nreturn [\n  {\n    json: {\n      subject: \"Workflow failure: \" + name,\n      body: \"Workflow: \" + w.name + \"\\nError: \" + v(err.message) + \"\\nStack trace: \" + v(err.stack),\n    },\n  },\n];\n"
      }
    },
    {
      "name": "Mailgun",
      "type": "n8n-nodes-base.mailgun",
      "position": [
        450,
        500
      ],
      "parameters": {
        "fromEmail": "YOUR_VERIFIED_SENDER",
        "toEmail": "YOUR_ALERT_EMAIL",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}"
      },
      "typeVersion": 1,
      "id": "mailgun-workflow-failure-alert-2"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Prepare failure details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare failure details": {
      "main": [
        [
          {
            "node": "Mailgun",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Send Workflow Failure Alerts with Mailgun",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
