        "jsCode": "const q = $json.query;\nif (!q || !/^[-0-9a-f]{36}$/i.test(q.id) || ![\"Yes\", \"No\"].includes(q.feedback))\n  throw Error(\"Invalid feedback\");\nreturn { json: $json, pairedItem: { item: $itemIndex } };\n"
