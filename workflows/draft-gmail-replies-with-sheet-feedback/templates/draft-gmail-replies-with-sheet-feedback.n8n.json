    {
      "name": "Prepare reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $(\"Resolve checkpoint\").item.json.ID,\n  base = \"https://YOUR_N8N_FEEDBACK_WEBHOOK_URL\";\nif (!/^https:\\/\\//.test(base)) throw Error(\"Configure HTTPS feedback URL\");\nconst sep = base.includes(\"?\") ? \"&\" : \"?\",\n  u = base + sep + \"id=\" + encodeURIComponent(id);\nreturn {\n  json: {\n    body:\n      $(\"Resolve checkpoint\").item.json[\"Generated reply\"] +\n      \"\\n\\nWas this helpful?\\nYes: \" +\n      u +\n      \"&feedback=Yes\\nNo: \" +\n      u +\n      \"&feedback=No\",\n  },\n  pairedItem: { item: $itemIndex },\n};\n"
      },
