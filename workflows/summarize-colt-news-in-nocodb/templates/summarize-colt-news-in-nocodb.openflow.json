        "source": "export default function ({ body, scheduledAt }) {\n  const html = typeof body === \"string\" ? body : \"\";\n  if (!html) throw Error(\"Empty news index\");\n  const links = [\n    ...html.matchAll(\n      /<a[^>]+href=[\"'](https:\\/\\/www\\.colt\\.net\\/resources\\/[^\"']+|\\/resources\\/[^\"']+)[\"'][^>]*>/gi,\n    ),\n  ]\n    .map((m) => m[1])\n    .filter((u) => !/\\/resources\\/type\\//i.test(u));\n  const dates = [...html.matchAll(/<time[^>]*>([^<]+)<\\/time>/gi)].map((m) => m[1].trim());\n  const cutoff = Date.parse(scheduledAt) - 70 * 86400000,\n    items = [],\n    seen = new Set();\n  for (let i = 0; i < Math.min(links.length, dates.length || links.length); i++) {\n    const date = dates[i] || scheduledAt.slice(0, 10),\n      ms = Date.parse(date),\n      url = new URL(links[i], \"https://www.colt.net\");\n    if (url.protocol !== \"https:\" || url.hostname !== \"www.colt.net\" || seen.has(url.href))\n      continue;\n    seen.add(url.href);\n    if (Number.isFinite(ms) && ms >= cutoff) items.push({ date, url: url.href });\n  }\n  return { items, runDay: scheduledAt.slice(0, 10) };\n}\n"
      },
      "n_feecb4b5513a9782": {
        "name": "Choose news article",
        "imports": [],
        "source": "export default function ({ items, previous }) {\n  const i = previous?.i ?? 0,\n    x = items[i] ?? { url: \"\", date: \"\" };\n  return { state: { i: i + 1 }, more: i < items.length, url: x.url, date: x.date };\n}\n"
      },
      "n_f14d16b4d1bb2856": {
        "name": "Extract article text",
        "imports": [],
        "source": "export default function ({ body }) {\n  const html = typeof body === \"string\" ? body : \"\";\n  const title = (\n    html.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i)?.[1] ||\n    html.match(/<title[^>]*>([^<]+)<\\/title>/i)?.[1] ||\n    \"\"\n  )\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n  const content = html\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .slice(0, 12000);\n  if (!title || !content) throw Error(\"Missing article content\");\n  return { title, content };\n}\n"
      },
      "n_0f67805554f31bfa": {
        "name": "Prepare NocoDB record",
        "imports": [],
        "source": "export default function ({ title, date, url, summary, keywords }) {\n  return {\n    records: [\n      {\n        fields: {\n          News_Source: \"Colt\",\n          Title: title,\n          Date: date,\n          Link: url,\n          Summary: summary,\n          Keywords: keywords,\n        },\n      },\n    ],\n  };\n}\n"
      },
      "n_c541793304ac9e2f": {
        "name": "Reserve article write",
        "imports": [],
        "source": "export default async function ({ day, url }, ctx) {\n  const key = \"colt-news:\" + day + \":\" + url,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect pending NocoDB record: \" + key);\n  if (s?.status === \"done\") return { key, send: false };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_0b75c3c930e23150": {
        "name": "Confirm article write",
        "imports": [],
        "source": "export default async function ({ key, records }, ctx) {\n  if (!Array.isArray(records) || records.length !== 1 || records[0].id == null)\n    throw Error(\"Unknown NocoDB result\");\n  await ctx.state.set(key, { status: \"done\", id: records[0].id });\n  return { ok: true };\n}\n"
      }
    },
    "features": []
  },
