    "modules": {
      "n_d939c81cec9b785d": {
        "name": "Create Asana task",
        "imports": [],
        "source": "export default async function createTask({ name, workspaceId }, context) {\n  const result = await context.actions.call('asana.create_task', { name, workspaceId });\n  if (!result?.task || typeof result.task.gid !== 'string' || !result.task.gid || typeof result.task.name !== 'string') throw new Error('Asana returned an invalid created task record');\n  return result;\n}\n"
      }
    }
