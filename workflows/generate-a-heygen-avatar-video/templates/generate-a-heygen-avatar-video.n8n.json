              "value": "YOUR_AVATAR_ID"
            },
            {
              "id": "eb2ed34c-53d2-41e8-ab2f-1b8278bde235",
              "name": "voice_id",
              "type": "string",
              "value": "YOUR_VOICE_ID"
            },
            {
