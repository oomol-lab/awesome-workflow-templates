    "modules": {
      "n_2ea5eca71b9cee5b": {
        "name": "Prepare avatar and narration",
        "imports": [],
        "source": "export default function scene({ avatarId, voiceId, text }) {\n  return {\n    videoInputs: [\n      {\n        character: { type: \"avatar\", avatarId, avatarStyle: \"normal\" },\n        voice: { type: \"text\", inputText: text, voiceId, speed: 1 },\n      },\n    ],\n  };\n}\n"
      },
      "n_2a2a8c14a1464658": {
        "name": "Read video status",
        "imports": [],
        "source": "export default function status({ status, videoUrl }) {\n  if (status === \"failed\") throw Error(\"HeyGen video generation failed\");\n  if (status === \"completed\" && !videoUrl) throw Error(\"HeyGen completed without video URL\");\n  return { completed: status === \"completed\", url: videoUrl ?? \"\" };\n}\n"
      }
    }
