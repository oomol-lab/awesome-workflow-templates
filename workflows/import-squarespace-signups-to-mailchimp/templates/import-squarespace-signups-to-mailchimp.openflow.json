    "modules": {
      "n_d9c34b51d40dbdeb": {
        "name": "Configure sheet and audience",
        "imports": [],
        "source": "export default function config({spreadsheetId,sheetName,listId}){for(const[k,v]of Object.entries({spreadsheetId,sheetName,listId}))if(typeof v!=='string'||!v.trim()||v.startsWith('YOUR_'))throw Error('Configure '+k);return{spreadsheetId,sheetName,listId,range:\"'\"+sheetName.replace(/'/g,\"''\")+\"'\"}}\n"
      },
      "n_51cf12d190849663": {
        "name": "Validate all signups",
        "imports": [],
        "source": "export default function validate({values}){if(!Array.isArray(values))throw Error('Invalid sheet response');if(!values.length)return{items:[]};const h=values[0];if(!Array.isArray(h))throw Error('Invalid header');const fields=['Email Address','Name','Submitted On'],idx=fields.map(x=>h.indexOf(x));if(idx.some(x=>x<0)||fields.some(x=>h.filter(y=>y===x).length!==1))throw Error('Required headers are missing or duplicated');const seen=new Set(),items=[];for(const row of values.slice(1)){if(!Array.isArray(row)||row.every(x=>x===null||x===undefined||x===''))continue;const [email,name,time]=idx.map(i=>row[i]);if(typeof email!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(email.trim())||typeof name!=='string'||!name.trim()||typeof time!=='string'||!/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$/.test(time)||!Number.isFinite(Date.parse(time)))throw Error('Each signup requires an email, name and ISO timestamp with time zone');const m=time.match(/^(\\d{4})-(\\d\\d)-(\\d\\d)T(\\d\\d):(\\d\\d):(\\d\\d)(?:\\.\\d+)?(Z|([+-])(\\d\\d):(\\d\\d))$/),d=new Date(Date.UTC(+m[1],+m[2]-1,+m[3]));if(d.getUTCFullYear()!==+m[1]||d.getUTCMonth()!==+m[2]-1||d.getUTCDate()!==+m[3]||+m[4]>23||+m[5]>59||+m[6]>59||(m[7]!=='Z'&&(+m[9]>23||+m[10]>59)))throw Error('Invalid signup timestamp');const key=email.trim().toLowerCase();if(seen.has(key))throw Error('Duplicate email in the sheet');seen.add(key);items.push({email:email.trim(),name:name.trim(),timestamp:new Date(time).toISOString()})}return{items}}\n"
      },
      "n_95e366b8ed05f69a": {
        "name": "Prepare the next subscriber",
        "imports": [],
        "source": "export default function next({items,listId,previous}){const i=previous?.index??0;if(!Array.isArray(items)||!Number.isInteger(i)||i<0||i>items.length)throw Error('Invalid signup list');if(i===items.length)return{state:{index:i},more:false,endpoint:'/unused',body:{},expected:'-'};const x=items[i];return{state:{index:i+1},more:true,endpoint:'/lists/'+encodeURIComponent(listId)+'/members',body:{email_address:x.email,status:'subscribed',merge_fields:{FNAME:x.name},timestamp_signup:x.timestamp},expected:x.email}}\n"
      },
      "n_1484ef3c9ca9d62b": {
        "name": "Confirm the subscriber",
        "imports": [],
        "source": "export default function confirm({body,statusCode,bodyEncoding,expected}){if(statusCode!==200||bodyEncoding||!body||typeof body.id!=='string'||!body.id||typeof body.email_address!=='string'||body.email_address.toLowerCase()!==expected.toLowerCase()||body.status!=='subscribed')throw Error('Mailchimp did not confirm the subscriber');return{member:body}}\n"
      }
    }
  },
