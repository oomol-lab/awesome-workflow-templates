    "modules": {
      "n_d9c34b51d40dbdeb": {
        "name": "Configure sheet and audience",
        "imports": [],
        "source": "export default function config({ spreadsheetId, sheetName, listId }) {\n  for (const [k, v] of Object.entries({ spreadsheetId, sheetName, listId }))\n    if (typeof v !== \"string\" || !v.trim() || v.startsWith(\"YOUR_\")) throw Error(\"Configure \" + k);\n  return { spreadsheetId, sheetName, listId, range: \"'\" + sheetName.replace(/'/g, \"''\") + \"'\" };\n}\n"
      },
      "n_51cf12d190849663": {
        "name": "Validate all signups",
        "imports": [],
        "source": "export default function validate({ values }) {\n  if (!Array.isArray(values)) throw Error(\"Invalid sheet response\");\n  if (!values.length) return { items: [] };\n  const h = values[0];\n  if (!Array.isArray(h)) throw Error(\"Invalid header\");\n  const fields = [\"Email Address\", \"Name\", \"Submitted On\"],\n    idx = fields.map((x) => h.indexOf(x));\n  if (idx.some((x) => x < 0) || fields.some((x) => h.filter((y) => y === x).length !== 1))\n    throw Error(\"Required headers are missing or duplicated\");\n  const seen = new Set(),\n    items = [];\n  for (const row of values.slice(1)) {\n    if (!Array.isArray(row) || row.every((x) => x === null || x === undefined || x === \"\"))\n      continue;\n    const [email, name, time] = idx.map((i) => row[i]);\n    if (\n      typeof email !== \"string\" ||\n      !/^\\S+@\\S+\\.\\S+$/.test(email.trim()) ||\n      typeof name !== \"string\" ||\n      !name.trim() ||\n      typeof time !== \"string\" ||\n      !/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$/.test(time) ||\n      !Number.isFinite(Date.parse(time))\n    )\n      throw Error(\"Each signup requires an email, name and ISO timestamp with time zone\");\n    const m = time.match(\n        /^(\\d{4})-(\\d\\d)-(\\d\\d)T(\\d\\d):(\\d\\d):(\\d\\d)(?:\\.\\d+)?(Z|([+-])(\\d\\d):(\\d\\d))$/,\n      ),\n      d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));\n    if (\n      d.getUTCFullYear() !== +m[1] ||\n      d.getUTCMonth() !== +m[2] - 1 ||\n      d.getUTCDate() !== +m[3] ||\n      +m[4] > 23 ||\n      +m[5] > 59 ||\n      +m[6] > 59 ||\n      (m[7] !== \"Z\" && (+m[9] > 23 || +m[10] > 59))\n    )\n      throw Error(\"Invalid signup timestamp\");\n    const key = email.trim().toLowerCase();\n    if (seen.has(key)) throw Error(\"Duplicate email in the sheet\");\n    seen.add(key);\n    items.push({ email: email.trim(), name: name.trim(), timestamp: new Date(time).toISOString() });\n  }\n  return { items };\n}\n"
      },
      "n_95e366b8ed05f69a": {
        "name": "Prepare the next subscriber",
        "imports": [],
        "source": "export default function next({ items, listId, previous }) {\n  const i = previous?.index ?? 0;\n  if (!Array.isArray(items) || !Number.isInteger(i) || i < 0 || i > items.length)\n    throw Error(\"Invalid signup list\");\n  if (i === items.length)\n    return { state: { index: i }, more: false, endpoint: \"/unused\", body: {}, expected: \"-\" };\n  const x = items[i];\n  return {\n    state: { index: i + 1 },\n    more: true,\n    endpoint: \"/lists/\" + encodeURIComponent(listId) + \"/members\",\n    body: {\n      email_address: x.email,\n      status: \"subscribed\",\n      merge_fields: { FNAME: x.name },\n      timestamp_signup: x.timestamp,\n    },\n    expected: x.email,\n  };\n}\n"
      },
      "n_1484ef3c9ca9d62b": {
        "name": "Confirm the subscriber",
        "imports": [],
        "source": "export default function confirm({ body, statusCode, bodyEncoding, expected }) {\n  if (\n    statusCode !== 200 ||\n    bodyEncoding ||\n    !body ||\n    typeof body.id !== \"string\" ||\n    !body.id ||\n    typeof body.email_address !== \"string\" ||\n    body.email_address.toLowerCase() !== expected.toLowerCase() ||\n    body.status !== \"subscribed\"\n  )\n    throw Error(\"Mailchimp did not confirm the subscriber\");\n  return { member: body };\n}\n"
      }
    }
  },
