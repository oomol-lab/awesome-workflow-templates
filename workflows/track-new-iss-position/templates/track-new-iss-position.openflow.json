    "modules": {
      "n_10994798908bebda": {
        "name": "Prepare the current timestamp",
        "imports": [],
        "source": "export default function query() {const timestamp=Math.floor(Date.now()/1000);return {timestamp,url:'https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps='+timestamp};}\n"
      },
      "n_a1877f13bd70fa19": {
        "name": "Validate the position",
        "imports": [],
        "source": "export default function row({body,timestamp}) {\n if(!Array.isArray(body)||body.length!==1)throw Error('Expected one ISS position');const p=body[0];\n if(!p||p.id!==25544||typeof p.name!=='string'||!p.name||!Number.isFinite(p.latitude)||p.latitude < -90||p.latitude>90||!Number.isFinite(p.longitude)||p.longitude < -180||p.longitude>180||p.timestamp!==timestamp)throw Error('ISS position does not match the request');\n const position={name:p.name,latitude:p.latitude,longitude:p.longitude,timestamp:p.timestamp};return {position,rows:[{json:position}]};\n}\n"
      },
      "n_d940f4a5d7aff713": {
        "name": "Keep only a new timestamp",
        "imports": [],
        "source": "export default async function dedup({position},context){const p=position;if(!p||!Number.isSafeInteger(p.timestamp))throw Error('Invalid position');const prior=await context.state.get('last-iss-timestamps');if(prior!==null&&!Array.isArray(prior))throw Error('Invalid saved timestamps');const duplicate=prior?.includes(p.timestamp)??false;await context.state.set('last-iss-timestamps',[p.timestamp]);return{result:duplicate?{message:'No new items'}:{timestamp:p.timestamp,latitude:p.latitude,longitude:p.longitude}}}\n"
      }
    }
