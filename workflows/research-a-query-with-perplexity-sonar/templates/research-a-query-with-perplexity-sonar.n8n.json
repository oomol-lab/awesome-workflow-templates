      ],
      "parameters": {
        "url": "https://api.perplexity.ai/v1/sonar",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({model:'sonar',messages:[{role:'system',content:$json.System},{role:'user',content:$json.User || 'No input provided'}],max_tokens:4000,temperature:0.2,top_p:0.9,return_citations:true,search_domain_filter:['perplexity.ai'],return_images:false,return_related_questions:false,search_recency_filter:'month',top_k:0,stream:false,presence_penalty:0,frequency_penalty:1}) }}",
        "sendBody": true,
        "specifyBody": "json",
