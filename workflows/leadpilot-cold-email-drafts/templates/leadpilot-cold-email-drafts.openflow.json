    "modules": {
      "n_bde9866a7196c378": {
        "name": "Validate every lead and sender",
        "imports": [],
        "source": "export default function prepareLeadPilot({ request }) {\n  if (!request || typeof request !== \"object\" || Array.isArray(request))\n    throw new Error(\"Provide a lead object or an object containing leads.\");\n  const source = request.leads === undefined ? [request] : request.leads;\n  if (!Array.isArray(source) || source.length === 0) throw new Error(\"Provide at least one lead.\");\n  const text = (value, name, fallback = \"\") => {\n    if (value === undefined || value === null || value === \"\") return fallback;\n    if (typeof value !== \"string\") throw new Error(name + \" must be text.\");\n    return value;\n  };\n  const senderName = text(request.sender_name, \"sender_name\", \"Your Name\"),\n    senderCompany = text(request.sender_company, \"sender_company\", \"Your Company\"),\n    senderValue = text(\n      request.value_prop,\n      \"value_prop\",\n      \"We help companies save time with automation.\",\n    ),\n    calendarLink = text(request.calendar_link, \"calendar_link\");\n  const leads = source.map((lead, index) => {\n    if (\n      !lead ||\n      typeof lead !== \"object\" ||\n      Array.isArray(lead) ||\n      typeof lead.name !== \"string\" ||\n      !lead.name.trim()\n    )\n      throw new Error(\"Lead \" + (index + 1) + \" requires a name.\");\n    return {\n      name: lead.name,\n      email: text(lead.email, \"email\"),\n      title: text(lead.title, \"title\"),\n      company: text(lead.company, \"company\"),\n      industry: text(lead.industry, \"industry\"),\n      companyDescription: text(lead.company_description, \"company_description\"),\n      linkedinUrl: text(lead.linkedin_url, \"linkedin_url\"),\n      notes: text(lead.notes, \"notes\"),\n      senderName,\n      senderCompany,\n      senderValue,\n      calendarLink,\n    };\n  });\n  return { leads };\n}\n"
      },
      "n_52ddde3241871007": {
        "name": "Collect validated lead drafts",
        "imports": [],
        "source": "export function validateLeadPilotEmail(value) {\n  if (typeof value === \"string\") {\n    try {\n      value = JSON.parse(value);\n    } catch {\n      throw new Error(\"The model response is not JSON.\");\n    }\n  }\n  if (!value || typeof value !== \"object\" || Array.isArray(value))\n    throw new Error(\"The model response must be an email object.\");\n  const required = (v, name) => {\n    if (typeof v !== \"string\" || !v.trim())\n      throw new Error(\"Generated \" + name + \" is empty or missing.\");\n    return v;\n  };\n  return {\n    subjectLine: required(value.subjectLine, \"subjectLine\"),\n    emailBody: required(value.emailBody, \"emailBody\"),\n    followUp: {\n      subject: required(value.followUp?.subject, \"followUp.subject\"),\n      body: required(value.followUp?.body, \"followUp.body\"),\n    },\n  };\n}\nexport function leadPilotPrompt(lead) {\n  return (\n    \"Write a cold email:\\n\\nRecipient: \" +\n    lead.name +\n    \"\\nTitle: \" +\n    lead.title +\n    \"\\nCompany: \" +\n    lead.company +\n    \"\\nIndustry: \" +\n    lead.industry +\n    \"\\nAbout Company: \" +\n    lead.companyDescription +\n    \"\\nNotes: \" +\n    lead.notes +\n    \"\\n\\nSender: \" +\n    lead.senderName +\n    \" at \" +\n    lead.senderCompany +\n    \"\\nValue Prop: \" +\n    lead.senderValue +\n    \"\\nCalendar: \" +\n    lead.calendarLink\n  );\n}\nexport default function collectLeadPilot({ leads, previousState, response }) {\n  let state = previousState ?? { index: 0, drafts: [] };\n  if (\n    !Number.isSafeInteger(state.index) ||\n    state.index < 0 ||\n    state.index > leads.length ||\n    state.drafts.length !== state.index\n  )\n    throw new Error(\"Invalid lead generation progress.\");\n  if (previousState && state.index < leads.length) {\n    const email = validateLeadPilotEmail(response),\n      lead = leads[state.index];\n    state = {\n      index: state.index + 1,\n      drafts: [...state.drafts, { ...lead, ...email, generatedAt: new Date().toISOString() }],\n    };\n  }\n  return {\n    state,\n    more: state.index < leads.length,\n    prompt: state.index < leads.length ? leadPilotPrompt(leads[state.index]) : \"\",\n    values: state.drafts.map((d) => [\n      d.name,\n      d.email,\n      d.title,\n      d.company,\n      d.subjectLine,\n      d.emailBody,\n      d.followUp.body,\n      d.generatedAt,\n      \"No\",\n    ]),\n  };\n}\n"
      },
      "n_684070830eb14d49": {
        "name": "Confirm all lead rows were saved",
        "imports": [],
        "source": "export default function confirmLeadPilot({ drafts, updatedRows, updatedRange }) {\n  if (updatedRows !== drafts.length || typeof updatedRange !== \"string\" || !updatedRange.trim())\n    throw new Error(\n      \"The complete lead batch was not confirmed saved. Inspect the sheet before repeating this request.\",\n    );\n  const first = drafts[0];\n  return {\n    success: true,\n    lead: first.name,\n    company: first.company,\n    subjectLine: first.subjectLine,\n    count: drafts.length,\n    drafts,\n    updatedRange: updatedRange,\n    message: \"Emails generated. Check Google Sheets to review and send.\",\n  };\n}\n"
      }
    }
  },
