            "name": "Write one cold email and follow-up",
            "retry": {
              "maxRetries": 2,
              "intervalMs": 2000
            },
            "kind": "task",
            "task": {
              "inputs": [
                {
                  "jsonSchema": {
                    "items": {
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "nullable": true,
                  "handle": "messages",
                  "value": null
