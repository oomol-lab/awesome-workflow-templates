    "modules": {
      "n_6c9c4c3e760e4ffc": {
        "name": "Read all tasks and Slack users",
        "imports": [],
        "source": "export default async function collect({previous,dataSourceId},context){\n  const s=previous??{phase:'notion',cursor:null,seen:[],tasks:[],users:[]};\n  if(!dataSourceId || dataSourceId.startsWith('YOUR_')) throw Error('Configure the Notion data source ID');\n  if(s.phase==='notion'){\n    const r=await context.actions.call('notion.query_data_source',{dataSourceId,pageSize:100,...(s.cursor?{startCursor:s.cursor}:{})});\n    if(!Array.isArray(r?.results)||typeof r.has_more!=='boolean') throw Error('Invalid Notion response');\n    const next=r.next_cursor;\n    if(r.has_more&&(typeof next!=='string'||!next||s.seen.includes(next)))throw Error('Invalid Notion cursor');\n    if(!r.has_more&&next!==null)throw Error('Inconsistent Notion cursor');\n    return {state:{...s,tasks:[...s.tasks,...r.results],phase:r.has_more?'notion':'slack',cursor:r.has_more?next:null,seen:r.has_more?[...s.seen,next]:[]},more:true};\n  }\n  const r=await context.actions.call('slack.list_users',{limit:200,...(s.cursor?{cursor:s.cursor}:{})});\n  if(!Array.isArray(r?.users))throw Error('Invalid Slack user response');\n  const next=r.nextCursor;\n  if(next!==null&&(typeof next!=='string'||!next||s.seen.includes(next)))throw Error('Invalid Slack cursor');\n  return {state:{...s,users:[...s.users,...r.users],cursor:next,seen:next?[...s.seen,next]:s.seen},more:next!==null};\n}\n"
      },
      "n_32536cdf93a49251": {
        "name": "Match assignees and tasks",
        "imports": [],
        "source": "export default function plan({state,user1,user2,name1,name2}){\n  const pairs=[[user1,name1],[user2,name2]];\n  if(pairs.some(([a,b])=>typeof a!=='string'||!a.trim()||typeof b!=='string'||!b.trim()||a.startsWith('YOUR_')||b.startsWith('YOUR_'))||user1===user2||name1===name2)throw Error('Configure two distinct Notion user IDs and Slack names');\n  if(!Array.isArray(state?.users)||!Array.isArray(state?.tasks))throw Error('Incomplete read state');\n  const users=pairs.map(([,name])=>{const matches=state.users.filter(u=>!u.isDeleted&&u.realName===name);if(matches.length!==1||!matches[0].userId)throw Error('Slack name must identify exactly one user');return matches[0].userId});\n  const out=[];\n  for(const page of state.tasks){\n    const p=page.properties;if(!p||typeof p!=='object')throw Error('Missing task properties');\n    const status=p.Status?.status?.name??p.Status?.select?.name;if(typeof status!=='string')throw Error('Missing Status');if(status==='Done')continue;\n    const title=p.Task?.title;if(!Array.isArray(title))throw Error('Missing Task title');const task=title.map(x=>x.plain_text??x.text?.content??'').join('');if(!task)throw Error('Empty task title');\n    const people=p['Notion User']?.people;if(!Array.isArray(people)||people.length>=25)throw Error('Missing or possibly truncated Notion User people');\n    const ids=people.map(u=>{if(typeof u.id!=='string'||!u.id)throw Error('Assignee ID unavailable');return u.id});\n    const due=p.Due?.date?.start;if(typeof due!=='string'||!due)throw Error('Missing task due date');\n    const i=pairs.findIndex(([id])=>ids.includes(id));if(i>=0)out.push({channelId:users[i],text:'# TO DO\\n☑️ '+task+' (Due: '+due+')'});\n  }\n  return {items:out};\n}\n"
      },
      "n_c12c695ffadd34bb": {
        "name": "Prepare each reminder",
        "imports": [],
        "source": "export default function next({items,previous,confirmation}){const i=previous?.index??0;if(i>0&&(!confirmation||typeof confirmation!=='string'))throw Error('Slack send not confirmed');if(i>=items.length)return{state:{index:i},more:false,channelId:'unused',text:'unused'};const item=items[i];return{state:{index:i+1},more:true,channelId:item.channelId,text:item.text};}\n"
      }
    }
