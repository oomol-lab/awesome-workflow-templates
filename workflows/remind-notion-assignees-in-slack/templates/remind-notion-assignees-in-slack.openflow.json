    "modules": {
      "n_6c9c4c3e760e4ffc": {
        "name": "Read all tasks and Slack users",
        "imports": [],
        "source": "export default async function collect({ previous, dataSourceId }, context) {\n  const s = previous ?? { phase: \"notion\", cursor: null, seen: [], tasks: [], users: [] };\n  if (!dataSourceId || dataSourceId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the Notion data source ID\");\n  if (s.phase === \"notion\") {\n    const r = await context.actions.call(\"notion.query_data_source\", {\n      dataSourceId,\n      pageSize: 100,\n      ...(s.cursor ? { startCursor: s.cursor } : {}),\n    });\n    if (!Array.isArray(r?.results) || typeof r.has_more !== \"boolean\")\n      throw Error(\"Invalid Notion response\");\n    const next = r.next_cursor;\n    if (r.has_more && (typeof next !== \"string\" || !next || s.seen.includes(next)))\n      throw Error(\"Invalid Notion cursor\");\n    if (!r.has_more && next !== null) throw Error(\"Inconsistent Notion cursor\");\n    return {\n      state: {\n        ...s,\n        tasks: [...s.tasks, ...r.results],\n        phase: r.has_more ? \"notion\" : \"slack\",\n        cursor: r.has_more ? next : null,\n        seen: r.has_more ? [...s.seen, next] : [],\n      },\n      more: true,\n    };\n  }\n  const r = await context.actions.call(\"slack.list_users\", {\n    limit: 200,\n    ...(s.cursor ? { cursor: s.cursor } : {}),\n  });\n  if (!Array.isArray(r?.users)) throw Error(\"Invalid Slack user response\");\n  const next = r.nextCursor;\n  if (next !== null && (typeof next !== \"string\" || !next || s.seen.includes(next)))\n    throw Error(\"Invalid Slack cursor\");\n  return {\n    state: {\n      ...s,\n      users: [...s.users, ...r.users],\n      cursor: next,\n      seen: next ? [...s.seen, next] : s.seen,\n    },\n    more: next !== null,\n  };\n}\n"
      },
      "n_32536cdf93a49251": {
        "name": "Match assignees and tasks",
        "imports": [],
        "source": "export default function plan({ state, user1, user2, name1, name2 }) {\n  const pairs = [\n    [user1, name1],\n    [user2, name2],\n  ];\n  if (\n    pairs.some(\n      ([a, b]) =>\n        typeof a !== \"string\" ||\n        !a.trim() ||\n        typeof b !== \"string\" ||\n        !b.trim() ||\n        a.startsWith(\"YOUR_\") ||\n        b.startsWith(\"YOUR_\"),\n    ) ||\n    user1 === user2 ||\n    name1 === name2\n  )\n    throw Error(\"Configure two distinct Notion user IDs and Slack names\");\n  if (!Array.isArray(state?.users) || !Array.isArray(state?.tasks))\n    throw Error(\"Incomplete read state\");\n  const users = pairs.map(([, name]) => {\n    const matches = state.users.filter((u) => !u.isDeleted && u.realName === name);\n    if (matches.length !== 1 || !matches[0].userId)\n      throw Error(\"Slack name must identify exactly one user\");\n    return matches[0].userId;\n  });\n  const out = [];\n  for (const page of state.tasks) {\n    const p = page.properties;\n    if (!p || typeof p !== \"object\") throw Error(\"Missing task properties\");\n    const status = p.Status?.status?.name ?? p.Status?.select?.name;\n    if (typeof status !== \"string\") throw Error(\"Missing Status\");\n    if (status === \"Done\") continue;\n    const title = p.Task?.title;\n    if (!Array.isArray(title)) throw Error(\"Missing Task title\");\n    const task = title.map((x) => x.plain_text ?? x.text?.content ?? \"\").join(\"\");\n    if (!task) throw Error(\"Empty task title\");\n    const people = p[\"Notion User\"]?.people;\n    if (!Array.isArray(people) || people.length >= 25)\n      throw Error(\"Missing or possibly truncated Notion User people\");\n    const ids = people.map((u) => {\n      if (typeof u.id !== \"string\" || !u.id) throw Error(\"Assignee ID unavailable\");\n      return u.id;\n    });\n    const due = p.Due?.date?.start;\n    if (typeof due !== \"string\" || !due) throw Error(\"Missing task due date\");\n    const i = pairs.findIndex(([id]) => ids.includes(id));\n    if (i >= 0)\n      out.push({ channelId: users[i], text: \"# TO DO\\n☑️ \" + task + \" (Due: \" + due + \")\" });\n  }\n  return { items: out };\n}\n"
      },
      "n_c12c695ffadd34bb": {
        "name": "Prepare each reminder",
        "imports": [],
        "source": "export default function next({ items, previous, confirmation }) {\n  const i = previous?.index ?? 0;\n  if (i > 0 && (!confirmation || typeof confirmation !== \"string\"))\n    throw Error(\"Slack send not confirmed\");\n  if (i >= items.length)\n    return { state: { index: i }, more: false, channelId: \"unused\", text: \"unused\" };\n  const item = items[i];\n  return { state: { index: i + 1 }, more: true, channelId: item.channelId, text: item.text };\n}\n"
      }
    }
