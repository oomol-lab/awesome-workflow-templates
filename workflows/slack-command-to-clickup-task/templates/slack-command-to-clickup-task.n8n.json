{
  "nodes": [
    {
      "id": "slack-command-to-clickup-task-0",
      "name": "Receives slack command",
      "type": "n8n-nodes-base.webhook",
      "position": [
        960,
        640
      ],
      "parameters": {
        "path": "slack-command-to-clickup-task",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "typeVersion": 1.1
    },
    {
      "id": "slack-command-to-clickup-task-1",
      "name": "Set your nodes",
      "type": "n8n-nodes-base.set",
      "position": [
        1160,
        640
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "8f6664ce-a3ad-42fb-84f7-58608d3c0ce8",
              "name": "channel_name",
              "type": "string",
              "value": "={{ $json.body.channel_name }}"
            },
            {
              "id": "54bf76f5-f00a-4f8e-bfcb-addd8af75a1a",
              "name": "command",
              "type": "string",
              "value": "={{ $json.body.command }}"
            },
            {
              "id": "37e273c0-2775-420b-9eb2-baeab3d1fdb6",
              "name": "user_name",
              "type": "string",
              "value": "={{ $json.body.user_name }}"
            },
            {
              "id": "6926bdae-e5eb-429d-a17d-7775b87184b1",
              "name": "text",
              "type": "string",
              "value": "={{ $json.body.text }}"
            }
          ]
        }
      },
      "typeVersion": 3.3
    },
    {
      "id": "slack-command-to-clickup-task-2",
      "name": "Create new clickup task",
      "type": "n8n-nodes-base.clickUp",
      "position": [
        1340,
        640
      ],
      "parameters": {
        "list": "YOUR_CLICKUP_LIST_ID",
        "name": "={{ $json.text }}",
        "team": "YOUR_CLICKUP_TEAM_ID",
        "space": "YOUR_CLICKUP_SPACE_ID",
        "folderless": true,
        "authentication": "oAuth2",
        "additionalFields": {
          "content": "={{ $json.text }}",
          "assignees": []
        }
      },
      "typeVersion": 1
    },
    {
      "id": "slack-command-to-clickup-task-execution-mode",
      "name": "Execution mode",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mode",
              "name": "executionMode",
              "type": "string",
              "value": "n8n"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "position": [
        1300,
        900
      ]
    },
    {
      "id": "slack-command-to-clickup-task-use-open-flow-",
      "name": "Use Open Flow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.executionMode }}",
              "operation": "equal",
              "value2": "openflow"
            }
          ]
        }
      },
      "position": [
        1300,
        900
      ]
    },
    {
      "id": "slack-command-to-clickup-task-forward-to-open-flow",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event:JSON.stringify($('Receives slack command').item.json.body)} }}",
        "options": {}
      },
      "position": [
        1300,
        900
      ]
    },
    {
      "id": "slack-command-to-clickup-task-send-slack-confirmation",
      "name": "Send Slack confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Receives slack command').item.json.body.response_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {text: \"Task Created: ID  \" + $json.id} }}",
        "options": {}
      },
      "position": [
        1300,
        900
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Receives slack command": {
      "main": [
        [
          {
            "node": "Execution mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execution mode": {
      "main": [
        [
          {
            "node": "Use Open Flow?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Use Open Flow?": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set your nodes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set your nodes": {
      "main": [
        [
          {
            "node": "Create new clickup task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create new clickup task": {
      "main": [
        [
          {
            "node": "Send Slack confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Create ClickUp Tasks from Slack Commands",
  "active": false
}
