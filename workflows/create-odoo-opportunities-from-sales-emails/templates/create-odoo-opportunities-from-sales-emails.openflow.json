      "n_2c4a04b0445c5234": {
        "name": "Choose the next email",
        "imports": [],
        "source": "export default function next({events,previousState,createdId}) {\n if(!Array.isArray(events)||events.length>25)throw Error('Invalid Gmail page');\n for(const e of events)if(!e||typeof e.messageId!=='string'||!e.messageId)throw Error('Missing Gmail message ID');\n let index=0;if(previousState!=null){if(!Number.isInteger(previousState.index)||previousState.index<0||previousState.index>=events.length||!Number.isInteger(createdId)||createdId<=0)throw Error('Invalid opportunity result');index=previousState.index+1}\n return {state:{index},more:index<events.length,messageId:index<events.length?events[index].messageId:'',count:index};\n}\n"
      },
      "n_3d67673936ea2b9e": {
        "name": "Prepare the inquiry",
        "imports": [],
        "source": "export default function prepare({expectedId,messageId,sender,subject,messageText}){\n if(messageId!==expectedId||typeof sender!=='string'||typeof subject!=='string'||!subject.trim()||typeof messageText!=='string'||!messageText.trim())throw Error('Message identity, sender, subject or text is missing');\n const m=sender.match(/(?:^|<)([^<>\\s@]+@[^<>\\s@]+)(?:>|$)/);if(!m)throw Error('Sender email address missing');\n return {email:m[1],subject,body:messageText};\n}\n"
      },
      "n_18f4b2189938556e": {
        "name": "Prepare the opportunity",
        "imports": [],
        "source": "export default function values({email,subject,summary}){\n if(typeof summary!=='string'||!summary.trim())throw Error('Summary is empty');\n return {values:{type:'opportunity',name:subject,email_from:email,description:summary}};\n}\n"
      }
    }
