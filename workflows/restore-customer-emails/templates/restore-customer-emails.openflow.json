        "name": "Keep customer names",
        "imports": [],
        "source": "export default function reduce({ customers }) {\n  return { names: customers.map((x) => ({ name: x.name })) };\n}\n"
      },
      "n_cbab156b0ad014b1": {
        "name": "Restore matched emails",
        "imports": [],
        "source": "export default function restore({ names, customers }) {\n  return { customers: names.map((x, i) => ({ name: x.name, restoreEmail: customers[i].email })) };\n}\n"
      }
