    "modules": {
      "n_e1613c07f0033cf5": {
        "name": "Find recent funding rounds",
        "imports": [],
        "source": "export default async function list({ apiKey }, context) {\n  if (!apiKey) throw Error(\"Configure the Piloterr API key\");\n  const events = [];\n  for (const type of [\"series_a\", \"series_b\", \"seed\"]) {\n    const url =\n        \"https://api.piloterr.com/v2/crunchbase/funding_rounds?days_since_announcement=1&investment_type=\" +\n        type,\n      r = await context.fetch(url, { headers: { \"x-api-key\": apiKey } });\n    if (!r.ok) throw Error(\"Piloterr funding lookup failed\");\n    const body = await r.json();\n    if (!Array.isArray(body.results)) throw Error(\"Invalid Piloterr funding response\");\n    events.push(...body.results);\n  }\n  return { events };\n}\n"
      },
      "n_0b3cea696f1fd457": {
        "name": "Enrich next funding round",
        "imports": [],
        "source": "export default async function next({ events, previous, apiKey }, context) {\n  const headers = [\n      \"company_name\",\n      \"website_url\",\n      \"type\",\n      \"money_raised\",\n      \"linkedin_url\",\n      \"announced_on\",\n      \"funding_total\",\n      \"employee_count\",\n      \"investment_type\",\n      \"monthly_traffic_semrush\",\n      \"country\",\n      \"link\",\n      \"event_link\",\n      \"founded_date\",\n    ],\n    index = previous?.index ?? 0;\n  if (index >= events.length) return { state: { index }, more: false, headers, rows: [[\"\"]] };\n  const e = events[index],\n    link = e?.funded_organization_identifier?.permalink,\n    eventLink = e?.identifier?.permalink;\n  if (!link || !eventLink) throw Error(\"Funding event lacks a company or event permalink\");\n  const url =\n    \"https://api.piloterr.com/v2/crunchbase/company/info?query=\" +\n    encodeURIComponent(\"https://www.crunchbase.com/organization/\" + link);\n  let c = {};\n  try {\n    const r = await context.fetch(url, { headers: { \"x-api-key\": apiKey } });\n    if (r.ok) c = await r.json();\n  } catch {}\n  let website = \"\";\n  try {\n    website = new URL(c.website).hostname.replace(/^www\\./, \"\");\n  } catch {}\n  const country =\n      c.location?.find?.((x) => x.type === \"country\")?.name ?? c.location?.[2]?.name ?? \"\",\n    linkedin = c.social_networks?.find?.((x) => x.name === \"linkedin\")?.url ?? \"\",\n    row = [\n      e.funded_organization_identifier.value ?? \"\",\n      website,\n      e.investment_type ?? \"\",\n      e.money_raised?.value_usd ?? \"\",\n      linkedin,\n      e.announced_on ?? \"\",\n      c.funding_rounds_headline?.funding_total?.value ?? \"\",\n      c.employee_count ?? \"\",\n      e.investment_type ?? \"\",\n      c.semrush_summary?.semrush_visits_latest_month ?? \"\",\n      country,\n      link,\n      eventLink,\n      c.founded ?? \"\",\n    ].map((v) => String(v));\n  return { state: { index: index + 1 }, more: true, headers, rows: [row] };\n}\n"
      }
    }
