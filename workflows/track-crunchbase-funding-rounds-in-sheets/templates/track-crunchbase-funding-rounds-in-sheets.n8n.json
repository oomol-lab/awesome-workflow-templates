    {
      "id": "track-crunchbase-funding-rounds-in-sheets-5",
      "name": "Prepare data",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        460
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json;\nreturn {\n  json: {\n    company_name: e.funded_organization_identifier?.value ?? \"\",\n    link: e.funded_organization_identifier?.permalink ?? \"\",\n    event_link: e.identifier?.permalink ?? \"\",\n    type: e.investment_type ?? \"\",\n    investment_type: e.investment_type ?? \"\",\n    money_raised: e.money_raised?.value_usd ?? \"\",\n    announced_on: e.announced_on ?? \"\",\n  },\n};\n"
      },
      "typeVersion": 2
    },
    {
      "id": "track-crunchbase-funding-rounds-in-sheets-6",
