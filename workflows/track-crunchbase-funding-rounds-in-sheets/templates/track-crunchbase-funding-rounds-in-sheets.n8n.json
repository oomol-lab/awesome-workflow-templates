    {
      "id": "track-crunchbase-funding-rounds-in-sheets-map",
      "name": "Combine funding and company",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $(\"Prepare data\").item.json,\n  c = $json;\nconst website = String(c.website ?? \"\").match(/^https?:\\/\\/(?:www\\.)?([^\\/:?#]+)/i)?.[1] ?? \"\";\nreturn {\n  json: {\n    ...e,\n    website_url: website,\n    linkedin_url: c.social_networks?.find((x) => x.name === \"linkedin\")?.url ?? \"\",\n    funding_total: c.funding_rounds_headline?.funding_total?.value ?? \"\",\n    employee_count: c.employee_count ?? \"\",\n    monthly_traffic_semrush: c.semrush_summary?.semrush_visits_latest_month ?? \"\",\n    country: c.location?.find((x) => x.type === \"country\")?.name ?? c.location?.[2]?.name ?? \"\",\n    founded_date: c.founded ?? \"\",\n  },\n};\n"
      }
    }
