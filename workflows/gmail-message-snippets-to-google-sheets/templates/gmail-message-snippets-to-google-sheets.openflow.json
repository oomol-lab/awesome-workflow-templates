      "n_8bf704265f3ff3ef": {
        "name": "Choose the next message",
        "imports": [],
        "source": "export default function gmailSheetProgress({ events, previousState, row }) {\n  if (!Array.isArray(events) || events.length > 50) throw new Error('Invalid Gmail poll page');\n  for (const event of events) if (!event || typeof event.messageId !== 'string' || !event.messageId) throw new Error('Missing Gmail message ID');\n  let state = { index: 0, values: [] };\n  if (previousState != null) {\n    if (!Number.isInteger(previousState.index) || previousState.index < 0 || previousState.index >= events.length || !Array.isArray(previousState.values) || previousState.values.length !== previousState.index || !row || !Array.isArray(row.values) || row.values.length !== 3) throw new Error('Invalid Gmail page progress');\n    state = { index: previousState.index + 1, values: previousState.values.concat([row.values]) };\n  }\n  return { state, more: state.index < events.length, messageId: state.index < events.length ? events[state.index].messageId : '', count: state.index, values: state.values, nonempty: state.index > 0 };\n}\n"
      },
      "n_33aef51868642e6c": {
        "name": "Prepare the sheet row",
        "imports": [],
        "source": "export default function gmailSheetRow({ expectedId, messageId, sender, subject, snippet }) {\n  if (messageId !== expectedId) throw new Error('Fetched a different Gmail message');\n  if (typeof sender !== 'string' || typeof subject !== 'string' || (snippet != null && typeof snippet !== 'string')) throw new Error('Invalid Gmail message fields');\n  return { row: { values: [sender, subject, snippet ?? ''] } };\n}\n"
      },
      "n_a19b9a793ce37b7b": {
        "name": "Confirm the appended page",
        "imports": [],
        "source": "export default function gmailSheetConfirm({ count, updatedRows }) {\n  if (count < 1 || updatedRows !== count) throw new Error('The sheet did not confirm the full batch; inspect it before replaying');\n  return { count };\n}\n"
      }
    }
