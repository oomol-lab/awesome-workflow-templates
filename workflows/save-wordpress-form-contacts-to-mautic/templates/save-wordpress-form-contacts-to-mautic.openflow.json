    "modules": {
      "n_90ba7d356da8fc22": {
        "name": "Map the form and validate email syntax",
        "imports": [],
        "source": "function mapMauticForm(body, expectedFormId, enableWrites) {\n  if (!enableWrites)\n    throw new Error(\"Verify webhook Header authentication before enabling Mautic writes\");\n  if (\n    typeof expectedFormId !== \"string\" ||\n    !expectedFormId ||\n    expectedFormId === \"YOUR_WORDPRESS_FORM_ID\"\n  ) {\n    throw new Error(\"Configure the WordPress form ID\");\n  }\n  if (body?.form_id !== expectedFormId) throw new Error(\"Unexpected WordPress form ID\");\n  const { Nome: name, \"E-mail\": email, WhatsApp: mobile } = body;\n  if (\n    typeof name !== \"string\" ||\n    !name.trim() ||\n    name.length > 200 ||\n    typeof email !== \"string\" ||\n    email.length > 254 ||\n    typeof mobile !== \"string\" ||\n    mobile.length > 80\n  ) {\n    throw new Error(\"Expected Nome, E-mail and WhatsApp as form fields\");\n  }\n  const firstName = name\n    .trim()\n    .replace(/(^|[\\s-])(\\p{Ll})([\\p{L}\\p{M}'’]*)/gu, (word, prefix, initial, rest) =>\n      /\\p{Lu}/u.test(rest) ? word : prefix + initial.toUpperCase() + rest,\n    );\n  const emailValid =\n    !email.includes(\" \") &&\n    /(([^<>()\\[\\]\\\\.,;:\\s@\"]+(\\.[^<>()\\[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@(\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}]|([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,})/.test(\n      email,\n    );\n  return { fields: { firstname: firstName, email: email.toLowerCase(), mobile }, emailValid };\n}\nexport default ({ body, expectedFormId, enableWrites }) =>\n  mapMauticForm(body, expectedFormId, enableWrites);\n"
      },
      "n_1cf93245bea1baa9": {
        "name": "Confirm the saved contact",
        "imports": [],
        "source": "function confirmMauticContact(contact, fields, emailValid) {\n  if (!Number.isSafeInteger(contact?.id) || contact.id < 1)\n    throw new Error(\"Mautic did not return a valid Contact ID\");\n  const returned = contact.fields?.all;\n  if (\n    !returned ||\n    returned.firstname !== fields.firstname ||\n    (returned.mobile ?? \"\") !== fields.mobile ||\n    (returned.email !== fields.email &&\n      (emailValid || (returned.email != null && returned.email !== \"\")))\n  ) {\n    throw new Error(\n      \"Mautic did not return the contact for this submission. Check the saved record before retrying.\",\n    );\n  }\n  return contact.id;\n}\nexport default ({ contact, fields, emailValid }) => {\n  const contactId = confirmMauticContact(contact, fields, emailValid);\n  return {\n    contactId,\n    endpoint: \"/contacts/\" + contactId + \"/dnc/email/add\",\n    suppressEmail: !emailValid,\n  };\n};\n"
      },
      "n_b626a2cbf6ea8ef0": {
        "name": "Confirm email Do Not Contact",
        "imports": [],
        "source": "function confirmMauticDnc(contact, contactId) {\n  if (\n    contact?.id !== contactId ||\n    !Array.isArray(contact.doNotContact) ||\n    !contact.doNotContact.some(\n      (entry) => entry?.channel === \"email\" && [1, 3].includes(Number(entry.reason)),\n    )\n  ) {\n    throw new Error(\"Mautic did not confirm email Do Not Contact on the saved Contact ID\");\n  }\n  return { contactId, emailStatus: \"do_not_contact\" };\n}\nexport default ({ status, response, contactId }) => {\n  if (status !== 200 || response?.errors)\n    throw new Error(\"Mautic Do Not Contact was not confirmed\");\n  return { result: confirmMauticDnc(response?.contact, contactId) };\n};\n"
      },
      "n_cd57a97583f39bff": {
        "name": "Record the valid email result",
        "imports": [],
        "source": "export default ({ contactId }) => ({ result: { contactId, emailStatus: \"valid_syntax\" } });\n"
      }
