e throw Error(\"Unexpected step\");\n  await ctx.state.set(\"stripe-spend\", s);\n  return { ok: true };\n}\n\nexport default async function run({ statusCode, body }, ctx) {\n  return result({ kind: \"create-property\", statusCode, body }, ctx);\n}\n"
