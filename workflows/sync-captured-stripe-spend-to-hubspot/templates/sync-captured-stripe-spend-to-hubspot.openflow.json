    "modules": {
      "n_7eadf9c261b80f17": {
        "name": "Choose sync step",
        "imports": [],
        "source": "export default async function next({ propertyId, propertyLabel, checkProperty, acknowledge }, ctx) {\n  if (!propertyId || propertyId.includes(\"YOUR_\") || !propertyLabel)\n    throw Error(\"Configure HubSpot property ID and label\");\n  let s = await ctx.state.get(\"stripe-spend\");\n  if (!s) {\n    s = {\n      phase: checkProperty ? \"property\" : \"charges\",\n      cursor: null,\n      totals: {},\n      customers: [],\n      index: 0,\n      emails: {},\n      pending: null,\n    };\n    await ctx.state.set(\"stripe-spend\", s);\n  }\n  if (s.pending) {\n    if (acknowledge !== s.pending) throw Error(\"Inspect HubSpot write \" + s.pending);\n    if (s.pending === \"property\") {\n      s.phase = \"charges\";\n    } else {\n      s.index++;\n      s.phase = \"upsert\";\n    }\n    s.pending = null;\n    await ctx.state.set(\"stripe-spend\", s);\n  }\n  for (;;) {\n    let action = s.phase,\n      url = \"https://api.hubapi.com/\",\n      body = {},\n      key = \"\";\n    if (action === \"property\")\n      url = \"https://api.hubapi.com/crm/v3/properties/contacts/\" + encodeURIComponent(propertyId);\n    if (action === \"create-property\") {\n      url = \"https://api.hubapi.com/crm/v3/properties/contacts\";\n      body = {\n        name: propertyId,\n        label: propertyLabel,\n        type: \"number\",\n        fieldType: \"number\",\n        groupName: \"contactinformation\",\n        formField: false,\n        description: \"Total spend calculated from Stripe charges.\",\n      };\n      s.pending = \"property\";\n      await ctx.state.set(\"stripe-spend\", s);\n    }\n    if (action === \"charges\")\n      url =\n        \"https://api.stripe.com/v1/charges?limit=100\" +\n        (s.cursor ? \"&starting_after=\" + encodeURIComponent(s.cursor) : \"\");\n    if (action === \"customer\") {\n      if (s.index >= s.customers.length) {\n        s.index = 0;\n        s.phase = \"upsert\";\n        await ctx.state.set(\"stripe-spend\", s);\n        continue;\n      }\n      url = \"https://api.stripe.com/v1/customers/\" + encodeURIComponent(s.customers[s.index]);\n    }\n    if (action === \"upsert\") {\n      const emails = Object.keys(s.emails);\n      if (s.index >= emails.length) {\n        s.phase = \"done\";\n        continue;\n      }\n      let email = emails[s.index];\n      url = \"https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert\";\n      body = {\n        inputs: [\n          {\n            id: email,\n            idProperty: \"email\",\n            properties: { email, [propertyId]: String(s.emails[email] / 100) },\n          },\n        ],\n      };\n      key = \"contact:\" + email;\n      s.pending = key;\n      await ctx.state.set(\"stripe-spend\", s);\n    }\n    if (action === \"done\") await ctx.state.set(\"stripe-spend\", null);\n    return { action, url, body, key };\n  }\n}\n"
      },
      "n_4d95486f3e5378bf": {
        "name": "Confirm property",
        "imports": [],
        "source": "async function result({ kind, statusCode, body }, ctx) {\n  const s = await ctx.state.get(\"stripe-spend\");\n  if (!s) throw Error(\"Missing Stripe spend state\");\n  if (kind === \"property\") {\n    if (statusCode === 404) s.phase = \"create-property\";\n    else if (statusCode === 200) s.phase = \"charges\";\n    else throw Error(\"HubSpot property read failed: \" + statusCode);\n  } else if (kind === \"create-property\") {\n    if (statusCode < 200 || statusCode >= 300) throw Error(\"Inspect HubSpot property creation\");\n    s.pending = null;\n    s.phase = \"charges\";\n  } else if (kind === \"charges\") {\n    if (statusCode !== 200 || !Array.isArray(body.data)) throw Error(\"Stripe charge read failed\");\n    for (const c of body.data) {\n      if (!c.customer) continue;\n      if (typeof c.customer !== \"string\" || !Number.isSafeInteger(c.amount_captured))\n        throw Error(\"Invalid charge\");\n      s.totals[c.customer] = (s.totals[c.customer] ?? 0) + c.amount_captured;\n    }\n    if (body.has_more) {\n      if (!body.data.length || !body.data.at(-1).id) throw Error(\"Invalid Stripe next page\");\n      s.cursor = body.data.at(-1).id;\n    } else {\n      s.customers = Object.keys(s.totals);\n      s.index = 0;\n      s.phase = \"customer\";\n    }\n  } else if (kind === \"customer\") {\n    if (statusCode !== 200) throw Error(\"Stripe customer read failed\");\n    const id = s.customers[s.index];\n    if (body.id !== id) throw Error(\"Stripe customer association mismatch\");\n    if (body.email) s.emails[body.email] = (s.emails[body.email] ?? 0) + s.totals[id];\n    s.index++;\n  } else if (kind === \"upsert\") {\n    if (\n      statusCode < 200 ||\n      statusCode >= 300 ||\n      (body.status === \"COMPLETE\" && body.numErrors > 0) ||\n      !Array.isArray(body.results) ||\n      body.results.length !== 1\n    )\n      throw Error(\"Inspect HubSpot contact write \" + s.pending);\n    s.pending = null;\n    s.index++;\n  } else throw Error(\"Unexpected step\");\n  await ctx.state.set(\"stripe-spend\", s);\n  return { ok: true };\n}\n\nexport default async function run({ statusCode, body }, ctx) {\n  return result({ kind: \"property\", statusCode, body }, ctx);\n}\n"
      },
