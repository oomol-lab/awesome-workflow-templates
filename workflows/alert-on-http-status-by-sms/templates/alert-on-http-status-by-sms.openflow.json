    "modules": {
      "n_7e9d20ced39ab10d": {
        "name": "Prepare the HTTP target",
        "imports": [],
        "source": "export default function hop({ initialUrl, previousState }) {\n  const candidate = previousState?.nextUrl || initialUrl;\n  let url;\n  try {\n    url = new URL(candidate);\n  } catch {\n    throw Error(\"Configure a valid HTTP or HTTPS target URL\");\n  }\n  if (![\"http:\", \"https:\"].includes(url.protocol) || url.username || url.password)\n    throw Error(\"Configure an HTTP or HTTPS URL without credentials\");\n  return { url: url.toString() };\n}\n"
      },
      "n_95feb37df67231f1": {
        "name": "Evaluate the HTTP response",
        "imports": [],
        "source": "export default function status({ url, statusCode, headers, previousState }) {\n  if (!Number.isInteger(statusCode) || statusCode < 100 || statusCode > 599)\n    throw Error(\"Invalid HTTP status\");\n  const hops = previousState?.hops ?? 0;\n  if (!Number.isInteger(hops) || hops < 0) throw Error(\"Invalid redirect state\");\n  if (\n    statusCode >= 300 &&\n    statusCode < 400 &&\n    typeof headers?.location === \"string\" &&\n    headers.location\n  ) {\n    if (hops >= 21) throw Error(\"Too many redirects\");\n    let target;\n    try {\n      target = new URL(headers.location, url);\n    } catch {\n      throw Error(\"Invalid redirect URL\");\n    }\n    if (![\"http:\", \"https:\"].includes(target.protocol) || target.username || target.password)\n      throw Error(\"Invalid redirect URL\");\n    return { state: { hops: hops + 1, nextUrl: target.toString() }, phase: \"follow\" };\n  }\n  return { state: { hops, nextUrl: \"\" }, phase: statusCode !== 200 ? \"send\" : \"ok\" };\n}\n"
      }
    }
