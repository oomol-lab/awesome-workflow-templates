    "modules": {
      "n_caedc5d8b4958496": {
        "name": "Select next unseen RSS item",
        "imports": [],
        "source": "function decodeEntities(s) {\n  return String(s ?? \"\")\n    .replace(/<!\\[CDATA\\[([\\s\\S]*?)\\]\\]>/g, \"$1\")\n    .replace(/&amp;/g, \"&\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\")\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .trim();\n}\n\nfunction extractTag(block, tag) {\n  const m = block.match(new RegExp(\"<\" + tag + \"(?:\\\\s[^>]*)?>([\\\\s\\\\S]*?)<\\\\/\" + tag + \">\", \"i\"));\n  return m ? decodeEntities(m[1]) : \"\";\n}\n\nfunction parseFeed(xml) {\n  const text = String(xml ?? \"\");\n  const blocks =\n    text.match(/<item(?:\\s[^>]*)?>[\\s\\S]*?<\\/item>|<entry(?:\\s[^>]*)?>[\\s\\S]*?<\\/entry>/gi) ?? [];\n  const items = [];\n  for (const b of blocks) {\n    const title = extractTag(b, \"title\");\n    let link = extractTag(b, \"link\");\n    if (!link) {\n      const href = b.match(/<link[^>]*\\bhref=[\"']([^\"']+)[\"']/i);\n      if (href) link = decodeEntities(href[1]);\n    }\n    const rawId = extractTag(b, \"guid\") || extractTag(b, \"id\") || link;\n    const shortId = rawId.split(\"/\").pop() || rawId;\n    if (shortId && (title || link)) {\n      items.push({ id: shortId, title, url: link });\n    }\n  }\n  return items;\n}\n\nexport default async function selectNext({ xml, previous }, context) {\n  let queue;\n  if (previous && Array.isArray(previous.queue)) {\n    queue = previous.queue;\n  } else {\n    const saved = await context.state.get(\"rss-to-mastodon:last-id\");\n    const lastId = saved != null ? String(saved) : \"\";\n    const parsed = parseFeed(xml);\n    const fresh = [];\n    for (const item of parsed) {\n      if (lastId && item.id === lastId) break;\n      fresh.push(item);\n    }\n    queue = fresh.reverse();\n  }\n  if (queue.length === 0) {\n    return {\n      hasMore: false,\n      itemId: \"\",\n      postBody: {},\n      state: { queue: [] },\n    };\n  }\n  const [current, ...rest] = queue;\n  return {\n    hasMore: true,\n    itemId: current.id,\n    postBody: { status: `${current.title} \\n${current.url}` },\n    state: { queue: rest },\n  };\n}\n"
      },
      "n_846c5d988a8f34bd": {
        "name": "Record posted RSS ID",
        "imports": [],
        "source": "export default async function saveCheckpoint({ itemId, response }, context) {\n  if (!itemId) throw new Error(\"Missing RSS item ID for checkpoint\");\n  await context.state.set(\"rss-to-mastodon:last-id\", itemId);\n  return { savedId: itemId, statusId: String(response?.id ?? \"\") };\n}\n"
      }
