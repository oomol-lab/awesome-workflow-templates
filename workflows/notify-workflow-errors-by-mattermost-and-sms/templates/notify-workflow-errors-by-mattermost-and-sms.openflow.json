    "modules": {
      "n_ccc514a4b913e69a": {
        "name": "Prepare error alerts",
        "imports": [],
        "source": "export default function workflowErrorAlert({ workflow, error, channelId, to, from }) {\n  if (\n    !workflow ||\n    typeof workflow.name !== \"string\" ||\n    !workflow.name ||\n    typeof workflow.flowId !== \"string\" ||\n    !workflow.flowId\n  )\n    throw Error(\"Missing workflow identity\");\n  if (\n    typeof channelId !== \"string\" ||\n    !channelId.trim() ||\n    channelId === \"YOUR_MATTERMOST_CHANNEL_ID\"\n  )\n    throw Error(\"Configure Mattermost channel\");\n  for (const n of [to, from])\n    if (typeof n !== \"string\" || !/^\\+[1-9]\\d{7,14}$/.test(n))\n      throw Error(\"Configure Twilio numbers in E.164 format\");\n  const name = workflow.name.replace(/[\\r\\n]+/g, \" \"),\n    id = workflow.flowId.replace(/[\\r\\n]+/g, \" \"),\n    node = typeof error?.nodeId === \"string\" && error.nodeId ? error.nodeId : \"not available\",\n    base = `The workflow named '${name}' with the ID ${id} has encountered an error.`;\n  return {\n    channelId,\n    to,\n    from,\n    sms: base,\n    message: base + \" The failed node ID was \" + node + \".\",\n  };\n}\n"
      }
    }
