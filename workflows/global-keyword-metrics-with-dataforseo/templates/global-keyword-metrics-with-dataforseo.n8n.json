    {
      "id": "global-keyword-metrics-with-dataforseo-volume",
      "name": "Get keyword volume",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.dataforseo.com/v3/keywords_data/google_ads/search_volume/live",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{keywords: [$(\"Keyword Query Extraction & Cleaning Agent\").first().json.output.trim()]}]) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "global-keyword-metrics-with-dataforseo-ideas",
      "name": "Get related keywords",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.dataforseo.com/v3/keywords_data/google_ads/keywords_for_keywords/live",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{keywords: [$(\"Keyword Query Extraction & Cleaning Agent\").first().json.output.trim()]}]) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "global-keyword-metrics-with-dataforseo-select",
      "name": "Select keyword metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function result({ keyword, volume, ideas, volumeStatus, ideasStatus }) {\n  function task(body, status) {\n    if (\n      status < 200 ||\n      status >= 300 ||\n      !body ||\n      body.status_code !== 20000 ||\n      !Array.isArray(body.tasks) ||\n      body.tasks[0]?.status_code !== 20000 ||\n      !Array.isArray(body.tasks[0].result)\n    )\n      throw Error(\"Keyword API failed\");\n    return body.tasks[0].result;\n  }\n  const main = task(volume, volumeStatus).find(\n      (x) => String(x.keyword).toLowerCase() === keyword.toLowerCase(),\n    ),\n    related = task(ideas, ideasStatus)\n      .filter((x) => String(x.keyword).toLowerCase() !== keyword.toLowerCase())\n      .slice(0, 10);\n  function fields(x) {\n    if (!x) return null;\n    return {\n      keyword: x.keyword,\n      avg_monthly_searches: x.search_volume ?? null,\n      competition_index: x.competition_index ?? null,\n      competition_value: x.competition ?? null,\n      high_cpc: x.high_top_of_page_bid ?? null,\n      low_cpc: x.low_top_of_page_bid ?? null,\n    };\n  }\n  if (!main) throw Error(\"No metrics for requested keyword\");\n  return { data: [fields(main), ...related.map(fields)] };\n}\n\nreturn {\n  json: result({\n    keyword: $(\"Keyword Query Extraction & Cleaning Agent\").first().json.output.trim(),\n    volume: $(\"Get keyword volume\").first().json,\n    ideas: $json,\n    volumeStatus: 200,\n    ideasStatus: 200,\n  }),\n};\n"
      }
    },
    {
      "id": "d0cbe978-040d-4663-895e-85844e203773",
      "name": "Keyword Data Response Formatter",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        980,
        -60
      ],
      "parameters": {
        "text": "Provide reponse according to the system message. ",
        "options": {
          "systemMessage": "=Format the keyword metrics clearly, preserving values and labeling missing data. Do not invent metrics. {{ JSON.stringify($json.data) }}"
        },
        "promptType": "define"
      },
      "typeVersion": 1.8
    },
