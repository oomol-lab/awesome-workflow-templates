    "modules": {
      "n_e1585af51d853ce5": {
        "name": "Select Checkout Session",
        "imports": [],
        "source": "export default function checkoutRequest({body,eventId}) {if(body?.type!=='checkout.session.completed'||body.id!==eventId||typeof eventId!=='string'||!eventId)throw Error('Invalid Stripe event');const sessionId=body.data?.object?.id;if(typeof sessionId!=='string'||!/^cs_(?:test|live)_[A-Za-z0-9]+$/.test(sessionId))throw Error('Invalid Checkout Session ID');return {sessionId,endpoint:'/v1/checkout/sessions/'+encodeURIComponent(sessionId)};}\n"
      },
      "n_210150110bf9bfdf": {
        "name": "Extract customer and product",
        "imports": [],
        "source": "export default function checkoutResult({body,statusCode,bodyEncoding,sessionId}) {if(statusCode<200||statusCode>=300||bodyEncoding!=null||!body||typeof body!=='object'||Array.isArray(body)||body.id!==sessionId)throw Error('Stripe did not return the requested Checkout Session');const details=body.customer_details;if(details!=null&&(typeof details!=='object'||Array.isArray(details)))throw Error('Invalid customer details');const rows=body.line_items?.data;if(!Array.isArray(rows))throw Error('Expanded line items are missing');const text=(v)=>{if(v==null)return null;if(typeof v!=='string')throw Error('Invalid Checkout Session field');return v};return {customerName:text(details?.name),customerEmail:text(details?.email),productDescription:text(rows[0]?.description)};}\n"
      }
    }
