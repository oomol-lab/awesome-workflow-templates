{
  "name": "Index Notion Pages in Supabase",
  "tags": [],
  "nodes": [
    {
      "id": "index-notion-pages-in-supabase-0",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {},
        "model": "text-embedding-3-small"
      },
      "typeVersion": 1.2
    },
    {
      "id": "index-notion-pages-in-supabase-1",
      "name": "Token Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterTokenSplitter",
      "position": [
        220,
        0
      ],
      "parameters": {
        "chunkSize": 256,
        "chunkOverlap": 30
      },
      "typeVersion": 1
    },
    {
      "id": "index-notion-pages-in-supabase-2",
      "name": "Notion - Page Added Trigger",
      "type": "n8n-nodes-base.notionTrigger",
      "position": [
        440,
        0
      ],
      "parameters": {
        "simple": false,
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_NOTION_DATABASE_ID"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "index-notion-pages-in-supabase-3",
      "name": "Notion - Retrieve Page Content",
      "type": "n8n-nodes-base.notion",
      "position": [
        660,
        0
      ],
      "parameters": {
        "blockId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true,
        "simplifyOutput": false
      },
      "typeVersion": 2.2,
      "alwaysOutputData": true
    },
    {
      "id": "index-notion-pages-in-supabase-4",
      "name": "Create metadata and load content",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "position": [
        880,
        0
      ],
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "pageId",
                "value": "={{ $(\"Loop pages\").item.json.id }}"
              },
              {
                "name": "createdTime",
                "value": "={{ $(\"Loop pages\").item.json.created_time }}"
              },
              {
                "name": "pageTitle",
                "value": "={{ (Object.values($(\"Loop pages\").item.json.properties).find(p=>p.type===\"title\")?.title??[]).map(x=>x.plain_text ?? x.text?.content ?? \"\").join(\"\") }}"
              }
            ]
          }
        },
        "jsonData": "={{ $json.text }}",
        "jsonMode": "expressionData"
      },
      "typeVersion": 1
    },
    {
      "id": "index-notion-pages-in-supabase-5",
      "name": "Supabase Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "insert",
        "options": {},
        "tableName": {
          "__rl": true,
          "mode": "id",
          "value": "documents"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Loop pages",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "index-notion-pages-in-supabase-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Collect page text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const blocks = $input.all().map((x) => x.json);\nconst text = blocks\n  .filter((b) => ![\"image\", \"video\"].includes(b.type))\n  .map((b) =>\n    [\"child_page\", \"child_database\"].includes(b.type)\n      ? (b[b.type]?.title ?? \"\")\n      : (b[b.type]?.rich_text ?? []).map((x) => x.plain_text ?? x.text?.content ?? \"\").join(\"\"),\n  )\n  .filter(Boolean)\n  .join(\"\\n\");\nreturn [{ json: { text }, pairedItem: { item: 0 } }];\n"
      },
      "id": "index-notion-pages-in-supabase-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Has text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "index-notion-pages-in-supabase-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "No prior page insert",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ \"notion:\" + $(\"Loop pages\").item.json.id }}"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "index-notion-pages-in-supabase-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Check insert status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect Supabase before retry\");\nreturn { json: { skip: $json.status === \"done\" } };\n"
      },
      "id": "index-notion-pages-in-supabase-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Already indexed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "index-notion-pages-in-supabase-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Reserve page insert",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ \"notion:\" + $(\"Loop pages\").item.json.id }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-notion-pages-in-supabase-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Restore page text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Collect page text\").item.json };\n"
      },
      "id": "index-notion-pages-in-supabase-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Gather insert result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (!$input.all().length) throw Error(\"Unknown insert outcome\");\nreturn [{ json: { ok: true }, pairedItem: { item: 0 } }];\n"
      },
      "id": "index-notion-pages-in-supabase-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Confirm page insert",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $(\"Reserve page insert\").item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-notion-pages-in-supabase-15",
      "position": [
        3300,
        0
      ]
    }
  ],
