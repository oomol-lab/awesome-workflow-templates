    "modules": {
      "n_047e03f84abcb178": {
        "name": "Upload background image",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async function upload(\n  { backgroundUrl, acknowledge, resolution, recoveredUrl },\n  ctx,\n) {\n  const u = new URL(backgroundUrl);\n  if (u.protocol !== \"https:\") throw Error(\"Background must be an HTTPS URL\");\n  const key = \"caption-upload:\" + createHash(\"sha256\").update(u.href).digest(\"hex\");\n  let state = await ctx.state.get(key);\n  if (state?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending Cloudinary upload \" + key);\n    if (resolution === \"confirmed\") {\n      const r = new URL(recoveredUrl);\n      if (\n        r.protocol !== \"https:\" ||\n        r.hostname !== \"res.cloudinary.com\" ||\n        !r.pathname.includes(\"/image/upload/\")\n      )\n        throw Error(\"Enter the verified Cloudinary image URL\");\n      state = { status: \"done\", asset: { secureUrl: r.href } };\n      await ctx.state.set(key, state);\n      return { asset: state.asset };\n    }\n  }\n  if (state?.status === \"done\") return { asset: state.asset };\n  await ctx.state.set(key, { status: \"pending\" });\n  const r = await ctx.actions.call(\"cloudinary.upload_asset\", {\n    resourceType: \"image\",\n    fileUrl: u.href,\n  });\n  const a = r?.asset;\n  if (!a?.assetId || !a?.publicId || !a?.secureUrl) throw Error(\"Cloudinary upload not confirmed\");\n  const asset = { secureUrl: a.secureUrl };\n  await ctx.state.set(key, { status: \"done\", asset });\n  return { asset };\n}\n"
      },
      "n_550b3691d1f24761": {
        "name": "Prepare image for Gemini",
        "imports": [],
        "source": "export default async function prepare({ asset }, ctx) {\n  const u = new URL(asset.secureUrl);\n  if (\n    u.protocol !== \"https:\" ||\n    u.hostname !== \"res.cloudinary.com\" ||\n    !u.pathname.includes(\"/image/upload/\")\n  )\n    throw Error(\"Invalid Cloudinary URL\");\n  const infoUrl = new URL(u);\n  infoUrl.pathname = infoUrl.pathname.replace(\"/image/upload/\", \"/image/upload/fl_getinfo/\");\n  const ir = await ctx.fetch(infoUrl.href);\n  if (!ir.ok) throw Error(\"Image dimensions unavailable\");\n  const info = await ir.json(),\n    width = info?.input?.width,\n    height = info?.input?.height;\n  if (!Number.isInteger(width) || !Number.isInteger(height) || width < 1 || height < 1)\n    throw Error(\"Invalid image dimensions\");\n  const small = new URL(u);\n  small.pathname = small.pathname.replace(\n    \"/image/upload/\",\n    \"/image/upload/c_limit,w_512,h_512/f_jpg/\",\n  );\n  const r = await ctx.fetch(small.href);\n  if (!r.ok || !(r.headers.get(\"content-type\") ?? \"\").startsWith(\"image/jpeg\"))\n    throw Error(\"Image preview unavailable\");\n  const image = new Uint8Array(await r.arrayBuffer());\n  if (!image.length) throw Error(\"Empty preview\");\n  return {\n    width,\n    height,\n    body: {\n      contents: [\n        {\n          parts: [\n            {\n              text: \"Generate an appropriate caption for this image, considering who, when, where and context. Give it a punny title.\",\n            },\n            {\n              inline_data: { mime_type: \"image/jpeg\", data: Buffer.from(image).toString(\"base64\") },\n            },\n          ],\n        },\n      ],\n      generationConfig: {\n        response_mime_type: \"application/json\",\n        response_schema: {\n          type: \"OBJECT\",\n          properties: { caption_title: { type: \"STRING\" }, caption_text: { type: \"STRING\" } },\n          required: [\"caption_title\", \"caption_text\"],\n        },\n      },\n    },\n  };\n}\n"
      },
      "n_2c0d2c9269bc1549": {
        "name": "Read generated caption",
        "imports": [],
        "source": "export default function parse({ body, statusCode, bodyEncoding }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    !body ||\n    typeof body !== \"object\"\n  )\n    throw Error(\"Caption generation failed\");\n  const c = body.candidates?.[0];\n  if (c?.finishReason !== \"STOP\") throw Error(\"Caption generation incomplete\");\n  const output = JSON.parse((c.content?.parts ?? []).map((p) => p.text ?? \"\").join(\"\"));\n  if (\n    typeof output.caption_title !== \"string\" ||\n    typeof output.caption_text !== \"string\" ||\n    !output.caption_title ||\n    !output.caption_text\n  )\n    throw Error(\"Invalid caption\");\n  return { title: output.caption_title, caption: output.caption_text };\n}\n"
      },
      "n_f5ee47c3baddcfa7": {
        "name": "Overlay caption on image",
        "imports": [],
        "source": "export default async function render({ asset, width, height, title, caption }, ctx) {\n  const u = new URL(asset.secureUrl);\n  if (\n    u.protocol !== \"https:\" ||\n    u.hostname !== \"res.cloudinary.com\" ||\n    !u.pathname.includes(\"/image/upload/\")\n  )\n    throw Error(\"Invalid Cloudinary URL\");\n  const font = Math.max(1, Math.round(height / 35)),\n    max = Math.max(1, Math.round(width / font) * 2),\n    text = '\"' + title + '\". ' + caption,\n    lines = Math.max(1, Math.round(text.length / max)),\n    vertical = height * 0.02,\n    horizontal = width * 0.02,\n    bar = Math.max(1, Math.min(height, Math.round(vertical * 2.5 + lines * font))),\n    pad = Math.max(0, Math.round(vertical / 2)),\n    x = Math.max(0, Math.round(horizontal)),\n    layer = Buffer.from(u.href).toString(\"base64\"),\n    encoded = encodeURIComponent(encodeURIComponent(text));\n  const transform =\n    \"l_fetch:\" +\n    layer +\n    \"/c_scale,w_\" +\n    width +\n    \",h_\" +\n    bar +\n    \",e_colorize:100,co_black,o_55/fl_layer_apply,g_south/l_text:Arial_\" +\n    font +\n    \":\" +\n    encoded +\n    \",co_white/c_fit,w_\" +\n    Math.max(1, width - x * 2) +\n    \"/fl_layer_apply,g_south_west,x_\" +\n    x +\n    \",y_\" +\n    pad +\n    \"/f_jpg/\";\n  u.pathname = u.pathname.replace(\"/image/upload/\", \"/image/upload/\" + transform);\n  const r = await ctx.fetch(u.href);\n  if (!r.ok || !(r.headers.get(\"content-type\") ?? \"\").startsWith(\"image/jpeg\"))\n    throw Error(\"Captioned image unavailable\");\n  const bytes = new Uint8Array(await r.arrayBuffer());\n  if (!bytes.length) throw Error(\"Empty image\");\n  return {\n    file: await ctx.artifact.put(bytes, { name: \"captioned.jpg\", mediaType: \"image/jpeg\" }),\n  };\n}\n"
      }
    }
  },
