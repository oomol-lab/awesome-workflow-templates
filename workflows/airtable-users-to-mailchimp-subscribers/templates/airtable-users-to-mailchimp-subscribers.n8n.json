{
  "name": "Airtable Users to Mailchimp Subscribers",
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        450,
        450
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {}
          ]
        }
      },
      "typeVersion": 1,
      "id": "airtable-users-to-mailchimp-subscribers-cron"
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        650,
        450
      ],
      "parameters": {
        "table": "Users",
        "operation": "list",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "additionalOptions": {
          "fields": [
            "Name",
            "Email",
            "Interest"
          ]
        },
        "returnAll": true,
        "authentication": "airtableTokenApi"
      },
      "typeVersion": 1,
      "id": "airtable-users-to-mailchimp-subscribers-read"
    },
    {
      "id": "airtable-users-to-mailchimp-subscribers-validate",
      "name": "Validate subscriber",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all();for(const item of items){const f=item.json.fields;if(!f || typeof f.Email !== 'string' || !f.Email.trim() || typeof f.Name !== 'string' || !f.Name.trim()) throw new Error('Airtable record requires text Email and Name');}return items;"
      }
    },
    {
      "name": "Mailchimp",
      "type": "n8n-nodes-base.mailchimp",
      "position": [
        840,
        450
      ],
      "parameters": {
        "list": "YOUR_MAILCHIMP_AUDIENCE_ID",
        "email": "={{$node[\"Airtable\"].json[\"fields\"][\"Email\"]}}",
        "status": "subscribed",
        "options": {
          "tags": "Interest"
        },
        "mergeFieldsUi": {
          "mergeFieldsValues": [
            {
              "name": "FNAME",
              "value": "={{$node[\"Airtable\"].json[\"fields\"][\"Name\"]}}"
            }
          ]
        },
        "resource": "member",
        "operation": "create",
        "authentication": "oAuth2"
      },
      "typeVersion": 1,
      "id": "airtable-users-to-mailchimp-subscribers-send"
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable": {
      "main": [
        [
          {
            "node": "Validate subscriber",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate subscriber": {
      "main": [
        [
          {
            "node": "Mailchimp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
