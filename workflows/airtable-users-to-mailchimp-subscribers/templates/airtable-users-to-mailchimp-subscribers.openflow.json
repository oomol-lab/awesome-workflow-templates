    "modules": {
      "n_87b2f9eb0e540a9a": {
        "name": "Collect the next page",
        "imports": [],
        "source": "export default function collectUsers({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  const all = [...state.records, ...records];\n  if (offset === null)\n    for (const r of all) {\n      const f = r?.fields;\n      if (\n        typeof f?.Email !== \"string\" ||\n        !f.Email.trim() ||\n        typeof f?.Name !== \"string\" ||\n        !f.Name.trim()\n      )\n        throw new Error(\"Airtable record requires text Email and Name\");\n    }\n  return {\n    state: { records: all, seen: offset === null ? state.seen : [...state.seen, offset] },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_7c6771b13a55218b": {
        "name": "Prepare the next subscriber",
        "imports": [],
        "source": "export default function nextMember({ pageState, previousState, listId }) {\n  if (typeof listId !== \"string\" || !listId.trim() || listId === \"YOUR_MAILCHIMP_AUDIENCE_ID\")\n    throw new Error(\"Configure the Mailchimp audience ID\");\n  const records = pageState?.records,\n    index = previousState?.index ?? 0;\n  if (!Array.isArray(records) || !Number.isInteger(index) || index < 0 || index > records.length)\n    throw new Error(\"Invalid subscriber state\");\n  if (index === records.length)\n    return { state: { index }, more: false, endpoint: \"/unused\", body: {}, count: index };\n  const fields = records[index]?.fields,\n    email = fields?.Email,\n    name = fields?.Name;\n  if (typeof email !== \"string\" || !email.trim() || typeof name !== \"string\" || !name.trim())\n    throw new Error(\"Airtable record requires text Email and Name\");\n  return {\n    state: { index: index + 1 },\n    more: true,\n    endpoint: \"/lists/\" + encodeURIComponent(listId) + \"/members\",\n    body: {\n      email_address: email,\n      status: \"subscribed\",\n      merge_fields: { FNAME: name },\n      tags: [\"Interest\"],\n    },\n    count: index + 1,\n  };\n}\n"
      },
      "n_4765c9ca516b5e6f": {
        "name": "Check the member response",
        "imports": [],
        "source": "export default function memberResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 200 || bodyEncoding)\n    throw new Error(\"Mailchimp did not return a completed member result (HTTP \" + statusCode + \")\");\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    typeof body.id !== \"string\" ||\n    !body.id ||\n    typeof body.email_address !== \"string\" ||\n    typeof body.status !== \"string\"\n  )\n    throw new Error(\"Mailchimp returned an unexpected member response\");\n  return { member: body };\n}\n"
      }
    }
