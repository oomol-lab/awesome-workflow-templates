      "id": "monitor-usdt-balance-on-telegram-4",
      "name": "balanceChecker",
      "type": "n8n-nodes-base.code",
      "position": [
        -280,
        0
      ],
      "parameters": {
        "jsCode": "function calculateUsdt({balance,wallet,contract,previous}){\n if(typeof balance!=='string'||!/^\\d+$/.test(balance))throw Error('Invalid token balance');\n if(previous!=null&&(typeof previous!=='object'||typeof previous.key!=='string'||typeof previous.balance!=='string'||!/^\\d+$/.test(previous.balance)))throw Error('Invalid saved balance');\n const key=wallet.toLowerCase()+':'+contract.toLowerCase(),last=previous?.key===key&&typeof previous.balance==='string'&&/^\\d+$/.test(previous.balance)?previous.balance:balance;\n const amount=x=>{const s=x.replace(/^0+(?=\\d)/,'').padStart(7,'0'),whole=s.slice(0,-6),fraction=s.slice(-6).replace(/0+$/,'');return fraction?whole+'.'+fraction:whole};\n const changed=last!==balance,text=changed?`🚨 *USDT Balance Change!*\\n\\nWallet Address: ${wallet}\\n\\n🔴 Previous Balance: ${amount(last)} USDT\\n\\n🟢 New Balance: ${amount(balance)} USDT`:'Balance Unchanged. USDT balance remained stable.';\n return {next:{key,balance},changed,text};\n}\n\nconst input=$('userData').first().json, wallet=input['Your Wallet Address'],contract=input['USDT ERC-20 Token Address'];if(!/^0x[0-9a-fA-F]{40}$/.test(wallet)||!/^0x[0-9a-fA-F]{40}$/.test(contract)||$json.status!=='1')throw Error('Invalid balance response or address');const store=$getWorkflowStaticData('global'),r=calculateUsdt({balance:$json.result,wallet,contract,previous:store.usdtBalance});store.usdtBalance=r.next;return [{json:{balanceChanged:r.changed,previousBalance:r.next.balance,currentBalance:$json.result,walletAddress:wallet,text:r.text}}];"
      },
      "typeVersion": 2
    },
