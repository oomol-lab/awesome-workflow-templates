    {
      "id": "monitor-usdt-balance-on-telegram-4",
      "name": "balanceChecker",
      "type": "n8n-nodes-base.code",
      "position": [
        -280,
        0
      ],
      "parameters": {
        "jsCode": "function calculateUsdt({ balance, wallet, contract, previous }) {\n  if (typeof balance !== \"string\" || !/^\\d+$/.test(balance)) throw Error(\"Invalid token balance\");\n  if (\n    previous != null &&\n    (typeof previous !== \"object\" ||\n      typeof previous.key !== \"string\" ||\n      typeof previous.balance !== \"string\" ||\n      !/^\\d+$/.test(previous.balance))\n  )\n    throw Error(\"Invalid saved balance\");\n  const key = wallet.toLowerCase() + \":\" + contract.toLowerCase(),\n    last =\n      previous?.key === key &&\n      typeof previous.balance === \"string\" &&\n      /^\\d+$/.test(previous.balance)\n        ? previous.balance\n        : balance;\n  const amount = (x) => {\n    const s = x.replace(/^0+(?=\\d)/, \"\").padStart(7, \"0\"),\n      whole = s.slice(0, -6),\n      fraction = s.slice(-6).replace(/0+$/, \"\");\n    return fraction ? whole + \".\" + fraction : whole;\n  };\n  const changed = last !== balance,\n    text = changed\n      ? `🚨 *USDT Balance Change!*\\n\\nWallet Address: ${wallet}\\n\\n🔴 Previous Balance: ${amount(last)} USDT\\n\\n🟢 New Balance: ${amount(balance)} USDT`\n      : \"Balance Unchanged. USDT balance remained stable.\";\n  return { next: { key, balance }, changed, text };\n}\n\nconst input = $(\"userData\").first().json,\n  wallet = input[\"Your Wallet Address\"],\n  contract = input[\"USDT ERC-20 Token Address\"];\nif (\n  !/^0x[0-9a-fA-F]{40}$/.test(wallet) ||\n  !/^0x[0-9a-fA-F]{40}$/.test(contract) ||\n  $json.status !== \"1\"\n)\n  throw Error(\"Invalid balance response or address\");\nconst store = $getWorkflowStaticData(\"global\"),\n  r = calculateUsdt({ balance: $json.result, wallet, contract, previous: store.usdtBalance });\nstore.usdtBalance = r.next;\nreturn [\n  {\n    json: {\n      balanceChanged: r.changed,\n      previousBalance: r.next.balance,\n      currentBalance: $json.result,\n      walletAddress: wallet,\n      text: r.text,\n    },\n  },\n];\n"
      },
      "typeVersion": 2
    },
