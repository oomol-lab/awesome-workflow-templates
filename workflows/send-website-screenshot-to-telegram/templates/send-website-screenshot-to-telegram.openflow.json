        "name": "Validate the screenshot URL",
        "imports": [],
        "source": "  function validUrl(value) {\n    if (typeof value !== 'string' || /[\\s\\x00-\\x1f\\x7f\\\\]/.test(value) || /%(?![0-9a-f]{2})/i.test(value)) return false;\n    const match = /^https?:\\/\\/([^/?#]+)(?:[/?#].*)?$/i.exec(value);\n    if (!match || match[1].includes('@')) return false;\n    const authority = match[1];\n    let host, port;\n    if (authority.startsWith('[')) {\n      const parts = /^\\[([0-9a-f:]+)\\](?::(\\d+))?$/i.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      const halves = host.split('::');\n      if (halves.length > 2) return false;\n      const groups = halves.flatMap(part => part ? part.split(':') : []);\n      if (groups.some(group => !/^[0-9a-f]{1,4}$/i.test(group))) return false;\n      if (halves.length === 1 ? groups.length !== 8 : groups.length >= 8) return false;\n    } else {\n      const parts = /^([^:]+)(?::(\\d+))?$/.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      if (host.length > 253) return false;\n      const labels = host.replace(/\\.$/, '').split('.');\n      if (!labels.every(label => label.length > 0 && label.length <= 63 && /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(label))) return false;\n      if (labels.every(label => /^\\d+$/.test(label)) && (labels.length !== 4 || labels.some(label => Number(label) > 255))) return false;\n    }\n    return port === undefined || (port.length <= 5 && Number(port) <= 65535);\n  }\n\nfunction checkPng(bytes){if(!bytes||bytes.length<24)throw Error('Screenshot PNG header is incomplete');const sig=[137,80,78,71,13,10,26,10];if(sig.some((x,i)=>bytes[i]!==x)||bytes[8]!==0||bytes[9]!==0||bytes[10]!==0||bytes[11]!==13||String.fromCharCode(...bytes.slice(12,16))!=='IHDR')throw Error('Screenshot is not a PNG with an IHDR header');const u=i=>bytes[i]*16777216+bytes[i+1]*65536+bytes[i+2]*256+bytes[i+3],width=u(16),height=u(20);if(width!==1024||height<1||height>=20000)throw Error('Screenshot dimensions may indicate truncation or scaling');return true;}\n\nexport default async function photo({url},context){if(!validUrl(url))throw Error('Screenshot service returned no usable public image URL');let parsed;try{parsed=new URL(url)}catch{throw Error('Invalid screenshot URL')}if(parsed.protocol!=='https:'||parsed.port!==''||!['cache.screenshotbase.com','cdn.screenshotbase.com'].includes(parsed.hostname))throw Error('Screenshot host is not an allowed Screenshotbase CDN');let response;try{response=await context.fetch(url,{method:'GET',headers:{Range:'bytes=0-23'}})}catch{throw Error('Screenshot header request failed')}if(response.status!==200&&response.status!==206)throw Error('Screenshot header request failed');const bytes=new Uint8Array(await response.arrayBuffer());checkPng(bytes);return{photo:url};}\n"
