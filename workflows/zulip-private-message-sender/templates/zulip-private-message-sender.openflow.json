    "modules": {
      "n_64fa85b038bb2d1b": {
        "name": "Prepare Zulip private message",
        "imports": [],
        "source": "export default function ({ recipients, content }) {\n  if (!Array.isArray(recipients) || recipients.length === 0 || recipients.some((email) => typeof email !== 'string' || !/^[^\\s,@]+@[^\\s,@]+\\.[^\\s,@]+$/.test(email))) throw new Error('Enter one or more Zulip API recipient email addresses');\n  if (typeof content !== 'string' || content.trim().length === 0) throw new Error('Enter message content');\n  return { body: { type: 'private', to: JSON.stringify(recipients), content } };\n}\n"
      },
      "n_a60cfd895b977e34": {
        "name": "Confirm Zulip message",
        "imports": [],
        "source": "function readZulipMessage(body) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || body.result !== 'success' || !Number.isSafeInteger(body.id) || body.id < 1) throw new Error('Zulip did not confirm a sent message');\n  return body;\n}\nexport default function ({ body, statusCode }) {\n  if (statusCode !== 200) throw new Error('Zulip did not return a successful response');\n  return { message: readZulipMessage(body) };\n}\n"
      }
    }
