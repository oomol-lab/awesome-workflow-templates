      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function readZulipMessage(body) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || body.result !== 'success' || !Number.isSafeInteger(body.id) || body.id < 1) throw new Error('Zulip did not confirm a sent message');\n  return body;\n}\nfunction zulipMessageResult ({ body, statusCode }) {\n  if (statusCode !== 200) throw new Error('Zulip did not return a successful response');\n  return { message: readZulipMessage(body) };\n}\n\nreturn { json: readZulipMessage($json) };"
      }
    }
  ],
