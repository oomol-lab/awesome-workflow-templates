          }
        ]
      ]
    },
    "Create Salesforce contact": {
      "main": [
        [
          {
            "node": "Remember account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remember account": {
      "main": [
        [
          {
            "node": "Loop contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop contacts": {
      "main": [
        [],
        [
          {
            "node": "Prepare contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Account found?": {
      "main": [
        [
          {
            "node": "Set Account ID",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create Salesforce account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Import Sheet Contacts to Salesforce",
  "active": false,
