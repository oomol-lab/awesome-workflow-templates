{
  "nodes": [
    {
      "id": "import-sheet-contacts-to-salesforce-0",
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        240,
        240
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "import-sheet-contacts-to-salesforce-1",
      "name": "Read Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        460,
        240
      ],
      "parameters": {
        "options": {},
        "sheetId": "YOUR_SPREADSHEET_ID",
        "range": "Sheet1!A:Z"
      },
      "typeVersion": 2
    },
    {
      "name": "Validate contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().filter((x) => Object.values(x.json).some((v) => v !== \"\" && v != null));\nfor (const x of rows) {\n  const r = x.json;\n  if (\n    ![\"Company Name\", \"First Name\", \"Last Name\", \"Email\"].every(\n      (k) => typeof r[k] === \"string\" && r[k].trim(),\n    ) ||\n    /[\\r\\n\\x00]/.test(r[\"Company Name\"]) ||\n    !/^\\S+@\\S+\\.\\S+$/.test(r.Email)\n  )\n    throw Error(\"Every row needs company, first name, last name and email\");\n}\nreturn rows;\n"
      },
      "id": "import-sheet-contacts-to-salesforce-2"
    },
    {
      "name": "Loop contacts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "options": {}
      },
      "id": "import-sheet-contacts-to-salesforce-3"
    },
    {
      "name": "Prepare contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json,\n  accounts = $runIndex === 0 ? {} : $(\"Remember account\").first(0, $runIndex - 1).json.accounts,\n  company = r[\"Company Name\"],\n  knownId = Object.hasOwn(accounts, company) ? accounts[company] : \"\",\n  escaped = company.replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\");\nreturn [\n  {\n    json: {\n      row: { company, first: r[\"First Name\"], last: r[\"Last Name\"], email: r.Email },\n      accounts,\n      knownId,\n      soql: \"SELECT Id, Name FROM Account WHERE Name = '\" + escaped + \"' LIMIT 2\",\n    },\n  },\n];\n"
      },
      "id": "import-sheet-contacts-to-salesforce-4"
    },
    {
      "id": "import-sheet-contacts-to-salesforce-5",
      "name": "Search Salesforce accounts",
      "type": "n8n-nodes-base.salesforce",
      "position": [
        680,
        240
      ],
      "parameters": {
        "query": "={{ $json.soql }}",
        "resource": "search"
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "name": "Resolve account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $(\"Prepare contact\").first(0, $runIndex).json;\nlet a = $input.all().map((x) => x.json);\nif (a.some((x) => Object.keys(x).length > 0 && !x.Id)) throw Error(\"Invalid account result\");\na = a.filter((x) => x.Id);\nif (a.length > 1) throw Error(\"Account name is ambiguous\");\nif (a.length && typeof a[0].Name !== \"string\") throw Error(\"Invalid account name\");\na = a.filter((x) => x.Name === p.row.company);\nlet id = a[0]?.Id ?? p.knownId;\nif (id && !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(id)) throw Error(\"Invalid account ID\");\nif (p.knownId && a[0]?.Id && p.knownId !== a[0].Id) throw Error(\"Account changed during import\");\nreturn [{ json: { found: !!id, id: id ?? \"\", row: p.row } }];\n"
      },
      "id": "import-sheet-contacts-to-salesforce-6"
    },
    {
      "name": "Account found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "found",
              "leftValue": "={{ $json.found }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "import-sheet-contacts-to-salesforce-7"
    },
    {
      "id": "import-sheet-contacts-to-salesforce-8",
      "name": "Create Salesforce account",
      "type": "n8n-nodes-base.salesforce",
      "position": [
        1340,
        140
      ],
      "parameters": {
        "name": "={{ $json.row.company }}",
        "resource": "account",
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Set Account ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $input.first().json.id;\nif (typeof id !== \"string\" || !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(id))\n  throw Error(\"Missing account ID\");\nreturn [{ json: { id } }];\n"
      },
      "id": "import-sheet-contacts-to-salesforce-9"
    },
    {
      "id": "import-sheet-contacts-to-salesforce-10",
      "name": "Create Salesforce contact",
      "type": "n8n-nodes-base.salesforce",
      "position": [
        2000,
        240
      ],
      "parameters": {
        "lastname": "={{ $('Prepare contact').first(0,$runIndex).json.row.last }}",
        "resource": "contact",
        "operation": "upsert",
        "externalId": "Email",
        "externalIdValue": "={{ encodeURIComponent($('Prepare contact').first(0,$runIndex).json.row.email) }}",
        "additionalFields": {
          "email": "={{ $('Prepare contact').first(0,$runIndex).json.row.email }}",
          "firstName": "={{ $('Prepare contact').first(0,$runIndex).json.row.first }}",
          "acconuntId": "={{ $('Set Account ID').first(0,$runIndex).json.id }}"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Remember account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $(\"Prepare contact\").first(0, $runIndex).json,\n  id = $(\"Set Account ID\").first(0, $runIndex).json.id;\nreturn [{ json: { accounts: { ...p.accounts, [p.row.company]: id } } }];\n"
      },
      "id": "import-sheet-contacts-to-salesforce-11"
    }
  ],
  "connections": {
