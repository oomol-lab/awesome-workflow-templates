    "modules": {
      "n_df8ab6b93f0c2669": {
        "name": "Validate contact rows",
        "imports": [],
        "source": "export default function ({ values }) {\n  if (!Array.isArray(values)) throw Error(\"Invalid sheet data\");\n  if (!values.length) return { rows: [] };\n  const header = values[0],\n    names = [\"Company Name\", \"First Name\", \"Last Name\", \"Email\"];\n  if (!Array.isArray(header)) throw Error(\"Invalid header\");\n  const cols = names.map((n) => {\n    const i = header.indexOf(n);\n    if (i < 0 || header.lastIndexOf(n) !== i) throw Error(\"Expected unique \" + n + \" header\");\n    return i;\n  });\n  const rows = values\n    .slice(1)\n    .filter((r) => Array.isArray(r) && r.some((x) => x !== \"\" && x != null))\n    .map((r) => {\n      const [company, first, last, email] = cols.map((i) => r[i]);\n      if (\n        ![company, first, last, email].every((x) => typeof x === \"string\" && x.trim()) ||\n        /[\\r\\n\\x00]/.test(company) ||\n        !/^\\S+@\\S+\\.\\S+$/.test(email)\n      )\n        throw Error(\"Every row needs company, first name, last name and email\");\n      return { company, first, last, email };\n    });\n  return { rows };\n}\n"
      },
      "n_17b8ebe8d546519e": {
        "name": "Prepare next contact",
        "imports": [],
        "source": "export default function ({ rows, previousState }) {\n  const state = previousState ?? { index: 0, accounts: {} };\n  if (\n    !Array.isArray(rows) ||\n    !Number.isInteger(state.index) ||\n    state.index < 0 ||\n    state.index > rows.length ||\n    !state.accounts ||\n    typeof state.accounts !== \"object\"\n  )\n    throw Error(\"Invalid import state\");\n  if (state.index === rows.length)\n    return {\n      state,\n      row: {},\n      more: false,\n      known: false,\n      accountId: \"\",\n      soql: \"SELECT Id FROM Account LIMIT 1\",\n      company: \"\",\n      count: state.index,\n    };\n  const row = rows[state.index],\n    id = Object.hasOwn(state.accounts, row.company) ? state.accounts[row.company] : \"\",\n    escaped = row.company.replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\");\n  return {\n    state,\n    row,\n    more: true,\n    known: !!id,\n    accountId: id,\n    company: row.company,\n    soql: \"SELECT Id, Name FROM Account WHERE Name = '\" + escaped + \"' LIMIT 2\",\n    count: state.index,\n  };\n}\n"
      },
      "n_d944b3656f730e7c": {
        "name": "Find account",
        "imports": [],
        "source": "export default async function ({ soql, knownId, company }, ctx) {\n  const r = await ctx.actions.call(\"salesforce.query\", { soql });\n  if (!r || !Array.isArray(r.records) || r.done !== true || r.records.length > 1)\n    throw Error(\"Account name is ambiguous or query incomplete\");\n  if (!r.records.length) return { found: !!knownId, id: knownId };\n  if (typeof r.records[0]?.Name !== \"string\") throw Error(\"Invalid account name\");\n  if (r.records[0].Name !== company) return { found: !!knownId, id: knownId };\n  const id = r.records[0]?.Id;\n  if (typeof id !== \"string\" || !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(id))\n    throw Error(\"Invalid account ID\");\n  if (knownId && knownId !== id) throw Error(\"Account changed during import\");\n  return { found: true, id };\n}\n"
      },
      "n_7d9c509cca084a80": {
        "name": "Create account",
        "imports": [],
        "source": "export default async function ({ row }, ctx) {\n  const r = await ctx.actions.call(\"salesforce.create_record\", {\n    objectName: \"Account\",\n    fields: { Name: row.company },\n  });\n  if (\n    r?.success !== true ||\n    typeof r.id !== \"string\" ||\n    !/^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$/.test(r.id)\n  )\n    throw Error(\"Account creation was not confirmed\");\n  return { id: r.id };\n}\n"
      },
      "n_892153c0195691c0": {
        "name": "Use found account",
        "imports": [],
        "source": "export default function ({ id }) {\n  return { id };\n}\n"
      },
      "n_e0413e638e82d0f1": {
        "name": "Upsert contact",
        "imports": [],
