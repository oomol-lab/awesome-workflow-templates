        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $(\"Loop Over Items\").item;\nreturn [\n  {\n    json: { ...item.json, followUp: Object.keys($input.first().json).length === 0 },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "typeVersion": 2
    },
