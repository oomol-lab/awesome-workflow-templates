    {
      "name": "Require booking decision",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"choice\":{\"type\":\"string\",\"enum\":[\"book\",\"dismiss\",\"unclear\"]},\"start\":{\"type\":\"string\"},\"end\":{\"type\":\"string\"}},\"required\":[\"choice\",\"start\",\"end\"],\"additionalProperties\":false}"
      },
      "id": "review-meeting-follow-up-suggestions-23"
    },
    {
      "name": "Validate human decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const v = $json.output;\nif (!v || ![\"book\", \"dismiss\", \"unclear\"].includes(v.choice)) throw Error(\"Invalid decision\");\nif (v.choice === \"unclear\") throw Error(\"Ask the administrator to clarify\");\nif (\n  v.choice === \"book\" &&\n  (!Number.isFinite(Date.parse(v.start)) ||\n    !Number.isFinite(Date.parse(v.end)) ||\n    Date.parse(v.start) <= Date.now() ||\n    Date.parse(v.end) <= Date.parse(v.start))\n)\n  throw Error(\"Invalid time\");\nreturn [{ json: v }];\n"
      },
      "id": "review-meeting-follow-up-suggestions-24"
    },
    {
      "name": "Book confirmed slot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
