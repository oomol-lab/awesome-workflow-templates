      "n_3ed7dfd740653447": {
        "name": "Identify the Vero user",
        "imports": [],
        "source": "export default async function identify({ id, token }, context) {\n  if (typeof token !== \"string\" || !token) throw Error(\"Configure the Vero token\");\n  const response = await context.fetch(\"https://api.getvero.com/api/v2/users/track\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ auth_token: token, id }),\n  });\n  if (!response.ok) throw Error(\"Vero identify request failed\");\n  return { result: await response.json() };\n}\n"
      }
    }
