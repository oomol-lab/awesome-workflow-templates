    {
      "id": "create-recurring-airtable-tasks-from-templates-5",
      "name": "Calculate Dates",
      "type": "n8n-nodes-base.code",
      "position": [
        1880,
        660
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function prepare({ automation, template, assignee, client }) {\n  const f = automation?.fields,\n    t = template?.fields;\n  for (const r of [automation, template, assignee, client])\n    if (typeof r?.id !== \"string\" || !r.id || !r.fields) throw Error(\"Invalid Airtable record\");\n  for (const [name, record] of [\n    [\"Template\", template],\n    [\"Assigned Team Member\", assignee],\n    [\"Client\", client],\n  ])\n    if (f?.[name]?.[0] !== record.id) throw Error(\"Linked record mismatch\");\n  if (\n    typeof t?.[\"Template Name\"] !== \"string\" ||\n    !t[\"Template Name\"].trim() ||\n    typeof t.Description !== \"string\"\n  )\n    throw Error(\"Missing template name or description\");\n  const first = f[\"First Task Created\"];\n  if (![true, false, \"true\", \"false\"].includes(first)) throw Error(\"Invalid first-task flag\");\n  const base = first === false || first === \"false\" ? f[\"Start Date\"] : f[\"Last Task Created\"];\n  if (typeof base !== \"string\" || !/^\\d{4}-\\d\\d-\\d\\d$/.test(base))\n    throw Error(\"Invalid kickoff date\");\n  const num = f[\"Time Value\"],\n    soft = f[\"Days for Soft Due Date\"];\n  if (!Number.isSafeInteger(num) || !Number.isSafeInteger(soft))\n    throw Error(\"Invalid task day offsets\");\n  const d = new Date(base + \"T00:00:00.000Z\");\n  if (!Number.isFinite(d.getTime()) || d.toISOString().slice(0, 10) !== base)\n    throw Error(\"Invalid date\");\n  const add = (date, n) => new Date(date.getTime() + n * 86400000).toISOString().slice(0, 10);\n  const kickoff = add(d, first === true || first === \"true\" ? num : 0),\n    k = new Date(kickoff + \"T00:00:00Z\"),\n    hard = add(k, num),\n    today = new Date().toISOString().slice(0, 10);\n  return {\n    create: [\n      {\n        fields: {\n          Status: \"Todo\",\n          \"Task Name\": t[\"Template Name\"],\n          \"Task Description\": t.Description,\n          \"Kickoff Date\": kickoff,\n          \"Soft Due Date\": add(k, num - soft),\n          \"Hard Due Date\": hard,\n          Assignee: [assignee.id],\n          Template: [template.id],\n          Client: [client.id],\n        },\n      },\n    ],\n    update: [\n      {\n        id: automation.id,\n        fields: {\n          \"First Task Created\": \"true\",\n          \"Last Task Created\": today,\n          \"Next Task Creation Date\": add(new Date(hard + \"T00:00:00Z\"), -1),\n        },\n      },\n    ],\n    title: t[\"Template Name\"],\n  };\n}\n\nconst r = (n) => {\n  const x = $(n).item.json;\n  return { id: x.id, fields: x };\n};\nreturn {\n  json: prepare({\n    automation: r(\"Get Automated Task\"),\n    template: r(\"Get Task Template\"),\n    assignee: r(\"Get Assignee\"),\n    client: r(\"Get Client\"),\n  }),\n};\n"
      },
      "typeVersion": 2
    },
