    {
      "id": "create-recurring-airtable-tasks-from-templates-5",
      "name": "Calculate Dates",
      "type": "n8n-nodes-base.code",
      "position": [
        1880,
        660
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function prepare({automation,template,assignee,client}) {\n const f=automation?.fields,t=template?.fields;\n for(const r of [automation,template,assignee,client])if(typeof r?.id!=='string'||!r.id||!r.fields)throw Error('Invalid Airtable record');\n for(const [name,record] of [['Template',template],['Assigned Team Member',assignee],['Client',client]])if(f?.[name]?.[0]!==record.id)throw Error('Linked record mismatch');\n if(typeof t?.['Template Name']!=='string'||!t['Template Name'].trim()||typeof t.Description!=='string')throw Error('Missing template name or description');\n const first=f['First Task Created'];if(![true,false,'true','false'].includes(first))throw Error('Invalid first-task flag');\n const base=(first===false||first==='false')?f['Start Date']:f['Last Task Created'];\n if(typeof base!=='string'||!/^\\d{4}-\\d\\d-\\d\\d$/.test(base))throw Error('Invalid kickoff date');\n const num=f['Time Value'],soft=f['Days for Soft Due Date'];if(!Number.isSafeInteger(num)||!Number.isSafeInteger(soft))throw Error('Invalid task day offsets');\n const d=new Date(base+'T00:00:00.000Z');if(!Number.isFinite(d.getTime())||d.toISOString().slice(0,10)!==base)throw Error('Invalid date');\n const add=(date,n)=>new Date(date.getTime()+n*86400000).toISOString().slice(0,10);\n const kickoff=add(d,(first===true||first==='true')?num:0),k=new Date(kickoff+'T00:00:00Z'),hard=add(k,num),today=new Date().toISOString().slice(0,10);\n return {create:[{fields:{Status:'Todo','Task Name':t['Template Name'],'Task Description':t.Description,'Kickoff Date':kickoff,'Soft Due Date':add(k,num-soft),'Hard Due Date':hard,Assignee:[assignee.id],Template:[template.id],Client:[client.id]}}],update:[{id:automation.id,fields:{'First Task Created':'true','Last Task Created':today,'Next Task Creation Date':add(new Date(hard+'T00:00:00Z'),-1)}}],title:t['Template Name']};\n}\n\nconst r=n=>{const x=$(n).item.json;return {id:x.id,fields:x}}; return {json:prepare({automation:r('Get Automated Task'),template:r('Get Task Template'),assignee:r('Get Assignee'),client:r('Get Client')})};"
      },
      "typeVersion": 2
    },
