    "modules": {
      "n_0f83550f0cfd065a": {
        "name": "Prepare attachment upload",
        "imports": [],
        "source": "export default function request({ messageId, attachmentKey, filename, folderId }) {\n  if (\n    !messageId ||\n    !/^attachment_\\d+$/.test(attachmentKey) ||\n    !filename ||\n    !folderId ||\n    folderId.includes(\"YOUR_\")\n  )\n    throw Error(\"Configure the folder and retain the original attachment reference\");\n  return { body: { messageId, attachmentKey, filename, folderId } };\n}\n"
      },
      "n_cf769ca9fc28b518": {
        "name": "Return classification and upload",
        "imports": [],
        "source": "export default function result({ matched, response }) {\n  if (!matched) return { response: { matched: false } };\n  if (!response?.id) throw Error(\"Upload relay did not return a file ID\");\n  return { response: { matched: true, fileId: response.id } };\n}\n"
      }
    }
