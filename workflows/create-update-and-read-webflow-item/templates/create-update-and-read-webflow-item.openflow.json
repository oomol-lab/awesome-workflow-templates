    "modules": {
      "n_de68f483ac258cfc": {
        "name": "Prepare item details",
        "imports": [],
        "source": "export default function config({collectionId,name,slug,imageUrl}){for(const [key,v] of Object.entries({collectionId,name,slug,imageUrl}))if(typeof v!=='string'||!v.trim()||v.startsWith('YOUR_'))throw Error('Set '+key);let u;try{u=new URL(imageUrl)}catch{throw Error('Set a public HTTPS image URL')}if(u.protocol!=='https:'||u.username||u.password)throw Error('Set a public HTTPS image URL');return {collectionId,fieldData:{name,slug},imageUrl}}\n"
      },
      "n_f1db5654912bd7c1": {
        "name": "Prepare avatar update",
        "imports": [],
        "source": "export default function prepare({item,imageUrl}){if(typeof item?.id!=='string'||!item.id||typeof item?.fieldData?.name!=='string'||typeof item?.fieldData?.slug!=='string')throw Error('Created item is missing its ID, name or slug');return {itemId:item.id,fieldData:{name:item.fieldData.name,slug:item.fieldData.slug,avatar:{url:imageUrl}}}}\n"
      },
      "n_83186783f1d97d04": {
        "name": "Confirm avatar update",
        "imports": [],
        "source": "export default function confirm({item,itemId}){if(item?.id!==itemId||item?.isDraft!==false||item?.isArchived!==false||typeof item?.fieldData?.avatar?.url!=='string'||!item.fieldData.avatar.url)throw Error('Webflow did not confirm the avatar on the created item');return {itemId}}\n"
      }
    }
