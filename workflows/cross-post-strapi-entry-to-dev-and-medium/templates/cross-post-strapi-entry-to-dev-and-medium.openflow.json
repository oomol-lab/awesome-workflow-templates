    "modules": {
      "n_c6d1739e8a3da992": {
        "name": "Authorize and read entry",
        "imports": [],
        "source": "export default function input({ headers, body, expectedAuthorization }) {\n  const header = Object.entries(headers || {}).find(\n    ([k]) => k.toLowerCase() === \"authorization\",\n  )?.[1];\n  if (!expectedAuthorization || header !== expectedAuthorization) throw Error(\"Unauthorized\");\n  const entry = body?.entry;\n  if (\n    typeof entry?.Title !== \"string\" ||\n    typeof entry?.PostContent !== \"string\" ||\n    !entry.Title ||\n    !entry.PostContent ||\n    typeof entry?.Tag !== \"string\"\n  )\n    throw Error(\"Missing Strapi entry fields\");\n  return { title: entry.Title, content: entry.PostContent, tag: entry.Tag };\n}\n"
      },
      "n_494602bdc99ede5f": {
        "name": "Prepare Medium post",
        "imports": [],
        "source": "export default function post({ author, title, content }) {\n  const id = author?.data?.id;\n  if (typeof id !== \"string\" || !id) throw Error(\"Medium returned no author ID\");\n  return {\n    url: `https://api.medium.com/v1/users/${encodeURIComponent(id)}/posts`,\n    body: { title, contentFormat: \"markdown\", content, publishStatus: \"public\" },\n  };\n}\n"
      }
    }
