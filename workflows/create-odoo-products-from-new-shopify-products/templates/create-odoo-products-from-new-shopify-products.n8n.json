    {
      "id": "create-odoo-products-from-new-shopify-products-11",
      "name": "Confirm the Odoo product ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function positiveOdooId(id) {\n  if (!Number.isSafeInteger(id) || id <= 0)\n    throw new Error(\"Odoo did not confirm a valid record ID\");\n  return id;\n}\n\nconst { body, statusCode } = $input.first().json;\nif (statusCode !== 200 || !Array.isArray(body) || body.length !== 1)\n  throw new Error(\"Odoo did not confirm one product creation\");\nreturn [\n  {\n    json: {\n      state: \"created\",\n      productId: $(\"Map product and choose Odoo database\").first().json.productId,\n      odooId: positiveOdooId(body[0]),\n    },\n  },\n];\n"
      }
    },
