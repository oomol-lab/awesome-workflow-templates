{
  "name": "Create Odoo Products for New Shopify Products",
  "nodes": [
    {
      "id": "create-odoo-products-from-new-shopify-products-0",
      "name": "On new Shopify product",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "topic": "products/create",
        "authentication": "accessToken"
      }
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-1",
      "name": "Map product and choose Odoo database",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function exactProductId(value, graphId) {\n  if (typeof value === \"string\" && /^[1-9]\\d{0,19}$/.test(value)) return value;\n  if (typeof value === \"number\" && Number.isInteger(value) && value > 0) {\n    if (Number.isSafeInteger(value)) return String(value);\n    if (graphId && Number(graphId) === value) return graphId;\n  }\n  throw new Error(\"Shopify did not provide an exact parent product ID\");\n}\n\nfunction mapProduct(product) {\n  const variant = product?.variants?.[0];\n  if (!Array.isArray(product?.variants) || !variant || typeof variant !== \"object\") {\n    throw new Error(\"The Shopify product event has no first variant\");\n  }\n  const graphId =\n    typeof product.admin_graphql_api_id === \"string\"\n      ? /^gid:\\/\\/shopify\\/Product\\/([1-9]\\d{0,19})$/.exec(product.admin_graphql_api_id)?.[1]\n      : undefined;\n  const productId = exactProductId(variant.product_id, graphId);\n  if (\n    (graphId && graphId !== productId) ||\n    (product.id != null && exactProductId(product.id, graphId) !== productId)\n  ) {\n    throw new Error(\"The first Shopify variant belongs to a different parent product\");\n  }\n  if (typeof product.title !== \"string\" || !product.title.trim()) {\n    throw new Error(\"The Shopify product title is missing\");\n  }\n  const rawPrice = variant.price;\n  const price =\n    typeof rawPrice === \"string\" && /^\\d+(?:\\.\\d+)?$/.test(rawPrice.trim())\n      ? Number(rawPrice)\n      : rawPrice;\n  if (!Number.isFinite(price) || price < 0)\n    throw new Error(\"The first Shopify variant has an invalid price\");\n  const description = product.body_html ?? \"\";\n  if (typeof description !== \"string\")\n    throw new Error(\"The Shopify product description must be HTML text\");\n  return {\n    productId,\n    domain: [[\"default_code\", \"=\", productId]],\n    values: { name: product.title, default_code: productId, description, list_price: price },\n  };\n}\n\nconst instance = \"https://example.com\";\nconst database = \"your-odoo-database\";\nif (\n  !/^https:\\/\\/[a-z0-9.-]+(?::\\d{1,5})?(?:\\/[^\\s?#]*)?$/i.test(instance) ||\n  !/^[a-z0-9_.-]+$/i.test(database)\n) {\n  throw new Error(\"Enter the HTTPS Odoo instance URL and database name\");\n}\nreturn [\n  {\n    json: {\n      ...mapProduct($input.first().json),\n      base: instance.replace(/\\/+$/, \"\"),\n      database,\n    },\n  },\n];\n"
      }
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-2",
      "name": "Find the Odoo product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Map product and choose Odoo database').first().json.base + \"/json/2/product.product/search_read\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Odoo-Database",
              "value": "={{ $('Map product and choose Odoo database').first().json.database }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { domain: $json.domain, fields: [\"id\", \"default_code\"], limit: 1 } }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-3",
      "name": "Check the matching reference",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function positiveOdooId(id) {\n  if (!Number.isSafeInteger(id) || id <= 0)\n    throw new Error(\"Odoo did not confirm a valid record ID\");\n  return id;\n}\n\nfunction inspectProductLookup(records, productId) {\n  if (!Array.isArray(records) || records.length > 1)\n    throw new Error(\"Odoo returned an invalid product search result\");\n  if (records.length === 0) return { missing: true, result: { state: \"missing\", productId } };\n  const record = records[0];\n  if (record?.default_code !== productId)\n    throw new Error(\"Odoo returned a different product reference\");\n  return {\n    missing: false,\n    result: { state: \"already_exists\", productId, odooId: positiveOdooId(record.id) },\n  };\n}\n\nconst { body, statusCode } = $input.first().json;\nif (statusCode !== 200) throw new Error(\"Odoo did not confirm the product lookup\");\nreturn [\n  {\n    json: inspectProductLookup(\n      body,\n      $(\"Map product and choose Odoo database\").first().json.productId,\n    ),\n  },\n];\n"
      }
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-4",
      "name": "Odoo product missing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "missing-odoo-product",
              "leftValue": "={{ $json.missing }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-5",
      "name": "Return the existing product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: $input.first().json.result }];\n"
      }
    },
