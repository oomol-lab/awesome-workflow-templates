      "alwaysOutputData": true
    },
    {
      "id": "create-odoo-products-from-new-shopify-products-7",
      "name": "Check for a pending creation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const productId = $(\"Map product and choose Odoo database\").first().json.productId;\nconst result = $input.first().json;\nif (Object.keys(result).length) {\n  if (result.product_key !== productId)\n    throw new Error(\"The reservation lookup returned the wrong product\");\n  throw new Error(\n    \"Odoo product \" +\n      productId +\n      \" has a pending create. Check its Odoo Internal Reference before retrying.\",\n  );\n}\nreturn [{ json: { productId } }];\n"
      }
    },
