    "modules": {
      "n_2356660efcf7f90f": {
        "name": "Configure list and contact",
        "imports": [],
        "source": "export default function prepare({ list, email, company }) {\n  return {\n    listBody: { name: list },\n    email,\n    updateBody: { contact: { Email: email, Company: company } },\n  };\n}\n"
      },
      "n_06b9b922e327de54": {
        "name": "Prepare list contact",
        "imports": [],
        "source": "export default function prepare({ response, email }) {\n  const id = response?.list_id;\n  if (typeof id !== \"string\" || !id)\n    throw Error(\"List creation did not return an ID; inspect before rerunning\");\n  return { id, body: { contact: { Email: email, _autopilot_list: id } } };\n}\n"
      },
      "n_b185ab8955d7b41e": {
        "name": "Select contacts page",
        "imports": [],
        "source": "export default function page({ id, previous }) {\n  const state = previous ?? { bookmark: null, contacts: [] };\n  return {\n    url:\n      \"https://api2.autopilothq.com/v1/list/\" +\n      encodeURIComponent(id) +\n      \"/contacts\" +\n      (state.bookmark == null ? \"\" : \"/\" + encodeURIComponent(state.bookmark)),\n    contacts: state.contacts,\n  };\n}\n"
      },
      "n_43ea7b5d1718d4b7": {
        "name": "Collect contacts",
        "imports": [],
        "source": "export default function collect({ response, contacts }) {\n  if (!Array.isArray(response?.contacts))\n    throw Error(\"Autopilot contacts response missing contacts\");\n  const all = [...contacts, ...response.contacts],\n    bookmark = response.bookmark;\n  return {\n    more: bookmark !== undefined,\n    state: { contacts: all, bookmark: bookmark ?? null },\n    contacts: all,\n  };\n}\n"
      }
    }
