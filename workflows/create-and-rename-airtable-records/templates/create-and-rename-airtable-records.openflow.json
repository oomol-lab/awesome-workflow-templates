      "n_f0fc655209a2c0f0": {
        "name": "Collect matching records",
        "imports": [],
        "source": "export default function collectImagePages({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  return {\n    state: {\n      records: [...state.records, ...records],\n      seen: offset === null ? state.seen : [...state.seen, offset],\n    },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_4b200a50bce78390": {
        "name": "Prepare rename batch",
        "imports": [],
        "source": "export default function next({ pageState, previousState, updated }) {\n  const rows = pageState?.records;\n  if (!Array.isArray(rows)) throw Error(\"Missing records\");\n  const state = previousState ?? { index: 0, updated: [] };\n  if (previousState) {\n    if (!Array.isArray(updated)) throw Error(\"Missing update response\");\n    state.updated.push(...updated);\n    state.index += 10;\n  }\n  if (state.index > rows.length + 9) throw Error(\"Invalid update state\");\n  const batch = rows.slice(state.index, state.index + 10).map((r) => {\n    if (typeof r.id !== \"string\" || !r.id) throw Error(\"Missing record ID\");\n    return { id: r.id, fields: { Name: \"nodemation\" } };\n  });\n  return {\n    state,\n    more: batch.length > 0,\n    records: batch.length ? batch : [{ id: \"rec_placeholder\", fields: {} }],\n    count: Math.min(state.index, rows.length),\n    updated: state.updated,\n  };\n}\n"
      }
    }
