      "n_7029425a585e8ac4": {
        "name": "Choose next website",
        "imports": [],
        "source": "export default function next({events,previous,folderId}){if(!Array.isArray(events))throw Error('Invalid sheet events');if(typeof folderId!=='string'||!folderId.trim()||folderId.startsWith('YOUR_'))throw Error('Configure the Drive folder ID');const index=previous==null?0:previous.index+1;if(!Number.isInteger(index)||index<0||index>events.length)throw Error('Invalid row progress');if(index===events.length)return{state:{index},more:false,url:'https://example.com',name:'-',parents:[folderId]};const row=events[index]?.row;if(typeof row?.Url!=='string'||!row.Url.trim()||typeof row?.Title!=='string'||!row.Title.trim())throw Error('Each row needs Url and Title');return{state:{index},more:true,url:row.Url.trim(),name:row.Title.trim()+'.png',parents:[folderId]}}\n"
      },
      "n_2c8b1436e0f3de4d": {
        "name": "Read and check PNG bytes",
        "imports": [],
        "source": "  function validUrl(value) {\n    if (typeof value !== 'string' || /[\\s\\x00-\\x1f\\x7f\\\\]/.test(value) || /%(?![0-9a-f]{2})/i.test(value)) return false;\n    const match = /^https?:\\/\\/([^/?#]+)(?:[/?#].*)?$/i.exec(value);\n    if (!match || match[1].includes('@')) return false;\n    const authority = match[1];\n    let host, port;\n    if (authority.startsWith('[')) {\n      const parts = /^\\[([0-9a-f:]+)\\](?::(\\d+))?$/i.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      const halves = host.split('::');\n      if (halves.length > 2) return false;\n      const groups = halves.flatMap(part => part ? part.split(':') : []);\n      if (groups.some(group => !/^[0-9a-f]{1,4}$/i.test(group))) return false;\n      if (halves.length === 1 ? groups.length !== 8 : groups.length >= 8) return false;\n    } else {\n      const parts = /^([^:]+)(?::(\\d+))?$/.exec(authority);\n      if (!parts) return false;\n      host = parts[1]; port = parts[2];\n      if (host.length > 253) return false;\n      const labels = host.replace(/\\.$/, '').split('.');\n      if (!labels.every(label => label.length > 0 && label.length <= 63 && /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(label))) return false;\n      if (labels.every(label => /^\\d+$/.test(label)) && (labels.length !== 4 || labels.some(label => Number(label) > 255))) return false;\n    }\n    return port === undefined || (port.length <= 5 && Number(port) <= 65535);\n  }\n\nfunction checkPng(bytes){if(!bytes||bytes.length<24)throw Error('Screenshot PNG header is incomplete');const sig=[137,80,78,71,13,10,26,10];if(sig.some((x,i)=>bytes[i]!==x)||bytes[8]!==0||bytes[9]!==0||bytes[10]!==0||bytes[11]!==13||String.fromCharCode(...bytes.slice(12,16))!=='IHDR')throw Error('Screenshot is not a PNG with an IHDR header');const u=i=>bytes[i]*16777216+bytes[i+1]*65536+bytes[i+2]*256+bytes[i+3],width=u(16),height=u(20);if(width!==1024||height<1||height>=20000)throw Error('Screenshot dimensions may indicate truncation or scaling');return true;}\n\nimport{Buffer}from'node:buffer';\nexport default async function content({url},context){if(!validUrl(url))throw Error('Invalid screenshot URL');const u=new URL(url);if(u.protocol!=='https:'||u.port!==''||!['cache.screenshotbase.com','cdn.screenshotbase.com'].includes(u.hostname))throw Error('Unexpected screenshot host');const r=await context.fetch(url,{method:'GET'});if(!r.ok)throw Error('Screenshot download failed');const bytes=Buffer.from(await r.arrayBuffer());checkPng(bytes);if(bytes.length<36||bytes.subarray(bytes.length-8,bytes.length-4).toString('ascii')!=='IEND')throw Error('Screenshot PNG is incomplete');const length=r.headers.get('content-length');if(length!=null&&Number(length)!==bytes.length)throw Error('Screenshot download length mismatch');return{contentBase64:bytes.toString('base64')}}\n"
      },
