        "source": "import { createHash } from \"node:crypto\";\nexport default function next({ rows, previous, runId, base }) {\n  if (!/^[-A-Za-z0-9_]{8,128}$/.test(runId) || !/^https:\\/\\//.test(base))\n    throw Error(\"Invalid run ID or Shopware URL\");\n  let [head, ...input] = rows || [];\n  let data = input.filter((r) => r.some((v) => v !== \"\" && v != null));\n  if (!head?.includes(\"name\")) throw Error(\"Sheet must include name\");\n  let names = data.map((r) => String(r[head.indexOf(\"name\")] || \"\").trim());\n  if (names.some((x) => !x) || new Set(names).size !== names.length)\n    throw Error(\"Names must be unique and non-empty\");\n  let i = previous?.index ?? 0;\n  if (i >= data.length)\n    return {\n      state: { index: i },\n      more: false,\n      key: \"\",\n      url: \"\",\n      logoUrl: \"\",\n      sync: {},\n      name: \"\",\n      mediaId: \"\",\n      extension: \"\",\n    };\n  let row = Object.fromEntries(head.map((h, k) => [h, data[i][k] ?? \"\"])),\n    name = String(row.name || \"\").trim();\n  if (!name) throw Error(\"Empty manufacturer name\");\n  let id = createHash(\"md5\")\n      .update(\"manufacturer-\" + name)\n      .digest(\"hex\"),\n    mediaId = createHash(\"md5\")\n      .update(\"media-\" + name)\n      .digest(\"hex\"),\n    translations = {};\n  for (let x = 1; x <= 3; x++) {\n    let language = row[\"translation_language_code_\" + x],\n      n = row[\"translation_name_\" + x],\n      d = row[\"translation_description_\" + x];\n    if (language && (n || d))\n      translations[language] = { ...(n ? { name: n } : {}), ...(d ? { description: d } : {}) };\n  }\n  let logoUrl = String(row.logo_url || \"\"),\n    extension = \"\";\n  if (logoUrl) {\n    let u = new URL(logoUrl);\n    if (u.protocol !== \"https:\") throw Error(\"Logo URL must be HTTPS\");\n    extension = (u.pathname.match(/\\.([A-Za-z0-9]{2,5})$/) || [])[1] || \"\";\n    if (!extension) throw Error(\"Logo URL requires a file extension\");\n  }\n  let payload = {\n    id,\n    name,\n    link: row.website || \"\",\n    description: row.description || \"\",\n    ...(Object.keys(translations).length ? { translations } : {}),\n    ...(logoUrl ? { media: { id: mediaId } } : {}),\n  };\n  return {\n    state: { index: i + 1 },\n    more: true,\n    key: \"shopware:\" + runId + \":\" + id,\n    url: base.replace(/\\/$/, \"\") + \"/api/_action/sync?_response=details\",\n    logoUrl,\n    sync: {\n      \"import-manufacturer\": {\n        entity: \"product_manufacturer\",\n        action: \"upsert\",\n        payload: [payload],\n      },\n    },\n    name,\n    mediaId,\n    extension,\n  };\n}\n"
      },
      "n_94ca8be194981ecd": {
        "name": "Reserve manufacturer",
        "imports": [],
        "source": "export default async function reserve({ key }, ctx) {\n  const s = await ctx.state.get(key);\n  if (s?.status === \"done\") return { skip: true };\n  if (s) throw Error(\"Inspect previous manufacturer import \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  return { skip: false };\n}\n"
      },
      "n_b28ed3541706c409": {
        "name": "Confirm manufacturer upsert",
        "imports": [],
        "source": "export default function verify({ status }) {\n  if (status < 200 || status >= 300) throw Error(\"Inspect Shopware write before retry\");\n  return { ok: true };\n}\n"
      },
      "n_658e97985b575ed7": {
        "name": "Prepare logo upload",
        "imports": [],
        "source": "export default function logo({ base, mediaId, name, extension, logoUrl }) {\n  return {\n    url:\n      base.replace(/\\/$/, \"\") +\n      \"/api/_action/media/\" +\n      encodeURIComponent(mediaId) +\n      \"/upload?extension=\" +\n      encodeURIComponent(extension) +\n      \"&fileName=\" +\n      encodeURIComponent(name),\n    body: { url: logoUrl },\n  };\n}\n"
      },
      "n_448a6e4d18b1486f": {
        "name": "Confirm logo upload",
        "imports": [],
        "source": "export default function verify({ status }) {\n  if (status < 200 || status >= 300) throw Error(\"Inspect Shopware write before retry\");\n  return { ok: true };\n}\n"
      },
      "n_409fa08bd6cf75fb": {
        "name": "Confirm manufacturer import",
        "imports": [],
        "source": "export default async function done({ key }, ctx) {\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
