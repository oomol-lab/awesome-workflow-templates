    "modules": {
      "n_fec3c2912aa607b9": {
        "name": "Prepare the next contact",
        "imports": [],
        "source": "export default function next({contacts,previousState,scheduledAt}) {\n  if(!Array.isArray(contacts)) throw Error('Invalid HubSpot contacts');\n  const index=previousState?.index ?? 0;\n  if(!Number.isSafeInteger(index)||index<0||index>contacts.length)throw Error('Invalid iteration state');\n  if(index===contacts.length)return {state:{index},more:false,old:false,current:{},url:'',count:index};\n  const c=contacts[index],t=Date.parse(c?.properties?.notes_last_contacted),now=Date.parse(scheduledAt);\n  if(typeof c?.id!=='string'||!/^\\d+$/.test(c.id)||!Number.isFinite(t)||!Number.isFinite(now))throw Error('Invalid contact or last-contacted date');\n  return {state:{index:index+1},more:true,old:t<now-30*86400000,current:{id:c.id,email:c.properties.email??'',firstName:c.properties.firstname??'',eligible:t<now-30*86400000},url:'https://api.hubapi.com/crm-associations/v1/associations/'+encodeURIComponent(c.id)+'/HUBSPOT_DEFINED/9',count:index};\n}\n"
      },
      "n_63ee232aba94abb4": {
        "name": "Check eligibility and prepare the email",
        "imports": [],
        "source": "export default function check({current,body,sender}) {\n  if(!body||!Array.isArray(body.results)||body.results.some(x=>!(Number.isSafeInteger(x)&&x>0)&&!(typeof x==='string'&&/^\\d+$/.test(x)&&x!=='0'))||typeof body.hasMore!=='boolean')throw Error('Invalid engagement response');\n  if(typeof sender!=='string'||!sender.includes('@')||sender.includes('YOUR_'))throw Error('Configure the Gmail sender address before sending');\n  const send=current.eligible && body.results.length===1 && !body.hasMore;\n  if(send&&(typeof current.email!=='string'||!current.email.includes('@')||typeof current.firstName!=='string'))throw Error('Contact needs an email and first name');\n  return {send,sender,to:send?current.email:'',subject:'Following up',body:'Hello '+current.firstName+',\\n\\nI wanted to follow up on our previous conversation.\\n\\nBest regards'};\n}\n"
      },
      "n_9716cb294404ad13": {
        "name": "Prepare the engagement",
        "imports": [],
        "source": "export default function log({current,to,subject,body,messageId,scheduledAt,sender}) {\n if(typeof messageId!=='string'||!messageId)throw Error('Gmail did not confirm sending');\n if(typeof sender!=='string'||!sender.includes('@')||sender.includes('YOUR_'))throw Error('Configure the Gmail sender address before sending');\n return {payload:{properties:{hs_timestamp:scheduledAt,hs_email_direction:'EMAIL',hs_email_status:'SENT',hs_email_subject:subject,hs_email_text:body,hs_email_headers:JSON.stringify({from:{email:sender},to:[{email:to}]})},associations:[{to:{id:current.id},types:[{associationCategory:'HUBSPOT_DEFINED',associationTypeId:198}]}]}};\n}\n"
      },
      "n_483c6c90db87ca21": {
        "name": "Confirm the engagement",
        "imports": [],
        "source": "export default function confirm({body}) {\n if(!body||typeof body.id!=='string'||!body.id)throw Error('HubSpot did not confirm the email engagement');\n return {ok:true};\n}\n"
      }
    }
