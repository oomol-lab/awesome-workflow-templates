    "modules": {
      "n_a29c97ee236a02a7": {
        "name": "Reserve registration update",
        "imports": [],
        "source": "export default async function plan({ body, values, sheet, acknowledge, resolution }, ctx) {\n  const { submissionId, stage } = body;\n  if (!submissionId || ![\"start\", \"verified\", \"use\"].includes(stage) || !/^[\\w -]+$/.test(sheet))\n    throw Error(\"Invalid submission or stage\");\n  const rows = values ?? [],\n    header = [\n      \"Submission ID\",\n      \"Firstname\",\n      \"Lastname\",\n      \"Email\",\n      \"Company\",\n      \"Verified\",\n      \"Intended Use\",\n    ];\n  if (header.some((v, i) => (rows[0] ?? [])[i] !== v))\n    throw Error(\"Configure required sheet headers\");\n  const found = [];\n  for (let i = 1; i < rows.length; i++) if (rows[i][0] === submissionId) found.push(i + 1);\n  if (found.length > 1) throw Error(\"Duplicate submission ID\");\n  const key = \"waitlist:\" + submissionId + \":\" + stage,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\")\n    return { write: false, update: false, key, range: \"Sheet1!A1:G1\", values: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending sheet write \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { write: false, update: false, key, range: \"Sheet1!A1:G1\", values: [] };\n    }\n  }\n  let row;\n  if (stage === \"start\") {\n    if (found.length) throw Error(\"Submission already exists\");\n    const email = String(body.email || \"\")\n      .trim()\n      .toLowerCase();\n    if (!email || !body.firstName || !body.lastName) throw Error(\"Missing applicant data\");\n    row = [\n      submissionId,\n      String(body.firstName),\n      String(body.lastName),\n      email,\n      String(body.company || \"\"),\n      \"false\",\n      \"\",\n    ];\n  } else {\n    if (!found.length) throw Error(\"Missing submission row\");\n    row = [...(rows[found[0] - 1] ?? [])];\n    while (row.length < 7) row.push(\"\");\n    if (stage === \"verified\") row[5] = \"true\";\n    else {\n      if (String(row[5]).toLowerCase() !== \"true\") throw Error(\"Submission not verified\");\n      row[6] = String(body.useCase ?? \"\");\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    write: true,\n    update: found.length === 1,\n    key,\n    range: \"'\" + sheet + \"'!A\" + (found[0] ?? 1) + \":G\" + (found[0] ?? 1),\n    values: [row],\n  };\n}\n"
      },
      "n_7c2d54141a192e0f": {
        "name": "Confirm registration update",
        "imports": [],
        "source": "export default async function confirm({ key, updatedRows }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Unknown sheet write\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_578296d9a93a0e24": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
  },
