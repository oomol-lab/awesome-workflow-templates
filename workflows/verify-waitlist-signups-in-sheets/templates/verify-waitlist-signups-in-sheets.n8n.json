    {
      "name": "Prepare registration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $json;\nif (!v.Firstname || !v.Lastname || !v.Email || !v.code) throw Error(\"Missing registration fields\");\nreturn {\n  json: {\n    submissionId: $execution.id,\n    firstName: String(v.Firstname),\n    lastName: String(v.Lastname),\n    email: String(v.Email).trim().toLowerCase(),\n    company: String(v[\"Company Website\"] ?? \"\"),\n    code: String(v.code),\n    startedAt: Date.now(),\n    mode: \"direct\",\n  },\n};\n"
      },
      "id": "verify-waitlist-signups-in-sheets-3",
      "position": [
        660,
        0
      ]
    },
