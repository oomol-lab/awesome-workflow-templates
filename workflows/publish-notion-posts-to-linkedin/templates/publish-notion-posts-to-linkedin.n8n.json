{
  "name": "Publish Notion Posts to LinkedIn",
  "tags": [],
  "nodes": [
    {
      "id": "publish-notion-posts-to-linkedin-0",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 15
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "publish-notion-posts-to-linkedin-1",
      "name": "query entries from Notion table for today",
      "type": "n8n-nodes-base.notion",
      "position": [
        220,
        0
      ],
      "parameters": {
        "filters": {
          "conditions": [
            {
              "key": "Date|date",
              "date": "={{ $now.toFormat(\"yyyy-MM-dd\") }}",
              "condition": "equals"
            },
            {
              "key": "Status|status",
              "condition": "does_not_equal",
              "statusValue": "Done"
            }
          ]
        },
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_NOTION_DATABASE_ID"
        },
        "filterType": "manual",
        "returnAll": true,
        "matchType": "allFilters"
      },
      "typeVersion": 2.2
    },
    {
      "name": "Process one post",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "publish-notion-posts-to-linkedin-2",
      "position": [
        440,
        0
      ]
    },
    {
      "id": "publish-notion-posts-to-linkedin-3",
      "name": "get all content from post page",
      "type": "n8n-nodes-base.notion",
      "position": [
        660,
        0
      ],
      "parameters": {
        "blockId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Process one post').item.json.id }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "publish-notion-posts-to-linkedin-4",
      "name": "Pull together all text blocks + image",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        880,
        0
      ],
      "parameters": {
        "options": {},
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "content"
            },
            {
              "fieldToAggregate": "image.file.url"
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Format LinkedIn text",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Format for LinkedIn with paragraph breaks and lists. Preserve meaning, do not invent facts: \" + $(\"Pull together all text blocks + image\").item.json.content.join(\" \") }}",
        "options": {}
      },
      "id": "publish-notion-posts-to-linkedin-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "OpenAI model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "publish-notion-posts-to-linkedin-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "id": "publish-notion-posts-to-linkedin-7",
      "name": "Initialize image upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/images?action=initializeUpload",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "LinkedIn-Version",
              "value": "202605"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"initializeUploadRequest\":{\"owner\":\"urn:li:person:YOUR_LINKEDIN_PERSON_ID\"}}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "publish-notion-posts-to-linkedin-8",
      "name": "Check upload address",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $json.value;\nif (\n  !v ||\n  typeof v.image !== \"string\" ||\n  !/^urn:li:image:/.test(v.image) ||\n  typeof v.uploadUrl !== \"string\" ||\n  !v.uploadUrl.startsWith(\"https://www.linkedin.com/dms-uploads/\")\n)\n  throw new Error(\"Unexpected LinkedIn upload response\");\nreturn { json: { image: v.image, uploadUrl: v.uploadUrl } };\n"
      }
    },
    {
      "id": "publish-notion-posts-to-linkedin-9",
      "name": "Download image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "url": "={{ $('Pull together all text blocks + image').item.json.url[0] }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "publish-notion-posts-to-linkedin-10",
      "name": "Upload image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $(\"Check upload address\").item.json.uploadUrl }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      }
    },
    {
      "name": "Post not pending",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'linkedin-notion:' + $('Process one post').item.json.id }}"
            }
          ]
