    {
      "name": "Validate relay URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { imageUrl, uploadUrl } = $json.body || {};\nif (\n  typeof imageUrl !== \"string\" ||\n  !/^https:\\/\\/[a-z0-9.-]+(?::443)?(?:[/?#]|$)/i.test(imageUrl) ||\n  typeof uploadUrl !== \"string\" ||\n  !uploadUrl.startsWith(\"https://www.linkedin.com/dms-uploads/\")\n)\n  throw Error(\"Invalid relay URLs\");\nreturn { json: { imageUrl, uploadUrl } };\n"
      },
