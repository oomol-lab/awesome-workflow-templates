        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'linkedin-notion:' + $('Process one post').item.json.id }}",
            "status": "pending-post"
          },
          "schema": []
        },
        "options": {}
      },
