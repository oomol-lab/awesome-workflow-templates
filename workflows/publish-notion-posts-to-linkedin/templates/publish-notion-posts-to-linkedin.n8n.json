    {
      "id": "publish-notion-posts-to-linkedin-13",
      "name": "Publish image post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "LinkedIn-Version",
              "value": "202605"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {author:\"urn:li:person:YOUR_LINKEDIN_PERSON_ID\",commentary:$(\"Format LinkedIn text\").item.json.output,visibility:\"PUBLIC\",distribution:{feedDistribution:\"MAIN_FEED\",targetEntities:[],thirdPartyDistributionChannels:[]},content:{media:{id:$(\"Check upload address\").item.json.image}},lifecycleState:\"PUBLISHED\",isReshareDisabledByAuthor:false} }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "name": "Verify LinkedIn receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const h = $json.headers || {};\nif ($json.statusCode < 200 || $json.statusCode >= 300 || !h[\"x-restli-id\"])\n  throw Error(\"Unknown LinkedIn post result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "publish-notion-posts-to-linkedin-14",
      "position": [
        3080,
        0
      ]
    },
