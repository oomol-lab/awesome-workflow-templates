    {
      "id": "a5bb1d44-df91-4908-ae24-cc4ac4760dab",
      "name": "Validate text request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prompts = {\n  spanish: 'Translate this message to Spanish.\\nOutput a JSON with a single field: output',\n  english: 'Translate this message to English.\\nOutput a JSON with a single field: output',\n  grammar: \"Correct grammar only, don't change the actual contents.\\nOutput a JSON with a single field: output\",\n  shorter: 'Summarize this content a little bit (5% shorter)\\nOutput a JSON with a single field: output',\n  longer: 'Make this content a little longer (5% longer)\\nOutput a JSON with a single field: output',\n};\n\nfunction prepareText({ body }) {\n  const { type, content } = body;\n  if (typeof type !== 'string' || !Object.hasOwn(prompts, type)) {\n    throw new Error('Choose spanish, english, grammar, shorter, or longer.');\n  }\n  if (typeof content !== 'string' || !content.trim()) {\n    throw new Error('content must be nonempty text.');\n  }\n  return { type, content, prompt: prompts[type] };\n}\n\nconst prepared=prepareText({body:$input.first().json.body ?? {}});\nreturn [{json:{body:{type:prepared.type,content:prepared.content}}}];\n"
      }
    },
    {
      "id": "9d49abf2-e170-493c-9d4e-a6d9d1ff3427",
      "name": "Read transformed text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function textResult({ result }) {\n  if (!result || typeof result !== 'object' || Array.isArray(result) || typeof result.output !== 'string' || !result.output.trim()) {\n    throw new Error('The model must return a nonempty output string.');\n  }\n  return { text: result.output };\n}\n\nreturn [{json:textResult({result:$input.first().json.message?.content})}];\n"
      }
    }
