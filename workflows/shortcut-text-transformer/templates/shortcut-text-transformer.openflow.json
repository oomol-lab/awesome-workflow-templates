      "n_af01827f8ebc55d7": {
        "name": "Choose text operation",
        "imports": [],
        "source": "export const prompts = {\n  spanish: 'Translate this message to Spanish.\\nOutput a JSON with a single field: output',\n  english: 'Translate this message to English.\\nOutput a JSON with a single field: output',\n  grammar: \"Correct grammar only, don't change the actual contents.\\nOutput a JSON with a single field: output\",\n  shorter: 'Summarize this content a little bit (5% shorter)\\nOutput a JSON with a single field: output',\n  longer: 'Make this content a little longer (5% longer)\\nOutput a JSON with a single field: output',\n};\n\nexport default function prepareText({ body }) {\n  const { type, content } = body;\n  if (typeof type !== 'string' || !Object.hasOwn(prompts, type)) {\n    throw new Error('Choose spanish, english, grammar, shorter, or longer.');\n  }\n  if (typeof content !== 'string' || !content.trim()) {\n    throw new Error('content must be nonempty text.');\n  }\n  return { type, content, prompt: prompts[type] };\n}\n"
      },
      "n_95958de966bb5fc5": {
        "name": "Read transformed text",
        "imports": [],
        "source": "export default function textResult({ result }) {\n  if (!result || typeof result !== 'object' || Array.isArray(result) || typeof result.output !== 'string' || !result.output.trim()) {\n    throw new Error('The model must return a nonempty output string.');\n  }\n  return { text: result.output };\n}\n"
      }
