    "modules": {
      "n_8064bbd9db923e5e": {
        "name": "Prepare newsletter subscription",
        "imports": [],
        "source": "export default function prepareNewsletterEnrollment({ body, baseId, tableIdOrName }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('Provide a signup object.');\n  const text = (value, label) => {\n    if (typeof value !== 'string' || !value.trim()) throw new Error('Provide ' + label + '.');\n    return value.trim();\n  };\n  const email = text(body.email, 'one email address'), topic = text(body.topic, 'a topic');\n  // The single-address grammar used by HTML email fields; no display names or recipient lists.\n  if (!/^[a-zA-Z0-9.!#$%&'*+\\-/=?^_`{|}~]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)*$/.test(email)) throw new Error('Provide one email address.');\n  if (email.includes(\"'\")) throw new Error('This template does not support apostrophes in email addresses.');\n  if (!['daily', 'weekly', 'surprise me'].includes(body.frequency)) throw new Error('Choose daily, weekly or surprise me.');\n  baseId = text(baseId, 'your Airtable base ID'); tableIdOrName = text(tableIdOrName, 'your subscribers table ID');\n  if (!/^app[a-zA-Z0-9]+$/.test(baseId) || !/^tbl[a-zA-Z0-9]+$/.test(tableIdOrName)) throw new Error('Configure your own Airtable base and table IDs.');\n  const fields = { Email: email, Topic: topic, Status: 'active', Interval: body.frequency === 'surprise me' ? 'surprise' : body.frequency, 'Start Day': ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date().getUTCDay()] };\n  return { baseId, tableIdOrName, data: { fields, recipient: email, subject: 'Learn something every day confirmation', message: 'This is to confirm your request to subscribe to \"Learn something every day!\" - a free service to send you facts about your favourite topics.\\n\\nTopic: ' + topic + '\\nSchedule: ' + body.frequency }, endpoint: '/v0/' + baseId + '/' + tableIdOrName, payload: { typecast: false, performUpsert: { fieldsToMergeOn: ['Email'] }, records: [{ fields }] } };\n}\n"
      },
      "n_220f63bd4faf4fbf": {
        "name": "Check subscription upsert",
        "imports": [],
        "source": "export default function assessNewsletterUpsert({ body, statusCode, bodyEncoding }) {\n  if (bodyEncoding !== null) throw new Error('Airtable returned an unexpected encoded response.');\n  if (statusCode === 200) return { needsFallback: false };\n  if (statusCode === 422 && body && typeof body === 'object' && !Array.isArray(body) && typeof body.error?.message === 'string' && body.error.message.includes('Cannot update more than one record')) return { needsFallback: true };\n  throw new Error('Airtable did not accept the subscription upsert (HTTP ' + statusCode + ').');\n}\n"
      },
      "n_860932add4e1218e": {
        "name": "Read every duplicate email match",
        "imports": [],
        "source": "export default async function readNewsletterDuplicates({ baseId, tableIdOrName, data }, context) {\n  const records = [], offsets = new Set();\n  let offset;\n  do {\n    context.signal?.throwIfAborted();\n    const page = await context.actions.call('airtable.list_records', { baseId, tableIdOrName, fields: ['Email'], filterByFormula: \"AND({Email} = '\" + data.fields.Email + \"')\", pageSize: 100, ...(offset ? { offset } : {}) });\n    if (!Array.isArray(page.records)) throw new Error('Airtable did not return matching records.');\n    records.push(...page.records);\n    const next = page.offset;\n    if (next === null || next === undefined) break;\n    if (typeof next !== 'string' || !next || offsets.has(next)) throw new Error('Airtable returned an invalid or repeated pagination offset.');\n    offsets.add(next); offset = next;\n  } while (true);\n  const first = records[0];\n  if (!first || typeof first.id !== 'string' || !/^rec[a-zA-Z0-9]+$/.test(first.id) || typeof first.fields?.Email !== 'string' || first.fields.Email.toLowerCase() !== data.fields.Email.toLowerCase()) throw new Error('Airtable did not identify the first matching subscriber.');\n  return { records: [{ id: first.id, fields: data.fields }], expectedId: first.id };\n}\n"
      },
      "n_15616977ce60b741": {
        "name": "Verify upserted subscriber",
        "imports": [],
        "source": "function verifyNewsletterSubscriber({ records, data, expectedId }) {\n  if (!Array.isArray(records) || records.length !== 1) throw new Error('Airtable did not confirm one saved subscriber.');\n  const record = records[0];\n  if (!record || typeof record.id !== 'string' || !/^rec[a-zA-Z0-9]+$/.test(record.id) || (expectedId && record.id !== expectedId) || !record.fields || Object.entries(data.fields).some(([key, value]) => record.fields[key] !== value)) throw new Error('Airtable did not confirm the saved subscription fields.');\n  return { recipient: data.recipient, subject: data.subject, message: data.message };\n}\n\nexport default function({body,data}) { return verifyNewsletterSubscriber({records:body?.records,data,expectedId:\"\"}); }\n"
      },
      "n_bd72de0239abbc14": {
        "name": "Verify first duplicate subscriber",
        "imports": [],
        "source": "export default function verifyNewsletterSubscriber({ records, data, expectedId }) {\n  if (!Array.isArray(records) || records.length !== 1) throw new Error('Airtable did not confirm one saved subscriber.');\n  const record = records[0];\n  if (!record || typeof record.id !== 'string' || !/^rec[a-zA-Z0-9]+$/.test(record.id) || (expectedId && record.id !== expectedId) || !record.fields || Object.entries(data.fields).some(([key, value]) => record.fields[key] !== value)) throw new Error('Airtable did not confirm the saved subscription fields.');\n  return { recipient: data.recipient, subject: data.subject, message: data.message };\n}\n"
      },
      "n_a62f81597c60be98": {
        "name": "Confirm email acceptance",
        "imports": [],
        "source": "export default function confirmNewsletterEnrollment({ messageId }) {\n  if (typeof messageId !== 'string' || !messageId.trim()) throw new Error('Gmail did not confirm acceptance of the confirmation email.');\n  return { body: { subscribed: true, confirmationAccepted: true } };\n}\n"
      }
    }
