    "modules": {
      "n_76a4b708c16dbfec": {
        "name": "Select workflow page",
        "imports": [],
        "source": "export default function page({ cursor }) {\n  return { cursor: cursor || null };\n}\n"
      },
      "n_7167dbc529f9e9fa": {
        "name": "Find affected expressions",
        "imports": [],
        "source": "export default function scan({ workflows, nextCursor, previous }) {\n  const matches = [...(previous?.matches ?? [])];\n  const tests = [\"beginningOf\", \"endOfMonth\", \"minus\", \"plus\"];\n  function walk(obj, w, n) {\n    if (!obj || typeof obj !== \"object\") return;\n    for (const [key, v] of Object.entries(obj)) {\n      if (typeof v === \"string\" && v.startsWith(\"={{\") && tests.some((t) => v.includes(t)))\n        matches.push({ workflowName: w, nodeName: n, parameterName: key });\n      else if (v && typeof v === \"object\") walk(v, w, n);\n    }\n  }\n  for (const w of workflows) for (const n of w.nodes ?? []) walk(n.parameters, w.name, n.name);\n  return { state: { matches }, matches, hasNext: !!nextCursor, nextCursor: nextCursor ?? \"\" };\n}\n"
      }
    }
