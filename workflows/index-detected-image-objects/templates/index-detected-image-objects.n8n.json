{
  "nodes": [
    {
      "name": "Run image indexing",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "id": "index-detected-image-objects-0",
      "position": [
        0,
        0
      ]
    },
    {
      "name": "Configure image",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "url",
              "name": "imageUrl",
              "type": "string",
              "value": "https://YOUR_IMAGE_URL"
            },
            {
              "id": "cloud",
              "name": "cloudName",
              "type": "string",
              "value": "YOUR_CLOUD_NAME"
            },
            {
              "id": "preset",
              "name": "preset",
              "type": "string",
              "value": "YOUR_UNSIGNED_PRESET"
            }
          ]
        },
        "options": {}
      },
      "id": "index-detected-image-objects-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "No prior image write",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'object-image:' + $('Configure image').first().json.imageUrl }}"
            }
          ]
        }
      },
      "id": "index-detected-image-objects-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Reserve image write",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'object-image:' + $('Configure image').first().json.imageUrl }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
