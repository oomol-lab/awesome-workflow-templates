    },
    {
      "name": "Upload source image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.cloudinary.com/v1_1/' + $('Configure image').first().json.cloudName + '/image/upload' }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $('Configure image').first().json.imageUrl }}"
            },
            {
              "name": "upload_preset",
              "value": "={{ $('Configure image').first().json.preset }}"
            }
          ]
        },
        "options": {}
      },
      "id": "index-detected-image-objects-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Fetch uploaded image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ $json.secure_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "index-detected-image-objects-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Detect objects",
      "type": "n8n-nodes-base.awsRekognition",
      "typeVersion": 1,
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "type": "detectLabels",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "minConfidence": 90
        }
      },
      "id": "index-detected-image-objects-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Prepare cropped objects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const asset = $(\"Upload source image\").first().json,\n  source = $(\"Configure image\").first().json.imageUrl,\n  labels = $input.first().json.Labels;\nif (!Array.isArray(labels) || !asset.secure_url || !asset.width || !asset.height)\n  throw Error(\"Invalid detection or asset\");\nconst rows = [];\nfor (const l of labels)\n  for (const v of l.Instances ?? []) {\n    const b = v.BoundingBox;\n    if (v.Confidence < 90 || !b) continue;\n    const x = Math.round(b.Left * asset.width),\n      y = Math.round(b.Top * asset.height),\n      width = Math.round(b.Width * asset.width),\n      height = Math.round(b.Height * asset.height);\n    if (\n      width < 1 ||\n      height < 1 ||\n      x < 0 ||\n      y < 0 ||\n      x + width > asset.width ||\n      y + height > asset.height\n    )\n      throw Error(\"Invalid crop\");\n    rows.push({\n      json: {\n        image_url: asset.secure_url.replace(\n          \"/upload/\",\n          `/upload/c_crop,x_${x},y_${y},w_${width},h_${height}/`,\n        ),\n        source_image_url: source,\n        label: l.Name,\n        metadata: JSON.stringify({ confidence: v.Confidence, box: b }),\n      },\n    });\n  }\nreturn rows.length ? rows : [{ json: { empty: true } }];\n"
      },
      "id": "index-detected-image-objects-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Has detected objects?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.empty !== true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "index-detected-image-objects-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Create object document",
      "type": "n8n-nodes-base.elasticsearch",
      "typeVersion": 1,
      "parameters": {
        "resource": "document",
        "operation": "create",
        "dataToSend": "defineBelow",
        "indexId": "YOUR_INDEX",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "image_url",
              "fieldValue": "={{ $json.image_url }}"
            },
            {
              "fieldId": "source_image_url",
              "fieldValue": "={{ $json.source_image_url }}"
            },
            {
              "fieldId": "label",
              "fieldValue": "={{ $json.label }}"
            },
            {
              "fieldId": "metadata",
              "fieldValue": "={{ $json.metadata }}"
            }
          ]
        },
        "additionalFields": {},
        "options": {}
      },
      "id": "index-detected-image-objects-9",
