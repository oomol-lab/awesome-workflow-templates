    "modules": {
      "n_84cb25407d6d75ce": {
        "name": "Upload source image",
        "imports": [],
        "source": "export default async function upload({ imageUrl, cloudName, preset }, ctx) {\n  if (!/^https:\\/\\//.test(imageUrl) || !/^[-a-zA-Z0-9_]+$/.test(cloudName) || !preset)\n    throw Error(\"Configure HTTPS image, Cloudinary and upload preset\");\n  const key = \"object-image:\" + imageUrl,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect Cloudinary and Elasticsearch before retry\");\n  if (s?.status === \"done\") return { asset: s.asset, skip: true, count: s.count };\n  await ctx.state.set(key, { status: \"pending\" });\n  const body = new URLSearchParams({ file: imageUrl, upload_preset: preset }).toString(),\n    r = await ctx.fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/x-www-form-urlencoded\" },\n      body,\n    });\n  if (!r.ok) throw Error(\"Cloudinary upload uncertain\");\n  const a = await r.json();\n  if (!a.secure_url || !a.width || !a.height) throw Error(\"Invalid Cloudinary response\");\n  return { asset: { url: a.secure_url, width: a.width, height: a.height }, skip: false, count: 0 };\n}\n"
      },
      "n_1012c74b448ae70a": {
        "name": "Return prior count",
        "imports": [],
        "source": "export default function ({ count }) {\n  return { count };\n}\n"
      },
      "n_94a7b6695c2e6d16": {
        "name": "Detect objects",
        "imports": [],
        "source": "import { createHash, createHmac } from \"node:crypto\";\nimport { Buffer } from \"node:buffer\";\nexport default async function detect(\n  { imageUrl, region, accessKeyId, secretAccessKey, sessionToken },\n  ctx,\n) {\n  if (\n    !/^https:\\/\\//.test(imageUrl) ||\n    !/^[-a-z0-9]+$/.test(region) ||\n    !accessKeyId ||\n    !secretAccessKey\n  )\n    throw Error(\"Configure HTTPS image and AWS credentials\");\n  const image = await ctx.fetch(imageUrl);\n  if (!image.ok) throw Error(\"Image download failed\");\n  const bytes = Buffer.from(await image.arrayBuffer());\n  if (!bytes.length || bytes.length > 5 * 1024 * 1024)\n    throw Error(\"Image must fit Rekognition 5 MiB limit\");\n  const service = \"rekognition\",\n    host = `rekognition.${region}.amazonaws.com`,\n    body = JSON.stringify({ Image: { Bytes: bytes.toString(\"base64\") }, MinConfidence: 90 }),\n    hash = (x) => createHash(\"sha256\").update(x).digest(\"hex\"),\n    hmac = (k, v) => createHmac(\"sha256\", k).update(v).digest(),\n    timestamp = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, \"\"),\n    date = timestamp.slice(0, 8),\n    headers = {\n      \"content-type\": \"application/x-amz-json-1.1\",\n      host,\n      \"x-amz-date\": timestamp,\n      \"x-amz-target\": \"RekognitionService.DetectLabels\",\n      ...(sessionToken ? { \"x-amz-security-token\": sessionToken } : {}),\n    },\n    names = Object.keys(headers).sort(),\n    signed = names.join(\";\"),\n    canonicalHeaders = names\n      .map((n) => n + \":\" + headers[n].trim().replace(/\\s+/g, \" \") + \"\\n\")\n      .join(\"\"),\n    scope = `${date}/${region}/${service}/aws4_request`,\n    canonical = [\"POST\", \"/\", \"\", canonicalHeaders, signed, hash(body)].join(\"\\n\"),\n    toSign = [\"AWS4-HMAC-SHA256\", timestamp, scope, hash(canonical)].join(\"\\n\"),\n    key = hmac(hmac(hmac(hmac(\"AWS4\" + secretAccessKey, date), region), service), \"aws4_request\");\n  delete headers.host;\n  headers.authorization = `AWS4-HMAC-SHA256 Credential=${accessKeyId}/${scope}, SignedHeaders=${signed}, Signature=${createHmac(\"sha256\", key).update(toSign).digest(\"hex\")}`;\n  const response = await ctx.fetch(\"https://\" + host + \"/\", { method: \"POST\", headers, body });\n  if (!response.ok) throw Error(\"Rekognition request failed\");\n  const data = await response.json();\n  if (!Array.isArray(data.Labels)) throw Error(\"Invalid detection response\");\n  const objects = [];\n  for (const label of data.Labels)\n    for (const instance of label.Instances ?? []) {\n      const b = instance.BoundingBox;\n      if (\n        instance.Confidence >= 90 &&\n        b &&\n        [b.Left, b.Top, b.Width, b.Height].every((x) => Number.isFinite(x) && x >= 0 && x <= 1)\n      )\n        objects.push({ label: label.Name, confidence: instance.Confidence, box: b });\n    }\n  return { objects };\n}\n"
      },
      "n_ed2b939993611d05": {
        "name": "Crop and index objects",
        "imports": [],
        "source": "export default async function index({ objects, imageUrl, asset, elasticUrl, elasticKey }, ctx) {\n  if (\n    !Array.isArray(objects) ||\n    !asset?.url ||\n    !asset.width ||\n    !asset.height ||\n    !/^https:\\/\\//.test(elasticUrl) ||\n    !elasticKey\n  )\n    throw Error(\"Configure asset and Elasticsearch\");\n  const batchKey = \"object-image:\" + imageUrl;\n  for (let i = 0; i < objects.length; i++) {\n    const o = objects[i],\n      b = o.box,\n      x = Math.round(b.Left * asset.width),\n      y = Math.round(b.Top * asset.height),\n      width = Math.round(b.Width * asset.width),\n      height = Math.round(b.Height * asset.height);\n    if (width < 1 || height < 1 || x + width > asset.width || y + height > asset.height)\n      throw Error(\"Invalid object crop\");\n    const image_url = asset.url.replace(\n        \"/upload/\",\n        `/upload/c_crop,x_${x},y_${y},w_${width},h_${height}/`,\n      ),\n      body = {\n        image_url,\n        source_image_url: imageUrl,\n        label: o.label,\n        metadata: JSON.stringify({ confidence: o.confidence, box: b }),\n      };\n    const r = await ctx.fetch(elasticUrl.replace(/\\/$/, \"\") + \"/_doc\", {\n      method: \"POST\",\n      headers: { authorization: \"ApiKey \" + elasticKey, \"content-type\": \"application/json\" },\n      body: JSON.stringify(body),\n    });\n    if (!r.ok) throw Error(\"Elasticsearch write uncertain\");\n  }\n  await ctx.state.set(batchKey, { status: \"done\", count: objects.length, asset });\n  return { count: objects.length };\n}\n"
      }
    }
