          ]
        },
        "operation": "update",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "threads-archive-18",
      "position": [
        4320,
        0
      ]
    }
