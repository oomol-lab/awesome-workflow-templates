        "jsCode": "const body = $('Webhook').item.json.body;\nconst name = body?.user_name;\nif (typeof name !== 'string' || !name || !Object.prototype.hasOwnProperty.call($json, name) || typeof $json[name] !== 'string' || !$json[name]) return null;\nreturn { json: { channelId: body.channel_id, roomUrl: 'https://whereby.com/' + $json[name] } };"
      }
