    "modules": {
      "n_e77637846a8a88be": {
        "name": "Select the configured room",
        "imports": [],
        "source": "export default function mattermostWebhookLink({ body, configuredUserName, roomSlug }) {\n  const userName = body?.user_name;\n  if (typeof userName !== 'string' || userName.length === 0) throw new Error('Webhook body.user_name is required');\n  if (typeof configuredUserName !== 'string' || configuredUserName.length === 0) throw new Error('Set the configured user name');\n  if (typeof roomSlug !== 'string' || !/^[A-Za-z0-9_-]+$/.test(roomSlug)) throw new Error('Set a valid Whereby room slug');\n  if (userName !== configuredUserName) throw new Error('Webhook user_name does not match the configured invite');\n  const url = 'https://whereby.com/' + roomSlug;\n  return { url, channelId: body.channel_id, props: { attachments: [{ title: 'Join the video call', title_link: url }] } };\n}\n"
      }
    }
