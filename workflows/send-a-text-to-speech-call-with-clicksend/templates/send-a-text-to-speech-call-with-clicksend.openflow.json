    "modules": {
      "n_d6f1c54ed684dfe2": {
        "name": "Prepare the voice call",
        "imports": [],
        "source": "export default function prepareVoice({request}) {\n const {Body:body,To:to,Voice:voice,Lang:language}=request??{}; let lang=language;\n if(typeof body!=='string'||!body.trim()||Array.from(body).length>600)throw Error('Enter a message of up to 600 characters');\n if(typeof to!=='string'||!/^\\+[1-9]\\d{7,14}$/.test(to))throw Error('Enter a phone number in E.164 format');\n if(!['male','female'].includes(voice))throw Error('Choose male or female');\n if(typeof lang!=='string')throw Error('Choose a language');\n lang=lang.trim();\n if(!['en-us','it-it','en-au','en-gb','de-de','es-es','fr-fr','is-is','da-dk','nl-nl','pl-pl','pt-br','ru-ru'].includes(lang))throw Error('Choose a supported language');\n return {request:{messages:[{source:'n8n',body,to,voice,lang,machine_detection:1}]}};\n}\n"
      }
    }
