    "modules": {
      "n_db771cca127c7db9": {
        "name": "Prepare form fields",
        "imports": [],
        "source": "export default function prepare({ body, templateId }) {\n  if (typeof templateId !== \"string\" || !templateId || templateId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure template document ID\");\n  if (typeof body?.name !== \"string\" || !body.name.trim()) throw Error(\"Provide name\");\n  const fields = { ...(body.fields ?? {}), name: body.name };\n  if (!fields || Array.isArray(fields) || typeof fields !== \"object\") throw Error(\"Invalid fields\");\n  const requests = Object.entries(fields).map(([key, v]) => {\n    if (!key || typeof v !== \"string\") throw Error(\"Field values must be strings\");\n    return {\n      replaceAllText: { containsText: { text: `{{${key}}}`, matchCase: true }, replaceText: v },\n    };\n  });\n  return { templateId, title: body.name, requests };\n}\n"
      }
    }
