    {
      "id": "fireflies-project-follow-ups-to-airtable-2",
      "name": "Get Meeting Content",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.fireflies.ai/graphql",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({query:'query Transcript($transcriptId: String!) { transcript(id: $transcriptId) { title participants sentences { speaker_name text } summary { bullet_gist } } }',variables:{transcriptId:$('Prepare meeting').item.json.meetingId}}) }}",
        "options": {}
      },
      "typeVersion": 4.2
    },
    {
      "name": "Read transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $json.data?.transcript;\nif ($json.errors?.length || !t || !Array.isArray(t.participants) || !Array.isArray(t.sentences))\n  throw Error(\"Invalid transcript\");\nreturn { json: { project: /project/i.test(t.title || \"\"), transcript: t } };\n"
      },
      "id": "fireflies-project-follow-ups-to-airtable-3",
      "position": [
        660,
        0
      ]
    },
