    {
      "name": "Follow-up plan schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"tasks\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"due_date\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"project_name\":{\"type\":\"string\"}},\"required\":[\"name\",\"description\",\"due_date\",\"priority\",\"project_name\"],\"additionalProperties\":false}},\"notifications\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"email\":{\"type\":\"string\"},\"action_items\":{\"type\":\"string\"}},\"required\":[\"email\",\"action_items\"],\"additionalProperties\":false}},\"events\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"start\":{\"type\":\"string\"},\"end\":{\"type\":\"string\"},\"attendee\":{\"type\":\"string\"}},\"required\":[\"name\",\"start\",\"end\",\"attendee\"],\"additionalProperties\":false}}},\"required\":[\"tasks\",\"notifications\",\"events\"],\"additionalProperties\":false}"
      },
      "id": "fireflies-project-follow-ups-to-airtable-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Expand follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $(\"Read transcript\").first().json.transcript,\n  p = JSON.parse($input.first().json.payload),\n  allowed = new Set(t.participants.map((x) => String(x).toLowerCase())),\n  owner = \"YOUR_EMAIL\";\nif (owner.includes(\"YOUR_\")) throw Error(\"Configure owner\");\nfor (const n of p.notifications)\n  if (!allowed.has(n.email?.toLowerCase()) || n.email.toLowerCase() === owner.toLowerCase())\n    throw Error(\"Invalid participant\");\nfor (const e of p.events)\n  if (\n    !allowed.has(e.attendee?.toLowerCase()) ||\n    !Number.isFinite(Date.parse(e.start)) ||\n    !Number.isFinite(Date.parse(e.end)) ||\n    Date.parse(e.end) <= Date.parse(e.start)\n  )\n    throw Error(\"Invalid event\");\nconst out = [];\nfor (const phase of [\"tasks\", \"notifications\", \"events\"]) {\n  if (!Array.isArray(p[phase])) throw Error(\"Invalid plan\");\n  p[phase].forEach((data, index) =>\n    out.push({\n      json: { phase, index, data, summary: t.summary?.bullet_gist || \"\" },\n      pairedItem: { item: 0 },\n    }),\n  );\n}\nreturn out;\n"
      },
      "id": "fireflies-project-follow-ups-to-airtable-12",
      "position": [
        2640,
        0
      ]
    },
