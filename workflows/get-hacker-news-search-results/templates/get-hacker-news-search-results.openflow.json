        "name": "Extract results",
        "imports": [],
        "source": "export default function hackerNewsHits({ statusCode, body }) {\n  if (statusCode !== 200 || !body || typeof body !== \"object\" || !Array.isArray(body.hits))\n    throw Error(\"Hacker News search failed or returned invalid hits\");\n  return { hits: body.hits };\n}\n"
      }
