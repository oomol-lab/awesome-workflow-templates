    "modules": {
      "n_4155a5eb801e7a04": {
        "name": "Select the email",
        "imports": [],
        "source": "export default function pickDeckMail({ emails }) {\n  if (!Array.isArray(emails)) throw Error(\"Invalid IMAP search response\");\n  if (emails.length === 0) return { more: false, uid: 1 };\n  const uid = emails[0]?.uid;\n  if (!Number.isSafeInteger(uid) || uid < 1) throw Error(\"Invalid IMAP UID\");\n  return { more: true, uid };\n}\n"
      },
      "n_162e520da9781f11": {
        "name": "Prepare the Deck card",
        "imports": [],
        "source": "export default function deckMailCard({ uid, actualUid, subject, text, html, truncated }) {\n  if (uid !== actualUid || truncated) throw Error(\"Cannot read the complete email\");\n  if (typeof subject !== \"string\" || !subject.trim() || subject.length > 255)\n    throw Error(\"Deck card title must contain 1 to 255 characters\");\n  const body =\n    typeof html === \"string\" && html\n      ? html.replace(/<br(\\s*?\\/?)>/g, \"\\n\").replace(/(<([^>]+)>)/g, \"\")\n      : typeof text === \"string\"\n        ? text\n        : null;\n  if (body === null) throw Error(\"Email body is missing\");\n  return { card: { title: subject, type: \"plain\", order: -1, description: body } };\n}\n"
      }
    }
  },
