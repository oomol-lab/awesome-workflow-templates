    "modules": {
      "n_74c969ed435a1d7c": {
        "name": "Select the server and calendar",
        "imports": [],
        "source": "function configure(config) {\n  const { guildId, calendarId } = config;\n  if (\n    typeof guildId !== \"string\" ||\n    !/^\\d{17,20}$/.test(guildId) ||\n    typeof calendarId !== \"string\" ||\n    !calendarId ||\n    calendarId.startsWith(\"YOUR_\") ||\n    /[/\\\\?#%\\s]/.test(calendarId)\n  ) {\n    throw Error(\"Set a Discord server ID and a Google Calendar ID.\");\n  }\n  return { guildId, collection: \"/calendars/\" + encodeURIComponent(calendarId) + \"/events\" };\n}\nexport default ({ settings }) => {\n  const config = configure(settings);\n  return { config, guildId: config.guildId };\n};\n"
      },
      "n_8edc2480aea3cb65": {
        "name": "Map the Discord events",
        "imports": [],
        "source": "function collect(items, config) {\n  if (!Array.isArray(items)) throw Error(\"Discord returned an invalid scheduled event list.\");\n  const events = [],\n    results = [],\n    ids = new Set();\n  for (const event of items) {\n    const {\n      id,\n      guild_id,\n      name,\n      scheduled_start_time,\n      scheduled_end_time,\n      description,\n      entity_metadata,\n    } = event;\n    if (\n      typeof id !== \"string\" ||\n      !/^\\d{17,20}$/.test(id) ||\n      guild_id !== config.guildId ||\n      ids.has(id)\n    ) {\n      throw Error(\"Discord returned an invalid or mismatched event. No Calendar writes were made.\");\n    }\n    ids.add(id);\n    const start = Date.parse(scheduled_start_time),\n      end = Date.parse(scheduled_end_time);\n    if (\n      typeof name !== \"string\" ||\n      !name.trim() ||\n      !/^\\d{4}-\\d\\d-\\d\\dT.*(?:Z|[+-]\\d\\d:\\d\\d)$/.test(scheduled_start_time ?? \"\") ||\n      !/^\\d{4}-\\d\\d-\\d\\dT.*(?:Z|[+-]\\d\\d:\\d\\d)$/.test(scheduled_end_time ?? \"\") ||\n      !Number.isFinite(start) ||\n      !Number.isFinite(end) ||\n      end <= start\n    ) {\n      results.push({ eventId: id, status: \"invalid_event_time\" });\n      continue;\n    }\n    const location = entity_metadata?.location ?? \"\";\n    if (typeof location !== \"string\" || (description != null && typeof description !== \"string\")) {\n      results.push({ eventId: id, status: \"invalid_event_details\" });\n      continue;\n    }\n    events.push({\n      id,\n      collection: config.collection,\n      endpoint: config.collection + \"/\" + id,\n      mapped: {\n        summary: name,\n        description: description ?? \"\",\n        location,\n        start: { dateTime: scheduled_start_time },\n        end: { dateTime: scheduled_end_time },\n      },\n    });\n  }\n  return { events, results };\n}\nexport default ({ items, config }) => collect(items, config);\n"
      },
      "n_ff3eacaf32b1ff35": {
        "name": "Select the next event",
        "imports": [],
        "source": "export default ({ events, initial, prior }) => {\n  const progress = prior ?? { index: 0, results: initial };\n  const event = events[progress.index];\n  return {\n    progress,\n    event: event ?? {},\n    more: event !== undefined,\n    endpoint: event?.endpoint ?? \"\",\n    results: progress.results,\n  };\n};\n"
      },
      "n_36a53edb462f08cf": {
        "name": "Compare the Calendar event",
        "imports": [],
        "source": "function sameFields(saved, mapped) {\n  return (\n    saved.summary === mapped.summary &&\n    (saved.description ?? \"\") === mapped.description &&\n    (saved.location ?? \"\") === mapped.location &&\n    Date.parse(saved.start?.dateTime) === Date.parse(mapped.start.dateTime) &&\n    Date.parse(saved.end?.dateTime) === Date.parse(mapped.end.dateTime)\n  );\n}\nfunction decide(event, status, body) {\n  const fail = (value) => ({\n    method: \"\",\n    endpoint: \"\",\n    tag: \"\",\n    payload: {},\n    result: { eventId: event.id, status: value },\n  });\n  const miss =\n    status === 404 &&\n    body?.error?.code === 404 &&\n    (body.error.status === \"NOT_FOUND\" ||\n      (Array.isArray(body.error.errors) &&\n        body.error.errors.some((error) => error?.reason === \"notFound\")));\n  if (miss)\n    return {\n      method: \"POST\",\n      endpoint: event.collection,\n      tag: \"\",\n      payload: { id: event.id, ...event.mapped },\n      result: {},\n    };\n  if (status !== 200 || body?.id !== event.id) return fail(\"lookup_unconfirmed\");\n  if (body.status === \"cancelled\") return fail(\"cancelled_target\");\n  if (sameFields(body, event.mapped)) return fail(\"unchanged\");\n  if (typeof body.etag !== \"string\" || !/^\"[^\"\\r\\n]+\"$/.test(body.etag))\n    return fail(\"etag_unconfirmed\");\n  return {\n    method: \"PATCH\",\n    endpoint: event.endpoint,\n    tag: body.etag,\n    payload: event.mapped,\n    result: {},\n  };\n}\nexport default ({ event, status, body }) => {\n  const plan = decide(event, status, body);\n  return {\n    plan,\n    endpoint: plan.endpoint,\n    tag: plan.tag,\n    payload: plan.payload,\n    write: plan.method !== \"\",\n    insert: plan.method === \"POST\",\n  };\n};\n"
      },
      "n_151ef62edaa7d697": {
        "name": "Verify and report the event",
        "imports": [],
        "source": "function sameFields(saved, mapped) {\n  return (\n    saved.summary === mapped.summary &&\n    (saved.description ?? \"\") === mapped.description &&\n    (saved.location ?? \"\") === mapped.location &&\n    Date.parse(saved.start?.dateTime) === Date.parse(mapped.start.dateTime) &&\n    Date.parse(saved.end?.dateTime) === Date.parse(mapped.end.dateTime)\n  );\n}\nfunction confirmed(event, method, status, body) {\n  const ok =\n    (status === 200 || (method === \"POST\" && status === 201)) &&\n    body?.id === event.id &&\n    sameFields(body, event.mapped);\n  return {\n    eventId: event.id,\n    status: ok\n      ? method === \"POST\"\n        ? \"created\"\n        : \"updated\"\n      : status === 409 || status === 412\n        ? \"write_conflict\"\n        : \"write_unconfirmed\",\n  };\n}\nexport default ({ progress, event, plan, newStatus, newBody, patchStatus, patchBody }) => {\n  const result = plan.method\n    ? confirmed(\n        event,\n        plan.method,\n        plan.method === \"POST\" ? newStatus : patchStatus,\n        plan.method === \"POST\" ? newBody : patchBody,\n      )\n    : plan.result;\n  return { progress: { index: progress.index + 1, results: [...progress.results, result] } };\n};\n"
      }
