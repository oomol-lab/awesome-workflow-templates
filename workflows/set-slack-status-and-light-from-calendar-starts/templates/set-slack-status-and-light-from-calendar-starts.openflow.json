        "name": "Read one calendar page",
        "imports": [],
        "source": "export default async function page({calendarId,from,to,previous},context){const token=previous?.nextToken??null;if(previous&&(!token||typeof token!=='string'))throw Error('Invalid page token');const r=await context.actions.call('googlecalendar.list_events',{calendarId,timeMin:new Date(from-1000).toISOString(),timeMax:new Date(to+1000).toISOString(),singleEvents:true,showDeleted:false,orderBy:'startTime',maxResults:100,...(token?{pageToken:token}:{})});if(!r||!Array.isArray(r.items))throw Error('Invalid calendar page');const next=r.nextPageToken??null;if(next!==null&&(typeof next!=='string'||!next||next===token||(previous?.seen??[]).includes(next)))throw Error('Invalid next page');function start(e){let s=e?.start;if(s?.dateTime){let t=Date.parse(s.dateTime);if(!Number.isFinite(t))throw Error('Invalid event start');return t}if(s?.date){let zone=s.timeZone||r.timeZone;if(typeof zone!=='string'||!zone)throw Error('Missing calendar timezone');let [y,m,d]=s.date.split('-').map(Number);if(!y||!m||!d)throw Error('Invalid all-day start');let target=Date.UTC(y,m-1,d),t=target;const f=new Intl.DateTimeFormat('en-CA-u-ca-iso8601',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'});for(let i=0;i<3;i++){let q=Object.fromEntries(f.formatToParts(new Date(t)).map(x=>[x.type,x.value]));t+=target-Date.UTC(+q.year,+q.month-1,+q.day,+q.hour,+q.minute,+q.second)}return t}throw Error('Missing event start')};const ids=[];for(const e of r.items){const t=start(e);if(t>from&&t<=to){if(typeof e.id!=='string'||!e.id)throw Error('Missing event ID');ids.push(e.id)}}return{page:{ids,key:token??'',nextToken:next},pageState:{nextToken:next,seen:token?[...(previous?.seen??[]),token]:(previous?.seen??[])}}}\n"
      },
      "n_b150df0cfe701c58": {
        "name": "Select the next started event",
        "imports": [],
        "source": "export default async function select({page,previous},context){if(!page||!Array.isArray(page.ids))throw Error('Invalid page');let s=await context.state.get('calendar-start-progress');if(!s||s.pending)throw Error('Pending event requires attention');let i=previous?.key===page.key?previous.index:0;for(;i<page.ids.length;i++){let id=page.ids[i];if(s.seen.includes(id))continue;s.pending=id;await context.state.set('calendar-start-progress',s);return{more:true,morePages:false,eventId:id,iteration:{key:page.key,index:i+1}}}return{more:false,morePages:!!page.nextToken,eventId:'',iteration:{key:page.key,index:i}}}\n"
      },
      "n_7105e26365e45af1": {
        "name": "Prepare the event status",
        "imports": [],
        "source": "export default async function format({calendarId,eventId},context){const id=eventId.split('_')[0],e=await context.actions.call('googlecalendar.get_event',{calendarId,eventId:id});if(!e||typeof e.summary!=='string')throw Error('Calendar event has no summary');const map={'1':'Lavendar','2':'4dw_leading','3':'Grape','4':'Flamingo','5':'4dw_managing','6':'Tangerine','7':'4dw_living','8':'Graphite','9':'Blueberry','10':'Basil','11':'4dw_doing'},color=map[e.colorId]||'undefined',route=['4dw_doing','4dw_managing','4dw_leading'].includes(color)?'busy':color==='4dw_living'?'personal':'available';return{body:{profile:{status_text:e.summary,status_emoji:':'+color+':'}},route}}\n"
      },
      "n_63af098739d3830b": {
        "name": "Confirm Slack status",
        "imports": [],
        "source": "export default function confirm({body,route}){if(!body||body.ok!==true)throw Error('Slack did not confirm status');return{route}}\n"
      },
      "n_dc426a647488c823": {
        "name": "Confirm the event is handled",
        "imports": [],
        "source": "export default async function done({eventId},context){let s=await context.state.get('calendar-start-progress');if(!s||s.pending!==eventId)throw Error('Event checkpoint mismatch');s.seen=[...new Set([...s.seen,eventId])];s.pending=null;await context.state.set('calendar-start-progress',s);return{done:true}}\n"
      },
      "n_11982a52d373a3ea": {
        "name": "Save the completed window",
        "imports": [],
        "source": "export default async function commit(_input,context){let s=await context.state.get('calendar-start-progress');if(!s||s.pending||!s.window)throw Error('Unfinished event window');await context.state.set('calendar-start-progress',{last:s.window.to,seen:[],pending:null});return{done:true}}\n"
      }
    }
  },
