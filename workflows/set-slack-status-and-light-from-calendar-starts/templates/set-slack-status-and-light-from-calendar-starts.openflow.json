    "modules": {
      "n_97284ac6c1b6c8ae": {
        "name": "Open the calendar window",
        "imports": [],
        "source": "export default async function window({calendarId,acknowledgeEventId},context){if(typeof calendarId!=='string'||!calendarId.trim()||calendarId==='YOUR_CALENDAR_ID')throw Error('Configure a calendar ID');let s=await context.state.get('calendar-start-progress'),now=Date.now();if(s===null){s={last:now,seen:[],pending:null};await context.state.set('calendar-start-progress',s)}if(!s||!Number.isFinite(s.last)||!Array.isArray(s.seen))throw Error('Invalid calendar checkpoint');if(s.pending){if(typeof acknowledgeEventId!=='string'||acknowledgeEventId!==s.pending)throw Error('Pending event '+s.pending+': check Slack and the light, then acknowledge this event ID');s.seen=[...new Set([...s.seen,s.pending])];s.pending=null;await context.state.set('calendar-start-progress',s)}let from=s.window?.from??s.last,to=s.window?.to??now;if(!Number.isFinite(from)||!Number.isFinite(to)||from>to)throw Error('Invalid calendar window');if(!s.window){s.window={from,to};await context.state.set('calendar-start-progress',s)}return{calendarId,from,to}}\n"
      },
