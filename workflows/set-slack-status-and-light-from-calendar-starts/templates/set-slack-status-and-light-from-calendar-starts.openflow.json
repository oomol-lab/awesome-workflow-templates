    "modules": {
      "n_97284ac6c1b6c8ae": {
        "name": "Open the calendar window",
        "imports": [],
        "source": "export default async function window({ calendarId, acknowledgeEventId }, context) {\n  if (typeof calendarId !== \"string\" || !calendarId.trim() || calendarId === \"YOUR_CALENDAR_ID\")\n    throw Error(\"Configure a calendar ID\");\n  let s = await context.state.get(\"calendar-start-progress\"),\n    now = Date.now();\n  if (s === null) {\n    s = { last: now, seen: [], pending: null };\n    await context.state.set(\"calendar-start-progress\", s);\n  }\n  if (!s || !Number.isFinite(s.last) || !Array.isArray(s.seen))\n    throw Error(\"Invalid calendar checkpoint\");\n  if (s.pending) {\n    if (typeof acknowledgeEventId !== \"string\" || acknowledgeEventId !== s.pending)\n      throw Error(\n        \"Pending event \" +\n          s.pending +\n          \": check Slack and the light, then acknowledge this event ID\",\n      );\n    s.seen = [...new Set([...s.seen, s.pending])];\n    s.pending = null;\n    await context.state.set(\"calendar-start-progress\", s);\n  }\n  let from = s.window?.from ?? s.last,\n    to = s.window?.to ?? now;\n  if (!Number.isFinite(from) || !Number.isFinite(to) || from > to)\n    throw Error(\"Invalid calendar window\");\n  if (!s.window) {\n    s.window = { from, to };\n    await context.state.set(\"calendar-start-progress\", s);\n  }\n  return { calendarId, from, to };\n}\n"
      },
      "n_4a72366ce70f28c1": {
        "name": "Read one calendar page",
        "imports": [],
        "source": "export default async function page({ calendarId, from, to, previous }, context) {\n  const token = previous?.nextToken ?? null;\n  if (previous && (!token || typeof token !== \"string\")) throw Error(\"Invalid page token\");\n  const r = await context.actions.call(\"googlecalendar.list_events\", {\n    calendarId,\n    timeMin: new Date(from - 1000).toISOString(),\n    timeMax: new Date(to + 1000).toISOString(),\n    singleEvents: true,\n    showDeleted: false,\n    orderBy: \"startTime\",\n    maxResults: 100,\n    ...(token ? { pageToken: token } : {}),\n  });\n  if (!r || !Array.isArray(r.items)) throw Error(\"Invalid calendar page\");\n  const next = r.nextPageToken ?? null;\n  if (\n    next !== null &&\n    (typeof next !== \"string\" || !next || next === token || (previous?.seen ?? []).includes(next))\n  )\n    throw Error(\"Invalid next page\");\n  function start(e) {\n    let s = e?.start;\n    if (s?.dateTime) {\n      let t = Date.parse(s.dateTime);\n      if (!Number.isFinite(t)) throw Error(\"Invalid event start\");\n      return t;\n    }\n    if (s?.date) {\n      let zone = s.timeZone || r.timeZone;\n      if (typeof zone !== \"string\" || !zone) throw Error(\"Missing calendar timezone\");\n      let [y, m, d] = s.date.split(\"-\").map(Number);\n      if (!y || !m || !d) throw Error(\"Invalid all-day start\");\n      let target = Date.UTC(y, m - 1, d),\n        t = target;\n      const f = new Intl.DateTimeFormat(\"en-CA-u-ca-iso8601\", {\n        timeZone: zone,\n        year: \"numeric\",\n        month: \"2-digit\",\n        day: \"2-digit\",\n        hour: \"2-digit\",\n        minute: \"2-digit\",\n        second: \"2-digit\",\n        hourCycle: \"h23\",\n      });\n      for (let i = 0; i < 3; i++) {\n        let q = Object.fromEntries(f.formatToParts(new Date(t)).map((x) => [x.type, x.value]));\n        t += target - Date.UTC(+q.year, +q.month - 1, +q.day, +q.hour, +q.minute, +q.second);\n      }\n      return t;\n    }\n    throw Error(\"Missing event start\");\n  }\n  const ids = [];\n  for (const e of r.items) {\n    const t = start(e);\n    if (t > from && t <= to) {\n      if (typeof e.id !== \"string\" || !e.id) throw Error(\"Missing event ID\");\n      ids.push(e.id);\n    }\n  }\n  return {\n    page: { ids, key: token ?? \"\", nextToken: next },\n    pageState: {\n      nextToken: next,\n      seen: token ? [...(previous?.seen ?? []), token] : (previous?.seen ?? []),\n    },\n  };\n}\n"
      },
      "n_b150df0cfe701c58": {
        "name": "Select the next started event",
        "imports": [],
        "source": "export default async function select({ page, previous }, context) {\n  if (!page || !Array.isArray(page.ids)) throw Error(\"Invalid page\");\n  let s = await context.state.get(\"calendar-start-progress\");\n  if (!s || s.pending) throw Error(\"Pending event requires attention\");\n  let i = previous?.key === page.key ? previous.index : 0;\n  for (; i < page.ids.length; i++) {\n    let id = page.ids[i];\n    if (s.seen.includes(id)) continue;\n    s.pending = id;\n    await context.state.set(\"calendar-start-progress\", s);\n    return {\n      more: true,\n      morePages: false,\n      eventId: id,\n      iteration: { key: page.key, index: i + 1 },\n    };\n  }\n  return {\n    more: false,\n    morePages: !!page.nextToken,\n    eventId: \"\",\n    iteration: { key: page.key, index: i },\n  };\n}\n"
      },
      "n_7105e26365e45af1": {
        "name": "Prepare the event status",
        "imports": [],
        "source": "export default async function format({ calendarId, eventId }, context) {\n  const id = eventId.split(\"_\")[0],\n    e = await context.actions.call(\"googlecalendar.get_event\", { calendarId, eventId: id });\n  if (!e || typeof e.summary !== \"string\") throw Error(\"Calendar event has no summary\");\n  const map = {\n      1: \"Lavendar\",\n      2: \"4dw_leading\",\n      3: \"Grape\",\n      4: \"Flamingo\",\n      5: \"4dw_managing\",\n      6: \"Tangerine\",\n      7: \"4dw_living\",\n      8: \"Graphite\",\n      9: \"Blueberry\",\n      10: \"Basil\",\n      11: \"4dw_doing\",\n    },\n    color = map[e.colorId] || \"undefined\",\n    route = [\"4dw_doing\", \"4dw_managing\", \"4dw_leading\"].includes(color)\n      ? \"busy\"\n      : color === \"4dw_living\"\n        ? \"personal\"\n        : \"available\";\n  return { body: { profile: { status_text: e.summary, status_emoji: \":\" + color + \":\" } }, route };\n}\n"
      },
      "n_63af098739d3830b": {
        "name": "Confirm Slack status",
        "imports": [],
        "source": "export default function confirm({ body, route }) {\n  if (!body || body.ok !== true) throw Error(\"Slack did not confirm status\");\n  return { route };\n}\n"
      },
      "n_dc426a647488c823": {
        "name": "Confirm the event is handled",
        "imports": [],
        "source": "export default async function done({ eventId }, context) {\n  let s = await context.state.get(\"calendar-start-progress\");\n  if (!s || s.pending !== eventId) throw Error(\"Event checkpoint mismatch\");\n  s.seen = [...new Set([...s.seen, eventId])];\n  s.pending = null;\n  await context.state.set(\"calendar-start-progress\", s);\n  return { done: true };\n}\n"
      },
      "n_11982a52d373a3ea": {
        "name": "Save the completed window",
        "imports": [],
        "source": "export default async function commit(_input, context) {\n  let s = await context.state.get(\"calendar-start-progress\");\n  if (!s || s.pending || !s.window) throw Error(\"Unfinished event window\");\n  await context.state.set(\"calendar-start-progress\", {\n    last: s.window.to,\n    seen: [],\n    pending: null,\n  });\n  return { done: true };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
