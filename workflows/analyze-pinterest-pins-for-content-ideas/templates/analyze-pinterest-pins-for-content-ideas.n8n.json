      "name": "Pull List of Pinterest Pins From Account",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "https://api.pinterest.com/v5/pins?page_size=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "bookmark",
                    "value": "={{ $response?.body?.bookmark }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.bookmark }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "analyze-pinterest-pins-for-content-ideas-5",
      "name": "Update Data Field To Include Organic",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Initialize an array to hold the output formatted for Airtable\nconst outputItems = [];\n\nfor (const item of $input.all()) {\n  if (item.json.body.items && Array.isArray(item.json.body.items)) {\n    for (const subItem of item.json.body.items) {\n      // Construct an object with only the required fields for Airtable\n      outputItems.push({\n        id: subItem.id || null,\n        created_at: subItem.created_at || null,\n        title: subItem.title || null,\n        description: subItem.description || null,\n        link: subItem.link || null,\n        type: \"Organic\", // Assign the value \"Organic\" to the 'Type' field\n      });\n    }\n  }\n}\n\n// Return the structured output\nreturn outputItems;\n"
      },
      "typeVersion": 2
    },
