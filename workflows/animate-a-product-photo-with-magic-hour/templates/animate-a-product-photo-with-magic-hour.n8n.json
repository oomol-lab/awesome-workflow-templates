{
  "name": "Animate a Product Photo with Magic Hour",
  "nodes": [
    {
      "id": "1",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Magic Hour",
      "type": "@gladiator1st/n8n-nodes-magichour.magicHour",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "resource": "video",
        "operation": "imageToVideo",
        "imageFilePath": "YOUR_IMAGE_URL_OR_ASSET_PATH",
        "imageToVideoPrompt": "YOUR_ANIMATION_PROMPT",
        "videoModel": "={{ 'ltx-2.5' }}",
        "resolution": "480p",
        "endSeconds": 1,
        "audio": false,
        "videoName": "Product animation",
        "waitForCompletion": true,
        "additionalOptions": {
          "pollingInterval": 10,
          "maxWaitTime": 600
        }
      }
    },
    {
      "id": "3",
      "name": "Require complete",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status-complete",
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Download result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "={{ $json.downloads[0].url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "5",
      "name": "Stop incomplete job",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        750,
        500
      ],
      "parameters": {
        "errorMessage": "={{ \"Generation is \" + $json.status + \". Keep project ID \" + $json.id + \" and resume with Get Details. Do not create another generation to retrieve it.\" }}"
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Magic Hour",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Magic Hour": {
      "main": [
        [
          {
            "node": "Require complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require complete": {
      "main": [
        [
          {
            "node": "Download result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop incomplete job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": [],
  "description": "Animate a product photo into a one-second video, require completion and download binary data."
}
