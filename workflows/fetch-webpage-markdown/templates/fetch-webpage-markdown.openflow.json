    "modules": {
      "n_24730efe8670876f": {
        "name": "Parse request",
        "imports": [],
        "source": "export default function parse({ query }) {\n  const error = \"INVALID action_input. Supply ?url=ENCODED_URL&method=full or simplified\";\n  if (typeof query !== \"string\")\n    return { ok: false, error, url: \"\", method: \"full\", maxlimit: 70000 };\n  let data = {};\n  try {\n    for (const p of query.slice(query.indexOf(\"?\") + 1).split(\"&\")) {\n      const i = p.indexOf(\"=\");\n      if (i >= 0) data[decodeURIComponent(p.slice(0, i))] = decodeURIComponent(p.slice(i + 1));\n    }\n  } catch {\n    return { ok: false, error, url: \"\", method: \"full\", maxlimit: 70000 };\n  }\n  const url = data.url ?? \"\",\n    method = data.method ?? \"full\",\n    maxlimit = data.maxlimit === undefined ? 70000 : Number(data.maxlimit);\n  if (\n    !/^https?:\\/\\//i.test(url) ||\n    ![\"full\", \"simplified\"].includes(method) ||\n    !Number.isFinite(maxlimit) ||\n    maxlimit < 1\n  )\n    return { ok: false, error, url: \"\", method: \"full\", maxlimit: 70000 };\n  return { ok: true, error: \"\", url, method, maxlimit };\n}\n"
      },
      "n_c0e9fe764f9bb6c4": {
        "name": "Return invalid request",
        "imports": [],
        "source": "export default function ({ error }) {\n  return { page_content: error, page_length: 0 };\n}\n"
      },
      "n_db241b6af375f13e": {
        "name": "Format page",
        "imports": [],
        "source": "function format({ body, method, maxlimit }) {\n  if (!body || body.success !== true || typeof body.data?.markdown !== \"string\")\n    return {\n      page_content: \"ERROR: \" + String(body?.error ?? \"Page content unavailable\"),\n      page_length: 0,\n    };\n  let text = body.data.markdown;\n  if (method === \"simplified\")\n    text = text\n      .replace(/!\\[([^\\]]*)\\]\\([^)]*\\)/g, \"![$1](NOIMG)\")\n      .replace(/(?<!!)\\[([^\\]]*)\\]\\([^)]*\\)/g, \"[$1](NOURL)\");\n  return {\n    page_content: text.length < maxlimit ? text : \"ERROR: PAGE CONTENT TOO LONG\",\n    page_length: text.length,\n  };\n}\n\nexport default function ({ body, error, method, maxlimit }) {\n  if (error) return { page_content: \"ERROR: Page request failed\", page_length: 0 };\n  return format({ body, method, maxlimit });\n}\n"
      }
    }
