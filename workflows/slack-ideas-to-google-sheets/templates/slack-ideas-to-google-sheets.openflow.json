    "modules": {
      "n_348cbb536582bc86": {
        "name": "Prepare idea and response",
        "imports": [],
        "source": "export default function prepare({ event, sheetUrl }) {\n  const { command, text, user_name, user_id, response_url } = event.event;\n  const message = `Thanks for adding the idea \\`${text}\\` <@${user_id}> :rocket: Please make sure to add some details and a hypothesis to it to make it easier for us to work with it.\\n\\n:point_right: <${sheetUrl}|Add your details here>`;\n  return {\n    command,\n    headers: [\"Name\", \"Creator\"],\n    rows: [[text, user_name]],\n    responseUrl: response_url,\n    body: { text: message },\n  };\n}\n"
      }
    }
