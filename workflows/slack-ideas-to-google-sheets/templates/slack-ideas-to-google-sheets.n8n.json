      ],
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: $('Webhook').item.json.body} }}",
        "options": {}
      }
    }
