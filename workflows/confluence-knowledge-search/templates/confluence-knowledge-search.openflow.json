    "modules": {
      "n_aefefa1585cf6391": {
        "name": "Prepare Confluence search",
        "imports": [],
        "source": "export function makeCqlQuery({ query }) {\n  if (typeof query !== 'string' || !query.trim()) throw new Error('Supply a nonempty Confluence search query.');\n  if (/[\\u0000-\\u001f\\u007f]/u.test(query)) throw new Error('Use a single-line search query without control characters.');\n  const text = query.trim();\n  return { cql: 'text ~ ' + JSON.stringify(text) };\n}\n\nexport function wikiRoot(value) {\n  if (typeof value !== 'string' || !/^https:\\/\\/[^/?#@\\s\\\\]+\\/wiki\\/?$/i.test(value)) throw new Error('Use your Confluence HTTPS wiki base URL ending in /wiki.');\n  if (/YOUR_SITE/i.test(value)) throw new Error('Configure your Confluence wiki base URL before searching.');\n  return value.replace(/\\/$/, '');\n}\n\nexport default function prepareConfluenceSearch({ query, wikiBaseUrl }) {\n  return { ...makeCqlQuery({ query }), wikiBaseUrl: wikiRoot(wikiBaseUrl) };\n}\n"
      },
      "n_829bfba428dfd994": {
        "name": "Return first knowledge result",
        "imports": [],
        "source": "export function sourceSearchReply({ results, wikiBaseUrl }) {\n  if (!Array.isArray(results)) throw new Error('Confluence must return a search results array.');\n  if (!results.length) return { found: false, response: 'No matching knowledge base article was found.' };\n  const first = results[0];\n  const title = first?.content?.title;\n  const path = first?.content?._links?.webui;\n  if (typeof title !== 'string' || !title.trim()) throw new Error('The first search result has no content title.');\n  if (typeof path !== 'string' || !path.startsWith('/') || path.startsWith('//') || /[\\s\\u0000-\\u001f\\u007f\\\\]/u.test(path)) throw new Error('The first search result has no valid relative Confluence web link.');\n  if (typeof wikiBaseUrl !== 'string' || !/^https:\\/\\/[^/?#@\\s\\\\]+\\/wiki\\/?$/i.test(wikiBaseUrl)) throw new Error('Confluence must supply a valid HTTPS wiki base URL.');\n  const base = wikiBaseUrl.replace(/\\/$/, '');\n  const link = /^\\/wiki(?:[/?#]|$)/.test(path) ? base.slice(0, -5) + path : base + path;\n  const excerpt = first.excerpt ?? '';\n  if (typeof excerpt !== 'string') throw new Error('The Confluence excerpt must be text.');\n  return { found: true, response: '\"Title\": ' + JSON.stringify(title) + '\\n\"Link\": ' + JSON.stringify(link) + '\\n\"Content\": ' + excerpt + '\\nWhen users request the password, make sure to send them the link above to reset it in markdown. ' };\n}\n\nexport default function formatConfluenceSearch({ results, wikiBaseUrl }) {\n  if (!Array.isArray(results)) throw new Error('Confluence must return a search results array.');\n  return sourceSearchReply({ results: results.map(result => result.raw), wikiBaseUrl });\n}\n"
      }
