    "modules": {
      "n_1eb024caced64d87": {
        "name": "Validate the URL",
        "imports": [],
        "source": "export default function input({body}){const url=body?.url;if(typeof url!=='string'||!/^https?:\\/\\/[^\\/?#@\\s]+(?:[\\/?#][^\\s]*)?$/i.test(url))throw Error('Provide an HTTP or HTTPS URL without credentials');return {url}}\n"
      },
      "n_738209b722f95700": {
        "name": "Prepare the webpage request",
        "imports": [],
        "source": "export default function serverHop({initialUrl,index,previousState}) {\n return {url:previousState?.index===index&&previousState?.nextUrl?previousState.nextUrl:initialUrl};\n}\n"
      },
      "n_4da02c3276a4ffa6": {
        "name": "Check the webpage response",
        "imports": [],
        "source": "export default function assessServer({url,index,status,headers,previousState}) {\n const prior=previousState?.index===index?previousState.hops:0;if(!Number.isInteger(prior)||prior<0)throw Error('Invalid redirect state');\n if((status>=300&&status<400)&&typeof headers?.location==='string'&&headers.location){\n  if(prior>=21)return {state:{index,hops:prior,nextUrl:''},redirect:false,alive:false};\n  try{const target=new URL(headers.location,url);if(!['http:','https:'].includes(target.protocol)||target.username||target.password)throw Error();return{state:{index,hops:prior+1,nextUrl:target.toString()},redirect:true,alive:false};}catch{return {state:{index,hops:prior,nextUrl:''},redirect:false,alive:false};}\n }\n return {state:{index,hops:prior,nextUrl:''},redirect:false,alive:status>=200&&status<300};\n}\n"
      },
      "n_d2e428cb139a27aa": {
        "name": "Prepare the HTML document",
        "imports": [],
        "source": "export default function html({body,alive}){if(!alive)throw Error('The webpage request did not succeed');if(typeof body!=='string')throw Error('Expected a text webpage');return {request:{document:{type:'HTML',content:body.substring(0,100000)},encodingType:'UTF8'}}}\n"
      },
      "n_9706043d6e5c7bbd": {
        "name": "Check the entity response",
        "imports": [],
        "source": "export default function result({body}){if(!body||typeof body!=='object'||Array.isArray(body))throw Error('Expected an entity response object');return{response:body}}\n"
      }
    }
