    "modules": {
      "n_243afe2729b3e6fb": {
        "name": "Prepare the holdings report",
        "imports": [],
        "source": "export default async function portfolio({tableId,previous,quote},context){\n if(!Number.isSafeInteger(tableId)||tableId<1)throw Error('Configure a Baserow table ID');\n const s=previous??{page:1,morePages:true,rows:[],entries:[],pending:null};\n if(s.pending){if(typeof quote!=='string')throw Error('Missing quote page');const row=s.pending,isin=String(row.ISIN??'').trim().toUpperCase();const matches=[...quote.matchAll(/<td\\b[^>]*>\\s*([A-Z]{2}[A-Z0-9]{10})\\s*<\\/td>/gi)].map(x=>x[1].toUpperCase());if(!matches.includes(isin))throw Error('Quote ISIN mismatch');const m=quote.match(/<[^>]+\\bid=[\"']bid[\"'][^>]*>\\s*([\\d.,]+)\\s*<\\//i);if(!m)throw Error('Missing bid');const bid=Number(m[1].replace(/\\./g,'').replace(',','.')),count=Number(row.Count),purchase=Number(row['Purchase Price']);if(!Number.isFinite(bid)||!Number.isFinite(count)||!Number.isFinite(purchase)||purchase===0)throw Error('Invalid amount');const current=bid*count,change=current-purchase;s.entries.push({Name:String(row.Name??''),ISIN:isin,Count:count,'Purchase Price':purchase,'Current Value':current.toFixed(2),Change:change.toFixed(2),'Change (%)':(change/purchase*100).toFixed(2)});s.pending=null;}\n if(!s.rows.length&&s.morePages){const r=await context.actions.call('baserow.list_table_rows',{tableId,userFieldNames:true,page:s.page,size:100});if(!r||!Array.isArray(r.rows)||(r.next!==null&&typeof r.next!=='string'))throw Error('Invalid Baserow page');s.rows=r.rows;s.morePages=r.next!==null;s.page++;if(!s.rows.length&&s.morePages)throw Error('Empty Baserow page with next link');}\n if(s.rows.length){s.pending=s.rows.shift();const isin=String(s.pending.ISIN??'').trim().toUpperCase();if(!/^[A-Z]{2}[A-Z0-9]{10}$/.test(isin))throw Error('Invalid ISIN');return{state:s,more:true,url:'https://www.tradegatebsx.com/orderbuch.php?isin='+encodeURIComponent(isin),html:''};}\n if(s.morePages)return{state:s,more:true,url:'',html:''};\n if(!s.entries.length)throw Error('No holdings to report');const esc=x=>String(x).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const keys=['Name','ISIN','Count','Purchase Price','Current Value','Change','Change (%)'],total=s.entries.reduce((a,x)=>a+Number(x['Current Value']),0),html='<p>Investments as of '+esc(new Date().toLocaleString('en-IE',{timeZone:'Europe/Dublin'}))+'</p><table><tr>'+keys.map(x=>'<th>'+esc(x)+'</th>').join('')+'</tr>'+s.entries.map(r=>'<tr>'+keys.map(k=>'<td>'+esc(r[k])+'</td>').join('')+'</tr>').join('')+'</table><p>Total: '+total.toFixed(2)+'</p>';return{state:s,more:false,url:'',html};\n}\n"
      }
    }
