    {
      "name": "Prepare response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json.body || $json,\n  id = r[\"Submission ID\"] || r.submissionId,\n  name = r.Name || r.name,\n  email = r.Email || r.email,\n  raw = r.Score ?? r.score,\n  score = Number(raw);\nif (!id || !name || !email || raw === \"\" || !Number.isFinite(score))\n  throw Error(\"Submission ID, name, email and numeric score required\");\nreturn {\n  json: {\n    submissionId: String(id),\n    name: String(name),\n    email: String(email),\n    score,\n    mode: \"direct\",\n  },\n};\n"
      },
      "id": "email-quiz-certificates-from-slides-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Passed quiz?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.score }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "email-quiz-certificates-from-slides-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Use Open Flow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.mode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "email-quiz-certificates-from-slides-5",
