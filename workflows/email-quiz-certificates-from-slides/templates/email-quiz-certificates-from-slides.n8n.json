    {
      "name": "Choose certificate step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n    .all()\n    .map((x) => x.json)\n    .filter((x) => x.item_key),\n  input = $(\"Prepare response\").item.json;\nif (rows.length > 1) throw Error(\"Duplicate submission\");\nif (!rows.length) return [{ json: { step: \"new\", payload: input } }];\nconst row = rows[0],\n  s = JSON.parse(row.payload);\nfor (const k of [\"submissionId\", \"name\", \"email\", \"score\"])\n  if (s[k] !== input[k]) throw Error(\"Submission changed\");\nif (row.status.startsWith(\"pending-\")) throw Error(\"Inspect pending certificate write\");\nif (![\"ready-replace\", \"ready-email\", \"done\"].includes(row.status)) throw Error(\"Invalid state\");\nreturn [{ json: { step: row.status, payload: s } }];\n"
      },
      "id": "email-quiz-certificates-from-slides-9",
      "position": [
        1980,
        0
      ]
