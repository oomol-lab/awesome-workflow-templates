    "modules": {
      "n_10ef827520750944": {
        "name": "Set current month",
        "imports": [],
        "source": "export default function range({ company }) {\n  if (!company.trim()) throw Error(\"Provide company ID\");\n  const now = new Date(),\n    start = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)),\n    end = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1));\n  return {\n    from: start.toISOString(),\n    to: end.toISOString(),\n    body: {\n      limit: 500,\n      filter: {\n        must: [\n          { key: \"metadata.company_id\", match: { value: company } },\n          {\n            key: \"metadata.review_date\",\n            range: { gte: start.toISOString(), lt: end.toISOString() },\n          },\n        ],\n      },\n      with_vector: true,\n      with_payload: false,\n    },\n  };\n}\n"
      },
      "n_6ee36423d171b36a": {
        "name": "Read and cluster review vectors",
        "imports": [],
        "source": "function cluster({ points }) {\n  if (!Array.isArray(points)) throw Error(\"Expected review vectors\");\n  if (!points.length) return { clusters: [] };\n  const ids = new Set(),\n    n = points[0]?.vector?.length;\n  if (!Number.isInteger(n) || n < 1) throw Error(\"Missing vector\");\n  for (const p of points) {\n    if (\n      !p.id ||\n      ids.has(String(p.id)) ||\n      !Array.isArray(p.vector) ||\n      p.vector.length !== n ||\n      p.vector.some((x) => !Number.isFinite(x))\n    )\n      throw Error(\"Invalid review vector or ID\");\n    ids.add(String(p.id));\n  }\n  const k = Math.min(5, points.length),\n    centers = points.slice(0, k).map((p) => p.vector.slice()),\n    dist = (a, b) => a.reduce((s, x, i) => s + (x - b[i]) ** 2, 0);\n  let labels = [];\n  for (let pass = 0; pass < 100; pass++) {\n    const next = points.map((p) =>\n      centers.reduce(\n        (best, c, i) => (dist(p.vector, c) < dist(p.vector, centers[best]) ? i : best),\n        0,\n      ),\n    );\n    if (next.every((x, i) => x === labels[i])) break;\n    labels = next;\n    for (let i = 0; i < k; i++) {\n      const group = points.filter((_, j) => labels[j] === i);\n      if (group.length)\n        centers[i] = centers[i].map(\n          (_, j) => group.reduce((sum, p) => sum + p.vector[j], 0) / group.length,\n        );\n    }\n  }\n  return {\n    clusters: centers\n      .map((_, i) => ({\n        id: \"Cluster \" + i,\n        points: points.filter((_, j) => labels[j] === i).map((p) => p.id),\n      }))\n      .filter((c) => c.points.length >= 3),\n  };\n}\n\nexport default async function fetchAndCluster({ url, apiKey, company, from, to }, ctx) {\n  if (!/^https:\\/\\//.test(url) || !apiKey || !company)\n    throw Error(\"Configure Qdrant URL, key and company\");\n  const points = [];\n  let offset = null;\n  do {\n    const body = {\n      limit: Math.min(10, 500 - points.length),\n      filter: {\n        must: [\n          { key: \"metadata.company_id\", match: { value: company } },\n          { key: \"metadata.review_date\", range: { gte: from, lt: to } },\n        ],\n      },\n      with_vector: true,\n      with_payload: false,\n      ...(offset == null ? {} : { offset }),\n    };\n    const r = await ctx.fetch(url, {\n      method: \"POST\",\n      headers: { \"api-key\": apiKey, \"content-type\": \"application/json\" },\n      body: JSON.stringify(body),\n    });\n    if (!r.ok) throw Error(\"Qdrant scroll failed\");\n    const data = await r.json();\n    if (!Array.isArray(data?.result?.points) || data.result.points.length > body.limit)\n      throw Error(\"Invalid Qdrant page\");\n    points.push(...data.result.points);\n    offset = data.result.next_page_offset ?? null;\n    if (!data.result.points.length && offset != null) throw Error(\"Empty Qdrant page with cursor\");\n  } while (offset != null && points.length < 500);\n  return cluster({ points });\n}\n"
      },
      "n_6c1101dd22514bee": {
        "name": "Select cluster",
        "imports": [],
        "source": "export default function next({ clusters, previous }) {\n  const i = (previous?.i ?? -1) + 1,\n    c = clusters[i];\n  return { state: { i }, more: !!c, ids: c?.points ?? [] };\n}\n"
      },
      "n_778935cea54ca9c7": {
        "name": "Prepare cluster request",
        "imports": [],
        "source": "export default function ({ ids }) {\n  return { body: { ids, with_payload: true } };\n}\n"
      },
      "n_e5f7c8ae6991a850": {
        "name": "Reserve insight row",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async function row({ company, from, to, ids, body, analysis }, ctx) {\n  const r = body?.result;\n  if (\n    !Array.isArray(r) ||\n    r.length !== ids.length ||\n    !analysis ||\n    !analysis.Insight ||\n    !analysis.Sentiment\n  )\n    throw Error(\"Invalid cluster payload or analysis\");\n  const actual = new Map(r.map((x) => [String(x.id), x]));\n  if (actual.size !== ids.length || ids.some((x) => !actual.has(String(x))))\n    throw Error(\"Cluster ID mismatch\");\n  const raw = ids\n      .map((id) => {\n        const p = actual.get(String(id)).payload,\n          m = p?.metadata;\n        if (!m || m.company_id !== company || typeof p.content !== \"string\")\n          throw Error(\"Invalid review association\");\n        return [\n          m.review_date,\n          m.review_author,\n          m.review_rating,\n          p.content.replaceAll(\"\\n\", \" \"),\n          m.review_url,\n        ].join(\" | \");\n      })\n      .join(\"\\n\"),\n    key =\n      \"review-cluster:\" +\n      createHash(\"sha256\")\n        .update(JSON.stringify([company, from, to, ids.map(String).sort()]))\n        .digest(\"hex\"),\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect sheet before retry\");\n  if (s?.status === \"done\") return { key, skip: true, values: [] };\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    skip: false,\n    values: [\n      [\n        company,\n        from,\n        to,\n        analysis.Insight,\n        analysis.Sentiment,\n        analysis[\"Suggested Improvements\"] ?? \"\",\n        ids.length,\n        raw,\n      ],\n    ],\n  };\n}\n"
      },
      "n_a85d280198eb26f0": {
        "name": "Confirm insight",
        "imports": [],
        "source": "export default async function confirm({ key, updatedRows }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Unknown sheet append outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
