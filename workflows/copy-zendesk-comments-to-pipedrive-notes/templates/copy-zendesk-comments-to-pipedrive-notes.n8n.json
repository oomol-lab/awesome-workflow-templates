        "jsCode": "if (!$json.data?.id || $json.data.person_id !== $(\"Check contact match\").item.json.personId)\n  throw Error(\"Unknown note result\");\nreturn [{ json: { ok: true }, pairedItem: { item: 0 } }];\n"
      },
