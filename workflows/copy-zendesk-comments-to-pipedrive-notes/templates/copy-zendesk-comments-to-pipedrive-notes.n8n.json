    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-7",
      "name": "Validate email ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const email = $json.via?.source?.from?.address;\nif (!email) throw Error(\"Email ticket missing sender\");\nreturn [{ json: { ticketId: $json.id, email }, pairedItem: { item: 0 } }];\n"
      },
      "position": [
        1540,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-8",
      "name": "Find Pipedrive contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://'+$('Configure export').first().json.pipedrive+'/api/v2/persons/search?fields=email&exact_match=true&limit=2&term='+encodeURIComponent($json.email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        1760,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-9",
      "name": "Check contact match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $json.data?.items,\n  e = $(\"Validate email ticket\").item.json.email;\nif (!Array.isArray(items) || items.length > 1 || $json.additional_data?.next_cursor)\n  throw Error(\"Invalid or ambiguous contact\");\nif (!items.length) return [{ json: { found: false, personId: 1 }, pairedItem: { item: 0 } }];\nconst p = items[0].item;\nif (!p.emails?.some((x) => x.toLowerCase() === e.toLowerCase()) || !p.id)\n  throw Error(\"Invalid contact\");\nreturn [{ json: { found: true, personId: p.id }, pairedItem: { item: 0 } }];\n"
      },
      "position": [
        1980,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-10",
      "name": "Contact found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
