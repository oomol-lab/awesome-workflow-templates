    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-11",
      "name": "Read Zendesk comment pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://'+$('Configure export').first().json.zendesk+'.zendesk.com/api/v2/tickets/'+$('Validate email ticket').item.json.ticketId+'/comments.json?page%5Bsize%5D=100' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://'+$('Configure export').first().json.zendesk+'.zendesk.com/api/v2/tickets/'+$('Validate email ticket').item.json.ticketId+'/comments.json?page%5Bsize%5D=100'+($pageCount===0?'':'&page%5Bafter%5D='+encodeURIComponent($response.body.meta.after_cursor)) }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ (() => { const m=$response.body.meta;if(!m||typeof m.has_more!=='boolean'||(m.has_more&&!m.after_cursor))throw Error('Invalid comment cursor');return !m.has_more; })() }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "position": [
        2420,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-12",
      "name": "Collect new comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const since = $(\"Configure export\").first().json.startTime,\n  out = [];\nfor (const [i, x] of $input.all().entries()) {\n  if (!Array.isArray(x.json.body?.comments)) throw Error(\"Invalid comment page\");\n  for (const a of x.json.body.comments) {\n    if (!a.id || !Number.isFinite(Date.parse(a.created_at)) || typeof a.body !== \"string\")\n      throw Error(\"Invalid comment\");\n    if (Date.parse(a.created_at) >= since * 1000) out.push({ json: a, pairedItem: { item: i } });\n  }\n}\nreturn out.length ? out : [{ json: { noComments: true }, pairedItem: { item: 0 } }];\n"
      },
      "position": [
        2640,
        0
      ]
    },
