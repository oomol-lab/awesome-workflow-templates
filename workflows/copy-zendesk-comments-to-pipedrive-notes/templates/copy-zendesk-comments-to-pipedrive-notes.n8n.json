      "id": "copy-zendesk-comments-to-pipedrive-notes-0",
      "name": "Daily at 09:00 UTC",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 9,
              "minute": 0
            }
          ]
        }
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-1",
      "name": "Configure export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const zendesk = \"YOUR_ZENDESK_SUBDOMAIN\",\n  pipedrive = \"YOUR_PIPEDRIVE_DOMAIN\",\n  startTime = 0;\nif (\n  !/^[a-z0-9-]+$/.test(zendesk) ||\n  zendesk.startsWith(\"YOUR\") ||\n  !pipedrive.endsWith(\".pipedrive.com\") ||\n  !Number.isInteger(startTime) ||\n  startTime <= 0 ||\n  startTime >= Date.now() / 1000 - 60\n)\n  throw Error(\"Configure domains and initial time at least one minute ago\");\nconst s = $getWorkflowStaticData(\"global\");\nreturn [\n  {\n    json: {\n      zendesk,\n      pipedrive,\n      startTime,\n      url:\n        \"https://\" +\n        zendesk +\n        \".zendesk.com/api/v2/incremental/tickets/cursor.json?\" +\n        (s.cursor ? \"cursor=\" + encodeURIComponent(s.cursor) : \"start_time=\" + startTime),\n    },\n  },\n];\n"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-2",
      "name": "Read Zendesk ticket page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        440,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-3",
      "name": "Prepare ticket page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (\n  !Array.isArray($json.tickets) ||\n  !$json.after_cursor ||\n  typeof $json.end_of_stream !== \"boolean\"\n)\n  throw Error(\"Invalid ticket page\");\nconst old = $getWorkflowStaticData(\"global\").cursor;\nif (!$json.end_of_stream && old === $json.after_cursor) throw Error(\"Repeated ticket cursor\");\nfor (const t of $json.tickets) if (!Number.isSafeInteger(t.id)) throw Error(\"Invalid ticket\");\nreturn [\n  {\n    json: {\n      cursor: $json.after_cursor,\n      tickets: $json.tickets.filter((t) => t.via?.channel === \"email\"),\n    },\n  },\n];\n"
      },
      "position": [
        660,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-4",
      "name": "Page has email tickets?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "yes",
              "leftValue": "={{ $json.tickets.length>0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        880,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-5",
      "name": "Expand tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $json.tickets.map((t) => ({ json: t, pairedItem: { item: 0 } }));\n"
      },
      "position": [
        1100,
        0
      ]
    },
    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-6",
