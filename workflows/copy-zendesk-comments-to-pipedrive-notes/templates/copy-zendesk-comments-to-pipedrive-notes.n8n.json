      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cursor = $(\"Prepare ticket page\").first().json.cursor;\nif (!cursor) throw Error(\"Missing cursor\");\n$getWorkflowStaticData(\"global\").cursor = cursor;\nreturn [{ json: { ok: true } }];\n"
      },
