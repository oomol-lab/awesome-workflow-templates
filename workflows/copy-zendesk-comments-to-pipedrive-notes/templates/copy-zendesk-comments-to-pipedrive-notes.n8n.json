    {
      "id": "copy-zendesk-comments-to-pipedrive-notes-20",
      "name": "Prepare note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $(\"One comment at a time\").item.json,\n  esc = (s) =>\n    String(s)\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replaceAll('\\\"', \"&quot;\")\n      .replaceAll(\"'\", \"&#39;\");\nreturn [\n  {\n    json: {\n      ticketId: $(\"Validate email ticket\").item.json.ticketId,\n      commentId: x.id,\n      personId: $(\"Check contact match\").item.json.personId,\n      content:\n        \"Message imported from Zendesk<br>From \" +\n        esc(x.via?.source?.from?.name ?? \"Zendesk user\") +\n        \"<br>\" +\n        esc(x.body).replaceAll(\"\\n\", \"<br>\"),\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
      "position": [
        4400,
        0
      ]
