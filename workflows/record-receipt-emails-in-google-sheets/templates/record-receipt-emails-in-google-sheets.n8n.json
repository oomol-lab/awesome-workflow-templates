    {
      "name": "Map receipt fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $(\"Choose receipt step\").item.json.jobId,\n  f = $json?.inference?.result?.fields,\n  subject = $(\"Prepare receipt email\").item.json.subject;\nif ($json?.inference?.job?.id !== job || !f) throw Error(\"Wrong Mindee result\");\nconst v = (x) => x?.value ?? \"\",\n  amount = v(f.total_amount),\n  date = v(f.date),\n  category = v(f.purchase_category),\n  currency = v(f.locale?.fields?.currency);\nif (amount !== \"\" && (typeof amount !== \"number\" || !Number.isFinite(amount)))\n  throw Error(\"Invalid total\");\nif ([date, category, currency].some((x) => typeof x !== \"string\"))\n  throw Error(\"Invalid receipt fields\");\nreturn {\n  json: {\n    Date: date,\n    Description: subject.split(\"-\")[1] || \"\",\n    Category: category,\n    Currency: currency,\n    Amount: amount,\n  },\n};\n"
