    {
      "name": "Check the job status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $json.job;\nconst expected = $(\"Choose receipt step\").item.json.jobId;\nif (\n  !job ||\n  job.id !== expected ||\n  job.status === \"Failed\" ||\n  (job.status === \"Processing\" && $runIndex >= 199)\n)\n  throw Error(\"Mindee job failed or timed out\");\nif (job.status !== \"Processing\" && job.status !== \"Processed\") throw Error(\"Invalid Mindee status\");\nif (\n  job.status === \"Processed\" &&\n  !/^https:\\/\\/api-v2\\.mindee\\.net\\/v2\\/products\\/extraction\\/results\\/[0-9a-f-]{36}$/i.test(\n    job.result_url || \"\",\n  )\n)\n  throw Error(\"Invalid result URL\");\nreturn { json: { ready: job.status === \"Processed\", resultUrl: job.result_url } };\n"
      },
