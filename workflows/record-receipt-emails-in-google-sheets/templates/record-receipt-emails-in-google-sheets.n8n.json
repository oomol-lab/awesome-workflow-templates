    {
      "name": "Prepare receipt email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { simpleParser } = require(\"mailparser\"),\n  uid = $json.uid;\nif (!Number.isSafeInteger(Number(uid)) || Number(uid) < 1) throw Error(\"Invalid UID\");\nconst m = await simpleParser(await helpers.getBinaryDataBuffer(0, \"data\")),\n  subject = typeof m.subject === \"string\" ? m.subject : \"\",\n  match = /(expenses|reciept|receipt)/i.test(subject),\n  a = m.attachments?.[0];\nif (match && !a) throw Error(\"Matching email has no attachment\");\nconst binary = a\n  ? {\n      attachment_0: await helpers.prepareBinaryData(\n        a.content,\n        a.filename || \"receipt\",\n        a.contentType,\n      ),\n    }\n  : {};\nreturn { json: { uid: String(uid), subject, match }, binary };\n"
      },
