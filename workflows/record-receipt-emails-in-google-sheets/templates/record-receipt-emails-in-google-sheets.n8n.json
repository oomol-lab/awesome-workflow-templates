    {
      "name": "Choose receipt step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.item_key);\nif (rows.length > 1) throw Error(\"Duplicate receipt state\");\nif (!rows.length)\n  return [\n    {\n      json: {\n        step: $(\"Prepare receipt email\").item.json.match ? \"new-match\" : \"new-skip\",\n        jobId: \"\",\n      },\n    },\n  ];\nconst r = rows[0];\nif (r.status.startsWith(\"pending-\")) throw Error(\"Inspect pending receipt operation\");\nif ([\"done\", \"ready-mark\"].includes(r.status)) return [{ json: { step: r.status, jobId: \"\" } }];\nif (r.status !== \"ready-poll\") throw Error(\"Invalid receipt state\");\nconst p = JSON.parse(r.payload || \"{}\");\nif (!/^[0-9a-f-]{36}$/i.test(p.jobId || \"\")) throw Error(\"Missing job ID\");\nreturn [{ json: { step: \"ready-poll\", jobId: p.jobId } }];\n"
      },
