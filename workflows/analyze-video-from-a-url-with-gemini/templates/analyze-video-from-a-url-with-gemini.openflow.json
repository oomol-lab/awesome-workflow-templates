    "modules": {
      "n_915b0489c0d87a79": {
        "name": "Set the video URL and instructions",
        "imports": [],
        "source": "function configureVideo({ videoUrl, instruction }) {\n  if (\n    typeof videoUrl !== \"string\" ||\n    !/^https:\\/\\/[a-z0-9.-]+(?::443)?\\/(?!\\/)[^#\\s\\\\]+$/i.test(videoUrl) ||\n    /^https:\\/\\/[^/]+\\.invalid\\//i.test(videoUrl)\n  ) {\n    throw new Error(\"Set a direct HTTPS video URL\");\n  }\n  if (typeof instruction !== \"string\" || !instruction.trim() || instruction.length > 4000) {\n    throw new Error(\"Enter video analysis instructions of up to 4,000 characters\");\n  }\n  return { videoUrl, instruction };\n}\nexport default configureVideo;\n"
      },
      "n_b69dcd495c9f2485": {
        "name": "Check video size and type",
        "imports": [],
        "source": "function videoMetadata({ size, mime, status }) {\n  if (status !== 200 || !Number.isSafeInteger(size) || size < 1 || size > 10 * 1024 * 1024) {\n    throw new Error(\"The video download must contain a complete file of up to 10 MiB\");\n  }\n  const supported = [\n    \"video/mp4\",\n    \"video/mpeg\",\n    \"video/quicktime\",\n    \"video/mov\",\n    \"video/avi\",\n    \"video/x-flv\",\n    \"video/mpg\",\n    \"video/webm\",\n    \"video/wmv\",\n    \"video/3gpp\",\n  ];\n  if (!supported.includes(mime))\n    throw new Error(\"The download did not return a supported video Content-Type\");\n  return { length: String(size), mime };\n}\nexport default ({ video, status }) =>\n  videoMetadata({ size: video.size, mime: video.mediaType, status });\n"
      },
      "n_e1eaa32106f0b9c6": {
        "name": "Read the Gemini upload URL",
        "imports": [],
        "source": "function uploadSession(headers) {\n  const url = Object.entries(headers ?? {}).find(\n    ([key]) => key.toLowerCase() === \"x-goog-upload-url\",\n  )?.[1];\n  if (\n    typeof url !== \"string\" ||\n    !/^https:\\/\\/generativelanguage\\.googleapis\\.com\\/upload\\/v1beta\\/files\\?[^#\\s\\\\]+$/.test(url)\n  ) {\n    throw new Error(\"Gemini did not return a trusted resumable upload URL\");\n  }\n  return url;\n}\nexport default ({ headers }) => ({ url: uploadSession(headers) });\n"
      },
      "n_7dc6078f39882a12": {
        "name": "Check the uploaded Gemini file",
        "imports": [],
        "source": "function uploadedFile({ body, mime, length }) {\n  const file = body?.file;\n  if (\n    !/^files\\/[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$/.test(file?.name ?? \"\") ||\n    file.mimeType !== mime ||\n    String(file.sizeBytes) !== length\n  ) {\n    throw new Error(\"Gemini upload did not return the matching file metadata\");\n  }\n  const url = \"https://generativelanguage.googleapis.com/v1beta/\" + file.name;\n  if (file.uri !== url) throw new Error(\"Gemini upload returned an unexpected file URI\");\n  if (file.state !== \"ACTIVE\" && file.state !== \"PROCESSING\") {\n    throw new Error(\"Gemini upload failed to process the video\");\n  }\n  return { fileName: file.name, fileUrl: url, mime };\n}\nexport default uploadedFile;\n"
      },
      "n_b4f558fe00623ad5": {
        "name": "Check the same file is ready",
        "imports": [],
        "source": "function fileStatus({ file, fileName, fileUrl, mime, instruction, attempt }) {\n  if (file?.name !== fileName || file?.uri !== fileUrl || file?.mimeType !== mime) {\n    throw new Error(\"Gemini status did not match the uploaded video\");\n  }\n  if (file.state === \"ACTIVE\") {\n    return {\n      processing: false,\n      attempt,\n      request: {\n        contents: [\n          {\n            role: \"user\",\n            parts: [{ fileData: { fileUri: fileUrl, mimeType: mime } }, { text: instruction }],\n          },\n        ],\n        generationConfig: { maxOutputTokens: 8192, thinkingConfig: { thinkingLevel: \"LOW\" } },\n      },\n    };\n  }\n  if (file.state !== \"PROCESSING\") throw new Error(\"Gemini failed to process the uploaded video\");\n  if (attempt >= 12)\n    throw new Error(\"Gemini video processing did not finish after 12 status checks\");\n  return { processing: true, attempt, request: null };\n}\nexport default ({ previous, ...inputs }) => fileStatus({ ...inputs, attempt: (previous ?? 0) + 1 });\n"
      },
      "n_27c4b693c406791e": {
        "name": "Extract the video description",
        "imports": [],
        "source": "function videoDescription(body) {\n  const candidate = body?.candidates?.[0];\n  if (candidate?.finishReason !== \"STOP\") throw new Error(\"Gemini did not complete video analysis\");\n  const description = (candidate.content?.parts ?? [])\n    .filter((part) => !part.thought && typeof part.text === \"string\")\n    .map((part) => part.text)\n    .join(\"\\n\")\n    .trim();\n  if (!description) throw new Error(\"Gemini returned no video description\");\n  return { videoDescription: description };\n}\nexport default ({ body }) => videoDescription(body);\n"
      }
    },
