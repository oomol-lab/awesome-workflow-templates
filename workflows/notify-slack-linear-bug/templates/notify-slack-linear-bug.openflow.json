    "modules": {
      "n_efb91fbce566a80a": {
        "name": "Read bug event",
        "imports": [],
        "source": "export default function read({ body }) {\n  const e = JSON.parse(body.event);\n  return {\n    eligible:\n      typeof e.data?.priority === \"number\" &&\n      e.data.priority >= 3 &&\n      e.data.labels?.[0]?.name === \"bug\",\n    title: body.title,\n    url: e.url ?? \"\",\n  };\n}\n"
      },
      "n_e74fdab415e5b5df": {
        "name": "Format Slack message",
        "imports": [],
        "source": "export default function format({ title, url }) {\n  return { text: `<!channel> New urgent bug *<${url}|${title}>*` };\n}\n"
      }
    }
