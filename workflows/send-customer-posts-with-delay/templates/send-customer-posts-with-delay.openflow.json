      "n_84bb4b2af38d2ad0": {
        "name": "Select next customer",
        "imports": [],
        "source": "export default function next({ customers, previous }) {\n  const index = previous?.index ?? 0,\n    person = customers[index];\n  if (!person) return { more: false, state: { index }, body: {} };\n  return { more: true, state: { index: index + 1 }, body: { id: person.id, name: person.name } };\n}\n"
      }
