      "n_86a2db0e2f4736c9": {
        "name": "Choose the close date",
        "imports": [],
        "source": "export default function closeDate({ value }) {\n  return {\n    closeDate: /\\d\\d\\d\\d-\\d\\d-\\d\\d/i.test(value)\n      ? value\n      : new Date(new Date().setDate(new Date().getDate() + 21)).toISOString(),\n  };\n}\n"
      }
