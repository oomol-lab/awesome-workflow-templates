    {
      "name": "Validate tool input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json,\n  ops = [\n    \"GET_CALENDAR\",\n    \"GET_ALL_CALENDAR\",\n    \"AVALIABILITY_CALENDAR\",\n    \"CREATE_CALENDAR\",\n    \"UPDATE_CALENDAR\",\n    \"DELETE_CALENDAR\",\n  ];\nif (!ops.includes(x.operation)) throw Error(\"Unknown operation\");\nif (\n  [\"CREATE_CALENDAR\", \"UPDATE_CALENDAR\", \"DELETE_CALENDAR\"].includes(x.operation) &&\n  !/^[A-Za-z0-9_-]{1,100}$/.test(x.requestId || \"\")\n)\n  throw Error(\"Unique requestId required\");\nif ([\"GET_CALENDAR\", \"UPDATE_CALENDAR\", \"DELETE_CALENDAR\"].includes(x.operation) && !x.eventId)\n  throw Error(\"Event ID required\");\nif (\n  [\"CREATE_CALENDAR\", \"AVALIABILITY_CALENDAR\"].includes(x.operation) &&\n  (!Number.isFinite(Date.parse(x.start)) ||\n    !Number.isFinite(Date.parse(x.end)) ||\n    Date.parse(x.end) <= Date.parse(x.start))\n)\n  throw Error(\"Valid start/end required\");\nreturn {\n  json: {\n    ...x,\n    fingerprint: JSON.stringify({\n      op: x.operation,\n      id: x.eventId || \"\",\n      start: x.start || \"\",\n      end: x.end || \"\",\n      description: x.description,\n      useDefault: x.useDefault,\n    }),\n    mode: \"direct\",\n    relayUrl: \"YOUR_OPEN_FLOW_WEBHOOK_URL\",\n  },\n};\n"
      },
      "id": "google-calendar-six-mcp-tools-8"
    },
