    "modules": {
      "n_96b2269deaa37561": {
        "name": "Set the channel and description lines",
        "imports": [],
        "source": "function configure(settings) {\n  const { channelId, rowBefore, rowAfter, rowToInsert } = settings;\n  if (\n    !/^UC[A-Za-z0-9_-]{22}$/.test(channelId) ||\n    [rowBefore, rowAfter, rowToInsert].some(\n      (line) => typeof line !== \"string\" || !line.trim() || /[\\r\\n]/.test(line),\n    ) ||\n    rowBefore.trim() === rowAfter.trim() ||\n    [rowBefore.trim(), rowAfter.trim()].includes(rowToInsert.trim()) ||\n    /[<>]/.test(rowToInsert)\n  ) {\n    throw Error(\"Enter a YouTube channel ID and three distinct, nonempty single lines.\");\n  }\n  return { channelId, rowBefore: rowBefore.trim(), rowAfter: rowAfter.trim(), rowToInsert };\n}\nexport default ({ settings }) => ({ config: configure(settings) });\n"
      },
      "n_73e524ec5f9fc96c": {
        "name": "Read the latest three uploads",
        "imports": [],
        "source": "function ownedUploads(channels, channelId) {\n  const matches = Array.isArray(channels) ? channels.filter((ch) => ch.id === channelId) : [];\n  const playlist = matches[0]?.contentDetails?.relatedPlaylists?.uploads;\n  if (\n    matches.length !== 1 ||\n    typeof playlist !== \"string\" ||\n    !/^UU[A-Za-z0-9_-]{22}$/.test(playlist)\n  ) {\n    throw Error(\n      \"The connected YouTube account did not confirm the configured channel and uploads playlist.\",\n    );\n  }\n  return playlist;\n}\nfunction selectedVideos(items, playlist) {\n  if (!Array.isArray(items) || items.length > 3)\n    throw Error(\"YouTube returned an unexpected uploads list.\");\n  const ids = items.map((row) => {\n    const id = row.contentDetails?.videoId;\n    if (\n      !/^[A-Za-z0-9_-]{11}$/.test(id ?? \"\") ||\n      (row.snippet?.playlistId && row.snippet.playlistId !== playlist)\n    ) {\n      throw Error(\"The uploads list contains an invalid video.\");\n    }\n    return id;\n  });\n  if (new Set(ids).size !== ids.length) throw Error(\"The uploads list contains a repeated video.\");\n  return ids;\n}\nfunction planUpdates(videos, ids, settings) {\n  if (\n    !Array.isArray(videos) ||\n    videos.some((video) => !ids.includes(video.id)) ||\n    new Set(videos.map((video) => video.id)).size !== videos.length\n  ) {\n    throw Error(\"YouTube returned unexpected video IDs.\");\n  }\n  const jobs = [],\n    results = [];\n  for (const id of ids) {\n    const video = videos.find((item) => item.id === id);\n    const snippet = video?.snippet;\n    const result = (status) => results.push({ videoId: id, status });\n    if (!snippet || snippet.channelId !== settings.channelId) {\n      result(\"ownership_unconfirmed\");\n      continue;\n    }\n    if (\n      typeof snippet.description !== \"string\" ||\n      typeof snippet.title !== \"string\" ||\n      !snippet.title ||\n      !/^\\d+$/.test(snippet.categoryId ?? \"\") ||\n      (Object.hasOwn(snippet, \"tags\") &&\n        (!Array.isArray(snippet.tags) || snippet.tags.some((tag) => typeof tag !== \"string\"))) ||\n      (Object.hasOwn(snippet, \"defaultLanguage\") && typeof snippet.defaultLanguage !== \"string\")\n    ) {\n      result(\"snippet_unconfirmed\");\n      continue;\n    }\n    const pieces = snippet.description.split(/(\\r\\n|\\r|\\n)/);\n    const rows = pieces.filter((_, index) => index % 2 === 0);\n    const before = rows.findIndex((line) => line.trim() === settings.rowBefore);\n    const after = rows.findIndex((line) => line.trim() === settings.rowAfter);\n    if (before < 0 || after <= before) {\n      result(\"markers_not_ordered\");\n      continue;\n    }\n    if (rows.includes(settings.rowToInsert)) {\n      result(\"already_present\");\n      continue;\n    }\n    const raw = video.etag;\n    if (typeof raw !== \"string\" || !/^\"?[A-Za-z0-9_+/=-]+\"?$/.test(raw)) {\n      result(\"etag_unconfirmed\");\n      continue;\n    }\n    const etag = '\"' + raw.replaceAll('\"', \"\") + '\"';\n    const separator = pieces[2 * before + 1];\n    pieces.splice(2 * before + 2, 0, settings.rowToInsert, separator);\n    const description = pieces.join(\"\");\n    const body = {\n      id,\n      snippet: { title: snippet.title, categoryId: snippet.categoryId, description },\n    };\n    for (const field of [\"tags\", \"defaultLanguage\"])\n      if (Object.hasOwn(snippet, field)) body.snippet[field] = snippet[field];\n    jobs.push({ videoId: id, channelId: settings.channelId, etag, body });\n  }\n  return { jobs, results };\n}\nexport default async ({ config }, ctx) => {\n  const channel = await ctx.actions.call(\"youtube.list_channels\", {\n    mine: true,\n    part: [\"contentDetails\"],\n  });\n  const playlistId = ownedUploads(channel.channels, config.channelId);\n  const recent = await ctx.actions.call(\"youtube.list_playlist_items\", {\n    playlistId,\n    part: [\"contentDetails\"],\n    maxResults: 3,\n  });\n  const ids = selectedVideos(recent.playlistItems, playlistId);\n  const videos = ids.length\n    ? (await ctx.actions.call(\"youtube.list_videos\", { ids, part: [\"snippet\"] })).videos\n    : [];\n  return planUpdates(videos, ids, config);\n};\n"
      },
      "n_10053161a0d346b6": {
        "name": "Select a video update",
        "imports": [],
        "source": "export default ({ jobs, initial, previous }) => {\n  const progress = previous ?? { index: 0, results: initial };\n  const job = jobs[progress.index];\n  return {\n    progress,\n    more: job !== undefined,\n    results: progress.results,\n    job: job ?? {},\n    body: job?.body ?? {},\n    etag: job?.etag ?? \"\",\n  };\n};\n"
      },
      "n_a5a8841022ee3c35": {
        "name": "Check the update receipt",
        "imports": [],
        "source": "function checkedReceipt(job, status, body) {\n  if (status === 412) return { videoId: job.videoId, status: \"changed_since_read\" };\n  const same =\n    body?.id === job.videoId &&\n    body.snippet?.channelId === job.channelId &&\n    Object.entries(job.body.snippet).every(\n      ([key, val]) => JSON.stringify(val) === JSON.stringify(body.snippet[key]),\n    );\n  return {\n    videoId: job.videoId,\n    status: status === 200 && same ? \"updated\" : \"update_unconfirmed\",\n  };\n}\nexport default ({ job, progress, body, status }) => {\n  const updated = checkedReceipt(job, status, body);\n  return { progress: { index: progress.index + 1, results: [...progress.results, updated] } };\n};\n"
      }
