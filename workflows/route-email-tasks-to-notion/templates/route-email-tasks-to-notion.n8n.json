    },
    {
      "id": "route-email-tasks-to-notion-5",
      "name": "Deactivate Route",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "async function safeRequest(options) {\n  try {\n    return await helpers.httpRequest(options);\n  } catch {\n    throw Error(\"External request failed or outcome unknown\");\n  }\n}\nconst base = \"YOUR_AIRTABLE_BASE_ID\",\n  table = \"YOUR_AIRTABLE_TABLE_ID\",\n  token = $env.AIRTABLE_TOKEN,\n  id = $(\"Get Route by ID\").item.json.id,\n  url = `https://api.airtable.com/v0/${encodeURIComponent(base)}/${encodeURIComponent(table)}/${encodeURIComponent(id)}`,\n  r = await safeRequest({\n    method: \"PATCH\",\n    url,\n    headers: { Authorization: \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n    body: { fields: { Active: false } },\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n    json: true,\n  });\nif (r.statusCode !== 200 || r.body?.id !== id || r.body?.fields?.Active !== false)\n  throw Error(\"Route update failed or outcome unknown\");\nreturn { json: { ok: true } };\n"
      },
      "typeVersion": 2
    },
