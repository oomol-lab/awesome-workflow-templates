    {
      "id": "route-email-tasks-to-notion-8",
      "name": "Get Route by ID",
      "type": "n8n-nodes-base.code",
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "async function safeRequest(options) {\n  try {\n    return await helpers.httpRequest(options);\n  } catch {\n    throw Error(\"External request failed or outcome unknown\");\n  }\n}\nconst t = $env.AIRTABLE_TOKEN,\n  base = \"YOUR_AIRTABLE_BASE_ID\",\n  table = \"YOUR_AIRTABLE_TABLE_ID\",\n  route = $json.route;\nif (!route) return { json: { status: \"missing\", id: \"\" } };\nconst r = await safeRequest({\n  method: \"GET\",\n  url: `https://api.airtable.com/v0/${encodeURIComponent(base)}/${encodeURIComponent(table)}/${encodeURIComponent(route)}`,\n  headers: { Authorization: \"Bearer \" + t },\n  returnFullResponse: true,\n  ignoreHttpStatusErrors: true,\n  json: true,\n});\nif (r.statusCode === 404) return { json: { status: \"missing\", id: route } };\nif (r.statusCode !== 200 || r.body?.id !== route || typeof r.body?.fields?.Active !== \"boolean\")\n  throw Error(\"Route lookup failed\");\nreturn { json: { status: r.body.fields.Active ? \"active\" : \"inactive\", id: route } };\n"
      },
      "typeVersion": 2
    },
    {
      "id": "route-email-tasks-to-notion-9",
      "name": "Create Notion Page",
      "type": "n8n-nodes-base.code",
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "async function safeRequest(options) {\n  try {\n    return await helpers.httpRequest(options);\n  } catch {\n    throw Error(\"External request failed or outcome unknown\");\n  }\n}\nconst base = \"YOUR_AIRTABLE_BASE_ID\",\n  table = \"YOUR_AIRTABLE_TABLE_ID\",\n  token = $env.AIRTABLE_TOKEN,\n  id = $(\"Get Route by ID\").item.json.id,\n  url = `https://api.airtable.com/v0/${encodeURIComponent(base)}/${encodeURIComponent(table)}/${encodeURIComponent(id)}`,\n  r = await safeRequest({\n    method: \"GET\",\n    url,\n    headers: { Authorization: \"Bearer \" + token },\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n    json: true,\n  });\nif (\n  r.statusCode !== 200 ||\n  r.body?.id !== id ||\n  !r.body?.fields?.Active ||\n  !r.body?.fields?.Token ||\n  !r.body?.fields?.NotionDatabase\n)\n  throw Error(\"Route is inactive or incomplete\");\nconst match = String(r.body.fields.NotionDatabase).match(\n  /([0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i,\n);\nif (!match) throw Error(\"Invalid Notion database ID\");\nconst body = { ...$json, parent: { database_id: match[1] } },\n  result = await safeRequest({\n    method: \"POST\",\n    url: \"https://api.notion.com/v1/pages\",\n    headers: {\n      Authorization: \"Bearer \" + r.body.fields.Token,\n      \"Notion-Version\": \"2022-06-28\",\n      \"Content-Type\": \"application/json\",\n    },\n    body,\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n    json: true,\n  });\nif (result.statusCode === 401 || result.statusCode === 403) return { json: { status: \"rejected\" } };\nif (result.statusCode < 200 || result.statusCode >= 300 || !result.body?.id)\n  throw Error(\"Notion request failed or outcome unknown\");\nreturn { json: { status: \"done\", id: result.body.id } };\n"
      },
      "typeVersion": 2
    },
