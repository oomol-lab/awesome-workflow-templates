    {
      "id": "route-email-tasks-to-notion-4",
      "name": "Extract Route ID",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = String($(\"Gmail Trigger\").item.json.to?.text ?? \"\").match(/\\+(rec[a-zA-Z0-9]+)@/i);\nreturn { json: { route: m?.[1] ?? \"\" } };\n"
      },
