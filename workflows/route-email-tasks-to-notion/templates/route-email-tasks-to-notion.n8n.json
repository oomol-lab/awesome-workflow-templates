    {
      "id": "route-email-tasks-to-notion-13",
      "name": "Format Notion Page Blocks",
      "type": "n8n-nodes-base.code",
      "position": [
        2860,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $(\"Generate Actionable Task\").item.json.output,\n  s = $(\"Get Summary & Meta Data\").item.json.output,\n  rich = (x) => {\n    const chars = Array.from(String(x)),\n      out = [];\n    for (let i = 0; i < chars.length; i += 1800)\n      out.push({ type: \"text\", text: { content: chars.slice(i, i + 1800).join(\"\") } });\n    return out.length ? out : [{ type: \"text\", text: { content: \"\" } }];\n  };\nreturn {\n  json: {\n    properties: { Name: { title: rich(t.title) } },\n    children: [\n      { object: \"block\", type: \"paragraph\", paragraph: { rich_text: rich(t.description) } },\n      ...t.bulletpoints.map((x) => ({\n        object: \"block\",\n        type: \"bulleted_list_item\",\n        bulleted_list_item: { rich_text: rich(x) },\n      })),\n      {\n        object: \"block\",\n        type: \"paragraph\",\n        paragraph: { rich_text: rich(\"Email summary: \" + s.summary) },\n      },\n      {\n        object: \"block\",\n        type: \"paragraph\",\n        paragraph: { rich_text: rich([s.meta.sender, s.meta.subject, s.meta.date].join(\"\\n\")) },\n      },\n    ],\n  },\n};\n"
      },
      "typeVersion": 2
    },
