    "modules": {
      "n_d21d375ea8f0cf89": {
        "name": "Set the search query",
        "imports": [],
        "source": "export default function query({ query }) {\n  if (typeof query !== \"string\" || !query.trim() || query.length > 1000)\n    throw Error(\"Enter a search query\");\n  return { body: { query: query.trim(), language: \"en\" } };\n}\n"
      },
      "n_714bc87c7c592309": {
        "name": "Prepare sheet rows",
        "imports": [],
        "source": "export default function rows({ body, statusCode, bodyEncoding }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    bodyEncoding !== null ||\n    !body ||\n    !Array.isArray(body.places)\n  )\n    throw Error(\"Maps search failed or returned no places array\");\n  const scalar = (x) =>\n    x == null\n      ? \"\"\n      : typeof x === \"string\" ||\n          typeof x === \"boolean\" ||\n          (typeof x === \"number\" && Number.isFinite(x))\n        ? x\n        : (() => {\n            throw Error(\"Invalid place field\");\n          })();\n  const rows = body.places.map((p) => {\n    if (!p || typeof p.title !== \"string\" || typeof p.address !== \"string\")\n      throw Error(\"Invalid place\");\n    if (p.bookingLinks != null && !Array.isArray(p.bookingLinks))\n      throw Error(\"Invalid booking links\");\n    return [\n      p.title,\n      p.address,\n      scalar(p.rating),\n      scalar(p.priceLevel),\n      scalar(p.type),\n      scalar(p.bookingLinks?.[0]),\n      scalar(p.website),\n      scalar(p.phoneNumber),\n      scalar(p.position),\n    ];\n  });\n  return { rows, hasRows: rows.length > 0 };\n}\n"
      },
      "n_ad86c21819fe83fc": {
        "name": "Prepare the next place",
        "imports": [],
        "source": "export default function next({ rows, previous }) {\n  const i = previous?.next ?? 0;\n  if (!Array.isArray(rows) || !Number.isInteger(i) || i < 0 || i > rows.length)\n    throw Error(\"Invalid row state\");\n  return {\n    state: { next: i + 1 },\n    more: i < rows.length,\n    values: i < rows.length ? [rows[i]] : [],\n  };\n}\n"
      },
      "n_228d869e619c4487": {
        "name": "Confirm the append",
        "imports": [],
        "source": "export default function confirm({ updatedRows }) {\n  if (updatedRows !== 1) throw Error(\"The sheet did not confirm one appended row\");\n  return {};\n}\n"
      }
    }
