    "modules": {
      "n_763a0ceed11bfd99": {
        "name": "Prepare board query",
        "imports": [],
        "source": "export default function prepare({ boardId }) {\n  if (!/^\\d+$/.test(boardId)) throw Error(\"Enter a numeric board ID\");\n  return {\n    body: {\n      query:\n        \"query ($id: [ID!]) { boards (ids: $id) { id name description state board_folder_id board_kind owners { id } } }\",\n      variables: { id: boardId },\n    },\n  };\n}\n"
      },
      "n_14584a4ab44b8be8": {
        "name": "Check the response",
        "imports": [],
        "source": "export default function result({ body, statusCode }) {\n  if (\n    statusCode !== 200 ||\n    !body ||\n    typeof body !== \"object\" ||\n    (Array.isArray(body.errors) && body.errors.length) ||\n    !Array.isArray(body.data?.boards)\n  )\n    throw Error(\"Monday board lookup failed\");\n  return { boards: body.data.boards };\n}\n"
      }
    }
