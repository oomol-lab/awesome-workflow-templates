      "n_52805d0c1249ea0e": {
        "name": "Collect Airtable contacts",
        "imports": [],
        "source": "export default function collectSmsContactPage({ previousState, records, offset }) {\n  if (previousState === null) {\n    if (records !== null || offset !== null)\n      throw new Error(\"Unexpected Airtable page before collection starts\");\n    return { state: { records: [], seenOffsets: [] }, records: [], offset: null, more: true };\n  }\n  if (\n    !previousState ||\n    !Array.isArray(previousState.records) ||\n    !Array.isArray(previousState.seenOffsets) ||\n    !Array.isArray(records)\n  )\n    throw new Error(\"Invalid Airtable contact collection state\");\n  if (\n    offset !== null &&\n    (typeof offset !== \"string\" || !offset || previousState.seenOffsets.includes(offset))\n  )\n    throw new Error(\"Airtable returned an invalid or repeated pagination cursor\");\n  const state = {\n    records: [...previousState.records, ...records],\n    seenOffsets:\n      offset === null ? [...previousState.seenOffsets] : [...previousState.seenOffsets, offset],\n  };\n  return { state, records: state.records, offset, more: offset !== null };\n}\n"
      },
      "n_2a23d1cb4b1ebc4c": {
        "name": "Prepare and validate messages",
        "imports": [],
        "source": "export default function prepareSms({ records }) {\n  const messages = records.map((record) => {\n    const to = String(record.fields?.Number ?? \"\").trim();\n    if (!/^\\+[1-9]\\d{1,14}$/.test(to))\n      throw new Error(\"Each Airtable Number must be an E.164 phone number\");\n    const name = String(record.fields?.Name ?? \"\");\n    return { to, body: `Hello, ${name}!\\nSending this SMS from n8n!` };\n  });\n  return { messages };\n}\n"
      },
      "n_5269ba45db54b93c": {
        "name": "Collect SMS submissions",
        "imports": [],
        "source": "const receiptFields = [\"messageSid\", \"accountSid\", \"status\", \"to\", \"from\", \"body\"];\nexport default function collectSmsSubmission(input) {\n  const { previousState, messages, from } = input;\n  if (!Array.isArray(messages)) throw new Error(\"Expected the validated message collection\");\n  let state;\n  if (previousState === null) {\n    if (receiptFields.some((field) => input[\"last\" + field] !== null))\n      throw new Error(\"Unexpected SMS result before sending starts\");\n    if (messages.length && !/^\\+[1-9]\\d{1,14}$/.test(from))\n      throw new Error(\"Configure the Twilio sender as an E.164 phone number\");\n    state = { index: 0, sent: [] };\n  } else {\n    if (\n      !previousState ||\n      !Number.isSafeInteger(previousState.index) ||\n      previousState.index < 0 ||\n      previousState.index >= messages.length ||\n      !Array.isArray(previousState.sent) ||\n      previousState.sent.length !== previousState.index\n    )\n      throw new Error(\"Invalid SMS submission state\");\n    const result = Object.fromEntries(receiptFields.map((field) => [field, input[\"last\" + field]]));\n    if (typeof result.messageSid !== \"string\" || !result.messageSid.trim())\n      throw new Error(\"Twilio did not return a submitted message SID\");\n    state = { index: previousState.index + 1, sent: [...previousState.sent, result] };\n  }\n  const message = state.index < messages.length ? messages[state.index] : null;\n  return {\n    state,\n    sent: state.sent,\n    count: state.index,\n    more: message !== null,\n    to: message?.to ?? \"\",\n    body: message?.body ?? \"\",\n    from,\n  };\n}\n"
      }
    }
  },
