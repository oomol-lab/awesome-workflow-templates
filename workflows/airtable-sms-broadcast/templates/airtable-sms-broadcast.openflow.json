    "modules": {
      "n_52805d0c1249ea0e": {
        "name": "Read all Airtable contacts",
        "imports": [],
        "source": "export default async function readSmsContacts({ baseId, tableIdOrName }, context) {\n  const records = [];\n  const seen = new Set();\n  let offset;\n  do {\n    const page = await context.actions.airtable.list_records({ baseId, tableIdOrName, ...(offset ? { offset } : {}) });\n    if (!Array.isArray(page.records)) throw new Error('Airtable returned no records array');\n    records.push(...page.records);\n    offset = page.offset;\n    if (offset != null && (typeof offset !== 'string' || !offset || seen.has(offset))) throw new Error('Airtable returned an invalid or repeated pagination cursor');\n    if (offset) seen.add(offset);\n  } while (offset);\n  return { records };\n}\n"
      },
      "n_6c99c4784cc057ff": {
        "name": "Prepare and validate messages",
        "imports": [],
        "source": "export default function prepareSms({ records }) {\n  const messages = records.map((record) => {\n    const to = String(record.fields?.Number ?? '').trim();\n    if (!/^\\+[1-9]\\d{1,14}$/.test(to)) throw new Error('Each Airtable Number must be an E.164 phone number');\n    const name = String(record.fields?.Name ?? '');\n    return { to, body: `Hello, ${name}!\\nSending this SMS from n8n!` };\n  });\n  return { messages };\n}\n"
      },
      "n_5b97c6e3e5aa25f8": {
        "name": "Send SMS in order",
        "imports": [],
        "source": "export default async function sendSms({ messages, from }, context) {\n  if (messages.length && !/^\\+[1-9]\\d{1,14}$/.test(from)) throw new Error('Configure the Twilio sender as an E.164 phone number');\n  const sent = [];\n  for (const message of messages) sent.push(await context.actions.twilio.send_message({ from, ...message }));\n  return { sent, count: sent.length };\n}\n"
      }
    }
