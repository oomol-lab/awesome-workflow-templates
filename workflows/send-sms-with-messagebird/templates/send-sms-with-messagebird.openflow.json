    "modules": {
      "n_dd0b034684325e23": {
        "name": "Prepare the SMS",
        "imports": [],
        "source": "export default function prepare({recipients,originator,message}){const parts=recipients.split(',').map(x=>x.trim());if(!parts.length||parts.length>50||parts.some(x=>!/^\\+?\\d{1,15}$/.test(x)))throw Error('Enter 1 to 50 recipient numbers with country codes');return {body:{recipients:parts.map(x=>parseInt(x,10)),originator,body:message}};}\n"
      }
