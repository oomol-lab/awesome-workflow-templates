    "modules": {
      "n_595a09efb7085d16": {
        "name": "Authenticate PDF event",
        "imports": [],
        "source": "export default function f({ body, headers, secret, term }) {\n  if (!secret || headers.authorization !== secret) throw Error(\"Unauthorized\");\n  if (\n    !body?.messageId ||\n    !body?.attachmentKey ||\n    !body?.fileName ||\n    typeof body?.text !== \"string\" ||\n    !term\n  )\n    throw Error(\"Missing PDF data\");\n  if (body.text.length / 4 > 3950) throw Error(\"PDF text exceeds source token estimate\");\n  return { text: body.text, fileName: body.fileName, term };\n}\n"
      },
      "n_7f97723e4a317b16": {
        "name": "Reserve matching PDF upload",
        "imports": [],
        "source": "export default async function f({ body, classification, acknowledge, resolution }, ctx) {\n  const { messageId, attachmentKey, fileName } = body || {};\n  if (!messageId || !/^attachment_\\d+$/.test(attachmentKey || \"\") || !fileName)\n    throw Error(\"Missing PDF identity\");\n  const key = \"pdf-match:\" + messageId + \":\" + attachmentKey;\n  let s = await ctx.state.get(key);\n  if (s?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect pending PDF upload \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, upload: false, request: {} };\n    }\n    s = null;\n  }\n  if (s?.status === \"done\" || !classification.match) return { key, upload: false, request: {} };\n  await ctx.state.set(key, { status: \"pending\", fileName });\n  return { key, upload: true, request: { messageId, attachmentKey, fileName } };\n}\n"
      },
      "n_2ca755dc7adb3f81": {
        "name": "Confirm PDF upload",
        "imports": [],
        "source": "export default async function f({ key, body, request }, ctx) {\n  if (\n    !body?.id ||\n    body.messageId !== request.messageId ||\n    body.attachmentKey !== request.attachmentKey\n  )\n    throw Error(\"Unknown PDF upload\");\n  await ctx.state.set(key, { status: \"done\", id: body.id });\n  return { ok: true };\n}\n"
      },
      "n_dece2d8b1084d6ad": {
        "name": "Return PDF decision",
        "imports": [],
        "source": "export default function f({ classification }) {\n  return { body: { status: \"done\", match: classification.match } };\n}\n"
      }
    }
