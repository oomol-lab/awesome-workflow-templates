    {
      "name": "Choose upload step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.item_key);\nif (rows.length > 1) throw Error(\"Duplicate PDF state\");\nif (rows[0]?.status === \"pending\") throw Error(\"Inspect pending PDF upload\");\nif (rows[0] && rows[0].status !== \"done\") throw Error(\"Invalid PDF state\");\nreturn [{ json: { step: rows.length ? \"done\" : \"upload\" } }];\n"
      },
