    {
      "name": "Expand attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  if (!item.json.id) throw Error(\"Missing Gmail message ID\");\n  for (const [key, binary] of Object.entries(item.binary || {}))\n    out.push({\n      json: { messageId: item.json.id, attachmentKey: key, fileName: binary.fileName || \"\" },\n      binary: { data: binary },\n    });\n}\nreturn out;\n"
      },
      "id": "save-matching-gmail-pdfs-to-drive-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "One attachment at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "options": {}
