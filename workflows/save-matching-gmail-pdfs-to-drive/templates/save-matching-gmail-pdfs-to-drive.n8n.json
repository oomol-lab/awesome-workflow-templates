    {
      "name": "Configure PDF matching",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $(\"One attachment at a time\").item.json,\n  text = $json.text;\nif (typeof text !== \"string\") throw Error(\"PDF text unavailable\");\nreturn {\n  json: { ...a, text, term: \"payslip\", mode: \"direct\", withinLimit: text.length / 4 <= 3950 },\n};\n"
      },
      "id": "save-matching-gmail-pdfs-to-drive-7",
      "position": [
        1540,
        0
      ]
    },
