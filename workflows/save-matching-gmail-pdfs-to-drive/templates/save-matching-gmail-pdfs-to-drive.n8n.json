        "jsCode": "const r = $(\"Upload original PDF webhook\").item.json.body || {},\n  b = $binary?.[r.attachmentKey];\nif (\n  !/^attachment_\\d+$/.test(r.attachmentKey || \"\") ||\n  !b ||\n  b.fileName !== r.fileName ||\n  $json.id !== r.messageId\n)\n  throw Error(\"Original PDF identity mismatch\");\nreturn { json: { messageId: r.messageId, attachmentKey: r.attachmentKey }, binary: { data: b } };\n"
