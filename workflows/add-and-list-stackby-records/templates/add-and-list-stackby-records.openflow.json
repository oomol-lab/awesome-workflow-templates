    "modules": {
      "n_58a61b773c42c76e": {
        "name": "Prepare the record",
        "imports": [],
        "source": "export default function setup({stackId,table,id,name}){if(typeof stackId!=='string'||! /^[A-Za-z0-9_-]+$/.test(stackId)||typeof table!=='string'||! /^[A-Za-z0-9_ -]+$/.test(table)||!table.trim())throw Error('Enter a valid stack ID and table name');if(typeof id!=='string'||!/^\\d+$/.test(id)||!Number.isSafeInteger(Number(id))||Number(id)<1)throw Error('Enter a numeric ID');if(typeof name!=='string'||!name.trim())throw Error('Enter a name');const root='https://stackby.com/api/betav1/',path=encodeURIComponent(stackId)+'/'+encodeURIComponent(table);return{stackId,table,id:Number(id),name:name.trim(),createUrl:root+'rowcreate/'+path,listUrl:root+'rowlist/'+path,body:{records:[{field:{ID:Number(id),Name:name.trim()}}]}};}\n"
      },
      "n_146827f30f72f83a": {
        "name": "Confirm the record",
        "imports": [],
        "source": "export default function created({body,id,name}){if(!Array.isArray(body)||body.length!==1||body[0]?.field?.ID!==id||body[0]?.field?.Name!==name)throw Error('Stackby did not confirm the created row');return{ok:true};}\n"
      },
      "n_8455909a6e478439": {
        "name": "Collect table pages",
        "imports": [],
        "source": "export default function pages({previousState,body,listUrl}){const state=previousState??{offset:0,rows:[]};if(previousState){if(!Array.isArray(body))throw Error('Stackby returned an invalid page');if(body.length>100)throw Error('Stackby page exceeds 100 rows');for(const row of body){if(!row||typeof row.field!=='object'||!row.field||Array.isArray(row.field))throw Error('Stackby returned an invalid row');state.rows.push(row.field)}if(body.length===0)return{state,more:false,url:'',rows:state.rows};if(state.offset>=9900)throw Error('Stackby result exceeds the 100 page limit');state.offset+=100;}return{state,more:true,url:listUrl+'?maxrecord=100&offset='+state.offset,rows:state.rows};}\n"
      }
    }
