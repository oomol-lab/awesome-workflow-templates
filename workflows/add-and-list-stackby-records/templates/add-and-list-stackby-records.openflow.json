    "modules": {
      "n_58a61b773c42c76e": {
        "name": "Prepare the record",
        "imports": [],
        "source": "export default function setup({ stackId, table, id, name }) {\n  if (\n    typeof stackId !== \"string\" ||\n    !/^[A-Za-z0-9_-]+$/.test(stackId) ||\n    typeof table !== \"string\" ||\n    !/^[A-Za-z0-9_ -]+$/.test(table) ||\n    !table.trim()\n  )\n    throw Error(\"Enter a valid stack ID and table name\");\n  if (\n    typeof id !== \"string\" ||\n    !/^\\d+$/.test(id) ||\n    !Number.isSafeInteger(Number(id)) ||\n    Number(id) < 1\n  )\n    throw Error(\"Enter a numeric ID\");\n  if (typeof name !== \"string\" || !name.trim()) throw Error(\"Enter a name\");\n  const root = \"https://stackby.com/api/betav1/\",\n    path = encodeURIComponent(stackId) + \"/\" + encodeURIComponent(table);\n  return {\n    stackId,\n    table,\n    id: Number(id),\n    name: name.trim(),\n    createUrl: root + \"rowcreate/\" + path,\n    listUrl: root + \"rowlist/\" + path,\n    body: { records: [{ field: { ID: Number(id), Name: name.trim() } }] },\n  };\n}\n"
      },
      "n_146827f30f72f83a": {
        "name": "Confirm the record",
        "imports": [],
        "source": "export default function created({ body, id, name }) {\n  if (\n    !Array.isArray(body) ||\n    body.length !== 1 ||\n    body[0]?.field?.ID !== id ||\n    body[0]?.field?.Name !== name\n  )\n    throw Error(\"Stackby did not confirm the created row\");\n  return { ok: true };\n}\n"
      },
      "n_8455909a6e478439": {
        "name": "Collect table pages",
        "imports": [],
        "source": "export default function pages({ previousState, body, listUrl }) {\n  const state = previousState ?? { offset: 0, rows: [] };\n  if (previousState) {\n    if (!Array.isArray(body)) throw Error(\"Stackby returned an invalid page\");\n    if (body.length > 100) throw Error(\"Stackby page exceeds 100 rows\");\n    for (const row of body) {\n      if (!row || typeof row.field !== \"object\" || !row.field || Array.isArray(row.field))\n        throw Error(\"Stackby returned an invalid row\");\n      state.rows.push(row.field);\n    }\n    if (body.length === 0) return { state, more: false, url: \"\", rows: state.rows };\n    if (state.offset >= 9900) throw Error(\"Stackby result exceeds the 100 page limit\");\n    state.offset += 100;\n  }\n  return {\n    state,\n    more: true,\n    url: listUrl + \"?maxrecord=100&offset=\" + state.offset,\n    rows: state.rows,\n  };\n}\n"
      }
    }
