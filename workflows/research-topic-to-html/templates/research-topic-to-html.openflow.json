          "modules": {
            "n_440592ccecb06d97": {
              "name": "Check topic",
              "imports": [],
              "source": "export default function ({ body }) {\n  return {\n    topic: typeof body?.topic === \"string\" ? body.topic.trim() : \"\",\n    chatId: typeof body?.chatId === \"string\" ? body.chatId.trim() : \"\",\n    requestId: typeof body?.requestId === \"string\" ? body.requestId.trim() : \"\",\n    valid:\n      typeof body?.topic === \"string\" &&\n      !!body.topic.trim() &&\n      typeof body?.chatId === \"string\" &&\n      !!body.chatId.trim() &&\n      typeof body?.requestId === \"string\" &&\n      !!body.requestId.trim(),\n  };\n}\n"
            },
            "n_b575a03fba8da9ab": {
              "name": "Send research excerpt to Telegram",
              "imports": [],
              "source": "export default async function ({ requestId, chatId, text }, ctx) {\n  const key = \"summary-notice:\" + requestId;\n  if (await ctx.state.get(key)) throw Error(\"Inspect existing notification before retrying \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  const r = await ctx.actions.call(\"telegram.send_message\", { chatId, text: text.slice(0, 300) });\n  if (!r?.messageId) throw Error(\"Unknown Telegram result\");\n  await ctx.state.set(key, { status: \"sent\", messageId: r.messageId });\n  return { ok: true };\n}\n"
            },
            "n_6835dfac8f8bd919": {
              "name": "Prepare article content",
              "imports": [],
              "source": "export default function ({ article }) {\n  return { text: JSON.stringify(article) };\n}\n"
            },
            "n_d8c50312c5e27992": {
              "name": "Prepare HTML response",
              "imports": [],
              "source": "export default function ({ html }) {\n  return { body: { ok: true, html } };\n}\n"
            },
            "n_3ecaf9efa984d6d9": {
              "name": "Report missing topic",
              "imports": [],
              "source": "export default function () {\n  return { body: { ok: false, status: 400, error: \"Provide topic, chatId and requestId.\" } };\n}\n"
            }
          }
        }
