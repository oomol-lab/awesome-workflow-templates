            "n_9d93a7123af992a5": {
              "name": "Send topic to Telegram",
              "imports": [],
              "source": "export default async function ({ requestId, chatId, text }, ctx) {\n  const key = \"research-notice:\" + requestId;\n  if (await ctx.state.get(key)) throw Error(\"Inspect existing notification before retrying \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  const r = await ctx.actions.call(\"telegram.send_message\", { chatId, text: text.slice(0, 4096) });\n  if (!r?.messageId) throw Error(\"Unknown Telegram result\");\n  await ctx.state.set(key, { status: \"sent\", messageId: r.messageId });\n  return { ok: true };\n}\n"
            },
            "n_f2c583464abfc041": {
              "name": "Prepare Perplexity request",
              "imports": [],
              "source": "export default function ({ topic }) {\n  if (!topic.trim()) throw Error(\"Missing topic\");\n  return {\n    body: {\n      model: \"sonar\",\n      messages: [\n        { role: \"system\", content: \"Provide an informative research response.\" },\n        { role: \"user\", content: topic },\n      ],\n      max_tokens: 4000,\n      temperature: 0.2,\n      search_domain_filter: [\"perplexity.ai\"],\n      search_recency_filter: \"month\",\n    },\n  };\n}\n"
            },
            "n_f89d6f4f765041ab": {
              "name": "Read research response",
              "imports": [],
              "source": "export default function ({ body }) {\n  const result = body?.choices?.[0]?.message?.content;\n  if (typeof result !== \"string\" || !result.trim()) throw Error(\"Missing research response\");\n  return { result };\n}\n"
            }
          }
        }
      }
