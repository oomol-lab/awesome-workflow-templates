    "modules": {
      "n_f0797e4d6927925d": {
        "name": "Validate SMS details",
        "imports": [],
        "source": "export default function message({ to, text }) {\n  if (typeof to !== \"string\" || !/^\\+[1-9][0-9]{1,14}$/.test(to))\n    throw Error(\"Enter an E.164 phone number\");\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"Enter a non-empty SMS\");\n  return { messages: [{ source: \"php\", body: text, to }] };\n}\n"
      },
      "n_a65d744ba73003cb": {
        "name": "Confirm the queued message",
        "imports": [],
        "source": "export default function confirm({ raw }) {\n  const m = raw?.data?.messages;\n  if (\n    raw?.response_code !== \"SUCCESS\" ||\n    !Array.isArray(m) ||\n    m.length !== 1 ||\n    m[0]?.status !== \"SUCCESS\" ||\n    typeof m[0].message_id !== \"string\" ||\n    !m[0].message_id\n  )\n    throw Error(\"ClickSend did not confirm the message was queued\");\n  return { messageId: m[0].message_id };\n}\n"
      }
    }
