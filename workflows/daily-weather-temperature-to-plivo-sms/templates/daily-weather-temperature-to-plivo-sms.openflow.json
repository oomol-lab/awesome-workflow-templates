    "modules": {
      "n_9dc0112fc05824b3": {
        "name": "Format temperature",
        "imports": [],
        "source": "export default function weatherMessage({weather,accountId,from,to}){if(weather?.cod!==200||typeof weather?.main?.temp!=='number'||!Number.isFinite(weather.main.temp))throw Error('OpenWeather response has no current temperature');if(!/^[A-Za-z0-9]+$/.test(accountId)||!from||!to)throw Error('Configure the Plivo account ID, sender and destination');return{url:`https://api.plivo.com/v1/Account/${accountId}/Message/`,body:{src:from,dst:to,text:`Hey! The temperature outside is ${weather.main.temp}°C.`}}}\n"
      }
    }
