      "n_d9c15ba7754f434d": {
        "name": "Validate server and request",
        "imports": [],
        "source": "export default function f({ body, headers, secret, server, engine }) {\n  const token = Object.entries(headers).find(([k]) => k.toLowerCase() === \"authorization\")?.[1];\n  let valid =\n    !!secret &&\n    token === secret &&\n    body.server_domain === server &&\n    body.command === \"container_log\" &&\n    /^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,200}$/.test(body.domain);\n  if (!valid) throw Error(\"Invalid request\");\n  return {\n    valid,\n    url: valid\n      ? engine.replace(/\\/$/, \"\") +\n        \"/v1.44/containers/\" +\n        encodeURIComponent(body.domain + \"_immich\") +\n        \"/json\"\n      : engine,\n    result: { status: \"error\", message: \"Invalid request\", data: \"\" },\n  };\n}\n"
      },
      "n_60bbb842676fb80f": {
        "name": "Read and decode Docker logs",
        "imports": [],
        "source": "export default async function logs({ url, token, status, body }, ctx) {\n  if (status !== 200 || !body?.Config || typeof body.Config.Tty !== \"boolean\")\n    throw Error(\"Docker inspection failed\");\n  const r = await ctx.fetch(url.replace(/\\/json$/, \"/logs?stdout=true&stderr=true&tail=1000\"), {\n    headers: { Authorization: \"Bearer \" + token },\n  });\n  if (!r.ok) throw Error(\"Docker logs unavailable\");\n  const bytes = new Uint8Array(await r.arrayBuffer());\n  let chunks = [];\n  if (body.Config.Tty) chunks = [bytes];\n  else {\n    let i = 0;\n    while (i < bytes.length) {\n      if (\n        i + 8 > bytes.length ||\n        ![1, 2].includes(bytes[i]) ||\n        bytes[i + 1] ||\n        bytes[i + 2] ||\n        bytes[i + 3]\n      )\n        throw Error(\"Invalid Docker log frame\");\n      let size = bytes[i + 4] * 16777216 + bytes[i + 5] * 65536 + bytes[i + 6] * 256 + bytes[i + 7];\n      i += 8;\n      if (i + size > bytes.length) throw Error(\"Truncated Docker log frame\");\n      chunks.push(bytes.subarray(i, i + size));\n      i += size;\n    }\n  }\n  let all = new Uint8Array(chunks.reduce((n, c) => n + c.length, 0)),\n    at = 0;\n  for (const c of chunks) {\n    all.set(c, at);\n    at += c.length;\n  }\n  return {\n    result: { status: \"success\", message: \"\", data: { logs: new TextDecoder().decode(all) } },\n  };\n}\n"
      }
    }
