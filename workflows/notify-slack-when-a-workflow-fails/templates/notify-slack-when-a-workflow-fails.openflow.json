        "name": "Prepare the Slack alert",
        "imports": [],
        "source": "export default function slackErrorIdentity({workflow,execution}) {\n if(!workflow||typeof workflow.name!=='string'||!workflow.name||!execution||typeof execution.runId!=='string'||!execution.runId)throw Error('Missing workflow or run identity');\n const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n return {message:`🐞 What?!\\n*This execution ${esc(workflow.name)} went wrong*\\nRun ID: ${esc(execution.runId)}`};\n}\n"
      }
