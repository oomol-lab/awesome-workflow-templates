{
  "name": "Publish Machine Telemetry to AMQP",
  "nodes": [
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        650,
        300
      ],
      "parameters": {
        "values": {
          "number": [],
          "string": [
            {
              "name": "machine_id.name",
              "value": "n8n_cr8"
            },
            {
              "name": "temperature_celsius",
              "value": "={{Math.floor(Math.random() * 100)}}"
            },
            {
              "name": "machine_id.uptime",
              "value": "={{Math.floor(Math.random() * 100)}}"
            },
            {
              "name": "time_stamp",
              "value": "={{Date.now()}}"
            }
          ],
          "boolean": []
        },
        "options": {}
      },
      "typeVersion": 1,
      "id": "publish-machine-telemetry-to-amqp-0"
    },
    {
      "name": "Interval",
      "type": "n8n-nodes-base.interval",
      "position": [
        450,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "publish-machine-telemetry-to-amqp-1"
    },
    {
      "name": "AMQP Sender",
      "type": "n8n-nodes-base.amqp",
      "position": [
        850,
        300
      ],
      "parameters": {
        "sink": "berlin_factory_01",
        "options": {
          "dataAsObject": true
        }
      },
      "typeVersion": 1,
      "id": "publish-machine-telemetry-to-amqp-2"
    },
    {
      "name": "Open Flow interval",
      "type": "n8n-nodes-base.interval",
      "position": [
        300,
        650
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "publish-machine-telemetry-to-amqp-tick",
      "disabled": true
    },
    {
      "id": "publish-machine-telemetry-to-amqp-forward",
      "name": "Send tick to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        650
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_OPENFLOW_HOST/webhook/YOUR_FLOW",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"tick\":true}",
        "options": {}
      }
    },
    {
      "id": "publish-machine-telemetry-to-amqp-hook",
      "name": "AMQP relay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        300,
        950
      ],
      "disabled": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-machine-telemetry-to-amqp",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "publish-machine-telemetry-to-amqp-unpack",
      "name": "Read telemetry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        950
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $json.body };\n"
      }
    },
    {
      "name": "AMQP relay sender",
      "type": "n8n-nodes-base.amqp",
      "position": [
        800,
        950
      ],
      "parameters": {
        "sink": "berlin_factory_01",
        "options": {
          "dataAsObject": true
        }
      },
      "typeVersion": 1,
      "id": "publish-machine-telemetry-to-amqp-relay"
    },
    {
      "id": "publish-machine-telemetry-to-amqp-respond",
      "name": "Confirm AMQP send",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1050,
        950
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "AMQP Sender",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Interval": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open Flow interval": {
      "main": [
        [
          {
            "node": "Send tick to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AMQP relay webhook": {
      "main": [
        [
          {
            "node": "Read telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read telemetry": {
      "main": [
        [
          {
            "node": "AMQP relay sender",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AMQP relay sender": {
      "main": [
        [
          {
            "node": "Confirm AMQP send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
