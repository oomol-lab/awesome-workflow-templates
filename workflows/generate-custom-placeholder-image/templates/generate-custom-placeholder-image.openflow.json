    "modules": {
      "n_9efc6db5f3a3e61f": {
        "name": "Generate the image",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function generate(\n  { size, backgroundColor, textColor, text, fontSize, type, fontFamily },\n  context,\n) {\n  const q = new URLSearchParams({ text, fontSize, type, fontFamily });\n  const url = `https://dummyjson.com/image/${encodeURIComponent(size)}/${encodeURIComponent(backgroundColor)}/${encodeURIComponent(textColor)}?${q}`;\n  const r = await context.fetch(url, { method: \"GET\" });\n  if (!r.ok) throw Error(\"Image request failed\");\n  const bytes = Buffer.from(await r.arrayBuffer());\n  if (!bytes.length) throw Error(\"Empty image response\");\n  return {\n    file: {\n      name: \"placeholder.\" + type,\n      mimeType: r.headers.get(\"content-type\"),\n      contentBase64: bytes.toString(\"base64\"),\n    },\n  };\n}\n"
      }
    }
