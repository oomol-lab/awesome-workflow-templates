    "modules": {
      "n_a96d3ee4355489ae": {
        "name": "Create calendar event file",
        "imports": [],
        "source": "export default function invitation({title,start,end}){\n if(typeof title!=='string'||!title.trim())throw Error('Set an event title');\n const date=x=>{if(typeof x!=='string'||!/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$/.test(x)||!Number.isFinite(Date.parse(x))||new Date(x).toISOString().replace('.000Z','Z')!==x)throw Error('Use valid UTC event dates like 2030-06-11T15:30:00Z');return new Date(x)};\n const a=date(start),b=date(end);if(b<=a)throw Error('End must follow start');const stamp=d=>d.toISOString().replace(/[-:]/g,'').replace(/\\.\\d{3}Z$/,'Z'),escape=s=>s.replace(/\\\\/g,'\\\\\\\\').replace(/\\r\\n|\\r|\\n/g,'\\\\n').replace(/,/g,'\\\\,').replace(/;/g,'\\\\;');\n const fold=s=>{let out='',line='';for(const c of s){if(Buffer.from(line+c,'utf8').length>75){out+=line+'\\r\\n';line=' '+c}else line+=c}return out+line};\n const uid=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+'@openflow.local';const data=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Open Flow//Calendar Invitation//EN','CALSCALE:GREGORIAN','METHOD:PUBLISH','BEGIN:VEVENT','UID:'+uid,'DTSTAMP:'+stamp(new Date()),'DTSTART:'+stamp(a),'DTEND:'+stamp(b),'SUMMARY:'+escape(title),'END:VEVENT','END:VCALENDAR'].map(fold).join('\\r\\n')+'\\r\\n';return {attachments:[{filename:'invite.ics',type:'text/calendar',contentBase64:Buffer.from(data,'utf8').toString('base64')}],subject:title.replace(/[\\r\\n]+/g,' ')};\n}\n"
      }
