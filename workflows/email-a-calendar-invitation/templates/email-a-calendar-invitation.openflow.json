    "modules": {
      "n_a96d3ee4355489ae": {
        "name": "Create calendar event file",
        "imports": [],
        "source": "export default function invitation({ title, start, end }) {\n  if (typeof title !== \"string\" || !title.trim()) throw Error(\"Set an event title\");\n  const date = (x) => {\n    if (\n      typeof x !== \"string\" ||\n      !/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$/.test(x) ||\n      !Number.isFinite(Date.parse(x)) ||\n      new Date(x).toISOString().replace(\".000Z\", \"Z\") !== x\n    )\n      throw Error(\"Use valid UTC event dates like 2030-06-11T15:30:00Z\");\n    return new Date(x);\n  };\n  const a = date(start),\n    b = date(end);\n  if (b <= a) throw Error(\"End must follow start\");\n  const stamp = (d) =>\n      d\n        .toISOString()\n        .replace(/[-:]/g, \"\")\n        .replace(/\\.\\d{3}Z$/, \"Z\"),\n    escape = (s) =>\n      s\n        .replace(/\\\\/g, \"\\\\\\\\\")\n        .replace(/\\r\\n|\\r|\\n/g, \"\\\\n\")\n        .replace(/,/g, \"\\\\,\")\n        .replace(/;/g, \"\\\\;\");\n  const fold = (s) => {\n    let out = \"\",\n      line = \"\";\n    for (const c of s) {\n      if (Buffer.from(line + c, \"utf8\").length > 75) {\n        out += line + \"\\r\\n\";\n        line = \" \" + c;\n      } else line += c;\n    }\n    return out + line;\n  };\n  const uid =\n    Date.now().toString(36) + \"-\" + Math.random().toString(36).slice(2) + \"@openflow.local\";\n  const data =\n    [\n      \"BEGIN:VCALENDAR\",\n      \"VERSION:2.0\",\n      \"PRODID:-//Open Flow//Calendar Invitation//EN\",\n      \"CALSCALE:GREGORIAN\",\n      \"METHOD:PUBLISH\",\n      \"BEGIN:VEVENT\",\n      \"UID:\" + uid,\n      \"DTSTAMP:\" + stamp(new Date()),\n      \"DTSTART:\" + stamp(a),\n      \"DTEND:\" + stamp(b),\n      \"SUMMARY:\" + escape(title),\n      \"END:VEVENT\",\n      \"END:VCALENDAR\",\n    ]\n      .map(fold)\n      .join(\"\\r\\n\") + \"\\r\\n\";\n  return {\n    attachments: [\n      {\n        filename: \"invite.ics\",\n        type: \"text/calendar\",\n        contentBase64: Buffer.from(data, \"utf8\").toString(\"base64\"),\n      },\n    ],\n    subject: title.replace(/[\\r\\n]+/g, \" \"),\n  };\n}\n"
      }
    }
