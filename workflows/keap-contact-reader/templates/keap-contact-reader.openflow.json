    "modules": {
      "n_21e7ecd0ccc48a9a": {
        "name": "Extract complete contact records",
        "imports": [],
        "source": "function readKeapContacts(page) {\n  if (\n    !page ||\n    typeof page !== \"object\" ||\n    Array.isArray(page) ||\n    !Array.isArray(page.contacts) ||\n    !page.contacts.every(\n      (contact) => contact && typeof contact === \"object\" && !Array.isArray(contact),\n    )\n  ) {\n    throw new Error(\"Keap did not return a contacts page\");\n  }\n  return { contacts: page.contacts, page, count: page.contacts.length };\n}\nexport default async function keapContacts({ body }) {\n  return readKeapContacts(body);\n}\n"
      }
    }
