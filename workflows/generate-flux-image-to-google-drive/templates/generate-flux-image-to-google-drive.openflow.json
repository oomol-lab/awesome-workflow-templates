    "modules": {
      "n_03d7c2fdc5b657aa": {
        "name": "Prepare the FLUX request",
        "imports": [],
        "source": "export default function input({prompt,width,height,steps,guidance}){if(typeof prompt!=='string'||!prompt.trim()||![width,height,steps].every(Number.isSafeInteger)||width<1||height<1||steps<1||typeof guidance!=='number'||!Number.isFinite(guidance))throw new Error('Provide a prompt and valid generation settings');return{input:{prompt,image_size:{width,height},num_inference_steps:steps,guidance_scale:guidance,num_images:1,enable_safety_checker:true}};}\n"
      },
      "n_6cf5a78d7b487a18": {
        "name": "Check fal queue URLs",
        "imports": [],
        "source": "export default function urls({statusUrl,responseUrl}){for(const u of [statusUrl,responseUrl]){if(typeof u!=='string'||!u.startsWith('https://queue.fal.run/'))throw new Error('Invalid fal queue URL');}return{statusUrl,responseUrl};}\n"
      },
      "n_d3ac6086cbc5b026": {
        "name": "Check completion",
        "imports": [],
        "source": "export default function status({status}){if(status==='COMPLETED')return{done:true};if(status==='IN_QUEUE'||status==='IN_PROGRESS')return{done:false};throw new Error('Generation stopped with an unexpected status');}\n"
      },
      "n_4c03dc72a5c670ee": {
        "name": "Download the complete image",
        "imports": [],
        "source": "import{Buffer}from'node:buffer';export default async function image({response},context){const item=response?.images?.[0];if(!item||typeof item.url!=='string'||!item.url.startsWith('https://'))throw new Error('fal did not return an image URL');const r=await context.fetch(item.url,{method:'GET'});if(!r.ok)throw new Error('Image download failed');const b=new Uint8Array(await r.arrayBuffer());if(!b.length||typeof item.file_size==='number'&&b.length!==item.file_size)throw new Error('Incomplete image');const mime=typeof item.content_type==='string'?item.content_type:r.headers.get('content-type');if(typeof mime!=='string'||!mime.startsWith('image/'))throw new Error('Unexpected image type');const path=new URL(item.url).pathname,segment=path.split('/').pop(),name=segment?decodeURIComponent(segment):'generated-image';return{name,mimeType:mime,contentBase64:Buffer.from(b).toString('base64'),bytes:b.length};}\n"
      },
      "n_082659fd0d70be1e": {
        "name": "Confirm the Drive image",
        "imports": [],
        "source": "export default function receipt({id,name,mimeType,bytes}){if(typeof id!=='string'||!id||typeof name!=='string'||!name||typeof mimeType!=='string'||!mimeType.startsWith('image/'))throw new Error('Drive did not confirm the image; inspect before replaying');return{result:{id,name,mimeType,bytes}};}\n"
      }
    }
