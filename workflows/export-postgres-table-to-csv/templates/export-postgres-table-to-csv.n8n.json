{
  "name": "Export a Postgres Table to CSV",
  "tags": [],
  "nodes": [
    {
      "id": "export-postgres-table-to-csv-0",
      "name": "When clicking \"Execute Workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        660,
        420
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "export-postgres-table-to-csv-1",
      "name": "Spreadsheet File",
      "type": "n8n-nodes-base.spreadsheetFile",
      "position": [
        1260,
        420
      ],
      "parameters": {
        "options": {},
        "operation": "toFile",
        "fileFormat": "csv"
      },
      "typeVersion": 1
    },
    {
      "id": "export-postgres-table-to-csv-2",
      "name": "TableName",
      "type": "n8n-nodes-base.set",
      "position": [
        840,
        420
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "TableName",
              "value": "YOUR_TABLE_NAME"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "export-postgres-table-to-csv-3",
      "name": "Postgres",
      "type": "n8n-nodes-base.postgres",
      "position": [
        1060,
        420
      ],
      "parameters": {
        "query": "={{ $json.query }}",
        "operation": "executeQuery",
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "id": "export-postgres-table-to-csv-validate-table-name",
      "name": "Validate table name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const table = $json.table ?? $json.TableName;\nif (\n  typeof table !== \"string\" ||\n  !/^[_A-Za-z][_A-Za-z0-9]*$/.test(table) ||\n  table.startsWith(\"YOUR_\")\n)\n  throw Error(\"Configure a simple table name\");\nreturn { json: { query: 'SELECT * FROM \"' + table + '\"' } };\n"
      }
    },
    {
      "id": "export-postgres-table-to-csv-hook",
      "name": "Postgres relay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        500
      ],
      "disabled": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "export-postgres-table-to-csv",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "export-postgres-table-to-csv-validate-relay-table",
      "name": "Validate relay table",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const table = $json.body?.table;\nif (\n  typeof table !== \"string\" ||\n  !/^[_A-Za-z][_A-Za-z0-9]*$/.test(table) ||\n  table.startsWith(\"YOUR_\")\n)\n  throw Error(\"Configure a simple table name\");\nreturn { json: { query: 'SELECT * FROM \"' + table + '\"' } };\n"
      }
    },
    {
      "id": "export-postgres-table-to-csv-relay-db",
      "name": "Read table for relay",
      "type": "n8n-nodes-base.postgres",
      "position": [
        600,
        500
      ],
      "parameters": {
        "query": "={{ $json.query }}",
        "operation": "executeQuery",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "export-postgres-table-to-csv-collect",
      "name": "Collect database rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => Object.keys(x).length);\nreturn [{ json: { rows } }];\n"
      }
    },
    {
      "id": "export-postgres-table-to-csv-respond",
      "name": "Return database rows",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "Postgres": {
      "main": [
        [
          {
            "node": "Spreadsheet File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TableName": {
      "main": [
        [
          {
            "node": "Validate table name",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking \"Execute Workflow\"": {
      "main": [
        [
          {
            "node": "TableName",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate table name": {
      "main": [
        [
          {
            "node": "Postgres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres relay webhook": {
      "main": [
        [
          {
            "node": "Validate relay table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate relay table": {
      "main": [
        [
          {
            "node": "Read table for relay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read table for relay": {
      "main": [
        [
          {
            "node": "Collect database rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect database rows": {
      "main": [
        [
          {
            "node": "Return database rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
