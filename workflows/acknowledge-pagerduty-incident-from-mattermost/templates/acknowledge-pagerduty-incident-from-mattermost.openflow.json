    "modules": {
      "n_3d13f386a26f577c": {
        "name": "Validate the action",
        "imports": [],
        "source": "export default function planAcknowledgement({body,secret,from}){\n if(typeof secret!=='string'||secret.length<24||secret==='YOUR_ACTION_SECRET')throw Error('Configure a strong action secret');const received=body?.context?.action_secret;if(typeof received!=='string'||received!==secret)throw Error('Invalid action secret');const incident=body?.context?.pagerduty_incident,channel=body?.channel_id;if(typeof incident!=='string'||!incident.trim()||typeof channel!=='string'||!channel.trim())throw Error('Missing incident or channel');if(typeof from!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(from)||from==='YOUR_PAGERDUTY_EMAIL')throw Error('Configure PagerDuty user email');return{incidentId:incident,channelId:channel,from};\n}\n"
      },
      "n_1dcbcd739353df88": {
        "name": "Confirm the incident status",
        "imports": [],
        "source": "export default function confirmAcknowledgement({incident,incidentId}){if(!incident||incident.id!==incidentId||incident.status!=='acknowledged')throw Error('PagerDuty did not confirm acknowledgement');return{message:'💪🏼 Incident status has been changed to Acknowledged on PagerDuty.'};}\n"
      }
    }
