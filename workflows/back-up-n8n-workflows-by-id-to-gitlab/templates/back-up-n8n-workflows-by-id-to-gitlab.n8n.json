      "name": "File status",
      "type": "n8n-nodes-base.code",
      "position": [
        2620,
        440
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nif (item.error) {\n  item.status =\n    item.error === \"The resource you are requesting could not be found\" ? \"new\" : \"error\";\n  return { json: item };\n}\nconst clean = (x) =>\n  Array.isArray(x)\n    ? x.map(clean)\n    : x && typeof x === \"object\"\n      ? Object.fromEntries(\n          Object.keys(x)\n            .filter((k) => k !== \"updatedAt\" && k !== \"global\")\n            .sort()\n            .map((k) => [k, clean(x[k])]),\n        )\n      : x;\nitem.status =\n  JSON.stringify(clean(item[\"workflow-from-n8n\"])) ===\n  JSON.stringify(clean(item[\"workflow-from-gitlab\"]))\n    ? \"same\"\n    : \"diff\";\nreturn { json: item };\n"
      },
      "typeVersion": 2
    },
