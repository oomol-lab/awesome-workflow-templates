{
  "name": "List Completed Unleashed Sales Orders",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        390,
        220
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "list-completed-unleashed-sales-orders-0"
    },
    {
      "name": "Read completed orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "https://api.unleashedsoftware.com/SalesOrders/1?orderStatus=Completed&pageSize=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "client-type",
              "value": "yourcompany/salesorders"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ 'https://api.unleashedsoftware.com/SalesOrders/' + ($pageCount === 0 ? 1 : $response.body.Pagination.PageNumber + 1) + '?orderStatus=Completed&pageSize=100' }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.Pagination.PageNumber >= $response.body.Pagination.NumberOfPages }}",
              "limitPagesFetched": false
            }
          }
        }
      },
      "id": "list-completed-unleashed-sales-orders-1"
    },
    {
      "name": "Collect orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function dates(x) {\n  if (Array.isArray(x)) return x.map(dates);\n  if (x && typeof x === \"object\")\n    return Object.fromEntries(Object.entries(x).map(([k, v]) => [k, dates(v)]));\n  if (typeof x === \"string\") {\n    const m = /\\/Date\\((\\d*)\\)\\//.exec(x);\n    if (m) return new Date(+m[1]).toISOString();\n  }\n  return x;\n}\nconst rows = [];\nfor (const { json } of $input.all()) {\n  const b = json.body;\n  if (!b || !Array.isArray(b.Items)) throw Error(\"Invalid Unleashed page\");\n  for (const x of b.Items) rows.push({ json: dates(x) });\n}\nreturn rows;\n"
      },
      "id": "list-completed-unleashed-sales-orders-2"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Read completed orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read completed orders": {
      "main": [
        [
          {
            "node": "Collect orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
