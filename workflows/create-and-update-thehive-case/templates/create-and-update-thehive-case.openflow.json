    "modules": {
      "n_d2091866500ca11b": {
        "name": "Validate case details",
        "imports": [],
        "source": "export default function input({ title, description, owner }) {\n  for (const [k, v] of Object.entries({ title, description, owner }))\n    if (typeof v !== \"string\" || !v.trim()) throw Error(\"Provide \" + k);\n  return {\n    title: title.trim(),\n    description: description.trim(),\n    owner: owner.trim(),\n    startDate: Date.now(),\n  };\n}\n"
      },
      "n_856e611de9e68ebf": {
        "name": "Prepare severity update",
        "imports": [],
        "source": "export default function update({ created }) {\n  const id = created?._id ?? created?.id;\n  if (typeof id !== \"string\" || !id || id.length > 256)\n    throw Error(\"TheHive did not return a case ID\");\n  return { caseId: id, endpoint: \"/api/case/\" + encodeURIComponent(id), body: { severity: 3 } };\n}\n"
      },
      "n_ee15d2b0f7ed10df": {
        "name": "Check update response",
        "imports": [],
        "source": "export default function check({ statusCode }) {\n  if (statusCode < 200 || statusCode >= 300) throw Error(\"Case update failed\");\n  return {};\n}\n"
      },
      "n_20deb11d25e56609": {
        "name": "Verify the updated case",
        "imports": [],
        "source": "export default function finish({ caseId, updated }) {\n  const id = updated?._id ?? updated?.id;\n  if (id !== caseId || updated?.severity !== 3)\n    throw Error(\"TheHive did not confirm the updated case\");\n  return { case: updated };\n}\n"
      }
    }
