          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Read properties",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read properties": {
      "main": [
        [
          {
            "node": "Prepare Berlin rent cells",
