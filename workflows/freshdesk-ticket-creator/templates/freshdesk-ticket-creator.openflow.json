    "modules": {
      "n_8cc40dfa67730774": {
        "name": "Prepare Freshdesk ticket",
        "imports": [],
        "source": "export default function ticketRequest({ email, subject, description }) {\n  if ([email, subject, description].some((value) => typeof value !== 'string' || !value)) throw new Error('Configure the requester email, subject and description');\n  return { endpoint: '/api/v2/tickets', body: { email, subject, description, status: 2, priority: 1, source: 2 } };\n}\n"
      },
      "n_a564e7fa96ecf6e8": {
        "name": "Confirm created ticket",
        "imports": [],
        "source": "export default function ticketResult({ body, statusCode, bodyEncoding }) {\n  if (statusCode !== 201 || bodyEncoding != null || !body || typeof body !== 'object' || Array.isArray(body) || !Number.isSafeInteger(body.id) || body.id <= 0) throw new Error('Freshdesk did not return a completed ticket creation record');\n  return { ticket: body };\n}\n"
      }
    }
