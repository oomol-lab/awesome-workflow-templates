    "modules": {
      "n_80acc40908ecc977": {
        "name": "Check target and objective",
        "imports": [],
        "source": "export default function input({ targetUrl, objective }) {\n  const rawTarget = String(targetUrl || \"\").trim(),\n    goal = String(objective || \"\").trim();\n  if (!rawTarget) throw Error(\"targetUrl is required\");\n  if (rawTarget.length > 2048) throw Error(\"targetUrl must be 2048 characters or fewer\");\n  if (!goal) throw Error(\"objective is required\");\n  if (goal.length > 500) throw Error(\"objective must be 500 characters or fewer\");\n  let target;\n  try {\n    target = new URL(rawTarget);\n  } catch {\n    throw Error(\"targetUrl must be a valid public HTTP or HTTPS URL\");\n  }\n  if (target.username || target.password) throw Error(\"targetUrl must not contain credentials\");\n  if (![\"http:\", \"https:\"].includes(target.protocol))\n    throw Error(\"targetUrl must use HTTP or HTTPS\");\n  const h = target.hostname.toLowerCase(),\n    privateHost =\n      h === \"localhost\" ||\n      h.endsWith(\".local\") ||\n      h === \"0.0.0.0\" ||\n      h === \"127.0.0.1\" ||\n      h === \"::1\" ||\n      h === \"[::1]\" ||\n      /^10\\./.test(h) ||\n      /^192\\.168\\./.test(h) ||\n      /^169\\.254\\./.test(h) ||\n      /^172\\.(1[6-9]|2\\d|3[01])\\./.test(h);\n  if (privateHost) throw Error(\"targetUrl must resolve to a public host\");\n  return { body: { url: target.toString(), mode: \"acceptance-pack\", objective: goal } };\n}\n"
      },
      "n_266d81e4c75a252c": {
        "name": "Summarize evidence",
        "imports": [],
        "source": "export default function summary({ report }) {\n  const readiness =\n    report?.readiness && typeof report.readiness === \"object\" ? report.readiness : {};\n  const pack =\n    report?.acceptance_pack && typeof report.acceptance_pack === \"object\"\n      ? report.acceptance_pack\n      : {};\n  const gate = pack.launch_gate && typeof pack.launch_gate === \"object\" ? pack.launch_gate : {};\n  const rawScore = readiness.score;\n  const numericScore =\n    typeof rawScore === \"number\" || typeof rawScore === \"string\" ? Number(rawScore) : 0;\n  const score = Number.isFinite(numericScore) ? numericScore : 0;\n  const riskFlags = Array.isArray(readiness.risk_flags) ? readiness.risk_flags : [];\n  const acceptanceTests = Array.isArray(pack.acceptance_tests) ? pack.acceptance_tests : [];\n  const backlog = Array.isArray(pack.prioritized_backlog) ? pack.prioritized_backlog : [];\n  const requiresAttention =\n    gate.decision !== \"ready\" ||\n    score < 80 ||\n    !Array.isArray(readiness.risk_flags) ||\n    riskFlags.length > 0;\n  return {\n    requiresAttention,\n    result: {\n      targetUrl: report?.target?.final_url || report?.target?.requested_url || null,\n      objective: pack.objective || null,\n      readinessScore: score,\n      readinessGrade: readiness.grade || null,\n      launchDecision: gate.decision || \"unknown\",\n      riskFlags,\n      acceptanceTestCount: acceptanceTests.length,\n      backlogCount: backlog.length,\n      requiresAttention,\n      acceptancePack: pack,\n      evidence: {\n        target: report?.target || null,\n        page: report?.page || null,\n        security: report?.security_headers || null,\n        readiness,\n      },\n    },\n  };\n}\n"
      },
      "n_7528a02aae6cee83": {
        "name": "Mark the decision",
        "imports": [],
        "source": "export default function decide({ result, requiresAttention }) {\n  return {\n    result: {\n      ...result,\n      workflowDecision: requiresAttention ? \"NEEDS_REVIEW\" : \"READY_TO_IMPLEMENT\",\n      nextStep: requiresAttention\n        ? \"Work through the P0 and P1 backlog items, then rerun the preflight.\"\n        : \"Use the acceptance tests as the implementation and launch checklist.\",\n    },\n  };\n}\n"
      }
    },
