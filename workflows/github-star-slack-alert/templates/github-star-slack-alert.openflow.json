    "modules": {
      "n_0c807d376aa291c3": {
        "name": "Format added or removed star",
        "imports": [],
        "source": "export default function starMessage({ body }) {\n  if (!['created', 'deleted'].includes(body.action)) throw new Error('Expected a GitHub star created or deleted action');\n  const total = body.repository?.stargazers_count, sender = body.sender;\n  if (!Number.isSafeInteger(total) || total < 0 || !sender || typeof sender.login !== 'string' || !sender.login) throw new Error('GitHub star event is missing its count or sender');\n  for (const field of ['avatar_url', 'html_url']) {\n    if (typeof sender[field] !== 'string') throw new Error('GitHub sender is missing ' + field);\n    const url = new URL(sender[field]);\n    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) throw new Error('GitHub sender URLs must use HTTP(S) without credentials');\n  }\n  const escape = (text) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const added = body.action === 'created';\n  const title = (added ? 'Got new star from: ' : 'Star got removed by: ') + escape(sender.login);\n  const message = 'The project has now: ' + total + ' Stars';\n  return { action: body.action, text: title + '\\n' + message, attachments: [{ color: added ? '#88FF00' : '#ff0000', fallback: title + '. ' + message, title, title_link: sender.html_url, image_url: sender.avatar_url, text: message }] };\n}\n"
      }
