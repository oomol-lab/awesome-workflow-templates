      "n_793c67f3b2f4a40d": {
        "name": "Prepare customer fields",
        "imports": [],
        "source": "export default function prepare({ customers }) {\n  return {\n    records: customers.map((customer) => ({\n      customer_id: String(customer.id ?? \"\"),\n      customer_name: String(customer.name ?? \"\"),\n      customer_description: String(customer.notes ?? \"\"),\n    })),\n  };\n}\n"
      }
