      "n_23949f56a88c88a6": {
        "name": "Read all Notion tasks",
        "imports": [],
        "source": "export default async function collect({ previous, sourceId }, ctx) {\n  if (!sourceId || sourceId.includes(\"YOUR_\")) throw Error(\"Configure Notion data source\");\n  const s = previous ?? { cursor: null, cursors: [], rows: [] },\n    args = { dataSourceId: sourceId, pageSize: 100 };\n  if (s.cursor) args.startCursor = s.cursor;\n  const p = await ctx.actions.call(\"notion.query_data_source\", args);\n  if (!Array.isArray(p?.results) || typeof p.has_more !== \"boolean\")\n    throw Error(\"Invalid Notion response\");\n  if (p.has_more && (!p.next_cursor || s.cursors.includes(p.next_cursor)))\n    throw Error(\"Invalid Notion cursor\");\n  const rows = [...s.rows, ...p.results],\n    state = {\n      rows,\n      cursor: p.has_more ? p.next_cursor : null,\n      cursors: p.has_more ? [...s.cursors, p.next_cursor] : s.cursors,\n    };\n  return { state, more: p.has_more };\n}\n"
      },
      "n_0f52fc9e0534e130": {
        "name": "Group tasks by deadline",
        "imports": [],
        "source": "export function renderTasks(rows, boardUrl, now) {\n  const esc = (x) =>\n    String(x ?? \"\").replace(\n      /[&<>\"']/g,\n      (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n    );\n  if (!/^https:\\/\\//.test(boardUrl)) throw Error(\"Configure HTTPS Notion board URL\");\n  const tasks = [];\n  for (const p of rows) {\n    const props = p.properties || {},\n      d = props.deadline?.date?.start;\n    if (!d) continue;\n    const time = Date.parse(d);\n    if (!Number.isFinite(time)) throw Error(\"Invalid deadline\");\n    const title =\n        Object.values(props)\n          .find((x) => x.type === \"title\")\n          ?.title?.map((x) => x.plain_text || \"\")\n          .join(\"\") || \"Untitled\",\n      field = (k) => {\n        const v = props[k];\n        return (\n          v?.select?.name ?? v?.status?.name ?? v?.multi_select?.map((x) => x.name).join(\", \") ?? \"\"\n        );\n      };\n    if (!/^https:\\/\\/[^\\s]+$/.test(p.url || \"\")) throw Error(\"Invalid task URL\");\n    tasks.push({\n      id: p.id,\n      title,\n      date: d,\n      time,\n      url: p.url,\n      priority: field(\"prio\"),\n      status: field(\"status\"),\n      tags: field(\"tags\"),\n    });\n  }\n  tasks.sort((a, b) => a.time - b.time);\n  const group = (label, items) =>\n    \"<h2>\" +\n    label +\n    \"</h2>\" +\n    items\n      .map(\n        (x) =>\n          '<div><h3><a href=\"' +\n          esc(x.url) +\n          '\">' +\n          esc(x.title) +\n          \"</a></h3><p>Deadline: \" +\n          esc(x.date) +\n          \"<br>Prio: \" +\n          esc(x.priority) +\n          \"<br>Status: \" +\n          esc(x.status) +\n          \"<br>Tags: \" +\n          esc(x.tags) +\n          \"</p></div>\",\n      )\n      .join(\"\");\n  return (\n    '<h1>Weekly Update about Notion Tasks</h1><p><a href=\"' +\n    esc(boardUrl) +\n    '\">To the Task Board in Notion</a></p>' +\n    group(\n      \"Tasks which are already overdue\",\n      tasks.filter((x) => x.time <= now),\n    ) +\n    group(\n      \"Tasks with an upcoming deadline\",\n      tasks.filter((x) => x.time > now),\n    )\n  );\n}\nexport default function render({ state, boardUrl }) {\n  return { html: renderTasks(state.rows, boardUrl, Date.now()) };\n}\n"
      },
      "n_c7565275dfa14e2b": {
        "name": "Reserve digest email",
        "imports": [],
        "source": "export default async function prepare({ stage, acknowledge, resolution }, ctx) {\n  const d = new Date(),\n    day = (d.getUTCDay() + 6) % 7,\n    monday = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - day))\n      .toISOString()\n      .slice(0, 10),\n    key = \"notion-week:\" + monday + \":\" + stage,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, send: false };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown \" + stage + \" outcome \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, send: false };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_27e6ab0da7407f95": {
        "name": "Confirm digest email",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown email result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_8b39824861f047da": {
        "name": "Reserve Pushover notice",
        "imports": [],
        "source": "export default async function prepare({ stage, acknowledge, resolution }, ctx) {\n  const d = new Date(),\n    day = (d.getUTCDay() + 6) % 7,\n    monday = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - day))\n      .toISOString()\n      .slice(0, 10),\n    key = \"notion-week:\" + monday + \":\" + stage,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, send: false };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown \" + stage + \" outcome \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, send: false };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, send: true };\n}\n"
      },
      "n_f91ebcc0465c2ff8": {
        "name": "Confirm Pushover notice",
        "imports": [],
        "source": "export default async function f({ key, output }, ctx) {\n  if (output?.status !== 1) throw Error(\"Unknown Pushover result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
