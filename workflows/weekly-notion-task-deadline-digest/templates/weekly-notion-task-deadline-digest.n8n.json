        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'notion-week:' + $now.startOf('week').toISODate() }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
