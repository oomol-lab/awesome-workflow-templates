        0
      ],
      "parameters": {
        "options": {},
        "chunkSize": 2000
      },
      "typeVersion": 1
    },
    {
      "name": "Check extracted text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.text !== \"string\" || !$json.text.trim())\n  throw Error(\"PDF extraction returned no text\");\nreturn { json: $json };\n"
      },
      "id": "index-policy-pdf-vectors-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Policy settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "url",
              "name": "pdfUrl",
              "type": "string",
              "value": "https://example.com/policy.pdf"
            },
            {
              "id": "version",
              "name": "version",
              "type": "string",
              "value": "v1"
            }
          ]
        },
        "options": {}
      },
      "id": "index-policy-pdf-vectors-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Find prior index",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ \"policy:\" + $(\"Policy settings\").item.json.pdfUrl + \"#\" + $(\"Policy settings\").item.json.version }}"
            }
          ]
        },
        "options": {}
      },
      "id": "index-policy-pdf-vectors-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Check index status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect PostgreSQL before retry\");\nreturn { json: { skip: $json.status === \"done\" } };\n"
      },
      "id": "index-policy-pdf-vectors-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Already indexed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "index-policy-pdf-vectors-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Reserve policy index",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ \"policy:\" + $(\"Policy settings\").item.json.pdfUrl + \"#\" + $(\"Policy settings\").item.json.version }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-policy-pdf-vectors-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Restore extracted text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Extract from File\").item.json };\n"
      },
      "id": "index-policy-pdf-vectors-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Check vector result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (!$input.all().length) throw Error(\"Unknown index outcome\");\nreturn [{ json: { ok: true }, pairedItem: { item: 0 } }];\n"
      },
      "id": "index-policy-pdf-vectors-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Confirm policy index",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $(\"Reserve policy index\").item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "index-policy-pdf-vectors-15",
      "position": [
        3300,
        0
      ]
    }
