      "position": [
        880,
        0
      ],
      "parameters": {
        "options": {},
        "model": "text-embedding-3-small"
      },
      "typeVersion": 1.2
    },
    {
      "id": "index-policy-pdf-vectors-5",
      "name": "Default Data Loader",
