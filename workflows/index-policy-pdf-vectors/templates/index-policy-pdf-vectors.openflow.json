    "modules": {
      "n_b10685e12a254b20": {
        "name": "Split policy text",
        "imports": [],
        "source": "export default function ({ body, pdfUrl, version }) {\n  if (typeof body !== \"string\" || !body.trim()) throw Error(\"PDF extraction returned no text\");\n  if (!/^https:\\/\\//.test(pdfUrl) || !version.trim())\n    throw Error(\"Provide an HTTPS PDF URL and a document version\");\n  const chars = Array.from(body),\n    chunks = [];\n  for (let i = 0; i < chars.length; i += 1800) chunks.push(chars.slice(i, i + 2000).join(\"\"));\n  return { chunks, page: { pageId: pdfUrl + \"#\" + version, title: pdfUrl, createdTime: version } };\n}\n"
      },
      "n_6318682827147a2e": {
        "name": "Select chunk",
        "imports": [],
        "source": "export default function ({ chunks, page, previous }) {\n  const i = previous?.pageId === page.pageId ? previous.i + 1 : 0;\n  return { state: { pageId: page.pageId, i }, more: i < chunks.length, text: chunks[i] ?? \"\" };\n}\n"
      },
      "n_e2be1f7bb7943f94": {
        "name": "Reserve vector insert",
        "imports": [],
        "source": "export default async function ({ page, index }, ctx) {\n  const key = `policy:${page.pageId}:${index}`,\n    v = await ctx.state.get(key);\n  if (v?.status === \"pending\") throw Error(\"Inspect Supabase before retry\");\n  if (v?.status === \"done\") return { key, skip: true };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, skip: false };\n}\n"
      },
      "n_5e8657db83d41256": {
        "name": "Prepare vector document",
        "imports": [],
        "source": "export default function ({ embedding, page, text, index }) {\n  const v = embedding?.data?.[0]?.embedding;\n  if (!Array.isArray(v) || v.length !== 1536 || v.some((x) => !Number.isFinite(x)))\n    throw Error(\"Invalid embedding\");\n  return {\n    body: {\n      content: text,\n      metadata: {\n        pageId: page.pageId,\n        createdTime: page.createdTime,\n        pageTitle: page.title,\n        chunk: index,\n      },\n      embedding: v,\n    },\n  };\n}\n"
      },
      "n_997fdbdf36c2908a": {
        "name": "Confirm vector insert",
        "imports": [],
        "source": "export default async function ({ key, body }, ctx) {\n  if (!Array.isArray(body) || body.length !== 1 || !body[0].id)\n    throw Error(\"Unknown Supabase insert outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
