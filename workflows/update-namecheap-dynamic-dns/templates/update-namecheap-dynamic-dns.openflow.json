    "modules": {
      "n_c27ddc3a13846739": {
        "name": "Select host to update",
        "imports": [],
        "source": "export default async function select({ response, hosts, domain, previous }, context) {\n  const ip = response?.ip;\n  if (!/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(ip || \"\") || ip.split(\".\").some((x) => Number(x) > 255))\n    throw Error(\"Expected an IPv4 address\");\n  if (!Array.isArray(hosts) || !hosts.length || hosts.some((x) => typeof x !== \"string\" || !x))\n    throw Error(\"Configure hosts\");\n  if (!domain || domain === \"YOUR_DOMAIN\") throw Error(\"Configure domain\");\n  const saved = await context.state.get(\"namecheap-ddns\");\n  if (!previous && saved?.ip === ip)\n    return { state: { index: hosts.length }, more: false, url: \"\", ip };\n  const index = previous?.index ?? 0;\n  return {\n    state: { index: index + 1 },\n    more: index < hosts.length,\n    url:\n      index < hosts.length\n        ? \"https://dynamicdns.park-your-domain.com/update?\" +\n          new URLSearchParams({ host: hosts[index], domain, ip }).toString()\n        : \"\",\n    ip,\n  };\n}\n"
      },
      "n_ba158f6700d8b739": {
        "name": "Check update response",
        "imports": [],
        "source": "export default async function confirm({ body, ip }, context) {\n  if (!/<ErrCount>\\s*0\\s*<\\/ErrCount>/i.test(body)) throw Error(\"Namecheap did not confirm update\");\n  return { ip };\n}\n"
      },
      "n_09acce555f3d6f75": {
        "name": "Remember current address",
        "imports": [],
        "source": "export default async function save({ ip }, context) {\n  await context.state.set(\"namecheap-ddns\", { ip });\n  return { ip };\n}\n"
      }
    }
