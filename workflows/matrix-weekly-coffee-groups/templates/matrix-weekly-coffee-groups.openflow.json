    "modules": {
      "n_ba7937cada5371b9": {
        "name": "Configure the Matrix rooms",
        "imports": [],
        "source": "export default function config({ homeserver, memberRoom, announcementRoom }) {\n  if (\n    typeof homeserver !== \"string\" ||\n    homeserver.includes(\"YOUR_\") ||\n    !/^https:\\/\\/[^/?#@\\s]+(?:\\/[^?#\\s]*)?$/i.test(homeserver)\n  )\n    throw Error(\"Configure an HTTPS Matrix homeserver without credentials\");\n  for (const room of [memberRoom, announcementRoom])\n    if (typeof room !== \"string\" || room.includes(\"YOUR_\") || !/^![^\\s/:]+:[^\\s/]+$/.test(room))\n      throw Error(\"Configure both Matrix room IDs\");\n  const base = homeserver.replace(/\\/+$/, \"\"),\n    prefix = base + \"/_matrix/client/v3/rooms/\",\n    txn =\n      Date.now().toString(36) +\n      \"-\" +\n      Math.random().toString(36).slice(2) +\n      \"-\" +\n      Math.random().toString(36).slice(2);\n  return {\n    base,\n    memberRoom,\n    announcementRoom,\n    greetingUrl: prefix + encodeURIComponent(memberRoom) + \"/send/m.room.message/\" + txn,\n    membersUrl: prefix + encodeURIComponent(memberRoom) + \"/members\",\n    greeting: {\n      msgtype: \"m.text\",\n      body: \"👋 Happy Monday Groups for this week's virtual coffee are:\",\n    },\n  };\n}\n"
      },
      "n_328ae71facabfcb2": {
        "name": "Confirm the greeting",
        "imports": [],
        "source": "export default function greeting({ body }) {\n  if (typeof body?.event_id !== \"string\" || !body.event_id)\n    throw Error(\"Matrix did not confirm the greeting\");\n  return { confirmed: true };\n}\n"
      },
      "n_1abe4bb131b04086": {
        "name": "Shuffle and form coffee groups",
        "imports": [],
        "source": "export default function groups({ body }) {\n  if (!Array.isArray(body?.chunk)) throw Error(\"Matrix returned no member list\");\n  const users = body.chunk.map((e) => {\n    if (\n      e?.type !== \"m.room.member\" ||\n      typeof e.state_key !== \"string\" ||\n      !/^@[^\\s:]+:[^\\s]+$/.test(e.state_key)\n    )\n      throw Error(\"Invalid Matrix member event\");\n    return e.state_key;\n  });\n  if (new Set(users).size !== users.length) throw Error(\"Duplicate Matrix member\");\n  if (users.length < 2) return { groups: [] };\n  for (let n = users.length; n > 0; n--) {\n    const j = Math.floor(Math.random() * n);\n    [users[n - 1], users[j]] = [users[j], users[n - 1]];\n  }\n  const groups = [];\n  for (let i = 0; i < users.length; i += 3) groups.push(users.slice(i, i + 3));\n  if (groups.at(-1).length === 1) groups.at(-1).push(groups.at(-2).shift());\n  return { groups };\n}\n"
      },
      "n_9eff99c182ec3a8a": {
        "name": "Prepare the next group message",
        "imports": [],
        "source": "export default function next({ groups, base, announcementRoom, previousState, body }) {\n  if (!Array.isArray(groups)) throw Error(\"Invalid coffee groups\");\n  const state = previousState ?? { index: 0 };\n  if (previousState) {\n    if (typeof body?.event_id !== \"string\" || !body.event_id)\n      throw Error(\"Matrix did not confirm the previous message\");\n    state.index++;\n  }\n  if (state.index >= groups.length)\n    return { state, more: false, url: \"https://example.com\", message: {}, count: groups.length };\n  const txn =\n    Date.now().toString(36) +\n    \"-\" +\n    Math.random().toString(36).slice(2) +\n    \"-\" +\n    Math.random().toString(36).slice(2) +\n    \"-\" +\n    state.index;\n  return {\n    state,\n    more: true,\n    url:\n      base +\n      \"/_matrix/client/v3/rooms/\" +\n      encodeURIComponent(announcementRoom) +\n      \"/send/m.room.message/\" +\n      txn,\n    message: { msgtype: \"m.text\", body: \"☀️ \" + groups[state.index].join(\", \") },\n    count: groups.length,\n  };\n}\n"
      }
    }
