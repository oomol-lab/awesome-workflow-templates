    "modules": {
      "n_ba7937cada5371b9": {
        "name": "Configure the Matrix rooms",
        "imports": [],
        "source": "export default function config({homeserver,memberRoom,announcementRoom}){if(typeof homeserver!=='string'||homeserver.includes('YOUR_')||!/^https:\\/\\/[^/?#@\\s]+(?:\\/[^?#\\s]*)?$/i.test(homeserver))throw Error('Configure an HTTPS Matrix homeserver without credentials');for(const room of [memberRoom,announcementRoom])if(typeof room!=='string'||room.includes('YOUR_')||!/^![^\\s/:]+:[^\\s/]+$/.test(room))throw Error('Configure both Matrix room IDs');const base=homeserver.replace(/\\/+$/,''),prefix=base+'/_matrix/client/v3/rooms/',txn=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+'-'+Math.random().toString(36).slice(2);return{base,memberRoom,announcementRoom,greetingUrl:prefix+encodeURIComponent(memberRoom)+'/send/m.room.message/'+txn,membersUrl:prefix+encodeURIComponent(memberRoom)+'/members',greeting:{msgtype:'m.text',body:\"👋 Happy Monday Groups for this week's virtual coffee are:\"}}}\n"
      },
      "n_328ae71facabfcb2": {
        "name": "Confirm the greeting",
        "imports": [],
        "source": "export default function greeting({body}){if(typeof body?.event_id!=='string'||!body.event_id)throw Error('Matrix did not confirm the greeting');return{confirmed:true}}\n"
      },
      "n_1abe4bb131b04086": {
        "name": "Shuffle and form coffee groups",
        "imports": [],
        "source": "export default function groups({body}){if(!Array.isArray(body?.chunk))throw Error('Matrix returned no member list');const users=body.chunk.map(e=>{if(e?.type!=='m.room.member'||typeof e.state_key!=='string'||!/^@[^\\s:]+:[^\\s]+$/.test(e.state_key))throw Error('Invalid Matrix member event');return e.state_key});if(new Set(users).size!==users.length)throw Error('Duplicate Matrix member');if(users.length<2)return{groups:[]};for(let n=users.length;n>0;n--){const j=Math.floor(Math.random()*n);[users[n-1],users[j]]=[users[j],users[n-1]]}const groups=[];for(let i=0;i<users.length;i+=3)groups.push(users.slice(i,i+3));if(groups.at(-1).length===1)groups.at(-1).push(groups.at(-2).shift());return{groups}}\n"
      },
      "n_9eff99c182ec3a8a": {
        "name": "Prepare the next group message",
        "imports": [],
        "source": "export default function next({groups,base,announcementRoom,previousState,body}){if(!Array.isArray(groups))throw Error('Invalid coffee groups');const state=previousState??{index:0};if(previousState){if(typeof body?.event_id!=='string'||!body.event_id)throw Error('Matrix did not confirm the previous message');state.index++}if(state.index>=groups.length)return{state,more:false,url:'https://example.com',message:{},count:groups.length};const txn=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+'-'+Math.random().toString(36).slice(2)+'-'+state.index;return{state,more:true,url:base+'/_matrix/client/v3/rooms/'+encodeURIComponent(announcementRoom)+'/send/m.room.message/'+txn,message:{msgtype:'m.text',body:'☀️ '+groups[state.index].join(', ')},count:groups.length}}\n"
      }
    }
