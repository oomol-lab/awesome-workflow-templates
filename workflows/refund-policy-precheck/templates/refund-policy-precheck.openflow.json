    "modules": {
      "n_3b589275c174eaeb": {
        "name": "Evaluate deterministic policy rules",
        "imports": [],
        "source": "export default function evaluatePolicy({ amountUsd, daysSincePurchase }) {\n  const flags = [];\n  if (daysSincePurchase > 30) flags.push(\"outside_30_day_window\");\n  if (amountUsd >= 250) flags.push(\"high_value_review\");\n  if (amountUsd <= 50 && daysSincePurchase <= 30) flags.push(\"eligible_low_risk_tier\");\n  return { policyFlags: flags, flagsSummary: flags.length ? flags.join(\", \") : \"standard_review\" };\n}\n"
      },
      "n_cd532f3c686d293b": {
        "name": "Format Slack approval card",
        "imports": [],
        "source": "export default function formatCard({\n  orderId,\n  customerEmail,\n  amountUsd,\n  recommendation,\n  riskScore,\n  rationale,\n  flagsSummary,\n}) {\n  const text =\n    \"*Refund Review: \" +\n    orderId +\n    \"* ($\" +\n    amountUsd +\n    \")\\n\" +\n    \"• Customer: \" +\n    customerEmail +\n    \"\\n\" +\n    \"• Policy Flags: \" +\n    flagsSummary +\n    \"\\n\" +\n    \"• AI Recommendation: *\" +\n    recommendation +\n    \"* (Risk: \" +\n    riskScore +\n    \"/100)\\n\" +\n    \"• Rationale: \" +\n    rationale;\n  return { slackText: text };\n}\n"
      }
    }
