      "n_565e4ceab7367ba4": {
        "name": "Capture the event",
        "imports": [],
        "source": "export default async function capture({ query, token, url }, context) {\n  if (typeof query.event !== \"string\" || !query.event)\n    throw Error(\"Expected an event query parameter\");\n  const res = await context.fetch(url, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ api_key: token, event: query.event, distinct_id: \"n8n\" }),\n  });\n  if (!res.ok) throw Error(\"PostHog capture failed or outcome is unknown\");\n  return { accepted: true };\n}\n"
      }
    }
