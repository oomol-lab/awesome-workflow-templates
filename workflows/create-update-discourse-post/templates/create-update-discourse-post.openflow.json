    "modules": {
      "n_4529feb5b645923e": {
        "name": "Validate topic details",
        "imports": [],
        "source": "export default function input({ categoryId, title, initial, updated }) {\n  if (\n    typeof categoryId !== \"string\" ||\n    !/^\\d+$/.test(categoryId) ||\n    !Number.isSafeInteger(Number(categoryId)) ||\n    Number(categoryId) < 1\n  )\n    throw Error(\"Enter a category ID\");\n  if ([title, initial, updated].some((x) => typeof x !== \"string\" || !x.trim()))\n    throw Error(\"Enter a title and both post bodies\");\n  return { categoryId: Number(categoryId), title, initial, updated };\n}\n"
      },
      "n_36d1dda97b605c30": {
        "name": "Create the topic",
        "imports": [],
        "source": "export default async function create({ categoryId, title, initial }, context) {\n  return await context.actions.call(\"discourse.create_topic\", { categoryId, title, raw: initial });\n}\n"
      },
      "n_8fe080a6ca8d04c2": {
        "name": "Prepare post update",
        "imports": [],
        "source": "export default function prepare({ post, updated }) {\n  const id = post?.id;\n  if (!Number.isSafeInteger(id) || id < 1) throw Error(\"Discourse returned no post ID\");\n  return { endpoint: \"/posts/\" + id + \".json\", body: { post: { raw: updated } }, postId: id };\n}\n"
      },
      "n_e8eabd2ead9d355c": {
        "name": "Confirm post update",
        "imports": [],
        "source": "export default function updated({ body, statusCode, bodyEncoding, postId }) {\n  if (statusCode !== 200 || bodyEncoding != null || !body?.post || body.post.id !== postId)\n    throw Error(\"Discourse did not confirm the updated post\");\n  return { endpoint: \"/posts/\" + postId + \".json\" };\n}\n"
      },
      "n_3cbc635d682e0632": {
        "name": "Verify the post",
        "imports": [],
        "source": "export default function result({ body, statusCode, bodyEncoding, postId }) {\n  if (statusCode !== 200 || bodyEncoding != null || !body || body.id !== postId)\n    throw Error(\"Discourse did not return the same post\");\n  return { post: body };\n}\n"
      }
    }
  },
