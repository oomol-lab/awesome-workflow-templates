      "name": "Set rebuild ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { requestId: \"YOUR_UNIQUE_REBUILD_ID\" } }];\n"
