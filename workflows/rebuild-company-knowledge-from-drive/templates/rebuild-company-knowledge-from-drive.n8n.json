    {
      "name": "Verify index output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (\n  !items.length ||\n  items.some((x) => x.json.error || typeof x.json.pageContent !== \"string\" || !x.json.pageContent)\n)\n  throw Error(\"Index write not confirmed; inspect Qdrant\");\nreturn items;\n"
      },
