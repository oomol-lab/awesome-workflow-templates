    {
      "name": "Pack Drive files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [\n  {\n    json: {\n      requestId: $(\"Set rebuild ID\").first().json.requestId,\n      files: $input\n        .all()\n        .map((x) => x.json)\n        .filter((x) => x.id),\n      clear: true,\n    },\n  },\n];\n"
      },
      "id": "rebuild-company-knowledge-from-drive-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Receive extraction request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "company-knowledge-extract",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "rebuild-company-knowledge-from-drive-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "id": "rebuild-company-knowledge-from-drive-10",
      "name": "Download extraction file",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.body.fileId }}"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        },
        "operation": "download"
      },
      "typeVersion": 3
    },
    {
      "name": "Parse source document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { N8nBinaryLoader } = require(\"@n8n/ai-utilities\");\nconst { TokenTextSplitter } = require(\"@langchain/textsplitters\");\nconst items = $input.all(),\n  documents = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const binary = item.binary?.data;\n  if (!binary?.mimeType) throw new Error(\"Missing downloaded file\");\n  const bytes = await this.helpers.getBinaryDataBuffer(i, \"data\");\n  const data = { ...binary, data: bytes.toString(\"base64\") };\n  delete data.id;\n  const context = {\n    getNode: () => ({ name: \"Parse source document\" }),\n    getInputData: () => [item],\n    getNodeParameter: (_k, _i, fallback) => fallback,\n    helpers: { assertBinaryData: () => data },\n  };\n  const loader = new N8nBinaryLoader(\n    context,\n    \"options.\",\n    \"data\",\n    new TokenTextSplitter({ chunkSize: 300, chunkOverlap: 30 }),\n  );\n  const chunks = await loader.processItemByKey(item, i, \"data\");\n  for (const chunk of chunks)\n    documents.push({ content: chunk.pageContent, metadata: chunk.metadata });\n}\nreturn [{ json: { documents } }];\n"
      },
      "id": "rebuild-company-knowledge-from-drive-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Respond with parsed chunks",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "rebuild-company-knowledge-from-drive-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Normalize rebuild plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $json };\n"
      },
      "id": "rebuild-company-knowledge-from-drive-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Check rebuild checkpoint",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ \"company-rebuild:\" + $json.requestId }}"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "rebuild-company-knowledge-from-drive-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Inspect rebuild checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect Qdrant before retrying pending rebuild\");\nreturn { json: { done: $json.status === \"done\" } };\n"
      },
      "id": "rebuild-company-knowledge-from-drive-15",
      "position": [
        3300,
        0
      ]
    },
    {
      "name": "Already rebuilt?",
