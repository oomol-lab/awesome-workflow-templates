    "modules": {
      "n_11cf6a89ded8d9f4": {
        "name": "Read completed email assessment",
        "imports": [],
        "source": "function readHunterAssessment(assessment) {\n  if (\n    !assessment ||\n    typeof assessment !== \"object\" ||\n    Array.isArray(assessment) ||\n    typeof assessment.email !== \"string\" ||\n    assessment.email.length === 0 ||\n    ![\"valid\", \"invalid\", \"accept_all\", \"webmail\", \"disposable\", \"unknown\"].includes(\n      assessment.status,\n    )\n  )\n    throw new Error(\n      \"Hunter did not return a completed email assessment; verification may still be in progress\",\n    );\n  return assessment;\n}\nexport default function ({ response }) {\n  if (!response || typeof response !== \"object\" || Array.isArray(response) || response.errors)\n    throw new Error(\n      \"Hunter did not return a completed assessment; verification may be pending or rejected\",\n    );\n  return { assessment: readHunterAssessment(response.data) };\n}\n"
      }
    }
