    "modules": {
      "n_443624dd19804579": {
        "name": "Prepare SQL requests",
        "imports": [],
        "source": "export default function prepare({ baseUrl, id, name }) {\n  return {\n    url: baseUrl.replace(/\\/$/, \"\") + \"/_sql\",\n    create: { stmt: \"CREATE TABLE test (id INT, name STRING);\" },\n    insert: { stmt: \"INSERT INTO test (id, name) VALUES (?, ?) RETURNING *\", args: [id, name] },\n  };\n}\n"
      }
    }
