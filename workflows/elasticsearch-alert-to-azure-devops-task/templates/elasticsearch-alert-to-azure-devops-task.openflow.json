    "modules": {
      "n_48ec0335b142b0a4": {
        "name": "Configure alert query",
        "imports": [],
        "source": "export default function configureSearch({ indexName, query }) {\n  const index = indexName.trim();\n  const filter = query.trim();\n  if (!index || index === \"your-alert-index\" || index === \".\" || index === \"..\" || !filter) {\n    throw new Error(\"Set the Elasticsearch index and alert query.\");\n  }\n  return { indexName: index, query: filter };\n}\n"
      },
      "n_86668b6707f97229": {
        "name": "Prepare work item",
        "imports": [],
        "source": "export default function prepareWorkItem({ count, failedShards }) {\n  if (!Number.isSafeInteger(count) || count < 0 || failedShards !== 0) {\n    throw new Error(\"Elasticsearch did not return a complete document count.\");\n  }\n  return {\n    matchCount: count,\n    patch: JSON.stringify([\n      {\n        op: \"add\",\n        path: \"/fields/System.Title\",\n        value: `Elasticsearch alert: ${count} matching ${count === 1 ? \"document\" : \"documents\"}`,\n      },\n    ]),\n  };\n}\n"
      },
      "n_ed3f66febff479af": {
        "name": "Confirm work item ID",
        "imports": [],
        "source": "export default function confirmWorkItem({ body, matchCount }) {\n  if (!Number.isSafeInteger(body?.id) || body.id < 1) {\n    throw new Error(\"Azure DevOps did not confirm the created work item ID.\");\n  }\n  return { matchCount, workItemId: body.id };\n}\n"
      },
      "n_358b420d30b9abb7": {
        "name": "No matches",
        "imports": [],
        "source": "export default function noTask() {\n  return { workItemId: null };\n}\n"
      }
