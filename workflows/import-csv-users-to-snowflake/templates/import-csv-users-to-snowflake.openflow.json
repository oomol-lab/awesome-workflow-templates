    "modules": {
      "n_9351da9939fedb94": {
        "name": "Read user records",
        "imports": [],
        "source": "export default function parse({ text }) {\n  if (typeof text !== \"string\") throw Error(\"Invalid CSV\");\n  text = text.replace(/^\\uFEFF/, \"\");\n  let rows = [],\n    row = [],\n    field = \"\",\n    quoted = false;\n  for (let i = 0; i < text.length; i++) {\n    const c = text[i];\n    if (quoted) {\n      if (c === '\"' && text[i + 1] === '\"') {\n        field += '\"';\n        i++;\n      } else if (c === '\"') quoted = false;\n      else field += c;\n    } else if (c === '\"' && !field) quoted = true;\n    else if (c === \",\") {\n      row.push(field);\n      field = \"\";\n    } else if (c === \"\\n\" || c === \"\\r\") {\n      if (c === \"\\r\" && text[i + 1] === \"\\n\") i++;\n      row.push(field);\n      if (row.some((x) => x !== \"\")) rows.push(row);\n      row = [];\n      field = \"\";\n    } else field += c;\n  }\n  if (quoted) throw Error(\"Unclosed CSV quote\");\n  if (field || row.length) {\n    row.push(field);\n    rows.push(row);\n  }\n  const header = rows.shift();\n  if (!header) throw Error(\"Missing CSV header\");\n  const cols = [\"id\", \"first_name\", \"last_name\"].map((k) => {\n    const i = header.indexOf(k);\n    if (i < 0 || header.lastIndexOf(k) !== i) throw Error(\"Missing or duplicate \" + k);\n    return i;\n  });\n  return {\n    rows: rows.map((r) => {\n      const [id, first, last] = cols.map((i) => r[i]);\n      if (\n        !/^\\d+$/.test(id ?? \"\") ||\n        typeof first !== \"string\" ||\n        typeof last !== \"string\" ||\n        !first ||\n        !last\n      )\n        throw Error(\"Invalid CSV row\");\n      return { id, first_name: first, last_name: last };\n    }),\n  };\n}\n"
      },
      "n_082947b6b7aab94d": {
        "name": "Prepare the next insert",
        "imports": [],
        "source": "export default function next({ rows, previous, confirmed, account, warehouse, database, schema }) {\n  const i = previous?.index ?? 0,\n    index = i + (confirmed === true ? 1 : 0);\n  if (\n    !/^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$/.test(account) ||\n    [warehouse, database, schema].some((x) => typeof x !== \"string\" || !x || x.startsWith(\"YOUR_\"))\n  )\n    throw Error(\"Configure Snowflake account and context\");\n  if (!Array.isArray(rows) || index > rows.length) throw Error(\"Invalid import state\");\n  const url = \"https://\" + account + \".snowflakecomputing.com/api/v2/statements\";\n  if (index === rows.length) return { state: { index }, more: false, url, body: {}, count: index };\n  const r = rows[index];\n  return {\n    state: { index },\n    more: true,\n    url,\n    count: index,\n    body: {\n      statement: 'INSERT INTO \"users\" (\"id\", \"first_name\", \"last_name\") VALUES (?, ?, ?)',\n      warehouse,\n      database,\n      schema,\n      bindings: {\n        1: { type: \"FIXED\", value: r.id },\n        2: { type: \"TEXT\", value: r.first_name },\n        3: { type: \"TEXT\", value: r.last_name },\n      },\n    },\n  };\n}\n"
      },
      "n_c12a0c306e2b05b6": {
        "name": "Check the statement",
        "imports": [],
        "source": "export default function status({ body, statusCode, url, previous }) {\n  const attempts = (previous?.attempts ?? 0) + 1;\n  if (!body || typeof body !== \"object\") throw Error(\"Invalid Snowflake response\");\n  if (statusCode === 200) {\n    if (body.code !== \"090001\") throw Error(\"Snowflake statement did not succeed\");\n    return { state: { attempts: 0 }, pending: false, confirmed: true, pollUrl: url };\n  }\n  if (\n    statusCode !== 202 ||\n    typeof body.statementHandle !== \"string\" ||\n    !/^[A-Za-z0-9-]+$/.test(body.statementHandle) ||\n    attempts > 60\n  )\n    throw Error(\"Snowflake statement not confirmed\");\n  return {\n    state: { attempts },\n    pending: true,\n    confirmed: false,\n    pollUrl: url + \"/\" + body.statementHandle,\n  };\n}\n"
      },
      "n_dae738bd1871ceb3": {
        "name": "Check polling result",
        "imports": [],
        "source": "export default function status({ body, statusCode, url, previous }) {\n  const attempts = (previous?.attempts ?? 0) + 1;\n  if (!body || typeof body !== \"object\") throw Error(\"Invalid Snowflake response\");\n  if (statusCode === 200) {\n    if (body.code !== \"090001\") throw Error(\"Snowflake statement did not succeed\");\n    return { state: { attempts: 0 }, pending: false, confirmed: true, pollUrl: url };\n  }\n  if (\n    statusCode !== 202 ||\n    typeof body.statementHandle !== \"string\" ||\n    !/^[A-Za-z0-9-]+$/.test(body.statementHandle) ||\n    attempts > 60\n  )\n    throw Error(\"Snowflake statement not confirmed\");\n  return {\n    state: { attempts },\n    pending: true,\n    confirmed: false,\n    pollUrl: url + \"/\" + body.statementHandle,\n  };\n}\n"
      },
      "n_2fee37d5ff8b7362": {
        "name": "Confirm the insert",
        "imports": [],
        "source": "export default function () {\n  return { confirmed: true };\n}\n"
      }
    }
