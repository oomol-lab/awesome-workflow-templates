    "modules": {
      "n_e914ccaf7d217a41": {
        "name": "Prepare the current timestamp",
        "imports": [],
        "source": "export default function query() {\n  const timestamp = Math.floor(Date.now() / 1000);\n  return {\n    timestamp,\n    url: \"https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps=\" + timestamp,\n  };\n}\n"
      },
      "n_7c6e1715141248e3": {
        "name": "Validate the position",
        "imports": [],
        "source": "export default function row({ body, timestamp }) {\n  if (!Array.isArray(body) || body.length !== 1) throw Error(\"Expected one ISS position\");\n  const p = body[0];\n  if (\n    !p ||\n    p.id !== 25544 ||\n    typeof p.name !== \"string\" ||\n    !p.name ||\n    !Number.isFinite(p.latitude) ||\n    p.latitude < -90 ||\n    p.latitude > 90 ||\n    !Number.isFinite(p.longitude) ||\n    p.longitude < -180 ||\n    p.longitude > 180 ||\n    p.timestamp !== timestamp\n  )\n    throw Error(\"ISS position does not match the request\");\n  const position = {\n    name: p.name,\n    latitude: p.latitude,\n    longitude: p.longitude,\n    timestamp: p.timestamp,\n  };\n  return { position, rows: [{ json: position }] };\n}\n"
      },
      "n_b11723b970fe44d2": {
        "name": "Confirm the insert",
        "imports": [],
        "source": "export default function confirm({ insertErrors }) {\n  if (!Array.isArray(insertErrors) || insertErrors.length)\n    throw Error(\"BigQuery did not accept the position\");\n  return { inserted: true };\n}\n"
      }
    }
