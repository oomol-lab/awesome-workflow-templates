{
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        410,
        240
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "log-iss-position-to-bigquery-0"
    },
    {
      "name": "Prepare the current timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function query() {\n  const timestamp = Math.floor(Date.now() / 1000);\n  return {\n    timestamp,\n    url: \"https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps=\" + timestamp,\n  };\n}\n\nreturn [{ json: query() }];\n"
      },
      "id": "log-iss-position-to-bigquery-1"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        610,
        240
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      },
      "typeVersion": 1,
      "id": "log-iss-position-to-bigquery-2"
    },
    {
      "name": "Validate the position",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function row({ body, timestamp }) {\n  if (!Array.isArray(body) || body.length !== 1) throw Error(\"Expected one ISS position\");\n  const p = body[0];\n  if (\n    !p ||\n    p.id !== 25544 ||\n    typeof p.name !== \"string\" ||\n    !p.name ||\n    !Number.isFinite(p.latitude) ||\n    p.latitude < -90 ||\n    p.latitude > 90 ||\n    !Number.isFinite(p.longitude) ||\n    p.longitude < -180 ||\n    p.longitude > 180 ||\n    p.timestamp !== timestamp\n  )\n    throw Error(\"ISS position does not match the request\");\n  const position = {\n    name: p.name,\n    latitude: p.latitude,\n    longitude: p.longitude,\n    timestamp: p.timestamp,\n  };\n  return { position, rows: [{ json: position }] };\n}\n\nreturn [\n  {\n    json: row({\n      body: $input.first().json,\n      timestamp: $(\"Prepare the current timestamp\").first().json.timestamp,\n    }).position,\n  },\n];\n"
      },
      "id": "log-iss-position-to-bigquery-3"
    },
    {
      "name": "Google BigQuery",
      "type": "n8n-nodes-base.googleBigQuery",
      "position": [
        1010,
        240
      ],
      "parameters": {
        "columns": "name, latitude, longitude, timestamp",
        "options": {},
        "tableId": "YOUR_TABLE_ID",
        "datasetId": "YOUR_DATASET_ID",
        "projectId": "YOUR_PROJECT_ID",
        "authentication": "oAuth2"
      },
      "typeVersion": 1,
      "id": "log-iss-position-to-bigquery-4"
    },
    {
      "name": "Confirm the insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $input.first().json;\nif (x.insertErrors !== undefined && (!Array.isArray(x.insertErrors) || x.insertErrors.length))\n  throw Error(\"BigQuery did not accept the position\");\nreturn [{ json: { inserted: true } }];\n"
      },
      "id": "log-iss-position-to-bigquery-5"
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Prepare the current timestamp",
