    "modules": {
      "n_a9c2487306ab3333": {
        "name": "Choose the calendar and 12-hour window",
        "imports": [],
        "source": "function calendarWindow(calendarId, now = new Date()) {\n  if (\n    typeof calendarId !== \"string\" ||\n    !calendarId.trim() ||\n    calendarId === \"YOUR_GOOGLE_CALENDAR_ID\"\n  ) {\n    throw new Error(\"Enter the Google Calendar ID.\");\n  }\n  const from = new Date(now);\n  const until = new Date(from.getTime() + 12 * 60 * 60 * 1000);\n  const query = {\n    timeMin: from.toISOString(),\n    timeMax: until.toISOString(),\n    singleEvents: \"true\",\n    showDeleted: \"false\",\n    fields:\n      \"nextPageToken,timeZone,items(id,status,transparency,summary,start(dateTime,timeZone),end(dateTime))\",\n  };\n  return { endpoint: \"/calendars/\" + encodeURIComponent(calendarId.trim()) + \"/events\", query };\n}\nexport default ({ calendarId, scheduledAt }) => {\n  const window = calendarWindow(calendarId, scheduledAt ?? undefined);\n  return { window, endpoint: window.endpoint };\n};\n"
      },
      "n_f03745d1307afeda": {
        "name": "Collect Calendar event pages",
        "imports": [],
        "source": "function collectCalendarPage(state, status, page) {\n  if (\n    status !== 200 ||\n    !page ||\n    typeof page !== \"object\" ||\n    Array.isArray(page) ||\n    (page.items !== undefined && !Array.isArray(page.items))\n  ) {\n    throw new Error(\"Google Calendar did not return a valid event page.\");\n  }\n  const old = state ?? { events: [], tokens: [], timezone: null };\n  const cursor = page.nextPageToken ?? null;\n  if (cursor !== null && (typeof cursor !== \"string\" || !cursor || old.tokens.includes(cursor))) {\n    throw new Error(\"Google Calendar returned an invalid or repeated page token.\");\n  }\n  const tokens = cursor === null ? old.tokens : [...old.tokens, cursor];\n  if (cursor && tokens.length >= 100) {\n    throw new Error(\"The Calendar query exceeded 100 pages.\");\n  }\n  return {\n    events: [...old.events, ...(page.items ?? [])],\n    tokens,\n    cursor,\n    timezone: old.timezone ?? page.timeZone ?? \"UTC\",\n  };\n}\nexport default ({ window, state, status, body }) => {\n  const next = status === null ? null : collectCalendarPage(state, status, body);\n  const query = { ...window.query };\n  if (next?.cursor) query.pageToken = next.cursor;\n  return { state: next, query, more: next === null || next.cursor !== null };\n};\n"
      },
      "n_550c401327235ddc": {
        "name": "Select events for Zoom",
        "imports": [],
        "source": "function selectMeetings(window, state) {\n  if (!state || state.cursor !== null) throw new Error(\"Calendar pagination is incomplete.\");\n  const start = Date.parse(window.query.timeMin);\n  const end = Date.parse(window.query.timeMax);\n  const seen = new Set();\n  const meetings = [];\n  for (const event of state.events) {\n    if (!event || typeof event !== \"object\" || Array.isArray(event))\n      throw new Error(\"Invalid Calendar event.\");\n    const { id, summary, status, transparency } = event;\n    if (\n      status === \"cancelled\" ||\n      transparency === \"transparent\" ||\n      typeof summary !== \"string\" ||\n      !summary.trim() ||\n      /signal|minute meeting|in person/i.test(summary) ||\n      !event.start?.dateTime ||\n      !event.end?.dateTime\n    )\n      continue;\n    const startMs = Date.parse(event.start.dateTime);\n    const endMs = Date.parse(event.end.dateTime);\n    if (\n      !Number.isFinite(startMs) ||\n      !Number.isFinite(endMs) ||\n      endMs <= startMs ||\n      typeof id !== \"string\" ||\n      !id\n    )\n      throw new Error(\"A timed Calendar event has invalid scheduling data.\");\n    if (startMs < start || startMs >= end || seen.has(id)) continue;\n    const topic = \"Meeting with \" + summary;\n    const duration = Math.ceil((endMs - startMs) / 60000);\n    if (topic.length > 200 || duration > 1440)\n      throw new Error(\"A Calendar event exceeds the Zoom meeting limits.\");\n    seen.add(id);\n    meetings.push({\n      eventId: id,\n      topic,\n      startTime: new Date(startMs).toISOString().replace(/\\.000Z$/, \"Z\"),\n      duration,\n      timezone: event.start.timeZone || state.timezone,\n    });\n  }\n  return meetings;\n}\nexport default ({ window, state }) => ({ meetings: selectMeetings(window, state) });\n"
      },
      "n_5424bccea3f99711": {
        "name": "Prepare the next Zoom meeting",
        "imports": [],
        "source": "function confirmMeeting(event, meeting) {\n  if (\n    (typeof meeting?.id !== \"string\" && !Number.isSafeInteger(meeting?.id)) ||\n    !/^\\d+$/.test(String(meeting.id)) ||\n    meeting.topic !== event.topic ||\n    Date.parse(meeting.startTime) !== Date.parse(event.startTime) ||\n    meeting.duration !== event.duration\n  ) {\n    throw new Error(\"Zoom did not confirm the requested meeting. Check Zoom before running again.\");\n  }\n  return {\n    calendarEventId: event.eventId,\n    zoomMeetingId: String(meeting.id),\n    ...(meeting.joinUrl ? { joinUrl: meeting.joinUrl } : {}),\n  };\n}\nexport default ({ meetings, previous, completed, receipt }) => {\n  const confirmed = completed ?? [];\n  if (previous !== null) confirmed.push(confirmMeeting(previous, receipt));\n  const event = meetings[confirmed.length] ?? null;\n  return {\n    confirmed,\n    event,\n    more: event !== null,\n    ...Object.fromEntries(\n      [\"topic\", \"startTime\", \"duration\", \"timezone\"].map((key) => [key, event?.[key] ?? null]),\n    ),\n  };\n};\n"
      }
    },
