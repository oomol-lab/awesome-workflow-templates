      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ...$input.first().json, deliveryMode: \"direct\" } }];\n"
      }
    },
    {
      "id": "log-n8n-execution-errors-to-monday-mode",
      "name": "Relay selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "mode",
              "leftValue": "={{ $json.deliveryMode }}",
              "rightValue": "relay",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "log-n8n-execution-errors-to-monday-prepare-monday-columns",
      "name": "Prepare Monday columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $(\"Error Trigger\").first().json;\nconst ids = [\n  \"YOUR_WORKFLOW_COLUMN_ID\",\n  \"YOUR_STACK_COLUMN_ID\",\n  \"YOUR_MESSAGE_COLUMN_ID\",\n  \"YOUR_DATE_COLUMN_ID\",\n];\nif (ids.some((x) => x.startsWith(\"YOUR_\")) || new Set(ids).size !== 4)\n  throw Error(\"Configure Monday column IDs\");\nreturn [\n  {\n    json: {\n      columnValues: {\n        [ids[0]]: e.workflow.name,\n        [ids[1]]: { text: escape(e.execution.error.stack) },\n        [ids[2]]: e.execution.error.message,\n        [ids[3]]: new Date().toISOString(),\n      },\n    },\n  },\n];\n"
      }
    },
    {
      "id": "log-n8n-execution-errors-to-monday-relay",
      "name": "Forward error to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        -100
      ],
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://YOUR_OPEN_FLOW_HOST/v1/webhooks/YOUR_ENDPOINT",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $(\"Error Trigger\").first().json }}",
        "options": {}
      }
    }
