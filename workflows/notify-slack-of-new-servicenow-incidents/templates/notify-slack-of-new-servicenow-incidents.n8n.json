    {
      "id": "notify-slack-of-new-servicenow-incidents-6",
      "name": "Post Incident Details to Slack Channel",
      "type": "n8n-nodes-base.slack",
      "position": [
        731,
        -271
      ],
      "parameters": {
        "select": "channel",
        "blocksUi": "={{ (() => { const i=$json,esc=v=>String(v ?? 'not available').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'),caller=typeof i.caller_id==='object' ? i.caller_id?.display_value : i.caller_id; if(typeof i.sys_id!=='string'||!/^[a-f0-9]{32}$/i.test(i.sys_id)||!i.number)throw Error('Invalid incident identity'); const fields=[['Incident ID',i.number],['Description',i.short_description],['Severity',i.severity],['Caller',caller],['Priority',i.priority],['State',i.incident_state],['Category',i.category],['Date Opened',i.opened_at]].map(([k,v])=>({type:'mrkdwn',text:'*'+k+':*\\n'+esc(v)}));return JSON.stringify({blocks:[{type:'header',text:{type:'plain_text',text:'ServiceNow Incident Notification',emoji:true}},{type:'section',fields},{type:'actions',elements:[{type:'button',text:{type:'plain_text',text:'View Incident',emoji:true},url:'https://YOUR_INSTANCE.service-now.com/nav_to.do?uri=incident.do%3Fsys_id%3D'+i.sys_id,action_id:'view_incident'}]}]}); })() }}",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID"
        },
        "messageType": "block",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "typeVersion": 2.2
    },
