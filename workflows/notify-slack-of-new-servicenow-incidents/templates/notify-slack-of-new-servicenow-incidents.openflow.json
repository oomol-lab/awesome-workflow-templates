    "modules": {
      "n_acec59cfda34e1fd": {
        "name": "Prepare the incident query",
        "imports": [],
        "source": "export default function window({instanceUrl}) {\n if(typeof instanceUrl!=='string'||!/^https:\\/\\/[a-z0-9-]+\\.service-now\\.com$/i.test(instanceUrl)||/YOUR_INSTANCE/i.test(instanceUrl))throw Error('Configure your ServiceNow HTTPS instance URL');\n const since=new Date(Date.now()-5*60*1000).toISOString().slice(0,19).replace('T',' ');\n return {instanceUrl,url:instanceUrl+'/api/now/table/incident?sysparm_query='+encodeURIComponent('sys_created_on>='+since)+'&sysparm_display_value=true&sysparm_limit=50'};\n}\n"
      },
      "n_7618ae73870e345b": {
        "name": "Prepare the next incident",
        "imports": [],
        "source": "export default function next({body,instanceUrl,previousState}) {\n if(!body||!Array.isArray(body.result))throw Error('Invalid ServiceNow incident response');\n const list=body.result.slice().sort((a,b)=>String(a.number??'').localeCompare(String(b.number??'')));const index=previousState?.index??0;\n if(!Number.isInteger(index)||index<0||index>list.length)throw Error('Invalid incident position');\n if(index===list.length)return {state:{index},more:false,text:'',count:index};\n const i=list[index];if(typeof i?.sys_id!=='string'||!/^[a-f0-9]{32}$/i.test(i.sys_id)||typeof i.number!=='string'||!i.number)throw Error('Invalid incident identity');\n const esc=x=>String(x??'not available').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'),caller=typeof i.caller_id==='object'?i.caller_id?.display_value:i.caller_id;\n const text=`ServiceNow Incident Notification\\nIncident ID: ${esc(i.number)}\\nDescription: ${esc(i.short_description)}\\nSeverity: ${esc(i.severity)}\\nCaller: ${esc(caller)}\\nPriority: ${esc(i.priority)}\\nState: ${esc(i.incident_state)}\\nCategory: ${esc(i.category)}\\nDate Opened: ${esc(i.opened_at)}\\nView Incident: ${instanceUrl}/nav_to.do?uri=incident.do%3Fsys_id%3D${i.sys_id}`;\n if(text.length>40000)throw Error('Incident alert exceeds Slack message limit');return {state:{index:index+1},more:true,text,count:index};\n}\n"
      }
    }
