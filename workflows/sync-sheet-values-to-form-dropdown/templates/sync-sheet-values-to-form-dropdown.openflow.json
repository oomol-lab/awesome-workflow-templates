      "n_78a255498fca7324": {
        "name": "Prepare dropdown update",
        "imports": [],
        "source": "export default async function plan(\n  { values, items, revisionId, formId, itemId, acknowledge },\n  ctx,\n) {\n  if (!formId || !itemId || formId.startsWith(\"YOUR_\") || itemId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure form and dropdown item IDs\");\n  const options = values.map((row) => String(row[0] ?? \"\").trim()).filter(Boolean);\n  if (!options.length || new Set(options).size !== options.length)\n    throw Error(\"Sheet must contain distinct non-empty choices\");\n  const index = items.findIndex((x) => x.itemId === itemId),\n    item = items[index];\n  if (index < 0 || item.questionItem?.question?.choiceQuestion?.type !== \"DROP_DOWN\" || !revisionId)\n    throw Error(\"Expected a dropdown item and form revision\");\n  const old = item.questionItem.question.choiceQuestion.options.map((x) => x.value);\n  const key = \"sheet-form:\" + formId + \":\" + itemId,\n    pending = await ctx.state.get(key);\n  if (JSON.stringify(old) === JSON.stringify(options)) {\n    if (pending) await ctx.state.set(key, null);\n    return { write: false, key, requests: [], revisionId };\n  }\n  if (pending) {\n    if (acknowledge !== key)\n      throw Error(\n        \"Previous form update uncertain. Inspect the form and acknowledge the pending key only if absent.\",\n      );\n    await ctx.state.set(key, null);\n  }\n  const next = structuredClone(item);\n  next.questionItem.question.choiceQuestion.options = options.map((value) => ({ value }));\n  const requests = [\n    {\n      updateItem: {\n        item: next,\n        location: { index },\n        updateMask: \"questionItem.question.choiceQuestion.options\",\n      },\n    },\n  ];\n  await ctx.state.set(key, { pending: true, options });\n  return { write: true, key, requests, revisionId };\n}\n"
      },
      "n_9fe51f22ef49b060": {
        "name": "Confirm dropdown update",
        "imports": [],
        "source": "export default async function f({ key, count, form, requests }, ctx) {\n  const item = requests[0]?.updateItem?.item,\n    got = form?.items?.find((x) => x.itemId === item?.itemId);\n  if (\n    count !== 1 ||\n    JSON.stringify(got?.questionItem?.question?.choiceQuestion?.options) !==\n      JSON.stringify(item?.questionItem?.question?.choiceQuestion?.options)\n  )\n    throw Error(\"Inspect form update\");\n  await ctx.state.set(key, null);\n  return { ok: true };\n}\n"
      }
    }
