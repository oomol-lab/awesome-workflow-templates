    "modules": {
      "n_a73444b64c4f9b72": {
        "name": "Format product notification",
        "imports": [],
        "source": "export default function productMessage({ body }) {\n  const escape = (text) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  for (const field of ['name', 'regular_price', 'sale_price', 'permalink', 'date_created']) if (typeof body[field] !== 'string') throw new Error('WooCommerce product is missing ' + field);\n  const link = new URL(body.permalink);\n  if (!['http:', 'https:'].includes(link.protocol) || link.username || link.password) throw new Error('Product permalink must be an HTTP(S) URL without credentials');\n  const footer = 'Added: ' + escape(body.date_created);\n  if (footer.length > 300) throw new Error('Product timestamp exceeds Slack footer size');\n  const text = ':new: A new product has been added! :new:';\n  return { text, attachments: [{ color: '#66FF00', fallback: text, fields: [\n    { title: 'Name', value: escape(body.name), short: false },\n    { title: 'Price', value: escape(body.regular_price), short: true },\n    { title: 'Sale Price', value: escape(body.sale_price), short: true },\n    { title: 'Link', value: escape(body.permalink), short: false },\n  ], footer }] };\n}\n"
      }
    }
