      "n_9cac00145954738e": {
        "name": "Collect existing records",
        "imports": [],
        "source": "export default function collectImagePages({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  return {\n    state: {\n      records: [...state.records, ...records],\n      seen: offset === null ? state.seen : [...state.seen, offset],\n    },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_d833331532b39ed0": {
        "name": "Find new posts",
        "imports": [],
        "source": "export default function plan({ response, pageState }) {\n  const data = response?.data ?? response ?? {};\n  const rawList = Array.isArray(data?.timeline)\n    ? data.timeline\n    : Array.isArray(data?.tweets)\n      ? data.tweets\n      : Array.isArray(data?.results)\n        ? data.results\n        : Array.isArray(data)\n          ? data\n          : null;\n  const records = pageState?.records;\n  if (!Array.isArray(rawList) || !Array.isArray(records)) {\n    throw Error(\"Invalid TikHub search or Airtable response\");\n  }\n  const known = new Set(\n    records\n      .map((r) => r?.fields?.Tweet_id)\n      .filter((x) => x !== undefined && x !== null)\n      .map(String),\n  );\n  const pending = [];\n  for (const item of rawList) {\n    if (!item || typeof item !== \"object\") continue;\n    const id = String(item.tweet_id ?? item.id_str ?? item.rest_id ?? item.id ?? \"\");\n    const text = item.text ?? item.full_text ?? item.legacy?.full_text ?? \"\";\n    const createdAt = String(item.created_at ?? item.createdAt ?? item.legacy?.created_at ?? \"\");\n    const likes = Number(\n      item.favorites ?? item.favorite_count ?? item.like_count ?? item.legacy?.favorite_count ?? 0,\n    );\n    const user =\n      item.user_info ?? item.author ?? item.user ?? item.core?.user_results?.result?.legacy ?? {};\n    const author = String(user.screen_name ?? user.username ?? item.screen_name ?? \"\");\n    if (!id || typeof text !== \"string\" || !createdAt || !Number.isFinite(likes) || !author) {\n      throw Error(\"Missing post ID, text, creation time, like count, or author\");\n    }\n    if (known.has(id)) continue;\n    const reply = item.in_reply_to_screen_name ?? item.legacy?.in_reply_to_screen_name ?? null;\n    pending.push({\n      fields: {\n        Likes: likes,\n        Tweet: text,\n        Tweet_id: id,\n        \"Tweet URL\": \"https://twitter.com/\" + author + \"/status/\" + id,\n        Author: reply ? String(reply) : null,\n        Time: createdAt,\n      },\n    });\n  }\n  return { pending };\n}\n"
      },
      "n_0bac8a93ae9bd8b9": {
        "name": "Prepare next batch",
        "imports": [],
        "source": "export default function next({ pending, previousState }) {\n  const state = previousState ?? { index: 0 };\n  if (previousState) state.index += 10;\n  if (!Array.isArray(pending) || state.index > pending.length + 9)\n    throw Error(\"Invalid write state\");\n  return {\n    state,\n    more: state.index < pending.length,\n    records:\n      state.index < pending.length\n        ? pending.slice(state.index, state.index + 10)\n        : [{ fields: {} }],\n    count: Math.min(state.index, pending.length),\n  };\n}\n"
      }
    }
  },
