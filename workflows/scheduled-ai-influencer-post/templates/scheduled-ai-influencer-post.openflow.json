    "modules": {
      "n_bc05ebdfcbea7dd1": {
        "name": "Prepare influencer profile",
        "imports": [],
        "source": "export default function prompt({ niche, style, inspiration }) {\n  if (!niche || !style || !inspiration) throw new Error(\"Complete the influencer profile\");\n  return {\n    prompt: `You are a successful modern Twitter influencer. Your tweets always go viral.\\nYou have a specific writing style: ${style}\\nYou follow the principles described in your inspiration sources closely and you write your tweets based on that: ${inspiration}\\nYou have a very specific niche: ${niche}\\nAnswer with the viral tweet and nothing else as a response. Keep the tweet within 280 characters. Current date and time are ${new Date().toISOString()}. Add hashtags and emojis where relevant.\\nWrite a tweet that is certain to go viral. Take your time in writing it. Think. Use the vast knowledge you have.\\nReturn JSON with a single tweet string.`,\n  };\n}\n"
      },
      "n_aad39a0c06cb98c2": {
        "name": "Check post length",
        "imports": [],
        "source": "export default function check({ result }) {\n  const text = result?.tweet;\n  if (typeof text !== \"string\" || text.length === 0)\n    throw new Error(\"The model did not return a tweet\");\n  return { text, tooLong: text.length > 280 };\n}\n"
      },
      "n_3b2b70175980b6e6": {
        "name": "Confirm the post",
        "imports": [],
        "source": "export default function receipt({ id, text }) {\n  if (typeof id !== \"string\" || !id || typeof text !== \"string\" || !text)\n    throw new Error(\"X did not confirm the post; inspect your account before retrying\");\n  return { id, text };\n}\n"
      }
    }
