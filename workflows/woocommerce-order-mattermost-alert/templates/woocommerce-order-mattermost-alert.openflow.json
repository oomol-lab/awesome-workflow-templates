    "modules": {
      "n_2a339c9420a23c05": {
        "name": "Build the purchase notice",
        "imports": [],
        "source": "export default function wooCommerceOrderNotice(input) {\n  const order = input.order;\n  if (\n    !order ||\n    typeof order !== \"object\" ||\n    Array.isArray(order) ||\n    !order.billing ||\n    typeof order.billing !== \"object\" ||\n    typeof order.billing.first_name !== \"string\" ||\n    !Array.isArray(order.line_items) ||\n    !order.line_items[0] ||\n    typeof order.line_items[0].name !== \"string\"\n  )\n    throw new Error(\n      \"The order needs billing.first_name and the first line item name before notifying Mattermost\",\n    );\n  if (typeof input.channelId !== \"string\" || !/^[a-z0-9]{26}$/.test(input.channelId))\n    throw new Error(\"Set the 26-character Mattermost channel ID\");\n  return {\n    order,\n    channelId: input.channelId,\n    message: order.billing.first_name + \" bought \" + order.line_items[0].name + \"!\",\n  };\n}\n"
      },
      "n_64e956ce59302dbc": {
        "name": "Confirm the purchase notice",
        "imports": [],
        "source": "export default function wooCommerceMattermostReceipt(input) {\n  const post = input.post;\n  if (\n    !post ||\n    typeof post !== \"object\" ||\n    Array.isArray(post) ||\n    typeof post.id !== \"string\" ||\n    !/^[a-z0-9]{26}$/.test(post.id) ||\n    post.channel_id !== input.channelId ||\n    post.message !== input.message\n  )\n    throw new Error(\n      \"Mattermost did not confirm the expected post. It may already have accepted it; inspect the channel before replaying.\",\n    );\n  return { order: input.order, post, rawPost: input.rawPost };\n}\n"
      }
    }
