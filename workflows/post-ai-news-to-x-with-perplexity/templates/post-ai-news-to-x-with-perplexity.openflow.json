        "imports": [],
        "source": "export default function message({response}){const text=response?.choices?.[0]?.message?.content;if(typeof text!=='string'||!text.trim()||[...text].length>200||!/^\\S[\\s\\S]*https?:\\/\\/\\S+/i.test(text.trim()))throw Error('Expected a short headline and article link');return{text:text.trim()}}\n"
