    "modules": {
      "n_1db79c26cc781918": {
        "name": "Prepare chart query",
        "imports": [],
        "source": "export default function ({ genre }) {\n  if (!/^[A-Z_]+$/.test(genre)) throw Error(\"Invalid genre\");\n  return {\n    body: {\n      query: `query { getTopChartsByGenres(limitPerPage:10,filterByCountry:UNITED_STATES_OF_AMERICA,taddyType:PODCASTEPISODE,genres:PODCASTSERIES_${genre}){ topChartsId podcastEpisodes{uuid name audioUrl podcastSeries{name}} } }`,\n    },\n  };\n}\n"
      },
      "n_352eb68bd8426523": {
        "name": "Validate podcast chart",
        "imports": [],
        "source": "export default function ({ body }) {\n  const items = body?.data?.getTopChartsByGenres?.podcastEpisodes;\n  if (\n    body?.errors?.length ||\n    !Array.isArray(items) ||\n    items.length > 10 ||\n    items.some(\n      (x) =>\n        !x.uuid ||\n        !x.name ||\n        !String(x.audioUrl || \"\").startsWith(\"https://\") ||\n        !x.podcastSeries?.name,\n    )\n  )\n    throw Error(\"Invalid Taddy chart\");\n  return { items };\n}\n"
      },
      "n_2082d66a0d202079": {
        "name": "Select episode",
        "imports": [],
        "source": "export default function ({ items, previous }) {\n  const i = previous?.i ?? 0,\n    results = previous?.results ?? [],\n    episode = items[i] ?? {};\n  return { more: i < items.length, episode, state: { i, results } };\n}\n"
      },
      "n_aaa0a4753fc33288": {
        "name": "Prepare transcript query",
        "imports": [],
        "source": "export default function ({ episode }) {\n  if (!episode.uuid) throw Error(\"Missing episode ID\");\n  return {\n    body: {\n      query:\n        \"query {getEpisodeTranscript(uuid:\" +\n        JSON.stringify(episode.uuid) +\n        \"){text startTimecode endTimecode}}\",\n    },\n  };\n}\n"
      },
      "n_1bd97bb140bad83a": {
        "name": "Select episode excerpt",
        "imports": [],
        "source": "export default function ({ body }) {\n  const items = body?.data?.getEpisodeTranscript;\n  if (\n    body?.errors?.length ||\n    !Array.isArray(items) ||\n    items.some(\n      (x) =>\n        !Number.isFinite(x.startTimecode) ||\n        !Number.isFinite(x.endTimecode) ||\n        typeof x.text !== \"string\",\n    )\n  )\n    throw Error(\"Transcript with timecodes unavailable\");\n  const text = items\n    .filter((x) => x.endTimecode > 480000 && x.startTimecode < 1440000)\n    .map((x) => x.text)\n    .join(\" \");\n  if (!text.trim()) throw Error(\"No transcript in 08:00–24:00\");\n  return { text };\n}\n"
      },
      "n_9a75823fc9340229": {
        "name": "Collect episode summary",
        "imports": [],
        "source": "export default function ({ state, episode, summary }) {\n  if (!summary?.summary) throw Error(\"Missing summary\");\n  return {\n    state: {\n      i: state.i + 1,\n      results: [\n        ...state.results,\n        {\n          podcast: episode.podcastSeries.name,\n          name: episode.name,\n          url: episode.audioUrl,\n          summary: summary.summary,\n        },\n      ],\n    },\n  };\n}\n"
      },
      "n_dd910ce0511f26b1": {
        "name": "Format podcast digest",
        "imports": [],
        "source": "export default function ({ state }) {\n  const e = (x) =>\n    String(x).replace(\n      /[&<>\"']/g,\n      (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n    );\n  const rows = state.results\n    .map(\n      (x) =>\n        `<tr><td>${e(x.podcast)}</td><td><a href=\"${e(x.url)}\">${e(x.name)}</a></td><td>${e(x.summary)}</td></tr>`,\n    )\n    .join(\"\");\n  return {\n    hasResults: !!state.results.length,\n    html: `<table><tr><th>Podcast</th><th>Episode</th><th>Summary (08:00–24:00)</th></tr>${rows}</table>`,\n  };\n}\n"
      },
      "n_ead9e6316226bb70": {
        "name": "Reserve digest",
        "imports": [],
        "source": "export default async function ({ scheduledAt, to }, ctx) {\n  const day = scheduledAt.slice(0, 10);\n  if (!/^\\d{4}-\\d\\d-\\d\\d$/.test(day) || !to) throw Error(\"Missing date or recipient\");\n  const key = \"podcast-digest:\" + day + \":\" + to,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect Gmail before retry\");\n  if (s?.status === \"done\") return { key, skip: true };\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, skip: false };\n}\n"
      },
      "n_6bf7e182a77e2844": {
        "name": "Confirm digest",
        "imports": [],
        "source": "export default async function confirm({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown Gmail outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
  },
