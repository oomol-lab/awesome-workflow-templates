    "modules": {
      "n_f24bbb1c592a17c9": {
        "name": "Choose old unstarred inbox messages",
        "imports": [],
        "source": "export default function archiveQuery({ scheduledAt }) {\n  const time = Date.parse(scheduledAt);\n  if (!Number.isFinite(time)) throw Error(\"Invalid schedule time\");\n  return { query: \"in:inbox -is:starred before:\" + Math.floor((time - 86400000) / 1000) };\n}\n"
      },
      "n_23326dfefe920a53": {
        "name": "Read all matching messages",
        "imports": [],
        "source": "export default async function collect({ query, previous }, context) {\n  const s = previous ?? { ids: [], cursor: null, seen: [] };\n  if (!Array.isArray(s.ids) || !Array.isArray(s.seen)) throw Error(\"Invalid page state\");\n  const r = await context.actions.call(\"gmail.fetch_emails\", {\n    query,\n    maxResults: 100,\n    detail: \"summary\",\n    ...(s.cursor ? { pageToken: s.cursor } : {}),\n  });\n  if (!Array.isArray(r.messages)) throw Error(\"Invalid Gmail page\");\n  const ids = [...s.ids],\n    known = new Set(ids);\n  for (const m of r.messages) {\n    if (\n      !m ||\n      typeof m.messageId !== \"string\" ||\n      !m.messageId ||\n      !Array.isArray(m.labelIds) ||\n      m.labelIds.some((x) => typeof x !== \"string\")\n    )\n      throw Error(\"Invalid Gmail message\");\n    if (\n      m.labelIds.includes(\"INBOX\") &&\n      !m.labelIds.includes(\"STARRED\") &&\n      !known.has(m.messageId)\n    ) {\n      known.add(m.messageId);\n      ids.push(m.messageId);\n    }\n  }\n  const cursor = r.nextPageToken;\n  if (cursor !== null && (typeof cursor !== \"string\" || !cursor || s.seen.includes(cursor)))\n    throw Error(\"Invalid or repeated Gmail page token\");\n  return {\n    state: { ids, cursor, seen: cursor ? [...s.seen, cursor] : s.seen },\n    more: cursor !== null,\n  };\n}\n"
      },
      "n_0ea0c3bc53a94bb7": {
        "name": "Prepare the next archive batch",
        "imports": [],
        "source": "export default function nextArchive({ collected, previous }) {\n  const ids = collected?.ids,\n    index = previous?.index ?? 0;\n  if (!Array.isArray(ids) || !Number.isInteger(index) || index < 0)\n    throw Error(\"Invalid archive state\");\n  if (index >= ids.length) return { state: { index }, more: false, ids: [\"\"] };\n  return { state: { index: index + 1000 }, more: true, ids: ids.slice(index, index + 1000) };\n}\n"
      },
      "n_8cc3403a606bbcc9": {
        "name": "Confirm archive",
        "imports": [],
        "source": "export default function confirm({ success }) {\n  if (success !== true) throw Error(\"Archive was not confirmed\");\n  return { ok: true };\n}\n"
      }
    }
