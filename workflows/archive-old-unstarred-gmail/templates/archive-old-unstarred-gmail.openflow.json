    "modules": {
      "n_f24bbb1c592a17c9": {
        "name": "Choose old unstarred inbox messages",
        "imports": [],
        "source": "export default function archiveQuery({scheduledAt}){const time=Date.parse(scheduledAt);if(!Number.isFinite(time))throw Error('Invalid schedule time');return{query:'in:inbox -is:starred before:'+Math.floor((time-86400000)/1000)};}\n"
      },
      "n_23326dfefe920a53": {
        "name": "Read all matching messages",
        "imports": [],
        "source": "export default async function collect({query,previous},context){const s=previous??{ids:[],cursor:null,seen:[]};if(!Array.isArray(s.ids)||!Array.isArray(s.seen))throw Error('Invalid page state');const r=await context.actions.call('gmail.fetch_emails',{query,maxResults:100,detail:'summary',...(s.cursor?{pageToken:s.cursor}:{})});if(!Array.isArray(r.messages))throw Error('Invalid Gmail page');const ids=[...s.ids],known=new Set(ids);for(const m of r.messages){if(!m||typeof m.messageId!=='string'||!m.messageId||!Array.isArray(m.labelIds)||m.labelIds.some(x=>typeof x!=='string'))throw Error('Invalid Gmail message');if(m.labelIds.includes('INBOX')&&!m.labelIds.includes('STARRED')&&!known.has(m.messageId)){known.add(m.messageId);ids.push(m.messageId)}}const cursor=r.nextPageToken;if(cursor!==null&&(typeof cursor!=='string'||!cursor||s.seen.includes(cursor)))throw Error('Invalid or repeated Gmail page token');return{state:{ids,cursor,seen:cursor?[...s.seen,cursor]:s.seen},more:cursor!==null};}\n"
      },
      "n_0ea0c3bc53a94bb7": {
        "name": "Prepare the next archive batch",
        "imports": [],
        "source": "export default function nextArchive({collected,previous}){const ids=collected?.ids,index=previous?.index??0;if(!Array.isArray(ids)||!Number.isInteger(index)||index<0)throw Error('Invalid archive state');if(index>=ids.length)return{state:{index},more:false,ids:['']};return{state:{index:index+1000},more:true,ids:ids.slice(index,index+1000)};}\n"
      },
      "n_8cc3403a606bbcc9": {
        "name": "Confirm archive",
        "imports": [],
        "source": "export default function confirm({success}){if(success!==true)throw Error('Archive was not confirmed');return{ok:true};}\n"
      }
    }
