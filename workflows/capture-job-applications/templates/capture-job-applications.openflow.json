    "modules": {
      "n_5607b1d01cfb1cb8": {
        "name": "Validate application",
        "imports": [],
        "source": "export default function ({ body }) {\n  for (const k of [\"submissionId\", \"name\", \"email\", \"phone\", \"cvUrl\", \"appliedOn\"])\n    if (typeof body[k] !== \"string\" || !body[k].trim()) throw Error(\"Missing \" + k);\n  if (!/^https:\\/\\//.test(body.cvUrl)) throw Error(\"Invalid CV URL\");\n  const experience = Number(body.experience);\n  if (!Number.isFinite(experience) || experience < 0) throw Error(\"Invalid experience\");\n  return { data: { ...body, experience } };\n}\n"
      },
      "n_1b37d51cb5efce6e": {
        "name": "Reserve application",
        "imports": [],
        "source": "export default async function ({ data }, ctx) {\n  const key = \"application:\" + data.submissionId,\n    v = await ctx.state.get(key);\n  if (v?.status === \"pending\") throw Error(\"Inspect Airtable before retry\");\n  if (v?.status !== \"done\") await ctx.state.set(key, { status: \"pending\" });\n  return {\n    key,\n    skip: v?.status === \"done\",\n    records: [\n      {\n        fields: {\n          Name: data.name,\n          \"Email address\": data.email,\n          Phone: data.phone,\n          \"CV Link\": data.cvUrl,\n          \"Years of experience\": data.experience,\n          \"Applied On\": data.appliedOn,\n        },\n      },\n    ],\n  };\n}\n"
      },
      "n_1150166eeb0b1c20": {
        "name": "Confirm application record",
        "imports": [],
        "source": "export default async function ({ key, records }, ctx) {\n  if (!Array.isArray(records) || records.length !== 1 || !records[0].id)\n    throw Error(\"Unknown Airtable outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
