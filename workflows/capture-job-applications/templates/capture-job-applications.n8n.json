    {
      "name": "Prepare application",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $(\"On form submission\").item.json,\n  id = $json.fileId;\nif (!id) throw Error(\"Missing Drive file ID\");\nreturn {\n  json: {\n    submissionId: f.Email + \":\" + f.submittedAt,\n    name: f[\"First Name\"] + \" \" + f[\"Last Name\"],\n    email: f.Email,\n    phone: String(f.Phone),\n    experience: f[\"Years of experience\"],\n    cvUrl: \"https://drive.google.com/file/d/\" + encodeURIComponent(id) + \"/view\",\n    appliedOn: f.submittedAt,\n  },\n};\n"
      },
      "typeVersion": 2,
      "id": "capture-job-applications-17",
      "position": [
        3740,
        0
      ]
    },
