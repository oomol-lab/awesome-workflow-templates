    {
      "name": "Inspect CV upload",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect destination before retry\");\nreturn { json: { done: $json.status === \"done\", fileId: $json.file_id ?? \"\" } };\n"
