      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"For each image\").item.json };\n"
      },
      "id": "generate-brand-scene-and-thumbnail-images-15",
      "position": [
        3300,
        0
      ]
    },
    {
      "name": "Submit Leonardo generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://cloud.leonardo.ai/api/rest/v1/generations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {modelId:'de7d3faf-762f-48e0-b3b7-9d0ac3a3fcf3',prompt:$json.prompt,width:720,height:1280,num_images:1,contrast:3.5,alchemy:false,ultra:false,public:false} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "generate-brand-scene-and-thumbnail-images-16",
      "position": [
        3520,
        0
      ]
    },
    {
      "name": "Verify generation ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = $json.sdGenerationJob?.generationId;\nif (!id) throw Error(\"Unknown Leonardo submission outcome\");\nreturn { json: { id } };\n"
      },
      "id": "generate-brand-scene-and-thumbnail-images-17",
      "position": [
        3740,
        0
      ]
    },
    {
      "name": "Wait for generation",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "generate-brand-scene-and-thumbnail-images-18",
      "position": [
        3960,
        0
      ]
    },
    {
      "name": "Read Leonardo generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://cloud.leonardo.ai/api/rest/v1/generations/'+$('Verify generation ID').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "generate-brand-scene-and-thumbnail-images-19",
      "position": [
        4180,
        0
      ]
    },
    {
      "name": "Check image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const g = $json.generations_by_pk;\nif (g?.status !== \"COMPLETE\" || !g.generated_images?.[0]?.url)\n  throw Error(\"Generation not complete or failed; inspect before retry\");\nreturn { json: { url: g.generated_images[0].url } };\n"
      },
      "id": "generate-brand-scene-and-thumbnail-images-20",
      "position": [
        4400,
        0
      ]
    },
    {
      "name": "Verify image asset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id) throw Error(\"Unknown asset write outcome\");\nreturn { json: $json };\n"
      },
      "id": "generate-brand-scene-and-thumbnail-images-21",
      "position": [
        4620,
        0
      ]
    },
    {
      "name": "Confirm image",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $(\"Reserve image\").item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "done"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "generate-brand-scene-and-thumbnail-images-22",
      "position": [
        4840,
        0
      ]
    }
