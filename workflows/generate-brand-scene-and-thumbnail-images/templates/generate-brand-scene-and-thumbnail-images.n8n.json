        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'brand-image:' + $('Get Content').first().json.id + ':' + $('For each image').item.json.slot }}",
