      "name": "Check created issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => {\n  if (item.json.errors?.length || !item.json.data?.issueCreate?.issue?.url)\n    throw new Error(\"Linear did not return a created issue URL\");\n  return { json: item.json, pairedItem: { item: index } };\n});\n"
      }
    }
