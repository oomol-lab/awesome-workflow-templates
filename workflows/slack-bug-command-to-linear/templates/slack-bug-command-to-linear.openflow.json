    "modules": {
      "n_7376299309621ca0": {
        "name": "Prepare Linear issue",
        "imports": [],
        "source": "export default function prepare({ event, teamId, labelIds }) {\n  const { text, user_name } = event.event;\n  const description = `## Description\\n [Add a description here]\\n## Expected\\n [What behavior did you expect?]\\n## Actual\\n [What was the actual behavior? Use screenshots or videos to show the behavior]\\n## Steps or workflow to reproduce (with screenshots/recordings)\\n **n8n version:** [Deployment type] [version]\\n 1. [Replace me]\\n\\n Created by: ${user_name}`;\n  return {\n    body: {\n      query:\n        \"mutation IssueCreate($input: IssueCreateInput!) { issueCreate(input: $input) { issue { id title url } } }\",\n      variables: { input: { title: text, teamId, description, labelIds } },\n    },\n  };\n}\n"
      },
      "n_18a275e3596141c2": {
        "name": "Prepare Slack response",
        "imports": [],
        "source": "export default function reply({ event, result }) {\n  const { text, user_id, response_url } = event.event,\n    url = result?.data?.issueCreate?.issue?.url;\n  if (!url || result.errors?.length) throw Error(\"Linear did not return a created issue URL\");\n  return {\n    responseUrl: response_url,\n    body: {\n      text: `Thanks for adding the bug \\`${text}\\` <@${user_id}> :rocket: Please make sure to add a way to reproduce, expected behavior and current behavior.\\n\\n:point_right: <${url}|Add your details here>`,\n    },\n  };\n}\n"
      }
    }
