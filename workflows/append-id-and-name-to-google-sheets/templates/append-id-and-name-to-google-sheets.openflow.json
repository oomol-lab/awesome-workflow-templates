    "modules": {
      "n_1a20fef077a9ff1b": {
        "name": "Prepare the row",
        "imports": [],
        "source": "export default function row({ values, id, name }) {\n  const h = values?.[0];\n  if (\n    !Array.isArray(h) ||\n    h.length !== 2 ||\n    new Set(h).size !== 2 ||\n    !h.includes(\"id\") ||\n    !h.includes(\"name\")\n  )\n    throw Error(\"First row must have unique id and name headers in A:B\");\n  if (typeof id !== \"number\" || !Number.isFinite(id) || typeof name !== \"string\")\n    throw Error(\"Enter an ID and name\");\n  const fields = { id: String(id), name };\n  return { values: [h.map((k) => fields[k])] };\n}\n"
      }
    }
