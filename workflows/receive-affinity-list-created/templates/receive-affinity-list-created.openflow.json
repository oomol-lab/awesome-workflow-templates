    "modules": {
      "n_4a4bb5e1e3d286c2": {
        "name": "Select created lists",
        "imports": [],
        "source": "export default function event({ body }) {\n  if (body?.type !== \"list.created\") return { accepted: false, endpoint: \"\", id: 0 };\n  const id = body?.body?.id;\n  if (!Number.isSafeInteger(id) || id <= 0) throw new Error(\"Invalid Affinity list ID\");\n  return { accepted: true, endpoint: \"/lists/\" + id, id };\n}\n"
      },
      "n_9ffe4863de2edf80": {
        "name": "Confirm list",
        "imports": [],
        "source": "export default function result({ body, statusCode, bodyEncoding, id }) {\n  if (\n    statusCode !== 200 ||\n    bodyEncoding != null ||\n    !body ||\n    typeof body !== \"object\" ||\n    Array.isArray(body) ||\n    body.id !== id\n  )\n    throw new Error(\"Affinity list lookup did not return the requested list\");\n  return { list: { ...body, type: \"list.created\" } };\n}\n"
      }
    }
