    "modules": {
      "n_feee4add70a1bf77": {
        "name": "Prepare the next subscriber",
        "imports": [],
        "source": "export default function next({body,previous}){const events=body?.events;if(!Array.isArray(events))throw Error('Expected MailerLite Classic events array');let index=previous?.index??0;if(!Number.isSafeInteger(index)||index<0)throw Error('Invalid event position');while(index<events.length){const e=events[index++];if(!e||typeof e!=='object'||Array.isArray(e))throw Error('Invalid event');if(e.type!=='subscriber.add_to_group')continue;const sub=e.data?.subscriber;if(!sub||typeof sub.name!=='string'||typeof sub.email!=='string'||!sub.email)throw Error('Subscriber name and email required');return{state:{index},more:true,records:[{fields:{Name:sub.name,Email:sub.email}}]}}return{state:{index},more:false,records:[{fields:{}}]}}\n"
      }
