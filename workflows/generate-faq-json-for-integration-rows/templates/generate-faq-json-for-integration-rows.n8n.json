    {
      "name": "Draft FAQ answers",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.5,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Draft concise answers for setup, permissions, combining with other apps, and use cases for this n8n integration or category. Distinguish native, credential-only and generic HTTP integrations. Avoid unsupported claims, pricing and fabricated capabilities; say documentation must be checked when unsure. Return drafts for human review. Job: '+JSON.stringify($json) }}",
        "hasOutputParser": true,
        "options": {}
      },
