      "position": [
        1760,
        0
      ]
    },
    {
      "name": "FAQ output parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"setup\":{\"type\":\"string\"},\"permissions\":{\"type\":\"string\"},\"combine\":{\"type\":\"string\"},\"uses\":{\"type\":\"string\"}},\"required\":[\"setup\",\"permissions\",\"combine\",\"uses\"],\"additionalProperties\":false}"
      },
      "id": "generate-faq-json-for-integration-rows-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Format FAQ JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $(\"Validate job\").item.json,\n  r = $json.output;\nif (\n  !r ||\n  [\"setup\", \"permissions\", \"combine\", \"uses\"].some((k) => typeof r[k] !== \"string\" || !r[k].trim())\n)\n  throw Error(\"Incomplete FAQ\");\nconst n = j.name,\n  q = [\n    {\n      question:\n        j.kind === \"Categories\"\n          ? \"What types of \" + n + \" tools can I integrate with n8n?\"\n          : \"How can I set up \" + n + \" integration in n8n?\",\n      answer: r.setup,\n    },\n    {\n      question: \"What permissions or credentials may be needed for \" + n + \"?\",\n      answer: r.permissions,\n    },\n    { question: \"Can I combine \" + n + \" with other apps in n8n workflows?\", answer: r.combine },\n    { question: \"What are common use cases for \" + n + \" integrations?\", answer: r.uses },\n    { question: \"How does n8n pricing affect \" + n + \" workflows?\", answer: j.pricing },\n  ];\nreturn {\n  json: { name: n + \"-faq.json\", content: JSON.stringify({ name: n, questions: q }, null, 2) },\n};\n"
      },
      "id": "generate-faq-json-for-integration-rows-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Verify FAQ file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.id) throw Error(\"Unknown Drive outcome\");\nreturn { json: $json };\n"
      },
