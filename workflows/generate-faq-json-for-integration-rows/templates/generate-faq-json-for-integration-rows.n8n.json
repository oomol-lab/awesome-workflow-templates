        }
      },
      "typeVersion": 4.4
    },
    {
      "name": "Validate job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json,\n  types = [\n    \"Single Integration Native\",\n    \"Single Integration Cred-only\",\n    \"Single Integration Non-native\",\n    \"Categories\",\n  ];\nif (\n  !j.name ||\n  !types.includes(j.kind) ||\n  !j.sheet ||\n  !Number.isInteger(j.row) ||\n  j.row < 2 ||\n  !/^[A-Z]+$/.test(j.statusColumn) ||\n  !j.spreadsheetId ||\n  !j.folderId ||\n  !j.pricing\n)\n  throw Error(\"Provide a valid job and destination\");\nreturn { json: j };\n"
      },
      "id": "generate-faq-json-for-integration-rows-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "No prior FAQ",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
