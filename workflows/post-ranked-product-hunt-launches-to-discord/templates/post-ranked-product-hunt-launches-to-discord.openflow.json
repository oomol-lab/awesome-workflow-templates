    "modules": {
      "n_16b160113d536b8c": {
        "name": "Prepare the ranking query",
        "imports": [],
        "source": "export default function query() {\n  const before = new Date(),\n    after = new Date(before.getTime() - 86400000);\n  return {\n    body: {\n      query:\n        \"query RankedPosts($after: DateTime!, $before: DateTime!) { posts(postedAfter: $after, postedBefore: $before, order: RANKING, first: 5) { edges { node { name description votesCount } } } }\",\n      variables: { after: after.toISOString(), before: before.toISOString() },\n    },\n  };\n}\n"
      },
      "n_fa1ebca79bed02c1": {
        "name": "Prepare the next launch",
        "imports": [],
        "source": "export default function next({ body, previousState }) {\n  if (\n    !body ||\n    typeof body !== \"object\" ||\n    (Array.isArray(body.errors) && body.errors.length) ||\n    !Array.isArray(body.data?.posts?.edges) ||\n    body.data.posts.edges.length > 5\n  )\n    throw Error(\"Invalid Product Hunt response\");\n  const posts = body.data.posts.edges.map((e) => {\n    const p = e?.node;\n    if (\n      typeof p?.name !== \"string\" ||\n      !p.name ||\n      typeof p.description !== \"string\" ||\n      !Number.isSafeInteger(p.votesCount) ||\n      p.votesCount < 0\n    )\n      throw Error(\"Invalid ranked product\");\n    const escape = (v) => v.replace(/@/g, \"@\\u200b\");\n    const text = `Here are the top 5 PH projects:\\n**Name:** ${escape(p.name)}\\n**Description:** ${escape(p.description)}\\n**Vote:** ${p.votesCount}\\n-------`;\n    if (text.length > 2000) throw Error(\"Product message exceeds Discord limit\");\n    return text;\n  });\n  const index = previousState?.index ?? 0;\n  if (!Number.isInteger(index) || index < 0 || index > posts.length)\n    throw Error(\"Invalid product position\");\n  return {\n    state: { index: index + 1 },\n    more: index < posts.length,\n    text: posts[index] ?? \"\",\n    count: index,\n  };\n}\n"
      }
    }
  },
