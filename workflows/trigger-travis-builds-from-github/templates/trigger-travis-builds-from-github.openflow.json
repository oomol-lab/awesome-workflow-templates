    "modules": {
      "n_9baead13ea03c2d7": {
        "name": "Select the next build",
        "imports": [],
        "source": "export default async function ({ body, event, deliveryId, branch, acknowledgeId }, ctx) {\n  const none = { more: false, url: \"\", body: {}, deliveryId: \"\" };\n  if (!branch || branch.startsWith(\"YOUR_\")) throw Error(\"Configure the Travis branch\");\n  if (event !== \"push\" && !(event === \"pull_request\" && body?.action === \"opened\")) return none;\n  const slug = body?.repository?.full_name;\n  if (typeof slug !== \"string\" || !/^[-A-Za-z0-9_.]+\\/[-A-Za-z0-9_.]+$/.test(slug) || !deliveryId)\n    throw Error(\"Missing repository or delivery ID\");\n  const s = (await ctx.state.get(\"travis-github\")) ?? { pending: null, queue: [], done: [] };\n  if (\n    !s.done.includes(deliveryId) &&\n    s.pending?.id !== deliveryId &&\n    !s.queue.some((x) => x.id === deliveryId)\n  ) {\n    s.queue.push({ id: deliveryId, slug, branch });\n    await ctx.state.set(\"travis-github\", s);\n  }\n  if (s.pending) {\n    if (acknowledgeId !== s.pending.id) throw Error(\"Inspect pending build \" + s.pending.id);\n    s.done.push(s.pending.id);\n    s.pending = null;\n    await ctx.state.set(\"travis-github\", s);\n  }\n  if (!s.queue.length) return none;\n  const item = s.queue.shift();\n  s.pending = item;\n  await ctx.state.set(\"travis-github\", s);\n  return {\n    more: true,\n    deliveryId: item.id,\n    url: \"https://api.travis-ci.com/repo/\" + encodeURIComponent(item.slug) + \"/requests\",\n    body: { request: { branch: item.branch } },\n  };\n}\n"
      },
      "n_fd08fa124974a5a2": {
        "name": "Confirm build request",
        "imports": [],
        "source": "export default async function ({ response, deliveryId }, ctx) {\n  if (!response || response[\"@type\"] !== \"pending\") throw Error(\"Build request not confirmed\");\n  const s = await ctx.state.get(\"travis-github\");\n  if (s?.pending?.id !== deliveryId) throw Error(\"Pending build mismatch\");\n  s.done.push(deliveryId);\n  s.pending = null;\n  await ctx.state.set(\"travis-github\", s);\n  return { done: true };\n}\n"
      }
