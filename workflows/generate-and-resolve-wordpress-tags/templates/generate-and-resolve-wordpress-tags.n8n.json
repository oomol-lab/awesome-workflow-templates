    {
      "id": "31db85c9-e4c2-4409-9d92-7eb005223de0",
      "name": "Generate tags for article",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        3360,
        320
      ],
      "parameters": {
        "text": "=Please provide 3-5 suitable tags for the following article:\n\n{{ $json.content }}\n\nTag Formatting Rules:\n1. Tags should be in title case",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.4
    },
    {
      "id": "generate-and-resolve-wordpress-tags-expand-requested-tags",
      "name": "Expand requested tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().flatMap((item, index) => {\n  const tags = item.json.tags;\n  if (!Array.isArray(tags) || !tags.length) throw Error(\"Provide at least one tag\");\n  const unique = new Map();\n  for (const name of tags) {\n    if (typeof name !== \"string\" || !name.trim()) throw Error(\"Invalid tag\");\n    const slug = name.trim().toLowerCase().replace(/\\s+/g, \"-\");\n    if (!unique.has(slug)) unique.set(slug, name.trim());\n  }\n  return [...unique].map(([slug, name]) => ({ json: { slug, name }, pairedItem: { item: index } }));\n});\n"
      },
      "position": [
        0,
        0
      ]
    },
