      },
      "typeVersion": 1.1
    },
    {
      "id": "matomo-repeat-visits-seo-report-row",
      "name": "Prepare report row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function reportRow({ completion, blog }) {\n  if (typeof blog !== \"string\" || !blog.trim() || blog === \"YOUR_BLOG_NAME\")\n    throw Error(\"Configure the blog name\");\n  const text = completion?.choices?.[0]?.message?.content;\n  if (typeof text !== \"string\" || !text.trim()) throw Error(\"OpenRouter returned no report text\");\n  if (completion.choices[0].finish_reason === \"length\")\n    throw Error(\"OpenRouter report was truncated\");\n  return { row: { Date: new Date().toISOString().slice(0, 10), Note: text, Blog: blog } };\n}\n\nreturn { json: reportRow({ completion: $json, blog: \"YOUR_BLOG_NAME\" }) };\n"
      }
    }
