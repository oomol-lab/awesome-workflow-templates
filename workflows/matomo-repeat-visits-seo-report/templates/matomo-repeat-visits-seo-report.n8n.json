    {
      "id": "matomo-repeat-visits-seo-report-3",
      "name": "Parse data from Matomo",
      "type": "n8n-nodes-base.code",
      "position": [
        580,
        260
      ],
      "parameters": {
        "jsCode": "function matomoPrompt({ body }) {\n  if (!Array.isArray(body)) throw Error(\"Matomo did not return a visit list\");\n  if (body.length > 100) throw Error(\"Matomo exceeded the 100-visit limit\");\n  if (!body.length) return { hasVisits: false, messages: [] };\n  const lines = body\n    .map((v) => {\n      if (\n        typeof v?.visitorId !== \"string\" ||\n        !v.visitorId ||\n        !Number.isFinite(Number(v.visitCount)) ||\n        !Array.isArray(v.actionDetails)\n      )\n        throw Error(\"Invalid Matomo visit\");\n      const actions = v.actionDetails\n        .map((a) => {\n          if (!a || typeof a !== \"object\" || Array.isArray(a)) throw Error(\"Invalid Matomo action\");\n          return `  - Page ${a.pageviewPosition ?? \"not provided\"}: ${a.pageTitle ?? \"not provided\"}\\n    URL: ${a.url ?? \"not provided\"}\\n    Time Spent: ${a.timeSpentPretty ?? \"not provided\"}`;\n        })\n        .join(\"\\n\");\n      return `- Visitor (ID: ${v.visitorId}):\\n  Visit Count: ${v.visitCount}\\n${actions}`;\n    })\n    .join(\"\\n\\n\");\n  const content = `You are an SEO expert. Please analyze this visitor data:\\n\\n${lines}\\n\\nPlease provide insights on:\\n1. Common visitor paths\\n2. Popular pages\\n3. User engagement patterns\\n4. Recommendations for improvement`;\n  return { hasVisits: true, messages: [{ role: \"user\", content }] };\n}\n\nconst result = matomoPrompt({ body: $input.all().map((i) => i.json) });\nreturn result.hasVisits ? [{ json: result }] : [];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "matomo-repeat-visits-seo-report-4",
      "name": "Send data to A.I. for analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        760,
        260
      ],
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "POST",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({model:\"YOUR_OPENROUTER_MODEL_ID\",messages:$json.messages}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2,
      "alwaysOutputData": false
    },
    {
      "id": "matomo-repeat-visits-seo-report-5",
