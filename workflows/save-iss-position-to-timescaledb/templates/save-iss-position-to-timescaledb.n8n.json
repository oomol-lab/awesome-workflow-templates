{
  "nodes": [
    {
      "name": "TimescaleDB",
      "type": "n8n-nodes-base.timescaleDb",
      "position": [
        1110,
        260
      ],
      "parameters": {
        "table": "iss",
        "columns": "latitude, longitude, timestamp"
      },
      "typeVersion": 1,
      "id": "save-iss-position-to-timescaledb-0"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        910,
        260
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "latitude",
              "value": "={{$json[\"latitude\"]}}"
            },
            {
              "name": "longitude",
              "value": "={{$json[\"longitude\"]}}"
            },
            {
              "name": "timestamp",
              "value": "={{$json[\"timestamp\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "save-iss-position-to-timescaledb-1"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        710,
        260
      ],
      "parameters": {
        "url": "https://api.wheretheiss.at/v1/satellites/25544",
        "options": {}
      },
      "typeVersion": 1,
      "id": "save-iss-position-to-timescaledb-2"
    },
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        510,
        260
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "save-iss-position-to-timescaledb-3"
    },
    {
      "id": "save-iss-position-to-timescaledb-hook",
      "name": "TimescaleDB relay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        300,
        500
      ],
      "disabled": true,
      "parameters": {
        "httpMethod": "POST",
        "path": "save-iss-position-to-timescaledb",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "save-iss-position-to-timescaledb-unpack",
      "name": "Read relayed position",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body;\nif (!b || [\"latitude\", \"longitude\", \"timestamp\"].some((k) => typeof b[k] !== \"string\"))\n  throw Error(\"Invalid relayed position\");\nreturn { json: b };\n"
      }
    },
    {
      "name": "TimescaleDB relay insert",
      "type": "n8n-nodes-base.timescaleDb",
      "position": [
        900,
        500
      ],
      "parameters": {
        "table": "iss",
        "columns": "latitude, longitude, timestamp",
        "returnFields": "*"
      },
      "typeVersion": 1,
      "id": "save-iss-position-to-timescaledb-relay-db"
    },
    {
      "id": "save-iss-position-to-timescaledb-respond",
      "name": "Confirm database insert",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Set": {
      "main": [
        [
          {
            "node": "TimescaleDB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Set",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TimescaleDB relay webhook": {
      "main": [
        [
          {
            "node": "Read relayed position",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read relayed position": {
      "main": [
        [
          {
            "node": "TimescaleDB relay insert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TimescaleDB relay insert": {
      "main": [
        [
          {
            "node": "Confirm database insert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Save ISS Position to TimescaleDB",
  "active": false,
