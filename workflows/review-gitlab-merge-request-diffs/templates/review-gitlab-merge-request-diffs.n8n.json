    {
      "name": "Validate review request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body,\n  a = b?.object_attributes;\nif (b?.object_kind !== \"note\" || a?.noteable_type !== \"MergeRequest\" || a.note !== \"+0\")\n  return { json: { relevant: false } };\nif (\n  !Number.isSafeInteger(b.project_id) ||\n  !Number.isSafeInteger(b.merge_request?.iid) ||\n  !Number.isSafeInteger(a.id)\n)\n  throw Error(\"Missing review identity\");\nreturn { json: { relevant: true, project: b.project_id, iid: b.merge_request.iid, noteId: a.id } };\n"
      },
      "id": "review-gitlab-merge-request-diffs-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Review requested?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.relevant }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "review-gitlab-merge-request-diffs-2",
      "position": [
