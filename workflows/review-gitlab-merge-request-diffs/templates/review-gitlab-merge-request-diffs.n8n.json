    {
      "name": "Prepare changed files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = $input.all(),\n  files = pages.flatMap((p) => p.json.body);\nif (\n  files.some(\n    (x) =>\n      x.too_large ||\n      x.collapsed ||\n      (!x.deleted_file && !x.renamed_file && typeof x.diff !== \"string\"),\n  )\n)\n  throw Error(\"GitLab omitted a diff\");\nfunction select({ files, previous }) {\n  let i = previous?.index ?? 0;\n  while (\n    i < files.length &&\n    (files[i].renamed_file || files[i].deleted_file || !files[i].diff?.startsWith(\"@@\"))\n  )\n    i++;\n  const more = i < files.length,\n    x = more ? files[i] : { diff: \"\", old_path: \"\", new_path: \"\" };\n  let old = 0,\n    now = 0,\n    position = null;\n  for (const line of x.diff.split(\"\\n\")) {\n    const m = /^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/.exec(line);\n    if (m) {\n      old = +m[1];\n      now = +m[2];\n      continue;\n    }\n    if (line.startsWith(\"+\")) {\n      position = { new_line: now };\n      now++;\n    } else if (line.startsWith(\"-\")) {\n      position = { old_line: old };\n      old++;\n    } else if (line.startsWith(\" \")) {\n      old++;\n      now++;\n    }\n  }\n  if (more && !position) throw Error(\"No changed line to anchor review\");\n  return { state: { index: i + 1 }, more, file: x, position: position ?? {} };\n}\n\nconst out = [];\nlet prev = null;\nfor (;;) {\n  const x = select({ files, previous: prev });\n  if (!x.more) break;\n  out.push({ json: { file: x.file, position: x.position }, pairedItem: { item: 0 } });\n  prev = x.state;\n}\nreturn out;\n"
      },
      "id": "review-gitlab-merge-request-diffs-6",
      "position": [
        1320,
        0
      ]
    },
