    {
      "name": "Validate diff refs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json.diff_refs;\nif (!x?.base_sha || !x?.start_sha || !x?.head_sha) throw Error(\"Diff refs not ready\");\nreturn { json: { refs: x, event: $(\"Validate review request\").item.json } };\n"
      },
      "id": "review-gitlab-merge-request-diffs-4",
