      "n_9b6cc755b2512b07": {
        "name": "Choose next record",
        "imports": [],
        "source": "export default function main({records,previous}) {\n  if (!Array.isArray(records)) throw Error('Invalid Airtable records');\n  const i=previous == null ? 0 : previous.index+1;\n  if(!Number.isInteger(i)||i<0||i>records.length)throw Error('Invalid position');\n  if(i===records.length)return {state:{index:i},more:false,url:'https://example.com',id:'none'};\n  const r=records[i],url=r?.fields?.url;\n  if(typeof r?.id!=='string'||!r.id||typeof url!=='string'||!/^https?:\\/\\//i.test(url))throw Error('Record needs an ID and public HTTP URL');\n  return {state:{index:i},more:true,url,id:r.id};\n}\n"
      },
      "n_d4cf6afc772a63c0": {
        "name": "Prepare record update",
        "imports": [],
        "source": "export default function main({data,id,statusCode}) {\n  if(statusCode<200 || statusCode>=300) throw Error('Page request failed');\n  if(!data||typeof data.title!=='string'||typeof data.description!=='string')throw Error('Page must provide a title and meta description');\n  return {records:[{id,fields:{'title tag':data.title,'meta desc':data.description}}]};\n}\n"
      },
      "n_560822c50ca38b78": {
        "name": "Confirm record update",
        "imports": [],
        "source": "export default function main({records,id}) {\n  if(!Array.isArray(records)||records.length!==1||records[0]?.id!==id)throw Error('Airtable update did not confirm the matching record');\n  return {ok:true};\n}\n"
      }
    }
