      "name": "Validate parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (\n  $json.job?.status !== \"COMPLETED\" ||\n  !Array.isArray($json.markdown?.pages) ||\n  $json.markdown.pages.some((x) => !x.success)\n)\n  throw Error(\"Parse result incomplete\");\nreturn { json: $json };\n"
      },
      "id": "parse-drive-invoices-into-airtable-22",
