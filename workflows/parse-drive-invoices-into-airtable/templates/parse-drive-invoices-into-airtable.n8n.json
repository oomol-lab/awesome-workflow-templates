    {
      "id": "parse-drive-invoices-into-airtable-5",
      "name": "OpenAI - Extract Line Items",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "=https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({model:'gpt-4o-mini',messages:[{role:'system',content:'Extract all invoice line items as JSON with items array. Each item must have description, qty, unit_price, and amount; quantities and prices are numbers.'},{role:'user',content:JSON.stringify($json.markdown.pages.map(x=>x.markdown))}],response_format:{type:'json_object'}}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi"
      },
      "typeVersion": 4.2
    },
    {
      "id": "parse-drive-invoices-into-airtable-6",
      "name": "Process Line Items",
      "type": "n8n-nodes-base.code",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const rows = JSON.parse(\n  $(\"OpenAI - Extract Line Items\").first().json.choices[0].message.content,\n).items;\nif (!Array.isArray(rows)) throw Error(\"No invoice items\");\nreturn rows.length\n  ? rows.map((x) => {\n      const r = {\n        description: String(x.description || \"\"),\n        qty: Number(x.qty),\n        unit_price: Number(x.unit_price),\n        amount: Number(x.amount),\n      };\n      if (!r.description || ![r.qty, r.unit_price, r.amount].every(Number.isFinite))\n        throw Error(\"Invalid invoice item\");\n      return { json: r, pairedItem: { item: 0 } };\n    })\n  : [{ json: { empty: true }, pairedItem: { item: 0 } }];\n"
      },
      "typeVersion": 2
    },
