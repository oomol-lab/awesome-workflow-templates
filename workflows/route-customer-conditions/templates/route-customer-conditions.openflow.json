      "n_44957cff54934fdc": {
        "name": "Select customer",
        "imports": [],
        "source": "export default function next({ customers, previous }) {\n  const state = previous ?? {\n    index: 0,\n    usYes: [],\n    usNo: [],\n    orYes: [],\n    orNo: [],\n    US: [],\n    CO: [],\n    UK: [],\n    other: [],\n  };\n  const item = customers[state.index] ?? {};\n  return {\n    state,\n    index: state.index,\n    has: state.index < customers.length,\n    name: String(item.name ?? \"\"),\n    country: String(item.country ?? \"\"),\n    item,\n  };\n}\n"
      },
      "n_3f5b248816d6051e": {
        "name": "Advance customer",
        "imports": [],
        "source": "export default function advance({ state }) {\n  return { state: { ...state, index: state.index + 1 } };\n}\n"
      },
