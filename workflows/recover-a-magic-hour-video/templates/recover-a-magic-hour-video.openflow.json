                        "properties": {
                          "message": {
                            "type": "string",
                            "description": "Details on the reason why a failure happened."
                          },
                          "code": {
                            "type": "string",
                            "description": "An error code to indicate why a failure happened."
                          }
                        },
                        "required": [
