    "modules": {
      "n_66e32a1c9f3df85e": {
        "name": "Require a completed video",
        "imports": [],
        "source": "export default function recover({ body, projectId }) {\n  if (!body || body.id !== projectId) throw Error(\"Project ID mismatch\");\n  if (body.status !== \"complete\")\n    throw Error(\"Video is \" + body.status + \" for project \" + projectId);\n  if (\n    !Array.isArray(body.downloads) ||\n    !body.downloads[0] ||\n    typeof body.downloads[0].url !== \"string\"\n  )\n    throw Error(\"Missing video download for project \" + projectId);\n  return { url: body.downloads[0].url, id: projectId };\n}\n"
      },
      "n_427e739a4e068356": {
        "name": "Download the video",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function download({ url, id }, context) {\n  if (typeof url !== \"string\" || !/^https:\\/\\//.test(url))\n    throw Error(\"Invalid video URL for project \" + id);\n  const r = await context.fetch(url, { method: \"GET\" });\n  if (!r.ok) throw Error(\"Download failed for project \" + id);\n  const b = Buffer.from(await r.arrayBuffer());\n  if (b.length < 12 || b.subarray(4, 8).toString() !== \"ftyp\")\n    throw Error(\"Invalid MP4 for project \" + id);\n  const video = await context.artifact.put(b, { name: \"video.mp4\", mediaType: \"video/mp4\" });\n  return { video, url, id };\n}\n"
      }
    }
