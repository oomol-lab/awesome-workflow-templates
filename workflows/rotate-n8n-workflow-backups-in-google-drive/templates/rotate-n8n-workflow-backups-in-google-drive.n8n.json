      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all().filter((x) => x.json.id);\nconst names = [\"n8n_old\", \"n8n_backups\"];\nfor (const n of names)\n  if (items.filter((x) => x.json.name === n).length > 1) throw Error(\"Duplicate root folder \" + n);\nconst missing = names.filter((n) => !items.some((x) => x.json.name === n));\nreturn [{ json: { message: missing.join(\",\") } }];\n"
      },
      "typeVersion": 2
    },
