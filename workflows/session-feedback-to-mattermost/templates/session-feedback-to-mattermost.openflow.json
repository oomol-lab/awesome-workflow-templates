    "modules": {
      "n_0a8dd54e26970031": {
        "name": "Prepare the session rows",
        "imports": [],
        "source": "export default function feedbackRows({values}){\n if(!Array.isArray(values))throw Error('Expected sheet rows');if(!values.length)return{rows:[]};\n const h=values[0],names=['Session','Mattermost Channel ID','Feedback Form Link'],indexes=names.map(n=>h.indexOf(n)),data=values.slice(1).filter(r=>r.some((_,i)=>Boolean(h[i])));\n if(!data.length)return{rows:[]};if(indexes.some((i,j)=>i<0||h.lastIndexOf(names[j])!==i))throw Error('Sheet needs unique Session, Mattermost Channel ID and Feedback Form Link headers');\n return{rows:data.map(r=>{let [session,channelId,url]=indexes.map(i=>r[i]);if([session,channelId,url].some(x=>typeof x!=='string'||!x.trim()))throw Error('Every session needs a name, channel ID and feedback URL');return{session,channelId,url}})};\n}\n"
      },
      "n_cf9a7cc7924d20a6": {
        "name": "Prepare next feedback notice",
        "imports": [],
        "source": "export default function feedbackNext({rows,previousState}){\n const index=previousState===null?0:previousState.index+1,more=index<rows.length,r=more?rows[index]:{session:'-',channelId:'-',url:'-'};\n return{state:{index},more,channelId:r.channelId,message:` Hey @channel, we hope you had a great time at **${r.session}**.\\nLet us know how we did by sharing your feedback with us on the link below!`,props:{attachments:[{title:'Feedback Form - '+r.session,title_link:r.url}]},count:rows.length};\n}\n"
      }
