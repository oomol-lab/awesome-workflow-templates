    {
      "id": "email-server-package-update-notice-3",
      "name": "Format as HTML list",
      "type": "n8n-nodes-base.code",
      "position": [
        -60,
        0
      ],
      "parameters": {
        "jsCode": "const x = $input.first().json;\nif (x.code !== 0 || typeof x.stdout !== \"string\") throw Error(\"Remote apt command failed\");\nconst esc = (v) =>\n  v.replace(\n    /[&<>\"']/g,\n    (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n  );\nreturn {\n  json: {\n    htmlList:\n      \"<ul>\" +\n      x.stdout\n        .split(\"\\n\")\n        .map((s) => s.trim())\n        .filter((s) => s && s !== \"Listing...\")\n        .map((s) => \"<li>\" + esc(s) + \"</li>\")\n        .join(\"\") +\n      \"</ul>\",\n  },\n};\n"
      },
      "typeVersion": 2
    },
    {
