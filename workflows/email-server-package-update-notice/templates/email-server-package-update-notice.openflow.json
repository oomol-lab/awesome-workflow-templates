    "modules": {
      "n_1174ee258d19f093": {
        "name": "Format available updates",
        "imports": [],
        "source": "export default function format({ body }) {\n  if (!body || typeof body.stdout !== \"string\" || body.code !== 0)\n    throw Error(\"Remote apt command failed\");\n  const lines = body.stdout\n    .split(\"\\n\")\n    .map((x) => x.trim())\n    .filter((x) => x && x !== \"Listing...\");\n  const esc = (x) =>\n    x.replace(\n      /[&<>\"']/g,\n      (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n    );\n  return {\n    hasUpdates: lines.length > 0,\n    html:\n      \"<p>The following packages can be updated on your server:</p><ul>\" +\n      lines.map((x) => \"<li>\" + esc(x) + \"</li>\").join(\"\") +\n      \"</ul><p>Please login and perform upgrade.</p>\",\n  };\n}\n"
      }
    }
