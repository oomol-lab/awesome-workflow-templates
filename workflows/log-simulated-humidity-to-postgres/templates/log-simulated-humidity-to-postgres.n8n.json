{
  "name": "Log Simulated Humidity to PostgreSQL",
  "nodes": [
    {
      "id": "log-simulated-humidity-to-postgres-schedule",
      "name": "Run every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "log-simulated-humidity-to-postgres-simulate",
      "name": "Generate a simulated reading",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const timeStamp = new Date($input.first().json.timestamp).toISOString();\nreturn [\n  {\n    json: {\n      sensor_id: \"humidity01\",\n      value: Math.floor(Math.random() * 100) + 1,\n      time_stamp: timeStamp,\n      notification: false,\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      }
    },
    {
      "id": "log-simulated-humidity-to-postgres-insert",
      "name": "Insert the reading into PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        240
      ],
      "parameters": {
        "resource": "database",
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "n8n"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        },
        "options": {
          "outputColumns": [
            "sensor_id",
            "value",
            "time_stamp",
            "notification"
          ]
        }
      }
    }
  ],
  "connections": {
    "Run every minute": {
      "main": [
        [
          {
            "node": "Generate a simulated reading",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate a simulated reading": {
      "main": [
        [
          {
            "node": "Insert the reading into PostgreSQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "pinData": {}
}
