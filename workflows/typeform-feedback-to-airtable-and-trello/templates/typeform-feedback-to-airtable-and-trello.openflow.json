    "modules": {
      "n_84fe148f49a31890": {
        "name": "Read the feedback answers",
        "imports": [],
        "source": "export default function feedback({ response }) {\n  if (!Array.isArray(response?.definition?.fields) || !Array.isArray(response?.answers))\n    throw Error(\"Expected the complete Typeform response\");\n  const read = (title, type, required) => {\n    const matches = response.definition.fields.filter((x) => x?.title === title);\n    if (\n      matches.length !== 1 ||\n      !matches[0].id ||\n      response.definition.fields.filter((x) => x.id === matches[0].id).length !== 1\n    )\n      throw Error(\"Expected one question titled \" + title);\n    const answers = response.answers.filter((x) => x?.field?.id === matches[0].id);\n    if (!answers.length && !required) return \"\";\n    if (answers.length !== 1 || answers[0].type !== type)\n      throw Error(\"Invalid answer for \" + title);\n    const v = answers[0][type];\n    if (\n      type === \"number\"\n        ? typeof v !== \"number\" || !Number.isFinite(v)\n        : typeof v !== \"string\" || (required && !v.trim())\n    )\n      throw Error(\"Invalid answer for \" + title);\n    return v;\n  };\n  const fields = {\n    Name: read(\"What is your name?\", \"text\", true),\n    Email: read(\"What is your email address?\", \"email\", false),\n    Score: read(\"What score would you like to give?\", \"number\", true),\n    Description: read(\"Anything else you want to share?\", \"text\", false),\n  };\n  return { fields, records: [{ fields }] };\n}\n"
      },
      "n_4826d02e0fc683da": {
        "name": "Confirm and classify the feedback",
        "imports": [],
        "source": "export default function confirm({ records, fields }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id\n  )\n    throw Error(\"Airtable did not confirm one record\");\n  const f = records[0].fields;\n  if (\n    !f ||\n    f.Score !== fields.Score ||\n    f.Name !== fields.Name ||\n    (f.Email ?? \"\") !== fields.Email ||\n    (f.Description ?? \"\") !== fields.Description\n  )\n    throw Error(\"Airtable record differs from submitted feedback\");\n  const name = `[${f.Score}] ${f.Name}`,\n    description = `Name: ${f.Name}\\nEmail: ${f.Email ?? \"\"}\\nScore: ${f.Score}\\nDescription: ${f.Description ?? \"\"}`;\n  return { low: f.Score < 7, name, description };\n}\n"
      }
    }
