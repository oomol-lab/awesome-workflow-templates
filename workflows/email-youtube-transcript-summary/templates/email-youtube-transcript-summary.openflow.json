    "modules": {
      "n_adc0386140f54bbf": {
        "name": "Extract the video ID",
        "imports": [],
        "source": "export default function ({ url }) {\n  let u;\n  try {\n    u = new URL(url);\n  } catch {\n    throw Error(\"Enter a YouTube URL\");\n  }\n  const host = u.hostname.toLowerCase(),\n    parts = u.pathname.split(\"/\").filter(Boolean);\n  let id;\n  if (host === \"youtu.be\") id = parts[0];\n  else if ([\"youtube.com\", \"www.youtube.com\", \"m.youtube.com\"].includes(host)) {\n    id = u.searchParams.get(\"v\");\n    if (!id && [\"shorts\", \"embed\", \"live\"].includes(parts[0])) id = parts[1];\n  }\n  if (!/^[A-Za-z0-9_-]{11}$/.test(id ?? \"\")) throw Error(\"Invalid YouTube video URL\");\n  return { id, body: { ids: [id] } };\n}\n"
      },
      "n_dab20f85291a8894": {
        "name": "Read the transcript",
        "imports": [],
        "source": "export default function ({ body, id }) {\n  if (!Array.isArray(body) || body.length !== 1 || body[0]?.id !== id)\n    throw Error(\"Transcript response does not match video\");\n  const track = body[0]?.tracks?.[0];\n  if (\n    !Array.isArray(track?.transcript) ||\n    !track.transcript.length ||\n    track.transcript.some((x) => typeof x?.text !== \"string\")\n  )\n    throw Error(\"No transcript available\");\n  return {\n    text: track.transcript\n      .map((x) => x.text)\n      .join(\" \")\n      .trim(),\n    language: track.language ?? \"\",\n  };\n}\n"
      },
      "n_1d0cdf01eb8ef93d": {
        "name": "Prepare the email",
        "imports": [],
        "source": "export default function ({ result, to }) {\n  if (typeof to !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(to)) throw Error(\"Configure recipient\");\n  if (\n    typeof result?.title !== \"string\" ||\n    !result.title.trim() ||\n    typeof result?.text !== \"string\" ||\n    !result.text.trim()\n  )\n    throw Error(\"Invalid summary\");\n  return { to, subject: result.title, body: result.text };\n}\n"
      }
    }
