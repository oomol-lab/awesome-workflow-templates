        "name": "Select photo and instructions",
        "imports": [],
        "source": "export default function cocktailPhoto({ body }) {\n  const drink = Array.isArray(body?.drinks) && body.drinks[0];\n  const photo = drink?.strDrinkThumb;\n  const parts =\n    typeof photo === \"string\" &&\n    /^https?:\\/\\/(\\[[0-9a-f:.]+\\]|[^\\s/\\\\?#@:%\\[\\]<>\"`]+)(?::(\\d{1,5}))?(?:[/?#][^\\s\\\\]*)?$/i.exec(\n      photo,\n    );\n  if (!parts || /[\\u0000-\\u0020\\u007f]/.test(photo) || (parts[2] && Number(parts[2]) > 65535))\n    throw new Error(\"TheCocktailDB returned no usable HTTP(S) photo URL\");\n  const caption = drink.strInstructions ?? null;\n  if (caption !== null && typeof caption !== \"string\")\n    throw new Error(\"TheCocktailDB instructions must be text or absent\");\n  if (caption !== null && caption.length > 1024)\n    throw new Error(\"The cocktail instructions exceed the Telegram Action caption limit\");\n  return { photo, caption };\n}\n"
      }
