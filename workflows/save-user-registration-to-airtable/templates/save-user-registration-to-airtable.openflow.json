    "modules": {
      "n_ab315d4c7a50f42b": {
        "name": "Prepare registration",
        "imports": [],
        "source": "export default function main({ body, submitted }) {\n  if (\n    !body ||\n    typeof body.Name !== \"string\" ||\n    !body.Name.trim() ||\n    typeof body.Age !== \"number\" ||\n    !Number.isFinite(body.Age) ||\n    typeof body.email !== \"string\" ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email) ||\n    ![\"Yes\", \"No\"].includes(body[\"You have Subscription ?\"]) ||\n    (body.address != null && typeof body.address !== \"string\")\n  )\n    throw Error(\"Provide name, numeric age, email and Yes/No subscription\");\n  const date = submitted ?? new Date().toISOString();\n  if (typeof date !== \"string\" || !date) throw Error(\"Missing submission time\");\n  const fields = {\n    Name: body.Name,\n    Age: String(body.Age),\n    Email: body.email,\n    Address: body.address ?? \"\",\n    Subscription: body[\"You have Subscription ?\"],\n    Submitted: date,\n  };\n  return { fields, records: [{ fields }] };\n}\n"
      },
      "n_68117d83a5419ac4": {
        "name": "Confirm registration",
        "imports": [],
        "source": "export default function main({ records, fields }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id\n  )\n    throw Error(\"Airtable did not confirm the new record\");\n  for (const [key, value] of Object.entries(fields)) {\n    const actual = records[0].fields?.[key];\n    if (value === \"\" && (actual === undefined || actual === \"\")) continue;\n    if (actual !== value) throw Error(\"Airtable record differs from submission\");\n  }\n  return { id: records[0].id };\n}\n"
      }
    }
