    {
      "id": "save-user-registration-to-airtable-prepare",
      "name": "Prepare registration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function main({ body, submitted }) {\n  if (\n    !body ||\n    typeof body.Name !== \"string\" ||\n    !body.Name.trim() ||\n    typeof body.Age !== \"number\" ||\n    !Number.isFinite(body.Age) ||\n    typeof body.email !== \"string\" ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email) ||\n    ![\"Yes\", \"No\"].includes(body[\"You have Subscription ?\"]) ||\n    (body.address != null && typeof body.address !== \"string\")\n  )\n    throw Error(\"Provide name, numeric age, email and Yes/No subscription\");\n  const date = submitted ?? new Date().toISOString();\n  if (typeof date !== \"string\" || !date) throw Error(\"Missing submission time\");\n  const fields = {\n    Name: body.Name,\n    Age: String(body.Age),\n    Email: body.email,\n    Address: body.address ?? \"\",\n    Subscription: body[\"You have Subscription ?\"],\n    Submitted: date,\n  };\n  return { fields, records: [{ fields }] };\n}\n\nreturn { json: main({ body: $json, submitted: $json.submittedAt }) };\n"
      }
    },
