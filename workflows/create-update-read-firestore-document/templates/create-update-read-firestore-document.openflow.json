    "modules": {
      "n_e2a6e50ee52fdceb": {
        "name": "Prepare the document",
        "imports": [],
        "source": "export default function prepare({project,collection}){if(!/^[a-z][a-z0-9-]{4,28}[a-z0-9]$/.test(project)||!collection||collection.includes('/'))throw Error('Enter a valid project ID and a single collection ID');return{url:`https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents/${encodeURIComponent(collection)}`,body:{fields:{id:{integerValue:1},name:{stringValue:'n8n'}}}}}\n"
      },
      "n_ce890186930c7000": {
        "name": "Prepare the update",
        "imports": [],
        "source": "export default function prepare({project,collection,created}){const prefix=`projects/${project}/databases/(default)/documents/${collection}/`;if(typeof created.name!=='string'||!created.name.startsWith(prefix)||!created.name.slice(prefix.length)||created.name.slice(prefix.length).includes('/'))throw Error('Create response lacks a matching document name; inspect Firestore before retrying');return{doc:created.name,id:created.name.slice(prefix.length),url:`https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents:batchWrite`,body:{writes:[{update:{name:created.name,fields:{name:{stringValue:'nodemation'}}},updateMask:{fieldPaths:['name']}}]}}}\n"
      },
      "n_c78839fc0735130c": {
        "name": "Confirm and prepare read",
        "imports": [],
        "source": "export default function prepare({project,doc,result}){if(!Array.isArray(result.status)||result.status.length!==1||!result.status[0]||typeof result.status[0]!=='object'||(result.status[0].code??0)!==0||!Array.isArray(result.writeResults)||result.writeResults.length!==1)throw Error('Update did not return a confirmed successful write; inspect Firestore before retrying');return{url:`https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents:batchGet`,body:{documents:[doc]}}}\n"
      },
      "n_cc20b876ba0cdfb4": {
        "name": "Return the document",
        "imports": [],
        "source": "export default function result({response}){if(!Array.isArray(response)||response.length!==1||!response[0].found)throw Error('Created document was not returned');const d=response[0].found;return{document:{_name:d.name,_id:d.name.split('/').pop(),_createTime:d.createTime,_updateTime:d.updateTime,id:d.fields?.id?.integerValue,name:d.fields?.name?.stringValue}}}\n"
      }
    }
