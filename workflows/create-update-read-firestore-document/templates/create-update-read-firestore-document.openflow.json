    "modules": {
      "n_e2a6e50ee52fdceb": {
        "name": "Prepare the document",
        "imports": [],
        "source": "export default function prepare({ project, collection }) {\n  if (!/^[a-z][a-z0-9-]{4,28}[a-z0-9]$/.test(project) || !collection || collection.includes(\"/\"))\n    throw Error(\"Enter a valid project ID and a single collection ID\");\n  return {\n    url: `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents/${encodeURIComponent(collection)}`,\n    body: { fields: { id: { integerValue: 1 }, name: { stringValue: \"n8n\" } } },\n  };\n}\n"
      },
      "n_ce890186930c7000": {
        "name": "Prepare the update",
        "imports": [],
        "source": "export default function prepare({ project, collection, created }) {\n  const prefix = `projects/${project}/databases/(default)/documents/${collection}/`;\n  if (\n    typeof created.name !== \"string\" ||\n    !created.name.startsWith(prefix) ||\n    !created.name.slice(prefix.length) ||\n    created.name.slice(prefix.length).includes(\"/\")\n  )\n    throw Error(\n      \"Create response lacks a matching document name; inspect Firestore before retrying\",\n    );\n  return {\n    doc: created.name,\n    id: created.name.slice(prefix.length),\n    url: `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents:batchWrite`,\n    body: {\n      writes: [\n        {\n          update: { name: created.name, fields: { name: { stringValue: \"nodemation\" } } },\n          updateMask: { fieldPaths: [\"name\"] },\n        },\n      ],\n    },\n  };\n}\n"
      },
      "n_c78839fc0735130c": {
        "name": "Confirm and prepare read",
        "imports": [],
        "source": "export default function prepare({ project, doc, result }) {\n  if (\n    !Array.isArray(result.status) ||\n    result.status.length !== 1 ||\n    !result.status[0] ||\n    typeof result.status[0] !== \"object\" ||\n    (result.status[0].code ?? 0) !== 0 ||\n    !Array.isArray(result.writeResults) ||\n    result.writeResults.length !== 1\n  )\n    throw Error(\n      \"Update did not return a confirmed successful write; inspect Firestore before retrying\",\n    );\n  return {\n    url: `https://firestore.googleapis.com/v1/projects/${encodeURIComponent(project)}/databases/(default)/documents:batchGet`,\n    body: { documents: [doc] },\n  };\n}\n"
      },
      "n_cc20b876ba0cdfb4": {
        "name": "Return the document",
        "imports": [],
        "source": "export default function result({ response }) {\n  if (!Array.isArray(response) || response.length !== 1 || !response[0].found)\n    throw Error(\"Created document was not returned\");\n  const d = response[0].found;\n  return {\n    document: {\n      _name: d.name,\n      _id: d.name.split(\"/\").pop(),\n      _createTime: d.createTime,\n      _updateTime: d.updateTime,\n      id: d.fields?.id?.integerValue,\n      name: d.fields?.name?.stringValue,\n    },\n  };\n}\n"
      }
    }
  },
