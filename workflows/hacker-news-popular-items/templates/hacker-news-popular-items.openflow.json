    "modules": {
      "n_7e339df7807ae34f": {
        "name": "Build JSON snapshot",
        "imports": [],
        "source": "export default function hackerNewsSnapshot({ body, statusCode, bodyEncoding = null }) {\n  if (statusCode !== 200) throw new Error('Hacker News search did not return HTTP 200.');\n  if (bodyEncoding !== null) throw new Error('Expected a JSON search response.');\n  if (!body || typeof body !== 'object' || Array.isArray(body) || !Array.isArray(body.hits)) throw new Error('The search response must contain a hits array.');\n  if (body.hits.length > 50) throw new Error('The search returned more than the requested fifty items.');\n  const text = (value, name) => {\n    if (value === null || value === undefined) return null;\n    if (typeof value !== 'string') throw new Error('Invalid ' + name + ' in search result.');\n    return value;\n  };\n  const items = body.hits.map(hit => {\n    if (!hit || typeof hit !== 'object' || Array.isArray(hit)) throw new Error('Invalid search item.');\n    if (hit.points !== null && hit.points !== undefined && (typeof hit.points !== 'number' || !Number.isFinite(hit.points))) throw new Error('Invalid points in search result.');\n    return { title: text(hit.title, 'title'), points: hit.points ?? null, url: text(hit.url, 'url'), created_at: text(hit.created_at, 'created_at'), author: text(hit.author, 'author') };\n  });\n  return { response: JSON.stringify(items), count: items.length };\n}\n"
      }
    }
