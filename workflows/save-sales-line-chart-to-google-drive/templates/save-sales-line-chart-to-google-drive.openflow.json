    "modules": {
      "n_490102278791cc8b": {
        "name": "Set chart data",
        "imports": [],
        "source": "export default function chart({ labels, salesData }) {\n  if (!Array.isArray(labels) || !Array.isArray(salesData) || labels.length !== salesData.length)\n    throw Error(\"Labels and values must have matching lengths\");\n  return {\n    chart: { type: \"line\", data: { labels, datasets: [{ label: \"Sales\", data: salesData }] } },\n  };\n}\n"
      },
      "n_66ea9259444d8714": {
        "name": "Download chart image",
        "imports": [],
        "source": "import { Buffer } from \"node:buffer\";\nexport default async function download({ url }, context) {\n  const response = await context.fetch(url, { method: \"GET\" });\n  if (!response.ok) throw Error(\"Chart download failed\");\n  const bytes = Buffer.from(await response.arrayBuffer());\n  if (!bytes.length) throw Error(\"Chart image is empty\");\n  return { contentBase64: bytes.toString(\"base64\") };\n}\n"
      }
    }
