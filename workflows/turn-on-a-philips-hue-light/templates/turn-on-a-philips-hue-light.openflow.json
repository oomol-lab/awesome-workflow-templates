    "modules": {
      "n_7c6a214a6a321a18": {
        "name": "Prepare the light state",
        "imports": [],
        "source": "export default function body({ brightness }) {\n  if (!Number.isInteger(brightness) || brightness < 1 || brightness > 254)\n    throw Error(\"Brightness must be an integer from 1 to 254\");\n  return { body: { on: true, bri: brightness } };\n}\n"
      },
      "n_078ef5e5665e5f85": {
        "name": "Confirm the light state",
        "imports": [],
        "source": "export default function confirm({ body, brightness }) {\n  if (!Array.isArray(body) || !body.length) throw Error(\"Hue Bridge returned an invalid response\");\n  let onId, briId;\n  for (const entry of body) {\n    if (!entry || typeof entry !== \"object\" || entry.error)\n      throw Error(\"Hue Bridge did not confirm the command\");\n    const s = entry.success;\n    if (!s || typeof s !== \"object\") throw Error(\"Hue Bridge returned an invalid response\");\n    for (const [path, v] of Object.entries(s)) {\n      let m = /^\\/lights\\/(\\d+)\\/state\\/(on|bri)$/.exec(path);\n      if (!m) continue;\n      if (m[2] === \"on\" && v === true) onId = m[1];\n      if (m[2] === \"bri\" && v === brightness) briId = m[1];\n    }\n  }\n  if (!onId || onId !== briId)\n    throw Error(\"Hue Bridge did not confirm power and brightness on the same light\");\n  return { lightId: onId, brightness };\n}\n"
      }
    }
  },
