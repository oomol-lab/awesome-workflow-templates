    "modules": {
      "n_93f0229f8391a2cd": {
        "name": "Prepare customer fields",
        "imports": [],
        "source": "export default function wooCommerceMauticFields({ customer }) {\n  if (customer == null || typeof customer !== \"object\" || Array.isArray(customer))\n    throw new Error(\"Expected a WooCommerce customer object\");\n  const email = typeof customer.email === \"string\" ? customer.email.trim() : \"\";\n  if (!/^[^\\s@:\"\\\\]+@[^\\s@:\"\\\\]+$/.test(email) || email.length > 254)\n    throw new Error(\"Customer email is missing or invalid\");\n  const text = (value, field) => {\n    if (value == null) return \"\";\n    if (typeof value !== \"string\") throw new Error(\"Customer \" + field + \" must be text\");\n    return value;\n  };\n  const firstname = text(customer.first_name, \"first name\"),\n    lastname = text(customer.last_name, \"last name\"),\n    company = text(customer.billing?.company, \"billing company\");\n  return {\n    search: email,\n    email,\n    createFields: { email, firstname, lastname, company, position: \"\", title: \"\" },\n    updateFields: { firstname, lastname },\n  };\n}\n"
      },
      "n_5fc5fb52218a6cdd": {
        "name": "Confirm one exact email match",
        "imports": [],
        "source": "export default function mauticCustomerMatch({ contacts, email }) {\n  if (!Array.isArray(contacts)) throw new Error(\"Mautic contact search did not return an array\");\n  if (contacts.length >= 30)\n    throw new Error(\n      \"Mautic search filled the 30-contact source window; narrow the data before retrying\",\n    );\n  const matches = contacts.filter(\n    (contact) =>\n      typeof contact?.fields?.all?.email === \"string\" &&\n      contact.fields.all.email.trim().toLowerCase() === email.toLowerCase(),\n  );\n  if (matches.length > 1) throw new Error(\"More than one Mautic contact has the customer email\");\n  if (matches.length === 0 && contacts.length > 0)\n    throw new Error(\"Mautic search returned contacts without an exact customer email match\");\n  const matched = matches[0] ?? null;\n  if (matched != null && (!Number.isSafeInteger(matched.id) || matched.id <= 0))\n    throw new Error(\"Matched Mautic contact ID is invalid\");\n  return { create: matched == null, matched };\n}\n"
      },
      "n_ade96d893b2403dd": {
        "name": "Select the existing contact ID",
        "imports": [],
        "source": "export default function mauticCustomerUpdate({ matched, fields }) {\n  if (!Number.isSafeInteger(matched?.id) || matched.id <= 0)\n    throw new Error(\"A matched Mautic contact is required for an update\");\n  return { contactId: matched.id, fields };\n}\n"
      },
      "n_fb362beda04783f0": {
        "name": "Check the saved contact ID",
        "imports": [],
        "source": "export default function mauticContactSaved({ contact }) {\n  if (\n    !contact ||\n    typeof contact !== \"object\" ||\n    Array.isArray(contact) ||\n    !Number.isInteger(contact.id) ||\n    contact.id <= 0\n  ) {\n    throw new Error(\"Mautic did not return a saved contact ID\");\n  }\n  return { contact };\n}\n"
      }
    }
  },
