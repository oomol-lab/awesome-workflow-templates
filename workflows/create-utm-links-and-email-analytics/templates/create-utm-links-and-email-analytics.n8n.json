              "type": "string",
              "value": "display"
            },
            {
              "id": "field-3",
              "name": "campaign",
              "type": "string",
              "value": "YOUR_CAMPAIGN"
            },
            {
              "id": "field-4",
              "name": "term",
              "type": "string",
              "value": ""
            },
            {
              "id": "field-5",
              "name": "campaignId",
              "type": "string",
              "value": ""
            },
            {
              "id": "field-6",
              "name": "requestId",
