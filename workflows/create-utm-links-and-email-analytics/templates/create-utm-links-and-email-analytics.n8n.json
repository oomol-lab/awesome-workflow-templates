        "jsCode": "if ($json.status === \"pending\") throw Error(\"Inspect pending Airtable record\");\nif ($json.status && $json.status !== \"done\") throw Error(\"Invalid checkpoint\");\nreturn { json: { create: $json.status !== \"done\" }, pairedItem: { item: $itemIndex } };\n"
