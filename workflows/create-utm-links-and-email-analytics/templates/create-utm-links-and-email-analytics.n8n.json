    {
      "name": "Configure report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const propertyId = \"YOUR_PROPERTY_ID\",\n  recipient = \"YOUR_REPORT_EMAIL\";\nif (!propertyId || propertyId.includes(\"YOUR_\") || !recipient || recipient.includes(\"YOUR_\"))\n  throw Error(\"Configure property and recipient\");\nreturn { json: { propertyId, recipient }, pairedItem: { item: $itemIndex } };\n"
      },
