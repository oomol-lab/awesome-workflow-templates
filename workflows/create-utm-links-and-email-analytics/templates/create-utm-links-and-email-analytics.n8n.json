      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "field-0",
              "name": "website",
              "type": "string",
              "value": "https://example.com/"
            },
            {
              "id": "field-1",
              "name": "source",
              "type": "string",
              "value": "google"
            },
            {
              "id": "field-2",
