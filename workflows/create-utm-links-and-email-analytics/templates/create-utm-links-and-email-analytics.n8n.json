    {
      "name": "Build campaign URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json;\nif (\n  !x.requestId ||\n  x.requestId.includes(\"YOUR_\") ||\n  !x.source ||\n  !x.medium ||\n  !x.campaign ||\n  x.campaign.includes(\"YOUR_\")\n)\n  throw Error(\"Configure campaign and request ID\");\nif (!new RegExp(\"^https?://[^/?# ]+\", \"i\").test(x.website)) throw Error(\"Enter HTTP URL\");\nconst [before, ...hash] = x.website.split(\"#\"),\n  [path, ...query] = before.split(\"?\"),\n  pairs = query\n    .join(\"?\")\n    .split(\"&\")\n    .filter(Boolean)\n    .filter(\n      (p) =>\n        ![\"utm_source\", \"utm_medium\", \"utm_campaign\", \"utm_term\", \"utm_content\"].includes(\n          decodeURIComponent(p.split(\"=\")[0].split(\"+\").join(\" \")),\n        ),\n    );\nfor (const [k, v] of Object.entries({\n  utm_source: x.source,\n  utm_medium: x.medium,\n  utm_campaign: x.campaign,\n  utm_term: x.term,\n  utm_content: x.campaignId,\n}))\n  pairs.push(encodeURIComponent(k) + \"=\" + encodeURIComponent(v));\nconst url = path + \"?\" + pairs.join(\"&\") + (hash.length ? \"#\" + hash.join(\"#\") : \"\");\nreturn { json: { url, key: \"utm:\" + x.requestId }, pairedItem: { item: $itemIndex } };\n"
      },
      "id": "utm-ga-2",
      "position": [
        440,
        0
      ]
    },
