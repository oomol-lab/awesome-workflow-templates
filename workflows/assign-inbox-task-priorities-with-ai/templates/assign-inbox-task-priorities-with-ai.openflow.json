    "modules": {
      "n_4aed47b0b460418d": {
        "name": "Read Inbox tasks",
        "imports": [],
        "source": "export default async function collect({ projectId, previous }, context) {\n  if (!projectId || projectId.startsWith(\"YOUR_\")) throw Error(\"Configure the Todoist project ID\");\n  const s = previous ?? { tasks: [], cursor: null, seen: [] };\n  const page = await context.actions.call(\"todoist.list_tasks\", {\n    projectId,\n    limit: 200,\n    ...(s.cursor ? { cursor: s.cursor } : {}),\n  });\n  if (!Array.isArray(page.tasks)) throw Error(\"Invalid Todoist task page\");\n  const cursor = page.nextCursor;\n  if (cursor !== null && (typeof cursor !== \"string\" || !cursor || s.seen.includes(cursor)))\n    throw Error(\"Invalid or repeated Todoist cursor\");\n  const state = {\n    tasks: [...s.tasks, ...page.tasks],\n    cursor,\n    seen: cursor ? [...s.seen, cursor] : s.seen,\n  };\n  return { state, more: cursor !== null, projectId };\n}\n"
      },
      "n_cff59d35baa59a9e": {
        "name": "Select the next top-level task",
        "imports": [],
        "source": "export default function next({ collection, mapping, previous }) {\n  const tasks = collection?.tasks;\n  if (!Array.isArray(tasks) || !mapping || typeof mapping !== \"object\" || Array.isArray(mapping))\n    throw Error(\"Invalid tasks or category map\");\n  const entries = Object.entries(mapping);\n  if (!entries.length || entries.some(([k, v]) => !k || !Number.isInteger(v) || v < 1 || v > 4))\n    throw Error(\"Map categories to priorities from 1 to 4\");\n  const active = tasks.filter((x) => x && (x.parent_id == null || x.parent_id === \"\"));\n  for (const t of active)\n    if (typeof t.id !== \"string\" || !t.id || typeof t.content !== \"string\" || !t.content)\n      throw Error(\"Invalid task\");\n  const index = previous?.index ?? 0;\n  if (!Number.isInteger(index) || index < 0 || index > active.length)\n    throw Error(\"Invalid position\");\n  const task = active[index];\n  return {\n    mapping,\n    state: { index: index + 1 },\n    more: index < active.length,\n    taskId: task?.id ?? \"unused\",\n    content: task?.content ?? \"No task\",\n    categories: entries.map(([k]) => k).join(\"\\n\"),\n  };\n}\n"
      },
      "n_0053d18ca9257c40": {
        "name": "Match category to priority",
        "imports": [],
        "source": "export default function match({ category, mapping, taskId }) {\n  if (typeof category !== \"string\" || !mapping || typeof mapping !== \"object\")\n    throw Error(\"Invalid classifier result\");\n  const key = category.trim();\n  const matched = Object.hasOwn(mapping, key);\n  const priority = matched ? mapping[key] : 1;\n  if (matched && (!Number.isInteger(priority) || priority < 1 || priority > 4))\n    throw Error(\"Invalid priority\");\n  return { matched, priority, taskId };\n}\n"
      },
      "n_58be67f795ccdb78": {
        "name": "Update task priority",
        "imports": [],
        "source": "export default async function update({ taskId, priority }, context) {\n  if (\n    typeof taskId !== \"string\" ||\n    !taskId ||\n    !Number.isInteger(priority) ||\n    priority < 1 ||\n    priority > 4\n  )\n    throw Error(\"Invalid update\");\n  const response = await context.actions.call(\"todoist.update_task\", { taskId, priority });\n  if (\n    !response ||\n    !response.task ||\n    response.task.id !== taskId ||\n    response.task.priority !== priority\n  )\n    throw Error(\"Task update not confirmed\");\n  return { ok: true };\n}\n"
      }
    }
