    "modules": {
      "n_ea45e95d6caa1ff9": {
        "name": "Select and format Show HN stories",
        "imports": [],
        "source": "export default function main({data,statusCode}) {\n  if(statusCode<200||statusCode>=300||!Array.isArray(data?.stories)||data.stories.length===0)throw Error('Hacker News page did not return a story list');\n  const chosen=[];\n  for(const story of data.stories){\n    if(typeof story?.title!=='string'||typeof story.rank!=='string'||typeof story.url!=='string'||!story.url)throw Error('Incomplete story in page');\n    if(!story.title.includes('Show HN:'))continue;\n    const url=story.url.startsWith('item?id=')?'https://news.ycombinator.com/'+story.url:story.url;\n    if(!/^https?:\\/\\//i.test(url))throw Error('Unsupported story URL');\n    chosen.push(`${story.rank} ${story.title}\\n${url}`);\n  }\n  return {hasStories:chosen.length>0,text:'Currently trending \"Show HN\":\\n\\n'+chosen.join('\\n\\n')+'\\n'};\n}\n"
      },
      "n_7ed8fd0c0eba3e94": {
        "name": "Confirm SMTP acceptance",
        "imports": [],
        "source": "export default function confirmEmail({accepted,rejected,response}){if(!Array.isArray(accepted)||!accepted.length||!Array.isArray(rejected)||rejected.length||typeof response!=='string')throw Error('Email was not accepted by SMTP');return {};}\n"
      }
