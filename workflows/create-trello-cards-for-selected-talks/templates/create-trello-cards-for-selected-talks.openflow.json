    "modules": {
      "n_2fe22347b2e5e304": {
        "name": "Read selected proposals",
        "imports": [],
        "source": "export default async function({baseId,table,previousState},ctx){const s=previousState??{records:[],offset:'',seen:[]};if(!baseId||!table||baseId.startsWith('YOUR_')||table.startsWith('YOUR_'))throw Error('Configure the Airtable base and table');const q={baseId,tableIdOrName:table,filterByFormula:'{Total Score} > 15'};if(s.offset)q.offset=s.offset;const r=await ctx.actions.call('airtable.list_records',q);if(!Array.isArray(r?.records))throw Error('Invalid Airtable page');const next=r.offset??'';if(typeof next!=='string'||(next&&s.seen.includes(next)))throw Error('Invalid Airtable offset');const state={records:[...s.records,...r.records],offset:next,seen:next?[...s.seen,next]:s.seen};return {state,more:!!next,records:state.records}}\n"
      },
      "n_debaaac8e087d3a1": {
        "name": "Validate proposals",
        "imports": [],
        "source": "export default function({records}){const keys=[\"What's the title of your talk?\",\"Please share the abstract of your talk.\",\"Please share a URL of your profile picture.\",\"Your twitter handle\",\"Great, can we get your full name?\",\"Please share a bit of information about you.\",\"And what's your email address?\"];for(const r of records)if(!r?.fields||keys.some(k=>typeof r.fields[k]!=='string'))throw Error('Provide all proposal fields as text');return {records}}\n"
      },
      "n_9e7b0ba74bf9ff26": {
        "name": "Prepare next proposal",
        "imports": [],
        "source": "export default function({records,previousState}){const state=previousState??{index:0,images:[]};if(!Array.isArray(records)||!Array.isArray(state.images)||state.index>records.length)throw Error('Invalid state');if(state.index===records.length)return {state,more:false,fields:{},images:state.images};const f=records[state.index]?.fields;if(!f||typeof f!== 'object')throw Error('Missing proposal fields');return {state,more:true,fields:f,images:state.images}}\n"
      },
      "n_52615a75bd2372ee": {
        "name": "Render proposal image",
        "imports": [],
        "source": "export default async function({fields,template},ctx){const keys=[\"What's the title of your talk?\",\"Please share the abstract of your talk.\",\"Please share a URL of your profile picture.\",\"Your twitter handle\",\"Great, can we get your full name?\",\"Please share a bit of information about you.\",\"And what's your email address?\"];if(!template||template.startsWith('YOUR_')||keys.some(k=>typeof fields[k]!=='string'))throw Error('Configure template and provide the proposal fields as text');const modifications=keys.slice(0,5).map((k,i)=>({name:['talk title','abstract','profile image','username','full name'][i],...(fields[k]===''?{}:{[i===2?'image_url':'text']:fields[k]})}));const r=await ctx.actions.call('bannerbear.create_image_sync',{template,modifications});if(r?.image?.status!=='completed'||!r.image.uid||!r.image.image_url)throw Error('Image did not complete');return {imageUrl:r.image.image_url}}\n"
      },
      "n_b6c204df37270a53": {
        "name": "Remember image",
        "imports": [],
        "source": "export default function({state,imageUrl}){return {state:{index:state.index+1,images:[...state.images,imageUrl]}}}\n"
      },
      "n_9ffefdab3a8735bd": {
        "name": "Prepare next card",
        "imports": [],
        "source": "export default function({records,images,listId,previousState}){const state=previousState??{index:0};if(!listId||listId.startsWith('YOUR_')||records.length!==images.length)throw Error('Configure the list and check images');if(state.index===records.length)return {state,more:false,body:{},count:state.index};const f=records[state.index].fields,description=`Abstract: ${f['Please share the abstract of your talk.']}\\n\\nName: ${f['Great, can we get your full name?']}\\nBio: ${f['Please share a bit of information about you.']}\\nEmail: ${f[\"And what's your email address?\"]}\\nTwitter: ${f['Your twitter handle']}`;return {state,more:true,body:{idList:listId,name:f[\"What's the title of your talk?\"],desc:description,urlSource:images[state.index]},count:state.index}}\n"
      },
      "n_ecc6691421f11606": {
        "name": "Confirm card",
        "imports": [],
        "source": "export default function({state,statusCode,body}){if(statusCode<200||statusCode>=300||!body||typeof body!=='object'||!body.id)throw Error('Card creation not confirmed');return {state:{index:state.index+1}}}\n"
      }
    }
  },
  "presentation": {
