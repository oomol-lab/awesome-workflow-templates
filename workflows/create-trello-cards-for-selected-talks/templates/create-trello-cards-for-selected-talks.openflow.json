    "modules": {
      "n_2fe22347b2e5e304": {
        "name": "Read selected proposals",
        "imports": [],
        "source": "export default async function ({ baseId, table, previousState }, ctx) {\n  const s = previousState ?? { records: [], offset: \"\", seen: [] };\n  if (!baseId || !table || baseId.startsWith(\"YOUR_\") || table.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the Airtable base and table\");\n  const q = { baseId, tableIdOrName: table, filterByFormula: \"{Total Score} > 15\" };\n  if (s.offset) q.offset = s.offset;\n  const r = await ctx.actions.call(\"airtable.list_records\", q);\n  if (!Array.isArray(r?.records)) throw Error(\"Invalid Airtable page\");\n  const next = r.offset ?? \"\";\n  if (typeof next !== \"string\" || (next && s.seen.includes(next)))\n    throw Error(\"Invalid Airtable offset\");\n  const state = {\n    records: [...s.records, ...r.records],\n    offset: next,\n    seen: next ? [...s.seen, next] : s.seen,\n  };\n  return { state, more: !!next, records: state.records };\n}\n"
      },
      "n_debaaac8e087d3a1": {
        "name": "Validate proposals",
        "imports": [],
        "source": "export default function ({ records }) {\n  const keys = [\n    \"What's the title of your talk?\",\n    \"Please share the abstract of your talk.\",\n    \"Please share a URL of your profile picture.\",\n    \"Your twitter handle\",\n    \"Great, can we get your full name?\",\n    \"Please share a bit of information about you.\",\n    \"And what's your email address?\",\n  ];\n  for (const r of records)\n    if (!r?.fields || keys.some((k) => typeof r.fields[k] !== \"string\"))\n      throw Error(\"Provide all proposal fields as text\");\n  return { records };\n}\n"
      },
      "n_9e7b0ba74bf9ff26": {
        "name": "Prepare next proposal",
        "imports": [],
        "source": "export default function ({ records, previousState }) {\n  const state = previousState ?? { index: 0, images: [] };\n  if (!Array.isArray(records) || !Array.isArray(state.images) || state.index > records.length)\n    throw Error(\"Invalid state\");\n  if (state.index === records.length)\n    return { state, more: false, fields: {}, images: state.images };\n  const f = records[state.index]?.fields;\n  if (!f || typeof f !== \"object\") throw Error(\"Missing proposal fields\");\n  return { state, more: true, fields: f, images: state.images };\n}\n"
      },
      "n_52615a75bd2372ee": {
        "name": "Render proposal image",
        "imports": [],
        "source": "export default async function ({ fields, template }, ctx) {\n  const keys = [\n    \"What's the title of your talk?\",\n    \"Please share the abstract of your talk.\",\n    \"Please share a URL of your profile picture.\",\n    \"Your twitter handle\",\n    \"Great, can we get your full name?\",\n    \"Please share a bit of information about you.\",\n    \"And what's your email address?\",\n  ];\n  if (!template || template.startsWith(\"YOUR_\") || keys.some((k) => typeof fields[k] !== \"string\"))\n    throw Error(\"Configure template and provide the proposal fields as text\");\n  const modifications = keys.slice(0, 5).map((k, i) => ({\n    name: [\"talk title\", \"abstract\", \"profile image\", \"username\", \"full name\"][i],\n    ...(fields[k] === \"\" ? {} : { [i === 2 ? \"image_url\" : \"text\"]: fields[k] }),\n  }));\n  const r = await ctx.actions.call(\"bannerbear.create_image_sync\", { template, modifications });\n  if (r?.image?.status !== \"completed\" || !r.image.uid || !r.image.image_url)\n    throw Error(\"Image did not complete\");\n  return { imageUrl: r.image.image_url };\n}\n"
      },
      "n_b6c204df37270a53": {
        "name": "Remember image",
        "imports": [],
        "source": "export default function ({ state, imageUrl }) {\n  return { state: { index: state.index + 1, images: [...state.images, imageUrl] } };\n}\n"
      },
      "n_9ffefdab3a8735bd": {
        "name": "Prepare next card",
        "imports": [],
        "source": "export default function ({ records, images, listId, previousState }) {\n  const state = previousState ?? { index: 0 };\n  if (!listId || listId.startsWith(\"YOUR_\") || records.length !== images.length)\n    throw Error(\"Configure the list and check images\");\n  if (state.index === records.length) return { state, more: false, body: {}, count: state.index };\n  const f = records[state.index].fields,\n    description = `Abstract: ${f[\"Please share the abstract of your talk.\"]}\\n\\nName: ${f[\"Great, can we get your full name?\"]}\\nBio: ${f[\"Please share a bit of information about you.\"]}\\nEmail: ${f[\"And what's your email address?\"]}\\nTwitter: ${f[\"Your twitter handle\"]}`;\n  return {\n    state,\n    more: true,\n    body: {\n      idList: listId,\n      name: f[\"What's the title of your talk?\"],\n      desc: description,\n      urlSource: images[state.index],\n    },\n    count: state.index,\n  };\n}\n"
      },
      "n_ecc6691421f11606": {
        "name": "Confirm card",
        "imports": [],
        "source": "export default function ({ state, statusCode, body }) {\n  if (statusCode < 200 || statusCode >= 300 || !body || typeof body !== \"object\" || !body.id)\n    throw Error(\"Card creation not confirmed\");\n  return { state: { index: state.index + 1 } };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
