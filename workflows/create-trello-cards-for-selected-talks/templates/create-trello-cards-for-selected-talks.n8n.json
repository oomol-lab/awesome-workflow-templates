{
  "name": "Create Trello Cards for Selected Talks",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        400,
        250
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-trello-cards-for-selected-talks-0"
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        600,
        250
      ],
      "parameters": {
        "table": "YOUR_TABLE_NAME",
        "operation": "list",
        "application": "YOUR_BASE_ID",
        "additionalOptions": {
          "filterByFormula": "{Total Score} > 15"
        },
        "authentication": "airtableTokenApi"
      },
      "typeVersion": 1,
      "id": "create-trello-cards-for-selected-talks-1"
    },
    {
      "name": "Validate proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f=$json.fields,keys=[\"What's the title of your talk?\",\"Please share the abstract of your talk.\",\"Please share a URL of your profile picture.\",\"Your twitter handle\",\"Great, can we get your full name?\",\"Please share a bit of information about you.\",\"And what's your email address?\"];if(!f||keys.some(k=>typeof f[k]!=='string'))throw Error('Provide all proposal fields as text');return {json:$json,pairedItem:{item:$itemIndex}};"
      },
      "id": "create-trello-cards-for-selected-talks-2"
    },
    {
      "name": "Bannerbear",
      "type": "n8n-nodes-base.bannerbear",
      "position": [
        800,
        250
      ],
      "parameters": {
        "templateId": "YOUR_TEMPLATE_UID",
        "modificationsUi": {
          "modificationsValues": [
            {
              "name": "talk title",
              "text": "={{$node[\"Airtable\"].json[\"fields\"][\"What's the title of your talk?\"]}}"
            },
            {
              "name": "abstract",
              "text": "={{$node[\"Airtable\"].json[\"fields\"][\"Please share the abstract of your talk.\"]}}"
            },
            {
              "name": "profile image",
              "imageUrl": "={{$node[\"Airtable\"].json[\"fields\"][\"Please share a URL of your profile picture.\"]}}"
            },
            {
              "name": "username",
              "text": "={{$node[\"Airtable\"].json[\"fields\"][\"Your twitter handle\"]}}"
            },
            {
              "name": "full name",
              "text": "={{$node[\"Airtable\"].json[\"fields\"][\"Great, can we get your full name?\"]}}"
            }
          ]
        },
        "additionalFields": {
          "waitForImage": true
        }
      },
      "typeVersion": 1,
      "id": "create-trello-cards-for-selected-talks-3"
    },
    {
      "name": "Confirm image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if($json.status!=='completed'||!$json.uid||!$json.image_url)throw Error('Image did not complete');return {json:$json,pairedItem:{item:$itemIndex}};"
      },
      "id": "create-trello-cards-for-selected-talks-4"
    },
    {
      "name": "Trello",
      "type": "n8n-nodes-base.trello",
      "position": [
        1000,
        250
      ],
      "parameters": {
        "name": "={{$node[\"Airtable\"].json[\"fields\"][\"What's the title of your talk?\"]}}",
        "listId": "YOUR_LIST_ID",
        "description": "=Abstract: {{$node[\"Airtable\"].json[\"fields\"][\"Please share the abstract of your talk.\"]}}\n\nName: {{$node[\"Airtable\"].json[\"fields\"][\"Great, can we get your full name?\"]}}\nBio: {{$node[\"Airtable\"].json[\"fields\"][\"Please share a bit of information about you.\"]}}\nEmail: {{$node[\"Airtable\"].json[\"fields\"][\"And what's your email address?\"]}}\nTwitter: {{$node[\"Airtable\"].json[\"fields\"][\"Your twitter handle\"]}}",
        "additionalFields": {
          "urlSource": "={{$node[\"Bannerbear\"].json[\"image_url\"]}}"
        }
      },
      "typeVersion": 1,
      "id": "create-trello-cards-for-selected-talks-5"
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable": {
      "main": [
        [
          {
            "node": "Validate proposal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate proposal": {
      "main": [
        [
          {
            "node": "Bannerbear",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bannerbear": {
      "main": [
        [
          {
            "node": "Confirm image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm image": {
      "main": [
        [
          {
            "node": "Trello",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
