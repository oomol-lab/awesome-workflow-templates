      "position": [
        180,
        1270
      ],
      "parameters": {
        "team": "YOUR_CLICKUP_TEAM_ID",
        "events": [
          "taskStatusUpdated"
        ],
        "filters": {}
      },
      "typeVersion": 1,
      "disabled": true
    },
    {
      "id": "sync-notion-and-clickup-tasks-forward-clickup-event",
      "name": "Forward ClickUp event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
