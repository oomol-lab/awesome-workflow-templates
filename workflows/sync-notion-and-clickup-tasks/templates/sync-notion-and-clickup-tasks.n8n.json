{
  "nodes": [
    {
      "id": "sync-notion-and-clickup-tasks-0",
      "name": "On updated database page",
      "type": "n8n-nodes-base.notionTrigger",
      "position": [
        180,
        620
      ],
      "parameters": {
        "event": "pagedUpdatedInDatabase",
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": "YOUR_NOTION_DATABASE_ID"
      },
      "typeVersion": 1
    },
    {
      "id": "sync-notion-and-clickup-tasks-1",
      "name": "Update an existing task",
      "type": "n8n-nodes-base.clickUp",
      "position": [
        400,
        620
      ],
      "parameters": {
        "id": "={{$node[\"On updated database page\"].json[\"ClickUp ID\"]}}",
        "operation": "update",
        "updateFields": {
          "name": "={{$node[\"On updated database page\"].json[\"Task name\"]}}",
          "status": "={{$node[\"On updated database page\"].json[\"Status\"]}}",
          "dueDate": "={{$node[\"On updated database page\"].json[\"Deadline\"][\"start\"]}}"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "sync-notion-and-clickup-tasks-2",
      "name": "On task status updated",
      "type": "n8n-nodes-base.clickUpTrigger",
      "position": [
        180,
        820
      ],
      "parameters": {
        "team": "YOUR_CLICKUP_TEAM_ID",
        "events": [
          "taskStatusUpdated"
        ],
        "filters": {}
      },
      "typeVersion": 1
    },
    {
      "id": "sync-notion-and-clickup-tasks-3",
      "name": "Get database page by ClickUp ID",
      "type": "n8n-nodes-base.notion",
      "position": [
        400,
        820
      ],
      "parameters": {
        "filters": {
          "conditions": [
            {
              "key": "ClickUp ID|rich_text",
              "condition": "equals",
              "richTextValue": "={{$node[\"On task status updated\"].json[\"task_id\"]}}"
            }
          ]
        },
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "returnAll": true,
        "databaseId": "YOUR_NOTION_DATABASE_ID",
        "filterType": "manual"
      },
      "typeVersion": 2
    },
    {
      "id": "sync-notion-and-clickup-tasks-4",
      "name": "Update the status of found database page",
      "type": "n8n-nodes-base.notion",
      "position": [
        620,
        820
      ],
      "parameters": {
        "pageId": "={{$node[\"Get database page by ClickUp ID\"].json[\"id\"]}}",
        "resource": "databasePage",
        "operation": "update",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Status|select",
              "selectValue": "={{$node[\"On task status updated\"].json[\"history_items\"][0][\"after\"][\"status\"]}}"
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "sync-notion-and-clickup-tasks-get",
      "name": "Read ClickUp task",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "position": [
        360,
        1100
      ],
      "parameters": {
        "id": "={{ $json[\"ClickUp ID\"] }}",
        "operation": "get"
      }
    },
    {
      "id": "sync-notion-and-clickup-tasks-compare",
      "name": "Task changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        580,
        1100
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.name !== $(\"On updated database page\").item.json[\"Task name\"] || $json.status?.status !== $(\"On updated database page\").item.json.Status || Number($json.due_date) !== Date.parse($(\"On updated database page\").item.json.Deadline.start) }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "sync-notion-and-clickup-tasks-status",
      "name": "Status changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        580,
        1400
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.property_status }}",
              "operation": "notEqual",
              "value2": "={{ $(\"On task status updated\").item.json.history_items[0].after.status }}"
            }
          ]
        }
      }
    },
    {
      "id": "sync-notion-and-clickup-tasks-notion-trigger-open-flow-",
      "name": "Notion trigger (Open Flow)",
      "type": "n8n-nodes-base.notionTrigger",
      "position": [
        180,
        1070
      ],
      "parameters": {
        "event": "pagedUpdatedInDatabase",
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": "YOUR_NOTION_DATABASE_ID"
      },
      "typeVersion": 1,
      "disabled": true
    },
    {
      "id": "sync-notion-and-clickup-tasks-forward-notion-event",
      "name": "Forward Notion event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1070
      ],
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event:JSON.stringify($json)} }}",
        "options": {}
      }
    },
    {
      "id": "sync-notion-and-clickup-tasks-clickup-trigger-open-flow-",
      "name": "ClickUp trigger (Open Flow)",
