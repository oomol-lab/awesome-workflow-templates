    {
      "id": "qualify-and-approve-appointment-requests-6",
      "name": "Has Accepted?",
      "type": "n8n-nodes-base.if",
      "position": [
        -1500,
        -240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "mode",
              "leftValue": "={{ Array.isArray($json[\"Please select\"]) ? $json[\"Please select\"].includes(\"I accept the terms and conditions\") : $json[\"Please select\"] === \"I accept the terms and conditions\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
