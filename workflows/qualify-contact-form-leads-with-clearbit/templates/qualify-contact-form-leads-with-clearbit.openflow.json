    "modules": {
      "n_e2383846e8a422c2": {
        "name": "Filter personal email",
        "imports": [],
        "source": "export default function filter({ body }) {\n  const email = String(body?.email || \"\").trim();\n  if (!email.includes(\"@\")) throw Error(\"Missing contact email\");\n  const blocked = [\n    \"@gmail.com\",\n    \"@yahoo.com\",\n    \"@outlook.com\",\n    \"@hotmail.com\",\n    \"@icloud.com\",\n    \"@mail.com\",\n    \"@aol.com\",\n    \"@zoho.com\",\n    \"@gmx\",\n  ].some((x) => email.includes(x));\n  return {\n    email,\n    eligible: !blocked,\n    personUrl: \"https://person.clearbit.com/v2/people/find?email=\" + encodeURIComponent(email),\n  };\n}\n"
      },
      "n_5de4439e680d25d7": {
        "name": "Read person and company domain",
        "imports": [],
        "source": "export default function person({ body, statusCode }) {\n  if (statusCode !== 200 || !body?.employment?.domain || !body?.name?.givenName)\n    throw Error(\"Person enrichment missing domain or name\");\n  return {\n    name: body.name.givenName,\n    url:\n      \"https://company.clearbit.com/v2/companies/find?domain=\" +\n      encodeURIComponent(body.employment.domain),\n  };\n}\n"
      },
      "n_8a01b48ae8a7738a": {
        "name": "Check B2B and employee count",
        "imports": [],
        "source": "export default function qualify({ body, statusCode }) {\n  if (\n    statusCode !== 200 ||\n    !Array.isArray(body?.tags) ||\n    typeof body.metrics?.employees !== \"number\"\n  )\n    throw Error(\"Company enrichment missing tags or employees\");\n  return { eligible: body.tags.includes(\"B2B\") && body.metrics.employees > 499 };\n}\n"
      },
      "n_eb29f50b4c0201c4": {
        "name": "Prepare acknowledgment",
        "imports": [],
        "source": "export default async function prepare({ body, email, name, acknowledge, resolution }, ctx) {\n  const submissionId = String(body?.submissionId || ctx.runId || \"\").trim();\n  const key = \"contact:\" + submissionId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { send: false, key, to: email, message: \"\" };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown email delivery \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { send: false, key, to: email, message: \"\" };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    send: true,\n    key,\n    to: email,\n    message: `Hi ${name},\\n\\nthanks so much for contacting us. We'll get back to you soon.\\nBest\\nYour Name`,\n  };\n}\n"
      },
      "n_fba8200df89cb868": {
        "name": "Confirm acknowledgment",
        "imports": [],
        "source": "export default async function f({ key, messageId }, ctx) {\n  if (!messageId) throw Error(\"Unknown email result\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      }
