    {
      "parameters": {
        "jsCode": "const rpc = $input.first().json;\nif (rpc.error) throw new Error(\"MCP transport error: \" + JSON.stringify(rpc.error));\nif (rpc.result && rpc.result.isError)\n  throw new Error(\n    \"MCP tool error: \" +\n      ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || \"unknown\"),\n  );\n// The slot JSON arrives as text inside the MCP tool result.\nconst slot = JSON.parse(rpc.result.content[0].text);\nif (slot.error) throw new Error(\"request_file_upload: \" + slot.error);\nconst trigger = $(\"On form submission\").first();\nconst binKey = Object.keys(trigger.binary || {})[0];\nif (!binKey) throw new Error(\"No file arrived from the form.\");\n// Ready-made JSON-RPC body for the Open PDF node (building it here avoids\n// n8n's expression parser tripping on `}}` inside inline object literals).\nslot.openBody = {\n  jsonrpc: \"2.0\",\n  id: 2,\n  method: \"tools/call\",\n  params: { name: \"open_pdf\", arguments: { upload_token: slot.upload_token } },\n};\nreturn [{ json: slot, binary: { file: trigger.binary[binKey] } }];\n"
      },
