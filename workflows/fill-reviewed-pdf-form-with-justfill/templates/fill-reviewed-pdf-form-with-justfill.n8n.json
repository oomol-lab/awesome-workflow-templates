    {
      "parameters": {
        "jsCode": "const rpc = $input.first().json;\nif (rpc.error) throw new Error(\"MCP transport error: \" + JSON.stringify(rpc.error));\nif (rpc.result && rpc.result.isError)\n  throw new Error(\n    \"MCP tool error: \" +\n      ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || \"unknown\"),\n  );\nconst ws = JSON.parse(rpc.result.content[0].text);\nif (ws.error) throw new Error(\"open_pdf: \" + ws.error);\nif (!Array.isArray(ws.fields) || !ws.summary?.workspace_id)\n  throw new Error(\"open_pdf returned no usable field list or workspace.\");\n\nconst raw = $(\"On form submission\").first().json[\"Data JSON\"];\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch {\n  throw new Error(\"Data JSON must be a JSON object keyed by reviewed PDF field names.\");\n}\nif (!data || Array.isArray(data) || typeof data !== \"object\" || !Object.keys(data).length) {\n  throw new Error(\"Data JSON must be a non-empty object, not a list, null or a scalar.\");\n}\n\n// Exact normalized names only. Keep Unicode; never guess using substrings.\nconst norm = (s) =>\n  String(s ?? \"\")\n    .normalize(\"NFC\")\n    .toLowerCase()\n    .replace(/[^\\p{L}\\p{M}\\p{N}]+/gu, \"\");\nconst values = Object.create(null),\n  unmatched = [],\n  usedIds = new Set();\nfor (const [k, v] of Object.entries(data)) {\n  const nk = norm(k);\n  if (!nk) throw new Error(\"Every JSON key must contain a letter or number.\");\n  if (v !== null && (typeof v === \"object\" || (typeof v === \"number\" && !Number.isFinite(v)))) {\n    throw new Error(\n      \"Field values must be text, finite numbers, booleans or null; nested values are not supported.\",\n    );\n  }\n  const matches = ws.fields.filter((f) => norm(f.name) === nk);\n  if (!matches.length) {\n    unmatched.push(k);\n    continue;\n  }\n  if (matches.length !== 1)\n    throw new Error(\"Ambiguous PDF field name: \" + k + \". Give each field a unique reviewed name.\");\n  const f = matches[0];\n  if (typeof f.id !== \"string\" || !f.id) throw new Error(\"A matched PDF field has no valid ID.\");\n  if (usedIds.has(f.id))\n    throw new Error(\"Two JSON keys map to the same PDF field. Use one key per field.\");\n  usedIds.add(f.id);\n  values[f.id] = v === null ? \"\" : String(v);\n}\nif (unmatched.length) {\n  throw new Error(\n    \"Unmatched JSON keys: \" +\n      unmatched.join(\", \") +\n      \". Rename the keys or review and save the PDF field names; no PDF was filled.\",\n  );\n}\nif (!Object.keys(values).length) throw new Error(\"No data keys matched the template fields.\");\n\nreturn [\n  {\n    json: {\n      workspace_id: ws.summary.workspace_id,\n      source: ws.summary.source,\n      matched: Object.keys(values).length,\n      unmatched,\n      values,\n      fillBody: {\n        jsonrpc: \"2.0\",\n        id: 3,\n        method: \"tools/call\",\n        params: { name: \"fill_pdf\", arguments: { workspace_id: ws.summary.workspace_id, values } },\n      },\n    },\n  },\n];\n"
      },
