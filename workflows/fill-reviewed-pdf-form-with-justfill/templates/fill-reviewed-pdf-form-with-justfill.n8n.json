        "jsCode": "const rpc = $input.first().json;\nif (rpc.error) throw new Error(\"MCP transport error: \" + JSON.stringify(rpc.error));\nif (rpc.result && rpc.result.isError)\n  throw new Error(\n    \"MCP tool error: \" +\n      ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || \"unknown\"),\n  );\nconst out = JSON.parse(rpc.result.content[0].text);\nif (out.error) throw new Error(\"fill_pdf: \" + out.error);\nif (typeof out.download_url !== \"string\" || !/^https:\\/\\//.test(out.download_url))\n  throw Error(\"Missing PDF download URL\");\n// download_url: plain GET, no auth, valid until the workspace expires (~24h).\nreturn [\n  {\n    json: {\n      download_url: out.download_url,\n      output_mode: out.output_mode,\n      filled_fields: out.filled_fields,\n      link_expires_at: out.link_expires_at,\n      warnings: out.warnings || null,\n    },\n  },\n];\n"
