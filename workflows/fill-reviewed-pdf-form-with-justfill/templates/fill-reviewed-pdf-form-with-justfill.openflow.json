    "modules": {
      "n_500206d29873c239": {
        "name": "Map reviewed field names",
        "imports": [],
        "source": "export default function map({ body }) {\n  const { rpc, raw } = body;\n  if (rpc.error) throw new Error(\"MCP transport error: \" + JSON.stringify(rpc.error));\n  if (rpc.result && rpc.result.isError)\n    throw new Error(\n      \"MCP tool error: \" +\n        ((rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text) || \"unknown\"),\n    );\n  const ws = JSON.parse(rpc.result.content[0].text);\n  if (ws.error) throw new Error(\"open_pdf: \" + ws.error);\n  if (!Array.isArray(ws.fields) || !ws.summary?.workspace_id)\n    throw new Error(\"open_pdf returned no usable field list or workspace.\");\n\n  let data;\n  try {\n    data = JSON.parse(raw);\n  } catch {\n    throw new Error(\"Data JSON must be a JSON object keyed by reviewed PDF field names.\");\n  }\n  if (!data || Array.isArray(data) || typeof data !== \"object\" || !Object.keys(data).length) {\n    throw new Error(\"Data JSON must be a non-empty object, not a list, null or a scalar.\");\n  }\n\n  // Exact normalized names only. Keep Unicode; never guess using substrings.\n  const norm = (s) =>\n    String(s ?? \"\")\n      .normalize(\"NFC\")\n      .toLowerCase()\n      .replace(/[^\\p{L}\\p{M}\\p{N}]+/gu, \"\");\n  const values = Object.create(null),\n    unmatched = [],\n    usedIds = new Set();\n  for (const [k, v] of Object.entries(data)) {\n    const nk = norm(k);\n    if (!nk) throw new Error(\"Every JSON key must contain a letter or number.\");\n    if (v !== null && (typeof v === \"object\" || (typeof v === \"number\" && !Number.isFinite(v)))) {\n      throw new Error(\n        \"Field values must be text, finite numbers, booleans or null; nested values are not supported.\",\n      );\n    }\n    const matches = ws.fields.filter((f) => norm(f.name) === nk);\n    if (!matches.length) {\n      unmatched.push(k);\n      continue;\n    }\n    if (matches.length !== 1)\n      throw new Error(\n        \"Ambiguous PDF field name: \" + k + \". Give each field a unique reviewed name.\",\n      );\n    const f = matches[0];\n    if (typeof f.id !== \"string\" || !f.id) throw new Error(\"A matched PDF field has no valid ID.\");\n    if (usedIds.has(f.id))\n      throw new Error(\"Two JSON keys map to the same PDF field. Use one key per field.\");\n    usedIds.add(f.id);\n    values[f.id] = v === null ? \"\" : String(v);\n  }\n  if (unmatched.length) {\n    throw new Error(\n      \"Unmatched JSON keys: \" +\n        unmatched.join(\", \") +\n        \". Rename the keys or review and save the PDF field names; no PDF was filled.\",\n    );\n  }\n  if (!Object.keys(values).length) throw new Error(\"No data keys matched the template fields.\");\n\n  return {\n    fillBody: {\n      jsonrpc: \"2.0\",\n      id: 3,\n      method: \"tools/call\",\n      params: { name: \"fill_pdf\", arguments: { workspace_id: ws.summary.workspace_id, values } },\n    },\n  };\n}\n"
      },
      "n_27943810291fb76d": {
        "name": "Reserve PDF generation",
        "imports": [],
        "source": "export default async function ({ body }, ctx) {\n  const id = String(body?.requestId || \"\").trim();\n  if (!id) throw Error(\"Provide a unique request ID\");\n  const key = \"justfill:\" + id;\n  if (await ctx.state.get(key)) throw Error(\"Inspect existing generation before retry: \" + key);\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key };\n}\n"
      },
      "n_f179c32032ba40b0": {
        "name": "Confirm filled PDF",
        "imports": [],
        "source": "export default async function ({ body, key }, ctx) {\n  let rpc;\n  if (typeof body !== \"string\") throw Error(\"Invalid MCP response\");\n  try {\n    const lines = body\n      .split(/\\r?\\n/)\n      .filter((x) => x.startsWith(\"data:\"))\n      .map((x) => x.slice(5).trim());\n    rpc = JSON.parse(lines.length ? lines.at(-1) : body);\n  } catch {\n    throw Error(\"Invalid MCP response; inspect pending generation\");\n  }\n  if (rpc.error || rpc.result?.isError) throw Error(\"PDF generation failed or uncertain\");\n  let out;\n  try {\n    out = JSON.parse(rpc.result.content[0].text);\n  } catch {\n    throw Error(\"Invalid tool output; inspect pending generation\");\n  }\n  if (out.error || typeof out.download_url !== \"string\" || !/^https:\\/\\//.test(out.download_url))\n    throw Error(\"Missing PDF download URL\");\n  await ctx.state.set(key, { status: \"done\" });\n  return {\n    result: {\n      download_url: out.download_url,\n      output_mode: out.output_mode ?? null,\n      filled_fields: out.filled_fields ?? null,\n      link_expires_at: out.link_expires_at ?? null,\n      warnings: out.warnings ?? null,\n    },\n  };\n}\n"
      }
    }
