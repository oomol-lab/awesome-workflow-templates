    "modules": {
      "n_050c5bace63afcb8": {
        "name": "Read Inbox tasks",
        "imports": [],
        "source": "export default async function collect({projectId,previous},context){\n if(!projectId||projectId.startsWith('YOUR_'))throw Error('Configure the Todoist project ID');\n const s=previous??{tasks:[],cursor:null,seen:[]};\n const page=await context.actions.call('todoist.list_tasks',{projectId,limit:200,...(s.cursor?{cursor:s.cursor}:{})});\n if(!Array.isArray(page.tasks))throw Error('Invalid Todoist task page');\n const cursor=page.nextCursor;if(cursor!==null&&(typeof cursor!=='string'||!cursor||s.seen.includes(cursor)))throw Error('Invalid or repeated Todoist cursor');\n const state={tasks:[...s.tasks,...page.tasks],cursor,seen:cursor?[...s.seen,cursor]:s.seen};return {state,more:cursor!==null,projectId};\n}\n"
      },
      "n_06ffc40a23c68a2c": {
        "name": "Select the next top-level task",
        "imports": [],
        "source": "export default function next({collection,mapping,previous}){const tasks=collection?.tasks;if(!Array.isArray(tasks)||!mapping||typeof mapping!=='object'||Array.isArray(mapping))throw Error('Invalid tasks or category map');const entries=Object.entries(mapping);if(!entries.length||entries.some(([k,v])=>!k||!Number.isInteger(v)||v<1||v>4))throw Error('Map categories to priorities from 1 to 4');const active=tasks.filter(x=>x&&(x.parent_id==null||x.parent_id===''));for(const t of active)if(typeof t.id!=='string'||!t.id||typeof t.content!=='string'||!t.content)throw Error('Invalid task');const index=previous?.index??0;if(!Number.isInteger(index)||index<0||index>active.length)throw Error('Invalid position');const task=active[index];return{mapping,state:{index:index+1},more:index<active.length,taskId:task?.id??'unused',content:task?.content??'No task',categories:entries.map(([k])=>k).join('\\n')}}\n"
      },
      "n_4b3af59cf78aaa24": {
        "name": "Match category to priority",
        "imports": [],
        "source": "export default function match({category,mapping,taskId}){if(typeof category!=='string'||!mapping||typeof mapping!=='object')throw Error('Invalid classifier result');const key=category.trim();const matched=Object.hasOwn(mapping,key);const priority=matched?mapping[key]:1;if(matched&&(!Number.isInteger(priority)||priority<1||priority>4))throw Error('Invalid priority');return{matched,priority,taskId}}\n"
      },
      "n_40773fd757489988": {
        "name": "Update task priority",
        "imports": [],
        "source": "export default async function update({taskId,priority},context){if(typeof taskId!=='string'||!taskId||!Number.isInteger(priority)||priority<1||priority>4)throw Error('Invalid update');const response=await context.actions.call('todoist.update_task',{taskId,priority});if(!response||!response.task||response.task.id!==taskId||response.task.priority!==priority)throw Error('Task update not confirmed');return{ok:true}}\n"
      }
    }
