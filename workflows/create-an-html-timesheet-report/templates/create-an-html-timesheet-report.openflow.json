    "modules": {
      "n_b567b5e4b19a4931": {
        "name": "Build the timesheet report",
        "imports": [],
        "source": "export default function report({ records }) {\n  if (!Array.isArray(records) || !records.length) throw Error(\"Provide timesheet records\");\n  const esc = (x) =>\n    String(x ?? \"\").replace(\n      /[&<>\"']/g,\n      (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n    );\n  const rows = records\n    .map((r) => {\n      if (\n        !r ||\n        typeof r.UserName !== \"string\" ||\n        !r.UserName ||\n        typeof r.TaskTitle !== \"string\" ||\n        !r.TaskTitle ||\n        typeof r.date !== \"string\" ||\n        typeof r.UserAvatar !== \"string\" ||\n        !/^https:\\/\\//i.test(r.UserAvatar) ||\n        !Number.isFinite(Number(r.hours))\n      )\n        throw Error(\"Invalid timesheet record\");\n      return r;\n    })\n    .sort(\n      (a, b) =>\n        a.UserName.localeCompare(b.UserName) ||\n        a.TaskTitle.localeCompare(b.TaskTitle) ||\n        a.date.localeCompare(b.date),\n    );\n  let html =\n      '<!doctype html><html><head><meta charset=\"utf-8\"><title>Timesheet report</title><style>table{border-collapse:collapse}th,td{border:1px solid;padding:4px}</style></head><body><h1>Timesheet report</h1>',\n    user = \"\",\n    task = \"\",\n    total = 0;\n  for (const r of rows) {\n    if (r.UserName !== user || r.TaskTitle !== task) {\n      if (task)\n        html += \"</table><p><em>\" + total.toFixed(2) + \" - Total hours for this task</em></p>\";\n      if (r.UserName !== user) {\n        user = r.UserName;\n        html +=\n          '<h2><img width=\"32\" height=\"32\" src=\"' +\n          esc(r.UserAvatar) +\n          '\" alt=\"\"> ' +\n          esc(user) +\n          \"</h2>\";\n      }\n      task = r.TaskTitle;\n      total = 0;\n      html +=\n        \"<h3>\" +\n        esc(task) +\n        \"</h3><table><tr><th>Date</th><th>Hours</th><th>Task Description</th></tr>\";\n    }\n    total += Number(r.hours);\n    html +=\n      \"<tr><td>\" +\n      esc(r.date.split(\"T\")[0]) +\n      \"</td><td>\" +\n      Number(r.hours).toFixed(2) +\n      \"</td><td>\" +\n      esc(r.note) +\n      \"</td></tr>\";\n  }\n  html +=\n    \"</table><p><em>\" +\n    total.toFixed(2) +\n    \" - Total hours for this task</em></p><p><em>Timesheet report generated on: \" +\n    new Date().toISOString().slice(0, 10) +\n    \"</em></p></body></html>\";\n  return { html };\n}\n"
      },
      "n_5786e42869f7c491": {
        "name": "Create the HTML file",
        "imports": [],
        "source": "export default async function file({ html }, context) {\n  return {\n    file: await context.artifact.put(Buffer.from(html, \"utf8\"), {\n      name: \"report.html\",\n      mediaType: \"text/html\",\n    }),\n  };\n}\n"
      }
