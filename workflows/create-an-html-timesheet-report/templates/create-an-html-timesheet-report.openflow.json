    "modules": {
      "n_b567b5e4b19a4931": {
        "name": "Build the timesheet report",
        "imports": [],
        "source": "export default function report({records}){\n if(!Array.isArray(records)||!records.length)throw Error('Provide timesheet records');const esc=x=>String(x??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const rows=records.map(r=>{if(!r||typeof r.UserName!=='string'||!r.UserName||typeof r.TaskTitle!=='string'||!r.TaskTitle||typeof r.date!=='string'||typeof r.UserAvatar!=='string'||!/^https:\\/\\//i.test(r.UserAvatar)||!Number.isFinite(Number(r.hours)))throw Error('Invalid timesheet record');return r}).sort((a,b)=>a.UserName.localeCompare(b.UserName)||a.TaskTitle.localeCompare(b.TaskTitle)||a.date.localeCompare(b.date));let html='<!doctype html><html><head><meta charset=\"utf-8\"><title>Timesheet report</title><style>table{border-collapse:collapse}th,td{border:1px solid;padding:4px}</style></head><body><h1>Timesheet report</h1>',user='',task='',total=0;for(const r of rows){if(r.UserName!==user||r.TaskTitle!==task){if(task)html+='</table><p><em>'+total.toFixed(2)+' - Total hours for this task</em></p>';if(r.UserName!==user){user=r.UserName;html+='<h2><img width=\"32\" height=\"32\" src=\"'+esc(r.UserAvatar)+'\" alt=\"\"> '+esc(user)+'</h2>'}task=r.TaskTitle;total=0;html+='<h3>'+esc(task)+'</h3><table><tr><th>Date</th><th>Hours</th><th>Task Description</th></tr>'}total+=Number(r.hours);html+='<tr><td>'+esc(r.date.split('T')[0])+'</td><td>'+Number(r.hours).toFixed(2)+'</td><td>'+esc(r.note)+'</td></tr>'}html+='</table><p><em>'+total.toFixed(2)+' - Total hours for this task</em></p><p><em>Timesheet report generated on: '+new Date().toISOString().slice(0,10)+'</em></p></body></html>';return{html};}\n"
      },
      "n_5786e42869f7c491": {
        "name": "Create the HTML file",
        "imports": [],
        "source": "export default async function file({html},context){return {file:await context.artifact.put(Buffer.from(html,'utf8'),{name:'report.html',mediaType:'text/html'})};}\n"
      }
