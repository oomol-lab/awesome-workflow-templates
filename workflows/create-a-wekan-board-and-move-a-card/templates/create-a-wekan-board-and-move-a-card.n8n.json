{
  "name": "Create a Wekan Board and Move a Card",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        450,
        450
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-0"
    },
    {
      "name": "Wekan",
      "type": "n8n-nodes-base.wekan",
      "position": [
        650,
        450
      ],
      "parameters": {
        "owner": "YOUR_WEKAN_USER_ID",
        "title": "Documentation",
        "resource": "board",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-1"
    },
    {
      "name": "Wekan1",
      "type": "n8n-nodes-base.wekan",
      "position": [
        850,
        450
      ],
      "parameters": {
        "title": "To Do",
        "boardId": "={{$node[\"Wekan\"].json[\"_id\"]}}",
        "resource": "list"
      },
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-2"
    },
    {
      "name": "Wekan2",
      "type": "n8n-nodes-base.wekan",
      "position": [
        1050,
        450
      ],
      "parameters": {
        "title": "Done",
        "boardId": "={{$node[\"Wekan\"].json[\"_id\"]}}",
        "resource": "list"
      },
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-3"
    },
    {
      "name": "Wekan3",
      "type": "n8n-nodes-base.wekan",
      "position": [
        1250,
        450
      ],
      "parameters": {
        "title": "Document Wekan node",
        "listId": "={{$node[\"Wekan1\"].json[\"_id\"]}}",
        "boardId": "={{$node[\"Wekan\"].json[\"_id\"]}}",
        "authorId": "YOUR_WEKAN_USER_ID",
        "swimlaneId": "={{ $('Check new board swimlane').first().json._id }}",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-4"
    },
    {
      "name": "Wekan4",
      "type": "n8n-nodes-base.wekan",
      "position": [
        1450,
        450
      ],
      "parameters": {
        "cardId": "={{$node[\"Wekan3\"].json[\"_id\"]}}",
        "listId": "={{$node[\"Wekan1\"].json[\"_id\"]}}",
        "boardId": "={{$node[\"Wekan\"].json[\"_id\"]}}",
        "operation": "update",
        "updateFields": {
          "listId": "={{$node[\"Wekan2\"].json[\"_id\"]}}"
        }
      },
      "typeVersion": 1,
      "id": "create-a-wekan-board-and-move-a-card-5"
    },
    {
      "name": "Read board swimlanes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "url": "={{ 'https://YOUR_WEKAN_HOST/api/boards/' + encodeURIComponent($('Wekan').first().json._id) + '/swimlanes' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wekanApi",
        "options": {}
      },
      "id": "create-a-wekan-board-and-move-a-card-6"
    },
    {
      "name": "Check new board swimlane",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (items.length !== 1 || !items[0].json._id)\n  throw new Error(\"Expected one swimlane in the new board\");\nreturn items;\n"
      },
      "id": "create-a-wekan-board-and-move-a-card-7"
    }
  ],
  "active": false,
