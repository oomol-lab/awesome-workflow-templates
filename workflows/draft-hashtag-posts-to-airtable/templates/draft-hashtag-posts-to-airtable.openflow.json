    "modules": {
      "n_2dfab60d4b648ef2": {
        "name": "Choose a hashtag",
        "imports": [],
        "source": "export default function pick({ hashtags }) {\n  if (\n    !Array.isArray(hashtags) ||\n    !hashtags.length ||\n    hashtags.some(\n      (x) => typeof x !== \"string\" || !/^#[\\p{L}\\p{N}_]+$/u.test(x) || Array.from(x).length > 80,\n    )\n  )\n    throw Error(\"Configure at least one valid hashtag\");\n  const hashtag = hashtags[Math.floor(Math.random() * hashtags.length)];\n  return { hashtag };\n}\n"
      },
      "n_93732631cd5f884e": {
        "name": "Validate the draft",
        "imports": [],
        "source": "export default function validate({ hashtag, text }) {\n  if (typeof hashtag !== \"string\" || typeof text !== \"string\") throw Error(\"Invalid draft\");\n  const content = text.trim();\n  let found = false,\n    offset = 0;\n  while (offset < content.length) {\n    const i = content.indexOf(hashtag, offset);\n    if (i < 0) break;\n    const next = Array.from(content.slice(i + hashtag.length))[0] || \"\";\n    if (!/[\\p{L}\\p{N}_]/u.test(next)) {\n      found = true;\n      break;\n    }\n    offset = i + hashtag.length;\n  }\n  if (!content || Array.from(content).length >= 100 || !found)\n    throw Error(\"Draft must include the selected hashtag and be under 100 characters\");\n  return { hashtag, content, records: [{ fields: { Hashtag: hashtag, Content: content } }] };\n}\n"
      },
      "n_29d4fde6799bc3b3": {
        "name": "Confirm the saved draft",
        "imports": [],
        "source": "export default function confirm({ records }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id\n  )\n    throw Error(\"Airtable did not confirm the draft\");\n  return { id: records[0].id };\n}\n"
      }
    }
