    "modules": {
      "n_f8520708f748fa73": {
        "name": "Read the name and email answers",
        "imports": [],
        "source": "export default function typeformContactSubmission({ response, nameQuestion, emailQuestion }) {\n  if (!response || !Array.isArray(response.definition?.fields) || !Array.isArray(response.answers))\n    throw new Error(\"Expected the complete Typeform submission\");\n  const read = (selector, type) => {\n    if (typeof selector !== \"string\" || !selector)\n      throw new Error(\"Configure the contact question selector\");\n    const fields = response.definition.fields.filter(\n      (field) => field?.id === selector || field?.ref === selector || field?.title === selector,\n    );\n    if (\n      fields.length !== 1 ||\n      typeof fields[0].id !== \"string\" ||\n      !fields[0].id ||\n      response.definition.fields.filter((field) => field?.id === fields[0].id).length !== 1\n    )\n      throw new Error(\"The contact question must identify exactly one form field\");\n    const answers = response.answers.filter((answer) => answer?.field?.id === fields[0].id);\n    if (\n      answers.length !== 1 ||\n      answers[0].type !== type ||\n      typeof answers[0][type] !== \"string\" ||\n      !answers[0][type].trim()\n    )\n      throw new Error(\"Expected one nonempty \" + type + \" answer for the contact question\");\n    return answers[0][type];\n  };\n  const fields = { Name: read(nameQuestion, \"text\"), Email: read(emailQuestion, \"email\") };\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(fields.Email))\n    throw new Error(\"The contact email must be a valid address\");\n  return { fields, records: [{ fields }], parts: contactNotificationParts(fields) };\n}\n\nfunction contactNotificationParts(fields) {\n  const text = \"*New Submission* 🙌\\nName: \" + fields.Name + \"\\nEmail: \" + fields.Email,\n    chunks = [];\n  let chunk = \"\";\n  for (const character of text) {\n    if (chunk.length + character.length > 3900) {\n      chunks.push(chunk);\n      chunk = \"\";\n    }\n    chunk += character;\n  }\n  if (chunk) chunks.push(chunk);\n  const parts = chunks.map((content, index) =>\n    chunks.length > 1 ? \"Part \" + (index + 1) + \"/\" + chunks.length + \"\\n\" + content : content,\n  );\n  if (parts.some((part) => part.length > 4000))\n    throw new Error(\"The contact notification part exceeds the message budget\");\n  return parts;\n}\n"
      },
      "n_f49a5b23c5d672c6": {
        "name": "Confirm the saved contact record",
        "imports": [],
        "source": "export default function airtableFormRecord({ records }) {\n  if (\n    !Array.isArray(records) ||\n    records.length !== 1 ||\n    typeof records[0]?.id !== \"string\" ||\n    !records[0].id ||\n    !records[0].fields ||\n    typeof records[0].fields !== \"object\" ||\n    Array.isArray(records[0].fields)\n  )\n    throw new Error(\n      \"Airtable did not confirm one saved record; creation may already have occurred\",\n    );\n  return { record: records[0] };\n}\n"
      },
