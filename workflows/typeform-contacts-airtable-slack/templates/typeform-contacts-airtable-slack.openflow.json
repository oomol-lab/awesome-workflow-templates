        "name": "Prepare the next contact notice",
        "imports": [],
        "source": "export default function contactNotificationProgress({\n  record,\n  parts,\n  previousState,\n  channelId,\n  messageTs,\n  messageChannelId,\n}) {\n  if (\n    !record ||\n    typeof record.id !== \"string\" ||\n    !record.id ||\n    !Array.isArray(parts) ||\n    !parts.length ||\n    typeof channelId !== \"string\" ||\n    !channelId.trim()\n  )\n    throw new Error(\n      \"Expected a confirmed contact record, notification parts and destination channel ID\",\n    );\n  let state;\n  if (previousState == null) state = { index: 0, receipts: [] };\n  else {\n    if (\n      !Number.isInteger(previousState.index) ||\n      previousState.index < 1 ||\n      previousState.index > parts.length ||\n      !Array.isArray(previousState.receipts) ||\n      previousState.receipts.length !== previousState.index - 1\n    )\n      throw new Error(\"Invalid contact notification progress\");\n    if (\n      typeof messageTs !== \"string\" ||\n      !/^\\d+\\.\\d+$/.test(messageTs) ||\n      messageChannelId !== channelId\n    )\n      throw new Error(\n        \"Slack did not confirm the contact notification in the requested channel; the Airtable record and earlier messages may already exist\",\n      );\n    state = {\n      index: previousState.index,\n      receipts: [...previousState.receipts, { ts: messageTs, channelId: messageChannelId }],\n    };\n  }\n  const text = parts[state.index];\n  if (text == null)\n    return { state, more: false, text: \"\", channelId, count: state.receipts.length };\n  if (typeof text !== \"string\" || !text || text.length > 4000)\n    throw new Error(\"Invalid contact notification part\");\n  return {\n    state: { index: state.index + 1, receipts: state.receipts },\n    more: true,\n    text,\n    channelId,\n    count: state.receipts.length,\n  };\n}\n"
