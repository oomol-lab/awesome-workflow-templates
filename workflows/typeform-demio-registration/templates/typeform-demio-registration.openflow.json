    "modules": {
      "n_d386ef4a18e0e71f": {
        "name": "Read registration name and email",
        "imports": [],
        "source": "export default function registrationAnswers({ response, nameField, emailField }) {\n  const fields = response.definition?.fields,\n    answers = response.answers;\n  if (!Array.isArray(fields) || !Array.isArray(answers))\n    throw new Error(\"Typeform response must include field definitions and answers\");\n  const read = (selector, expectedType) => {\n    if (typeof selector !== \"string\" || !selector)\n      throw new Error(\"Configure the name and email question identifiers\");\n    const matches = fields.filter(\n      (field) => field.id === selector || field.ref === selector || field.title === selector,\n    );\n    if (matches.length !== 1 || typeof matches[0].id !== \"string\")\n      throw new Error(\"Typeform field must match one unique question: \" + selector);\n    const values = answers.filter((answer) => answer.field?.id === matches[0].id);\n    if (\n      values.length !== 1 ||\n      values[0].type !== expectedType ||\n      typeof values[0][expectedType] !== \"string\"\n    )\n      throw new Error(\"Typeform answer is missing or has the wrong type: \" + selector);\n    return values[0][expectedType];\n  };\n  const name = read(nameField, \"text\"),\n    email = read(emailField, \"email\");\n  if (name.length < 3 || !name.trim())\n    throw new Error(\"Demio requires a first name of at least three characters\");\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))\n    throw new Error(\"Typeform email answer is invalid\");\n  return { name, email };\n}\n"
      }
    }
