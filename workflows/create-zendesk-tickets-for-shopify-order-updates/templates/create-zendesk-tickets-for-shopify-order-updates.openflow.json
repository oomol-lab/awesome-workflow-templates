    "modules": {
      "n_b49fe134be409fff": {
        "name": "Check for an open ticket",
        "imports": [],
        "source": "function normalizeOrder(order) {\n  const number = order?.order_number;\n  const externalId = String(number);\n  if (\n    (typeof number !== \"string\" && typeof number !== \"number\") ||\n    !/^[1-9]\\d{0,19}$/.test(externalId) ||\n    (typeof number === \"number\" && !Number.isSafeInteger(number)) ||\n    !Array.isArray(order.line_items)\n  ) {\n    throw new Error(\"Shopify order number or line items are missing or invalid\");\n  }\n\n  const customer = order.customer;\n  const customerName = [customer?.first_name, customer?.last_name]\n    .filter((part) => typeof part === \"string\" && part.trim())\n    .join(\" \");\n  const email = [customer?.email, order.contact_email, order.email].find(\n    (value) => typeof value === \"string\" && value.trim(),\n  );\n  const subject = \"Order #\" + externalId + \" - \" + order.line_items.length + \" item(s)\";\n  return {\n    externalId,\n    subject,\n    comment: {\n      body: [\n        subject,\n        \"\",\n        \"Order:\",\n        \"Customer: \" + (customerName || \"Unavailable\"),\n        \"email: \" + (email || \"Unavailable\"),\n        \"Status: New order\",\n      ].join(\"\\n\"),\n    },\n    status: \"open\",\n  };\n}\n\nfunction readPage(body, externalId, state) {\n  const { tickets, meta } = body ?? {};\n  if (!Array.isArray(tickets) || typeof meta?.has_more !== \"boolean\") {\n    throw new Error(\"Zendesk returned an invalid ticket page\");\n  }\n\n  const nextCursor = meta.has_more ? meta.after_cursor : null;\n  if (\n    meta.has_more &&\n    (typeof nextCursor !== \"string\" || !nextCursor || state.cursors.includes(nextCursor))\n  ) {\n    throw new Error(\"Zendesk returned an invalid pagination cursor\");\n  }\n\n  let latestId = state.latestId;\n  let open = state.open;\n  for (const ticket of tickets) {\n    if (typeof ticket?.external_id !== \"string\") {\n      throw new Error(\"Zendesk returned a ticket with no external ID\");\n    }\n    if (ticket.external_id !== externalId) continue;\n    if (!Number.isSafeInteger(ticket.id) || ticket.id < 1 || typeof ticket.status !== \"string\") {\n      throw new Error(\"Zendesk returned an invalid matching ticket\");\n    }\n    latestId = Math.max(ticket.id, latestId);\n    open ||= ticket.status === \"open\";\n  }\n\n  return {\n    cursors: nextCursor ? [...state.cursors, nextCursor] : state.cursors,\n    latestId,\n    open,\n  };\n}\n\nfunction ticketKey(externalId, latestId) {\n  return \"shopify-order-\" + externalId + \"-after-zendesk-\" + latestId;\n}\n\nexport default function collect({ order, previous, response, statusCode }) {\n  const { externalId, ...ticketFields } = normalizeOrder(order);\n  if (statusCode !== null && statusCode !== 200) {\n    throw new Error(\"Zendesk ticket lookup failed\");\n  }\n\n  const state =\n    previous === null\n      ? { cursors: [], latestId: 0, open: false }\n      : readPage(response, externalId, previous);\n  const nextCursor = state.cursors.at(-1);\n  const more = previous === null || (response.meta.has_more && !state.open);\n  return {\n    state,\n    more,\n    missing: !state.open,\n    externalId,\n    query: {\n      external_id: externalId,\n      \"page[size]\": 100,\n      ...(nextCursor ? { \"page[after]\": nextCursor } : {}),\n    },\n    body: { ticket: { ...ticketFields, external_id: externalId } },\n    key: ticketKey(externalId, state.latestId),\n  };\n}\n"
      },
      "n_96969b5ec687c0de": {
        "name": "Confirm ticket creation",
        "imports": [],
        "source": "export default function confirm({ response, statusCode, externalId }) {\n  const ticket = response?.ticket;\n  if (\n    statusCode !== 201 ||\n    !Number.isSafeInteger(ticket?.id) ||\n    ticket.id < 1 ||\n    ticket.external_id !== externalId\n  ) {\n    throw new Error(\"Zendesk did not confirm the new ticket for this order\");\n  }\n  return { ticketId: ticket.id };\n}\n"
      }
    },
