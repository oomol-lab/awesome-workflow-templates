{
  "nodes": [
    {
      "name": "Start manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "id": "check-airtable-email-mx-records-0"
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        470,
        200
      ],
      "parameters": {
        "table": "YOUR_AIRTABLE_TABLE_ID",
        "operation": "list",
        "additionalOptions": {},
        "authentication": "airtableTokenApi",
        "returnAll": true,
        "application": "YOUR_AIRTABLE_BASE_ID"
      },
      "typeVersion": 1,
      "id": "check-airtable-email-mx-records-1"
    },
    {
      "name": "Check email MX",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ \"https://api.usercheck.com/email/\" + encodeURIComponent($json.fields.Email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-airtable-email-mx-records-2"
    },
    {
      "name": "Prepare the record update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original=$('Airtable').item.json;if(typeof $json.mx!=='boolean'||typeof $json.email!=='string'||$json.email.toLowerCase()!==String(original.fields.Email).toLowerCase())throw Error('Unconfirmed MX result');return {json:{ID:original.id,Valid:$json.mx}};"
      },
      "id": "check-airtable-email-mx-records-3"
    },
    {
      "name": "Airtable1",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1070,
        200
      ],
      "parameters": {
        "id": "={{$json[\"ID\"]}}",
        "table": "YOUR_AIRTABLE_TABLE_ID",
        "fields": [
          "Valid"
        ],
        "options": {},
        "operation": "update",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "updateAllFields": false,
        "authentication": "airtableTokenApi"
      },
      "typeVersion": 1,
      "id": "check-airtable-email-mx-records-4"
    }
  ],
  "connections": {
    "Start manually": {
      "main": [
        [
          {
            "node": "Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable": {
      "main": [
        [
          {
            "node": "Check email MX",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check email MX": {
      "main": [
        [
          {
            "node": "Prepare the record update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare the record update": {
      "main": [
        [
          {
            "node": "Airtable1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Check Airtable Email MX Records",
  "active": false,
  "pinData": {}
}
