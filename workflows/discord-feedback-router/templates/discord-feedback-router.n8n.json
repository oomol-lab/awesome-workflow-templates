      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prepare = function prepareFeedback(inputs) {\n  if (typeof inputs.feedback !== \"string\" || !inputs.feedback.trim())\n    throw new Error(\"Supply nonempty feedback text.\");\n  return { feedback: inputs.feedback };\n};\n\nconst item = $input.first().json;\nreturn [\n  { json: prepare({ feedback: item.body?.feedback ?? item.feedback }), pairedItem: { item: 0 } },\n];\n"
      }
    },
