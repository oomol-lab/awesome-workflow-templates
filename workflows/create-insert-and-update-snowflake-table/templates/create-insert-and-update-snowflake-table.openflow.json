    "modules": {
      "n_c74363c821efde99": {
        "name": "Prepare SQL statements",
        "imports": [],
        "source": "export default function prepare({account}){if(typeof account!=='string'||!/^https:\\/\\/[a-z0-9][a-z0-9.-]*\\.snowflakecomputing\\.com$/i.test(account))throw Error('Enter the Snowflake account URL without a trailing slash');return{url:account+'/api/v2/statements',body:{statement:\"CREATE TABLE docs (id INT, name STRING); INSERT INTO docs (id,name) VALUES (1,'n8n'); UPDATE docs SET name='nodemation' WHERE id=1;\",parameters:{MULTI_STATEMENT_COUNT:'3'}}}}\n"
      },
      "n_8452ab484ee77b62": {
        "name": "Check submission",
        "imports": [],
        "source": "export default function result({body,statusCode,account,previous}){if(!body||typeof body!=='object'||Array.isArray(body))throw Error('Invalid Snowflake response');const count=(previous?.count||0)+1;if(statusCode===200&&(!Array.isArray(body.statementHandles)||body.statementHandles.length!==3))throw Error('Snowflake did not confirm all three statements');if(statusCode===200)return{done:true,url:'',state:{count,url:''},result:body};if(statusCode!==202||typeof body.statementHandle!=='string'||!/^[a-z0-9-]+$/i.test(body.statementHandle)||count>60)throw Error('Snowflake execution not confirmed; inspect its status before retrying');return{done:false,url:account+'/api/v2/statements/'+body.statementHandle,state:{count,url:account+'/api/v2/statements/'+body.statementHandle},result:{}}}\n"
      },
      "n_27ca27a041834622": {
        "name": "Check completion",
        "imports": [],
        "source": "export default function result({body,statusCode,account,previous}){if(!body||typeof body!=='object'||Array.isArray(body))throw Error('Invalid Snowflake response');const count=(previous?.count||0)+1;if(statusCode===200&&(!Array.isArray(body.statementHandles)||body.statementHandles.length!==3))throw Error('Snowflake did not confirm all three statements');if(statusCode===200)return{done:true,url:'',state:{count,url:''},result:body};if(statusCode!==202||typeof body.statementHandle!=='string'||!/^[a-z0-9-]+$/i.test(body.statementHandle)||count>60)throw Error('Snowflake execution not confirmed; inspect its status before retrying');return{done:false,url:account+'/api/v2/statements/'+body.statementHandle,state:{count,url:account+'/api/v2/statements/'+body.statementHandle},result:{}}}\n"
      }
    }
