    "modules": {
      "n_914a1828fa5a2c6d": {
        "name": "Validate note request",
        "imports": [],
        "source": "export default function ({ body }) {\n  for (const k of [\"eventId\", \"botId\"])\n    if (typeof body?.[k] !== \"string\" || !body[k].trim()) throw Error(\"Missing \" + k);\n  return { eventId: body.eventId, botId: body.botId, parameters: [body.botId] };\n}\n"
      },
      "n_538ab64649503392": {
        "name": "Combine transcript history",
        "imports": [],
        "source": "export default function ({ result }) {\n  const rows = Array.isArray(result) ? result : result?.rows;\n  if (!Array.isArray(rows)) throw Error(\"Invalid transcript query result\");\n  const history = rows\n    .map((x) => String(x.speaker ?? \"\") + \": \" + String(x.words ?? \"\"))\n    .join(\"\\n\");\n  if (!history) throw Error(\"No transcript\");\n  return { history };\n}\n"
      },
      "n_3638232beea0464b": {
        "name": "Reserve note",
        "imports": [],
        "source": "export default async function ({ eventId, botId, analysis }, ctx) {\n  if (typeof analysis === \"string\") analysis = JSON.parse(analysis);\n  if (typeof analysis?.should_write !== \"boolean\" || typeof analysis?.note !== \"string\")\n    throw Error(\"Invalid note\");\n  if (!analysis.should_write) return { write: false, skip: false, key: \"\", body: {} };\n  if (!analysis.note.trim()) throw Error(\"Empty note\");\n  const key = \"recall-note:\" + eventId,\n    s = await ctx.state.get(key);\n  if (s?.status === \"pending\") throw Error(\"Inspect notes before retry\");\n  if (s?.status === \"done\") return { write: true, skip: true, key, body: {} };\n  await ctx.state.set(key, { status: \"pending\" });\n  return {\n    write: true,\n    skip: false,\n    key,\n    body: { event_id: eventId, bot_id: botId, note: analysis.note },\n  };\n}\n"
      },
      "n_a908c3911c7a4809": {
        "name": "Confirm note",
        "imports": [],
        "source": "export default async function ({ key, eventId, body }, ctx) {\n  if (!Array.isArray(body) || body.length !== 1 || body[0].event_id !== eventId)\n    throw Error(\"Unknown note insert outcome\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_f89b15d91eb77fd9": {
        "name": "Prepare event completion",
        "imports": [],
        "source": "export default function ({ projectUrl, eventId, botId }) {\n  if (!/^https:\\/\\/[a-z0-9-]+\\.supabase\\.co$/i.test(projectUrl))\n    throw Error(\"Configure Supabase project URL\");\n  return {\n    url:\n      projectUrl +\n      \"/rest/v1/meeting_utterances?event_id=eq.\" +\n      encodeURIComponent(eventId) +\n      \"&bot_id=eq.\" +\n      encodeURIComponent(botId),\n    body: { note_status: \"done\" },\n  };\n}\n"
      },
      "n_a68d109418c71f74": {
        "name": "Confirm event completion",
        "imports": [],
        "source": "export default function ({ body, eventId }) {\n  if (!Array.isArray(body) || body.length !== 1 || body[0].event_id !== eventId)\n    throw Error(\"Unknown event completion outcome\");\n  return { ok: true };\n}\n"
      }
    }
  },
