{
  "nodes": [
    {
      "name": "Recall transcript webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "parameters": {
        "httpMethod": "POST",
        "path": "record-recall-transcript-notes",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "record-recall-transcript-notes-0",
      "position": [
        0,
        0
      ]
    },
    {
      "name": "Verify Recall signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require(\"crypto\");\nconst raw = await helpers.getBinaryDataBuffer($itemIndex, \"data\");\nconst h = $json.headers ?? {},\n  id = h[\"webhook-id\"],\n  ts = h[\"webhook-timestamp\"],\n  sig = h[\"webhook-signature\"],\n  secret = $env.RECALL_WORKSPACE_SECRET;\nif (\n  !secret?.startsWith(\"whsec_\") ||\n  !id ||\n  !ts ||\n  !sig ||\n  !/^\\d+$/.test(ts) ||\n  Math.abs(Date.now() / 1000 - Number(ts)) > 300\n)\n  throw Error(\"Invalid Recall signature headers\");\nconst hash = crypto\n    .createHmac(\"sha256\", Buffer.from(secret.slice(6), \"base64\"))\n    .update(Buffer.concat([Buffer.from(id + \".\" + ts + \".\"), raw]))\n    .digest(),\n  valid = String(sig)\n    .split(\" \")\n    .some((x) => {\n      const [v, s] = x.split(\",\");\n      if (v !== \"v1\" || !s) return false;\n      const b = Buffer.from(s, \"base64\");\n      return b.length === hash.length && crypto.timingSafeEqual(b, hash);\n    });\nif (!valid) throw Error(\"Invalid Recall signature\");\nconst e = JSON.parse(raw.toString(\"utf8\")),\n  data = e.data?.data,\n  botId = e.data?.bot?.id;\nif (\n  e.event !== \"transcript.data\" ||\n  typeof botId !== \"string\" ||\n  !botId ||\n  !Array.isArray(data?.words) ||\n  data.words.some((w) => typeof w.text !== \"string\")\n)\n  throw Error(\"Invalid transcript event\");\nconst words = data.words.map((w) => w.text).join(\" \"),\n  speaker = data.participant?.name ?? \"\",\n  relative = Number(data.words[0]?.start_timestamp?.relative ?? 0);\nif (!Number.isFinite(relative)) throw Error(\"Invalid transcript timestamp\");\nreturn { json: { eventId: String(id), botId, words, speaker, relative } };\n"
      },
      "id": "record-recall-transcript-notes-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Store transcript event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO meeting_utterances(event_id,bot_id,speaker,words,relative_seconds) VALUES ($1,$2,$3,$4,$5) ON CONFLICT(event_id) DO UPDATE SET event_id=EXCLUDED.event_id WHERE meeting_utterances.bot_id=EXCLUDED.bot_id RETURNING event_id,bot_id,speaker,words,relative_seconds,note_status",
        "options": {
          "queryReplacement": "={{ [$json.eventId,$json.botId,$json.speaker,$json.words,$json.relative] }}"
        }
      },
      "id": "record-recall-transcript-notes-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Acknowledge Recall",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true} }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "record-recall-transcript-notes-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Pending event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.note_status === \"pending\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "record-recall-transcript-notes-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Keyword spoken?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.words.includes(\"Jimmy\") }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "record-recall-transcript-notes-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Read transcript history",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(string_agg(speaker || ': ' || words, E'\\n' ORDER BY relative_seconds,event_id),'') AS history FROM meeting_utterances WHERE bot_id=$1",
        "options": {
          "queryReplacement": "={{ [$(\"Store transcript event\").item.json.bot_id] }}"
        }
      },
      "id": "record-recall-transcript-notes-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Choose mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, relay: true } };\n"
      },
      "id": "record-recall-transcript-notes-7",
      "position": [
        1540,
        0
      ]
    },
