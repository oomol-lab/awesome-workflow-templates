    {
      "name": "Complete transcript event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE meeting_utterances SET note_status='done' WHERE event_id=$1 AND bot_id=$2 RETURNING event_id",
        "options": {
          "queryReplacement": "={{ [$(\"Store transcript event\").item.json.event_id,$(\"Store transcript event\").item.json.bot_id] }}"
        }
