      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"should_write\":{\"type\":\"boolean\"},\"note\":{\"type\":\"string\"}},\"required\":[\"should_write\",\"note\"],\"additionalProperties\":false}"
      },
      "id": "record-recall-transcript-notes-12",
