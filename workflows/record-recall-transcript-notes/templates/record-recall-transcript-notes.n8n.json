    {
      "name": "Insert meeting note",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO meeting_notes(event_id,bot_id,note) VALUES($1,$2,$3) ON CONFLICT(event_id) DO UPDATE SET event_id=EXCLUDED.event_id WHERE meeting_notes.bot_id=EXCLUDED.bot_id RETURNING event_id,bot_id",
        "options": {
          "queryReplacement": "={{ [$(\"Store transcript event\").item.json.event_id,$(\"Store transcript event\").item.json.bot_id,$json.output.note] }}"
        }
