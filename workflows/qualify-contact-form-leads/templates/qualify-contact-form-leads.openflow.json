    "modules": {
      "n_35fc9c19e624fa94": {
        "name": "Read the email and set the notification recipient",
        "imports": [],
        "source": "function formEmail(value) {\n  const email = typeof value === \"string\" ? value.trim().toLowerCase() : \"\";\n  if (\n    email.length > 254 ||\n    !/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$/.test(\n      email,\n    )\n  ) {\n    throw new Error(\"A business email address is required\");\n  }\n  return email;\n}\n\nfunction leadSettings(email, recipient, threshold) {\n  if (!Number.isFinite(threshold) || threshold < 0 || threshold > 100) {\n    throw Error(\"Set a numeric minimum fit score between 0 and 100.\");\n  }\n  const businessEmail = formEmail(email);\n  let notificationEmail;\n  try {\n    notificationEmail = formEmail(recipient);\n  } catch {\n    throw Error(\"Set one valid internal notification email address.\");\n  }\n  return { email: businessEmail, recipient: notificationEmail, threshold };\n}\n\nexport default ({ body, notificationEmail, threshold }) => {\n  const scope = leadSettings(body.Email, notificationEmail, threshold);\n  return { scope, email: scope.email };\n};\n"
      },
      "n_ad9beaaebc633e76": {
        "name": "Check Hunter’s verification",
        "imports": [],
        "source": "function verifyLead(email, data, statusCode = 200) {\n  if (statusCode !== 200 || typeof data?.status !== \"string\") {\n    return { valid: false, status: \"verification_unavailable\", url: \"\", password: \"\" };\n  }\n  if (data.status !== \"valid\")\n    return { valid: false, status: \"email_not_valid\", url: \"\", password: \"\" };\n  if (typeof data.email !== \"string\" || data.email.toLowerCase() !== email) {\n    return { valid: false, status: \"verification_mismatch\", url: \"\", password: \"\" };\n  }\n  return {\n    valid: true,\n    status: \"verified\",\n    url: \"https://api.madkudu.com/v1/persons?email=\" + encodeURIComponent(email),\n    password: \"\",\n  };\n}\n\nexport default ({ email, reply }) => {\n  const { valid, status, url, password } = verifyLead(email, reply.data);\n  return { valid, result: { status, messageId: null }, url, password };\n};\n"
      },
      "n_10beac60ac981374": {
        "name": "Send the qualified lead alert",
        "imports": [],
        "source": "function prepareLeadAlert(scope, person, statusCode) {\n  const skip = (status) => ({ status, send: false, recipient: \"\", subject: \"\", body: \"\" });\n  if (statusCode === 404) return skip(\"person_not_found\");\n  if (statusCode !== 200) return skip(\"score_unavailable\");\n  if (\n    person?.object_type !== \"person\" ||\n    typeof person.email !== \"string\" ||\n    person.email.toLowerCase() !== scope.email\n  ) {\n    return skip(\"score_mismatch\");\n  }\n  const { properties } = person;\n  const fit = properties?.customer_fit;\n  if (!Number.isFinite(fit?.score) || fit.score < 0 || fit.score > 100)\n    return skip(\"score_unavailable\");\n  if (fit.score <= scope.threshold) return skip(\"score_below_threshold\");\n  const oneLine = (field) =>\n    typeof field === \"string\"\n      ? field\n          .replace(/[\\u0000-\\u001f\\u007f\\s]+/gu, \" \")\n          .trim()\n          .slice(0, 140)\n      : \"\";\n  const name =\n    [oneLine(properties.first_name), oneLine(properties.last_name)].filter(Boolean).join(\" \") ||\n    scope.email;\n  const company = person.company?.properties;\n  const companyName = oneLine(company?.name),\n    domain = oneLine(company?.domain);\n  const organization =\n    companyName && domain ? companyName + \" (\" + domain + \")\" : companyName || domain;\n  const location = [oneLine(company?.location?.state), oneLine(company?.location?.country)]\n    .filter(Boolean)\n    .join(\", \");\n  const signals = [fit.top_signals_formated, fit.top_signals_formatted].find(\n    (item) => typeof item === \"string\" && item.trim(),\n  );\n  const summary =\n    \"Got a hot lead for you: \" +\n    name +\n    (organization ? \" from \" + organization : \"\") +\n    (location ? \", based in \" + location : \"\") +\n    \".\";\n  return {\n    status: \"qualified\",\n    send: true,\n    recipient: scope.recipient,\n    subject: \"⭐ Hot lead alert: \" + name,\n    body:\n      summary +\n      (signals\n        ? \"\\n\\n\" +\n          signals\n            .replace(/\\u0000/g, \"\")\n            .trim()\n            .slice(0, 12000)\n        : \"\"),\n  };\n}\n\nfunction leadSendReceipt(id) {\n  const confirmed = typeof id === \"string\" && Boolean(id.trim());\n  return { status: confirmed ? \"sent\" : \"email_unconfirmed\", messageId: confirmed ? id : null };\n}\n\nexport default async ({ scope, reply, statusCode }, context) => {\n  const plan = prepareLeadAlert(scope, reply, statusCode);\n  if (!plan.send) return { result: { status: plan.status, messageId: null } };\n  try {\n    const receipt = await context.actions.call(\"gmail.send_email\", {\n      to: plan.recipient,\n      subject: plan.subject,\n      body: plan.body,\n      isHtml: false,\n    });\n    return { result: leadSendReceipt(receipt?.messageId) };\n  } catch {\n    return { result: leadSendReceipt(null) };\n  }\n};\n"
      },
      "n_96f2e2f8b26f6cc6": {
        "name": "Return the verification outcome",
        "imports": [],
        "source": "export default ({ result }) => ({ result });\n"
      }
    },
