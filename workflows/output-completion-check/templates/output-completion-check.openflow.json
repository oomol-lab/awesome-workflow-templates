    "modules": {
      "n_eaa2a0816ba8b708": {
        "name": "Check completed outputs",
        "imports": [],
        "source": "export default function checkOutputs({ records, minimumItems, recordIdField }) {\n  const minimum = Number(minimumItems);\n  if (!Number.isSafeInteger(minimum) || minimum < 0 || minimum > 1000000000)\n    throw new Error(\"minimumItems must be a non-negative integer, at most 1000000000.\");\n  const field = String(recordIdField || \"\").trim();\n  if (!field) throw new Error(\"Set recordIdField to the field identifying a completed output.\");\n  if (\n    !Array.isArray(records) ||\n    records.some((record) => !record || typeof record !== \"object\" || Array.isArray(record))\n  )\n    throw new Error(\"records must be an array of objects.\");\n  const rows = records.filter((record) => Object.keys(record).length > 0);\n  const keys = new Set();\n  let invalidItems = 0;\n  for (const row of rows) {\n    const value = row[field];\n    const valid =\n      (typeof value === \"string\" && value.trim().length > 0) ||\n      (typeof value === \"number\" && Number.isFinite(value));\n    if (!valid) {\n      invalidItems++;\n      continue;\n    }\n    keys.add(String(value).trim());\n  }\n  const items = keys.size;\n  const duplicateItems = rows.length - invalidItems - items;\n  return {\n    checkPassed: items >= minimum && invalidItems === 0,\n    checkStatus: invalidItems ? \"invalid_output\" : items < minimum ? \"below_minimum\" : \"healthy\",\n    minimumItems: minimum,\n    items,\n    invalidItems,\n    duplicateItems,\n  };\n}\n"
      }
    }
