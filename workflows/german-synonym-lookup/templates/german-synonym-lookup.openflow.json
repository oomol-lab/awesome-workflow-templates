      "n_c34ea55ff7683a36": {
        "name": "Read synonym groups",
        "imports": [],
        "source": "export default function synonymResult({ body }) {\n  if (!body || typeof body !== 'object' || !Array.isArray(body.synsets) || body.synsets.some((group) => !group || typeof group !== 'object' || Array.isArray(group))) throw new Error('OpenThesaurus returned an invalid synonym-group response');\n  return { synsets: body.synsets, count: body.synsets.length };\n}\n"
      }
