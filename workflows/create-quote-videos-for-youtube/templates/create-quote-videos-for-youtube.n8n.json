        "jsCode": "const a = $input.all().map((x) => x.json),\n  v = a.filter((x) => x.BackgroundURL),\n  m = a.filter((x) => x.MusicURL),\n  q = a.filter((x) => x.Qoute && x.Author && !x.CreateStatus);\nif (!v.length || !m.length || !q.length) throw Error(\"Missing source\");\nconst pick = (x) => x[Math.floor(Math.random() * x.length)];\nreturn [{ json: { video: pick(v), music: pick(m), quote: pick(q) } }];\n"
