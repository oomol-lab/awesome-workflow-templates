      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { requestId, url, title, description } = $json.body ?? {};\nif (\n  !/^[A-Za-z0-9_-]{16,128}$/.test(requestId ?? \"\") ||\n  !/^https:\\/\\/res\\.cloudinary\\.com\\//.test(url ?? \"\") ||\n  !title\n)\n  throw Error(\"Invalid upload request\");\nreturn { json: { requestId, url, title, description }, pairedItem: { item: $itemIndex } };\n"
