    {
      "id": "autoclip-20",
      "name": "Prepare portrait clip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function f({ video, music, quote }) {\n  const v = video?.secureUrl,\n    id = music?.publicId;\n  if (\n    typeof v !== \"string\" ||\n    !/^https:\\/\\/res\\.cloudinary\\.com\\//.test(v) ||\n    !id ||\n    !quote?.text ||\n    !quote?.author\n  )\n    throw Error(\"Invalid Cloudinary assets or quote\");\n  let marker = \"/video/upload/\",\n    at = v.indexOf(marker);\n  if (at < 0) throw Error(\"Unexpected video delivery URL\");\n  const esc = (x) => encodeURIComponent(x).replace(/%2F/gi, \"%252F\").replace(/%2C/gi, \"%252C\"),\n    audio = id.replace(/\\//g, \":\");\n  if (!/^[\\w:.-]+$/.test(audio)) throw Error(\"Invalid audio public ID\");\n  const wrap = (s, n) => {\n    let lines = [],\n      line = \"\";\n    for (const word of s.split(/\\s+/)) {\n      if (line && line.length + 1 + word.length > n) {\n        lines.push(line);\n        line = \"\";\n      }\n      line += (line ? \" \" : \"\") + word;\n    }\n    if (line) lines.push(line);\n    return lines.join(\"\\n\");\n  };\n  let wrapped = wrap(quote.text, 24),\n    text = esc(wrapped),\n    author = esc(quote.author),\n    authorY = Math.round(960 + (wrapped.split(\"\\n\").length * 77) / 2 + 20),\n    trans =\n      \"c_fill,w_1080,h_1920,du_10/e_brightness:-30/l_audio:\" +\n      audio +\n      \"/e_volume:80/fl_layer_apply/l_text:Kanit@google_70_italic:\" +\n      text +\n      \",co_white/fl_layer_apply/l_text:Kanit@google_50_italic:\" +\n      author +\n      \",co_white,g_north_east,x_40,y_\" +\n      authorY +\n      \"/fl_layer_apply/\";\n  return {\n    url:\n      v.slice(0, at + marker.length) +\n      trans +\n      v.slice(at + marker.length).replace(/\\.[A-Za-z0-9]+(?:\\?.*)?$/, \".mp4\"),\n    title: Array.from(quote.text).slice(0, 100).join(\"\"),\n    description: quote.text + \"\\n\" + quote.author,\n  };\n}\n\nconst s = $(\"Select video music and quote\").first().json;\nreturn {\n  json: f({\n    video: { secureUrl: $(\"Upload video to Cloudinary\").first().json.secure_url },\n    music: { publicId: $(\"Upload music to Cloudinary\").first().json.public_id },\n    quote: { text: s.quote.Qoute, author: s.quote.Author },\n  }),\n  pairedItem: { item: $itemIndex },\n};\n"
      }
    },
