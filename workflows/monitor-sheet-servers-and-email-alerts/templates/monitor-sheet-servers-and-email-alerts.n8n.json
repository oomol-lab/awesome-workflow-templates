      "type": "n8n-nodes-base.gmail",
      "position": [
        660,
        100
      ],
      "parameters": {
        "message": "=Hi Team,\n\nAt {{$now.format('yyyy-MM-dd HH:mm:ss')}}, the following server failed its HTTP check:\n\n🔻 Server Down: {{ $('Server-Monitor').item.json.Server }}  \n\nPlease investigate immediately to prevent service disruption. \n\nAutomated Monitoring System\n",
        "options": {
          "appendAttribution": false
        },
        "subject": "=🔻 Server Down: {{ $('Server-Monitor').item.json.Server }}: {{ $today.format('yyyy-MM-dd') }}",
        "sendTo": "YOUR_ALERT_EMAIL",
        "emailType": "text"
      },
      "typeVersion": 2.1
    },
