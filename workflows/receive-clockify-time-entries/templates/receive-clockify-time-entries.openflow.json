    "modules": {
      "n_67d3633f7e9a8770": {
        "name": "Prepare time window",
        "imports": [],
        "source": "export default async function window({ user, workspace, startOverride, endOverride }, context) {\n  if (!user?.id || !workspace) throw Error(\"Configure workspace and connect Clockify\");\n  const now = new Date().toISOString(),\n    start = (await context.state.get(\"clockify-last-checked\")) ?? startOverride,\n    end = endOverride ? new Date(endOverride).toISOString() : now;\n  if (start && Date.parse(end) <= Date.parse(start)) throw Error(\"End must follow start\");\n  if (Date.parse(end) > Date.parse(now)) throw Error(\"End must not be in the future\");\n  const url = new URL(\n    `https://api.clockify.me/api/v1/workspaces/${encodeURIComponent(workspace)}/user/${encodeURIComponent(user.id)}/time-entries`,\n  );\n  if (start) url.searchParams.set(\"start\", start);\n  url.searchParams.set(\"end\", end);\n  url.searchParams.set(\"hydrated\", \"true\");\n  url.searchParams.set(\"in-progress\", \"false\");\n  return { url: url.toString(), end };\n}\n"
      },
      "n_ddbae8ac9841e629": {
        "name": "Save cursor and return entries",
        "imports": [],
        "source": "export default async function save({ entries, end }, context) {\n  if (!Array.isArray(entries)) throw Error(\"Clockify did not return an array\");\n  if (entries.length >= 50)\n    throw Error(\"Clockify may have more than one page; shorten the window before advancing\");\n  await context.state.set(\"clockify-last-checked\", end);\n  return { entries };\n}\n"
      }
    }
