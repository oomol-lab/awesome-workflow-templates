      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "typeVersion": 1,
      "id": "new-youtube-channel-videos-to-telegram-4"
    }
