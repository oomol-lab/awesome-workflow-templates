{
  "nodes": [
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        500,
        510
      ],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "id",
              "value": "={{$node[\"GetVideosYT\"].json[\"id\"][\"videoId\"]}}"
            },
            {
              "name": "url",
              "value": "=https://youtu.be/{{$node[\"GetVideosYT\"].json[\"id\"][\"videoId\"]}}"
            },
            {
              "name": "title",
              "value": "={{$node[\"GetVideosYT\"].json[\"snippet\"][\"title\"]}}"
            }
          ],
          "boolean": []
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "new-youtube-channel-videos-to-telegram-0"
    },
    {
      "name": "Function",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        510
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(({ json: x }) => {\n  if (\n    typeof x.id !== \"string\" ||\n    !/^[A-Za-z0-9_-]{1,128}$/.test(x.id) ||\n    typeof x.title !== \"string\"\n  )\n    throw new Error(\"Invalid video\");\n  const t = x.title.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n  const text = \"New video on YouTube!\\n<b>\" + t + \"</b>\\n\\nhttps://youtu.be/\" + x.id;\n  if (text.length > 4096) throw new Error(\"Telegram message exceeds limit\");\n  return { id: x.id, text };\n});\nconst data = $getWorkflowStaticData(\"node\");\ndata.ids = data.ids || [];\nconst result = [];\nfor (const row of rows) {\n  if (data.ids.includes(row.id)) break;\n  result.push({ json: row });\n}\ndata.ids = rows.map((x) => x.id);\nreturn result;\n"
      },
      "typeVersion": 2,
      "id": "new-youtube-channel-videos-to-telegram-1"
    },
    {
      "name": "CheckTime",
      "type": "n8n-nodes-base.interval",
      "position": [
        210,
        510
      ],
      "parameters": {
        "unit": "minutes",
        "interval": 30
      },
      "typeVersion": 1,
      "id": "new-youtube-channel-videos-to-telegram-2"
    },
    {
      "name": "GetVideosYT",
      "type": "n8n-nodes-base.youTube",
      "position": [
        370,
        510
      ],
      "parameters": {
        "limit": 4,
        "filters": {
