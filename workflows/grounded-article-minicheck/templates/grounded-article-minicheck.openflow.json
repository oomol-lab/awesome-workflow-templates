      "n_519b8dfc680c8d97": {
        "name": "Split all articles into claims",
        "imports": [],
        "source": "export function splitGroundedClaims(text) {\n  if(typeof text!=='string'||!text.trim())throw new Error('Article text is empty.');\n  const dates=[...text.matchAll(/\\b\\d{1,2}\\.\\s*(?:(?:Januar|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember)|\\d{1,2}\\.)\\s*\\d{2,4}\\b/gi)].map(match=>[match.index,match.index+match[0].length]);\n  const lists=[...text.matchAll(/^\\s*\\d+\\.\\s+/gm)].map(match=>[match.index,match.index+match[0].length]);\n  const protectedRanges=[...dates,...lists].sort((a,b)=>a[0]-b[0]);\n  let protectedIndex=0;\n  const boundaries=[...text.matchAll(/(?<=[.!?])\\s+(?=[A-ZÄÖÜ]|$)/g)].filter(match=>{\n    while(protectedIndex<protectedRanges.length&&protectedRanges[protectedIndex][1]<=match.index)protectedIndex++;\n    const range=protectedRanges[protectedIndex];\n    return !range||match.index<=range[0]||match.index>=range[1];\n  });\n  const claims=[];let offset=0;for(const boundary of boundaries){const claim=text.slice(offset,boundary.index).trim();if(claim)claims.push(claim);offset=boundary.index+boundary[0].length;}const last=text.slice(offset).trim();if(last)claims.push(last);return claims;\n}\nexport default function prepareGroundedClaims({documents}){\n  if(!Array.isArray(documents))throw new Error('Provide an array of facts/text document pairs.');\n  const claims=[];\n  for(const [documentIndex,document] of documents.entries()){\n    if(!document||typeof document.facts!=='string'||!document.facts.trim())throw new Error('Reference facts are empty.');\n    for(const [claimIndex,claim] of splitGroundedClaims(document.text).entries())claims.push({documentIndex,claimIndex,claim});\n  }\n  return {documents,claims};\n}\n"
      },
      "n_7dac953b5eb36fd0": {
        "name": "Collect grounded claim judgments",
        "imports": [],
        "source": "export function validateMiniCheckText(content){if(typeof content!=='string')throw new Error('Bespoke-MiniCheck answer is not text.');const verdict=content.trim();if(verdict!=='Yes'&&verdict!=='No')throw new Error('Bespoke-MiniCheck must answer Yes or No.');return verdict;}\nexport function readMiniCheckVerdict(response){\n  if(!response||typeof response!=='object'||response.done!==true||response.model!=='bespoke-minicheck:latest'||response.message?.role!=='assistant'||typeof response.message.content!=='string')throw new Error('Ollama did not return a complete bespoke-minicheck answer.');\n  return validateMiniCheckText(response.message.content);\n}\nexport default function collectGroundedChecks({documents,claims,previousState,response}){\n  let state;\n  if(previousState===null)state={index:0,checks:[]};\n  else{\n    const {index,checks}=previousState;\n    if(!Number.isSafeInteger(index)||index<0||index>=claims.length||checks.length!==index)throw new Error('Invalid grounded-check frame.');\n    state={index:index+1,checks:[...checks,{...claims[index],verdict:readMiniCheckVerdict(response)}]};\n  }\n  const next=claims[state.index],unsupported=state.checks.filter(check=>check.verdict==='No');\n  return {state,body:{model:'bespoke-minicheck:latest',stream:false,messages:[{role:'user',content:next?'Document: '+documents[next.documentIndex].facts+'\\nClaim: '+next.claim:'unused-completed-frame'}]},more:state.index<claims.length,unsupported,summaryInput:JSON.stringify(unsupported),hasUnsupported:unsupported.length>0,count:unsupported.length};\n}\n"
      },
      "n_57498924d3008595": {
        "name": "Complete editorial review report",
        "imports": [],
        "source": "export default function finishGroundedReport({checks,unsupported,completion}){\n  if(!Array.isArray(checks)||!Array.isArray(unsupported))throw new Error('Grounded check results are missing.');\n  const summary=unsupported.length===0?'No unsupported claims were identified by the configured checker.':completion;\n  if(typeof summary!=='string'||!summary.trim())throw new Error('The grounded-check summary is empty.');\n  return {checks,unsupported,count:unsupported.length,summary:summary.trim()};\n}\n"
      }
    }
