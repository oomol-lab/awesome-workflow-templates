    "modules": {
      "n_0fb386d1d53035d1": {
        "name": "Prepare feedback",
        "imports": [],
        "source": "export default function prepareFeedback({ values }) {\n  const questions = ['What went great?', 'How can we improve?', 'What is the chance of recommending our event?'];\n  if (!Array.isArray(values)) throw new Error('Feedback values must be an array.');\n  if (!values.length) return { count: 0, text: '' };\n  const headers = values[0];\n  if (!Array.isArray(headers) || questions.some((question) => !headers.includes(question))) throw new Error('Feedback sheet must contain the three configured question headers.');\n  for (const question of questions) if (headers.filter((header) => header === question).length !== 1) throw new Error('Duplicate feedback header: ' + question);\n  const rows = values.slice(1).filter((row) => Array.isArray(row) && row.some((value) => value !== null && value !== ''));\n  const text = questions.map((question, index) => `${index + 1}. ${question}: ${rows.map((row) => String(row[headers.indexOf(question)] ?? '')).join(' | ')}`).join('\\n');\n  return { count: rows.length, text };\n}\n"
      }
    }
