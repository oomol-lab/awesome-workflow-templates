{
  "nodes": [
    {
      "id": "airtable-contacts-to-lemlist-campaign-start",
      "name": "Import contacts",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        440,
        320
      ],
      "parameters": {
        "operation": "list",
        "authentication": "airtableTokenApi",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "table": "YOUR_TABLE_NAME",
        "returnAll": true,
        "additionalOptions": {}
      },
      "typeVersion": 1,
      "id": "airtable-contacts-to-lemlist-campaign-read"
    },
    {
      "id": "airtable-contacts-to-lemlist-campaign-validate",
      "name": "Validate contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all();for(const item of items){const f=item.json.fields;if(typeof f?.Email!=='string'||!f.Email.trim()||typeof f?.Name!=='string'||!f.Name.trim())throw new Error('Airtable record requires text Email and Name');}return items.map((item,index)=>({json:{...item.json,emailPath:encodeURIComponent(item.json.fields.Email)},pairedItem:{item:index}}));"
      }
    },
    {
      "name": "Lemlist",
      "type": "n8n-nodes-base.lemlist",
      "position": [
        640,
        320
      ],
      "parameters": {
        "resource": "lead",
        "operation": "create",
        "campaignId": "YOUR_LEMLIST_CAMPAIGN_ID",
        "email": "={{ $json.emailPath }}",
        "additionalFields": {
          "firstName": "={{ $json.fields.Name }}"
        }
      },
      "typeVersion": 1,
      "id": "airtable-contacts-to-lemlist-campaign-create"
    },
    {
      "name": "Lemlist1",
      "type": "n8n-nodes-base.lemlist",
      "position": [
        840,
        320
      ],
      "parameters": {
        "resource": "lead",
        "operation": "get",
        "email": "={{ $(\"Validate contacts\").item.json.emailPath }}"
      },
      "typeVersion": 1,
      "id": "airtable-contacts-to-lemlist-campaign-get"
    }
  ],
  "connections": {
    "Import contacts": {
      "main": [
        [
          {
            "node": "Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable": {
      "main": [
        [
          {
            "node": "Validate contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate contacts": {
      "main": [
        [
          {
            "node": "Lemlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lemlist": {
      "main": [
        [
          {
            "node": "Lemlist1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Import Airtable Contacts into a Lemlist Campaign",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
