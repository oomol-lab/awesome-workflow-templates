      "n_813f606845349984": {
        "name": "Collect and validate every page",
        "imports": [],
        "source": "export default function collectUsers({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  const all = [...state.records, ...records];\n  if (offset === null)\n    for (const r of all) {\n      const f = r?.fields;\n      if (\n        typeof f?.Email !== \"string\" ||\n        !f.Email.trim() ||\n        typeof f?.Name !== \"string\" ||\n        !f.Name.trim()\n      )\n        throw new Error(\"Airtable record requires text Email and Name\");\n    }\n  return {\n    state: { records: all, seen: offset === null ? state.seen : [...state.seen, offset] },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_1d2c1c6745e993a0": {
        "name": "Prepare each campaign lead",
        "imports": [],
        "source": "export default function next({\n  pageState,\n  previousState,\n  campaignId,\n  body,\n  statusCode,\n  bodyEncoding,\n}) {\n  const state = previousState ?? { index: 0, records: pageState.records, results: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.results))\n    throw Error(\"Invalid import state\");\n  if (previousState) {\n    if (\n      statusCode !== 200 ||\n      bodyEncoding ||\n      !body ||\n      typeof body !== \"object\" ||\n      Array.isArray(body)\n    )\n      throw Error(\"Lemlist did not return a completed creation\");\n    const expected = state.records[state.index]?.fields?.Email;\n    if (typeof body.email !== \"string\" || body.email.toLowerCase() !== expected.toLowerCase())\n      throw Error(\"Lemlist response does not match email\");\n    state.results.push(body);\n    state.index++;\n  }\n  if (state.index === state.records.length)\n    return { state, more: false, endpoint: \"unused\", payload: {}, count: state.results.length };\n  if (typeof campaignId !== \"string\" || !campaignId.trim() || campaignId.startsWith(\"YOUR_\"))\n    throw Error(\"Configure a campaign ID\");\n  const f = state.records[state.index].fields;\n  return {\n    state,\n    more: true,\n    endpoint: `/campaigns/${encodeURIComponent(campaignId)}/leads/${encodeURIComponent(f.Email)}`,\n    payload: { firstName: f.Name },\n    count: state.results.length,\n  };\n}\n"
      },
      "n_58dbb6b0595fc3dc": {
        "name": "Prepare each lead lookup",
        "imports": [],
        "source": "export default function next({ createState, previousState, body, statusCode, bodyEncoding }) {\n  const state = previousState ?? { index: 0, records: createState.records, results: [] };\n  if (previousState) {\n    if (statusCode !== 200 || bodyEncoding || !Array.isArray(body))\n      throw Error(\"Lemlist did not return a lead list\");\n    state.results.push({ email: state.records[state.index].fields.Email, leads: body });\n    state.index++;\n  }\n  if (state.index === state.records.length)\n    return { state, more: false, endpoint: \"unused\", count: state.results.length };\n  return {\n    state,\n    more: true,\n    endpoint: `/leads/${encodeURIComponent(state.records[state.index].fields.Email)}`,\n    count: state.results.length,\n  };\n}\n"
      }
    }
  },
