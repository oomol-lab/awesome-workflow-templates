    "modules": {
      "n_91ae301048ea8015": {
        "name": "Read answers and map company size",
        "imports": [],
        "source": "export default function readLead({ response, fieldKey, optionIds }) {\n  if (!response || !Array.isArray(response.answers) || !Array.isArray(response.definition?.fields))\n    throw Error(\"Expected complete Typeform response\");\n  if (!/^[a-f0-9]{40}$/i.test(fieldKey))\n    throw Error(\"Configure the Pipedrive organization custom field key\");\n  const sizes = [\"< 20\", \"20 - 100\", \"101 - 500\", \"501 - 1000\", \"1000+\"];\n  if (\n    !optionIds ||\n    sizes.some((k) => !Number.isSafeInteger(optionIds[k]) || optionIds[k] < 1) ||\n    new Set(sizes.map((k) => optionIds[k])).size !== 5\n  )\n    throw Error(\"Configure five distinct Pipedrive option IDs\");\n  function read(title, kind) {\n    const fields = response.definition.fields.filter((x) => x?.title === title);\n    if (\n      fields.length !== 1 ||\n      typeof fields[0].id !== \"string\" ||\n      response.definition.fields.filter((x) => x?.id === fields[0].id).length !== 1\n    )\n      throw Error(\"Expected one field: \" + title);\n    const a = response.answers.filter((x) => x?.field?.id === fields[0].id);\n    if (a.length !== 1 || a[0].type !== kind)\n      throw Error(\"Expected one \" + kind + \" answer: \" + title);\n    return kind === \"choice\" ? a[0].choice?.label : a[0][kind];\n  }\n  const company = read(\"What *company* are you contacting us from?\", \"text\"),\n    name = read(\"Let's start with your *first and last name.*\", \"text\"),\n    email = read(\"What *email address* can we reach you at?\", \"email\"),\n    questions = read(\n      \"Do you have any *specific questions* about embedding n8n at this stage?\",\n      \"text\",\n    ),\n    size = read(\"How many employees?\", \"choice\");\n  for (const x of [company, name, email, questions, size])\n    if (typeof x !== \"string\" || !x.trim()) throw Error(\"Expected nonempty form answers\");\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw Error(\"Invalid email\");\n  if (!sizes.includes(size)) throw Error(\"Unrecognized company size\");\n  const escape = (x) =>\n    x\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replaceAll('\"', \"&quot;\")\n      .replaceAll(\"'\", \"&#39;\");\n  return {\n    company,\n    name,\n    email,\n    customFields: { [fieldKey]: optionIds[size] },\n    note:\n      \"Website form submitted\\n\\nQuestion:\\n\" +\n      escape(questions) +\n      \"\\n\\nCompany Size:\\n\" +\n      escape(size),\n  };\n}\n"
      },
      "n_a3320ce0aade0c07": {
        "name": "Create the organization",
        "imports": [],
        "source": "export default async function createOrg({ company, customFields }, context) {\n  const { organization } = await context.actions.call(\"pipedrive.create_organization\", {\n    name: company,\n    customFields,\n  });\n  if (!Number.isSafeInteger(organization?.id) || organization.id < 1)\n    throw Error(\"Organization creation returned no usable ID\");\n  return { id: organization.id };\n}\n"
      },
      "n_6d63724978afda18": {
        "name": "Create the person",
        "imports": [],
        "source": "export default async function createPerson({ name, email, organizationId }, context) {\n  const { person } = await context.actions.call(\"pipedrive.create_person\", {\n    name,\n    organizationId,\n    emails: [{ value: email }],\n  });\n  if (!Number.isSafeInteger(person?.id) || person.id < 1)\n    throw Error(\"Person creation returned no usable ID\");\n  return { id: person.id };\n}\n"
      },
      "n_1302f5ed9735e232": {
        "name": "Prepare the lead",
        "imports": [],
        "source": "export default function lead({ company, organizationId, personId }) {\n  return {\n    body: { title: company + \" lead\", organization_id: organizationId, person_id: personId },\n  };\n}\n"
      },
      "n_30fc940ae5f86f50": {
        "name": "Prepare the note",
        "imports": [],
        "source": "export default function note({ statusCode, body, content }) {\n  if (\n    statusCode < 200 ||\n    statusCode >= 300 ||\n    body?.success !== true ||\n    typeof body?.data?.id !== \"string\" ||\n    !body.data.id\n  )\n    throw Error(\"Lead creation returned no usable ID\");\n  return { body: { lead_id: body.data.id, content } };\n}\n"
      },
      "n_a217bd251239856f": {
        "name": "Confirm the note",
        "imports": [],
        "source": "export default function ({ statusCode, body }) {\n  if (statusCode < 200 || statusCode >= 300 || body?.success !== true || !body.data?.id)\n    throw Error(\"Note creation failed\");\n  return {};\n}\n"
      }
    }
  },
