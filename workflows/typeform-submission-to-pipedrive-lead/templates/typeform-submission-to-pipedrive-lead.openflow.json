    "modules": {
      "n_91ae301048ea8015": {
        "name": "Read answers and map company size",
        "imports": [],
        "source": "export default function readLead({response,fieldKey,optionIds}) {\n if(!response||!Array.isArray(response.answers)||!Array.isArray(response.definition?.fields))throw Error('Expected complete Typeform response');\n if(!/^[a-f0-9]{40}$/i.test(fieldKey))throw Error('Configure the Pipedrive organization custom field key');\n const sizes=['< 20','20 - 100','101 - 500','501 - 1000','1000+'];\n if(!optionIds||sizes.some(k=>!Number.isSafeInteger(optionIds[k])||optionIds[k]<1)||new Set(sizes.map(k=>optionIds[k])).size!==5)throw Error('Configure five distinct Pipedrive option IDs');\n function read(title,kind){const fields=response.definition.fields.filter(x=>x?.title===title);if(fields.length!==1||typeof fields[0].id!=='string'||response.definition.fields.filter(x=>x?.id===fields[0].id).length!==1)throw Error('Expected one field: '+title);const a=response.answers.filter(x=>x?.field?.id===fields[0].id);if(a.length!==1||a[0].type!==kind)throw Error('Expected one '+kind+' answer: '+title);return kind==='choice'?a[0].choice?.label:a[0][kind]}\n const company=read('What *company* are you contacting us from?','text'),name=read(\"Let's start with your *first and last name.*\",'text'),email=read('What *email address* can we reach you at?','email'),questions=read('Do you have any *specific questions* about embedding n8n at this stage?','text'),size=read('How many employees?','choice');\n for(const x of [company,name,email,questions,size])if(typeof x!=='string'||!x.trim())throw Error('Expected nonempty form answers');\n if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))throw Error('Invalid email');if(!sizes.includes(size))throw Error('Unrecognized company size');\n const escape=x=>x.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('\"','&quot;').replaceAll(\"'\",'&#39;');\n return {company,name,email,customFields:{[fieldKey]:optionIds[size]},note:'Website form submitted\\n\\nQuestion:\\n'+escape(questions)+'\\n\\nCompany Size:\\n'+escape(size)};\n}\n"
      },
      "n_a3320ce0aade0c07": {
        "name": "Create the organization",
        "imports": [],
        "source": "export default async function createOrg({company,customFields},context){const {organization}=await context.actions.call('pipedrive.create_organization',{name:company,customFields});if(!Number.isSafeInteger(organization?.id)||organization.id<1)throw Error('Organization creation returned no usable ID');return {id:organization.id};}\n"
      },
      "n_6d63724978afda18": {
        "name": "Create the person",
        "imports": [],
        "source": "export default async function createPerson({name,email,organizationId},context){const {person}=await context.actions.call('pipedrive.create_person',{name,organizationId,emails:[{value:email}]});if(!Number.isSafeInteger(person?.id)||person.id<1)throw Error('Person creation returned no usable ID');return {id:person.id};}\n"
      },
      "n_1302f5ed9735e232": {
        "name": "Prepare the lead",
        "imports": [],
        "source": "export default function lead({company,organizationId,personId}){return {body:{title:company+' lead',organization_id:organizationId,person_id:personId}};}\n"
      },
      "n_30fc940ae5f86f50": {
        "name": "Prepare the note",
        "imports": [],
        "source": "export default function note({statusCode,body,content}){if(statusCode<200||statusCode>=300||body?.success!==true||typeof body?.data?.id!=='string'||!body.data.id)throw Error('Lead creation returned no usable ID');return {body:{lead_id:body.data.id,content}};}\n"
      },
      "n_a217bd251239856f": {
        "name": "Confirm the note",
        "imports": [],
        "source": "export default function({statusCode,body}){if(statusCode<200||statusCode>=300||body?.success!==true||!body.data?.id)throw Error(\"Note creation failed\");return {};}"
      }
    }
