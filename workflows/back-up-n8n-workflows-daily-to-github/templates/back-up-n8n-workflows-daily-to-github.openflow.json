    "modules": {
      "n_bc8d85434ee4835b": {
        "name": "Choose the backup repository",
        "imports": [],
        "source": "export default function config({owner,repo,path}){for(const [k,v] of Object.entries({owner,repo,path}))if(typeof v!=='string'||!v.trim()||v.startsWith('YOUR_'))throw Error('Configure GitHub '+k);if(path.startsWith('/')||path.endsWith('/')||path.split('/').some(x=>!x||x==='.'||x==='..'))throw Error('Invalid existing directory');return {owner,repo,path}}\n"
      },
