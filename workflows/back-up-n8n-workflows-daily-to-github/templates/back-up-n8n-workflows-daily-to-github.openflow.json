        "name": "Collect n8n workflow pages",
        "imports": [],
        "source": "export default async function pages({previous},context){const s=previous??{items:[],cursor:null,seen:[]};const r=await context.actions.call('n8n.list_workflows',{limit:100,...(s.cursor?{cursor:s.cursor}:{})});if(!Array.isArray(r?.data))throw Error('Invalid n8n workflow page');const c=r.nextCursor;if(c!==null&&(typeof c!=='string'||!c||s.seen.includes(c)))throw Error('Invalid or repeated workflow cursor');return {state:{items:s.items.concat(r.data),cursor:c,seen:c?[...s.seen,c]:s.seen},more:c!==null}}\n"
      },
      "n_c2142c1966f21f85": {
        "name": "Check backup paths",
        "imports": [],
        "source": "export default function plan({state,entries,owner,repo,path}){for(const [k,v] of Object.entries({owner,repo,path}))if(typeof v!=='string'||!v.trim()||v.startsWith('YOUR_'))throw Error('Configure GitHub '+k);if(!Array.isArray(state?.items)||!Array.isArray(entries))throw Error('Invalid workflow or directory list');if(entries.length>=1000)throw Error('Directory may exceed the GitHub listing limit');if(path.startsWith('/')||path.endsWith('/')||path.split('/').some(x=>!x||x==='.'||x==='..'))throw Error('Invalid existing directory');const seen=new Set(),items=[];for(const w of state.items){if(typeof w?.id!=='string'||!w.id||typeof w.name!=='string'||!w.name||/[\\/\\\\\\u0000-\\u001f]/.test(w.name)||w.name==='.'||w.name==='..')throw Error('Workflow name cannot be used as a file name');const name=w.name+'.json';if(seen.has(name))throw Error('Workflow names would collide');seen.add(name);const matches=entries.filter(e=>e.name===name);if(matches.length>1||matches.some(e=>e.type!=='file'||typeof e.sha!=='string'||!e.sha))throw Error('Invalid GitHub directory entry');items.push({workflowId:w.id,name,path:path+'/'+name,exists:matches.length===1})}return {items}}\n"
      },
      "n_d6d6bc172d47a033": {
        "name": "Prepare the next workflow",
        "imports": [],
        "source": "export default function next({items,previous}){const i=previous?.index??0;if(i>=items.length)return {state:{index:i},more:false,item:{},id:'-',path:'-',exists:false};const item=items[i];return {state:{index:i+1},more:true,item,id:item.workflowId,path:item.path,exists:item.exists}}\n"
      },
      "n_d07859ef06d5006f": {
        "name": "Read the n8n workflow",
        "imports": [],
        "source": "export default async function workflow({id},context){const w=await context.actions.call('n8n.get_workflow',{workflowId:id});if(!w||w.id!==id||typeof w.name!=='string'||!Array.isArray(w.nodes)||typeof w.connections!=='object'||!w.connections)throw Error('Invalid n8n workflow');return {workflow:w}}\n"
      },
      "n_f51b05bdbdfc42d4": {
        "name": "Compare the existing backup",
        "imports": [],
        "source": "export default async function compare({workflow,item,owner,repo},context){if(workflow.id!==item.workflowId||workflow.name+'.json'!==item.name)throw Error('Workflow changed during backup');let sha=null,changed=true;if(item.exists){const file=await context.actions.call('github.get_file_contents',{owner,repo,path:item.path});if(!file||file.type!=='file'||file.path!==item.path||typeof file.sha!=='string'||!file.sha||typeof file.decoded_content!=='string')throw Error('Invalid existing backup');let old;try{old=JSON.parse(file.decoded_content)}catch{throw Error('Existing backup is not JSON')}if(!old||typeof old!=='object'||Array.isArray(old))throw Error('Existing backup is not a workflow');const order=x=>Object.fromEntries(Object.keys(x).sort().map(k=>[k,x[k]]));changed=JSON.stringify(order(old))!==JSON.stringify(order(workflow));sha=file.sha}return {changed,content:JSON.stringify(workflow,null,2),sha}}\n"
      },
      "n_52db1ecf8f2d55ae": {
        "name": "Save the GitHub backup",
        "imports": [],
        "source": "export default async function write({owner,repo,path,content,sha},context){const r=await context.actions.call('github.create_or_update_file',{owner,repo,path,message:'[n8n backup] '+path,content,...(sha?{sha}:{})});if(typeof r?.content?.sha!=='string'||!r.content.sha||typeof r?.commit?.sha!=='string'||!r.commit.sha)throw Error('GitHub did not confirm the backup commit');return {result:r}}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
