    "modules": {
      "n_bc8d85434ee4835b": {
        "name": "Choose the backup repository",
        "imports": [],
        "source": "export default function config({ owner, repo, path }) {\n  for (const [k, v] of Object.entries({ owner, repo, path }))\n    if (typeof v !== \"string\" || !v.trim() || v.startsWith(\"YOUR_\"))\n      throw Error(\"Configure GitHub \" + k);\n  if (\n    path.startsWith(\"/\") ||\n    path.endsWith(\"/\") ||\n    path.split(\"/\").some((x) => !x || x === \".\" || x === \"..\")\n  )\n    throw Error(\"Invalid existing directory\");\n  return { owner, repo, path };\n}\n"
      },
      "n_d79bd8565f900f4a": {
        "name": "Collect n8n workflow pages",
        "imports": [],
        "source": "export default async function pages({ previous }, context) {\n  const s = previous ?? { items: [], cursor: null, seen: [] };\n  const r = await context.actions.call(\"n8n.list_workflows\", {\n    limit: 100,\n    ...(s.cursor ? { cursor: s.cursor } : {}),\n  });\n  if (!Array.isArray(r?.data)) throw Error(\"Invalid n8n workflow page\");\n  const c = r.nextCursor;\n  if (c !== null && (typeof c !== \"string\" || !c || s.seen.includes(c)))\n    throw Error(\"Invalid or repeated workflow cursor\");\n  return {\n    state: { items: s.items.concat(r.data), cursor: c, seen: c ? [...s.seen, c] : s.seen },\n    more: c !== null,\n  };\n}\n"
      },
      "n_c2142c1966f21f85": {
        "name": "Check backup paths",
        "imports": [],
        "source": "export default function plan({ state, entries, owner, repo, path }) {\n  for (const [k, v] of Object.entries({ owner, repo, path }))\n    if (typeof v !== \"string\" || !v.trim() || v.startsWith(\"YOUR_\"))\n      throw Error(\"Configure GitHub \" + k);\n  if (!Array.isArray(state?.items) || !Array.isArray(entries))\n    throw Error(\"Invalid workflow or directory list\");\n  if (entries.length >= 1000) throw Error(\"Directory may exceed the GitHub listing limit\");\n  if (\n    path.startsWith(\"/\") ||\n    path.endsWith(\"/\") ||\n    path.split(\"/\").some((x) => !x || x === \".\" || x === \"..\")\n  )\n    throw Error(\"Invalid existing directory\");\n  const seen = new Set(),\n    items = [];\n  for (const w of state.items) {\n    if (\n      typeof w?.id !== \"string\" ||\n      !w.id ||\n      typeof w.name !== \"string\" ||\n      !w.name ||\n      /[\\/\\\\\\u0000-\\u001f]/.test(w.name) ||\n      w.name === \".\" ||\n      w.name === \"..\"\n    )\n      throw Error(\"Workflow name cannot be used as a file name\");\n    const name = w.name + \".json\";\n    if (seen.has(name)) throw Error(\"Workflow names would collide\");\n    seen.add(name);\n    const matches = entries.filter((e) => e.name === name);\n    if (\n      matches.length > 1 ||\n      matches.some((e) => e.type !== \"file\" || typeof e.sha !== \"string\" || !e.sha)\n    )\n      throw Error(\"Invalid GitHub directory entry\");\n    items.push({ workflowId: w.id, name, path: path + \"/\" + name, exists: matches.length === 1 });\n  }\n  return { items };\n}\n"
      },
      "n_d6d6bc172d47a033": {
        "name": "Prepare the next workflow",
        "imports": [],
        "source": "export default function next({ items, previous }) {\n  const i = previous?.index ?? 0;\n  if (i >= items.length)\n    return { state: { index: i }, more: false, item: {}, id: \"-\", path: \"-\", exists: false };\n  const item = items[i];\n  return {\n    state: { index: i + 1 },\n    more: true,\n    item,\n    id: item.workflowId,\n    path: item.path,\n    exists: item.exists,\n  };\n}\n"
      },
      "n_d07859ef06d5006f": {
        "name": "Read the n8n workflow",
        "imports": [],
        "source": "export default async function workflow({ id }, context) {\n  const w = await context.actions.call(\"n8n.get_workflow\", { workflowId: id });\n  if (\n    !w ||\n    w.id !== id ||\n    typeof w.name !== \"string\" ||\n    !Array.isArray(w.nodes) ||\n    typeof w.connections !== \"object\" ||\n    !w.connections\n  )\n    throw Error(\"Invalid n8n workflow\");\n  return { workflow: w };\n}\n"
      },
      "n_f51b05bdbdfc42d4": {
        "name": "Compare the existing backup",
        "imports": [],
        "source": "export default async function compare({ workflow, item, owner, repo }, context) {\n  if (workflow.id !== item.workflowId || workflow.name + \".json\" !== item.name)\n    throw Error(\"Workflow changed during backup\");\n  let sha = null,\n    changed = true;\n  if (item.exists) {\n    const file = await context.actions.call(\"github.get_file_contents\", {\n      owner,\n      repo,\n      path: item.path,\n    });\n    if (\n      !file ||\n      file.type !== \"file\" ||\n      file.path !== item.path ||\n      typeof file.sha !== \"string\" ||\n      !file.sha ||\n      typeof file.decoded_content !== \"string\"\n    )\n      throw Error(\"Invalid existing backup\");\n    let old;\n    try {\n      old = JSON.parse(file.decoded_content);\n    } catch {\n      throw Error(\"Existing backup is not JSON\");\n    }\n    if (!old || typeof old !== \"object\" || Array.isArray(old))\n      throw Error(\"Existing backup is not a workflow\");\n    const order = (x) =>\n      Object.fromEntries(\n        Object.keys(x)\n          .sort()\n          .map((k) => [k, x[k]]),\n      );\n    changed = JSON.stringify(order(old)) !== JSON.stringify(order(workflow));\n    sha = file.sha;\n  }\n  return { changed, content: JSON.stringify(workflow, null, 2), sha };\n}\n"
      },
      "n_52db1ecf8f2d55ae": {
        "name": "Save the GitHub backup",
        "imports": [],
        "source": "export default async function write({ owner, repo, path, content, sha }, context) {\n  const r = await context.actions.call(\"github.create_or_update_file\", {\n    owner,\n    repo,\n    path,\n    message: \"[n8n backup] \" + path,\n    content,\n    ...(sha ? { sha } : {}),\n  });\n  if (\n    typeof r?.content?.sha !== \"string\" ||\n    !r.content.sha ||\n    typeof r?.commit?.sha !== \"string\" ||\n    !r.commit.sha\n  )\n    throw Error(\"GitHub did not confirm the backup commit\");\n  return { result: r };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
