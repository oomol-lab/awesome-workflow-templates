    "modules": {
      "n_b5c0c6c41a3a811c": {
        "name": "Validate files",
        "imports": [],
        "source": "export default function ({ events, email, baseId, table }) {\n  if (\n    typeof email !== \"string\" ||\n    !email.trim() ||\n    email.startsWith(\"YOUR_\") ||\n    typeof baseId !== \"string\" ||\n    !baseId.trim() ||\n    baseId.startsWith(\"YOUR_\") ||\n    typeof table !== \"string\" ||\n    !table.trim() ||\n    table.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure recipient and Airtable\");\n  if (!Array.isArray(events)) throw Error(\"Invalid event batch\");\n  for (const e of events)\n    if (\n      e?.eventType !== \"file_created\" ||\n      e.itemType !== \"file\" ||\n      typeof e.fileId !== \"string\" ||\n      !e.fileId ||\n      typeof e.name !== \"string\" ||\n      (e.createdTime !== null && typeof e.createdTime !== \"string\") ||\n      (e.modifiedTime !== null && typeof e.modifiedTime !== \"string\")\n    )\n      throw Error(\"Invalid file event\");\n  return { files: events, email, baseId, table };\n}\n"
      },
      "n_d2dbf88c069398c7": {
        "name": "Prepare next permission",
        "imports": [],
        "source": "export default function ({ files, email, previousState }) {\n  if (typeof email !== \"string\" || !email.trim() || email.startsWith(\"YOUR_\"))\n    throw Error(\"Configure the recipient email\");\n  const state = previousState ?? { index: 0, permissions: [] };\n  if (!Array.isArray(files) || !Array.isArray(state.permissions) || state.index > files.length)\n    throw Error(\"Invalid share state\");\n  if (state.index === files.length)\n    return { state, more: false, fileId: \"\", email, permissions: state.permissions };\n  return {\n    state,\n    more: true,\n    fileId: files[state.index].fileId,\n    email,\n    permissions: state.permissions,\n  };\n}\n"
      },
      "n_6d78a832df67824b": {
        "name": "Grant edit access",
        "imports": [],
        "source": "export default async function ({ fileId, email }, ctx) {\n  const r = await ctx.actions.call(\"googledrive.permissions.create\", {\n    fileId,\n    type: \"user\",\n    role: \"writer\",\n    emailAddress: email,\n    supportsAllDrives: true,\n  });\n  if (typeof r?.id !== \"string\" || !r.id) throw Error(\"Permission creation not confirmed\");\n  return { permissionId: r.id };\n}\n"
      },
      "n_1803f7d2e749e208": {
        "name": "Remember permission",
        "imports": [],
        "source": "export default function ({ state, permissionId }) {\n  return { state: { index: state.index + 1, permissions: [...state.permissions, permissionId] } };\n}\n"
      },
      "n_ae941c28efce20b1": {
        "name": "Prepare next Airtable record",
        "imports": [],
        "source": "export default function ({ files, permissions, baseId, table, previousState }) {\n  if (\n    !baseId ||\n    !table ||\n    baseId.startsWith(\"YOUR_\") ||\n    table.startsWith(\"YOUR_\") ||\n    files.length !== permissions.length\n  )\n    throw Error(\"Configure Airtable and verify permission results\");\n  const state = previousState ?? { index: 0 };\n  if (state.index === files.length)\n    return { state, more: false, baseId, table, fields: {}, count: state.index };\n  const f = files[state.index],\n    fields = {\n      FileId: f.fileId,\n      sentId: permissions[state.index],\n      FileName: f.name,\n      CreatedTime: f.createdTime,\n      ModifiedTime: f.modifiedTime,\n    };\n  return { state, more: true, baseId, table, fields, count: state.index };\n}\n"
      },
      "n_413694b436308b90": {
        "name": "Log file metadata",
        "imports": [],
        "source": "export default async function ({ baseId, table, fields }, ctx) {\n  const r = await ctx.actions.call(\"airtable.create_records\", {\n    baseId,\n    tableIdOrName: table,\n    records: [{ fields }],\n  });\n  if (\n    !Array.isArray(r?.records) ||\n    r.records.length !== 1 ||\n    typeof r.records[0].id !== \"string\" ||\n    !r.records[0].id\n  )\n    throw Error(\"Airtable creation not confirmed\");\n  return { id: r.records[0].id };\n}\n"
      },
      "n_a316fb47d0157db4": {
        "name": "Advance to next record",
        "imports": [],
        "source": "export default function ({ state }) {\n  return { state: { index: state.index + 1 } };\n}\n"
      }
    }
  },
