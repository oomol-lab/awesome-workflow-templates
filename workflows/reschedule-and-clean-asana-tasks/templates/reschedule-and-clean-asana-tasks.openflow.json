    "modules": {
      "n_cc9d25c79be71b77": {
        "name": "Choose workspace and assignee",
        "imports": [],
        "source": "export default function configure({ workspace, assignee }) {\n  if (\n    !workspace ||\n    workspace === \"YOUR_WORKSPACE_ID\" ||\n    !assignee ||\n    assignee === \"YOUR_ASSIGNEE_ID\"\n  )\n    throw Error(\"Set the workspace and assignee IDs\");\n  const fmt = new Intl.DateTimeFormat(\"en-CA\", {\n    timeZone: \"Europe/Paris\",\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n    hourCycle: \"h23\",\n  });\n  const parts = Object.fromEntries(fmt.formatToParts(new Date()).map((x) => [x.type, x.value]));\n  const today = `${parts.year}-${parts.month}-${parts.day}`;\n  const desired = Date.UTC(+parts.year, +parts.month - 1, +parts.day);\n  let utc = desired;\n  for (let i = 0; i < 3; i++) {\n    const p = Object.fromEntries(fmt.formatToParts(new Date(utc)).map((x) => [x.type, x.value]));\n    utc += desired - Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute, +p.second);\n  }\n  return { workspace, assignee, today, completedSince: new Date(utc).toISOString() };\n}\n"
      },
      "n_20bb9194683dfde5": {
        "name": "Collect task pages",
        "imports": [],
        "source": "export default function page({ page, previous }) {\n  let state = previous ?? { ids: [], seen: [], count: 0, cursor: null };\n  if (page != null) {\n    if (!Array.isArray(page.tasks)) throw Error(\"Invalid task list\");\n    const ids = [...state.ids];\n    for (const task of page.tasks) {\n      if (typeof task?.gid !== \"string\" || !task.gid) throw Error(\"Task is missing its ID\");\n      ids.push(task.gid);\n    }\n    const count = state.count + 1,\n      next = page.nextCursor;\n    if (next == null)\n      return {\n        state: { ids, seen: state.seen, count, cursor: null },\n        more: false,\n        ids,\n        cursor: null,\n      };\n    if (typeof next !== \"string\" || !next || state.seen.includes(next))\n      throw Error(\"Invalid or repeated task cursor\");\n    if (count >= 100) throw Error(\"Task listing exceeded 100 pages\");\n    state = { ids, seen: [...state.seen, next], count, cursor: next };\n  }\n  return { state, more: true, ids: state.ids, cursor: state.cursor };\n}\n"
      },
      "n_345548e41e7f409a": {
        "name": "List a task page",
        "imports": [],
        "source": "export default async function list({ workspace, assignee, completedSince, cursor }, context) {\n  return {\n    page: await context.actions.call(\"asana.list_tasks\", {\n      workspaceId: workspace,\n      assignee,\n      completedSince,\n      limit: 100,\n      ...(cursor ? { cursor } : {}),\n    }),\n  };\n}\n"
      },
      "n_129760f6e10e0515": {
        "name": "Prepare the next task",
        "imports": [],
        "source": "export default function next({ ids, previous, task }) {\n  let state = previous ?? { index: 0, tasks: [] };\n  if (task != null) {\n    if (task.gid !== ids[state.index - 1] || typeof task.completed !== \"boolean\")\n      throw Error(\"Invalid task detail\");\n    state = { index: state.index, tasks: [...state.tasks, task] };\n  }\n  if (state.index === ids.length) return { state, more: false, taskId: \"-\", tasks: state.tasks };\n  const taskId = ids[state.index];\n  return {\n    state: { index: state.index + 1, tasks: state.tasks },\n    more: true,\n    taskId,\n    tasks: state.tasks,\n  };\n}\n"
      },
      "n_8800b6f722fcba28": {
        "name": "Read a task",
        "imports": [],
        "source": "export default async function read({ taskId }, context) {\n  return await context.actions.call(\"asana.get_task\", { taskId });\n}\n"
      },
      "n_17126b29388c1cbb": {
        "name": "Select updates and deletions",
        "imports": [],
        "source": "export default function plan({ tasks, today }) {\n  const update = [],\n    remove = [];\n  for (const task of tasks) {\n    if (task.completed) {\n      remove.push(task.gid);\n      continue;\n    }\n    const due = task.due_on;\n    if (due == null || due === \"\") continue;\n    if (\n      typeof due !== \"string\" ||\n      !/^\\d{4}-\\d{2}-\\d{2}$/.test(due) ||\n      Number.isNaN(Date.parse(due + \"T00:00:00Z\")) ||\n      new Date(due + \"T00:00:00Z\").toISOString().slice(0, 10) !== due\n    )\n      throw Error(\"Invalid due date\");\n    if (due < today) update.push(task.gid);\n  }\n  return { update, remove };\n}\n"
      },
      "n_1408dfd8bb6f7a5a": {
        "name": "Prepare next update",
        "imports": [],
        "source": "export default function next({ ids, previous }) {\n  const index = previous?.index ?? 0;\n  if (index === ids.length) return { state: { index }, more: false, taskId: \"-\" };\n  return { state: { index: index + 1 }, more: true, taskId: ids[index] };\n}\n"
      },
      "n_a0e296d627136fc5": {
        "name": "Reschedule an overdue task",
        "imports": [],
        "source": "export default async function update({ taskId, today }, context) {\n  await context.actions.call(\"asana.update_task\", { taskId, dueOn: today });\n  return {};\n}\n"
      },
      "n_64b1de6c302410ed": {
        "name": "Prepare next deletion",
        "imports": [],
        "source": "export default function next({ ids, previous }) {\n  const index = previous?.index ?? 0;\n  if (index === ids.length) return { state: { index }, more: false, taskId: \"-\" };\n  return { state: { index: index + 1 }, more: true, taskId: ids[index] };\n}\n"
      },
      "n_7b53445efcc087e4": {
        "name": "Delete a completed task",
        "imports": [],
        "source": "export default async function remove({ taskId }, context) {\n  await context.actions.call(\"asana.delete_task\", { taskId });\n  return {};\n}\n"
      }
    }
