    "modules": {
      "n_8b0d23035d616426": {
        "name": "Prepare recipe search",
        "imports": [],
        "source": "export default function recipeQuery({\n  query,\n  diet,\n  minCalories,\n  maxCalories,\n  minMinutes,\n  maxMinutes,\n  maxIngredients,\n  health,\n  count,\n}) {\n  if (\n    typeof query !== \"string\" ||\n    !query.trim() ||\n    /[\\r\\n]/.test(query) ||\n    query.startsWith(\"YOUR_\")\n  )\n    throw Error(\"Configure a recipe search term\");\n  const diets = [\"balanced\", \"high-fiber\", \"high-protein\", \"low-carb\", \"low-fat\", \"low-sodium\"];\n  if (diet === \"random\") diet = diets[Math.floor(Math.random() * diets.length)];\n  if (!diets.includes(diet)) throw Error(\"Choose a supported diet filter\");\n  const allowed = [\n    \"alcohol-free\",\n    \"celery-free\",\n    \"crustacean-free\",\n    \"dairy-free\",\n    \"egg-free\",\n    \"fish-free\",\n    \"fodmap-free\",\n    \"gluten-free\",\n    \"keto-friendly\",\n    \"kidney-friendly\",\n    \"kosher\",\n    \"low-fat-abs\",\n    \"low-potassium\",\n    \"low-sugar\",\n    \"lupine-free\",\n    \"mustard-free\",\n    \"no-oil-added\",\n    \"paleo\",\n    \"peanut-free\",\n    \"pescatarian\",\n    \"pork-free\",\n    \"red-meat-free\",\n    \"sesame-free\",\n    \"shellfish-free\",\n    \"soy-free\",\n    \"sugar-conscious\",\n    \"tree-nut-free\",\n    \"vegan\",\n    \"vegetarian\",\n    \"wheat-free\",\n  ];\n  if (health === \"random\") health = allowed[Math.floor(Math.random() * allowed.length)];\n  if (!allowed.includes(health)) throw Error(\"Choose a supported health filter\");\n  for (const n of [minCalories, minMinutes])\n    if (!Number.isSafeInteger(n) || n < 0) throw Error(\"Set nonnegative search minimums\");\n  for (const n of [maxCalories, maxMinutes, maxIngredients, count])\n    if (!Number.isSafeInteger(n) || n < 1) throw Error(\"Set positive integer search limits\");\n  if (minCalories > maxCalories || minMinutes > maxMinutes || count > 20)\n    throw Error(\"Invalid search range or recipe count\");\n  const p = {\n    type: \"public\",\n    q: query.trim(),\n    diet,\n    health,\n    calories: `${minCalories}-${maxCalories}`,\n    time: `${minMinutes}-${maxMinutes}`,\n    ingr: String(maxIngredients),\n    random: \"true\",\n  };\n  return {\n    url:\n      \"https://api.edamam.com/api/recipes/v2?\" +\n      Object.entries(p)\n        .map(([k, v]) => encodeURIComponent(k) + \"=\" + encodeURIComponent(v))\n        .join(\"&\"),\n    query: query.trim(),\n    diet,\n    health,\n    maxCalories,\n    maxMinutes,\n    count,\n  };\n}\n"
      },
      "n_b6e6d4b43a85713e": {
        "name": "Format recipe links",
        "imports": [],
        "source": "export default function recipeFormat({\n  body,\n  query,\n  diet,\n  health,\n  maxCalories,\n  maxMinutes,\n  count,\n}) {\n  if (!body || !Array.isArray(body.hits)) throw Error(\"Invalid recipe response\");\n  if (!body.hits.length) throw Error(\"No recipes matched the selected filters\");\n  const escape = (s) =>\n    String(s)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  const validUrl = (u) => {\n    if (typeof u !== \"string\" || /[\\s\\x00-\\x1f\\x7f\\\\]/.test(u) || /%(?![0-9a-f]{2})/i.test(u))\n      return false;\n    const m = /^https:\\/\\/([^/?#]+)(?:[/?#].*)?$/i.exec(u);\n    if (!m || m[1].length > 253) return false;\n    const labels = m[1].replace(/\\.$/, \"\").split(\".\");\n    if (\n      !labels.every(\n        (x) => x.length > 0 && x.length <= 63 && /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(x),\n      )\n    )\n      return false;\n    if (\n      labels.every((x) => /^\\d+$/.test(x)) &&\n      (labels.length !== 4 || labels.some((x) => Number(x) > 255))\n    )\n      return false;\n    return true;\n  };\n  const links = body.hits.slice(0, count).map(({ recipe }) => {\n    const u = recipe?.shareAs,\n      name = recipe?.label;\n    if (typeof name !== \"string\" || !name.trim() || !validUrl(u))\n      throw Error(\"Invalid recipe link or label\");\n    return `<li><a href=\"${escape(u)}\">${escape(name)}</a></li>`;\n  });\n  return {\n    html: \"Here are your recipes for today:<br><ul>\" + links.join(\"\") + \"</ul>\",\n    subject: `${links.length} ${diet}, ${health} ${query} recipes up to ${maxCalories} calories per serving and ${maxMinutes} minutes`,\n  };\n}\n"
      }
    }
  },
  "presentation": {
