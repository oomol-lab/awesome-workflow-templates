        "method": "POST",
        "options": {},
        "jsonBody": "{\n \"keyword\": \"ai\",\n \"cfda\": null,\n \"agencies\": null,\n \"sortBy\": \"openDate|desc\",\n \"rows\": 5000,\n \"eligibilities\": null,\n \"fundingCategories\": null,\n \"fundingInstruments\": null,\n \"dateRange\": \"1\",\n \"oppStatuses\": \"forecasted|posted\"\n}",
        "sendBody": true,
        "specifyBody": "json"
      },
      "typeVersion": 4.2
    },
    {
      "id": "track-ai-grants-and-send-digest-9",
      "name": "Get New Eligible Grants Today",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1980,
        0
      ],
      "parameters": {
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GRANTS_TABLE"
        },
        "options": {},
        "operation": "search",
        "filterByFormula": "=AND(\n {Status} = 'New',\n {Eligibility?} = 'Yes',\n IS_SAME(DATETIME_FORMAT(Created, 'YYYY-MM-DD'), DATETIME_FORMAT(TODAY(), 'YYYY-MM-DD'))\n)",
        "returnAll": true
      },
      "typeVersion": 2.1
    },
    {
      "id": "track-ai-grants-and-send-digest-10",
      "name": "Generate Email",
      "type": "n8n-nodes-base.code",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const esc = (s) =>\n  String(s ?? \"\").replace(\n    /[&<>\"']/g,\n    (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c],\n  );\nconst html =\n  \"<h1>Latest AI Grants</h1>\" +\n  $input\n    .all()\n    .map(({ json: f }) => {\n      const u = String(f.URL ?? \"\");\n      if (!/^https:\\/\\/(?:www\\.)?grants\\.gov\\/search-results-detail\\/\\d+$/.test(u))\n        throw Error(\"Invalid grant URL\");\n      return (\n        \"<h2>\" +\n        esc(f.Title) +\n        \"</h2><p>\" +\n        esc(f.Agency) +\n        \"</p><p>\" +\n        esc(f.Goal) +\n        \"</p><ul>\" +\n        String(f[\"Success Criteria\"] ?? \"\")\n          .split(\"\\n\")\n          .map((x) => \"<li>\" + esc(x) + \"</li>\")\n          .join(\"\") +\n        \"</ul><p>Posted: \" +\n        esc(f[\"Posted Date\"]) +\n        \"; Respond by: \" +\n        esc(f[\"Response Date\"]) +\n        '</p><a href=\"' +\n        esc(u) +\n        '\">See details</a>'\n      );\n    })\n    .join(\"\");\nreturn [{ json: { html } }];\n"
      },
      "typeVersion": 2
    },
