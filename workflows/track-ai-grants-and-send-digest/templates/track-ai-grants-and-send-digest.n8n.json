    {
      "name": "Validate grant search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (\n  !Array.isArray($json.oppHits) ||\n  !Number.isInteger($json.hitCount) ||\n  $json.hitCount > $json.oppHits.length\n)\n  throw Error(\"Incomplete grant search\");\nreturn { json: $json };\n"
