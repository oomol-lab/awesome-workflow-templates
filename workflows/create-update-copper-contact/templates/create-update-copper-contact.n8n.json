            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copper": {
      "main": [
        [
          {
            "node": "Confirm created person",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm created person": {
      "main": [
        [
          {
            "node": "Copper1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copper1": {
      "main": [
        [
          {
            "node": "Confirm update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm update": {
      "main": [
        [
          {
            "node": "Copper2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copper2": {
      "main": [
        [
          {
            "node": "Verify person",
            "type": "main",
