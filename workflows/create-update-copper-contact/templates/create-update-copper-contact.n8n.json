{
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        320
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "create-update-copper-contact-0"
    },
    {
      "name": "Set contact details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const name = \"\",\n  email = \"\",\n  phone = \"\";\nif (!name.trim() || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()) || !phone.trim())\n  throw Error(\"Enter contact name, email and phone\");\nreturn [{ json: { name: name.trim(), email: email.trim(), phone: phone.trim() } }];\n"
      },
      "id": "create-update-copper-contact-1"
    },
    {
      "name": "Copper",
      "type": "n8n-nodes-base.copper",
      "position": [
        450,
        320
      ],
      "parameters": {
        "name": "={{ $(\"Set contact details\").first().json.name }}",
        "resource": "person",
        "additionalFields": {
          "emails": {
            "emailFields": [
              {
                "email": "={{ $(\"Set contact details\").first().json.email }}",
                "category": "work"
              }
            ]
          }
        }
      },
      "typeVersion": 1,
      "id": "create-update-copper-contact-2"
    },
    {
      "name": "Confirm created person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $input.first().json.id;\nif (!Number.isSafeInteger(id) || id < 1) throw Error(\"Copper did not return a person ID\");\nreturn $input.all();\n"
      },
      "id": "create-update-copper-contact-3"
    },
    {
      "name": "Copper1",
      "type": "n8n-nodes-base.copper",
      "position": [
        650,
        320
      ],
      "parameters": {
        "personId": "={{ $(\"Copper\").first().json.id }}",
        "resource": "person",
        "operation": "update",
        "updateFields": {
          "phone_numbers": {
            "phoneFields": [
              {
                "number": "={{ $(\"Set contact details\").first().json.phone }}",
                "category": "work"
              }
            ]
          }
        }
      },
      "typeVersion": 1,
      "id": "create-update-copper-contact-4"
    },
    {
      "name": "Confirm update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const id = $(\"Copper\").first().json.id;\nif ($input.first().json.id !== id) throw Error(\"Copper did not confirm the same person\");\nreturn $input.all();\n"
      },
      "id": "create-update-copper-contact-5"
    },
    {
      "name": "Copper2",
      "type": "n8n-nodes-base.copper",
      "position": [
        850,
        320
      ],
      "parameters": {
        "personId": "={{ $(\"Copper\").first().json.id }}",
        "resource": "person",
        "operation": "get"
      },
      "typeVersion": 1,
      "id": "create-update-copper-contact-6"
    },
    {
      "name": "Verify person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function result({ body, id, email, phone }) {\n  if (\n    !body ||\n    body.id !== id ||\n    !Array.isArray(body.emails) ||\n    !body.emails.some((x) => x.email === email && x.category === \"work\") ||\n    !Array.isArray(body.phone_numbers) ||\n    !body.phone_numbers.some((x) => x.number === phone && x.category === \"work\")\n  )\n    throw Error(\"Copper did not return the expected person\");\n  return { person: body };\n}\n\nconst s = $(\"Set contact details\").first().json,\n  id = $(\"Copper\").first().json.id;\nreturn [{ json: result({ body: $input.first().json, id, email: s.email, phone: s.phone }).person }];\n"
      },
      "id": "create-update-copper-contact-7"
    }
  ],
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set contact details",
