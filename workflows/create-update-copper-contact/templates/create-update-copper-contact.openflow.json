    "modules": {
      "n_78b9c56736b1fb9a": {
        "name": "Prepare contact details",
        "imports": [],
        "source": "export default function setup({userEmail,name,email,phone}){if(typeof userEmail!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(userEmail.trim())||typeof email!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(email.trim()))throw Error('Enter valid account and contact emails');if(typeof name!=='string'||!name.trim()||typeof phone!=='string'||!phone.trim())throw Error('Enter a name and phone');return{userEmail:userEmail.trim(),name:name.trim(),email:email.trim(),phone:phone.trim(),create:{name:name.trim(),emails:[{email:email.trim(),category:'work'}]},update:{phone_numbers:[{number:phone.trim(),category:'work'}]}};}\n"
      },
      "n_8849ce6a50a539a2": {
        "name": "Identify person",
        "imports": [],
        "source": "export default function created({body}){const id=body?.id;if(!Number.isSafeInteger(id)||id<1)throw Error('Copper did not return a person ID');return{id,url:'https://api.copper.com/developer_api/v1/people/'+id};}\n"
      },
      "n_47fabe889df568a4": {
        "name": "Confirm update",
        "imports": [],
        "source": "export default function updated({body,id}){if(!body||body.id!==id)throw Error('Copper did not confirm the same person');return{ok:true};}\n"
      },
      "n_b04de57e70ad4c1a": {
        "name": "Verify person",
        "imports": [],
        "source": "export default function result({body,id,email,phone}){if(!body||body.id!==id||!Array.isArray(body.emails)||!body.emails.some(x=>x.email===email&&x.category==='work')||!Array.isArray(body.phone_numbers)||!body.phone_numbers.some(x=>x.number===phone&&x.category==='work'))throw Error('Copper did not return the expected person');return{person:body};}\n"
      }
    }
