    "modules": {
      "n_cc58135cf5e6405f": {
        "name": "Choose the collection",
        "imports": [],
        "source": "export default function prepare({baseUrl,collection}){let url;try{url=new URL(baseUrl)}catch{throw Error('Configure the Cockpit URL')}if(url.protocol!=='https:'||url.username||url.password||url.search||url.hash||!collection||collection.includes('/'))throw Error('Configure an HTTPS Cockpit URL and collection name');return{url:url.toString().replace(/\\/$/,'')+'/api/collections/get/'+encodeURIComponent(collection)}}\n"
      },
      "n_5a1bd1b9fe0fb9df": {
        "name": "Collect entries",
        "imports": [],
        "source": "export default function check({body,statusCode,bodyEncoding}){if(statusCode!==200||bodyEncoding||!Array.isArray(body))throw Error('Cockpit did not return a collection');return{entries:body}}\n"
      }
    }
