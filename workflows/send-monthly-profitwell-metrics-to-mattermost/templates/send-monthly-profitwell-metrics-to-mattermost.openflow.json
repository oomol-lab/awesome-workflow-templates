    "modules": {
      "n_3741e87cae4e506d": {
        "name": "Format the monthly metrics",
        "imports": [],
        "source": "export default function format({ body, channelId }) {\n  if (typeof channelId !== \"string\" || !channelId.trim())\n    throw Error(\"Set the Mattermost channel ID\");\n  if (!body || typeof body !== \"object\" || !body.data || typeof body.data !== \"object\")\n    throw Error(\"Invalid ProfitWell response\");\n  const fields = [\n    [\"Active Customers\", \"active_customers\"],\n    [\"Trailing Customers\", \"active_trialing_customers\"],\n    [\"New Customers\", \"new_customers\"],\n    [\"Growth Rate\", \"growth_rate\"],\n    [\"Recurring Revenue\", \"recurring_revenue\"],\n  ];\n  const lines = fields.map(([label, key]) => {\n    const entries = body.data[key];\n    if (!Array.isArray(entries) || !entries.length) throw Error(\"Missing monthly metric \" + key);\n    const last = entries[entries.length - 1];\n    if (\n      !last ||\n      !(last.value === null || (typeof last.value === \"number\" && Number.isFinite(last.value)))\n    )\n      throw Error(\"Invalid monthly metric \" + key);\n    return label + \": \" + String(last.value);\n  });\n  return { channelId, message: lines.join(\"\\n\") };\n}\n"
      }
    }
