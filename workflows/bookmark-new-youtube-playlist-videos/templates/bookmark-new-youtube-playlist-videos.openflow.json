    "modules": {
      "n_a4f2c8f527bd0235": {
        "name": "Select and remember new videos",
        "imports": [],
        "source": "export default async function select({playlistItems},context){if(!Array.isArray(playlistItems))throw Error('Invalid playlist response');const rows=playlistItems.map(item=>{const s=item?.snippet,id=s?.resourceId?.videoId;if(typeof id!=='string'||!/^[A-Za-z0-9_-]+$/.test(id)||typeof s?.title!=='string'||!s.title||typeof s?.videoOwnerChannelTitle!=='string'||!s.videoOwnerChannelTitle)throw Error('Each playlist item requires a video ID, title and owner');const title=s.videoOwnerChannelTitle+' | '+s.title;if(title.length>1000)throw Error('Bookmark title exceeds 1000 characters');return{id,link:'https://www.youtube.com/watch?v='+encodeURIComponent(id),title}});if(!rows.length)return{plans:[],count:0};const saved=await context.state.get('youtube-raindrop-ids');if(saved!==null&&(!Array.isArray(saved)||saved.some(x=>typeof x!=='string')))throw Error('Invalid saved video IDs');const ids=rows.map(x=>x.id),fresh=saved===null?rows:rows.filter(x=>!saved.includes(x.id));await context.state.set('youtube-raindrop-ids',saved===null?ids:[...fresh.map(x=>x.id),...saved]);return{plans:fresh,count:fresh.length}}\n"
      },
      "n_8c6956f2c3a01419": {
        "name": "Prepare the next bookmark",
        "imports": [],
        "source": "export default function next({plans,previousState,result,item}){const state=previousState??{index:0,created:[]};if(previousState){if(result!==true||!item||typeof item!=='object'||Array.isArray(item))throw Error('Raindrop did not return a created bookmark');state.created.push(item);state.index++}if(state.index===plans.length)return{state,more:false,link:'https://example.com',title:'unused',count:state.created.length};if(!Array.isArray(plans)||state.index>plans.length)throw Error('Invalid bookmark state');const p=plans[state.index];return{state,more:true,link:p.link,title:p.title,count:state.created.length}}\n"
      }
    }
