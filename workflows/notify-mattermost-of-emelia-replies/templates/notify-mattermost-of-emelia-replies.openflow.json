    "modules": {
      "n_8e618914343ae606": {
        "name": "Prepare the reply notice",
        "imports": [],
        "source": "export default function prepare({ body, channelId }) {\n  if (body.event !== \"REPLIED\") throw Error(\"Expected an Emelia REPLIED event\");\n  if (!channelId || channelId.startsWith(\"YOUR_\")) throw Error(\"Configure the Mattermost channel\");\n  const c = body.contact;\n  if (!c || typeof c !== \"object\") throw Error(\"Missing contact\");\n  return {\n    channelId,\n    message: `${c.firstName} from ${c.company} has replied back to your campaign.`,\n  };\n}\n"
      }
    }
  },
