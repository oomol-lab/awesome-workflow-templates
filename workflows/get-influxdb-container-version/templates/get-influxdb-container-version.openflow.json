    "modules": {
      "n_52497d0de1b549f5": {
        "name": "Validate server and request",
        "imports": [],
        "source": "export default function f({ body, headers, secret, server, engine }) {\n  const token = Object.entries(headers).find(([k]) => k.toLowerCase() === \"authorization\")?.[1];\n  let valid =\n    !!secret &&\n    token === secret &&\n    body.server_domain === server &&\n    body.command === \"app_version\" &&\n    /^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,200}$/.test(body.domain);\n  if (!valid) throw Error(\"Invalid request\");\n  return {\n    valid,\n    url: valid\n      ? engine.replace(/\\/$/, \"\") +\n        \"/v1.44/containers/\" +\n        encodeURIComponent(body.domain + \"_influxdb\") +\n        \"/json\"\n      : engine,\n    result: { status: \"error\", message: \"Invalid request\", data: \"\" },\n  };\n}\n"
      },
      "n_0d251f521cc16ce8": {
        "name": "Prepare fixed version command",
        "imports": [],
        "source": "export default function f({ url }) {\n  return {\n    url: url.replace(/\\/json$/, \"/exec\"),\n    base: url.split(\"/v1.44/\")[0],\n    body: { AttachStdout: true, AttachStderr: true, Tty: false, Cmd: [\"influxd\", \"version\"] },\n  };\n}\n"
      },
      "n_d7c57488e685c05d": {
        "name": "Run version command",
        "imports": [],
        "source": "export default async function start({ base, token, status, body }, ctx) {\n  if (status !== 201 || !body?.Id || !/^[a-f0-9]{8,128}$/i.test(body.Id))\n    throw Error(\"Docker exec creation failed\");\n  const id = body.Id,\n    r = await ctx.fetch(base + \"/v1.44/exec/\" + id + \"/start\", {\n      method: \"POST\",\n      headers: { Authorization: \"Bearer \" + token, \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ Detach: false, Tty: false }),\n    });\n  if (!r.ok) throw Error(\"Docker exec start failed\");\n  const b = new Uint8Array(await r.arrayBuffer());\n  let i = 0,\n    parts = [];\n  while (i < b.length) {\n    if (i + 8 > b.length || ![1, 2].includes(b[i]) || b[i + 1] || b[i + 2] || b[i + 3])\n      throw Error(\"Invalid Docker exec frame\");\n    const size = b[i + 4] * 16777216 + b[i + 5] * 65536 + b[i + 6] * 256 + b[i + 7];\n    i += 8;\n    if (i + size > b.length) throw Error(\"Truncated Docker exec frame\");\n    parts.push(b.subarray(i, i + size));\n    i += size;\n  }\n  let all = new Uint8Array(parts.reduce((n, c) => n + c.length, 0)),\n    at = 0;\n  for (const c of parts) {\n    all.set(c, at);\n    at += c.length;\n  }\n  return { id, url: base + \"/v1.44/exec/\" + id + \"/json\", text: new TextDecoder().decode(all) };\n}\n"
      },
      "n_232d0185b40ff0d7": {
        "name": "Return version result",
        "imports": [],
        "source": "export default function f({ status, body, text }) {\n  if (status !== 200 || body?.Running !== false || body?.ExitCode !== 0 || !text.trim())\n    throw Error(\"Version command did not complete successfully\");\n  return { result: { status: \"success\", message: \"\", data: { version: text.trimEnd() } } };\n}\n"
      }
    }
