    {
      "name": "Calculate monthly invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const month = $now.toFormat(\"yyyy-MM\"),\n  rows = $input.all().filter((x) => String(x.json.date || \"\").startsWith(month));\nif (!rows.length) return [];\nlet tokens = 0,\n  cost = 0;\nfor (const { json: r } of rows) {\n  const t = Number(r.total_tokens),\n    c = Number(r.total_cost);\n  if (!Number.isFinite(t) || !Number.isFinite(c) || t < 0 || c < 0)\n    throw Error(\"Invalid usage row\");\n  tokens += t;\n  cost += c;\n}\nreturn [\n  {\n    json: {\n      month,\n      clientId: \"YOUR_CLIENT_ID\",\n      subject: \"Invoice for \" + month,\n      body: `Hello,\\nThis is an invoice for ${month}.\\n\\nTotal usage: ${tokens} tokens\\nTotal token cost: $${cost.toFixed(5)}\\nTax @ 20%: $${(cost * 0.2).toFixed(5)}\\nTotal payable: $${(cost * 1.2).toFixed(5)}\\n\\nPayable within 14 days.\\nThank you for your custom.`,\n    },\n  },\n];\n"
      },
