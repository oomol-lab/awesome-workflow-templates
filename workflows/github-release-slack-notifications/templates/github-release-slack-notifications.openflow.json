    "modules": {
      "n_2cf5e2a1b50c2d07": {
        "name": "Format the complete release notice",
        "imports": [],
        "source": "export default function githubReleaseParts({ body }) {\n  if (!body || typeof body !== 'object' || Array.isArray(body) || typeof body.action !== 'string' || !body.action || !body.repository || !body.release) throw new Error('Expected a GitHub release event');\n  const repository = body.repository.full_name, tag = body.release.tag_name, notes = body.release.body, link = body.release.html_url;\n  if (typeof repository !== 'string' || !repository.trim() || typeof tag !== 'string' || !tag.trim() || (notes != null && typeof notes !== 'string') || typeof link !== 'string') throw new Error('The release is missing its repository, tag, notes or URL');\n  if (!/^https:\\/\\/[^\\s/?#@<>\"'\\\\]+(?:[/?#][^\\s<>\"'\\\\]*)?$/.test(link)) throw new Error('Expected the release’s real HTTPS URL without credentials');\n  const text = 'New release is available in ' + repository + ' !\\n' + tag + ' Details:\\n' + (notes ?? '') + '\\n\\nLink: ' + link;\n  const chunks = [];\n  let chunk = '';\n  for (const character of text) {\n    if (chunk.length + character.length > 3900) { chunks.push(chunk); chunk = ''; }\n    chunk += character;\n  }\n  if (chunk) chunks.push(chunk);\n  const parts = chunks.map((content, index) => chunks.length > 1 ? 'Part ' + (index + 1) + '/' + chunks.length + '\\n' + content : content);\n  if (parts.some(part => part.length > 4000)) throw new Error('The release part exceeds the message budget');\n  return { parts, action: body.action };\n}\n"
      },
      "n_60dbb7c5c6cfef02": {
        "name": "Prepare the next Slack message",
        "imports": [],
        "source": "export default function githubReleaseProgress({ parts, previousState, messageTs, messageChannelId, channelId }) {\n  if (!Array.isArray(parts) || !parts.length || typeof channelId !== 'string' || !channelId.trim()) throw new Error('Expected the release parts and destination channel ID');\n  let state;\n  if (previousState == null) state = { index: 0, receipts: [] };\n  else {\n    if (!Number.isInteger(previousState.index) || previousState.index < 1 || previousState.index > parts.length || !Array.isArray(previousState.receipts) || previousState.receipts.length !== previousState.index - 1) throw new Error('Invalid release notification progress');\n    if (typeof messageTs !== 'string' || !/^\\d+\\.\\d+$/.test(messageTs) || messageChannelId !== channelId) throw new Error('Slack did not confirm the release notification in the requested channel; posting may already have occurred');\n    state = { index: previousState.index, receipts: [...previousState.receipts, { ts: messageTs, channelId: messageChannelId }] };\n  }\n  const text = parts[state.index];\n  if (text == null) return { state, more: false, text: '', channelId, count: state.receipts.length };\n  if (typeof text !== 'string' || !text || text.length > 4000) throw new Error('Invalid release message part');\n  return { state: { index: state.index + 1, receipts: state.receipts }, more: true, text, channelId, count: state.receipts.length };\n}\n"
      }
