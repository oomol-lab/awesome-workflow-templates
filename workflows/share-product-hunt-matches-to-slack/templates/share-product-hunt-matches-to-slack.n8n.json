              "leftValue": "={{ $json.data.modelResponse }}",
              "rightValue": "[NA]"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "share-product-hunt-matches-to-slack-2",
      "name": "Look up products",
      "type": "n8n-nodes-base.airtop",
      "position": [
        440,
        -100
      ],
      "parameters": {
        "url": "https://www.producthunt.com/",
        "prompt": "=Extract up to 5 product launches that are {{ $json[\"Relevant Products\"] }} for each product extract the title and URL (if exists).\n\nReturn format:\nToday's [{{ $json[\"Relevant Products\"] }}] on Producthunt\n1. Title 1 (URL 1)\n2. Title 2 (URL 2)\nand so on\n\nIf you cannot find any relevant products, return [NA]",
        "resource": "extraction",
        "operation": "query",
        "sessionMode": "new",
        "additionalFields": {}
      },
      "typeVersion": 1
    },
    {
      "id": "share-product-hunt-matches-to-slack-3",
      "name": "Send slack message",
      "type": "n8n-nodes-base.slack",
      "position": [
        880,
        -100
      ],
      "parameters": {
        "text": "={{ $json.data.modelResponse }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID"
        },
        "otherOptions": {}
      },
      "typeVersion": 2.3
    },
    {
      "id": "share-product-hunt-matches-to-slack-4",
      "name": "Trigger daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        -100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "typeVersion": 1.2
    }
