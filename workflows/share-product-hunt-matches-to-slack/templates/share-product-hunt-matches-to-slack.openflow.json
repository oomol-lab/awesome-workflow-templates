        "source": "export default function session({ body }) {\n  const x = body?.data;\n  if (!x || typeof x.id !== \"string\" || !/^[-a-z0-9]+$/i.test(x.id) || body.errors?.length)\n    throw Error(\"Invalid Airtop session\");\n  const base = \"https://api.airtop.ai/api/v1/sessions/\" + encodeURIComponent(x.id);\n  if (![\"initializing\", \"running\", \"active\"].includes(x.status))\n    throw Error(\"Invalid Airtop session state\");\n  return {\n    windowUrl: base + \"/windows\",\n    terminateUrl: base,\n    ready: x.status === \"running\" || x.status === \"active\",\n  };\n}\n"
      },
      "n_4d108fcac145d98b": {
        "name": "Evaluate browser readiness",
        "imports": [],
        "source": "export default function poll({ body, previous }) {\n  const count = (previous?.count ?? 0) + 1;\n  if (!Number.isInteger(count) || count > 60) throw Error(\"Airtop session did not become ready\");\n  if (body?.errors?.length) throw Error(\"Airtop session status failed\");\n  const status = body?.data?.status;\n  if (![\"initializing\", \"running\", \"active\"].includes(status))\n    throw Error(\"Invalid Airtop session status\");\n  if (status === \"initializing\" && count === 60) throw Error(\"Airtop session did not become ready\");\n  return { state: { count }, ready: status === \"running\" || status === \"active\" };\n}\n"
      },
      "n_f624bc44c9699023": {
        "name": "Prepare the product search",
        "imports": [],
        "source": "export default function window({ body, terminateUrl, topic }) {\n  const id = body?.data?.windowId;\n  if (\n    typeof id !== \"string\" ||\n    !/^[-a-z0-9]+$/i.test(id) ||\n    body.errors?.length ||\n    typeof topic !== \"string\" ||\n    !topic.trim() ||\n    topic.length > 500\n  )\n    throw Error(\"Invalid Airtop window or topic\");\n  return {\n    queryUrl: terminateUrl + \"/windows/\" + encodeURIComponent(id) + \"/page-query\",\n    query: {\n      prompt: `Extract up to 5 product launches that are ${topic} for each product extract the title and URL (if exists).\\n\\nReturn format:\\nToday's [${topic}] on Producthunt\\n1. Title 1 (URL 1)\\n2. Title 2 (URL 2)\\nand so on\\n\\nIf you cannot find any relevant products, return [NA]`,\n      configuration: { experimental: { includeVisualAnalysis: \"disabled\" } },\n    },\n  };\n}\n"
      },
      "n_af3d69e50e78f719": {
        "name": "Check the extracted launches",
        "imports": [],
        "source": "export default function result({ body }) {\n  const text = body?.data?.modelResponse;\n  if (\n    typeof text !== \"string\" ||\n    !text.trim() ||\n    body.errors?.length ||\n    body.meta?.status === \"error\"\n  )\n    throw Error(\"Invalid Airtop extraction result\");\n  return { send: !text.includes(\"[NA]\"), text };\n}\n"
      }
    }
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
