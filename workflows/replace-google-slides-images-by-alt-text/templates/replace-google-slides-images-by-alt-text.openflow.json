    "modules": {
      "n_ff4f090db46b877b": {
        "name": "Read request",
        "imports": [],
        "source": "export default function read({ body }) {\n  return {\n    presentationId: body.presentation_id,\n    imageKey: body.image_key,\n    imageUrl: body.image_url,\n  };\n}\n"
      },
      "n_36bcb222cea37a24": {
        "name": "Find matching images",
        "imports": [],
        "source": "export default function prepare({ slides, imageKey, imageUrl }) {\n  const ids = (slides || [])\n    .flatMap((slide) => slide.pageElements || [])\n    .filter((el) => el.image && el.description === imageKey)\n    .map((el) => el.objectId);\n  if (!ids.length) throw Error(\"No image has the requested alt-text description\");\n  return {\n    requests: ids.flatMap((objectId) => [\n      {\n        replaceImage: { imageObjectId: objectId, url: imageUrl, imageReplaceMethod: \"CENTER_CROP\" },\n      },\n      { updatePageElementAltText: { objectId, description: imageKey } },\n    ]),\n  };\n}\n"
      },
      "n_960965096c5f08fb": {
        "name": "Confirm replacement",
        "imports": [],
        "source": "export default function confirm() {\n  return { response: { message: \"Image replaced.\" } };\n}\n"
      }
    }
