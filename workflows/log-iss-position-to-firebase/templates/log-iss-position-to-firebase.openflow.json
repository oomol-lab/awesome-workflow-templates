    "modules": {
      "n_6dd285b03b165162": {
        "name": "Prepare the current timestamp",
        "imports": [],
        "source": "export default function query() {const timestamp=Math.floor(Date.now()/1000);return {timestamp,url:'https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps='+timestamp};}\n"
      },
      "n_d25d7971bd346961": {
        "name": "Prepare the Firebase record",
        "imports": [],
        "source": "function row({body,timestamp}) {\n if(!Array.isArray(body)||body.length!==1)throw Error('Expected one ISS position');const p=body[0];\n if(!p||p.id!==25544||typeof p.name!=='string'||!p.name||!Number.isFinite(p.latitude)||p.latitude < -90||p.latitude>90||!Number.isFinite(p.longitude)||p.longitude < -180||p.longitude>180||p.timestamp!==timestamp)throw Error('ISS position does not match the request');\n const position={name:p.name,latitude:p.latitude,longitude:p.longitude,timestamp:p.timestamp};return {position,rows:[{json:position}]};\n}\n\nexport default function firebaseRow({body,timestamp,databaseUrl}){if(typeof databaseUrl!=='string'||databaseUrl.includes('YOUR-DATABASE'))throw Error('Configure database URL');let u;try{u=new URL(databaseUrl)}catch{throw Error('Invalid database URL')}if(u.protocol!=='https:'||u.username||u.password||u.port||u.search||u.hash||u.pathname!=='/iss.json'||!(/^[-a-z0-9]+\\.firebaseio\\.com$/.test(u.hostname)||/^[-a-z0-9]+\\.[a-z0-9-]+\\.firebasedatabase\\.app$/.test(u.hostname)))throw Error('Use the Firebase database /iss.json URL');const p=row({body,timestamp}).position;return{url:u.href,position:{latitude:p.latitude,longitude:p.longitude,timestamp:p.timestamp}}}\n"
      },
      "n_b768840d671f3438": {
        "name": "Confirm the push key",
        "imports": [],
        "source": "export default function confirm({body}){if(!body||typeof body.name!=='string'||!body.name)throw Error('Firebase did not confirm the push key');return{key:body.name}}\n"
      }
    }
