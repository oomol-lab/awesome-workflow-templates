    "modules": {
      "n_6dd285b03b165162": {
        "name": "Prepare the current timestamp",
        "imports": [],
        "source": "export default function query() {\n  const timestamp = Math.floor(Date.now() / 1000);\n  return {\n    timestamp,\n    url: \"https://api.wheretheiss.at/v1/satellites/25544/positions?timestamps=\" + timestamp,\n  };\n}\n"
      },
      "n_d25d7971bd346961": {
        "name": "Prepare the Firebase record",
        "imports": [],
        "source": "function row({ body, timestamp }) {\n  if (!Array.isArray(body) || body.length !== 1) throw Error(\"Expected one ISS position\");\n  const p = body[0];\n  if (\n    !p ||\n    p.id !== 25544 ||\n    typeof p.name !== \"string\" ||\n    !p.name ||\n    !Number.isFinite(p.latitude) ||\n    p.latitude < -90 ||\n    p.latitude > 90 ||\n    !Number.isFinite(p.longitude) ||\n    p.longitude < -180 ||\n    p.longitude > 180 ||\n    p.timestamp !== timestamp\n  )\n    throw Error(\"ISS position does not match the request\");\n  const position = {\n    name: p.name,\n    latitude: p.latitude,\n    longitude: p.longitude,\n    timestamp: p.timestamp,\n  };\n  return { position, rows: [{ json: position }] };\n}\n\nexport default function firebaseRow({ body, timestamp, databaseUrl }) {\n  if (typeof databaseUrl !== \"string\" || databaseUrl.includes(\"YOUR-DATABASE\"))\n    throw Error(\"Configure database URL\");\n  let u;\n  try {\n    u = new URL(databaseUrl);\n  } catch {\n    throw Error(\"Invalid database URL\");\n  }\n  if (\n    u.protocol !== \"https:\" ||\n    u.username ||\n    u.password ||\n    u.port ||\n    u.search ||\n    u.hash ||\n    u.pathname !== \"/iss.json\" ||\n    !(\n      /^[-a-z0-9]+\\.firebaseio\\.com$/.test(u.hostname) ||\n      /^[-a-z0-9]+\\.[a-z0-9-]+\\.firebasedatabase\\.app$/.test(u.hostname)\n    )\n  )\n    throw Error(\"Use the Firebase database /iss.json URL\");\n  const p = row({ body, timestamp }).position;\n  return {\n    url: u.href,\n    position: { latitude: p.latitude, longitude: p.longitude, timestamp: p.timestamp },\n  };\n}\n"
      },
      "n_b768840d671f3438": {
        "name": "Confirm the push key",
        "imports": [],
        "source": "export default function confirm({ body }) {\n  if (!body || typeof body.name !== \"string\" || !body.name)\n    throw Error(\"Firebase did not confirm the push key\");\n  return { key: body.name };\n}\n"
      }
