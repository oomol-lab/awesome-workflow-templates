    },
    {
      "name": "Validate uploaded image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!/^file-[A-Za-z0-9_-]+$/.test($json.id ?? \"\")) throw Error(\"Unknown upload outcome\");\nreturn { json: { fileId: $json.id } };\n"
      },
      "position": [
        4400,
        0
      ],
      "id": "caption-and-overlay-remote-image-20"
    },
    {
      "name": "Request caption from Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fileId:$json.fileId} }}",
        "options": {
          "timeout": 65000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        4620,
        0
      ],
      "id": "caption-and-overlay-remote-image-21"
    },
    {
      "name": "Restore original image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $(\"Get Image\").item;\nif (!original.binary?.data) throw Error(\"Missing original image\");\nreturn { json: $json, binary: original.binary };\n"
      },
      "position": [
        4840,
        0
      ],
      "id": "caption-and-overlay-remote-image-22"
    },
    {
      "name": "Restore original for Open Flow",
