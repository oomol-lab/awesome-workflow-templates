      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $(\"Fetch image for Open Flow\").item;\nif (!original.binary?.data) throw Error(\"Missing original image\");\nreturn { json: $json, binary: original.binary };\n"
      },
      "position": [
        5060,
        0
      ],
      "id": "caption-and-overlay-remote-image-23"
    }
