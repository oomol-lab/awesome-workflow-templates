    "modules": {
      "n_e65b52d940af7469": {
        "name": "Prepare image caption request",
        "imports": [],
        "source": "export default function ({ body }) {\n  const id = String(body?.fileId || \"\");\n  if (!/^file-[A-Za-z0-9_-]+$/.test(id)) throw Error(\"Expected an OpenAI image file ID\");\n  return {\n    request: {\n      model: \"gpt-5.4-mini\",\n      input: [\n        {\n          role: \"user\",\n          content: [\n            {\n              type: \"input_text\",\n              text: \"Describe the supplied image in a caption with a punny title. Include who, when, where and context only when visible or known; do not invent details. Return JSON with caption_title and caption_text.\",\n            },\n            { type: \"input_image\", file_id: id, detail: \"auto\" },\n          ],\n        },\n      ],\n      text: {\n        format: {\n          type: \"json_schema\",\n          name: \"caption\",\n          strict: true,\n          schema: {\n            type: \"object\",\n            properties: { caption_title: { type: \"string\" }, caption_text: { type: \"string\" } },\n            required: [\"caption_title\", \"caption_text\"],\n            additionalProperties: false,\n          },\n        },\n      },\n    },\n  };\n}\n"
      },
      "n_ab05b0764775dfc7": {
        "name": "Validate image caption",
        "imports": [],
        "source": "export default function ({ body }) {\n  if (body?.status !== \"completed\" || !Array.isArray(body.output))\n    throw Error(\"Incomplete caption\");\n  const text = body.output\n    .flatMap((x) => x.content || [])\n    .filter((x) => x.type === \"output_text\")\n    .map((x) => x.text)\n    .join(\"\");\n  let c;\n  try {\n    c = JSON.parse(text);\n  } catch {\n    throw Error(\"Invalid caption JSON\");\n  }\n  if (\n    typeof c.caption_title !== \"string\" ||\n    typeof c.caption_text !== \"string\" ||\n    !c.caption_title.trim() ||\n    !c.caption_text.trim()\n  )\n    throw Error(\"Invalid caption\");\n  return { body: JSON.stringify({ output: c }) };\n}\n"
      }
    }
