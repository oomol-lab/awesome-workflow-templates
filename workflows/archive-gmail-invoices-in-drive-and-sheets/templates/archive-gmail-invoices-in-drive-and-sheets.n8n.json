    {
      "name": "Select PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $(\"Gmail Trigger1\").item,\n  entries = Object.entries(msg.binary || {}),\n  entry = entries.find(([, v]) => v.mimeType === \"application/pdf\");\nif (!entry) return { json: { hasPdf: false, messageId: msg.json.id } };\nconst raw = String(msg.json.subject || \"invoice\").replace(/[\\/\\\\]/g, \"_\");\nreturn {\n  json: {\n    hasPdf: true,\n    messageId: msg.json.id,\n    fileName: raw + \"_invoice_\" + new Date().toISOString().slice(0, 10) + \".pdf\",\n  },\n  binary: { data: entry[1] },\n};\n"
      },
      "id": "archive-gmail-invoices-in-drive-and-sheets-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "PDF found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.hasPdf }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "archive-gmail-invoices-in-drive-and-sheets-4",
      "position": [
        880,
        0
      ]
    },
