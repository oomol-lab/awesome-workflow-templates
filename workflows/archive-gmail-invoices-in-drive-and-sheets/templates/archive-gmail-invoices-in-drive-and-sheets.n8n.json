        1100,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{ $('Select PDF').item.json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DRIVE_FOLDER_ID"
        },
        "inputDataFieldName": "data",
        "options": {}
      },
      "typeVersion": 3
    },
