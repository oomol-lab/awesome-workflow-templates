    "modules": {
      "n_728023ba4d21aeac": {
        "name": "Read invoice text",
        "imports": [],
        "source": "export default function f({ body }) {\n  return { text: body.text, messageId: body.messageId };\n}\n"
      },
      "n_d49768c791b01b07": {
        "name": "Prepare reconciliation row",
        "imports": [],
        "source": "export default async function prepare(\n  { body, invoice, spreadsheetId, range, acknowledge, resolution },\n  ctx,\n) {\n  if (!body?.messageId || !body?.driveId || !body?.fileName || !body?.text)\n    throw Error(\"Missing message or invoice\");\n  if (!spreadsheetId || spreadsheetId.includes(\"YOUR_\") || !range) throw Error(\"Configure sheet\");\n  const key = \"invoice:\" + body.messageId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { key, write: false, spreadsheetId, range, values: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect unknown sheet append \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { key, write: false, spreadsheetId, range, values: [] };\n    }\n  }\n  const values = [\n    [\n      invoice.date,\n      body.fileName,\n      invoice.total,\n      \"https://drive.google.com/file/d/\" + encodeURIComponent(body.driveId) + \"/view\",\n    ],\n  ];\n  await ctx.state.set(key, { status: \"pending\" });\n  return { key, write: true, spreadsheetId, range, values };\n}\n"
      },
      "n_7f66027c8d0f0372": {
        "name": "Confirm invoice row",
        "imports": [],
        "source": "export default async function confirm({ key, updatedRows, messageId }, ctx) {\n  if (updatedRows !== 1) throw Error(\"Unknown sheet result\");\n  await ctx.state.set(key, { status: \"done\" });\n  await ctx.state.set(\"response:\" + messageId, { ok: true, messageId });\n  return { ok: true };\n}\n"
      },
      "n_701d8683accbdc48": {
        "name": "Return confirmed row",
        "imports": [],
        "source": "export default async function f({ messageId }, ctx) {\n  await ctx.state.set(\"response:\" + messageId, { ok: true, messageId });\n  return { ok: true };\n}\n"
      },
      "n_14a43cfdaea78ade": {
        "name": "Return processing result",
        "imports": [],
        "source": "export default async function f({ messageId }, ctx) {\n  const body = await ctx.state.get(\"response:\" + messageId);\n  if (!body) throw Error(\"Missing result\");\n  await ctx.state.set(\"response:\" + messageId, null);\n  return { body };\n}\n"
      }
    }
  },
