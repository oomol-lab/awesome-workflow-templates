    "modules": {
      "n_41bb30ca3bdde2b8": {
        "name": "Configure budget alerts",
        "imports": [],
        "source": "export default function settings(inputs) {\n  return inputs;\n}\n"
      },
      "n_1ec5d371218bb4b6": {
        "name": "Prepare Project filters",
        "imports": [],
        "source": "export default function requestPage({ budgetField, previous }) {\n  if (\n    !/^[a-z][a-z0-9_]*$/.test(budgetField) ||\n    [\"name\", \"company\", \"cost_center\", \"status\", \"project_type\", \"is_active\"].includes(budgetField)\n  ) {\n    throw new Error(\"Enter the API fieldname for the Project budgeted cost.\");\n  }\n  const fields = [\n    \"name\",\n    \"company\",\n    \"cost_center\",\n    \"status\",\n    \"project_type\",\n    \"is_active\",\n    budgetField,\n  ];\n  const filters = [\n    [\"status\", \"=\", \"Open\"],\n    [\"project_type\", \"=\", \"External\"],\n    [\"is_active\", \"=\", \"Yes\"],\n    [budgetField, \"=\", 0],\n  ];\n  if (previous) filters.push([\"name\", \">\", previous.lastName]);\n  return { fields, filters };\n}\n"
      },
      "n_419133665e33bda9": {
        "name": "Count by company and cost center",
        "imports": [],
        "source": "function isZero(value) {\n  return value === 0 || (typeof value === \"string\" && /^[+-]?(?:0+(?:\\.0+)?|\\.0+)$/.test(value));\n}\n\nfunction isLink(value) {\n  return value === null || typeof value === \"string\";\n}\n\nexport default function countProjects({\n  budgetField,\n  documents,\n  previous,\n  centerA,\n  centerB,\n  centerC,\n  centerD,\n}) {\n  const centers = [centerA, centerB, centerC, centerD];\n  if (centers.some((center) => !center.trim()) || new Set(centers).size !== centers.length) {\n    throw new Error(\"Enter four distinct cost center names.\");\n  }\n\n  const groups = new Map(\n    (previous?.groups ?? []).map((group) => [JSON.stringify([group.company, group.center]), group]),\n  );\n  const names = new Set();\n  for (const row of documents) {\n    const { name, company, cost_center: center } = row;\n    if (\n      typeof name !== \"string\" ||\n      !name.trim() ||\n      !isLink(company) ||\n      !isLink(center) ||\n      row.status !== \"Open\" ||\n      row.project_type !== \"External\" ||\n      row.is_active !== \"Yes\" ||\n      !isZero(row[budgetField])\n    ) {\n      throw new Error(\n        \"ERPNext returned an incomplete or unexpected Project row. Check field access and filters.\",\n      );\n    }\n    if (names.has(name) || previous?.lastName === name) {\n      throw new Error(\"ERPNext did not advance the Project name cursor.\");\n    }\n    names.add(name);\n    if (!center?.trim() || !centers.slice(0, 3).includes(center)) continue;\n    const key = JSON.stringify([company, center]);\n    const group = groups.get(key) ?? { company, center, count: 0 };\n    group.count += 1;\n    groups.set(key, group);\n  }\n\n  const lastName = documents.at(-1)?.name ?? previous?.lastName ?? \"\";\n  return { more: documents.length > 0, state: { lastName, groups: [...groups.values()] } };\n}\n"
      },
      "n_e651ad744963431c": {
        "name": "Prepare next team alert",
        "imports": [],
        "source": "export default function prepareMail({\n  state,\n  index,\n  centerA,\n  centerB,\n  centerC,\n  emailA,\n  emailB,\n  emailC,\n}) {\n  const recipients = new Map([\n    [centerA, emailA],\n    [centerB, emailB],\n    [centerC, emailC],\n  ]);\n  const groups = [...state.groups].sort(\n    (left, right) =>\n      String(left.company ?? \"\").localeCompare(String(right.company ?? \"\")) ||\n      right.count - left.count ||\n      left.center.localeCompare(right.center),\n  );\n  const validAddress = (email) =>\n    typeof email === \"string\" && /^[^\\s@,;<>]+@[^\\s@,;<>]+$/.test(email);\n  if (index === null && groups.some(({ center }) => !validAddress(recipients.get(center)))) {\n    throw new Error(\"Enter a valid Outlook recipient for every matching cost center.\");\n  }\n\n  const current = index ?? 0;\n  const group = groups[current];\n  if (!group) return { more: false, nextIndex: current, toRecipients: [], body: \"\" };\n  return {\n    more: true,\n    nextIndex: current + 1,\n    toRecipients: [recipients.get(group.center)],\n    body: [\n      \"Company: \" + (group.company ?? \"Unspecified\"),\n      \"Cost center: \" + group.center,\n      \"Projects with a zero budgeted cost: \" + group.count,\n      \"\",\n      \"Please coordinate with the Accounts team to update the missing budgeted costs.\",\n    ].join(\"\\n\"),\n  };\n}\n"
      },
      "n_decb06367f5f2a51": {
        "name": "Confirm Outlook accepted the alert",
        "imports": [],
        "source": "export default function confirm({ success }) {\n  if (success !== true) throw new Error(\"Outlook did not confirm acceptance.\");\n  return {};\n}\n"
      }
