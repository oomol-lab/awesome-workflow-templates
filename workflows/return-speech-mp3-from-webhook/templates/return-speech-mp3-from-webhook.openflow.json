    "modules": {
      "n_19d0531665648412": {
        "name": "Validate text and select a voice",
        "imports": [],
        "source": "function readSpeechText(body) {\n  const text = body?.text_to_convert;\n  return typeof text === \"string\" && /\\S/.test(text) && [...text].length <= 4096 ? text : null;\n}\n\nfunction speechVoice(id) {\n  if (typeof id !== \"string\" || !/^[A-Za-z0-9]{20}$/.test(id))\n    throw new Error(\"Set an ElevenLabs voice ID from your Voice Library\");\n  return id;\n}\n\nexport default ({ body, voiceId, enableCalls }) => {\n  if (!enableCalls)\n    throw new Error(\"Configure and test webhook authentication before enabling speech requests\");\n  const text = readSpeechText(body);\n  if (text === null) throw new Error(\"Supply between 1 and 4096 characters of text\");\n  return { text, voiceId: speechVoice(voiceId) };\n};\n"
      },
      "n_66c703e357bf5a2a": {
        "name": "Check the audio download",
        "imports": [],
        "source": "function signedSpeechUrl(\n  { file, voiceId, modelId, outputFormat },\n  expectedVoice,\n  expectedModel,\n  expectedFormat,\n) {\n  const mime =\n    typeof file?.mimetype === \"string\" ? file.mimetype.split(\";\")[0].toLowerCase().trim() : \"\";\n  if (\n    voiceId !== expectedVoice ||\n    modelId !== expectedModel ||\n    outputFormat !== expectedFormat ||\n    ![\"audio/mpeg\", \"audio/mp3\", \"application/octet-stream\"].includes(mime) ||\n    typeof file?.s3url !== \"string\" ||\n    !/^https:\\/\\/[a-z0-9.-]+(?:[/?][^\\s\"'<>]*)$/i.test(file.s3url)\n  ) {\n    throw new Error(\"The speech service did not return the expected MP3 download\");\n  }\n  return file.s3url;\n}\n\nexport default ({ file, voiceId, modelId, outputFormat, expectedVoice }) => ({\n  url: signedSpeechUrl(\n    { file, voiceId, modelId, outputFormat },\n    expectedVoice,\n    \"eleven_multilingual_v2\",\n    \"mp3_44100_128\",\n  ),\n});\n"
      },
      "n_ef2e54413431a789": {
        "name": "Verify the MP3 bytes",
        "imports": [],
        "source": "function checkSpeechBytes(bytes, mediaType) {\n  const mime = typeof mediaType === \"string\" ? mediaType.split(\";\")[0].toLowerCase().trim() : \"\";\n  if (\n    ![\"audio/mpeg\", \"audio/mp3\", \"application/octet-stream\"].includes(mime) ||\n    bytes.length < 24 ||\n    bytes.length > 8 * 1024 * 1024\n  ) {\n    throw new Error(\"The speech response is empty, has the wrong format, or exceeds 8 MiB\");\n  }\n  let offset = 0;\n  if (bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) {\n    const length = bytes.subarray(6, 10);\n    if (length.some((byte) => byte > 0x7f))\n      throw new Error(\"The speech response has an invalid MP3 tag\");\n    offset = 10 + ((length[0] << 21) | (length[1] << 14) | (length[2] << 7) | length[3]);\n    if (bytes[3] === 4 && bytes[5] & 0x10) offset += 10;\n  }\n  // The selected output is MPEG-1 Layer III, 44.1 kHz. Check a complete first audio frame after optional ID3 metadata.\n  const frame = bytes.subarray(offset, offset + 4);\n  const bitrates = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0];\n  const bitrate = bitrates[frame[2] >> 4];\n  const frameSize = Math.floor((144000 * bitrate) / 44100) + ((frame[2] >> 1) & 1);\n  if (\n    frame.length !== 4 ||\n    frame[0] !== 0xff ||\n    (frame[1] & 0xfe) !== 0xfa ||\n    ((frame[2] >> 2) & 3) !== 0 ||\n    !bitrate ||\n    offset + frameSize > bytes.length\n  )\n    throw new Error(\"The speech response has no complete first MP3 frame\");\n}\n\nexport default async ({ file, status }, context) => {\n  if (status !== 200 || file.size > 8 * 1024 * 1024)\n    throw new Error(\"The MP3 download is incomplete or exceeds 8 MiB\");\n  const bytes = await context.artifact.open(file);\n  if (bytes.length !== file.size) throw new Error(\"The MP3 download length does not match\");\n  checkSpeechBytes(bytes, file.mediaType);\n  return {\n    audio: await context.artifact.put(bytes, { name: \"speech.mp3\", mediaType: \"audio/mpeg\" }),\n  };\n};\n"
      }
    },
