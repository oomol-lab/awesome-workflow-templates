    {
      "id": "reconcile-gmail-messages-with-todoist-tasks-plan",
      "name": "Plan mailbox changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const unread = $(\"Get Unread From Inbox\")\n    .all()\n    .map((x) => x.json)\n    .filter((x) => x.id),\n  unreadIds = new Set(unread.map((x) => x.id)),\n  emails = [\n    ...$(\"Get Starred From Inbox\")\n      .all()\n      .map((x) => x.json),\n    ...unread,\n  ].filter((x) => x.id),\n  pages = $(\"Get Open Tasks\")\n    .all()\n    .map((x) => x.json.body);\nif (pages.some((x) => !Array.isArray(x?.results))) throw Error(\"Invalid Todoist task page\");\nconst tasks = pages.flatMap((x) => x.results),\n  active = new Map(emails.map((m) => [m.id, m])),\n  tracked = new Map();\nfor (const t of tasks) {\n  const match = /(?:^|\\n)\\[gmail-message:([a-zA-Z0-9_-]+)\\]$/.exec(t.description ?? \"\");\n  if (!match) continue;\n  if (tracked.has(match[1])) throw Error(\"Duplicate Gmail task marker\");\n  tracked.set(match[1], t);\n}\nconst work = [];\nfor (const [id, m] of active) {\n  if (!/^[a-zA-Z0-9_-]+$/.test(id)) throw Error(\"Invalid Gmail ID\");\n  if (!tracked.has(id) || unreadIds.has(id))\n    work.push({\n      mode: tracked.has(id) ? \"mark\" : \"create\",\n      messageId: id,\n      subject: m.Subject || m.subject || \"(no subject)\",\n    });\n}\nfor (const [id, t] of tracked)\n  if (!active.has(id))\n    work.push({ mode: \"close\", messageId: id, taskId: t.id, subject: t.content });\nreturn work.map((json) => ({ json, pairedItem: { item: 0 } }));\n"
      }
    },
