    "modules": {
      "n_9a841fc59583a6a4": {
        "name": "Choose the next message",
        "imports": [],
        "source": "export default function gmailTaskProgress({ events, previousState }) {\n  if (!Array.isArray(events) || events.length > 50) throw new Error(\"Invalid Gmail poll page\");\n  for (const e of events)\n    if (!e || typeof e.messageId !== \"string\" || !e.messageId)\n      throw new Error(\"Invalid Gmail event\");\n  let index = 0;\n  if (previousState != null) {\n    if (\n      !Number.isInteger(previousState.index) ||\n      previousState.index < 0 ||\n      previousState.index >= events.length\n    )\n      throw new Error(\"Invalid Gmail page progress\");\n    index = previousState.index + 1;\n  }\n  return {\n    state: { index },\n    more: index < events.length,\n    messageId: events[index]?.messageId ?? \"\",\n    count: index,\n  };\n}\n"
      },
      "n_080a62ee0f3f4cf8": {
        "name": "Prepare the Google Task",
        "imports": [],
        "source": "export default function gmailTaskPlan({ expectedId, messageId, subject, snippet, tasklistId }) {\n  if (expectedId !== messageId) throw new Error(\"Fetched a different Gmail message\");\n  if (typeof subject !== \"string\" || !subject.trim())\n    throw new Error(\"The message needs a subject for the task title\");\n  if (snippet != null && typeof snippet !== \"string\") throw new Error(\"Invalid Gmail snippet\");\n  if (typeof tasklistId !== \"string\" || !tasklistId.trim() || tasklistId === \"YOUR_TASK_LIST_ID\")\n    throw new Error(\"Set the Google Tasks list ID\");\n  const now = new Date();\n  const tomorrow = new Date(\n    Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1),\n  ).toISOString();\n  return { title: subject, notes: snippet ?? \"\", due: tomorrow, tasklistId };\n}\n"
      }
    }
  },
