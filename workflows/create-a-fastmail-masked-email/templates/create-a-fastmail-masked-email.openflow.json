    "modules": {
      "n_65a897b2fcec192a": {
        "name": "Prepare masked email",
        "imports": [],
        "source": "export default function prepare({ event, session }) {\n  const accountId = session?.primaryAccounts?.[\"https://www.fastmail.com/dev/maskedemail\"];\n  if (!accountId) throw Error(\"Fastmail session has no Masked Email account\");\n  const state = event.state ?? \"pending\",\n    description = event.description ?? \"Test via N8n\";\n  return {\n    description,\n    body: {\n      using: [\"urn:ietf:params:jmap:core\", \"https://www.fastmail.com/dev/maskedemail\"],\n      methodCalls: [\n        [\n          \"MaskedEmail/set\",\n          { accountId, create: { maskedEmailId1: { description, state } } },\n          \"c1\",\n        ],\n      ],\n    },\n  };\n}\n"
      },
      "n_f08b5a6dfec8dbee": {
        "name": "Read created address",
        "imports": [],
        "source": "export default function result({ body, description }) {\n  const call = body?.methodResponses?.find((x) => x[2] === \"c1\");\n  const email = call?.[1]?.created?.maskedEmailId1?.email;\n  if (call?.[0] !== \"MaskedEmail/set\" || typeof email !== \"string\" || !email)\n    throw Error(\"Fastmail did not confirm masked email creation\");\n  return { response: { email, desciption: description } };\n}\n"
      }
    }
  },
