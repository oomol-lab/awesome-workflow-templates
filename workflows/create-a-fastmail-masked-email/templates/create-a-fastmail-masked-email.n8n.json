      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item, index) => {\n  const c = item.json.methodResponses?.[0];\n  if (c?.[0] !== \"MaskedEmail/set\" || c?.[2] !== \"c1\" || !c?.[1]?.created?.maskedEmailId1?.email)\n    throw new Error(\"Fastmail did not confirm masked email creation\");\n  return { json: item.json, pairedItem: { item: index } };\n});\n"
