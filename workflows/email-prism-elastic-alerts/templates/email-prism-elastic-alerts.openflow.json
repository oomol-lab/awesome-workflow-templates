        "source": "function alertSettings(feedUrl, recipient, scheduledAt) {\n  const url =\n    typeof feedUrl === \"string\" &&\n    /^https:\\/\\/([a-z0-9-]+(?:\\.[a-z0-9-]+)*)(?::(\\d{1,5}))?(?:\\/[^\\s\\\\#]*)?$/i.exec(feedUrl);\n  if (\n    !url ||\n    url[1].toLowerCase().endsWith(\".invalid\") ||\n    (url[2] && (Number(url[2]) < 1 || Number(url[2]) > 65535))\n  ) {\n    throw Error(\"Configure the final HTTPS PRISM alert feed without embedded credentials.\");\n  }\n  if (\n    typeof recipient !== \"string\" ||\n    recipient.length > 254 ||\n    !/^[^\\s@,;<>]+@[^\\s@,;<>]+\\.[^\\s@,;<>]+$/.test(recipient)\n  ) {\n    throw Error(\"Configure one authorized Outlook recipient.\");\n  }\n  const timestamp = Date.parse(scheduledAt);\n  if (!Number.isFinite(timestamp)) throw Error(\"The schedule did not provide a valid time.\");\n  return { feedUrl, recipient, day: new Date(timestamp).toISOString().slice(0, 10) };\n}\nexport default ({ feedUrl, recipient, scheduledAt }) =>\n  alertSettings(feedUrl, recipient, scheduledAt);\n"
      },
      "n_bccc5fe7b148dadc": {
        "name": "Validate the alert feed",
        "imports": [],
        "source": "function alertMessages(body, statusCode, config) {\n  if (statusCode !== 200) throw Error(\"The alert feed did not return a complete JSON response.\");\n  const empty =\n    body && typeof body === \"object\" && !Array.isArray(body) && Object.keys(body).length === 0;\n  const alerts = Array.isArray(body) ? body : empty ? [] : [body];\n  if (alerts.length > 100) throw Error(\"The alert feed exceeded 100 records.\");\n  const field = (value, limit) =>\n    typeof value === \"string\" && value.trim() && value.length <= limit;\n  const html = (value) =>\n    String(value)\n      .replaceAll(\"&\", \"&amp;\")\n      .replaceAll(\"<\", \"&lt;\")\n      .replaceAll(\">\", \"&gt;\")\n      .replaceAll('\"', \"&quot;\")\n      .replaceAll(\"'\", \"&#39;\")\n      .replace(/\\r\\n|\\r|\\n/g, \"<br>\");\n  return alerts.map((alert) => {\n    const { alert_name: name, severity, timestamp, alert_message: details } = alert ?? {};\n    if (\n      !field(name, 200) ||\n      /[\\r\\n\\u0000]/.test(name) ||\n      !(field(severity, 60) || Number.isFinite(severity)) ||\n      !field(timestamp, 100) ||\n      !field(details, 8000)\n    ) {\n      throw Error(\"An alert is missing its name, severity, timestamp or details.\");\n    }\n    return {\n      fingerprint: JSON.stringify([\n        config.feedUrl,\n        config.recipient,\n        name,\n        severity,\n        timestamp,\n        details,\n      ]),\n      subject: \"PRISM Elastic Alert: \" + name,\n      body:\n        \"Hello,<br><br>An alert has been triggered:<br><strong>Alert Name:</strong> \" +\n        html(name) +\n        \"<br><strong>Severity:</strong> \" +\n        html(severity) +\n        \"<br><strong>Timestamp:</strong> \" +\n        html(timestamp) +\n        \"<br><br>Details:<br>\" +\n        html(details) +\n        \"<br><br>Regards,<br>PRISM Alert System\",\n      recipient: config.recipient,\n    };\n  });\n}\nexport default ({ body, statusCode, feedUrl, recipient, day }) => ({\n  alerts: alertMessages(body, statusCode, { feedUrl, recipient, day }),\n});\n"
      },
      "n_2364407a2716c987": {
        "name": "Select the next alert",
        "imports": [],
        "source": "export default ({ alerts, previous }) => {\n  const index = previous ?? 0,\n    alert = alerts[index] ?? null;\n  return { index, alert, more: alert !== null };\n};\n"
      },
      "n_0a62f0ffda2cd210": {
        "name": "Reserve the selected alert",
        "imports": [],
        "source": "import { createHash } from \"node:crypto\";\nexport default async ({ alert, day }, context) => {\n  const digest = createHash(\"sha256\").update(alert.fingerprint).digest(\"hex\"),\n    key = \"prism-alert:\" + digest;\n  const lock = key + \":pending\",\n    receipt = key + \":accepted\";\n  if (!(await context.state.insert(lock, { day })))\n    return { ready: false, key, subject: \"\", body: \"\", toRecipients: [] };\n  const prior = await context.state.get(receipt);\n  if (prior?.day >= day) {\n    await context.state.delete(lock);\n    return { ready: false, key, subject: \"\", body: \"\", toRecipients: [] };\n  }\n  return {\n    ready: true,\n    key,\n    subject: alert.subject,\n    body: alert.body,\n    toRecipients: [alert.recipient],\n  };\n};\n"
      },
      "n_a928440af0bacd06": {
        "name": "Record Outlook acceptance",
        "imports": [],
        "source": "export default async ({ key, day, success }, context) => {\n  if (success !== true) throw Error(\"Outlook did not confirm acceptance.\");\n  await context.state.set(key + \":accepted\", { day });\n  await context.state.delete(key + \":pending\");\n  return { accepted: true };\n};\n"
      },
      "n_148ffb2b5a148a28": {
        "name": "Advance to the next alert",
        "imports": [],
        "source": "export default ({ index }) => ({ index: index + 1 });\n"
      }
    },
    "features": []
  },
  "presentation": {
    "designer": {
      "version": 1,
      "flow": {
        "direction": "vertical"
      }
    }
  }
}
