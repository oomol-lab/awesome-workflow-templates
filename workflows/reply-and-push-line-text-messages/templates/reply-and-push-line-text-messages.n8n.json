      "id": "reply-and-push-line-text-messages-prepare",
      "name": "Read the original request bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst raw = await helpers.getBinaryDataBuffer(0, \"data\");\nconst receivedAt = Date.now();\nreturn [\n  {\n    json: {\n      signature: item.json.headers[\"x-line-signature\"],\n      receivedAt,\n      raw: raw.toString(\"base64\"),\n    },\n    binary: item.binary,\n  },\n];\n"
