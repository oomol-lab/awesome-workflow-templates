    {
      "id": "reply-and-push-line-text-messages-config",
      "name": "Set one push user, message and retry key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function linePush(settings) {\n  if (settings.enabled !== true) return [];\n  const { recipient, message, retryKey } = settings;\n  if (\n    typeof recipient !== \"string\" ||\n    !/^U[a-fA-F0-9]{32}$/.test(recipient) ||\n    typeof message !== \"string\" ||\n    !message.trim() ||\n    message.length > 5000 ||\n    typeof retryKey !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(retryKey)\n  ) {\n    throw Error(\"Set one LINE user ID, a non-empty text message and a new UUIDv4 retry key.\");\n  }\n  return [\n    {\n      key: \"push:\" + retryKey.toLowerCase(),\n      retryKey: retryKey.toLowerCase(),\n      request: { to: recipient, messages: [{ type: \"text\", text: message }] },\n    },\n  ];\n}\n\nconst settings = {\n  enabled: false,\n  recipient: \"YOUR_LINE_USER_ID\",\n  message: \"推播測試\",\n  retryKey: \"YOUR_UUID_V4\",\n};\nreturn linePush(settings).map((json) => ({ json }));\n"
      },
