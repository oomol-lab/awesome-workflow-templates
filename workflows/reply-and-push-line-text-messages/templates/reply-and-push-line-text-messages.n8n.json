    {
      "id": "reply-and-push-line-text-messages-sign",
      "name": "Sign the request with the LINE channel secret",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "data",
        "dataPropertyName": "digest",
        "encoding": "base64",
        "secret": "={{ (()=>{throw Error(\"Configure the LINE channel secret\")})() }}"
