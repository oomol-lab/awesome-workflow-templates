    {
      "id": "reply-and-push-line-text-messages-verify",
      "name": "Authenticate the LINE delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function compareLineSignature(expected, computed) {\n  if (\n    typeof expected !== \"string\" ||\n    typeof computed !== \"string\" ||\n    !/^[A-Za-z0-9+/]{43}=$/.test(expected) ||\n    computed.length !== 44\n  )\n    return false;\n  let difference = 0;\n  for (let i = 0; i < 44; i++) difference |= expected.charCodeAt(i) ^ computed.charCodeAt(i);\n  return difference === 0;\n}\n\nfunction lineMessages(body, receivedAt) {\n  if (\n    !body ||\n    typeof body.destination !== \"string\" ||\n    !/^U[a-fA-F0-9]{32}$/.test(body.destination) ||\n    !Array.isArray(body.events)\n  )\n    return null;\n  return body.events.flatMap((event) => {\n    if (\n      event?.type !== \"message\" ||\n      event.mode !== \"active\" ||\n      event.message?.type !== \"text\" ||\n      typeof event.message.text !== \"string\" ||\n      event.message.text.length === 0 ||\n      !/^[0-9A-HJKMNP-TV-Z]{26}$/.test(event.webhookEventId) ||\n      typeof event.replyToken !== \"string\" ||\n      !/^[A-Za-z0-9_-]{1,256}$/.test(event.replyToken) ||\n      !Number.isSafeInteger(event.timestamp) ||\n      event.timestamp > receivedAt + 60_000 ||\n      receivedAt - event.timestamp >= 20 * 60_000\n    )\n      return [];\n    const text = \"收到您的訊息 : \" + event.message.text;\n    if (text.length > 5000) return [];\n    return [\n      {\n        key: \"reply:\" + body.destination + \":\" + event.webhookEventId,\n        receivedAt,\n        request: { replyToken: event.replyToken, messages: [{ type: \"text\", text }] },\n      },\n    ];\n  });\n}\n\nconst { signature, digest, raw, receivedAt } = $input.first().json;\nif (!compareLineSignature(signature, digest)) return [{ json: { status: 401, messages: [] } }];\nlet messages;\ntry {\n  messages = lineMessages(JSON.parse(Buffer.from(raw, \"base64\").toString(\"utf8\")), receivedAt);\n} catch {\n  messages = null;\n}\nreturn [{ json: { status: messages === null ? 400 : 200, messages: messages ?? [] } }];\n"
      },
      "position": [
        648,
        240
      ]
    },
