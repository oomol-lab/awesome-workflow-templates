    {
      "id": "reply-and-push-line-text-messages-status",
      "name": "Read the LINE reply outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function lineReceipt(reply) {\n  const status = reply?.statusCode;\n  const receipt = reply?.body?.sentMessages;\n  const id = receipt?.[0]?.id;\n  if (\n    status === 200 &&\n    Array.isArray(receipt) &&\n    receipt.length === 1 &&\n    typeof id === \"string\" &&\n    /^\\d{1,40}$/.test(id)\n  ) {\n    return { status: \"accepted\", receipt: id };\n  }\n  if (Number.isInteger(status) && status >= 400 && status < 500 && status !== 409)\n    return { status: \"rejected\", receipt: \"\" };\n  return { status: \"indeterminate\", receipt: \"\" };\n}\n\nconst key = $(\"Is this reply fresh and unattempted?\").item.json.key;\nreturn [{ json: { key, ...lineReceipt($input.first().json) }, pairedItem: { item: 0 } }];\n"
      },
