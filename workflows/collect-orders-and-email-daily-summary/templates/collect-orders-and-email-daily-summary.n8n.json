    {
      "id": "collect-orders-and-email-daily-summary-6",
      "name": "HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        1120,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function report({ records, state }) {\n  const escape = (x) =>\n    String(x ?? \"\")\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  const rows = (records ?? state?.records ?? []).map((r) => r.fields ?? r),\n    html =\n      \"<table><tr><th>time</th><th>orderID</th><th>orderPrice</th></tr>\" +\n      rows\n        .map(\n          (r) =>\n            \"<tr>\" +\n            [r.time, r.orderID, r.orderPrice].map((x) => \"<td>\" + escape(x) + \"</td>\").join(\"\") +\n            \"</tr>\",\n        )\n        .join(\"\") +\n      \"</table>\";\n  return { hasOrders: rows.length > 0, html };\n}\n\nreturn [{ json: report({ records: $input.all().map((x) => x.json) }) }];\n"
      },
      "executeOnce": true,
      "typeVersion": 2
    },
