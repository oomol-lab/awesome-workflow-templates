    {
      "id": "collect-orders-and-email-daily-summary-4",
      "name": "Yesterday Date",
      "type": "n8n-nodes-base.code",
      "position": [
        660,
        520
      ],
      "parameters": {
        "jsCode": "function window({ scheduledAt }) {\n  const end = new Date(scheduledAt);\n  if (!Number.isFinite(end.getTime())) throw Error(\"Invalid schedule time\");\n  const start = new Date(end.getTime() - 86400000);\n  return {\n    formula: `AND(IS_AFTER({time},DATETIME_PARSE('${start.toISOString()}')),IS_BEFORE({time},DATETIME_PARSE('${end.toISOString()}')))`,\n  };\n}\n\nreturn [{ json: window({ scheduledAt: new Date().toISOString() }) }];\n"
      },
      "typeVersion": 2
    },
