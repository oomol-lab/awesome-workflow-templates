      "n_6fb52a51dd1aa635": {
        "name": "Prepare the order",
        "imports": [],
        "source": "export default function intake({ body }) {\n  const id = Number(body?.orderID),\n    price = Number(body?.orderPrice);\n  if (\n    body?.orderID == null ||\n    body?.orderPrice == null ||\n    !Number.isFinite(id) ||\n    !Number.isFinite(price)\n  )\n    throw Error(\"Provide numeric orderID and orderPrice\");\n  return {\n    records: [{ fields: { time: new Date().toISOString(), orderID: id, orderPrice: price } }],\n  };\n}\n"
      },
      "n_f03cdf5d294eb91e": {
        "name": "Choose the last 24 hours",
        "imports": [],
        "source": "export default function window({ scheduledAt }) {\n  const end = new Date(scheduledAt);\n  if (!Number.isFinite(end.getTime())) throw Error(\"Invalid schedule time\");\n  const start = new Date(end.getTime() - 86400000);\n  return {\n    formula: `AND(IS_AFTER({time},DATETIME_PARSE('${start.toISOString()}')),IS_BEFORE({time},DATETIME_PARSE('${end.toISOString()}')))`,\n  };\n}\n"
      },
      "n_e9520b0137ae94ed": {
        "name": "Collect all order pages",
        "imports": [],
        "source": "export default function collectImagePages({ records, offset, previousState }) {\n  if (!Array.isArray(records)) throw new Error(\"Missing Airtable records\");\n  const state = previousState ?? { records: [], seen: [] };\n  if (!Array.isArray(state.records) || !Array.isArray(state.seen))\n    throw new Error(\"Invalid pagination state\");\n  if (offset !== null && (typeof offset !== \"string\" || !offset || state.seen.includes(offset)))\n    throw new Error(\"Invalid or repeated Airtable offset\");\n  return {\n    state: {\n      records: [...state.records, ...records],\n      seen: offset === null ? state.seen : [...state.seen, offset],\n    },\n    offset: offset ?? \"unused\",\n    more: offset !== null,\n  };\n}\n"
      },
      "n_308bdfe8187a69a0": {
        "name": "Build the order table",
        "imports": [],
        "source": "export default function report({ records, state }) {\n  const escape = (x) =>\n    String(x ?? \"\")\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  const rows = (records ?? state?.records ?? []).map((r) => r.fields ?? r),\n    html =\n      \"<table><tr><th>time</th><th>orderID</th><th>orderPrice</th></tr>\" +\n      rows\n        .map(\n          (r) =>\n            \"<tr>\" +\n            [r.time, r.orderID, r.orderPrice].map((x) => \"<td>\" + escape(x) + \"</td>\").join(\"\") +\n            \"</tr>\",\n        )\n        .join(\"\") +\n      \"</table>\";\n  return { hasOrders: rows.length > 0, html };\n}\n"
      }
    }
