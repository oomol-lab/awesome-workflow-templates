      "parameters": {
        "options": {
          "formTitle": "Enter a Date & Time",
          "formDescription": "=Please select a date and time"
        },
        "defineForm": "json",
        "jsonOutput": "={{ [{fieldLabel:'Date',requiredField:true,fieldType:'dropdown',fieldOptions:Array(5).fill(0).map((_,i)=>$now.plus({days:i+1})).filter(d=>!d.isWeekend).map(d=>({option:d.toFormat('yyyy-MM-dd')}))},{fieldLabel:'Time',requiredField:true,fieldType:'dropdown',fieldOptions:Array.from({length:10},(_,i)=>({option:String(i+9).padStart(2,'0')+':00'}))}] }}"
      },
      "typeVersion": 1
