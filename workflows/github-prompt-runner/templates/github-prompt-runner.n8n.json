    {
      "id": "9d92f581-8cd9-448c-aa1d-023a96c1ddda",
      "name": "Check and Fill Prompt Variables",
      "type": "n8n-nodes-base.code",
      "position": [
        1900,
        -20
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function substitutePrompt({ promptText, variables }) {\n  if (typeof promptText !== 'string' || !promptText.trim()) throw new Error('The GitHub prompt file must contain UTF-8 text.');\n  if (!variables || typeof variables !== 'object' || Array.isArray(variables) || Object.values(variables).some(value => typeof value !== 'string')) throw new Error('Prompt variables must be an object of strings.');\n  const keys = [...new Set([...promptText.matchAll(/{{(.*?)}}/g)].map(match => match[1].trim().split('.').pop().trim()))];\n  const missing = keys.filter(key => !Object.hasOwn(variables, key));\n  if (missing.length) throw new Error('Missing prompt variables: ' + missing.join(', '));\n  const prompt = promptText.replace(/{{(.*?)}}/g, (_, expression) => variables[expression.trim().split('.').pop().trim()]);\n  return { prompt };\n}\n\nfunction prepareGitHubPrompt({ file, variables }) {\n  if (!file || file.type !== 'file' || typeof file.decoded_content !== 'string') throw new Error('GitHub must return a regular UTF-8 prompt file.');\n  if ((typeof file.size === 'number' && file.size > 1048576) || new TextEncoder().encode(file.decoded_content).length > 1048576) throw new Error('The prompt file must be at most 1 MiB.');\n  return substitutePrompt({ promptText: file.decoded_content, variables });\n}\n\nconst bytes=await this.helpers.getBinaryDataBuffer(0,\"data\");\nif(bytes.length>1048576)throw new Error(\"The prompt file must be at most 1 MiB.\");\nconst text=bytes.toString(\"utf8\");\nif(!Buffer.from(text,\"utf8\").equals(bytes))throw new Error(\"The GitHub prompt file must contain UTF-8 text.\");\nreturn [{json:substitutePrompt({promptText:text.replace(/^\\uFEFF/,\"\"),variables:$(\"Set Prompt Settings\").first().json.variables}),pairedItem:{item:0}}];\n"
      },
      "typeVersion": 2
    },
