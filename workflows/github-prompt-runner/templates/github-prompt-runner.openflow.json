    "modules": {
      "n_549e055dc49370d8": {
        "name": "Check and fill prompt variables",
        "imports": [],
        "source": "export function substitutePrompt({ promptText, variables }) {\n  if (typeof promptText !== \"string\" || !promptText.trim())\n    throw new Error(\"The GitHub prompt file must contain UTF-8 text.\");\n  if (\n    !variables ||\n    typeof variables !== \"object\" ||\n    Array.isArray(variables) ||\n    Object.values(variables).some((value) => typeof value !== \"string\")\n  )\n    throw new Error(\"Prompt variables must be an object of strings.\");\n  const keys = [\n    ...new Set(\n      [...promptText.matchAll(/{{(.*?)}}/g)].map((match) =>\n        match[1].trim().split(\".\").pop().trim(),\n      ),\n    ),\n  ];\n  const missing = keys.filter((key) => !Object.hasOwn(variables, key));\n  if (missing.length) throw new Error(\"Missing prompt variables: \" + missing.join(\", \"));\n  const prompt = promptText.replace(\n    /{{(.*?)}}/g,\n    (_, expression) => variables[expression.trim().split(\".\").pop().trim()],\n  );\n  return { prompt };\n}\n\nexport default function prepareGitHubPrompt({ file, variables }) {\n  if (!file || file.type !== \"file\" || typeof file.decoded_content !== \"string\")\n    throw new Error(\"GitHub must return a regular UTF-8 prompt file.\");\n  if (\n    (typeof file.size === \"number\" && file.size > 1048576) ||\n    new TextEncoder().encode(file.decoded_content).length > 1048576\n  )\n    throw new Error(\"The prompt file must be at most 1 MiB.\");\n  return substitutePrompt({ promptText: file.decoded_content, variables });\n}\n"
      }
    }
