    "modules": {
      "n_80e460c1f76ad838": {
        "name": "Translate each subtitle cue",
        "imports": [],
        "source": "export default async function translate({ body, apiKey }, context) {\n  const language = String(body.language || \"\").toLowerCase();\n  const target = language === \"jp\" ? \"ja\" : language;\n  if (![\"en\", \"ja\"].includes(target) || typeof body.srt !== \"string\" || !apiKey)\n    throw Error(\"Provide SRT text, EN or JP, and a Google API key\");\n  const blocks = body.srt\n    .replace(/^\\uFEFF/, \"\")\n    .replace(/\\r\\n?/g, \"\\n\")\n    .trim()\n    .split(/\\n[\\t ]*\\n/);\n  const cues = blocks.map((block) => {\n    const lines = block.split(\"\\n\");\n    if (\n      lines.length < 3 ||\n      !/^\\d+$/.test(lines[0]) ||\n      !/^\\d\\d:\\d\\d:\\d\\d,\\d{3}\\s+-->\\s+\\d\\d:\\d\\d:\\d\\d,\\d{3}/.test(lines[1])\n    )\n      throw Error(\"Invalid SRT cue\");\n    return { header: lines.slice(0, 2).join(\"\\n\"), text: lines.slice(2).join(\"\\n\") };\n  });\n  const translated = [];\n  for (const cue of cues) {\n    const r = await context.fetch(\"https://translation.googleapis.com/language/translate/v2\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", \"x-goog-api-key\": apiKey },\n      body: JSON.stringify({ q: cue.text, target, format: \"text\" }),\n    });\n    if (!r.ok) throw Error(\"Translation request failed\");\n    const t = (await r.json())?.data?.translations?.[0]?.translatedText;\n    if (typeof t !== \"string\") throw Error(\"Translation response missing text\");\n    translated.push(cue.header + \"\\n\" + t);\n  }\n  return { response: { srt: translated.join(\"\\n\\n\") + \"\\n\" } };\n}\n"
      }
    }
  },
