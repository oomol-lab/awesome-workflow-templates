    {
      "id": "translate-srt-subtitles-with-google-parse",
      "name": "Parse subtitle cues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json.data,\n  lang = $(\"Receive SRT File to Translate\").first().json[\"Translate to Language\"];\nconst target = lang === \"JP\" ? \"ja\" : lang === \"EN\" ? \"en\" : null;\nif (typeof raw !== \"string\" || !target) throw Error(\"Invalid SRT or language\");\nreturn raw\n  .replace(/^\\uFEFF/, \"\")\n  .replace(/\\r\\n?/g, \"\\n\")\n  .trim()\n  .split(/\\n[\\t ]*\\n/)\n  .map((block) => {\n    const lines = block.split(\"\\n\");\n    if (\n      lines.length < 3 ||\n      !/^\\d+$/.test(lines[0]) ||\n      !/^\\d\\d:\\d\\d:\\d\\d,\\d{3}\\s+-->\\s+\\d\\d:\\d\\d:\\d\\d,\\d{3}/.test(lines[1])\n    )\n      throw Error(\"Invalid SRT cue\");\n    return {\n      json: { header: lines.slice(0, 2).join(\"\\n\"), text: lines.slice(2).join(\"\\n\"), target },\n      pairedItem: { item: 0 },\n    };\n  });\n"
      }
    },
    {
      "id": "translate-srt-subtitles-with-google-http",
      "name": "Translate cue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://translation.googleapis.com/language/translate/v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleTranslateOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { q: $json.text, target: $json.target, format: \"text\" } }}",
        "options": {}
      }
    },
    {
      "id": "translate-srt-subtitles-with-google-assemble",
      "name": "Assemble translated SRT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cues = $(\"Parse subtitle cues\").all(),\n  results = $input.all();\nif (cues.length !== results.length) throw Error(\"Translation count mismatch\");\nconst srt =\n  results\n    .map((r, i) => {\n      const text = r.json?.data?.translations?.[0]?.translatedText;\n      if (typeof text !== \"string\") throw Error(\"Translation missing\");\n      return cues[i].json.header + \"\\n\" + text;\n    })\n    .join(\"\\n\\n\") + \"\\n\";\nreturn [{ json: { data: Buffer.from(srt, \"utf8\").toString(\"base64\") } }];\n"
      }
    }
  ],
  "active": false,
