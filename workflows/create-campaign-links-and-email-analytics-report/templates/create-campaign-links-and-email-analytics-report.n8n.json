    {
      "id": "create-campaign-links-and-email-analytics-report-2",
      "name": "Create UTM Link With Parameters",
      "type": "n8n-nodes-base.code",
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const j = item.json,\n    parts = j.website_url.split(\"#\"),\n    base = parts.shift(),\n    fragment = parts.length ? \"#\" + parts.join(\"#\") : \"\",\n    sep = base.includes(\"?\") ? \"&\" : \"?\",\n    fields = {\n      utm_source: j.campaign_source,\n      utm_medium: j.campaign_medium,\n      utm_campaign: j.campaign_name,\n      utm_term: j.campaign_term,\n      utm_content: j.campaign_id,\n    },\n    query = Object.entries(fields)\n      .map(([k, v]) => encodeURIComponent(k) + \"=\" + encodeURIComponent(v))\n      .join(\"&\");\n  return { json: { ...j, utmUrl: base + sep + query + fragment }, pairedItem: { item: i } };\n});\n"
      },
      "typeVersion": 2
    },
