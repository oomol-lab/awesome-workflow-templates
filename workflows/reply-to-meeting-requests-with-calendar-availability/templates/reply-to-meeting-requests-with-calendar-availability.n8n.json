          "includeSpamTrash": false
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "maxResults": 10
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-1",
      "name": "Chat OpenAI",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        220,
        0
      ],
      "parameters": {
        "model": "gpt-5.4-mini",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-2",
      "name": "Workflow Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "position": [
        440,
        0
      ],
      "parameters": {
        "name": "Calendar_Availability",
        "workflowId": "={{ $workflow.id }}",
        "description": "Call this tool to get my calendar availability as stringified JSON array."
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-3",
