      "name": "Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "position": [
        880,
        0
      ],
      "parameters": {
        "options": {
          "timeMax": "={{ $now.plus(1, 'month').toISO() }}",
          "timeMin": "={{ $now.minus(1, 'day').toISO() }}",
          "singleEvents": true
        },
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "primary"
        },
        "operation": "getAll",
        "returnAll": true
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-5",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "position": [
        1100,
        0
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-6",
      "name": "Is appointment request",
      "type": "n8n-nodes-base.if",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.is_appointment }}",
              "value2": "true"
            }
          ],
          "boolean": [
            {
              "value1": "={{ $json.is_appointment }}",
              "value2": true
            }
          ]
        },
        "combineOperation": "any"
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-7",
      "name": "Classify appointment",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1540,
        0
      ],
      "parameters": {
        "prompt": "=Please evaluate the following email to determine if it suggests scheduling a meeting or a call:\nSubject: {{ encodeURI($json.Subject) }}\nSnippet: {{ encodeURI($json.snippet) }}\nIndicate your assessment by responding with \"true\" if it suggests a meeting or call, or \"false\" otherwise. Use lowercase for your response.\n"
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-8",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsonSchema": "{\n \"type\": \"object\",\n \"properties\": {\n \"is_appointment\": {\n \"type\": \"boolean\"\n }\n }\n}"
      },
      "typeVersion": 1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-9",
      "name": "Mark as read",
      "type": "n8n-nodes-base.gmail",
      "position": [
        1980,
        0
      ],
      "parameters": {
        "messageId": "={{ $('Gmail Trigger').item.json.id }}",
        "operation": "markAsRead"
      },
      "typeVersion": 2.1
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-10",
      "name": "Send Reply",
      "type": "n8n-nodes-base.gmail",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "message": "={{ $json.output }}",
        "options": {
          "replyToSenderOnly": true
        },
        "messageId": "={{ $('Gmail Trigger').item.json.id }}",
        "operation": "reply"
      },
      "typeVersion": 2
    },
    {
      "id": "reply-to-meeting-requests-with-calendar-availability-11",
      "name": "Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2420,
        0
      ],
      "parameters": {
        "text": "=Sender: {{ $('Gmail Trigger').item.json.From }}\\nSubject: {{ $('Gmail Trigger').item.json.Subject }}\\nEmail Text: {{ $('Gmail Trigger').item.json.snippet }}",
        "options": {
          "systemMessage": "=You are an email scheduling assistant. Based on the received email, check my availability and propose an appropriate response. \nAim to get a specific time, rather than just a day. When checking my availability, make sure that there's enough time in between meetings.\nIf I'm not available, ALWAYS propose a new time based on my availability. When proposing a new time, always leave 15 minutes buffer from previous meeting.\nToday date and time is: {{ $now.toISO() }}."
        }
      },
      "typeVersion": 1
    },
    {
      "name": "Calendar events JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events = $input\n  .all()\n  .map((x) => x.json)\n  .filter((e) => e.status === \"confirmed\" && e.start?.dateTime && e.end?.dateTime)\n  .map((e) => ({ start: e.start.dateTime, end: e.end.dateTime, name: e.summary || \"\" }))\n  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));\nreturn [{ json: { response: JSON.stringify(events) } }];\n"
      },
      "position": [
        2640,
        0
      ],
      "id": "reply-to-meeting-requests-with-calendar-availability-12"
    },
    {
      "name": "Validate suggested reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.output !== \"string\" || !$json.output.trim()) throw Error(\"Empty reply\");\nreturn { json: $json };\n"
      },
      "position": [
        2860,
        0
      ],
      "id": "reply-to-meeting-requests-with-calendar-availability-13"
    },
