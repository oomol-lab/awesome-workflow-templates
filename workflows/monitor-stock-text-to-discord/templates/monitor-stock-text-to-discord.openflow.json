    "modules": {
      "n_31b70975b52523c8": {
        "name": "Prepare the page URL",
        "imports": [],
        "source": "export default function stockHop({ initialUrl, previous }) {\n  return { url: previous?.nextUrl || initialUrl };\n}\n"
      },
      "n_2c11a9a3eff44660": {
        "name": "Check the page text",
        "imports": [],
        "source": "export default function stockAssess({ url, status, headers, body, previous }) {\n  const hops = previous?.hops ?? 0;\n  if (!Number.isInteger(hops) || hops < 0) throw Error(\"Invalid redirect state\");\n  if (status >= 300 && status < 400 && typeof headers?.location === \"string\" && headers.location) {\n    if (hops >= 21) throw Error(\"Too many redirects\");\n    let target;\n    try {\n      target = new URL(headers.location, url);\n    } catch {\n      throw Error(\"Invalid redirect\");\n    }\n    if (![\"http:\", \"https:\"].includes(target.protocol) || target.username || target.password)\n      throw Error(\"Unsupported redirect target\");\n    return { state: { hops: hops + 1, nextUrl: target.toString() }, redirect: true, absent: false };\n  }\n  if (!Number.isInteger(status) || status < 200 || status >= 300)\n    throw Error(\"Page request failed\");\n  if (body === null) body = \"\";\n  if (typeof body !== \"string\") throw Error(\"Page response is not text\");\n  return { state: { hops, nextUrl: \"\" }, redirect: false, absent: !body.includes(\"Out Of Stock\") };\n}\n"
      }
    }
