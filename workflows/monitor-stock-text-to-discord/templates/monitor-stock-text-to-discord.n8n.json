{
  "name": "Notify Discord When Stock Text Is Absent",
  "nodes": [
    {
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "position": [
        210,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "monitor-stock-text-to-discord-0"
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        400,
        300
      ],
      "parameters": {
        "url": "https://example.com",
        "options": {},
        "responseFormat": "string"
      },
      "typeVersion": 1,
      "id": "monitor-stock-text-to-discord-1"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        550,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"HTTP Request\"].json[\"data\"]}}",
              "value2": "Out Of Stock",
              "operation": "contains"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "monitor-stock-text-to-discord-2"
    },
    {
      "id": "monitor-stock-text-to-discord-3",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        700,
        450
      ],
      "parameters": {
        "authentication": "botToken",
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DISCORD_SERVER_ID"
        },
        "sendTo": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DISCORD_CHANNEL_ID"
        },
        "content": "value not found",
        "options": {}
      }
    }
  ],
  "active": false,
  "settings": {
    "timezone": "America/Los_Angeles"
  },
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF": {
      "main": [
        [],
        [
          {
            "node": "Notify Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
