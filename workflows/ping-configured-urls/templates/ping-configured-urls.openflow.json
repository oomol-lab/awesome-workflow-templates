    "modules": {
      "n_ac0f5ae8aa5dce5f": {
        "name": "Prepare the next URL",
        "imports": [],
        "source": "export default function next({ urls, previousState, previousResult }) {\n  if (!Array.isArray(urls)) throw Error(\"URLs must be a list\");\n  if (!previousState)\n    for (const url of urls)\n      if (typeof url !== \"string\" || !/^https?:\\/\\/[^\\/?#@\\s]+(?:[\\/?#][^\\s]*)?$/i.test(url))\n        throw Error(\"Every URL must be HTTP or HTTPS without credentials\");\n  const index = previousState?.index ?? 0,\n    failed = !!previousState?.failed || !!previousResult?.failed;\n  if (!Number.isInteger(index) || index < 0) throw Error(\"Invalid state\");\n  if (index >= urls.length)\n    return { state: { index, failed }, more: false, url: \"https://unused.invalid\", count: index };\n  return { state: { index: index + 1, failed }, more: true, url: urls[index], count: index + 1 };\n}\n"
      },
      "n_eeabf0979559b61b": {
        "name": "Prepare the HTTP target",
        "imports": [],
        "source": "export default function serverHop({ initialUrl, index, previousState }) {\n  return {\n    url:\n      previousState?.index === index && previousState?.nextUrl ? previousState.nextUrl : initialUrl,\n  };\n}\n"
      },
      "n_940edaffa3b0c8bd": {
        "name": "Check the response",
        "imports": [],
        "source": "export default function assess({ url, index, status, headers, error, previousState }) {\n  const prior = previousState?.index === index ? previousState.hops : 0;\n  if (!Number.isInteger(prior) || prior < 0) throw Error(\"Invalid redirect state\");\n  if (error || typeof status !== \"number\")\n    return { state: { index, hops: prior, nextUrl: \"\", failed: true }, redirect: false };\n  if (status >= 300 && status < 400 && typeof headers?.location === \"string\" && headers.location) {\n    try {\n      const target = new URL(headers.location, url);\n      if (\n        prior >= 21 ||\n        ![\"http:\", \"https:\"].includes(target.protocol) ||\n        target.username ||\n        target.password\n      )\n        throw Error();\n      return {\n        state: { index, hops: prior + 1, nextUrl: target.toString(), failed: false },\n        redirect: true,\n      };\n    } catch {\n      return { state: { index, hops: prior, nextUrl: \"\", failed: true }, redirect: false };\n    }\n  }\n  return {\n    state: { index, hops: prior, nextUrl: \"\", failed: status < 200 || status >= 300 },\n    redirect: false,\n  };\n}\n"
      }
