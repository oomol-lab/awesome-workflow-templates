    "modules": {
      "n_8f9bf9d32d47c0c5": {
        "name": "Choose the dates and market",
        "imports": [],
        "source": "export default function query({ startDate, endDate, market }) {\n  const d = /^\\d{4}\\/\\d{2}\\/\\d{2}$/;\n  if (!d.test(startDate) || !d.test(endDate) || startDate > endDate)\n    throw Error(\"Enter dates as YYYY/MM/DD, start no later than end\");\n  if (typeof market !== \"string\") throw Error(\"Invalid market\");\n  return {\n    url:\n      \"https://data.moa.gov.tw/api/v1/SheepQuotation/?Start_time=\" +\n      encodeURIComponent(startDate) +\n      \"&End_time=\" +\n      encodeURIComponent(endDate),\n    market,\n  };\n}\n"
      },
      "n_ef1f19d143b5ceee": {
        "name": "Prepare quotation rows",
        "imports": [],
        "source": "export default function rows({ body, market }) {\n  if (!body || body.RS !== \"OK\" || !Array.isArray(body.Data) || body.Next !== false)\n    throw Error(\"Sheep quotation response incomplete or invalid\");\n  const fields = [\n    \"transDate\",\n    \"marketID\",\n    \"shortName\",\n    \"name\",\n    \"productID\",\n    \"productName\",\n    \"productTypeName\",\n    \"quantity\",\n    \"avgWeight\",\n    \"avgPrice\",\n    \"highestPrice\",\n    \"Record_ID\",\n  ];\n  const values = body.Data.filter((x) => !market || x.shortName === market).map((x) => {\n    if (!x || typeof x !== \"object\") throw Error(\"Invalid quotation\");\n    return fields.map((f) => {\n      if (typeof x[f] !== \"string\" && typeof x[f] !== \"number\")\n        throw Error(\"Missing quotation field: \" + f);\n      return x[f];\n    });\n  });\n  return { values, hasRows: values.length > 0 };\n}\n"
      }
    }
