        "name": "Prepare temperature message",
        "imports": [],
        "source": "export default function main({weather}) {\n  const temp=weather?.main?.temp;\n  if(typeof temp!=='number'||!Number.isFinite(temp))throw Error('Weather response does not contain a temperature');\n  return {message:`Hey! The temperature outside is ${temp}°C.`};\n}\n"
