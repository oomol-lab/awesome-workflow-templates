      ]
    },
    {
      "name": "Stop for vector review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "throw Error(\"Inspect pending page vectors before retrying\");\n"
      },
      "id": "index-notion-pages-in-pinecone-768-8",
