    {
      "id": "index-notion-pages-in-pinecone-768-2",
      "name": "Notion - Retrieve Page Content",
      "type": "n8n-nodes-base.notion",
      "position": [
        440,
        0
      ],
      "parameters": {
        "blockId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('One page at a time').item.json.id }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true,
        "simplifyOutput": true,
        "fetchNestedBlocks": false
      },
      "typeVersion": 2.2,
      "alwaysOutputData": true
    },
    {
      "name": "Prepare page text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $(\"One page at a time\").item.json,\n  blocks = $input.all().map((x) => x.json),\n  text = blocks\n    .filter((b) => b.type !== \"image\" && b.type !== \"video\")\n    .map((b) =>\n      typeof b.content === \"string\"\n        ? b.content\n        : (b[b.type]?.rich_text ?? b[b.type]?.text ?? [])\n            .map((t) => t.plain_text ?? t.text?.content ?? \"\")\n            .join(\"\"),\n    )\n    .filter(Boolean)\n    .join(\"\\n\");\nconst title =\n  p.properties?.Name?.title?.map((x) => x.plain_text ?? x.text?.content ?? \"\").join(\"\") ?? \"\";\nif (!p.id || !p.created_time) throw Error(\"Missing page metadata\");\nreturn [{ json: { pageId: p.id, createdTime: p.created_time, pageTitle: title, text } }];\n"
      },
      "id": "index-notion-pages-in-pinecone-768-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Has page text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.text.trim().length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "index-notion-pages-in-pinecone-768-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Page not indexed",
      "type": "n8n-nodes-base.dataTable",
