      ]
    },
    {
      "name": "Verify relay receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status !== \"completed\") throw Error(\"Unknown relay result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "index-notion-pages-in-pinecone-768-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "name": "Prepare Gemini chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const page = $(\"Prepare page text\").item.json,\n  chunks = [];\nfor (let i = 0; i < page.text.length; i += 880) {\n  chunks.push(page.text.slice(i, i + 1000));\n  if (i + 1000 >= page.text.length) break;\n}\nif (chunks.length > 20) throw Error(\"Page exceeds 20 chunks\");\nconst model = \"models/gemini-embedding-2\";\nreturn {\n  json: {\n    chunks,\n    requests: chunks.map((text) => ({\n      model,\n      content: { parts: [{ text }] },\n      outputDimensionality: 768,\n    })),\n  },\n};\n"
      },
      "id": "index-notion-pages-in-pinecone-768-14",
      "position": [
        3080,
        0
      ]
    },
    {
      "name": "Embed page chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-2:batchEmbedContents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {requests:$json.requests} }}",
        "options": {}
      },
      "id": "index-notion-pages-in-pinecone-768-15",
      "position": [
        3300,
        0
      ]
    },
    {
      "name": "Prepare Pinecone vectors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Prepare page text\").item.json,\n  c = $(\"Prepare Gemini chunks\").item.json.chunks,\n  r = $json.embeddings;\nif (!Array.isArray(r) || r.length !== c.length) throw Error(\"Embedding count mismatch\");\nconst vectors = c.map((content, i) => {\n  const v = r[i]?.values;\n  if (!Array.isArray(v) || v.length !== 768 || v.some((x) => !Number.isFinite(x)))\n    throw Error(\"Invalid embedding\");\n  return {\n    id: p.pageId + \":\" + i,\n    values: v,\n    metadata: { pageId: p.pageId, createdTime: p.createdTime, pageTitle: p.pageTitle, content },\n  };\n});\nreturn { json: { vectors } };\n"
      },
      "id": "index-notion-pages-in-pinecone-768-16",
      "position": [
        3520,
        0
      ]
    },
    {
      "name": "Upsert Pinecone vectors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_INDEX_HOST/vectors/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Pinecone-Api-Version",
              "value": "2025-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {vectors:$json.vectors} }}",
        "options": {}
      },
      "id": "index-notion-pages-in-pinecone-768-17",
      "position": [
        3740,
        0
      ]
    },
    {
      "name": "Verify vector upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.upsertedCount !== $(\"Prepare Pinecone vectors\").item.json.vectors.length)\n  throw Error(\"Unknown Pinecone result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "index-notion-pages-in-pinecone-768-18",
      "position": [
        3960,
        0
      ]
    },
