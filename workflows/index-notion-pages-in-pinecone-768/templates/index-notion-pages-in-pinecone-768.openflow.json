    "modules": {
      "n_0bc44d8ec8c42127": {
        "name": "Prepare page chunks",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const { pageId, createdTime, pageTitle, text } = body;\n  if (\n    !pageId ||\n    !createdTime ||\n    typeof pageTitle !== \"string\" ||\n    typeof text !== \"string\" ||\n    !text.trim()\n  )\n    throw Error(\"Missing page metadata or text\");\n  const chunks = [];\n  for (let i = 0; i < text.length; i += 880) {\n    chunks.push(text.slice(i, i + 1000));\n    if (i + 1000 >= text.length) break;\n  }\n  if (chunks.length > 20) throw Error(\"Page exceeds 20 chunks; split it before indexing\");\n  const model = \"models/gemini-embedding-2\";\n  return {\n    request: {\n      requests: chunks.map((text) => ({\n        model,\n        content: { parts: [{ text }] },\n        outputDimensionality: 768,\n      })),\n    },\n    chunks,\n    metadata: { pageId, createdTime, pageTitle },\n  };\n}\n"
      },
      "n_57d94de53d8f8573": {
        "name": "Reserve page indexing",
        "imports": [],
        "source": "export default async function plan({ response, chunks, metadata, acknowledge, resolution }, ctx) {\n  if (!Array.isArray(response?.embeddings) || response.embeddings.length !== chunks.length)\n    throw Error(\"Embedding count mismatch\");\n  const vectors = chunks.map((content, i) => {\n      const v = response.embeddings[i]?.values;\n      if (!Array.isArray(v) || v.length !== 768 || v.some((x) => !Number.isFinite(x)))\n        throw Error(\"Invalid embedding \" + i);\n      return { id: metadata.pageId + \":\" + i, values: v, metadata: { ...metadata, content } };\n    }),\n    key = \"notion-pinecone:\" + metadata.pageId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { write: false, key, request: { vectors: [] }, count: 0 };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect Pinecone records for \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { write: false, key, request: { vectors: [] }, count: 0 };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { write: true, key, request: { vectors }, count: vectors.length };\n}\n"
      },
      "n_decd8c5a35c518b1": {
        "name": "Confirm page indexing",
        "imports": [],
        "source": "export default async function confirm({ key, response, count }, ctx) {\n  if (response?.upsertedCount !== count) throw Error(\"Unknown Pinecone write\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_0b248d43f73e0be2": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
