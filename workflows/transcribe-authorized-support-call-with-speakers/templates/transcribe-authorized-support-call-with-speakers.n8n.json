              "value": "300"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({sources:$(\"Validate consent URL and limits\").first().json.sources,language:$(\"Validate consent URL and limits\").first().json.language,diarization:true,output_formats:[\"json\",\"srt\",\"vtt\",\"txt\"],maxDurationMinutes:$(\"Validate consent URL and limits\").first().json.maxDurationMinutes,integrationSource:\"n8n-c157-support-call-review\"}) }}",
        "options": {
          "timeout": 295000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "id": "transcribe-authorized-support-call-with-speakers-3",
      "name": "Transcribe support call on Apify"
    },
    {
      "parameters": {
        "jsCode": "const expected = $(\"Validate consent URL and limits\").first().json;\nconst rows = $input.all().flatMap((item) => (Array.isArray(item.json) ? item.json : [item.json]));\nif (rows.length !== 1) throw new Error(\"Expected exactly one transcription result\");\nconst row = rows[0];\nif (\n  row.url !== expected.sources[0] ||\n  row.integrationSource !== expected.integrationSource ||\n  typeof row.text !== \"string\" ||\n  !Array.isArray(row.segments) ||\n  !row.files ||\n  typeof row.files !== \"object\" ||\n  !Number.isInteger(row.charged_minutes) ||\n  row.charged_minutes < 1 ||\n  row.charged_minutes > expected.maxDurationMinutes\n)\n  throw new Error(\"The Actor response failed semantic validation\");\nreturn [{ json: row }];\n"
      },
      "type": "n8n-nodes-base.code",
