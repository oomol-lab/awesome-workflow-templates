    {
      "parameters": {
        "jsCode": "function prepare({ mediaUrl, language, maxDurationMinutes, confirmRightsAndConsent }) {\n  if (confirmRightsAndConsent !== true)\n    throw Error(\"Confirm processing rights and any required speaker consent\");\n  const raw = String(mediaUrl || \"\").trim(),\n    m = /^https:\\/\\/([a-z0-9.-]+)(?::(\\d{1,5}))?([/?#][^\\s]*)?$/i.exec(raw);\n  if (!m) throw Error(\"Use one public HTTPS media URL without credentials\");\n  const host = m[1].toLowerCase(),\n    port = m[2] ? Number(m[2]) : 443,\n    parts = host.split(\".\");\n  if (\n    port < 1 ||\n    port > 65535 ||\n    parts.length < 2 ||\n    parts.some((x) => !x || x.length > 63 || !/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(x)) ||\n    host.endsWith(\".local\") ||\n    host.endsWith(\".internal\")\n  )\n    throw Error(\"Use a public host\");\n  if (/^[0-9.]+$/.test(host)) {\n    if (\n      parts.length !== 4 ||\n      parts.some((x) => !/^\\d{1,3}$/.test(x) || Number(x) > 255 || String(Number(x)) !== x)\n    )\n      throw Error(\"Invalid IPv4\");\n    const [a, b] = parts.map(Number);\n    if (\n      a === 0 ||\n      a === 10 ||\n      a === 127 ||\n      a >= 224 ||\n      (a === 169 && b === 254) ||\n      (a === 192 && b === 168) ||\n      (a === 172 && b >= 16 && b <= 31)\n    )\n      throw Error(\"Use a public host\");\n  } else if (!/^[a-z]{2,63}$/i.test(parts.at(-1))) throw Error(\"Invalid hostname\");\n  const lang = String(language || \"pt\").toLowerCase(),\n    max = Number(maxDurationMinutes);\n  if (!/^[a-z]{2,3}$/.test(lang) || !Number.isInteger(max) || max < 1 || max > 20)\n    throw Error(\"Invalid language or duration\");\n  let rest = m[3] || \"/\";\n  if (rest.startsWith(\"?\") || rest.startsWith(\"#\")) rest = \"/\" + rest;\n  const url = \"https://\" + host + (m[2] && port !== 443 ? \":\" + port : \"\") + rest;\n  return {\n    request: {\n      sources: [url],\n      language: lang,\n      diarization: true,\n      output_formats: [\"json\", \"srt\", \"vtt\", \"txt\"],\n      maxDurationMinutes: max,\n      integrationSource: \"n8n-c157-support-call-review\",\n    },\n  };\n}\n\nconst cfg = $input.first().json,\n  id = String(cfg.requestId || \"\").trim();\nif (!id || id.startsWith(\"YOUR_\")) throw Error(\"Provide a unique request ID\");\nreturn [{ json: { ...prepare(cfg).request, requestId: id } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "transcribe-authorized-support-call-with-speakers-2",
      "name": "Validate consent URL and limits"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/vivid_astronaut~audio-video-transcription-diarization/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxItems",
              "value": "1"
            },
