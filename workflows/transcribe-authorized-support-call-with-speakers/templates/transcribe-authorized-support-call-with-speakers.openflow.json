      "n_3ccc209aafa69ba8": {
        "name": "Validate and reserve transcription",
        "imports": [],
        "source": "function prepare({ mediaUrl, language, maxDurationMinutes, confirmRightsAndConsent }) {\n  if (confirmRightsAndConsent !== true)\n    throw Error(\"Confirm processing rights and any required speaker consent\");\n  const raw = String(mediaUrl || \"\").trim(),\n    m = /^https:\\/\\/([a-z0-9.-]+)(?::(\\d{1,5}))?([/?#][^\\s]*)?$/i.exec(raw);\n  if (!m) throw Error(\"Use one public HTTPS media URL without credentials\");\n  const host = m[1].toLowerCase(),\n    port = m[2] ? Number(m[2]) : 443,\n    parts = host.split(\".\");\n  if (\n    port < 1 ||\n    port > 65535 ||\n    parts.length < 2 ||\n    parts.some((x) => !x || x.length > 63 || !/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(x)) ||\n    host.endsWith(\".local\") ||\n    host.endsWith(\".internal\")\n  )\n    throw Error(\"Use a public host\");\n  if (/^[0-9.]+$/.test(host)) {\n    if (\n      parts.length !== 4 ||\n      parts.some((x) => !/^\\d{1,3}$/.test(x) || Number(x) > 255 || String(Number(x)) !== x)\n    )\n      throw Error(\"Invalid IPv4\");\n    const [a, b] = parts.map(Number);\n    if (\n      a === 0 ||\n      a === 10 ||\n      a === 127 ||\n      a >= 224 ||\n      (a === 169 && b === 254) ||\n      (a === 192 && b === 168) ||\n      (a === 172 && b >= 16 && b <= 31)\n    )\n      throw Error(\"Use a public host\");\n  } else if (!/^[a-z]{2,63}$/i.test(parts.at(-1))) throw Error(\"Invalid hostname\");\n  const lang = String(language || \"pt\").toLowerCase(),\n    max = Number(maxDurationMinutes);\n  if (!/^[a-z]{2,3}$/.test(lang) || !Number.isInteger(max) || max < 1 || max > 20)\n    throw Error(\"Invalid language or duration\");\n  let rest = m[3] || \"/\";\n  if (rest.startsWith(\"?\") || rest.startsWith(\"#\")) rest = \"/\" + rest;\n  const url = \"https://\" + host + (m[2] && port !== 443 ? \":\" + port : \"\") + rest;\n  return {\n    request: {\n      sources: [url],\n      language: lang,\n      diarization: true,\n      output_formats: [\"json\", \"srt\", \"vtt\", \"txt\"],\n      maxDurationMinutes: max,\n      integrationSource: \"n8n-c157-support-call-review\",\n    },\n  };\n}\n\nexport default async function (\n  { mediaUrl, language, maxDurationMinutes, confirmRightsAndConsent, requestId },\n  ctx,\n) {\n  const request = prepare({\n      mediaUrl,\n      language,\n      maxDurationMinutes,\n      confirmRightsAndConsent,\n    }).request,\n    id = String(requestId || \"\").trim();\n  if (!id) throw Error(\"Provide a unique request ID\");\n  const key = \"call-transcription:\" + id,\n    fingerprint = JSON.stringify(request),\n    s = await ctx.state.get(key);\n  if (s && s.fingerprint !== fingerprint) throw Error(\"Request ID belongs to different input\");\n  if (s && !s.runId) throw Error(\"Actor start outcome unknown; inspect Apify\");\n  if (s)\n    return {\n      key,\n      domain: request.sources[0],\n      limit: request.maxDurationMinutes,\n      runId: s.runId,\n      start: false,\n      body: request,\n    };\n  await ctx.state.set(key, { fingerprint, status: \"start-pending\" });\n  return {\n    key,\n    domain: request.sources[0],\n    limit: request.maxDurationMinutes,\n    runId: \"pending\",\n    start: true,\n    body: request,\n  };\n}\n"
      },
      "n_39897a29061b0810": {
        "name": "Record Actor run ID",
        "imports": [],
        "source": "export default async function ({ key, body }, ctx) {\n  const id = body?.data?.id,\n    s = await ctx.state.get(key);\n  if (typeof id !== \"string\" || !id || !s?.fingerprint) throw Error(\"Unknown Actor start outcome\");\n  await ctx.state.set(key, { ...s, status: \"running\", runId: id });\n  return { runId: id };\n}\n"
      },
      "n_6d7a87f745c7ef52": {
        "name": "Select Actor run",
        "imports": [],
        "source": "export default function ({ fresh, existing }) {\n  return { runId: fresh || existing };\n}\n"
      },
      "n_d3cf96a4c7c5c02a": {
        "name": "Check Actor status",
        "imports": [],
        "source": "export default function ({ run, runId, previous }) {\n  if (run?.id !== runId) throw Error(\"Actor run ID mismatch\");\n  if ([\"FAILED\", \"ABORTED\", \"TIMED-OUT\"].includes(run.status))\n    throw Error(\"Actor failed: \" + run.status);\n  const count = (previous?.count || 0) + 1;\n  if (count > 31) throw Error(\"Actor still running; resume this request later\");\n  if (run.status === \"SUCCEEDED\" && !run.defaultDatasetId) throw Error(\"Missing dataset\");\n  return {\n    state: { count },\n    done: run.status === \"SUCCEEDED\",\n    datasetId: run.defaultDatasetId || \"pending\",\n  };\n}\n"
      },
      "n_d3b26f205f2ead91": {
        "name": "Validate speaker-labelled result",
        "imports": [],
        "source": "export default function ({ items, domain, limit }) {\n  if (!Array.isArray(items) || items.length !== 1) throw Error(\"Expected one transcription\");\n  const r = items[0];\n  if (\n    r.url !== domain ||\n    r.integrationSource !== \"n8n-c157-support-call-review\" ||\n    typeof r.text !== \"string\" ||\n    !Array.isArray(r.segments) ||\n    !r.files ||\n    typeof r.files !== \"object\" ||\n    !Number.isInteger(r.charged_minutes) ||\n    r.charged_minutes < 1 ||\n    r.charged_minutes > limit\n  )\n    throw Error(\"Transcription result mismatch\");\n  return { result: r };\n}\n"
      }
