{
  "nodes": [
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        630,
        990
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "deal_value",
              "value": "={{$json[\"properties\"][\"amount\"][\"value\"]}}"
            },
            {
              "name": "deal_id",
              "value": "={{$json[\"dealId\"]}}"
            }
          ],
          "string": [
            {
              "name": "deal_name",
              "value": "={{$json[\"properties\"][\"dealname\"][\"value\"]}}"
            },
            {
              "name": "deal_description",
              "value": "={{$json[\"properties\"][\"description\"][\"value\"]}}"
            },
            {
              "name": "deal_type",
              "value": "={{$json[\"properties\"][\"dealtype\"][\"value\"]}}"
            },
            {
              "name": "deal_stage",
              "value": "={{$json[\"properties\"][\"dealstage\"][\"value\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-0"
    },
    {
      "name": "Switch",
      "type": "n8n-nodes-base.switch",
      "position": [
        830,
        740
      ],
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "closedwon"
            },
            {
              "output": 1,
              "value2": "presentationscheduled"
            },
            {
              "output": 2,
              "value2": "closedlost"
            }
          ]
        },
        "value1": "={{$node[\"Hubspot\"].json[\"properties\"][\"dealstage\"][\"value\"]}}",
        "dataType": "string"
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-1"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        830,
        1140
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"deal_value\"]}}",
              "value2": 500,
              "operation": "larger"
            }
          ],
          "string": [
            {
              "value1": "={{$json[\"deal_type\"]}}",
              "value2": "newbusiness"
            },
            {
              "value1": "={{$json[\"deal_stage\"]}}",
              "value2": "closedlost|closedwon",
              "operation": "notEqual"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-2"
    },
    {
      "name": "high-priority",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        1030,
        1040
      ],
      "parameters": {
        "stageId": "YOUR_TICKET_STAGE_ID",
        "resource": "ticket",
        "pipelineId": "YOUR_TICKET_PIPELINE_ID",
        "ticketName": "=Deal: {{$json[\"deal_name\"]}}",
        "additionalFields": {
          "priority": "HIGH",
          "description": "={{$json[\"deal_description\"]}}",
          "ticketOwnerId": "YOUR_HIGH_PRIORITY_OWNER_ID"
        }
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-3"
    },
    {
      "name": "low-priority",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        1030,
        1240
      ],
      "parameters": {
        "stageId": "YOUR_TICKET_STAGE_ID",
        "resource": "ticket",
        "pipelineId": "YOUR_TICKET_PIPELINE_ID",
        "ticketName": "=Deal: {{$json[\"deal_name\"]}}",
        "additionalFields": {
          "priority": "MEDIUM",
          "description": "={{$json[\"deal_description\"]}}"
        }
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-4"
    },
    {
      "name": "#closedwon",
      "type": "n8n-nodes-base.slack",
      "position": [
        1030,
        590
      ],
      "parameters": {
        "text": "={{ 'We successfully closed the deal ' + $('Set').item.json.deal_name + '!' }}",
        "channel": "YOUR_SLACK_CHANNEL_ID",
        "attachments": [],
        "otherOptions": {}
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-5"
    },
    {
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "position": [
        1030,
        890
      ],
      "parameters": {
        "table": "YOUR_AIRTABLE_TABLE_ID",
        "fields": [
          "deal_name",
          "deal_id",
          "deal_type"
        ],
        "options": {},
        "operation": "append",
        "application": "YOUR_AIRTABLE_BASE_ID",
        "addAllFields": false
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-6"
    },
    {
      "name": "Google Slides",
      "type": "n8n-nodes-base.googleSlides",
      "position": [
        1030,
        740
      ],
      "parameters": {
        "title": "={{ 'Presentation for deal ' + $('Set').item.json.deal_name }}",
        "authentication": "oAuth2"
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-7"
    },
    {
      "name": "Hubspot Trigger",
      "type": "n8n-nodes-base.hubspotTrigger",
      "position": [
        240,
        990
      ],
      "parameters": {
        "eventsUi": {
          "eventValues": [
            {
              "name": "deal.creation"
            }
          ]
        },
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-8"
    },
    {
      "name": "Hubspot",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        440,
        990
      ],
      "parameters": {
        "dealId": "={{$json[\"dealId\"]}}",
        "operation": "get",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-9"
    }
  ],
