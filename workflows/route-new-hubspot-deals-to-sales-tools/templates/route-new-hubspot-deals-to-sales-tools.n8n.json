{
  "name": "Route New HubSpot Deals to Sales Tools",
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "route-new-hubspot-deals-to-sales-tools-0",
      "name": "Receive HubSpot events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "receive-hubspot-app-events",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "route-new-hubspot-deals-to-sales-tools-1",
      "name": "Read original request bytes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bytes = await helpers.getBinaryDataBuffer($itemIndex, \"data\");\nreturn {\n  json: { headers: $json.headers, raw: bytes.toString(\"utf8\") },\n  binary: $binary,\n  pairedItem: { item: $itemIndex },\n};\n"
      }
    },
    {
      "id": "route-new-hubspot-deals-to-sales-tools-2",
      "name": "Compute HubSpot signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "binaryData": false,
        "value": "={{ $env.HUBSPOT_CLIENT_SECRET + $json.raw }}",
        "dataPropertyName": "computedHmac",
        "encoding": "hex"
      }
    },
    {
      "id": "route-new-hubspot-deals-to-sales-tools-3",
      "name": "Valid HubSpot request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.computedHmac }}",
              "rightValue": "={{ $json.headers['x-hubspot-signature'] }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.headers['x-hubspot-signature'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $env.HUBSPOT_CLIENT_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "route-new-hubspot-deals-to-sales-tools-4",
      "name": "Decode events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const events = JSON.parse($input.first().json.raw, (key, value, context) =>\n  typeof value === \"number\" && Number.isInteger(value) && !Number.isSafeInteger(value)\n    ? context.source\n    : value,\n);\nreturn events.map((event) => {\n  const type = event.subscriptionType || \"\";\n  for (const name of [\"contact\", \"company\", \"deal\", \"ticket\"])\n    if (type.includes(name)) event[name + \"Id\"] = event.objectId;\n  delete event.objectId;\n  return { json: event };\n});\n"
      }
    },
    {
      "id": "route-new-hubspot-deals-to-sales-tools-5",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify($json)} }}",
        "options": {}
      }
    },
    {
      "name": "Is deal creation?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.subscriptionType }}",
              "value2": "deal.creation"
            }
          ]
        }
      },
      "id": "route-new-hubspot-deals-to-sales-tools-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Deal event not processed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'deal:' + $('Decode events').item.json.eventId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "route-new-hubspot-deals-to-sales-tools-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Reserve deal event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'deal:' + $('Decode events').item.json.eventId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "route-new-hubspot-deals-to-sales-tools-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Hubspot",
      "type": "n8n-nodes-base.hubspot",
      "position": [
        1980,
        0
      ],
      "parameters": {
        "dealId": "={{ $('Decode events').item.json.dealId }}",
        "operation": "get",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-9"
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "position": [
        2200,
        0
      ],
      "parameters": {
        "values": {
          "number": [
            {
              "name": "deal_value",
              "value": "={{$json[\"properties\"][\"amount\"][\"value\"]}}"
            },
            {
              "name": "deal_id",
              "value": "={{$json[\"dealId\"]}}"
            }
          ],
          "string": [
            {
              "name": "deal_name",
              "value": "={{$json[\"properties\"][\"dealname\"][\"value\"]}}"
            },
            {
              "name": "deal_description",
              "value": "={{$json[\"properties\"][\"description\"][\"value\"]}}"
            },
            {
              "name": "deal_type",
              "value": "={{$json[\"properties\"][\"dealtype\"][\"value\"]}}"
            },
            {
              "name": "deal_stage",
              "value": "={{$json[\"properties\"][\"dealstage\"][\"value\"]}}"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-10"
    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        2420,
        0
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"deal_value\"]}}",
              "value2": 500,
              "operation": "larger"
            }
          ],
          "string": [
            {
              "value1": "={{$json[\"deal_type\"]}}",
              "value2": "newbusiness"
            },
            {
              "value1": "={{$json[\"deal_stage\"]}}",
              "value2": "closedlost|closedwon",
              "operation": "notEqual"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "route-new-hubspot-deals-to-sales-tools-11"
    },
