    "modules": {
      "n_697d89b75025a109": {
        "name": "Set the reporting dates",
        "imports": [],
        "source": "export default function window(){const p=new Intl.DateTimeFormat('en-CA-u-ca-iso8601',{timeZone:'America/Los_Angeles',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()),v=Object.fromEntries(p.map(x=>[x.type,x.value])),today=Date.UTC(Number(v.year),Number(v.month)-1,Number(v.day)),date=n=>new Date(today-n*86400000).toISOString().slice(0,10);return {startDate:date(7),endDate:date(1)};}\n"
      },
      "n_bb6e4f89649e94a3": {
        "name": "Prepare the report",
        "imports": [],
        "source": "export default function summarize({rows,startDate,endDate}){if(!Array.isArray(rows)||rows.length>10)throw Error('Invalid Search Console rows');let lines=[];for(const [i,r] of rows.entries()){if(!Array.isArray(r.keys)||r.keys.length!==1||typeof r.keys[0]!=='string'||!['clicks','impressions','ctr','position'].every(k=>typeof r[k]==='number'&&Number.isFinite(r[k])))throw Error('Invalid Search Console row');const query=r.keys[0].replace(/[\\r\\n]+/g,' ');lines.push(`${i+1}. ${query} - Clicks: ${r.clicks}, Impressions: ${r.impressions}, CTR: ${r.ctr.toFixed(2)}, Position: ${r.position.toFixed(2)}`)}return {text:`Top 10 Search Queries (${startDate} through ${endDate}, Pacific Time):\\n\\n${lines.length?lines.join('\\n'):'No data returned.'}`};}\n"
      }
    }
