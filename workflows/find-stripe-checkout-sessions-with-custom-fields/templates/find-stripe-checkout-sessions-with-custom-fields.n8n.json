      "name": "Select matching sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input\n  .all()\n  .map((item, index) => ({ json: item.json, pairedItem: { item: index } }))\n  .filter(({ json: s }) => {\n    const fields = s.custom_fields ?? [];\n    const filled = (key) =>\n      fields.some(\n        (f) => f.key === key && typeof f[f.type]?.value === \"string\" && f[f.type].value.length > 0,\n      );\n    return filled(\"nickname\") && filled(\"job_title\");\n  });\n"
      }
    }
