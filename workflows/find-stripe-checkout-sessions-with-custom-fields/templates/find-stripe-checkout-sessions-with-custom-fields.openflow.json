    "modules": {
      "n_172d8d5dd4d27fc1": {
        "name": "Prepare session page",
        "imports": [],
        "source": "export default function page({ previous }) {\n  const now = new Date();\n  now.setUTCHours(0, 0, 0, 0);\n  const end = previous?.end ?? Math.floor(now.getTime() / 1000),\n    start = previous?.start ?? end - 20 * 86400;\n  const q = new URLSearchParams({\n    \"created[gte]\": String(start),\n    \"created[lte]\": String(end),\n    limit: \"100\",\n  });\n  if (previous?.cursor) q.set(\"starting_after\", previous.cursor);\n  return { url: \"https://api.stripe.com/v1/checkout/sessions?\" + q.toString(), start, end };\n}\n"
      },
      "n_66f1f0149a262585": {
        "name": "Select matching sessions",
        "imports": [],
        "source": "export default function collect({ page, previous, start, end }) {\n  const items = [...(previous?.items ?? [])];\n  for (const session of page.data) {\n    const fields = session.custom_fields ?? [];\n    const filled = (key) =>\n      fields.some(\n        (f) => f.key === key && typeof f[f.type]?.value === \"string\" && f[f.type].value.length > 0,\n      );\n    if (filled(\"nickname\") && filled(\"job_title\")) items.push(session);\n  }\n  const cursor = page.has_more ? page.data.at(-1)?.id : null;\n  if (page.has_more && (!cursor || cursor === previous?.cursor))\n    throw Error(\"Stripe pagination did not advance\");\n  return { state: { items, cursor, start, end }, sessions: items, hasNext: page.has_more };\n}\n"
      }
    }
