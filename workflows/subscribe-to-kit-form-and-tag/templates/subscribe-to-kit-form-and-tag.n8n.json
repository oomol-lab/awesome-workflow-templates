{
  "name": "Subscribe to a Kit Form and Tag",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        300,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-0"
    },
    {
      "name": "Set subscription details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function setup({ email, formId, tagName }) {\n  if (typeof email !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()))\n    throw Error(\"Enter a valid email\");\n  if (\n    typeof formId !== \"string\" ||\n    !/^\\d+$/.test(formId) ||\n    !Number.isSafeInteger(Number(formId)) ||\n    Number(formId) < 1\n  )\n    throw Error(\"Enter a numeric form ID\");\n  if (typeof tagName !== \"string\" || !tagName.trim() || tagName.includes(\",\"))\n    throw Error(\"Enter one tag name\");\n  email = email.trim();\n  return {\n    email,\n    formId: Number(formId),\n    tagName: tagName.trim(),\n    formUrl: \"https://api.convertkit.com/v3/forms/\" + formId + \"/subscribe\",\n    formBody: { email },\n    tagBody: { tag: [{ name: tagName.trim() }] },\n  };\n}\n\nreturn [{ json: setup({ email: \"\", formId: \"\", tagName: \"\" }) }];\n"
      },
      "id": "subscribe-to-kit-form-and-tag-1"
    },
    {
      "name": "ConvertKit",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        500,
        300
      ],
      "parameters": {
        "id": "={{ $(\"Set subscription details\").first().json.formId }}",
        "email": "={{ $(\"Set subscription details\").first().json.email }}",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-2"
    },
    {
      "name": "Confirm form subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $input.first().json;\nif (\n  !Number.isSafeInteger(s?.id) ||\n  s.id < 1 ||\n  !Number.isSafeInteger(s?.subscriber?.id) ||\n  s.subscriber.id < 1\n)\n  throw Error(\"Form subscription not confirmed\");\nreturn $input.all();\n"
      },
      "id": "subscribe-to-kit-form-and-tag-3"
    },
    {
      "name": "ConvertKit1",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        710,
        300
      ],
      "parameters": {
        "name": "={{ $(\"Set subscription details\").first().json.tagName }}",
        "resource": "tag"
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-4"
    },
    {
      "name": "Confirm tag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $input.first().json;\nif (\n  !Number.isSafeInteger(t?.id) ||\n  t.id < 1 ||\n  t.name !== $(\"Set subscription details\").first().json.tagName\n)\n  throw Error(\"Tag creation not confirmed\");\nreturn $input.all();\n"
      },
      "id": "subscribe-to-kit-form-and-tag-5"
    },
    {
      "name": "ConvertKit2",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        910,
        300
      ],
      "parameters": {
        "email": "={{ $(\"Set subscription details\").first().json.email }}",
        "tagId": "={{ $(\"ConvertKit1\").first().json.id }}",
        "resource": "tagSubscriber",
        "operation": "add",
        "additionalFields": {
          "fields": {
            "field": []
          }
        }
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-6"
    },
    {
      "name": "Confirm tag subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $input.first().json,\n  f = $(\"Confirm form subscription\").first().json,\n  t = $(\"Confirm tag\").first().json;\nif (\n  !Number.isSafeInteger(s?.id) ||\n  s.id < 1 ||\n  s.subscriber?.id !== f.subscriber.id ||\n  s.subscribable_id !== t.id\n)\n  throw Error(\"Tag subscription does not match\");\nreturn $input.all();\n"
      },
      "id": "subscribe-to-kit-form-and-tag-7"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set subscription details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set subscription details": {
      "main": [
        [
          {
            "node": "ConvertKit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit": {
      "main": [
        [
          {
            "node": "Confirm form subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm form subscription": {
      "main": [
        [
          {
            "node": "ConvertKit1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit1": {
      "main": [
        [
          {
            "node": "Confirm tag",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm tag": {
      "main": [
        [
          {
            "node": "ConvertKit2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit2": {
      "main": [
        [
          {
            "node": "Confirm tag subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
