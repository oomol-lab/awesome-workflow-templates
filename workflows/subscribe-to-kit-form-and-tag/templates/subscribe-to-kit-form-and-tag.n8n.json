{
  "name": "Subscribe to a Kit Form and Tag",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        300,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-0"
    },
    {
      "name": "Set subscription details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function setup({email,formId,tagName}){if(typeof email!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(email.trim()))throw Error('Enter a valid email');if(typeof formId!=='string'||!/^\\d+$/.test(formId)||!Number.isSafeInteger(Number(formId))||Number(formId)<1)throw Error('Enter a numeric form ID');if(typeof tagName!=='string'||!tagName.trim()||tagName.includes(','))throw Error('Enter one tag name');email=email.trim();return {email,formId:Number(formId),tagName:tagName.trim(),formUrl:'https://api.convertkit.com/v3/forms/'+formId+'/subscribe',formBody:{email},tagBody:{tag:[{name:tagName.trim()}]}};}\n\nreturn [{json:setup({email:'',formId:'',tagName:''})}];"
      },
      "id": "subscribe-to-kit-form-and-tag-1"
    },
    {
      "name": "ConvertKit",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        500,
        300
      ],
      "parameters": {
        "id": "={{ $(\"Set subscription details\").first().json.formId }}",
        "email": "={{ $(\"Set subscription details\").first().json.email }}",
        "additionalFields": {}
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-2"
    },
    {
      "name": "Confirm form subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(!Number.isSafeInteger(s?.id)||s.id<1||!Number.isSafeInteger(s?.subscriber?.id)||s.subscriber.id<1)throw Error(\"Form subscription not confirmed\");return $input.all();"
      },
      "id": "subscribe-to-kit-form-and-tag-3"
    },
    {
      "name": "ConvertKit1",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        710,
        300
      ],
      "parameters": {
        "name": "={{ $(\"Set subscription details\").first().json.tagName }}",
        "resource": "tag"
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-4"
    },
    {
      "name": "Confirm tag",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t=$input.first().json;if(!Number.isSafeInteger(t?.id)||t.id<1||t.name!==$(\"Set subscription details\").first().json.tagName)throw Error(\"Tag creation not confirmed\");return $input.all();"
      },
      "id": "subscribe-to-kit-form-and-tag-5"
    },
    {
      "name": "ConvertKit2",
      "type": "n8n-nodes-base.convertKit",
      "position": [
        910,
        300
      ],
      "parameters": {
        "email": "={{ $(\"Set subscription details\").first().json.email }}",
        "tagId": "={{ $(\"ConvertKit1\").first().json.id }}",
        "resource": "tagSubscriber",
        "operation": "add",
        "additionalFields": {
          "fields": {
            "field": []
          }
        }
      },
      "typeVersion": 1,
      "id": "subscribe-to-kit-form-and-tag-6"
    },
    {
      "name": "Confirm tag subscription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json, f=$(\"Confirm form subscription\").first().json, t=$(\"Confirm tag\").first().json;if(!Number.isSafeInteger(s?.id)||s.id<1||s.subscriber?.id!==f.subscriber.id||s.subscribable_id!==t.id)throw Error(\"Tag subscription does not match\");return $input.all();"
      },
      "id": "subscribe-to-kit-form-and-tag-7"
    }
  ],
  "active": false,
  "settings": {},
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Set subscription details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set subscription details": {
      "main": [
        [
          {
            "node": "ConvertKit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit": {
      "main": [
        [
          {
            "node": "Confirm form subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm form subscription": {
      "main": [
        [
          {
            "node": "ConvertKit1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit1": {
      "main": [
        [
          {
            "node": "Confirm tag",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confirm tag": {
      "main": [
        [
          {
            "node": "ConvertKit2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ConvertKit2": {
      "main": [
        [
          {
            "node": "Confirm tag subscription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
