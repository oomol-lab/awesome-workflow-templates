    "modules": {
      "n_2c489220875ea66c": {
        "name": "Validate subscription details",
        "imports": [],
        "source": "export default function setup({ email, formId, tagName }) {\n  if (typeof email !== \"string\" || !/^\\S+@\\S+\\.\\S+$/.test(email.trim()))\n    throw Error(\"Enter a valid email\");\n  if (\n    typeof formId !== \"string\" ||\n    !/^\\d+$/.test(formId) ||\n    !Number.isSafeInteger(Number(formId)) ||\n    Number(formId) < 1\n  )\n    throw Error(\"Enter a numeric form ID\");\n  if (typeof tagName !== \"string\" || !tagName.trim() || tagName.includes(\",\"))\n    throw Error(\"Enter one tag name\");\n  email = email.trim();\n  return {\n    email,\n    formId: Number(formId),\n    tagName: tagName.trim(),\n    formUrl: \"https://api.convertkit.com/v3/forms/\" + formId + \"/subscribe\",\n    formBody: { email },\n    tagBody: { tag: [{ name: tagName.trim() }] },\n  };\n}\n"
      },
      "n_f8d3540176ccb1cd": {
        "name": "Confirm form subscription",
        "imports": [],
        "source": "export default function form({ body }) {\n  const s = body?.subscription,\n    id = s?.subscriber?.id;\n  if (!Number.isSafeInteger(id) || id < 1 || !Number.isSafeInteger(s?.id) || s.id < 1)\n    throw Error(\"Form subscription not confirmed\");\n  return { subscriberId: id };\n}\n"
      },
      "n_4fdb0f95675385cc": {
        "name": "Prepare tag subscription",
        "imports": [],
        "source": "export default function tag({ body, tagName, email }) {\n  const t = Array.isArray(body) && body.length === 1 ? body[0] : null;\n  if (!t || !Number.isSafeInteger(t.id) || t.id < 1 || t.name !== tagName)\n    throw Error(\"Tag creation not confirmed\");\n  return {\n    url: \"https://api.convertkit.com/v3/tags/\" + t.id + \"/subscribe\",\n    body: { email },\n    tagId: t.id,\n  };\n}\n"
      },
      "n_5c7d183705bd0cf5": {
        "name": "Confirm tag subscription",
        "imports": [],
        "source": "export default function confirm({ body, subscriberId, tagId }) {\n  const s = body?.subscription;\n  if (\n    !s ||\n    !Number.isSafeInteger(s.id) ||\n    s.id < 1 ||\n    s.subscriber?.id !== subscriberId ||\n    s.subscribable_id !== tagId\n  )\n    throw Error(\"Tag subscription does not match\");\n  return { subscription: s };\n}\n"
      }
    }
  },
