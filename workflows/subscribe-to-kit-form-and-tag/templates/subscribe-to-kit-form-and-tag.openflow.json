    "modules": {
      "n_2c489220875ea66c": {
        "name": "Validate subscription details",
        "imports": [],
        "source": "export default function setup({email,formId,tagName}){if(typeof email!=='string'||!/^\\S+@\\S+\\.\\S+$/.test(email.trim()))throw Error('Enter a valid email');if(typeof formId!=='string'||!/^\\d+$/.test(formId)||!Number.isSafeInteger(Number(formId))||Number(formId)<1)throw Error('Enter a numeric form ID');if(typeof tagName!=='string'||!tagName.trim()||tagName.includes(','))throw Error('Enter one tag name');email=email.trim();return {email,formId:Number(formId),tagName:tagName.trim(),formUrl:'https://api.convertkit.com/v3/forms/'+formId+'/subscribe',formBody:{email},tagBody:{tag:[{name:tagName.trim()}]}};}\n"
      },
      "n_f8d3540176ccb1cd": {
        "name": "Confirm form subscription",
        "imports": [],
        "source": "export default function form({body}){const s=body?.subscription,id=s?.subscriber?.id;if(!Number.isSafeInteger(id)||id<1||!Number.isSafeInteger(s?.id)||s.id<1)throw Error('Form subscription not confirmed');return {subscriberId:id};}\n"
      },
      "n_4fdb0f95675385cc": {
        "name": "Prepare tag subscription",
        "imports": [],
        "source": "export default function tag({body,tagName,email}){const t=Array.isArray(body)&&body.length===1?body[0]:null;if(!t||!Number.isSafeInteger(t.id)||t.id<1||t.name!==tagName)throw Error('Tag creation not confirmed');return {url:'https://api.convertkit.com/v3/tags/'+t.id+'/subscribe',body:{email},tagId:t.id};}\n"
      },
      "n_5c7d183705bd0cf5": {
        "name": "Confirm tag subscription",
        "imports": [],
        "source": "export default function confirm({body,subscriberId,tagId}){const s=body?.subscription;if(!s||!Number.isSafeInteger(s.id)||s.id<1||s.subscriber?.id!==subscriberId||s.subscribable_id!==tagId)throw Error('Tag subscription does not match');return {subscription:s};}\n"
      }
    }
