    {
      "name": "Check the summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const summary=$json.message?.content;if(typeof summary!==\"string\"||!summary.trim())throw Error(\"Summary is empty\");return {json:{summary},pairedItem:{item:$itemIndex}};"
      },
      "id": "summarize-new-google-docs-to-sheets-7"
    },
    {
      "id": "summarize-new-google-docs-to-sheets-8",
      "name": "Append the summary",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1040,
        540
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Email": "={{ $('Process documents one by one').item.json.lastModifyingUser?.emailAddress ?? '' }}",
            "Name": "={{ $('Process documents one by one').item.json.lastModifyingUser?.displayName ?? '' }}",
            "Summary": "={{ $json.summary }}"
          },
          "schema": [
            {
              "id": "Email",
              "displayName": "Email",
              "type": "string",
              "display": true,
              "required": false,
              "canBeUsedToMatch": true,
              "defaultMatch": false
            },
            {
              "id": "Name",
              "displayName": "Name",
              "type": "string",
              "display": true,
              "required": false,
              "canBeUsedToMatch": true,
              "defaultMatch": false
            },
            {
              "id": "Summary",
              "displayName": "Summary",
              "type": "string",
              "display": true,
              "required": false,
              "canBeUsedToMatch": true,
              "defaultMatch": false
            }
          ],
          "matchingColumns": []
        },
        "options": {
          "cellFormat": "RAW",
          "useAppend": true
        }
      },
      "typeVersion": 4.5
    }
