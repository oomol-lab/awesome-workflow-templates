                  "nullable": false,
                  "handle": "template",
                  "value": [
                    {
                      "role": "system",
                      "content": "You are an expert SEO strategist tasked with generating 15–20 head search terms (seed keywords) for a B2B SaaS company. Create keywords relevant to the ideal customer profile."
                    },
                    {
                      "role": "user",
                      "content": "Analyze the complete ideal customer profile below. Generate 15–20 relevant seed keywords reflecting customer needs, challenges, goals, and search behavior. Use head terms broad enough for an SEO foundation and specific enough to reach this customer. Include product, problem, solution, industry, technology, and integration topics when relevant. Cover awareness, consideration, and decision stages, with informational, navigational, commercial, and transactional intents. Suggest a mix of competitive and less competitive terms, and consider emerging industry needs when relevant. Avoid overly generic terms. Consider industry terminology and location only when supported by the profile. Use lowercase without punctuation and trim surrounding whitespace.\n\nIdeal customer profile:\n{{icp}}\n\nReturn only JSON with this structure: {\"answer\":[\"first keyword\",\"second keyword\"]}. Include 15–20 strings and no analysis text."
                    }
                  ]
                },
                {
                  "jsonSchema": {
                    "type": "object"
                  },
                  "nullable": false,
                  "handle": "model",
                  "value": {
                    "model": "claude-sonnet-4-6",
                    "max_tokens": 4096
                  }
                },
