    "modules": {
      "n_3687b3846af5e18f": {
        "name": "Prepare complete profile",
        "imports": [],
        "source": "export default function prepareProfile(inputs) {\n  const profile = {};\n  for (const name of [\"product\", \"pain_points\", \"goals\", \"current_solutions\", \"expertise_level\"]) {\n    if (typeof inputs[name] !== \"string\" || !inputs[name].trim())\n      throw new Error(\"Provide the ideal customer profile field: \" + name);\n    profile[name] = inputs[name].trim();\n  }\n  return { icp: JSON.stringify(profile, null, 2) };\n}\n"
      },
      "n_e9f90b38244e8ba2": {
        "name": "Validate keyword list",
        "imports": [],
        "source": "export default function readKeywords({ text }) {\n  let parsed;\n  try {\n    parsed = JSON.parse(text);\n  } catch {\n    throw new Error(\"The model did not return keyword JSON.\");\n  }\n  if (\n    !Array.isArray(parsed?.answer) ||\n    parsed.answer.length < 15 ||\n    parsed.answer.length > 20 ||\n    parsed.answer.some((keyword) => typeof keyword !== \"string\" || !keyword.trim())\n  )\n    throw new Error(\"Expected 15–20 nonempty seed keywords in answer.\");\n  return { keywords: parsed.answer.map((keyword) => keyword.trim().toLowerCase()) };\n}\n"
      }
    }
