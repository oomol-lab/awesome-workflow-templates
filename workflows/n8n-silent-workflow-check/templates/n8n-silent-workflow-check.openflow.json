    "modules": {
      "n_4b6d05e94e3d20aa": {
        "name": "Find silent workflows",
        "imports": [],
        "source": "export default function findSilent({\n  workflows,\n  executions,\n  staleHours,\n  now,\n  workflowCursor,\n  executionCursor,\n}) {\n  if (!Array.isArray(workflows) || !Array.isArray(executions))\n    throw new Error(\"Workflow and execution pages must be arrays\");\n  if (!Number.isFinite(staleHours) || staleHours <= 0)\n    throw new Error(\"staleHours must be a positive number\");\n  const timestamp = new Date(now).getTime();\n  if (!Number.isFinite(timestamp)) throw new Error(\"now must be a valid timestamp\");\n  const active = workflows.filter((workflow) => workflow.active && !workflow.isArchived);\n  const latest = new Map();\n  for (const execution of executions) {\n    const id = String(execution.workflowId);\n    const started = new Date(execution.startedAt || execution.createdAt).getTime();\n    if (!Number.isFinite(started)) continue;\n    if (!latest.has(id) || started > latest.get(id)) latest.set(id, started);\n  }\n  const threshold = timestamp - staleHours * 3600000;\n  const findings = [];\n  for (const workflow of active) {\n    const last = latest.get(String(workflow.id));\n    if (last === undefined)\n      findings.push({\n        workflow: workflow.name,\n        workflowId: workflow.id,\n        lastRun: null,\n        hoursSilent: null,\n        note: \"no execution in the window\",\n      });\n    else if (last < threshold)\n      findings.push({\n        workflow: workflow.name,\n        workflowId: workflow.id,\n        lastRun: new Date(last).toISOString(),\n        hoursSilent: Math.round((timestamp - last) / 3600000),\n        note: \"active but stalled\",\n      });\n  }\n  return {\n    silent: findings.length,\n    activeChecked: active.length,\n    findings,\n    workflowPageLimited: Boolean(workflowCursor),\n    executionPageLimited: Boolean(executionCursor),\n  };\n}\n"
      }
    }
