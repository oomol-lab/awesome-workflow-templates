{
  "name": "Disqus Forum Reader",
  "nodes": [
    {
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        250,
        300
      ],
      "parameters": {},
      "typeVersion": 1,
      "id": "disqus-forum-reader-trigger"
    },
    {
      "id": "disqus-forum-reader-read",
      "name": "Read public Disqus forum",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://disqus.com/api/3.0/forums/details.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "forum",
              "value": "YOUR_FORUM_SHORT_NAME"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Referer",
              "value": "https://your-registered-site.example/"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": false
            }
          }
        }
      }
    },
    {
      "id": "disqus-forum-reader-check",
      "name": "Check forum response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function readDisqusForum(body) {\n  const forum = body && typeof body === \"object\" && body.response;\n  if (\n    body?.code !== 0 ||\n    !forum ||\n    typeof forum !== \"object\" ||\n    Array.isArray(forum) ||\n    typeof forum.id !== \"string\" ||\n    !forum.id.trim()\n  ) {\n    throw new Error(\"Disqus did not return the requested forum details\");\n  }\n  return forum;\n}\nasync function disqusForum({ body }) {\n  return { forum: readDisqusForum(body) };\n}\n\nreturn { json: readDisqusForum($json) };\n"
      }
    }
  ],
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "connections": {
    "On clicking 'execute'": {
      "main": [
        [
          {
            "node": "Read public Disqus forum",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read public Disqus forum": {
      "main": [
        [
          {
            "node": "Check forum response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
