      "n_34acfd07e68d58a0": {
        "name": "Check forum response",
        "imports": [],
        "source": "function readDisqusForum(body) {\n  const forum = body && typeof body === 'object' && body.response;\n  if (body?.code !== 0 || !forum || typeof forum !== 'object' || Array.isArray(forum) || typeof forum.id !== 'string' || !forum.id.trim()) {\n    throw new Error('Disqus did not return the requested forum details');\n  }\n  return forum;\n}\nexport default async function disqusForum({ body }) {\n  return { forum: readDisqusForum(body) };\n}\n"
      }
