        "name": "Read existing workflows",
        "imports": [],
        "source": "export default async function pages({previous},context){const s=previous??{items:[],cursor:null,seen:[]};const r=await context.actions.call('n8n.list_workflows',{limit:100,...(s.cursor?{cursor:s.cursor}:{})});if(!Array.isArray(r?.data))throw Error('Invalid n8n workflow page');const c=r.nextCursor;if(c!==null&&(typeof c!=='string'||!c||s.seen.includes(c)))throw Error('Invalid or repeated workflow cursor');return {state:{items:s.items.concat(r.data),cursor:c,seen:c?[...s.seen,c]:s.seen},more:c!==null}}\n"
      },
      "n_e8c393915a445329": {
        "name": "Read and validate backups",
        "imports": [],
        "source": "export default async function files({entries,existing,owner,repo,previous},context){if(!Array.isArray(entries)||!Array.isArray(existing.items))throw Error('Invalid lists');if(entries.length>=1000)throw Error('Directory may exceed GitHub listing limit');const s=previous??{index:0,items:[],seen:[]};if(s.index>=entries.length)return{state:s,more:false};const e=entries[s.index];if(e.type!=='file'||typeof e.name!=='string'||!e.name.endsWith('.json')||typeof e.path!=='string')throw Error('Directory must contain workflow JSON files only');const f=await context.actions.call('github.get_file_contents',{owner,repo,path:e.path});if(f.type!=='file'||f.path!==e.path||typeof f.decoded_content!=='string')throw Error('Invalid workflow file');let w;try{w=JSON.parse(f.decoded_content)}catch{throw Error('Invalid workflow JSON')}if(!w||typeof w.name!=='string'||!w.name.trim()||!Array.isArray(w.nodes)||!w.connections||typeof w.connections!=='object'||!w.settings||typeof w.settings!=='object')throw Error('Invalid workflow backup');if(s.seen.includes(w.name))throw Error('Duplicate backup workflow name');const payload={name:w.name,nodes:w.nodes,connections:w.connections,settings:w.settings,...(Object.hasOwn(w,'staticData')?{staticData:w.staticData}:{})};const items=existing.items.some(x=>x.name===w.name)?s.items:s.items.concat(payload);return{state:{index:s.index+1,items,seen:[...s.seen,w.name]},more:s.index+1<entries.length}}\n"
      },
      "n_70099d66d23c7e48": {
        "name": "Prepare the next restore",
        "imports": [],
        "source": "export default function next({state,previous}){const i=previous?.index??0;if(!Array.isArray(state.items))throw Error('Invalid restore plan');return i<state.items.length?{state:{index:i+1},more:true,body:state.items[i]}:{state:{index:i},more:false,body:{}}}\n"
      },
      "n_65a9621a69548c30": {
        "name": "Confirm the created workflow",
        "imports": [],
        "source": "export default function confirm({body,statusCode,bodyEncoding,expected}){if(statusCode<200||statusCode>=300||bodyEncoding||!body||typeof body.id!=='string'||!body.id||body.name!==expected.name)throw Error('Workflow creation was not confirmed');return {id:body.id}}\n"
      }
    }
  },
