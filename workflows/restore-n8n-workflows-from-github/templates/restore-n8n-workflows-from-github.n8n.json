{
  "name": "Restore n8n Workflows from GitHub",
  "tags": [],
  "nodes": [
    {
      "id": "restore-n8n-workflows-from-github-0",
      "name": "On clicking 'execute'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        -700,
        780
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "name": "Configure the backup directory",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function config({ owner, repo, path }) {\n  for (const [k, v] of Object.entries({ owner, repo, path }))\n    if (typeof v !== \"string\" || !v.trim() || v.startsWith(\"YOUR_\"))\n      throw Error(\"Configure GitHub \" + k);\n  if (\n    path.startsWith(\"/\") ||\n    path.endsWith(\"/\") ||\n    path.split(\"/\").some((x) => !x || x === \".\" || x === \"..\")\n  )\n    throw Error(\"Invalid existing directory\");\n  return { owner, repo, path };\n}\n\nreturn [\n  {\n    json: config({\n      owner: \"YOUR_GITHUB_OWNER\",\n      repo: \"YOUR_GITHUB_REPOSITORY\",\n      path: \"YOUR_BACKUP_DIRECTORY\",\n    }),\n  },\n];\n"
      },
      "id": "restore-n8n-workflows-from-github-1"
    },
    {
      "id": "restore-n8n-workflows-from-github-2",
      "name": "Read existing workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [
        -500,
        880
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {}
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "restore-n8n-workflows-from-github-3",
      "name": "List the backup directory",
      "type": "n8n-nodes-base.github",
      "position": [
        -280,
        540
      ],
      "parameters": {
        "resource": "file",
        "operation": "list",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $(\"Configure the backup directory\").first().json.owner }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $(\"Configure the backup directory\").first().json.repo }}"
        },
        "filePath": "={{ $(\"Configure the backup directory\").first().json.path }}"
      },
      "typeVersion": 1
    },
    {
      "name": "Validate directory entries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input.all();\nif (a.length >= 1000) throw Error(\"Directory may exceed GitHub listing limit\");\nfor (const x of a)\n  if (x.json.type !== \"file\" || typeof x.json.name !== \"string\" || !x.json.name.endsWith(\".json\"))\n    throw Error(\"Directory must contain workflow JSON files only\");\nreturn a;\n"
      },
      "id": "restore-n8n-workflows-from-github-4"
    },
    {
      "id": "restore-n8n-workflows-from-github-5",
      "name": "Read backup files",
      "type": "n8n-nodes-base.github",
      "position": [
        140,
        660
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $(\"Configure the backup directory\").first().json.owner }}"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $(\"Configure the backup directory\").first().json.repo }}"
        },
        "filePath": "={{ $json.path }}",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "typeVersion": 1
    },
    {
      "name": "Validate backups and skip existing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const existing = new Set(\n    $(\"Read existing workflows\")\n      .all()\n      .map((x) => x.json.name)\n      .filter(Boolean),\n  ),\n  seen = new Set(),\n  result = [];\nfor (const [i, x] of $input.all().entries()) {\n  let w;\n  try {\n    w = JSON.parse(Buffer.from(x.json.content, \"base64\").toString(\"utf8\"));\n  } catch {\n    throw Error(\"Invalid workflow JSON\");\n  }\n  if (\n    !w ||\n    typeof w.name !== \"string\" ||\n    !w.name.trim() ||\n    !Array.isArray(w.nodes) ||\n    !w.connections ||\n    typeof w.connections !== \"object\" ||\n    !w.settings ||\n    typeof w.settings !== \"object\"\n  )\n    throw Error(\"Invalid workflow backup\");\n  if (seen.has(w.name)) throw Error(\"Duplicate backup workflow name\");\n  seen.add(w.name);\n  if (!existing.has(w.name))\n    result.push({\n      json: {\n        name: w.name,\n        nodes: w.nodes,\n        connections: w.connections,\n        settings: w.settings,\n        ...(Object.hasOwn(w, \"staticData\") ? { staticData: w.staticData } : {}),\n      },\n      pairedItem: { item: i },\n    });\n}\nreturn result;\n"
      },
      "id": "restore-n8n-workflows-from-github-6"
    },
    {
      "name": "Restore one workflow at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "restore-n8n-workflows-from-github-7"
    },
    {
      "id": "restore-n8n-workflows-from-github-8",
      "name": "Create the workflow",
      "type": "n8n-nodes-base.n8n",
      "position": [
        1180,
        660
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "create",
        "workflowObject": "={{ JSON.stringify($json) }}"
      },
      "typeVersion": 1
    },
    {
      "name": "Confirm the created workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x = $input.first().json,\n  expected = $(\"Restore one workflow at a time\").item.json;\nif (!x || typeof x.id !== \"string\" || !x.id || x.name !== expected.name)\n  throw Error(\"Workflow creation was not confirmed\");\nreturn [{ json: x }];\n"
      },
      "id": "restore-n8n-workflows-from-github-9"
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
