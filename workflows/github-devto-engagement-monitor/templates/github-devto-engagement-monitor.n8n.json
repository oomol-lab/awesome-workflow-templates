    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const summarize = ({ repo1, repo2, article }) => {\n  function metric(record, field, label) {\n    if (record === null || typeof record !== \"object\" || !Number.isFinite(record[field])) {\n      throw new Error(\"Missing or invalid metric: \" + label + \".\" + field);\n    }\n    return record[field];\n  }\n  function repository(record, label) {\n    return {\n      stars: metric(record, \"stargazers_count\", label),\n      forks: metric(record, \"forks_count\", label),\n      open_issues: metric(record, \"open_issues_count\", label),\n    };\n  }\n  return {\n    checked_at: new Date().toISOString(),\n    repo1: repository(repo1, \"repo1\"),\n    repo2: repository(repo2, \"repo2\"),\n    article1: {\n      reactions: metric(article, \"positive_reactions_count\", \"article\"),\n      comments: metric(article, \"comments_count\", \"article\"),\n    },\n  };\n};\n\nreturn [\n  {\n    json: summarize({\n      repo1: $(\"GitHub Repo 1\").first().json,\n      repo2: $(\"GitHub Repo 2\").first().json,\n      article: $(\"dev.to Article 1\").first().json,\n    }),\n  },\n];\n"
      },
      "id": "compile1",
      "name": "Compile Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    }
