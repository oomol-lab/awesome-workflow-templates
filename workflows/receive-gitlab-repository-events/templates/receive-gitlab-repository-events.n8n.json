{
  "nodes": [
    {
      "name": "Gitlab Trigger",
      "type": "n8n-nodes-base.gitlabTrigger",
      "position": [
        460,
        480
      ],
      "parameters": {
        "owner": "YOUR_GITLAB_OWNER",
        "events": [
          "*"
        ],
        "repository": "YOUR_GITLAB_REPOSITORY"
      },
      "typeVersion": 1,
      "id": "receive-gitlab-repository-events-0"
    },
    {
      "id": "receive-gitlab-repository-events-relay",
      "name": "Forward to Open Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        220
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {event: JSON.stringify({...$json, headers: Object.fromEntries(Object.entries($json.headers ?? {}).filter(([key]) => key.toLowerCase() !== \"x-gitlab-token\"))})} }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Gitlab Trigger": {
      "main": [
        [
          {
            "node": "Forward to Open Flow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "name": "Receive GitLab Repository Events",
  "active": false,
  "pinData": {}
}
