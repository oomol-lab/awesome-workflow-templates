    "modules": {
      "n_1e75a3a7b40fce70": {
        "name": "Prepare payout batch",
        "imports": [],
        "source": "export default function payout({ batchId, items }) {\n  if (!batchId || !Array.isArray(items) || !items.length)\n    throw Error(\"Provide a batch ID and at least one payout item\");\n  return { body: { sender_batch_header: { sender_batch_id: batchId }, items } };\n}\n"
      },
      "n_0d09d70c635b05c3": {
        "name": "Check response",
        "imports": [],
        "source": "export default function result({ body, statusCode }) {\n  if (statusCode < 200 || statusCode >= 300)\n    throw Error(\"Payout request failed or is uncertain; inspect PayPal before retrying\");\n  return { result: body };\n}\n"
      }
    }
