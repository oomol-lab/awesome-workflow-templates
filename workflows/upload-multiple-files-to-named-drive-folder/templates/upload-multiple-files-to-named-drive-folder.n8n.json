            "item_key": "={{ 'bulk-folder:' + $('Prepare folder request').first().json.submissionId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "upload-multiple-files-to-named-drive-folder-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Relay folder request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $('Prepare folder request').first().json.mode === 'relay' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "upload-multiple-files-to-named-drive-folder-4",
      "position": [
        880,
        0
      ]
    },
    {
