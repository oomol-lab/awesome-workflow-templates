    {
      "name": "Resolve folder ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const folderId = $json.folderId ?? $json.id;\nif (!folderId || ($json.status && $json.status !== \"completed\"))\n  throw Error(\"Unknown folder result\");\nreturn { json: { folderId } };\n"
      },
      "id": "upload-multiple-files-to-named-drive-folder-10",
      "position": [
        2200,
        0
      ]
    },
    {
