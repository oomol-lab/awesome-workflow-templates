        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Reserve folder request').first().json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
