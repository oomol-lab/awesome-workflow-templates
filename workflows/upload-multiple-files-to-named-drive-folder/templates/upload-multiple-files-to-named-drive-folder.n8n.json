{
  "nodes": [
    {
      "id": "upload-multiple-files-to-named-drive-folder-0",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "options": {},
        "formTitle": "Upload files to Drive",
        "formFields": {
          "values": [
            {
              "fieldType": "file",
              "fieldLabel": "file",
              "requiredField": true,
              "multipleFiles": true
            },
            {
              "fieldLabel": "folderName",
              "requiredField": true
            }
          ]
        },
        "formDescription": "Choose files and a destination folder name."
      },
      "typeVersion": 2.2
    },
    {
      "name": "Prepare folder request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function input({ body }) {\n  const name = String(body.folderName || \"\").trim(),\n    parent = String(body.parentId || \"\").trim();\n  if (!name || !parent || name.length > 200 || /[\\r\\n]/.test(name))\n    throw Error(\"Expected parent and folder name\");\n  const esc = (x) => x.replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\");\n  return {\n    name,\n    parent,\n    parents: [parent],\n    query:\n      \"mimeType = 'application/vnd.google-apps.folder' and trashed = false and name = '\" +\n      esc(name) +\n      \"' and '\" +\n      esc(parent) +\n      \"' in parents\",\n  };\n}\n\nconst mode = \"direct\",\n  parentId = \"YOUR_PARENT_FOLDER_ID\",\n  folderName = String($json.folderName ?? \"\");\nconst p = input({ body: { folderName, parentId } });\nreturn {\n  json: {\n    submissionId: $execution.id,\n    folderName: p.name,\n    parentId: p.parent,\n    query: p.query,\n    mode,\n  },\n};\n"
      },
      "id": "upload-multiple-files-to-named-drive-folder-1",
      "position": [
        220,
        0
      ]
    },
    {
      "name": "Folder request not processed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'bulk-folder:' + $('Prepare folder request').first().json.submissionId }}"
            }
          ]
        }
      },
      "id": "upload-multiple-files-to-named-drive-folder-2",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Reserve folder request",
      "type": "n8n-nodes-base.dataTable",
