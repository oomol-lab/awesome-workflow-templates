      ]
    },
    {
      "id": "upload-multiple-files-to-named-drive-folder-6",
      "name": "Search specific folder",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "filter": {},
        "options": {},
        "resource": "fileFolder",
        "queryString": "={{ $('Prepare folder request').first().json.query }}",
        "searchMethod": "query",
        "returnAll": false,
        "limit": 2
      },
      "typeVersion": 3,
      "alwaysOutputData": true
    },
    {
      "name": "Check matching folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a = $input\n  .all()\n  .map((x) => x.json)\n  .filter((x) => x.id);\nif (a.length > 1) throw Error(\"Multiple matching folders\");\nreturn [{ json: { found: a.length === 1, folderId: a[0]?.id ?? \"\" } }];\n"
      },
      "id": "upload-multiple-files-to-named-drive-folder-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Folder found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
