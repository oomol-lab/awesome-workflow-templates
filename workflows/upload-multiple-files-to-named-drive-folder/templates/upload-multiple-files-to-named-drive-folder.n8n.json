    {
      "name": "Prepare files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const folderId = $(\"Resolve folder ID\").first().json.folderId,\n  binary = $(\"On form submission\").first().binary ?? {},\n  keys = Object.keys(binary);\nif (!keys.length) throw Error(\"No files\");\nreturn keys.map((k, index) => ({\n  json: { index, fileName: binary[k].fileName ?? \"file-\" + index, folderId },\n  binary: { data: binary[k] },\n  pairedItem: { item: 0 },\n}));\n"
      },
      "id": "upload-multiple-files-to-named-drive-folder-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "One file at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
