        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {folderName:$('Prepare folder request').first().json.folderName,parentId:$('Prepare folder request').first().json.parentId} }}",
        "options": {}
      },
      "id": "upload-multiple-files-to-named-drive-folder-5",
      "position": [
        1100,
