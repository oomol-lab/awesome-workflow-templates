          }
        ]
      ]
    },
    "When clicking ‘Test workflow’": {
      "main": [
        [
          {
            "node": "List ALL Files*",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All into one Item (include Binary)": {
      "main": [
        [
          {
