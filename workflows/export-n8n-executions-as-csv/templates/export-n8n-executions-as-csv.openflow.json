    "modules": {
      "n_74b8054ab46613c3": {
        "name": "Prepare execution page",
        "imports": [],
        "source": "export default function page({ baseUrl, cursor }) {\n  return {\n    url:\n      baseUrl.replace(/\\/$/, \"\") +\n      \"/api/v1/executions?limit=100\" +\n      (cursor ? \"&cursor=\" + encodeURIComponent(cursor) : \"\"),\n  };\n}\n"
      },
      "n_4f6ee586aee195b1": {
        "name": "Collect executions",
        "imports": [],
        "source": "export default function collect({ body, previous }) {\n  if (!Array.isArray(body?.data)) throw Error(\"Missing execution list\");\n  const rows = [...(previous?.rows ?? []), ...body.data],\n    cursor = body.nextCursor ?? \"\";\n  if (typeof cursor !== \"string\") throw Error(\"Invalid cursor\");\n  return { state: { rows }, hasNext: !!cursor, cursor };\n}\n"
      },
      "n_0c553a5caf99578b": {
        "name": "Convert to CSV",
        "imports": [],
        "source": "export default function csv({ state }) {\n  const rows = state.rows,\n    columns = [...new Set(rows.flatMap((row) => Object.keys(row)))],\n    escape = (value) => {\n      if (value == null) return \"\";\n      let text = typeof value === \"object\" ? JSON.stringify(value) : String(value);\n      return /[\",\\r\\n]/.test(text) ? '\"' + text.replace(/\"/g, '\"\"') + '\"' : text;\n    };\n  return {\n    csv: columns.length\n      ? [\n          columns.map(escape).join(\",\"),\n          ...rows.map((row) => columns.map((k) => escape(row[k])).join(\",\")),\n        ].join(\"\\r\\n\")\n      : \"\",\n  };\n}\n"
      }
    }
