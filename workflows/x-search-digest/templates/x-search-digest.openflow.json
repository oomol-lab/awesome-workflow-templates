    "modules": {
      "n_2f30f372d99be9b2": {
        "name": "Validate search settings",
        "imports": [],
        "source": "export default function prepareSearch({query,limit}) {\n  if(typeof query!=='string'||!query.trim()||query.length>4096)throw new Error('query must contain 1–4096 characters.');\n  if(!Number.isInteger(limit)||limit<1||limit>10000)throw new Error('limit must be an integer from 1 to 10000.');\n  return {query,limit};\n}\n"
      },
      "n_732b916b3233cac2": {
        "name": "Build search digest",
        "imports": [],
        "source": "export default function buildDigest({body,query}) {\n  if(!body||typeof body!=='object'||Array.isArray(body)||!Array.isArray(body.tweets))throw new Error('Xquik did not return a tweets array.');\n  const more=body.has_next_page??body.has_more??false;\n  if(typeof more!=='boolean')throw new Error('Xquik pagination flag must be boolean.');\n  const cursor=body.next_cursor??'';\n  if(typeof cursor!=='string')throw new Error('Xquik cursor must be text.');\n  const tweets=body.tweets.map(tweet=>{\n    if(!tweet||typeof tweet!=='object'||Array.isArray(tweet))throw new Error('Xquik returned an invalid tweet.');\n    const sourceId=tweet.id??tweet.tweet_id??tweet.rest_id??'';\n    if(typeof sourceId!=='string'&&!Number.isSafeInteger(sourceId))throw new Error('Xquik tweet ID must be text or a safe integer.');\n    const id=String(sourceId);\n    const text=tweet.text??tweet.full_text??tweet.content??'';\n    const url=tweet.url??(id?'https://x.com/i/web/status/'+encodeURIComponent(id):'');\n    const sourceAuthor=tweet.author??tweet.user??{};\n    const author=sourceAuthor.username??sourceAuthor.screen_name??sourceAuthor.name??'';\n    const created_at=tweet.createdAt??tweet.created_at??tweet.created??tweet.timestamp??'';\n    if([text,url,author,created_at].some(value=>typeof value!=='string'))throw new Error('Xquik text, URL, author and timestamp must be strings.');\n    const metrics=tweet.metrics??Object.fromEntries(['likeCount','retweetCount','replyCount','quoteCount','viewCount','bookmarkCount'].filter(name=>Object.hasOwn(tweet,name)).map(name=>[name,tweet[name]]));\n    if(!metrics||typeof metrics!=='object'||Array.isArray(metrics))throw new Error('Xquik metrics must be an object.');\n    return {id,url,text,author,created_at,metrics};\n  });\n  const lines=tweets.length?tweets.map((tweet,index)=>(index+1)+'. '+tweet.text+(tweet.author?' by '+tweet.author:'')+(tweet.url?'\\n'+tweet.url:'')):['No matching X posts found for this query.'];\n  return {query,results_count:tweets.length,has_more:more,next_cursor:cursor,tweets,digest:lines.join('\\n\\n')};\n}\n"
      }
