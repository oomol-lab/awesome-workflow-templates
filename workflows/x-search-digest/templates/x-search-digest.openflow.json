    "modules": {
      "n_2f30f372d99be9b2": {
        "name": "Validate search settings",
        "imports": [],
        "source": "export default function prepareSearch({ query, limit }) {\n  if (typeof query !== \"string\" || !query.trim() || query.length > 4096) {\n    throw new Error(\"query must contain 1–4096 characters.\");\n  }\n  if (!Number.isInteger(limit) || limit < 1 || limit > 10000) {\n    throw new Error(\"limit must be an integer from 1 to 10000.\");\n  }\n  return {\n    query: query.trim(),\n    limit,\n    request: {\n      query: {\n        keyword: query.trim(),\n        search_type: \"Top\",\n      },\n    },\n  };\n}\n"
      },
      "n_1a1e7e23c38b1777": {
        "name": "Build search digest",
        "imports": [],
        "source": "export default function buildDigest({ response, query, limit }) {\n  const data = response?.data ?? response ?? {};\n  const rawList = Array.isArray(data?.timeline)\n    ? data.timeline\n    : Array.isArray(data?.tweets)\n      ? data.tweets\n      : Array.isArray(data?.results)\n        ? data.results\n        : Array.isArray(data)\n          ? data\n          : null;\n  if (!Array.isArray(rawList)) {\n    throw new Error(\"TikHub did not return an X search timeline array.\");\n  }\n  const cursor = String(data?.next_cursor ?? data?.cursor ?? \"\");\n  const more = Boolean(cursor);\n  const sliced = typeof limit === \"number\" && limit > 0 ? rawList.slice(0, limit) : rawList;\n  const tweets = sliced.map((tweet) => {\n    if (!tweet || typeof tweet !== \"object\" || Array.isArray(tweet)) {\n      throw new Error(\"TikHub returned an invalid tweet.\");\n    }\n    const sourceId = tweet.tweet_id ?? tweet.id_str ?? tweet.rest_id ?? tweet.id ?? \"\";\n    if (typeof sourceId !== \"string\" && !Number.isSafeInteger(sourceId)) {\n      throw new Error(\"TikHub tweet ID must be text or a safe integer.\");\n    }\n    const id = String(sourceId);\n    const text = String(\n      tweet.text ?? tweet.full_text ?? tweet.legacy?.full_text ?? tweet.content ?? \"\",\n    );\n    const user =\n      tweet.user_info ??\n      tweet.author ??\n      tweet.user ??\n      tweet.core?.user_results?.result?.legacy ??\n      {};\n    const author = String(user.screen_name ?? user.username ?? user.name ?? \"\");\n    const url = String(\n      tweet.url ??\n        (id\n          ? author\n            ? \"https://x.com/\" + encodeURIComponent(author) + \"/status/\" + encodeURIComponent(id)\n            : \"https://x.com/i/web/status/\" + encodeURIComponent(id)\n          : \"\"),\n    );\n    const created_at = String(\n      tweet.created_at ?? tweet.createdAt ?? tweet.legacy?.created_at ?? tweet.created ?? \"\",\n    );\n    const metrics = {\n      likeCount: Number(\n        tweet.favorites ??\n          tweet.favorite_count ??\n          tweet.like_count ??\n          tweet.legacy?.favorite_count ??\n          0,\n      ),\n      retweetCount: Number(\n        tweet.retweets ?? tweet.retweet_count ?? tweet.legacy?.retweet_count ?? 0,\n      ),\n      replyCount: Number(tweet.replies ?? tweet.reply_count ?? tweet.legacy?.reply_count ?? 0),\n      quoteCount: Number(tweet.quotes ?? tweet.quote_count ?? tweet.legacy?.quote_count ?? 0),\n      viewCount: Number(tweet.views ?? tweet.view_count ?? 0),\n      bookmarkCount: Number(tweet.bookmarks ?? tweet.bookmark_count ?? 0),\n    };\n    return { id, url, text, author, created_at, metrics };\n  });\n  const lines = tweets.length\n    ? tweets.map(\n        (tweet, index) =>\n          index +\n          1 +\n          \". \" +\n          tweet.text +\n          (tweet.author ? \" by \" + tweet.author : \"\") +\n          (tweet.url ? \"\\n\" + tweet.url : \"\"),\n      )\n    : [\"No matching X posts found for this query.\"];\n  return {\n    query,\n    results_count: tweets.length,\n    has_more: more,\n    next_cursor: cursor,\n    tweets,\n    digest: lines.join(\"\\n\\n\"),\n  };\n}\n"
      }
    }
