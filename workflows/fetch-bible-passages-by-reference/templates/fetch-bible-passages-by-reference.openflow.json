      "n_adae61a66a8e4436": {
        "name": "Prepare GetBible query",
        "imports": [],
        "source": "export default function getBible({ references, translation, version }) {\n  const refs = Array.isArray(references) ? references.join(\"; \") : \"John 3:16\",\n    v = version || \"v2\",\n    t = translation || \"kjv\";\n  return {\n    url:\n      \"https://query.getbible.net/\" +\n      encodeURIComponent(v) +\n      \"/\" +\n      encodeURIComponent(t) +\n      \"/\" +\n      encodeURIComponent(refs),\n  };\n}\n"
      }
    }
