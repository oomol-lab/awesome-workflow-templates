    "modules": {
      "n_077c509ca9a02a80": {
        "name": "Select the video",
        "imports": [],
        "source": "export default function ({ records }) {\n  if (!records.length) return { found: false, id: \"\", body: {} };\n  const r = records[0],\n    url = r.fields.Source;\n  if (\n    !r.id ||\n    typeof url !== \"string\" ||\n    !/^https:\\/\\/(www\\.)?(youtube\\.com|youtu\\.be)\\//i.test(url)\n  )\n    throw Error(\"Invalid YouTube Source URL\");\n  return { found: true, id: r.id, body: { videoUrl: url, includeTimestamps: false } };\n}\n"
      },
      "n_cbfade34cf71b261": {
        "name": "Check transcript",
        "imports": [],
        "source": "export default function ({ body, statusCode }) {\n  if (statusCode !== 200 || typeof body?.transcript !== \"string\" || !body.transcript.trim())\n    throw Error(\"Transcript unavailable\");\n  return { text: body.transcript };\n}\n"
      },
      "n_75f2f4ad50e82316": {
        "name": "Prepare record update",
        "imports": [],
        "source": "export default function ({ id, result }) {\n  if (\n    !id ||\n    !result?.mainIdea?.trim() ||\n    !Array.isArray(result.takeaways) ||\n    !result.takeaways.length ||\n    result.takeaways.some((x) => typeof x !== \"string\" || !x.trim())\n  )\n    throw Error(\"Invalid summary\");\n  return {\n    records: [\n      {\n        id,\n        fields: {\n          Status: true,\n          \"Main Idea\": result.mainIdea,\n          Takeaways: result.takeaways.join(\"\\n\"),\n        },\n      },\n    ],\n  };\n}\n"
      },
      "n_701a0e65264f00fe": {
        "name": "Reserve video update",
        "imports": [],
        "source": "export default async function ({ id }, ctx) {\n  const key = \"youtube-summary:\" + id;\n  const state = await ctx.state.get(key);\n  if (state?.phase === \"pending\") throw Error(\"Inspect Airtable before clearing pending update\");\n  if (state?.phase === \"done\") throw Error(\"Already completed: inspect Airtable and state\");\n  await ctx.state.set(key, { phase: \"pending\" });\n  return { ok: true };\n}\n"
      },
      "n_2b423ed1f9c3d25c": {
        "name": "Confirm video update",
        "imports": [],
        "source": "export default async function ({ id, records }, ctx) {\n  if (records.length !== 1 || records[0].id !== id) throw Error(\"Unknown update result\");\n  await ctx.state.set(\"youtube-summary:\" + id, { phase: \"done\" });\n  return { ok: true };\n}\n"
      }
    }
