    {
      "id": "12084971-c81b-4a0e-814e-120867562642",
      "name": "Merge sentiment with form content",
      "type": "n8n-nodes-base.code",
      "position": [
        1680,
        1320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = function feedbackRow({ name, category, feedback, contact, timestamp, sentiment }) {\n  if (typeof sentiment !== \"string\" || !sentiment.trim())\n    throw new Error(\"The sentiment model returned an empty response.\");\n  return { values: [[timestamp, category, feedback, name, contact, \"Form\", \"\", sentiment]] };\n};\n\nreturn [\n  {\n    json: row({\n      ...$(\"Validate Feedback\").first().json,\n      sentiment: $input.first().json.message.content,\n    }),\n  },\n];\n"
      },
      "typeVersion": 2
    },
