    {
      "id": "prepare-feedback",
      "name": "Validate Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        1320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prepare = function prepareFeedback({ body }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body))\n    throw new Error(\"Feedback must be a JSON object.\");\n  const required = [\"Name\", \"What is your feedback about?\", \"Your feedback\"];\n  for (const name of required)\n    if (typeof body[name] !== \"string\" || !body[name].trim())\n      throw new Error(\"Required feedback field: \" + name);\n  const category = body[\"What is your feedback about?\"];\n  if (![\"Product\", \"Service\", \"Other\"].includes(category))\n    throw new Error(\"Feedback category must be Product, Service, or Other.\");\n  const contact = body[\"How do we get in touch with you?\"];\n  if (contact != null && typeof contact !== \"string\") throw new Error(\"Contact must be text.\");\n  const timestamp = body.submittedAt || new Date().toISOString();\n  if (typeof timestamp !== \"string\" || !Number.isFinite(Date.parse(timestamp)))\n    throw new Error(\"Submission timestamp must be a valid date.\");\n  return {\n    name: body.Name,\n    category,\n    feedback: body[\"Your feedback\"],\n    contact: contact || \"\",\n    timestamp,\n  };\n};\n\nreturn $input\n  .all()\n  .map((item, index) => ({ json: prepare({ body: item.json }), pairedItem: { item: index } }));\n"
      }
    }
