    "modules": {
      "n_001a962da0ead0c4": {
        "name": "Prepare feedback submission",
        "imports": [],
        "source": "export default function prepareFeedback({ body }) {\n  if (!body || typeof body !== \"object\" || Array.isArray(body))\n    throw new Error(\"Feedback must be a JSON object.\");\n  const required = [\"Name\", \"What is your feedback about?\", \"Your feedback\"];\n  for (const name of required)\n    if (typeof body[name] !== \"string\" || !body[name].trim())\n      throw new Error(\"Required feedback field: \" + name);\n  const category = body[\"What is your feedback about?\"];\n  if (![\"Product\", \"Service\", \"Other\"].includes(category))\n    throw new Error(\"Feedback category must be Product, Service, or Other.\");\n  const contact = body[\"How do we get in touch with you?\"];\n  if (contact != null && typeof contact !== \"string\") throw new Error(\"Contact must be text.\");\n  const timestamp = body.submittedAt || new Date().toISOString();\n  if (typeof timestamp !== \"string\" || !Number.isFinite(Date.parse(timestamp)))\n    throw new Error(\"Submission timestamp must be a valid date.\");\n  return {\n    name: body.Name,\n    category,\n    feedback: body[\"Your feedback\"],\n    contact: contact || \"\",\n    timestamp,\n  };\n}\n"
      },
      "n_571e822b51e9a4db": {
        "name": "Prepare feedback row",
        "imports": [],
        "source": "export default function feedbackRow({ name, category, feedback, contact, timestamp, sentiment }) {\n  if (typeof sentiment !== \"string\" || !sentiment.trim())\n    throw new Error(\"The sentiment model returned an empty response.\");\n  return { values: [[timestamp, category, feedback, name, contact, \"Form\", \"\", sentiment]] };\n}\n"
      }
    }
