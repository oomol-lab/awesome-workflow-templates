    "modules": {
      "n_e35fc25d1e62d588": {
        "name": "Prepare sheet rows",
        "imports": [],
        "source": "export default function plan({values,channelId}) {\n if(!channelId || channelId.startsWith('YOUR_'))throw new Error('Set the Mattermost channel ID');\n if(!Array.isArray(values))throw new Error('Expected sheet rows');\n if(!values.length)return {rows:[],channelId};\n const headers=values[0], names=['Compte','Followers','Posts'];\n const idx=names.map(n=>headers.indexOf(n));\n const data=values.slice(1).filter(row=>row.some((_,i)=>Boolean(headers[i])));\n if(!data.length)return {rows:[],channelId};\n if(idx.some((x,i)=>x<0||headers.lastIndexOf(names[i])!==x))throw new Error('Sheet needs unique Compte, Followers and Posts headers');\n return {rows:data.map(row=>({account:row[idx[0]]??null,followers:row[idx[1]]??null,posts:row[idx[2]]??null})),channelId};\n}\n"
      },
      "n_539cf9ee4380ef4b": {
        "name": "Prepare next notice",
        "imports": [],
        "source": "export default function next({rows,channelId,previousState}) {\n const index=previousState===null?0:previousState.index+1;\n if(index>=rows.length)return {state:{index},more:false,channelId,text:'-',count:rows.length};\n const row=rows[index],v=x=>x==null?'undefined':String(x),d=new Date(),days=['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'],date=`${String(d.getUTCDate()).padStart(2,'0')}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${d.getUTCFullYear()}`;\n return {state:{index},more:true,channelId,text:`Bonjour ! Voici les stats de notre Instagram ${v(row.account)} en ce beau matin du ${days[d.getUTCDay()]} ${date}\\nLe nombre de Followers est de : ${v(row.followers)}\\nNous avons réalisé : ${v(row.posts)} posts, \\nBravo !`,count:rows.length};\n}\n"
      }
    }
