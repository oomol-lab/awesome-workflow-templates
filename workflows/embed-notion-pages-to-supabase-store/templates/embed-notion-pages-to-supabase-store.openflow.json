    "modules": {
      "n_a12a73009da7c5aa": {
        "name": "Prepare page chunks",
        "imports": [],
        "source": "export default function prepare({ body }) {\n  const { pageId, createdTime, pageTitle, text } = body;\n  if (\n    !pageId ||\n    !createdTime ||\n    typeof pageTitle !== \"string\" ||\n    typeof text !== \"string\" ||\n    !text.trim()\n  )\n    throw Error(\"Missing page metadata or text\");\n  const chunks = [];\n  for (let i = 0; i < text.length; i += 880) {\n    chunks.push(text.slice(i, i + 1000));\n    if (i + 1000 >= text.length) break;\n  }\n  if (chunks.length > 20) throw Error(\"Page exceeds 20 chunks; split it before indexing\");\n  return {\n    request: { model: \"text-embedding-ada-002\", input: chunks },\n    chunks,\n    metadata: { pageId, createdTime, pageTitle },\n  };\n}\n"
      },
      "n_ddb17064357d4132": {
        "name": "Reserve page indexing",
        "imports": [],
        "source": "export default async function plan({ response, chunks, metadata, acknowledge, resolution }, ctx) {\n  if (!Array.isArray(response?.data) || response.data.length !== chunks.length)\n    throw Error(\"Embedding count mismatch\");\n  const rows = chunks.map((content, i) => {\n      const found = response.data.filter((x) => x.index === i);\n      if (\n        found.length !== 1 ||\n        !Array.isArray(found[0].embedding) ||\n        found[0].embedding.length !== 1536 ||\n        found[0].embedding.some((x) => !Number.isFinite(x))\n      )\n        throw Error(\"Invalid embedding \" + i);\n      return { content, metadata, embedding: found[0].embedding };\n    }),\n    key = \"notion-vector:\" + metadata.pageId,\n    old = await ctx.state.get(key);\n  if (old?.status === \"done\") return { write: false, key, rows: [] };\n  if (old?.status === \"pending\") {\n    if (acknowledge !== key || ![\"confirmed\", \"absent\"].includes(resolution))\n      throw Error(\"Inspect Supabase rows for \" + key);\n    if (resolution === \"confirmed\") {\n      await ctx.state.set(key, { status: \"done\" });\n      return { write: false, key, rows: [] };\n    }\n  }\n  await ctx.state.set(key, { status: \"pending\" });\n  return { write: true, key, rows };\n}\n"
      },
      "n_601fece69b204718": {
        "name": "Confirm page indexing",
        "imports": [],
        "source": "export default async function confirm({ key, status }, ctx) {\n  if (status < 200 || status >= 300) throw Error(\"Unknown Supabase write\");\n  await ctx.state.set(key, { status: \"done\" });\n  return { ok: true };\n}\n"
      },
      "n_c2556103ec025220": {
        "name": "Prepare receipt",
        "imports": [],
        "source": "export default function f() {\n  return { body: JSON.stringify({ status: \"completed\" }) };\n}\n"
      }
    }
