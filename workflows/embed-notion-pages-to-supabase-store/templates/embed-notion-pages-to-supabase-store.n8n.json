      ],
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "pageId",
                "value": "={{ $('Prepare page text').item.json.pageId }}"
              },
              {
                "name": "createdTime",
                "value": "={{ $('Prepare page text').item.json.createdTime }}"
              },
              {
                "name": "pageTitle",
                "value": "={{ $('Prepare page text').item.json.pageTitle }}"
              }
            ]
          }
        },
        "jsonData": "={{ $('Prepare page text').item.json.text }}",
        "jsonMode": "expressionData"
      },
      "typeVersion": 1
    },
    {
      "id": "embed-notion-pages-to-supabase-store-16",
      "name": "Token Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterTokenSplitter",
      "position": [
        3520,
