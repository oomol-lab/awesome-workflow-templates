{
  "name": "Embed Notion Pages to Supabase Store",
  "tags": [],
  "nodes": [
    {
      "id": "embed-notion-pages-to-supabase-store-0",
      "name": "Notion - Page Added Trigger",
      "type": "n8n-nodes-base.notionTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "simple": false,
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_NOTION_DATABASE_ID"
        }
      },
      "typeVersion": 1
    },
    {
      "name": "One page at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "embed-notion-pages-to-supabase-store-1",
      "position": [
        220,
        0
      ]
    },
    {
      "id": "embed-notion-pages-to-supabase-store-2",
      "name": "Notion - Retrieve Page Content",
      "type": "n8n-nodes-base.notion",
      "position": [
        440,
        0
      ],
      "parameters": {
        "blockId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('One page at a time').item.json.id }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true,
        "simplifyOutput": true,
        "fetchNestedBlocks": false
      },
      "typeVersion": 2.2,
      "alwaysOutputData": true
    },
    {
      "name": "Prepare page text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $(\"One page at a time\").item.json,\n  blocks = $input.all().map((x) => x.json),\n  text = blocks\n    .filter((b) => b.type !== \"image\" && b.type !== \"video\")\n    .map((b) =>\n      typeof b.content === \"string\"\n        ? b.content\n        : (b[b.type]?.rich_text ?? b[b.type]?.text ?? [])\n            .map((t) => t.plain_text ?? t.text?.content ?? \"\")\n            .join(\"\"),\n    )\n    .filter(Boolean)\n    .join(\"\\n\");\nconst title =\n  p.properties?.Page?.title?.map((x) => x.plain_text ?? x.text?.content ?? \"\").join(\"\") ?? \"\";\nif (!p.id || !p.created_time) throw Error(\"Missing page metadata\");\nreturn [{ json: { pageId: p.id, createdTime: p.created_time, pageTitle: title, text } }];\n"
      },
      "id": "embed-notion-pages-to-supabase-store-3",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Has page text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.text.trim().length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "embed-notion-pages-to-supabase-store-4",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Page not indexed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'notion-vector:' + $('Prepare page text').item.json.pageId }}"
            }
          ]
        }
      },
      "id": "embed-notion-pages-to-supabase-store-5",
      "position": [
        1100,
        0
      ]
    },
    {
      "name": "Page already indexed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'notion-vector:' + $('Prepare page text').item.json.pageId }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "done"
            }
          ]
        }
      },
      "id": "embed-notion-pages-to-supabase-store-6",
      "position": [
        1320,
        0
      ]
    },
    {
      "name": "Page has pending vectors",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "rowExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "item_key",
              "condition": "eq",
              "keyValue": "={{ 'notion-vector:' + $('Prepare page text').item.json.pageId }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "id": "embed-notion-pages-to-supabase-store-7",
      "position": [
        1540,
        0
      ]
    },
    {
      "name": "Stop for vector review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "throw Error(\"Inspect pending page vectors before retrying\");\n"
      },
      "id": "embed-notion-pages-to-supabase-store-8",
      "position": [
        1760,
        0
      ]
    },
    {
      "name": "Reserve page vectors",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "item_key": "={{ 'notion-vector:' + $('Prepare page text').item.json.pageId }}",
            "status": "pending"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "embed-notion-pages-to-supabase-store-9",
      "position": [
        1980,
        0
      ]
    },
    {
      "name": "Choose indexing mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { mode: \"direct\" } };\n"
      },
      "id": "embed-notion-pages-to-supabase-store-10",
      "position": [
        2200,
        0
      ]
    },
    {
      "name": "Relay mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.mode === 'relay' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "embed-notion-pages-to-supabase-store-11",
      "position": [
        2420,
        0
      ]
    },
    {
      "name": "Forward page text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "YOUR_OPEN_FLOW_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Prepare page text').item.json }}",
        "options": {}
      },
      "id": "embed-notion-pages-to-supabase-store-12",
      "position": [
        2640,
        0
      ]
    },
    {
      "name": "Verify relay receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status !== \"completed\") throw Error(\"Unknown relay result\");\nreturn { json: { ok: true } };\n"
      },
      "id": "embed-notion-pages-to-supabase-store-13",
      "position": [
        2860,
        0
      ]
    },
    {
      "id": "embed-notion-pages-to-supabase-store-14",
      "name": "Supabase Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "position": [
        3080,
        0
      ],
      "parameters": {
        "mode": "insert",
        "options": {},
        "tableName": {
          "__rl": true,
          "mode": "name",
          "value": "documents"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "embed-notion-pages-to-supabase-store-15",
      "name": "Create metadata and load content",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "position": [
        3300,
